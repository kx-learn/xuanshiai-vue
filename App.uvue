<script setup lang="uts">
	import { isLiveDemoRoute } from './utils/liveDemoRoute.uts'
	import {
		FASTAPI_AUTO_ENTER_COMMUNITY,
		FASTAPI_DEV_ACCESS_TOKEN,
		FASTAPI_DEV_USER_ID,
		USE_MOCK,
		getAccessToken,
		setAuthTokens
	} from './api/config.uts'

	let parentRouteRedirecting = false
	const enforceParentRoute = () => {
		const storedMode = uni.getStorageSync('xsa_onboarding_mode')
		if (storedMode == null || String(storedMode) != 'parent' || parentRouteRedirecting) return
		const pages = getCurrentPages()
		const currentPage = pages.length > 0 ? pages[pages.length - 1] : null
		const route = currentPage != null && currentPage.route != null ? String(currentPage.route) : ''
		if (currentPage != null && isLiveDemoRoute(route, (currentPage as any).options as UTSJSONObject)) return
		if (
			route == '' || route == 'pages/parent/parent' || route == 'pages/parent/user-detail' ||
			route == 'pagesSub/profileExtra/certification' || route == 'pagesSub/chat/detail' ||
			route == 'pages/auth/login' || route == 'pages/auth/register' ||
			route == 'pagesSub/userExtra/onboarding/profile'
		) return
		parentRouteRedirecting = true
		uni.reLaunch({ url: '/pages/parent/parent', complete: () => { parentRouteRedirecting = false } })
	}

	const tryAutoEnterFastApiCommunity = (): boolean => {
		if (FASTAPI_AUTO_ENTER_COMMUNITY != true) return false
		if (FASTAPI_DEV_ACCESS_TOKEN == '' || FASTAPI_DEV_USER_ID <= 0) return false

		setAuthTokens(FASTAPI_DEV_ACCESS_TOKEN)
		if (getAccessToken() != FASTAPI_DEV_ACCESS_TOKEN) return false

		try {
			uni.setStorageSync('xsa_user_id', FASTAPI_DEV_USER_ID)
		} catch (e) {
			return false
		}

		uni.switchTab({
			url: '/pages/community/community'
		})
		return true
	}

	const tryAutoEnterMock = (): boolean => {
		if (USE_MOCK != true) return false

		setAuthTokens('mock_debug_access_token_xsa', 'mock_debug_refresh_token_xsa')
		if (getAccessToken() != 'mock_debug_access_token_xsa') return false

		try {
			uni.setStorageSync('xsa_user_id', 9001)
			uni.setStorageSync('xsa_login_agreed', true)
			uni.setStorageSync('xsa_skip_welcome_once', true)
		} catch (e) {
			return false
		}

		uni.switchTab({ url: '/pages/index/index' })
		return true
	}

	// #ifdef APP-ANDROID || APP-HARMONY
	let firstBackTime = 0
	// #endif

	onLaunch((options) => {
		console.log('App Launch')
		if (isLiveDemoRoute(options.path ?? '', options.query)) return
		uni.setStorageSync('xsa_new_app_launch', true)
		if (!tryAutoEnterFastApiCommunity()) tryAutoEnterMock()
	})

	onShow(() => {
		console.log('App Show')
		enforceParentRoute()
		setTimeout(() => enforceParentRoute(), 0)
	})

	onHide(() => {
		console.log('App Hide')
	})

	// #ifdef APP-ANDROID || APP-HARMONY
	onLastPageBackPress(() => {
		console.log('App LastPageBackPress')
		if (firstBackTime == 0) {
			uni.showToast({
				title: '再按一次退出应用',
				position: 'bottom',
			})
			firstBackTime = Date.now()
			setTimeout(() => {
				firstBackTime = 0
			}, 2000)
		} else if (Date.now() - firstBackTime < 2000) {
			firstBackTime = Date.now()
			uni.exit()
		}
	})

	onExit(() => {
		console.log('App Exit')
	})
	// #endif
</script>

<style>
	/* 全局 Token：必须写在 App 全局样式，才能进入微信 app.wxss。
	 * 与 uni.scss 保持同一套 hex/rgba 语义 Token（方案 A：全端统一）。
	 */
	page {
		/* 基底色 */
		--canvas: #F4F8F7;
		--paper: #FAFCFC;
		--surface: #FFFFFF;
		--warm: #E7ECEC;

		/* 文字色 */
		--ink: #0C1313;
		--ink2: #42494A;
		--muted: #7B8282;

		/* 分割与边框 */
		--line: #D3D9D8;

		/* 主色（青瓷绿） */
		--accent: #2D7C72;
		--accent2: #006052;
		--soft: #669C92;

		/* 收藏爱心（低饱和红，与 uni.scss / DESIGN.md 同源） */
		--heart-red: #F08282;

		/* 功能色 */
		--brown: #2C807C;
		--navy: #18415D;
		--sage: #28775B;
		--sage-soft: #C2E0CF;
		--security-hero: #E5F7E7;

		/* 辅助色 */
		--bg-hover: #E7ECEC;
		--bg-subtle: #DCE3E2;
		--accent-bg: #C3DEDA;
		--accent-glow: rgba(56, 152, 141, 0.15);
		--text-invert: #FCFCFC;
		--review-canvas: #F6F7FB;
		--review-soft: #F4F3F8;
		--review-purple: #9E43E8;
		--review-deep: #74458E;
		--review-lilac: #E9D6FB;
		--review-pink: #F3B1EE;
		--review-orange: #E97927;
		--review-orange-soft: #FFF0E4;
		--review-danger: #D45372;

		/* 牵线域：纸张档案视觉 */
		--match-paper: #FFFDF8;
		--match-mist: #E6F0EC;
		--match-sky: #E9F1F5;
		--match-blush: #F9E7E8;
		--match-deep: #154A45;
		--match-coral: #C95C58;
		--match-line: #DBE4DF;
		--match-shadow: 0 12px 28px rgba(27, 91, 86, 0.09);
		--shortcut-application: #ECEBF8;
		--shortcut-plane: #DDF1F5;
		--shortcut-dynamic: #DDF2EC;
		--shortcut-lab: #F6E8DE;

		/* 纸飞机工作台 */
		--plane-purple: #7450C8;
		--plane-purple-deep: #4D2E96;
		--plane-pink: #E86C9A;
		--plane-lilac: #EEE8FF;
		--plane-yellow: #F4B942;
		--plane-blue: #54A8D8;
		--plane-sky: #EEF7FF;
		--plane-sky-deep: #DCEBFF;
		--plane-cloud: #FCFDFF;
		--plane-surface: rgba(255, 255, 255, 0.88);
		--plane-lavender-surface: rgba(241, 234, 255, 0.92);
		--plane-pink-surface: rgba(255, 232, 243, 0.92);

		/* 阴影 */
		--shadow-sm: 0 2px 12px rgba(17, 23, 24, 0.04);
		--shadow-md: 0 4px 16px rgba(17, 23, 24, 0.08);
		--shadow-lg: 0 8px 24px rgba(17, 23, 24, 0.10);

		/* 字体 */
		--serif: "Songti SC", "STSong", "Noto Serif SC", serif;
		--sans: "PingFang SC", "Microsoft YaHei", Arial, sans-serif;

		background-color: var(--canvas);
		color: var(--ink);
		font-family: var(--sans);
		font-size: 14px;
		line-height: 1.6;
	}

	/* 每个页面公共 css */
	.uni-row {
		flex-direction: row;
	}

	.uni-column {
		flex-direction: column;
	}

	/* 微信开发者工具与真机统一使用系统中文字体，避免缺字与字形错位。 */
	view, text, button, input, textarea {
		font-family: var(--sans);
		font-variant-ligatures: none;
	}

	.text-serif {
		font-family: var(--serif);
	}

	.text-muted {
		color: var(--muted);
	}

	.text-accent {
		color: var(--accent2);
	}

	.bg-surface {
		background: var(--surface);
	}

	.bg-paper {
		background: var(--paper);
	}

	.border-line {
		border: 1px solid var(--line);
	}

	.shadow-sm {
		box-shadow: var(--shadow-sm);
	}

	.shadow-md {
		box-shadow: var(--shadow-md);
	}

	.shadow-lg {
		box-shadow: var(--shadow-lg);
	}
</style>
