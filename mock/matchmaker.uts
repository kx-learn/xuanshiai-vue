/**
 * 红娘工作台统计卡片的联调明细。
 * 这些均为脱敏测试资料，覆盖牵线的待处理、进行中、成功、失败，
 * 以及约见的处理中、待见面、已完成、已结束等完整状态。
 */
const demoWomen = ['周书仪', '许清禾', '沈知意', '程晚晴', '叶舒然', '林初夏']
const demoMen = ['陈向远', '陆景川', '顾言之', '宋知行', '谢予安', '傅明远']

const matchmakingAnimeAvatar = (index: number, gender: number): string => {
  // 牵线记录使用 1-72，约见记录使用 73-82；同一嘉宾始终映射到同一张本地头像。
  const compactIndex = index <= 35 ? index : 36 + (index - 41)
  const avatarNumber = compactIndex * 2 + gender
  const padded = avatarNumber < 10 ? '00' + String(avatarNumber) : (avatarNumber < 100 ? '0' + String(avatarNumber) : String(avatarNumber))
  return '/static/avatars/matchmaking-anime-' + padded + '.jpg'
}

const buildDemoPerson = (index: number, gender: number) => ({
  user_id: (gender == 1 ? 'M' : 'W') + String(10001 + index),
  nickname: gender == 1 ? demoMen[index % demoMen.length] : demoWomen[index % demoWomen.length],
  gender: gender,
  avatar: matchmakingAnimeAvatar(index, gender)
})

const buildDemoIntroduction = (index: number, status: string, createdAt: string) => ({
  id: 'INTRO-' + String(1000 + index),
  status: status,
  failure_reason: status == 'FAILED' ? (index % 2 == 0 ? '双方时间暂未匹配，建议下月再沟通' : '沟通后发现核心需求不一致') : '',
  note: status == 'SUCCEEDED' ? '双方已确认继续相处，由服务红娘持续跟进。' : '服务红娘已完成资料核验与匹配建议。',
  created_at: createdAt,
  updated_at: createdAt,
  from_user: buildDemoPerson(index, 2),
  to_user: buildDemoPerson(index, 1)
})

export const mockMatchmakerWorkspaceIntroductions: any[] = []

// 统计口径：3 条待我牵线、29 条牵线成功；其余状态用于完整筛选回归。
for (let i = 0; i < 3; i++) mockMatchmakerWorkspaceIntroductions.push(buildDemoIntroduction(i, 'PENDING', '2026-09-0' + String(i + 1) + ' 10:0' + String(i) + ':00'))
for (let i = 0; i < 2; i++) mockMatchmakerWorkspaceIntroductions.push(buildDemoIntroduction(i + 3, 'IN_PROGRESS', '2026-08-2' + String(i + 1) + ' 14:30:00'))
for (let i = 0; i < 29; i++) mockMatchmakerWorkspaceIntroductions.push(buildDemoIntroduction(i + 5, 'SUCCEEDED', '2026-08-' + String((i % 20) + 1).padStart(2, '0') + ' 11:20:00'))
for (let i = 0; i < 2; i++) mockMatchmakerWorkspaceIntroductions.push(buildDemoIntroduction(i + 34, 'FAILED', '2026-07-1' + String(i + 1) + ' 16:40:00'))

