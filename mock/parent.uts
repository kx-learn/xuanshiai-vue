import { mockMeProfile } from './user.uts'
import { CURRENT_USER_ID_KEY, getAccessToken } from '@/api/config.uts'

const ordinaryProfile = mockMeProfile as any
const childBirthYear = new Date().getFullYear() - Number(ordinaryProfile.age != null ? ordinaryProfile.age : 29)

/**
 * 单子女上下文仅用于隔离的本地父母主体；生产发布仍须由服务端返回父母端专用的隐私字段。
 */
export const mockParentContext = {
	id: 'parent_context_001',
	mode: 'parent',
	dataMode: 'mock',
	parent: {
		id: 9101,
		name: String(ordinaryProfile.name) + '的家人',
		avatar: ordinaryProfile.avatar != null ? String(ordinaryProfile.avatar) : '',
		realNameStatus: 'passed'
	},
	child: {
		id: 9201,
		displayName: ordinaryProfile.name != null ? String(ordinaryProfile.name) : '我的子女',
		birthYear: childBirthYear,
		city: ordinaryProfile.city != null ? String(ordinaryProfile.city) : '南京',
		job: ordinaryProfile.job != null ? String(ordinaryProfile.job) : '产品经理',
		introduction: ordinaryProfile.introduction != null ? String(ordinaryProfile.introduction) : '认真经营生活，也期待稳定长久的关系。',
		authorizationStatus: 'granted',
		authorizationExpiresAt: '2099-12-31T23:59:59+08:00',
		profileProgress: Number(ordinaryProfile.profileProgress != null ? ordinaryProfile.profileProgress : 78)
	},
	quota: {
		dailyTotal: 3,
		remainingApplications: 2
	},
	releaseGate: {
		productionReady: false,
		code: 'PARENT_RELATIONSHIP_BACKEND_REQUIRED',
		message: '父母端服务正在持续完善。'
	}
}

function cloneChild(child: any): any {
	if (child == null) return null
	return {
		id: child.id,
		displayName: child.displayName,
		birthYear: child.birthYear,
		city: child.city,
		job: child.job,
		introduction: child.introduction,
		authorizationStatus: child.authorizationStatus,
		authorizationExpiresAt: child.authorizationExpiresAt,
		profileProgress: child.profileProgress
	}
}

export function getMockParentContextData(): any {
    const state = getMockParentStateData()
	return JSON.parse(JSON.stringify(state.context))
}

const parentStates: { [key: string]: any } = {}

export function getParentMockSubjectKey(childId: number = 9201): string {
    const userId = String(uni.getStorageSync(CURRENT_USER_ID_KEY)).trim()
    if (getAccessToken() == '' || userId == '' || !Number.isFinite(childId) || childId <= 0) {
        throw new Error('PARENT_AUTH_REQUIRED: 请重新登录')
    }
    return 'parent:' + encodeURIComponent(userId) + ':' + childId
}

export function getMockParentStateData(scope: string = ''): any {
    const key = scope == '' ? getParentMockSubjectKey() : scope
    if (key != getParentMockSubjectKey()) throw new Error('PARENT_SUBJECT_CHANGED: 父母账号或子女已变更')
    if (parentStates[key] == null) {
        const stored = uni.getStorageSync('xsa_parent_state_v2:' + key)
        const seed = seedParentContext()
        seed.parent.id = Number(uni.getStorageSync(CURRENT_USER_ID_KEY))
        seed.id = key
        parentStates[key] = stored != null && stored.schemaVersion == 2 && stored.context != null
            ? JSON.parse(JSON.stringify(stored))
            : { schemaVersion: 2, context: seed, likedUserIds: [], blockedUserIds: [], reports: [],
                messageState: null, quotaDate: new Date().toISOString().slice(0, 10), messageNotifications: true }
    }
    const state = parentStates[key]
    const today = new Date().toISOString().slice(0, 10)
    if (state.quotaDate != today) {
        state.context.quota.remainingApplications = state.context.quota.dailyTotal
        state.quotaDate = today
    }
    return state
}

export function saveMockParentStateData(scope: string = ''): void {
    const key = scope == '' ? getParentMockSubjectKey() : scope
    const state = getMockParentStateData(key)
    try {
        uni.setStorageSync('xsa_parent_state_v2:' + key, JSON.parse(JSON.stringify(state)))
    } catch (error) {
        delete parentStates[key]
        throw new Error('PARENT_STORAGE_FAILED: 保存失败，请重试')
    }
}

export function isMockParentCandidateBlocked(candidateId: number, scope: string = ''): boolean {
    return getMockParentStateData(scope).blockedUserIds.indexOf(candidateId) >= 0
}

export function blockMockParentCandidate(candidateId: number): any {
    const state = getMockParentStateData()
    if (state.blockedUserIds.indexOf(candidateId) < 0) state.blockedUserIds.push(candidateId)
    state.likedUserIds = state.likedUserIds.filter((id: number) => id != candidateId)
    if (state.messageState != null) {
        state.messageState.messageList = state.messageState.messageList.filter((item: any) => item.userId != candidateId)
        state.messageState.applications = state.messageState.applications.filter((item: any) => item.userId != candidateId)
        delete state.messageState.chatMessagesByUser[String(candidateId)]
    }
    saveMockParentStateData()
    return { success: true, internalDemo: true }
}

export function reportMockParentCandidate(candidateId: number, reasonId: string, detail: string): any {
    const state = getMockParentStateData()
    const existing = state.reports.find((item: any) => item.targetId == candidateId && item.reasonId == reasonId && item.detail == detail)
    if (existing != null) return { success: true, reportId: existing.id, internalDemo: true, deduplicated: true }
    const record = { id: state.reports.length + 1, targetId: candidateId, reasonId: reasonId, detail: detail, createdAt: Date.now(), status: 'pending' }
    state.reports.push(record)
    saveMockParentStateData()
    return { success: true, reportId: record.id, internalDemo: true }
}

function seedParentContext(): any {
	return {
		id: mockParentContext.id,
		mode: mockParentContext.mode,
		dataMode: mockParentContext.dataMode,
		parent: { ...mockParentContext.parent },
		child: cloneChild(mockParentContext.child),
		quota: { ...mockParentContext.quota },
		releaseGate: { ...mockParentContext.releaseGate }
	}
}

export function updateMockParentChildProfileData(profile: any): any {
	const child = getMockParentStateData().context.child
	child.displayName = profile.displayName
	child.birthYear = profile.birthYear
	child.city = profile.city
	child.job = profile.job
	child.introduction = profile.introduction
	let progress = 60
	if (profile.job.length > 0) progress += 20
	if (profile.introduction.length > 0) progress += 20
	child.profileProgress = progress
    saveMockParentStateData()
	return cloneChild(child)
}
