function cloneValue(value: any): any {
  return JSON.parse(JSON.stringify(value))
}

function replaceList(target: any[], seed: any[]) {
  target.splice(0, target.length)
  const fresh = cloneValue(seed) as any[]
  fresh.forEach((item: any) => target.push(item))
}

function normalizedPageSize(pageSize: number): number {
  if (pageSize <= 0) return 20
  return Math.min(pageSize, 50)
}

function cursorOffset(cursor: string): number {
  if (cursor == null || cursor == '') return 0
  const offset = parseInt(cursor)
  return Number.isNaN(offset) || offset < 0 ? 0 : offset
}

function paginate(list: any[], cursor: string, pageSize: number): any {
  const offset = cursorOffset(cursor)
  const size = normalizedPageSize(pageSize)
  const page = list.slice(offset, offset + size)
  const nextOffset = offset + page.length
  const hasMore = nextOffset < list.length
  return {
    list: cloneValue(page),
    nextCursor: hasMore ? '' + nextOffset : '',
    hasMore: hasMore,
    total: list.length
  }
}

export const mockMessageList = cloneValue(CONVERSATION_SEED) as any[]
export const mockChatMessages = cloneValue(CHAT_SEED) as any[]
export const mockApplications = cloneValue(APPLICATION_SEED) as any[]

const selfChatMessagesByUser: any = {
  '1': mockChatMessages
}
const selfSentMessagesByClientId: any = {}
const selfApplicationCommandsByClientId: any = {}
const selfContactExchanges: any[] = [{
  id: 2001,
  userId: 1,
  requesterId: 1,
  recipientId: 'self',
  contactType: 'wechat',
  contactValue: 'xsa_mock_suwanqing',
  status: 'pending',
  createdAt: Date.now() - 15 * 60 * 1000,
  respondedAt: null
}]
const selfContactCommandsByClientId: any = {}
const selfRevokeCommandsByClientId: any = {}
const selfFailureOnce: any = {}

const mockSubjectStates: any = {
  'self': {
    messageList: mockMessageList,
    chatMessages: mockChatMessages,
    applications: mockApplications,
    chatMessagesByUser: selfChatMessagesByUser,
    sentMessagesByClientId: selfSentMessagesByClientId,
    applicationCommandsByClientId: selfApplicationCommandsByClientId,
    contactExchanges: selfContactExchanges,
    contactCommandsByClientId: selfContactCommandsByClientId,
    revokeCommandsByClientId: selfRevokeCommandsByClientId,
    failureOnce: selfFailureOnce,
    messageIdSeed: 1000,
    contactExchangeIdSeed: 2000
  }
}

function clearObject(target: any) {
  Object.keys(target).forEach((key: string) => {
    delete target[key]
  })
}

function normalizedMockSubjectKey(subjectKey: string): string {
  if (subjectKey == null || subjectKey.trim() == '') return 'self'
  return subjectKey.trim()
}

function createMockSubjectState(): any {
  const chatMessages = cloneValue(CHAT_SEED) as any[]
  return {
    messageList: cloneValue(CONVERSATION_SEED) as any[],
    chatMessages: chatMessages,
    applications: cloneValue(APPLICATION_SEED) as any[],
    chatMessagesByUser: { '1': chatMessages },
    sentMessagesByClientId: {},
    applicationCommandsByClientId: {},
    contactExchanges: [{
      id: 2001,
      userId: 1,
      requesterId: 1,
      recipientId: 'self',
      contactType: 'wechat',
      contactValue: 'xsa_mock_suwanqing',
      status: 'pending',
      createdAt: Date.now() - 15 * 60 * 1000,
      respondedAt: null
    }],
    contactCommandsByClientId: {},
    revokeCommandsByClientId: {},
    failureOnce: {},
    messageIdSeed: 1000,
    contactExchangeIdSeed: 2001
  }
}

let parentMessageStore: any = null
let parentMessageSave: any = null
let parentMessageBlocked: any = null

/** The parent adapter supplies one durable account+child transaction boundary. */
export function configureParentMessageRuntime(read: any, save: any, blocked: any): void {
  parentMessageStore = read
  parentMessageSave = save
  parentMessageBlocked = blocked
}

function persistParentMessageState(subjectKey: string): void {
  if (subjectKey.indexOf('parent:') == 0 && parentMessageSave != null) parentMessageSave(subjectKey)
}

function getMockSubjectState(subjectKey: string = 'self'): any {
  const key = normalizedMockSubjectKey(subjectKey)
  if (key.indexOf('parent:') == 0 && parentMessageStore != null) {
    const owner = parentMessageStore(key)
    if (owner.messageState == null) owner.messageState = createMockSubjectState()
    return owner.messageState
  }
  if (mockSubjectStates[key] == null) {
    mockSubjectStates[key] = createMockSubjectState()
  }
  return mockSubjectStates[key]
}

function consumeMockFailure(state: any, operation: string): boolean {
  if (state.failureOnce[operation] != true) return false
  delete state.failureOnce[operation]
  return true
}

/** 仅用于 Mock 状态机验收；失败只生效一次且必须发生在状态变更前。 */
export function failNextMockMessageOperation(operation: string, subjectKey: string = 'self') {
  getMockSubjectState(subjectKey).failureOnce[operation] = true
}

function findConversation(state: any, userId: number): any {
  return state.messageList.find((item: any) => item.userId == userId)
}

function ensureChatThread(state: any, userId: number): any[] {
  const key = '' + userId
  if (state.chatMessagesByUser[key] == null) {
    state.chatMessagesByUser[key] = []
  }
  return state.chatMessagesByUser[key] as any[]
}

function ensureAcceptedConversation(state: any, application: any): any {
  let conversation = findConversation(state, application.userId)
  if (conversation == null) {
    conversation = {
      id: state.messageList.length + 1,
      conversationId: 'conversation-' + application.userId,
      userId: application.userId,
      avatar: application.avatar,
      name: application.name,
      lastMessage: '你们已同意认识，可以开始聊天。',
      time: Date.now(),
      unreadCount: 0,
      online: false,
      messageType: 'text',
      type: 'chat',
      matched: true,
      canChat: true
    }
    state.messageList.unshift(conversation)
  } else {
    conversation.matched = true
    conversation.canChat = true
    conversation.type = 'chat'
  }
  ensureChatThread(state, application.userId)
  return conversation
}

function resetSelfMockState() {
  replaceList(mockMessageList, CONVERSATION_SEED)
  replaceList(mockChatMessages, CHAT_SEED)
  replaceList(mockApplications, APPLICATION_SEED)
  clearObject(selfChatMessagesByUser)
  selfChatMessagesByUser['1'] = mockChatMessages
  clearObject(selfSentMessagesByClientId)
  clearObject(selfApplicationCommandsByClientId)
  selfContactExchanges.splice(0, selfContactExchanges.length)
  selfContactExchanges.push({
    id: 2001,
    userId: 1,
    requesterId: 1,
    recipientId: 'self',
    contactType: 'wechat',
    contactValue: 'xsa_mock_suwanqing',
    status: 'pending',
    createdAt: Date.now() - 15 * 60 * 1000,
    respondedAt: null
  })
  clearObject(selfContactCommandsByClientId)
  clearObject(selfRevokeCommandsByClientId)
  clearObject(selfFailureOnce)
  mockSubjectStates['self'].messageIdSeed = 1000
  mockSubjectStates['self'].contactExchangeIdSeed = 2001
}

/** 恢复稳定初始状态；无主体参数时清除全部主体，供重复验收使用。 */
export function resetMockMessageState(subjectKey: string = '') {
  const key = subjectKey == null ? '' : subjectKey.trim()
  if (key == '') {
    resetSelfMockState()
    const keys = Object.keys(mockSubjectStates)
    for (let i = 0; i < keys.length; i++) {
      if (keys[i] != 'self') delete mockSubjectStates[keys[i]]
    }
    return
  }
  const normalizedKey = normalizedMockSubjectKey(key)
  if (normalizedKey == 'self') {
    resetSelfMockState()
    return
  }
  mockSubjectStates[normalizedKey] = createMockSubjectState()
}

export function getMockConversationPage(
  cursor: string = '',
  pageSize: number = 20,
  subjectKey: string = 'self'
): any {
  const state = getMockSubjectState(subjectKey)
  const result = paginate(state.messageList, cursor, pageSize)
  result.unreadTotal = state.messageList.reduce((sum: number, item: any) => {
    return sum + (item.unreadCount != null ? item.unreadCount : 0)
  }, 0)
  return result
}

export function getMockApplicationPage(
  direction: string = 'incoming',
  cursor: string = '',
  pageSize: number = 20,
  subjectKey: string = 'self'
): any {
  const state = getMockSubjectState(subjectKey)
  const expected = direction == 'outgoing' ? 'out' : 'in'
  const filtered = state.applications.filter((item: any) => item.direction == expected)
  const result = paginate(filtered, cursor, pageSize)
  result.direction = direction == 'outgoing' ? 'outgoing' : 'incoming'
  result.pendingCount = expected == 'in'
    ? state.applications.filter((item: any) => item.direction == 'in' && item.status == 'pending').length
    : 0
  return result
}

export function getMockChatPermission(userId: number, subjectKey: string = 'self'): any {
  const state = getMockSubjectState(subjectKey)
  const conversation = findConversation(state, userId)
  const blocked = subjectKey.indexOf('parent:') == 0 && parentMessageBlocked != null && parentMessageBlocked(userId, subjectKey)
  const canChat = !blocked && conversation != null && conversation.matched == true && conversation.canChat == true
  return {
    userId: userId,
    conversationId: canChat ? conversation.conversationId : '',
    sessionId: canChat ? conversation.id : null,
    canChat: canChat,
    reason: canChat ? '' : '双方同意后才能开始聊天'
  }
}

export function markAllMockMessagesRead(subjectKey: string = 'self'): any {
  const state = getMockSubjectState(subjectKey)
  if (consumeMockFailure(state, 'markAllRead')) {
    return { success: false, code: 'MOCK_FAILURE', message: '全部已读失败，请重试' }
  }
  let updatedCount = 0
  state.messageList.forEach((item: any) => {
    const count = item.unreadCount != null ? item.unreadCount : 0
    updatedCount += count
    item.unreadCount = 0
  })
  persistParentMessageState(subjectKey)
  return {
    success: true,
    updatedCount: updatedCount,
    unreadTotal: 0
  }
}

export function handleMockApplication(
  applicationId: number,
  action: string,
  clientCommandId: string = '',
  subjectKey: string = 'self'
): any {
  const state = getMockSubjectState(subjectKey)
  // 仅保留给既有 Mock 直调测试；公开 API 会在到达此处前拒绝空命令 ID。
  const commandId = clientCommandId == null || clientCommandId.trim() == ''
    ? 'legacy-direct:' + applicationId + ':' + action
    : clientCommandId.trim()
  const existingCommand = state.applicationCommandsByClientId[commandId]
  if (existingCommand != null) {
    if (existingCommand.applicationId != applicationId || existingCommand.action != action) {
      return {
        success: false,
        code: 'IDEMPOTENCY_CONFLICT',
        message: '申请操作唯一标识已被其它操作使用'
      }
    }
    return cloneValue(existingCommand.result)
  }
  const application = state.applications.find((item: any) => item.id == applicationId)
  if (application == null) {
    return { success: false, code: 'NOT_FOUND', message: '申请不存在或已失效' }
  }
  if (application.direction != 'in') {
    return { success: false, code: 'FORBIDDEN_ACTION', message: '只能处理收到的申请' }
  }
  if (application.status != 'pending') {
    return { success: false, code: 'ALREADY_HANDLED', message: '该申请已处理' }
  }
  if (action != 'accept' && action != 'reject') {
    return { success: false, code: 'INVALID_ACTION', message: '不支持的处理方式' }
  }
  if (consumeMockFailure(state, 'handleApplication')) {
    return { success: false, code: 'MOCK_FAILURE', message: '申请处理失败，请重试' }
  }

  application.status = action == 'accept' ? 'accepted' : 'rejected'
  application.statusText = action == 'accept' ? '已同意' : '已拒绝'
  let conversation: any = null
  if (action == 'accept') {
    conversation = ensureAcceptedConversation(state, application)
  }
  const result = {
    success: true,
    application: cloneValue(application),
    conversation: conversation != null ? cloneValue(conversation) : null,
    canChat: action == 'accept'
  }
  state.applicationCommandsByClientId[commandId] = {
    applicationId: applicationId,
    action: action,
    result: cloneValue(result)
  }
  persistParentMessageState(subjectKey)
  return result
}

export function createMockParentApplication(candidate: any, note: string, subjectKey: string, quota: any): any {
  const state = getMockSubjectState(subjectKey)
  const existing = state.applications.find((item: any) => item.userId == candidate.id && (item.status == 'pending' || item.status == 'accepted'))
  if (existing != null) {
    if (existing.direction != 'out' || existing.status != 'pending') return { success: false, code: 'APPLICATION_EXISTS', message: '双方已有申请或已同意认识' }
    return { success: true, applicationId: existing.id, applyStatus: 'pending', remainingApplications: quota.remainingApplications, deduplicated: true, internalDemo: true }
  }
  if (quota.remainingApplications <= 0) return { success: false, code: 'APPLICATION_QUOTA_EXHAUSTED', message: '今日申请次数已用完' }
  const applicationId = state.applications.reduce((maximum: number, item: any) => Math.max(maximum, item.id), 1000) + 1
  state.applications.unshift({ id: applicationId, userId: candidate.id, name: candidate.name, avatar: '', age: candidate.age,
    city: candidate.city, job: candidate.job, message: note, direction: 'out', status: 'pending', statusText: '等待回应', time: Date.now() })
  quota.remainingApplications -= 1
  persistParentMessageState(subjectKey)
  return { success: true, applicationId: applicationId, applyStatus: 'pending', remainingApplications: quota.remainingApplications, deduplicated: false, internalDemo: true }
}

export function getMockChatMessages(userId: number, subjectKey: string = 'self'): any[] {
  const state = getMockSubjectState(subjectKey)
  const thread = state.chatMessagesByUser['' + userId]
  return thread != null ? cloneValue(thread) as any[] : []
}

export function sendMockMessage(
  userId: number,
  content: string,
  type: string = 'text',
  clientMessageId: string = '',
  subjectKey: string = 'self'
): any {
  const state = getMockSubjectState(subjectKey)
  const permission = getMockChatPermission(userId, subjectKey)
  if (permission.canChat != true) {
    return { success: false, code: 'CHAT_NOT_ALLOWED', message: permission.reason }
  }
  if (clientMessageId == null || clientMessageId.trim() == '') {
    return { success: false, code: 'CLIENT_MESSAGE_ID_REQUIRED', message: '缺少消息唯一标识' }
  }
  const resolvedClientMessageId = clientMessageId.trim()
  if (type == 'text' && content.trim() == '') {
    return { success: false, code: 'EMPTY_MESSAGE', message: '消息内容不能为空' }
  }

  const dedupeKey = userId + ':' + resolvedClientMessageId
  const existing = state.sentMessagesByClientId[dedupeKey]
  if (existing != null) {
    if (existing.content != content || existing.type != type) {
      return {
        success: false,
        code: 'IDEMPOTENCY_CONFLICT',
        message: '消息唯一标识已被其它内容使用'
      }
    }
    return {
      success: true,
      messageId: existing.id,
      message: cloneValue(existing),
      deduplicated: true
    }
  }
  if (consumeMockFailure(state, 'sendMessage')) {
    return { success: false, code: 'MOCK_FAILURE', message: '发送失败，请重试' }
  }

  state.messageIdSeed += 1
  const message = {
    id: state.messageIdSeed,
    senderId: 'me',
    senderName: '我',
    senderAvatar: PORTRAIT.man,
    content: content,
    type: type,
    time: Date.now(),
    isMine: true,
    status: '已发送',
    clientMessageId: resolvedClientMessageId
  }
  ensureChatThread(state, userId).push(message)
  state.sentMessagesByClientId[dedupeKey] = message

  const conversation = findConversation(state, userId)
  if (conversation != null) {
    conversation.lastMessage = type == 'text' ? content : '[' + type + ']'
    conversation.messageType = type
    conversation.time = message.time
  }
  persistParentMessageState(subjectKey)
  return {
    success: true,
    messageId: message.id,
    message: cloneValue(message),
    deduplicated: false
  }
}

function mockContactExchangeResponse(exchange: any): any {
  const accepted = exchange.status == 'accepted'
  const requestedByMe = exchange.requesterId == 'self'
  return {
    id: exchange.id,
    userId: exchange.userId,
    contactType: exchange.contactType,
    status: exchange.status,
    requestedByMe: requestedByMe,
    // Pending and rejected requests must never expose the submitted value.
    contactValue: accepted ? exchange.contactValue : null,
    createdAt: exchange.createdAt,
    respondedAt: exchange.respondedAt
  }
}

export function getMockContactExchanges(userId: number, subjectKey: string = 'self'): any {
  const state = getMockSubjectState(subjectKey)
  const permission = getMockChatPermission(userId, subjectKey)
  if (permission.canChat != true) {
    return { success: false, code: 'CHAT_NOT_ALLOWED', message: permission.reason }
  }
  const list = state.contactExchanges
    .filter((item: any) => item.userId == userId)
    .map((item: any) => mockContactExchangeResponse(item))
  return { success: true, list: list }
}

export function createMockContactExchange(
  userId: number,
  contactType: string,
  contactValue: string,
  clientCommandId: string,
  subjectKey: string = 'self'
): any {
  const state = getMockSubjectState(subjectKey)
  const permission = getMockChatPermission(userId, subjectKey)
  if (permission.canChat != true) {
    return { success: false, code: 'CHAT_NOT_ALLOWED', message: permission.reason }
  }
  if (contactType != 'phone' && contactType != 'wechat') {
    return { success: false, code: 'INVALID_CONTACT_TYPE', message: '不支持的联系方式类型' }
  }
  const commandId = clientCommandId != null ? clientCommandId.trim() : ''
  if (commandId == '') {
    return { success: false, code: 'CLIENT_COMMAND_ID_REQUIRED', message: '缺少操作唯一标识' }
  }
  const payloadKey = userId + ':' + contactType + ':' + contactValue
  const existing = state.contactCommandsByClientId[commandId]
  if (existing != null) {
    if (existing.payloadKey != payloadKey) {
      return { success: false, code: 'IDEMPOTENCY_CONFLICT', message: '操作唯一标识已被其它请求使用' }
    }
    return cloneValue(existing.result)
  }
  if (consumeMockFailure(state, 'createContactExchange')) {
    return { success: false, code: 'MOCK_FAILURE', message: '联系方式请求发送失败，请重试' }
  }
  const value = contactType == 'phone' ? '13800001001' : contactValue.trim()
  if ((contactType == 'wechat' && value.length < 6) || value.length > 64) {
    return { success: false, code: 'INVALID_CONTACT_VALUE', message: '请填写有效的微信号' }
  }
  state.contactExchangeIdSeed += 1
  const exchange = {
    id: state.contactExchangeIdSeed,
    userId: userId,
    requesterId: 'self',
    recipientId: userId,
    contactType: contactType,
    contactValue: value,
    status: 'pending',
    createdAt: Date.now(),
    respondedAt: null
  }
  state.contactExchanges.unshift(exchange)
  const result = { success: true, exchange: mockContactExchangeResponse(exchange) }
  state.contactCommandsByClientId[commandId] = { payloadKey: payloadKey, result: cloneValue(result) }
  return result
}

export function respondMockContactExchange(
  exchangeId: number,
  action: string,
  clientCommandId: string,
  subjectKey: string = 'self'
): any {
  const state = getMockSubjectState(subjectKey)
  const commandId = clientCommandId != null ? clientCommandId.trim() : ''
  if (commandId == '') {
    return { success: false, code: 'CLIENT_COMMAND_ID_REQUIRED', message: '缺少操作唯一标识' }
  }
  const payloadKey = exchangeId + ':' + action
  const existing = state.contactCommandsByClientId[commandId]
  if (existing != null) {
    if (existing.payloadKey != payloadKey) {
      return { success: false, code: 'IDEMPOTENCY_CONFLICT', message: '操作唯一标识已被其它请求使用' }
    }
    return cloneValue(existing.result)
  }
  const exchange = state.contactExchanges.find((item: any) => item.id == exchangeId)
  if (exchange == null || exchange.recipientId != 'self') {
    return { success: false, code: 'FORBIDDEN_ACTION', message: '只能处理收到的联系方式交换请求' }
  }
  if (exchange.status != 'pending') {
    return { success: false, code: 'ALREADY_HANDLED', message: '联系方式交换请求已处理' }
  }
  if (action != 'accept' && action != 'reject') {
    return { success: false, code: 'INVALID_ACTION', message: '不支持的处理方式' }
  }
  if (consumeMockFailure(state, 'respondContactExchange')) {
    return { success: false, code: 'MOCK_FAILURE', message: '联系方式请求处理失败，请重试' }
  }
  exchange.status = action == 'accept' ? 'accepted' : 'rejected'
  exchange.respondedAt = Date.now()
  const result = { success: true, exchange: mockContactExchangeResponse(exchange) }
  state.contactCommandsByClientId[commandId] = { payloadKey: payloadKey, result: cloneValue(result) }
  return result
}

export function revokeMockMessage(
  messageId: number,
  clientCommandId: string,
  subjectKey: string = 'self'
): any {
  const state = getMockSubjectState(subjectKey)
  const commandId = clientCommandId != null ? clientCommandId.trim() : ''
  if (commandId == '') {
    return { success: false, code: 'CLIENT_COMMAND_ID_REQUIRED', message: '缺少撤回操作唯一标识' }
  }
  const existing = state.revokeCommandsByClientId[commandId]
  if (existing != null) {
    if (existing.messageId != messageId) {
      return { success: false, code: 'IDEMPOTENCY_CONFLICT', message: '撤回操作唯一标识已被其它消息使用' }
    }
    return cloneValue(existing.result)
  }
  let target: any = null
  const threadKeys = Object.keys(state.chatMessagesByUser)
  for (let i = 0; i < threadKeys.length; i++) {
    const candidate = state.chatMessagesByUser[threadKeys[i]].find((item: any) => item.id == messageId)
    if (candidate != null) {
      target = candidate
      break
    }
  }
  if (target == null || target.isMine != true || target.revoked == true) {
    return { success: false, code: 'NOT_FOUND', message: '消息不存在或无法撤回' }
  }
  if (consumeMockFailure(state, 'revokeMessage')) {
    return { success: false, code: 'MOCK_FAILURE', message: '撤回失败，请重试' }
  }
  target.revoked = true
  target.type = 'text'
  target.content = '消息已撤回'
  const result = { success: true, messageId: messageId }
  state.revokeCommandsByClientId[commandId] = { messageId: messageId, result: cloneValue(result) }
  persistParentMessageState(subjectKey)
  return result
}
