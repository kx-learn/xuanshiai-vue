<template>
	<view class="page">
		<view class="tabs">
			<view
				class="tab"
				:class="{ active: currentTab === 'comment' }"
				@click="switchTab('comment')"
			>
				<text class="tab-text">评论</text>
			</view>
			<view
				class="tab"
				:class="{ active: currentTab === 'like' }"
				@click="switchTab('like')"
			>
				<text class="tab-text">点赞</text>
			</view>
			<view
				class="tab"
				:class="{ active: currentTab === 'activity' }"
				@click="switchTab('activity')"
			>
				<text class="tab-text">活动通知</text>
			</view>
			<view class="tab" :class="{ active: currentTab === 'live' }" @click="switchTab('live')">
				<text class="tab-text">直播场次</text>
			</view>
		</view>
		<view class="toolbar" v-if="list.length > 0">
			<text class="mark-all text-accent" @click="markAll">全部已读</text>
		</view>
		<scroll-view class="list" scroll-y>
			<view class="state" v-if="loading"><text class="text-muted">通知加载中...</text></view>
			<XsaEmpty
				v-else-if="notificationError"
				type="noNetwork"
				text="通知加载失败"
				description="请检查网络后重试"
				:show-action="true"
				action-text="重试"
				@action="load"
			/>
			<XsaEmpty
				v-else-if="filteredList.length == 0"
				:text="emptyText"
				:description="emptyDesc"
			/>
			<view
				class="item"
				:class="{ unread: !n.read }"
				v-for="n in filteredList"
				:key="n.id"
				@click="open(n)"
			>
				<view class="dot" v-if="!n.read"></view>
				<view class="body">
					<text class="title">{{ n.title }}</text>
					<text class="content text-muted">{{ n.content }}</text>
					<text class="time text-muted">{{ n.timeText }}</text>
				</view>
			</view>
			<view class="pad"></view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import XsaEmpty from '@/components/XsaEmpty.uvue'
	import {
		getCommunityNotifications,
		markNotificationRead,
		markAllNotificationsRead
	} from '@/api'

	const list = ref([] as any[])
	const loading = ref(false)
	const notificationError = ref(false)
	const currentTab = ref('comment')

	const switchTab = (tab: string) => {
		currentTab.value = tab
	}

	const filteredList = computed(() => {
		const all = list.value as any[]
		const out: any[] = []
		for (let i = 0; i < all.length; i++) {
			const n = all[i]
			const t = n.type != null ? ('' + n.type) : ''
			if (currentTab.value == 'comment' && t == 'comment') out.push(n)
			else if (currentTab.value == 'like' && t == 'like') out.push(n)
			else if (currentTab.value == 'live' && n.targetType == 'live_v2_session') out.push(n)
			else if (
				currentTab.value == 'activity' &&
				t == 'activity' &&
				n.isOfficialActivity == true
			) {
				out.push(n)
			}
		}
		return out
	})

	const emptyText = computed(() => {
		if (currentTab.value == 'comment') return '暂无评论'
		if (currentTab.value == 'like') return '暂无点赞'
		if (currentTab.value == 'activity') return '暂无活动通知'
		if (currentTab.value == 'live') return '暂无直播场次通知'
		return '暂无通知'
	})

	const emptyDesc = computed(() => {
		if (currentTab.value == 'comment') return '收到的评论会出现在这里'
		if (currentTab.value == 'like') return '收到的点赞会出现在这里'
		if (currentTab.value == 'live') return '直播邀请、安排变更与场后结果会出现在这里'
		return '官方活动报名、审核与签到进展会出现在这里'
	})

	onMounted(() => {
		load()
	})

	const load = async () => {
		loading.value = true
		notificationError.value = false
		try {
			const res = await getCommunityNotifications()
			if (res.success) list.value = res.data as any[]
			else notificationError.value = true
		} catch (e) {
			notificationError.value = true
			uni.showToast({ title: '通知加载失败', icon: 'none' })
		} finally {
			loading.value = false
		}
	}

	const open = async (n: any) => {
		const item = n
		if (n.read != true) {
			n.read = true
			try {
				await markNotificationRead(n.id as number)
			} catch (e) {}
		}
		if (item.targetType == 'live_v2_session' && item.targetId > 0) {
			const page = item.type == 'live_result' ? 'results' : 'detail'
			uni.navigateTo({ url: '/pagesSub/live/' + page + '?id=' + item.targetId })
		} else if (item.targetType == 'comment' && item.postId > 0 && item.commentId > 0) {
			uni.navigateTo({ url: '/pagesSub/community/post-detail?id=' + item.postId + '&commentId=' + item.commentId })
		} else if (item.targetType == 'comment' && item.payload != null && item.payload.post_id > 0 && item.payload.comment_id > 0) {
			uni.navigateTo({ url: '/pagesSub/community/post-detail?id=' + item.payload.post_id + '&commentId=' + item.payload.comment_id })
		} else if (item.type == 'comment' && item.postId > 0 && item.commentId > 0) {
			uni.navigateTo({ url: '/pagesSub/community/post-detail?id=' + item.postId + '&commentId=' + item.commentId })
		} else if (item.targetType == 'post' && item.targetId > 0) {
			uni.navigateTo({ url: `/pagesSub/community/post-detail?id=${item.targetId}` })
		} else if (item.type == 'comment') {
			uni.showToast({ title: '该评论已不可查看', icon: 'none' })
		} else if (item.targetType == 'activity' && item.targetId > 0 && item.isOfficialActivity == true) {
			uni.navigateTo({ url: `/pagesSub/community/activity-detail?id=${item.targetId}` })
		} else if (item.targetType == 'user' && item.targetId > 0) {
			uni.navigateTo({ url: `/pagesSub/userExtra/user/detail?userId=${item.targetId}` })
		} else if (item.targetType == 'report' || item.targetType == 'appeal') {
			uni.navigateTo({ url: '/pagesSub/profileExtra/settings' })
		} else if (item.targetType == 'message') {
			uni.switchTab({ url: '/pages/message/message' })
		} else {
			uni.showToast({ title: '该通知关联内容已不可查看', icon: 'none' })
		}
	}

	const markAll = async () => {
		try {
			const res = await markAllNotificationsRead()
			if (res.success) {
				const items = list.value as any[]
				for (let i = 0; i < items.length; i++) {
					items[i].read = true
				}
				uni.showToast({ title: '已全部标为已读', icon: 'none' })
			}
		} catch (e) {
			uni.showToast({ title: '操作失败', icon: 'none' })
		}
	}
</script>

<style scoped>
	.page {
		height: 100vh;
		background: var(--canvas);
		display: flex;
		flex-direction: column;
	}
	.tabs {
		display: flex;
		flex-direction: row;
		background: var(--surface);
		border-bottom: 1px solid var(--line);
	}
	.tab {
		flex: 1;
		height: 44px;
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: center;
		border-bottom: 2px solid transparent;
	}
	.tab.active {
		border-bottom-color: var(--accent);
	}
	.tab-text {
		font-size: 14px;
		font-weight: 600;
		color: var(--muted);
	}
	.tab.active .tab-text {
		color: var(--accent);
		font-weight: 700;
	}
	.toolbar {
		height: 40px;
		padding: 0 16px;
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: flex-end;
		border-bottom: 1px solid var(--line);
		background: var(--surface);
	}
	.mark-all {
		font-size: 12px;
		font-weight: 700;
	}
	.list {
		flex: 1;
		height: 0;
	}
	.item {
		display: flex;
		flex-direction: row;
		gap: 10px;
		padding: 14px 16px;
		background: var(--surface);
		border-bottom: 1px solid var(--line);
	}
	.item.unread {
		background: var(--soft);
	}
	.dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--accent);
		margin-top: 6px;
		flex-shrink: 0;
	}
	.body {
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: 4px;
	}
	.title {
		font-size: 14px;
		font-weight: 700;
		color: var(--ink);
	}
	.content {
		font-size: 12px;
		line-height: 1.45;
	}
	.time {
		font-size: 11px;
	}
	.pad {
		height: 24px;
	}
</style>
