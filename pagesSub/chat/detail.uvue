<template>
	<view class="chat-page" :class="[isAiAvatarMode ? 'ai-avatar-mode' : '', { 'parent-mode': isParentMode }]">
		<view class="permission-state" v-if="permissionLoading">
			<text class="state-title">正在确认聊天权限...</text>
		</view>
		<view class="permission-state" v-else-if="!chatAllowed">
			<text class="state-title">暂时无法进入聊天</text>
			<text class="state-desc text-muted">{{ permissionError }}</text>
			<XsaButton
				variant="secondary"
				:size="isParentMode ? 'large' : 'small'"
				:large-text="isParentMode"
				@click="retryPermission"
			>重新确认</XsaButton>
		</view>

		<template v-else>
			<view
				v-if="isAiAvatarMode && !isParentMode && aiAvatarProfile != null"
				class="ai-head"
			>
				<view class="ai-head-avatar">
					<image
						v-if="aiAvatarProfile.avatar != null && aiAvatarProfile.avatar != ''"
						class="ai-head-img"
						:src="aiAvatarProfile.avatar"
						mode="aspectFill"
					></image>
					<view v-else class="ai-head-avatar-fallback"><text>AI</text></view>
					<view class="ai-head-badge"><text>AI</text></view>
				</view>
				<view class="ai-head-copy">
					<text class="ai-head-name">{{ aiAvatarProfile.name != null ? aiAvatarProfile.name + '的 AI 分身' : 'AI 分身' }}</text>
					<text class="ai-head-desc">只参考当前公开资料；对方不会收到提醒。</text>
				</view>
				<button class="ai-avatar-clear" :disabled="aiAvatarSending" @click="clearAiAvatarHistory">清空</button>
			</view>

			<scroll-view
				class="message-list"
				:class="{ 'ai-thread': isAiAvatarMode && !isParentMode }"
				scroll-y
				:scroll-into-view="scrollToView"
				scroll-with-animation
			>
				<view v-if="isAiAvatarMode && !isParentMode" class="ai-avatar-notice">
					<text class="ai-avatar-notice-title">AI 公开资料问答</text>
					<scroll-view v-if="aiQuickQuestions.length > 0" class="ai-quick-list" scroll-x show-scrollbar="false">
						<view v-for="question in aiQuickQuestions" :key="question.id" class="ai-quick-question" @click="askQuickQuestion(question.prompt)">
							<text>{{ question.label }}</text>
						</view>
					</scroll-view>
				</view>
				<view class="chat-loading" v-if="loading">
					<text class="text-muted">{{ isAiAvatarMode ? '正在读取 AI 分身聊天记录…' : '正在加载聊天记录...' }}</text>
				</view>
				<view class="chat-error" v-else-if="chatError !== '' && messages.length === 0">
					<text class="state-desc text-muted">{{ chatError }}</text>
						<XsaButton
							variant="secondary"
							:size="isParentMode ? 'large' : 'small'"
							:large-text="isParentMode"
							@click="retryHistory"
						>重试</XsaButton>
				</view>
				<view
					class="message-item"
					v-for="(message, index) in messages"
					:key="message.clientMessageId != null ? message.clientMessageId : message.id"
					:id="'msg-' + index"
				>
					<view class="time-divider" v-if="message.showTime">
						<text class="time-text">{{ message.time }}</text>
					</view>

					<view class="message-wrapper" :class="message.isMine ? 'mine' : 'other'">
						<view
							class="avatar protected-avatar"
							v-if="!message.isMine && isParentMode"
							@click="openPeerProfile"
						>
							<text class="protected-avatar-text">隐私</text>
						</view>
						<image
							class="avatar"
							:src="message.avatar"
							mode="aspectFill"
							v-else-if="!message.isMine && !isAiAvatarMode"
							@click="openPeerProfile"
						></image>

							<view class="bubble-column" :class="{ mine: message.isMine }">
								<text class="ai-message-source" v-if="isAiAvatarMode && !message.isMine">{{ getAiMessageLabel(message) }}</text>
								<view class="message-bubble" :class="message.type">
									<text class="revoked-content" v-if="message.revoked == true">消息已撤回</text>
									<view class="protected-content" v-else-if="isParentMode && message.protectedContent">
										<text class="protected-content-text">内容已保护</text>
									</view>
									<text class="text-content" v-else-if="message.type === 'text'">{{ message.content }}</text>
									<view
										v-if="isAiAvatarMode && !message.isMine && message.handoffStatus === 'pending'"
										class="ai-handoff-state"
									>
										<view class="ai-handoff-dot"></view>
										<text>演示状态：不会通知对方</text>
									</view>
								<image
									class="image-content"
									:src="message.content"
									mode="aspectFill"
									@click="previewImage(message.content)"
									v-else-if="message.type === 'image'"
								></image>
									<view class="voice-content" v-else-if="message.type === 'voice'">
										<audio class="voice-player" :src="message.content" controls></audio>
									</view>
									<video class="video-content" :src="message.content" controls v-else-if="message.type === 'video'"></video>
								</view>
								<text
									v-if="!isParentMode && message.isMine && message.id > 0 && message.status == 'sent' && message.revoked != true"
									class="revoke-action"
									@click="requestRevokeMessage(message)"
								>撤回</text>
							<text class="message-status text-muted" v-if="message.isMine && message.status === 'sending'">发送中...</text>
								<text
									class="message-status failed"
									v-else-if="message.isMine && message.status === 'failed' && message.type !== 'text' && message.mediaId == null"
								>{{ message.errorMessage != null && message.errorMessage != '' ? message.errorMessage + '，请重新选择媒体' : '媒体上传失败，请重新选择媒体' }}</text>
								<text
									class="message-status failed retryable"
									v-else-if="message.isMine && message.status === 'failed'"
									@click="retryFailedMessage(message)"
								>{{ message.errorMessage != null && message.errorMessage != '' ? message.errorMessage + '，点击重试' : '发送失败，点击重试' }}</text>
						</view>

						<view class="avatar protected-avatar" v-if="message.isMine && isParentMode">
							<text class="protected-avatar-text">子女</text>
						</view>
						<image
							class="avatar"
							:src="message.avatar"
							mode="aspectFill"
							v-else-if="message.isMine"
						></image>
					</view>
				</view>
			</scroll-view>

			<view class="input-bar" :class="{ expanded: showMore && !isAiAvatarMode, 'ai-mode': isAiAvatarMode && !isParentMode }">
				<view class="input-wrapper">
					<input
						class="input"
						:class="{ 'ai-mode': isAiAvatarMode && !isParentMode }"
						type="text"
						:value="inputText"
						@input="onInput"
						:placeholder="isAiAvatarMode ? '询问公开资料…' : '说点什么...'"
						confirm-type="send"
						@confirm="sendMessage"
					/>
					<button class="send-btn" @click="sendMessage" :disabled="sendingText || inputText.trim() == '' || (isAiAvatarMode && (aiAvatarSending || aiAvatarError != ''))">{{ isAiAvatarMode && aiAvatarSending ? '发送中…' : '发送' }}</button>
					<button v-if="!isAiAvatarMode" class="tool-btn more-toggle" @click="toggleMoreMenu">
						<text class="icon">{{ showMore ? '×' : '+' }}</text>
					</button>
				</view>
				<view v-if="isAiAvatarMode && !isParentMode" class="ai-disclaimer">
					<text>内容由 AI 生成，仅参考当前公开资料</text>
				</view>

				<view class="more-actions" v-if="showMore && !isAiAvatarMode">
						<view class="menu-grid">
							<view class="menu-item" v-if="!isParentMode" @click="chooseChatImage">
								<view class="menu-icon">▧</view>
								<text class="menu-text">图片</text>
							</view>
							<view class="menu-item" v-if="!isParentMode" @click="chooseChatVideo">
								<view class="menu-icon">▷</view>
								<text class="menu-text">视频</text>
							</view>
							<view class="menu-item" v-if="!isParentMode" @click="toggleVoiceRecording">
								<view class="menu-icon">{{ voiceRecording ? '■' : '◉' }}</view>
								<text class="menu-text">{{ voiceRecording ? '结束录音' : '语音' }}</text>
							</view>
							<view class="menu-item" v-if="!isParentMode" @click="openContactExchange">
								<view class="menu-icon">⌁</view>
								<text class="menu-text">联系方式</text>
							</view>
							<view class="menu-item" v-if="!isParentMode" @click="openAiAdvisor">
								<view class="menu-icon">✦</view>
								<text class="menu-text">AI军师</text>
							</view>
							<view class="menu-item" @click="openChatReport">
							<view class="menu-icon">⚑</view>
							<text class="menu-text">举报</text>
						</view>
					</view>
				</view>
			</view>
		</template>

			<XsaReportSheet
				v-if="!isAiAvatarMode"
			:visible="reportVisible"
			target-type="chatUser"
			:target-id="userId"
			:user-id="userId"
			:large-text="isParentMode"
			:parent-mode="isParentMode"
			:parent-context="activeParentContext"
			@close="reportVisible = false"
				@reported="reportVisible = false"
			/>

			<XsaAiAdvisorSheet
				v-if="!isParentMode && !isAiAvatarMode"
				:visible="aiAdvisorVisible"
				:target-user-id="userId"
				:initial-message="aiAdvisorInitialMessage"
				@close="aiAdvisorVisible = false"
			/>

			<XsaSheet v-if="!isParentMode && !isAiAvatarMode" :visible="contactVisible" title="联系方式交换" @close="closeContactExchange">
				<view class="contact-sheet">
					<text class="contact-note">双方已同意认识。对方明确确认前，不会显示你提交的联系方式。</text>
					<view class="contact-type-row">
						<button class="contact-type" :class="{ selected: contactType == 'phone' }" @click="contactType = 'phone'">手机号</button>
						<button class="contact-type" :class="{ selected: contactType == 'wechat' }" @click="contactType = 'wechat'">微信号</button>
					</view>
					<input v-if="contactType == 'wechat'" class="contact-input" :value="contactValue" @input="onContactValueInput" placeholder="输入你的微信号" maxlength="64" />
					<text v-else class="contact-phone-hint">将使用当前账号已绑定的手机号</text>
					<button class="contact-send" :disabled="contactSubmitting" @click="submitContactExchange">{{ contactSubmitting ? '正在发送...' : '发起交换请求' }}</button>
					<text v-if="contactError != ''" class="contact-error">{{ contactError }}</text>
					<view class="contact-loading" v-if="contactLoading">
						<text>正在读取联系方式状态...</text>
					</view>
					<view class="contact-list" v-else-if="contactExchanges.length > 0">
						<view class="contact-card" v-for="exchange in contactExchanges" :key="exchange.id">
							<view class="contact-card-copy">
								<text class="contact-card-title">{{ exchange.contactType == 'phone' ? '手机号' : '微信号' }}</text>
								<text class="contact-card-status">{{ contactExchangeStatus(exchange) }}</text>
								<text v-if="exchange.status == 'accepted' && exchange.contactValue" class="contact-value">{{ exchange.contactValue }}</text>
							</view>
							<view class="contact-card-actions" v-if="exchange.status == 'pending' && exchange.requestedByMe != true">
								<button class="contact-reject" :disabled="contactSubmitting" @click="respondToContactExchange(exchange, 'reject')">拒绝</button>
								<button class="contact-accept" :disabled="contactSubmitting" @click="respondToContactExchange(exchange, 'accept')">确认</button>
							</view>
							<button v-if="exchange.status == 'accepted' && exchange.contactValue" class="contact-copy" @click="copyContactValue(exchange.contactValue)">复制</button>
						</view>
					</view>
				</view>
			</XsaSheet>
		</view>
</template>

<script setup lang="uts">
	import XsaButton from '@/components/XsaButton.uvue'
	import XsaReportSheet from '@/components/XsaReportSheet.uvue'
	import XsaAiAdvisorSheet from '@/components/XsaAiAdvisorSheet.uvue'
	import XsaSheet from '@/components/XsaSheet.uvue'
	import type { MessageSubject, ParentContext } from '@/api'
	import {
		getChatMessages,
		getChatPermission,
		getParentAccessGate,
		getParentContext,
		sendMessage as sendMessageApi,
		uploadChatMedia,
		revokeMessage,
		getContactExchanges,
		createContactExchange,
		respondContactExchange,
		getAiAvatarProfile,
		getAiAvatarQuickQuestions,
		getAiAvatarConversation,
		sendAiAvatarMessage,
		resolveAiAvatarHandoffs,
		clearAiAvatarConversation
	} from '@/api'

	const messages = ref([] as any[])
	const inputText = ref('')
	const showMore = ref(false)
	const scrollToView = ref('')
	const loading = ref(false)
	const chatError = ref('')
	const userId = ref(0)
	const reportVisible = ref(false)
	const chatAllowed = ref(false)
	const initialMode = uni.getStorageSync('xsa_onboarding_mode')
	const roleMode = ref(initialMode != null && String(initialMode) == 'parent' ? 'parent' : 'self')
	const isParentMode = computed(() => roleMode.value == 'parent')
	const isAiAvatarMode = ref(false)
	const aiAvatarProfile = ref(null as any)
	const aiQuickQuestions = ref([] as any[])
	const aiAvatarSending = ref(false)
	const aiAvatarRestricted = ref(false)
	const aiAvatarError = ref('')
	const aiAdvisorVisible = ref(false)
	const aiAdvisorInitialMessage = ref('')
	const activeMessageSubject = ref(null as MessageSubject | null)
	const activeParentContext = ref(null as ParentContext | null)
	const chatMutationVersion = ref(0)
	const permissionLoading = ref(true)
	const permissionError = ref('双方同意后才能开始聊天')
	const sendingText = ref(false)
	const voiceRecording = ref(false)
	const contactVisible = ref(false)
	const contactLoading = ref(false)
	const contactSubmitting = ref(false)
	const contactError = ref('')
	const contactType = ref('phone')
	const contactValue = ref('')
	const contactExchanges = ref([] as any[])
	let clientMessageSequence = 0
	let permissionRequestSequence = 0
	let historyRequestSequence = 0
	let roleAccessEpoch = 0
	let roleAccessRequest: Promise<boolean> | null = null
	let roleAccessRequestEpoch = -1
	let deliveryAttemptSequence = 0
	let textSendAttemptSequence = 0
	let activeTextSendAttempt = 0
	let voiceRecorder: any = null
	let discardVoiceRecording = false
	let aiHandoffTimer: any = null

	onMounted(() => {
		setupVoiceRecorder()
		const pages = getCurrentPages()
		const currentPage = pages[pages.length - 1]
		const options = currentPage.options
		if (options != null && options.userId != null) {
			const parsedUserId = Number(options.userId)
			if (Number.isFinite(parsedUserId) && Math.floor(parsedUserId) == parsedUserId && parsedUserId > 0) {
				userId.value = parsedUserId
			}
		}
		const aiAvatarRequested = options != null && options.mode === 'ai-avatar'
		if (aiAvatarRequested) {
			if (isParentMode.value) {
				permissionLoading.value = false
				permissionError.value = '父母端不支持 AI 分身代聊'
				return
			}
			if (userId.value <= 0) {
				permissionLoading.value = false
				permissionError.value = '暂时无法获取 AI 分身资料'
				return
			}
			isAiAvatarMode.value = true
			aiAvatarRestricted.value = options != null && (options.locked === 'true' || options.locked === true)
			chatAllowed.value = true
			permissionLoading.value = false
			loadAiAvatarMode()
			return
		}
		verifyChatPermission()
	})

	onShow(() => {
		if (isAiAvatarMode.value) {
			refreshAiAvatarHistory()
			return
		}
		if (userId.value > 0) verifyChatPermission()
	})

	onUnmounted(() => {
		if (aiHandoffTimer != null) {
			clearTimeout(aiHandoffTimer)
			aiHandoffTimer = null
		}
		if (voiceRecorder != null && voiceRecording.value) {
			discardVoiceRecording = true
			voiceRecorder.stop()
		}
		voiceRecording.value = false
	})

	const retryHistory = () => {
		if (isAiAvatarMode.value) {
			loadAiAvatarMode()
			return
		}
		loadChatMessages()
	}

	const mapAiAvatarMessages = (rows: any[]): any[] => {
		return rows.map((message: any, index: number) => ({
			...message,
			time: typeof message.time == 'number' ? formatTime(message.time) : (message.time != null ? String(message.time) : ''),
			showTime: message.showTime == true || index == 0,
			avatar: message.avatar != null && String(message.avatar).length > 0
				? String(message.avatar)
				: (message.isMine == true ? '/static/portraits/profile-man-light.webp' : '/static/portraits/profile-woman-main.webp'),
			status: 'sent'
		}))
	}

	const getAiMessageLabel = (msg: any): string => {
		if (msg != null && msg.source === 'owner-answer') return '本人补充回答（演示）'
		if (msg != null && msg.source === 'mock-person') return '本人回答（模拟）'
		if (msg != null && msg.source === 'ai-avatar' && msg.handoffStatus === 'pending') return '已转交（演示）'
		return 'AI 分身'
	}

	const scheduleAiHandoff = (rows: any[]) => {
		if (!isAiAvatarMode.value || aiAvatarProfile.value == null) return
		if (aiHandoffTimer != null) clearTimeout(aiHandoffTimer)
		let dueAt = 0
		for (let index = 0; index < rows.length; index++) {
			const message = rows[index]
			if (message.handoffStatus === 'pending' && message.handoffDueAt != null) {
				const candidate = Number(message.handoffDueAt)
				if (dueAt == 0 || candidate < dueAt) dueAt = candidate
			}
		}
		if (dueAt == 0) return
		const delay = Math.max(350, dueAt - Date.now())
		aiHandoffTimer = setTimeout(async () => {
			aiHandoffTimer = null
			if (!isAiAvatarMode.value || aiAvatarProfile.value == null) return
			const resolved = await resolveAiAvatarHandoffs(userId.value, aiAvatarProfile.value)
			if (resolved.success && resolved.data != null) {
				messages.value = mapAiAvatarMessages(resolved.data as any[])
				scrollToBottom()
				scheduleAiHandoff(resolved.data as any[])
			}
		}, delay)
	}

	const loadAiAvatarMode = async () => {
		if (!isAiAvatarMode.value || isParentMode.value || userId.value <= 0) return
		loading.value = true
		aiAvatarError.value = ''
		chatError.value = ''
		try {
			const profileRes = await getAiAvatarProfile(userId.value, aiAvatarRestricted.value)
			if (!profileRes.success || profileRes.data == null) {
				aiAvatarError.value = responseMessage(profileRes, '公开资料暂时无法读取')
				chatError.value = aiAvatarError.value
				return
			}
			aiAvatarProfile.value = profileRes.data
			const name = profileRes.data.name != null ? String(profileRes.data.name) : 'Ta'
			uni.setNavigationBarTitle({ title: 'AI 分身 · ' + name })
			const quickRes = getAiAvatarQuickQuestions()
			if (quickRes.success && quickRes.data != null && Array.isArray(quickRes.data)) aiQuickQuestions.value = quickRes.data as any[]
			const historyRes = await getAiAvatarConversation(userId.value, aiAvatarProfile.value)
			if (!historyRes.success || historyRes.data == null) {
				aiAvatarError.value = responseMessage(historyRes, 'AI 分身聊天记录暂时无法读取')
				chatError.value = aiAvatarError.value
				return
			}
			messages.value = mapAiAvatarMessages(historyRes.data as any[])
			scheduleAiHandoff(historyRes.data as any[])
			scrollToBottom()
		} catch (error) {
			aiAvatarError.value = '网络或资料服务异常，请稍后重试'
			chatError.value = aiAvatarError.value
		} finally {
			loading.value = false
		}
	}

	const retryAiAvatar = () => {
		if (loading.value || userId.value <= 0) return
		loadAiAvatarMode()
	}

	const refreshAiAvatarHistory = async () => {
		if (!isAiAvatarMode.value || aiAvatarProfile.value == null) return
		const resolved = await resolveAiAvatarHandoffs(userId.value, aiAvatarProfile.value)
		if (resolved.success && resolved.data != null) {
			messages.value = mapAiAvatarMessages(resolved.data as any[])
			scheduleAiHandoff(resolved.data as any[])
			scrollToBottom()
		}
	}

	const clearAiAvatarHistory = () => {
		if (!isAiAvatarMode.value || aiAvatarSending.value || aiAvatarProfile.value == null) return
		uni.showModal({
			title: '清空 AI 分身记录',
			content: '清空后将无法在当前设备查看这段对话，确定继续吗？',
			confirmText: '清空',
		success: async (result: any) => {
				if (result.confirm !== true) return
				if (aiHandoffTimer != null) {
					clearTimeout(aiHandoffTimer)
					aiHandoffTimer = null
				}
				const cleared = await clearAiAvatarConversation(userId.value)
				if (!cleared.success) {
					uni.showToast({ title: responseMessage(cleared, '清空失败'), icon: 'none' })
					return
				}
				const history = await getAiAvatarConversation(userId.value, aiAvatarProfile.value)
				if (history.success && history.data != null) {
					messages.value = mapAiAvatarMessages(history.data as any[])
					scrollToBottom()
				}
				uni.showToast({ title: '记录已清空', icon: 'success' })
			}
		})
	}

	const askQuickQuestion = (prompt: string) => {
		if (!isAiAvatarMode.value || aiAvatarSending.value) return
		inputText.value = prompt
		sendMessage()
	}

	const sendAiAvatarText = async (content: string) => {
		if (!isAiAvatarMode.value || aiAvatarSending.value || aiAvatarProfile.value == null) return
		const question = content.trim()
		if (question.length == 0) return
		aiAvatarSending.value = true
		inputText.value = ''
		try {
			const res = await sendAiAvatarMessage(userId.value, question, aiAvatarProfile.value)
			if (!res.success || res.data == null) {
				uni.showToast({ title: responseMessage(res, '发送失败，请重试'), icon: 'none' })
				return
			}
			const rows = res.data.messages as any[]
			messages.value = mapAiAvatarMessages(rows)
			scheduleAiHandoff(rows)
			scrollToBottom()
		} catch (error) {
			uni.showToast({ title: '发送失败，请稍后重试', icon: 'none' })
		} finally {
			aiAvatarSending.value = false
		}
	}

	const responseMessage = (res: any, fallback: string): string => {
		if (res != null && res.message != null && res.message != 'success') return '' + res.message
		if (res != null && res.data != null && res.data.message != null) return '' + res.data.message
		return fallback
	}

	const subjectKey = (subject: MessageSubject | null): string => {
		if (subject == null) return ''
		if (subject.mode == 'parent') return 'parent-' + (subject.childId != null ? subject.childId : 0)
		return 'self'
	}

	const clearChatSensitiveState = (
		message: string = '',
		clearSubject: boolean = true,
		preservePermissionRequest: boolean = false
	) => {
		roleAccessEpoch += 1
		roleAccessRequest = null
		roleAccessRequestEpoch = -1
		chatMutationVersion.value += 1
		historyRequestSequence += 1
		if (!preservePermissionRequest) permissionRequestSequence += 1
		messages.value = []
		inputText.value = ''
		showMore.value = false
		scrollToView.value = ''
		loading.value = false
		chatError.value = ''
		chatAllowed.value = false
			reportVisible.value = false
			contactVisible.value = false
			contactLoading.value = false
			contactSubmitting.value = false
			contactError.value = ''
			contactValue.value = ''
			contactExchanges.value = []
			sendingText.value = false
		activeTextSendAttempt = 0
		permissionLoading.value = false
		if (clearSubject) {
			activeMessageSubject.value = null
			activeParentContext.value = null
		}
		if (message != '') permissionError.value = message
	}

	const activateMessageSubject = (subject: MessageSubject) => {
		const previousKey = subjectKey(activeMessageSubject.value)
		const nextKey = subjectKey(subject)
		if (previousKey != '' && previousKey != nextKey) clearChatSensitiveState('', true, true)
		activeMessageSubject.value = subject
	}

	const isUnauthorizedResponse = (res: any): boolean => {
		if (res == null) return false
		if (res.code != null && String(res.code) == '401') return true
		return res.data != null && res.data.code != null && String(res.data.code) == '401'
	}

	const handleSubjectUnauthorizedResponse = (res: any, requestSubjectKey: string): boolean => {
		if (!isUnauthorizedResponse(res)) return false
		if (requestSubjectKey != subjectKey(activeMessageSubject.value)) return false
		clearChatSensitiveState(responseMessage(res, '登录状态已失效，请重新登录'), true)
		return true
	}

	const fetchParentRoleAccess = async (requestEpoch: number): Promise<boolean> => {
		try {
			const contextRes = await getParentContext()
			if (requestEpoch != roleAccessEpoch) return false
			const latestStoredMode = uni.getStorageSync('xsa_onboarding_mode')
			if (latestStoredMode == null || String(latestStoredMode) != 'parent') {
				clearChatSensitiveState('当前账号已切换身份，请重新进入会话', true)
				return false
			}
			if (contextRes == null || contextRes.success != true || contextRes.data == null) {
				clearChatSensitiveState(responseMessage(contextRes, '暂时无法确认父母端访问权限'), true)
				return false
			}
			const context = contextRes.data as ParentContext
			const gate = getParentAccessGate(context)
			if (gate == null || gate.allowed != true) {
				const message = gate != null && gate.message != null
					? '' + gate.message
					: '父母端访问条件已失效'
				clearChatSensitiveState(message, true)
				return false
			}
			if (context.child == null) {
				clearChatSensitiveState('请先取得子女授权', true)
				return false
			}
			const childId = Number(context.child.id)
			if (!Number.isFinite(childId) || Math.floor(childId) != childId || childId <= 0) {
				clearChatSensitiveState('授权子女主体无效', true)
				return false
			}
			activateMessageSubject({ mode: 'parent', childId: childId } as MessageSubject)
			activeParentContext.value = context
			return true
		} catch (error) {
			if (requestEpoch != roleAccessEpoch) return false
			clearChatSensitiveState('暂时无法确认父母端访问权限', true)
			return false
		}
	}

	const confirmRoleAccess = async (): Promise<boolean> => {
		const storedMode = uni.getStorageSync('xsa_onboarding_mode')
		if (storedMode == null || String(storedMode) != 'parent') {
			roleMode.value = 'self'
			activateMessageSubject({ mode: 'self' } as MessageSubject)
			activeParentContext.value = null
			return true
		}
		roleMode.value = 'parent'
		const requestEpoch = roleAccessEpoch
		const existingRequest = roleAccessRequest
		if (existingRequest != null && roleAccessRequestEpoch == requestEpoch) {
			return await existingRequest
		}
		const request = fetchParentRoleAccess(requestEpoch)
		roleAccessRequest = request
		roleAccessRequestEpoch = requestEpoch
		try {
			return await request
		} finally {
			if (roleAccessRequest == request) {
				roleAccessRequest = null
				roleAccessRequestEpoch = -1
			}
		}
	}

	const isPermissionRequestCurrent = (
		requestId: number,
		requestVersion: number,
		requestSubjectKey: string
	): boolean => {
		return requestId == permissionRequestSequence &&
			requestVersion == chatMutationVersion.value &&
			requestSubjectKey == subjectKey(activeMessageSubject.value)
	}

	const verifyChatPermission = async () => {
		const requestId = permissionRequestSequence + 1
		permissionRequestSequence = requestId
		chatAllowed.value = false
		permissionLoading.value = true
		permissionError.value = '双方同意后才能开始聊天'
		try {
			if (!Number.isFinite(userId.value) || Math.floor(userId.value) != userId.value || userId.value <= 0) {
				clearChatSensitiveState('无效的聊天对象', true)
				return
			}
			if (!await confirmRoleAccess()) return
			if (requestId != permissionRequestSequence) return
			const subject = activeMessageSubject.value
			if (subject == null) {
				clearChatSensitiveState('暂时无法确认聊天主体', true)
				return
			}
			const requestVersion = chatMutationVersion.value
			const requestSubjectKey = subjectKey(subject)
			const res = await getChatPermission(userId.value, subject)
			if (handleSubjectUnauthorizedResponse(res, requestSubjectKey)) return
			if (!isPermissionRequestCurrent(requestId, requestVersion, requestSubjectKey)) return
			const permission = res != null ? res.data : null
			if (res != null && res.success == true && permission != null && permission.canChat == true) {
				chatAllowed.value = true
				permissionError.value = ''
				await loadChatMessages(true)
				return
			}
			const message = permission != null && permission.reason != null
				? '' + permission.reason
				: responseMessage(res, '暂时无法确认聊天权限')
			clearChatSensitiveState(message, false)
		} catch (error) {
			if (requestId == permissionRequestSequence) {
				chatAllowed.value = false
				permissionError.value = '暂时无法确认聊天权限，请稍后重试'
			}
		} finally {
			if (requestId == permissionRequestSequence) permissionLoading.value = false
		}
	}

	const retryPermission = () => {
		verifyChatPermission()
	}

	const isProtectedMediaMessage = (message: any): boolean => {
		if (!isParentMode.value || message == null) return false
		if (message.protectedContent == true) return true
		const type = message.type != null ? String(message.type).toLowerCase() : ''
		if (type != '' && type != 'text') return true
		if (message.content != null && typeof message.content != 'string') return true
		if (typeof message.content == 'string') {
			const content = message.content.trim().toLowerCase()
			if (
				content.indexOf('://') >= 0 ||
				content.indexOf('data:') == 0 ||
				content.indexOf('blob:') == 0 ||
				content.indexOf('file:') == 0 ||
				content.indexOf('wxfile:') == 0 ||
				content.indexOf('/') == 0 ||
				content.indexOf('./') == 0 ||
				content.indexOf('../') == 0 ||
				content.indexOf('private/') == 0 ||
				content.indexOf('media/') == 0 ||
				content.indexOf('images/') == 0 ||
				content.indexOf('photos/') == 0 ||
				content.indexOf('uploads/') == 0 ||
				content.indexOf('assets/') == 0 ||
				content.indexOf('static/') == 0
			) return true
		}
		return message.imageUrl != null ||
			message.fileUrl != null ||
			message.attachmentUrl != null ||
			message.mediaUrl != null ||
			message.preview != null ||
			message.previewUrl != null ||
			message.cover != null ||
			message.coverUrl != null ||
			message.poster != null ||
			message.posterUrl != null ||
			message.attachment != null ||
			message.attachments != null ||
			message.media != null
	}

	const isHistoryRequestCurrent = (
		requestId: number,
		requestVersion: number,
		requestSubjectKey: string
	): boolean => {
		return requestId == historyRequestSequence &&
			requestVersion == chatMutationVersion.value &&
			requestSubjectKey == subjectKey(activeMessageSubject.value)
	}

	const loadChatMessages = async (force: boolean = false): Promise<boolean> => {
		if (!chatAllowed.value || (!force && loading.value)) return false
		if (force) loading.value = false
		const requestId = historyRequestSequence + 1
		historyRequestSequence = requestId
		if (!await confirmRoleAccess()) {
			if (requestId == historyRequestSequence) chatAllowed.value = false
			return false
		}
		if (requestId != historyRequestSequence || !chatAllowed.value) return false
		const subject = activeMessageSubject.value
		if (subject == null) {
			clearChatSensitiveState('暂时无法确认聊天主体', true)
			return false
		}
		const requestVersion = chatMutationVersion.value
		const requestSubjectKey = subjectKey(subject)
		loading.value = true
		chatError.value = ''
		try {
			const res = await getChatMessages(
				userId.value,
				isParentMode.value ? 'protected' : 'standard',
				subject
			)
			if (handleSubjectUnauthorizedResponse(res, requestSubjectKey)) return false
			if (!isHistoryRequestCurrent(requestId, requestVersion, requestSubjectKey)) return false
			if (res == null || res.success != true || res.data == null) {
				const message = responseMessage(res, '聊天记录加载失败')
				if (res != null && res.code == 'CHAT_NOT_ALLOWED') {
					clearChatSensitiveState(message, false)
					return false
				}
				throw new Error(message)
			}
			const list = res.data as any[]
			const serverMessages = list.map((message: any, index: number) => {
				const protectedContent = isProtectedMediaMessage(message)
				return {
					id: message.id,
					clientMessageId: message.clientMessageId,
					type: message.type,
					content: protectedContent ? '' : message.content,
					time: message.timeLabel != null ? message.timeLabel : formatTime(message.time),
					showTime: message.showTime == true || index == 0,
					isMine: message.isMine,
					avatar: isParentMode.value ? '' : (message.senderAvatar != null ? message.senderAvatar : message.avatar),
					protectedContent: protectedContent,
					revoked: message.revoked == true,
					status: message.isMine == true ? 'sent' : '',
					subjectKey: requestSubjectKey
				}
			})
			const unsentLocal = messages.value.filter((message: any) => {
				return message.isMine == true &&
					message.clientMessageId != null &&
					message.clientMessageId != '' &&
					message.status != 'sent' &&
					message.subjectKey == requestSubjectKey
			})
			unsentLocal.forEach((message: any) => {
				const exists = serverMessages.some((serverMessage: any) => {
					return serverMessage.clientMessageId == message.clientMessageId
				})
				if (!exists) {
					serverMessages.push(isParentMode.value
						? { ...message, avatar: '', protectedAvatar: true }
						: message)
				}
			})
			messages.value = serverMessages
			scrollToBottom()
			return true
		} catch (error: any) {
			if (isHistoryRequestCurrent(requestId, requestVersion, requestSubjectKey)) {
				chatError.value = error != null && error.message != null ? '' + error.message : '聊天记录加载失败，请重试'
			}
			return false
		} finally {
			if (isHistoryRequestCurrent(requestId, requestVersion, requestSubjectKey)) loading.value = false
		}
	}

	const formatTime = (timestamp: number): string => {
		const date = new Date(timestamp)
		const hours = date.getHours().toString().padStart(2, '0')
		const minutes = date.getMinutes().toString().padStart(2, '0')
		return `${hours}:${minutes}`
	}

	const onInput = (event: InputEvent) => {
		inputText.value = event.detail.value
	}

	const createClientMessageId = (): string => {
		clientMessageSequence += 1
		return 'chat-' + userId.value + '-' + Date.now() + '-' + clientMessageSequence
	}

	const isDeliveryAttemptCurrent = (
		message: any,
		attemptId: number,
		expectedVersion: number,
		expectedSubjectKey: string
	): boolean => {
		return message.deliveryAttemptId == attemptId &&
			expectedVersion == chatMutationVersion.value &&
			expectedSubjectKey == subjectKey(activeMessageSubject.value)
	}

	const confirmPermissionForSend = async (
		message: any,
		attemptId: number,
		expectedVersion: number,
		expectedSubjectKey: string
	): Promise<boolean> => {
		try {
			if (!await confirmRoleAccess()) {
				if (isDeliveryAttemptCurrent(message, attemptId, expectedVersion, expectedSubjectKey)) {
					chatAllowed.value = false
				}
				return false
			}
			if (!isDeliveryAttemptCurrent(message, attemptId, expectedVersion, expectedSubjectKey)) return false
			const subject = activeMessageSubject.value
			if (subject == null || subjectKey(subject) != expectedSubjectKey) {
				chatAllowed.value = false
				permissionError.value = '聊天主体已变更，请重新进入会话'
				return false
			}
			const res = await getChatPermission(userId.value, subject)
			if (handleSubjectUnauthorizedResponse(res, expectedSubjectKey)) return false
			if (!isDeliveryAttemptCurrent(message, attemptId, expectedVersion, expectedSubjectKey)) return false
			const permission = res != null ? res.data : null
			if (res != null && res.success == true && permission != null && permission.canChat == true) {
				return true
			}
			chatAllowed.value = false
			permissionError.value = permission != null && permission.reason != null
				? '' + permission.reason
				: '聊天权限已变更，请重新确认'
			clearChatSensitiveState(permissionError.value, false)
			return false
		} catch (error) {
			if (isDeliveryAttemptCurrent(message, attemptId, expectedVersion, expectedSubjectKey)) {
				clearChatSensitiveState('暂时无法确认聊天权限，请重新确认', false)
			}
			return false
		}
	}

	const deliverMessage = async (message: any) => {
		if (message.status === 'sending') return
		const expectedSubjectKey = message.subjectKey != null ? String(message.subjectKey) : ''
		const expectedVersion = chatMutationVersion.value
		const attemptId = deliveryAttemptSequence + 1
		deliveryAttemptSequence = attemptId
		message.deliveryAttemptId = attemptId
		message.status = 'sending'
		message.errorMessage = ''
		const stillAllowed = await confirmPermissionForSend(
			message,
			attemptId,
			expectedVersion,
			expectedSubjectKey
		)
		if (!isDeliveryAttemptCurrent(message, attemptId, expectedVersion, expectedSubjectKey)) return
		if (!stillAllowed) {
			message.status = 'failed'
			message.errorMessage = '聊天权限确认失败'
			return
		}
		const subject = activeMessageSubject.value
		if (subject == null || subjectKey(subject) != expectedSubjectKey) {
			message.status = 'failed'
			message.errorMessage = '聊天主体已变更'
			return
		}
		try {
			const res = await sendMessageApi(
				userId.value,
				message.content,
				message.type,
					message.clientMessageId,
					subject,
					message.mediaId != null ? Number(message.mediaId) : null
			)
			if (handleSubjectUnauthorizedResponse(res, expectedSubjectKey)) return
			if (!isDeliveryAttemptCurrent(message, attemptId, expectedVersion, expectedSubjectKey)) return
			const result = res != null ? res.data : null
			if (res == null || res.success != true || result == null || result.success != true) {
				message.status = 'failed'
				message.errorMessage = responseMessage(res, '发送失败')
				if (res != null && res.code == 'CHAT_NOT_ALLOWED') {
					clearChatSensitiveState(message.errorMessage, false)
				}
				return
			}
			if (result.messageId != null) message.id = result.messageId
			message.status = 'sent'
		} catch (error) {
			if (isDeliveryAttemptCurrent(message, attemptId, expectedVersion, expectedSubjectKey)) {
				message.status = 'failed'
				message.errorMessage = '网络异常，发送失败'
			}
		}
	}

	const sendMessage = async () => {
		const content = inputText.value.trim()
		if (content == '' || sendingText.value || !chatAllowed.value) return
		if (isAiAvatarMode.value) {
			await sendAiAvatarText(content)
			return
		}
		const subject = activeMessageSubject.value
		if (subject == null) return
		const textAttemptId = textSendAttemptSequence + 1
		textSendAttemptSequence = textAttemptId
		activeTextSendAttempt = textAttemptId
		sendingText.value = true
		const message = {
			id: 0,
			clientMessageId: createClientMessageId(),
			type: 'text',
			content: content,
			time: getCurrentTime(),
			showTime: false,
			isMine: true,
			avatar: isParentMode.value ? '' : '/static/portraits/profile-man-light.webp',
			status: 'queued',
			errorMessage: '',
			subjectKey: subjectKey(subject)
		}
		messages.value.push(message)
		inputText.value = ''
		scrollToBottom()
		try {
			await deliverMessage(message)
		} finally {
			if (activeTextSendAttempt == textAttemptId) {
				activeTextSendAttempt = 0
				sendingText.value = false
			}
		}
	}

		const retryFailedMessage = async (message: any) => {
			if (message.status !== 'failed' || !chatAllowed.value) return
			await deliverMessage(message)
		}

		const sendMediaFile = async (filePath: string, type: string) => {
			if (isParentMode.value || !chatAllowed.value || filePath == '') return
			const subject = activeMessageSubject.value
			if (subject == null) return
			closeMoreMenu()
			const message = {
				id: 0,
				clientMessageId: createClientMessageId(),
				type: type,
				content: filePath,
				mediaId: null,
				time: getCurrentTime(),
				showTime: false,
				isMine: true,
				avatar: '/static/portraits/profile-man-light.webp',
				status: 'sending',
				errorMessage: '',
				subjectKey: subjectKey(subject)
			}
			messages.value.push(message)
			scrollToBottom()
			let uploadRes: any = null
			try {
				uploadRes = await uploadChatMedia(userId.value, filePath, subject)
			} catch (error) {
				message.status = 'failed'
				message.errorMessage = '媒体上传失败'
				return
			}
			if (uploadRes == null || uploadRes.success != true || uploadRes.data == null || Number(uploadRes.data.id) <= 0) {
				message.status = 'failed'
				message.errorMessage = responseMessage(uploadRes, '媒体上传失败')
				return
			}
			message.mediaId = Number(uploadRes.data.id)
			if (uploadRes.data.url != null && '' + uploadRes.data.url != '') message.content = '' + uploadRes.data.url
			message.status = 'queued'
			await deliverMessage(message)
		}

		const chooseChatImage = () => {
			if (isParentMode.value) return
			uni.chooseImage({
				count: 1,
				sizeType: ['compressed'],
				sourceType: ['album', 'camera'],
				success: (res: any) => {
					const paths = res != null ? res.tempFilePaths : null
					if (paths != null && paths.length > 0) sendMediaFile('' + paths[0], 'image')
				}
			})
		}

		const chooseChatVideo = () => {
			if (isParentMode.value) return
			uni.chooseVideo({
				sourceType: ['album', 'camera'],
				compressed: true,
				success: (res: any) => {
					const path = res != null && res.tempFilePath != null ? '' + res.tempFilePath : ''
					if (path != '') sendMediaFile(path, 'video')
				}
			})
		}

		const setupVoiceRecorder = () => {
			// #ifdef MP-WEIXIN
			voiceRecorder = uni.getRecorderManager()
			voiceRecorder.onStop((res: any) => {
				voiceRecording.value = false
				if (discardVoiceRecording) {
					discardVoiceRecording = false
					return
				}
				const path = res != null && res.tempFilePath != null ? '' + res.tempFilePath : ''
				if (path != '') sendMediaFile(path, 'voice')
			})
			voiceRecorder.onError(() => {
				voiceRecording.value = false
				uni.showToast({ title: '录音失败，请检查麦克风权限', icon: 'none' })
			})
			// #endif
		}

		const toggleVoiceRecording = () => {
			if (isParentMode.value) return
			// #ifdef MP-WEIXIN
			if (voiceRecorder == null) {
				uni.showToast({ title: '录音功能暂不可用', icon: 'none' })
				return
			}
			if (voiceRecording.value) {
				voiceRecorder.stop()
			} else {
				discardVoiceRecording = false
				voiceRecording.value = true
				voiceRecorder.start({ duration: 60000, format: 'mp3' })
			}
			// #endif
			// #ifndef MP-WEIXIN
			uni.showToast({ title: '请在微信小程序中使用录音', icon: 'none' })
			// #endif
		}

		const contactCommandId = (operation: string, id: number = 0): string => {
			return 'contact-' + operation + '-' + id + '-' + Date.now() + '-' + createClientMessageId()
		}

		const loadContactExchanges = async () => {
			if (isParentMode.value || !chatAllowed.value) return
			const subject = activeMessageSubject.value
			if (subject == null) return
			contactLoading.value = true
			contactError.value = ''
			try {
				const res = await getContactExchanges(userId.value, subject)
				if (res != null && res.success == true && Array.isArray(res.data)) {
					contactExchanges.value = res.data
					return
				}
				contactError.value = responseMessage(res, '联系方式状态加载失败')
			} catch (error) {
				contactError.value = '联系方式状态加载失败'
			} finally {
				contactLoading.value = false
			}
		}

		const openContactExchange = () => {
			if (isParentMode.value) return
			closeMoreMenu()
			contactVisible.value = true
			loadContactExchanges()
		}

		const closeContactExchange = () => {
			contactVisible.value = false
			contactError.value = ''
		}

		const onContactValueInput = (event: InputEvent) => {
			contactValue.value = event.detail.value
		}

		const contactExchangeStatus = (exchange: any): string => {
			if (exchange.status == 'accepted') return '已确认，双方可见'
			if (exchange.status == 'rejected') return '对方未同意'
			return exchange.requestedByMe == true ? '等待对方确认' : '等待你的确认'
		}

		const submitContactExchange = async () => {
			if (contactSubmitting.value || isParentMode.value) return
			const subject = activeMessageSubject.value
			if (subject == null) return
			contactSubmitting.value = true
			contactError.value = ''
			try {
				const res = await createContactExchange(
					userId.value, contactType.value, contactValue.value.trim(), contactCommandId('create'), subject
				)
				if (res == null || res.success != true) {
					contactError.value = responseMessage(res, '联系方式请求发送失败')
					return
				}
				contactValue.value = ''
				await loadContactExchanges()
			} finally {
				contactSubmitting.value = false
			}
		}

		const respondToContactExchange = async (exchange: any, action: string) => {
			if (contactSubmitting.value || exchange == null || isParentMode.value) return
			const subject = activeMessageSubject.value
			if (subject == null) return
			contactSubmitting.value = true
			contactError.value = ''
			try {
				const res = await respondContactExchange(Number(exchange.id), action, contactCommandId(action, Number(exchange.id)), subject)
				if (res == null || res.success != true) {
					contactError.value = responseMessage(res, '联系方式请求处理失败')
					return
				}
				await loadContactExchanges()
			} finally {
				contactSubmitting.value = false
			}
		}

		const copyContactValue = (value: string) => {
			uni.setClipboardData({ data: value, success: () => uni.showToast({ title: '已复制', icon: 'success' }) })
		}

		const requestRevokeMessage = (message: any) => {
			if (isParentMode.value || message == null || message.id <= 0 || message.revoked == true) return
			uni.showModal({
				title: '撤回消息',
				content: '撤回后对方将看到“消息已撤回”。',
				confirmText: '确认撤回',
				success: async (result: any) => {
					if (result == null || result.confirm != true) return
					const subject = activeMessageSubject.value
					if (subject == null) return
					const res = await revokeMessage(Number(message.id), 'revoke-' + message.id + '-' + Date.now(), subject)
					if (res != null && res.success == true) {
						message.revoked = true
						message.type = 'text'
						message.content = '消息已撤回'
						return
					}
					uni.showToast({ title: responseMessage(res, '撤回失败，请重试'), icon: 'none' })
				}
			})
		}

		const previewImage = (url: string) => {
		const images = messages.value
			.filter((message: any) => message.type === 'image')
			.map((message: any) => message.content)
		uni.previewImage({ current: url, urls: images })
	}

	const toggleMoreMenu = () => {
		if (isAiAvatarMode.value) return
		showMore.value = !showMore.value
	}

	const closeMoreMenu = () => {
		showMore.value = false
	}

	const openPeerProfile = () => {
		if (isAiAvatarMode.value) return
		if (userId.value <= 0) {
			uni.showToast({ title: '暂时无法获取对方资料', icon: 'none' })
			return
		}
		if (isParentMode.value) {
			uni.navigateTo({ url: '/pages/parent/user-detail?id=' + userId.value })
			return
		}
			uni.navigateTo({ url: '/pages/user/detail?userId=' + userId.value })
	}

	const openChatReport = () => {
		if (isAiAvatarMode.value) return
		closeMoreMenu()
		reportVisible.value = true
	}

	const openAiAdvisor = () => {
		if (isParentMode.value || isAiAvatarMode.value) return
		closeMoreMenu()
		let latestPeerMessage = ''
		const rows = messages.value as any[]
		for (let index = rows.length - 1; index >= 0; index--) {
			const message = rows[index]
			if (message != null && message.isMine !== true && message.type === 'text' && message.content != null && String(message.content).trim().length > 0) {
				latestPeerMessage = String(message.content).trim()
				break
			}
		}
		aiAdvisorInitialMessage.value = latestPeerMessage.length > 0 ? latestPeerMessage : inputText.value.trim()
		aiAdvisorVisible.value = true
	}

	const scrollToBottom = () => {
		if (messages.value.length === 0) return
		setTimeout(() => {
			scrollToView.value = 'msg-' + (messages.value.length - 1)
		}, 100)
	}

	const getCurrentTime = (): string => {
		const now = new Date()
		const hours = now.getHours().toString().padStart(2, '0')
		const minutes = now.getMinutes().toString().padStart(2, '0')
		return `${hours}:${minutes}`
	}
</script>

<style scoped>
