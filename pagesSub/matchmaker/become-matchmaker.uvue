}

/* ===== 右上角快捷入口（与返回键同高，位于操作行右端；该行已避开胶囊带） ===== */
.nav-entries { position: absolute; right: 20rpx; top: calc(var(--status-bar-height) + 84rpx); height: 56rpx; display: flex; flex-direction: row; align-items: center; gap: 26rpx; }
.nav-entry { width: 64rpx; height: 56rpx; display: flex; align-items: center; justify-content: center; }
.nav-entry:active { opacity: 0.6; }
.entry-person { position: relative; width: 40rpx; height: 40rpx; }
.entry-person-head { position: absolute; left: 11rpx; top: 0; width: 18rpx; height: 18rpx; border: 3rpx solid var(--ink); border-radius: 50%; box-sizing: border-box; }
.entry-person-body { position: absolute; left: 3rpx; bottom: 0; width: 34rpx; height: 16rpx; border: 3rpx solid var(--ink); border-bottom: none; border-radius: 17rpx 17rpx 0 0; box-sizing: border-box; }
.entry-person-dot { position: absolute; right: -3rpx; bottom: -3rpx; width: 15rpx; height: 15rpx; border-radius: 50%; background: var(--sage); border: 2rpx solid var(--paper); box-sizing: border-box; }
.entry-lines { width: 36rpx; display: flex; flex-direction: column; gap: 7rpx; }
.entry-lines view { height: 4rpx; border-radius: 2rpx; background: var(--ink); }

/* ===== 滚动区域 ===== */
.workspace-scroller { flex: 1; height: 0; background: var(--canvas); }
.workspace-content { min-height: 100%; padding: 20rpx 22rpx 130rpx; background: var(--canvas); }
.workspace-heading { padding: 8rpx 4rpx 18rpx; display: flex; flex-direction: column; gap: 5rpx; }
.workspace-title { font-size: 32rpx; font-weight: 800; color: var(--ink); }.workspace-copy,.workspace-muted { font-size: 20rpx; color: var(--muted); }
.workspace-tabs { height: 74rpx; display: flex; background: var(--surface); border-radius: 20rpx 20rpx 0 0; }.workspace-tab { flex: 1; position: relative; display: flex; align-items: center; justify-content: center; font-size: 21rpx; white-space: nowrap; }.workspace-tab.active { color: var(--accent2); font-weight: 800; }.workspace-tab.active:after { content: ''; position: absolute; bottom: 0; width: 42rpx; height: 6rpx; border-radius: 99rpx; background: var(--accent); }
.workspace-search { height: 70rpx; margin: 18rpx 0; padding: 0 7rpx 0 18rpx; border: 1rpx solid var(--line); background: var(--surface); border-radius: 14rpx; display: flex; align-items: center; gap: 10rpx; font-size: 30rpx; color: var(--muted); box-shadow: var(--shadow-sm); }.workspace-search input { flex: 1; min-width: 0; font-size: 22rpx; color: var(--ink); }.workspace-search-submit { width: 92rpx; height: 56rpx; border-radius: 14rpx; background: var(--accent); color: var(--paper); display: flex; align-items: center; justify-content: center; }.workspace-search-glyph { font-size: 34rpx; line-height: 1; font-weight: 700; color: inherit; }
.workspace-cash { min-height: 254rpx; padding: 30rpx; position: relative; border-radius: 20rpx; background: var(--accent-bg); display: flex; flex-direction: column; gap: 12rpx; color: var(--ink2); font-size: 23rpx; }.workspace-cash-value { font-size: 56rpx; color: var(--ink); font-weight: 800; }.workspace-cash > view { position: absolute; top: 40rpx; right: 26rpx; padding: 14rpx 24rpx; border-radius: 999rpx; background: var(--surface); color: var(--accent2); font-size: 21rpx; font-weight: 800; }
.workspace-notice,.workspace-promotion { margin-top: 20rpx; padding: 22rpx; border-radius: 20rpx; background: var(--surface); display: flex; flex-direction: column; gap: 10rpx; color: var(--ink2); font-size: 21rpx; line-height: 1.55; box-shadow: var(--shadow-sm); }.workspace-notice-title { font-size: 25rpx; color: var(--ink); font-weight: 800; }.workspace-promotion { background: var(--sage-soft); color: var(--accent2); font-weight: 800; }.workspace-promotion > view { display: flex; gap: 12rpx; }.workspace-promotion > view text { flex: 1; padding: 12rpx 8rpx; border-radius: 999rpx; background: var(--surface); text-align: center; font-size: 19rpx; }
.workspace-commission-row { margin-top: 18rpx; color: var(--muted); font-size: 20rpx; }.workspace-commission-row > view { margin-top: 8rpx; padding: 20rpx; border-radius: 20rpx; background: var(--surface); display: flex; align-items: center; gap: 16rpx; box-shadow: var(--shadow-sm); }.workspace-commission-row image,.workspace-member-header image,.workspace-match-person image { width: 60rpx; height: 60rpx; border-radius: 50%; }.workspace-commission-row > view > view { flex: 1; display: flex; flex-direction: column; gap: 4rpx; color: var(--ink); font-size: 21rpx; }.workspace-commission-row > view > view text:last-child { color: var(--muted); font-size: 19rpx; }.workspace-commission-row > view > text:last-child { color: var(--accent2); font-size: 27rpx; font-weight: 800; }
.workspace-info-card,.workspace-match-card { margin-top: 18rpx; padding: 22rpx; border-radius: 20rpx; background: var(--surface); display: flex; flex-direction: column; gap: 16rpx; color: var(--ink); font-size: 28rpx; font-weight: 800; box-shadow: var(--shadow-sm); }.workspace-info-card > view:not(.workspace-actions):not(.workspace-member-header) { padding-bottom: 13rpx; border-bottom: 1px solid var(--line); display: flex; justify-content: space-between; color: var(--ink2); font-size: 21rpx; font-weight: 400; }.workspace-info-card > view:not(.workspace-actions):not(.workspace-member-header) text:last-child { color: var(--ink); }.workspace-actions { display: flex; gap: 9rpx; }.workspace-actions text { flex: 1; padding: 12rpx 4rpx; border-radius: 14rpx; background: var(--warm); color: var(--accent2); text-align: center; font-size: 18rpx; font-weight: 700; }
