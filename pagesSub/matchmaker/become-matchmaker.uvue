const toggleMemberTag = (tag: string) => {
	const current = memberEntry.value.tags != null ? (memberEntry.value.tags as string[]) : []
	const has = current.indexOf(tag) >= 0
	if (has) {
		memberEntry.value.tags = current.filter((t: string) => t != tag)
		return
	}
	let next = current.concat([tag])
	// 职业性质互斥：同类只保留最后选中的一个
	for (let i = 0; i < memberExclusiveTagGroups.length; i++) {
		const group = memberExclusiveTagGroups[i]
		const picked = next.filter((t: string) => group.indexOf(t) >= 0)
		if (picked.length > 1) {
			next = next.filter((t: string) => group.indexOf(t) < 0 || t == picked[picked.length - 1])
		}
	}
	memberEntry.value.tags = next
}
// 居住地省市区三级选择
interface MemberRegionOption { code: string; name: string }
const memberResidenceProvinces = ref<MemberRegionOption[]>([])
const memberResidenceCities = ref<MemberRegionOption[]>([])
const memberResidenceDistricts = ref<MemberRegionOption[]>([])
const memberResidencePickerVisible = ref(false)
const memberResidencePickerLoading = ref(false)
const memberResidenceCol = ref(0)
const memberResidenceValue = ref<number[]>([0, 0, 0])
const memberRegionTarget = ref('residence')
const memberResidenceRange = computed((): string[][] => [
	memberResidenceProvinces.value.map((r: MemberRegionOption) => r.name),
	memberResidenceCities.value.map((r: MemberRegionOption) => r.name),
	memberResidenceDistricts.value.map((r: MemberRegionOption) => r.name)
])
const normalizeMemberRegion = (source: any): MemberRegionOption[] => {
	const items = source != null && source.items != null ? (source.items as any[]) : []
	return items.map((item: any): MemberRegionOption => ({ code: item.code != null ? String(item.code) : '', name: item.name != null ? String(item.name) : '' })).filter((r: MemberRegionOption) => r.code.length > 0 && r.name.length > 0)
}
const loadMemberResidenceDistricts = async (cityIndex: number) => {
	const city = memberResidenceCities.value[cityIndex]
	if (city == null) { memberResidenceDistricts.value = []; memberResidenceValue.value = [memberResidenceValue.value[0], cityIndex, 0]; return }
	try {
		const resp = await getRegionDistricts(city.code)
		memberResidenceDistricts.value = resp.success ? normalizeMemberRegion(resp.data) : []
	} catch (e) {
		memberResidenceDistricts.value = []
	}
	memberResidenceValue.value = [memberResidenceValue.value[0], cityIndex, 0]
}
const loadMemberResidenceCities = async (provinceIndex: number) => {
	const province = memberResidenceProvinces.value[provinceIndex]
	if (province == null) { memberResidenceCities.value = []; memberResidenceDistricts.value = []; return }
	try {
		const resp = await getRegionCities(province.code)
		memberResidenceCities.value = resp.success ? normalizeMemberRegion(resp.data) : []
	} catch (e) {
		memberResidenceCities.value = []
	}
	memberResidenceDistricts.value = []
	memberResidenceValue.value = [provinceIndex, 0, 0]
	await loadMemberResidenceDistricts(0)
}
const openMemberResidencePicker = async (target: string = 'residence') => {
	memberRegionTarget.value = target
	if (memberResidenceProvinces.value.length == 0) {
		memberResidencePickerLoading.value = true
		try {
			const resp = await getRegionProvinces()
			memberResidenceProvinces.value = resp.success ? normalizeMemberRegion(resp.data) : []
			if (memberResidenceProvinces.value.length > 0) await loadMemberResidenceCities(0)
		} catch (e) {
			memberResidenceProvinces.value = []
		} finally {
			memberResidencePickerLoading.value = false
		}
	}
	memberResidencePickerVisible.value = true
}
const onMemberResidenceColumnChange = async (event: any) => {
	const column = Number(event.detail.column)
	const value = Number(event.detail.value)
	memberResidenceCol.value = column
	if (column == 0) {
		if (value != memberResidenceValue.value[0]) await loadMemberResidenceCities(value)
	} else if (column == 1) {
		if (value != memberResidenceValue.value[1]) await loadMemberResidenceDistricts(value)
	} else {
		memberResidenceValue.value = [memberResidenceValue.value[0], memberResidenceValue.value[1], value]
	}
}
const onMemberResidenceChange = (event: any) => {
	const val = event.detail.value as number[]
	memberResidenceValue.value = val
	const p = memberResidenceProvinces.value[val[0]]
	const c = memberResidenceCities.value[val[1]]
	const d = memberResidenceDistricts.value[val[2] != null ? val[2] : 0]
	if (p == null) return
	const parts = [p.name]
	if (c != null && c.name != p.name) parts.push(c.name)
	if (d != null) {
		const cityName = c != null ? c.name : ''
		if (d.name != cityName) parts.push(d.name)
	}
	memberEntry.value[memberRegionTarget.value] = parts.join(' ')
}
const closeMemberResidencePicker = () => { memberResidencePickerVisible.value = false }
const memberRegionPickerTitle = computed((): string => memberRegionTarget.value == 'household' ? '选择户口所在地' : '选择省市区')
const memberRegionPickerValue = computed((): string => {
	const current = memberEntry.value[memberRegionTarget.value]
	return current != null && String(current).length > 0 ? String(current) : '点击选择省市区'
})
const memberEthnicityIndex = computed((): number => {
	const idx = memberEthnicityOptions.indexOf(memberEntry.value.ethnicity)
	return idx >= 0 ? idx : 0
})
const onMemberEthnicityChange = (event: any) => {
	const val = Number(event.detail.value)
	memberEntry.value.ethnicity = memberEthnicityOptions[val] != null ? memberEthnicityOptions[val] : ''
}
// 择偶要求：职业 picker（不限 + 20 项）
const memberPrefOccupationRange = computed((): string[] => ['不限'].concat(memberOccupationOptions))
const memberPrefOccupationIndex = computed((): number => {
	const idx = memberPrefOccupationRange.value.indexOf(memberEntry.value.pref.occupation)
	return idx >= 0 ? idx : 0
})
const onMemberPrefOccupationChange = (event: any) => {
	const val = Number(event.detail.value)
	memberEntry.value.pref.occupation = memberPrefOccupationRange.value[val] != null ? memberPrefOccupationRange.value[val] : '不限'
}
// 年龄/身高上下限滑动
const onMemberPrefAgeMin = (event: any) => { memberEntry.value.pref.ageMin = Number(event.detail.value) }
const onMemberPrefAgeMax = (event: any) => { memberEntry.value.pref.ageMax = Number(event.detail.value) }
const onMemberPrefHeightMin = (event: any) => { memberEntry.value.pref.heightMin = Number(event.detail.value) }
const onMemberPrefHeightMax = (event: any) => { memberEntry.value.pref.heightMax = Number(event.detail.value) }
const memberEntryFilled = computed(() => {
	const d = memberEntry.value
	return String(d.nickname).trim() != '' || String(d.phone).trim() != '' || String(d.realName).trim() != ''
})
const fillMemberDemo = () => {
	if (memberEntryFilled.value) {
		memberEntry.value = emptyMemberEntry()
		memberEntryError.value = ''
		return
	}
	memberEntry.value = {
		nickname: '钱多多（示例）', realName: '钱多多', gender: 2, phone: '13922224444', wechat: 'wx_demo_qdd',
		birthday: '1996-08-12', height: '164', weight: '50', hometown: '江苏省 南京市', residence: '浙江省 杭州市 西湖区', household: '江苏省 南京市',
		education: '本科', maritalStatus: '未婚', occupation: '互联网行业', occupationCustom: '', income: '1-2万元', ethnicity: '汉族', zodiac: '鼠',
		housing: '已购婚房无贷款', vehicle: '已购车', smoking: '不吸烟', drinking: '偶尔小酌', religion: '无', marriagePlan: '两年内', tags: ['高颜值', '985毕业'], remark: '示例录入：性格温和，喜欢运动和摄影，希望找同城、有稳定工作的对象。',
		pref: { ageMin: 25, ageMax: 35, heightMin: 170, heightMax: 185, income: '1-2万元', education: '本科', occupation: '互联网行业', marriageAccept: '不接受离异', housing: '要有独立婚房', smoking: '不接受吸烟', weddingPlan: '计划两年内' }
	}
	memberEntryError.value = ''
}
const submitMemberEntry = async () => {
	if (memberEntrySubmitting.value) return
	const d = memberEntry.value
	const nickname = String(d.nickname).trim()
	const realName = String(d.realName).trim()
	const phone = String(d.phone).trim()
	if (nickname.length == 0) { memberEntryError.value = '请填写昵称'; return }
	if (realName.length == 0) { memberEntryError.value = '请填写姓名'; return }
	if (!/^1[3-9]\d{9}$/.test(phone)) { memberEntryError.value = '请填写正确的 11 位手机号'; return }
	if (String(d.height).trim() != '' && (isNaN(Number(d.height)) || Number(d.height) < 100 || Number(d.height) > 250)) { memberEntryError.value = '身高需在 100-250cm 之间'; return }
	if (String(d.weight).trim() != '' && (isNaN(Number(d.weight)) || Number(d.weight) < 40 || Number(d.weight) > 120)) { memberEntryError.value = '体重需在 40-120kg 之间'; return }
	memberEntrySubmitting.value = true
	memberEntryError.value = ''
	try {
		// 职业「其他」联动：选了其他就用自定义输入，否则用选项本身。
		const occupation = String(d.occupation).trim()
		const finalOccupation = occupation == '其他' ? String(d.occupationCustom != null ? d.occupationCustom : '').trim() : occupation
		const result = await createMatchmakerWorkspaceMember({
			nickname: nickname, realName: realName, gender: Number(d.gender), phone: phone,
			wechat: String(d.wechat).trim(), birthday: d.birthday, height: String(d.height).trim(),
			weight: String(d.weight).trim(), hometown: String(d.hometown).trim(), residence: String(d.residence).trim(),
			household: String(d.household).trim(), education: String(d.education).trim(), maritalStatus: String(d.maritalStatus).trim(),
			occupation: finalOccupation, income: String(d.income).trim(), ethnicity: String(d.ethnicity).trim(),
			zodiac: String(d.zodiac).trim(), housing: String(d.housing).trim(), vehicle: String(d.vehicle).trim(),
			smoking: String(d.smoking).trim(), drinking: String(d.drinking).trim(), religion: String(d.religion).trim(),
			marriagePlan: String(d.marriagePlan).trim(), tags: d.tags, remark: String(d.remark).trim(),
			pref: d.pref
		})
		if (!result.success) {
			memberEntryError.value = result.message != null && String(result.message).length > 0 ? String(result.message) : '录入失败，请稍后重试'
			return
		}
		showToast('会员已录入，等待审核')
		memberEntry.value = emptyMemberEntry()
	} catch (e) {
		memberEntryError.value = '网络异常，请稍后重试'
	} finally {
		memberEntrySubmitting.value = false
	}
}
const openLeadAddSheet = () => {
	leadFormIsEdit.value = false
	leadFormLeadId.value = ''
	leadFormName.value = ''
	leadFormPhone.value = ''
	leadFormWechat.value = ''
	leadFormSource.value = ''
	leadFormRemark.value = ''
	leadFormPhoto.value = ''
	leadFormGender.value = 0
	leadFormBirthday.value = ''
	leadFormIntention.value = 1
	leadFormError.value = ''
	leadFormSheetVisible.value = true
}
const openLeadEditSheet = (row: any) => {
	leadFormIsEdit.value = true
	leadFormLeadId.value = String(row.id)
	leadFormName.value = String(row.name)
	leadFormPhone.value = row.phone == '未提供' ? '' : String(row.phone)
	leadFormWechat.value = row.wechat == '未提供' ? '' : String(row.wechat)
	leadFormSource.value = String(row.source)
	leadFormRemark.value = row.remark != null ? String(row.remark) : ''
	leadFormPhoto.value = row.photo != null ? String(row.photo) : ''
	leadFormGender.value = row.gender != null ? Number(row.gender) : 0
	leadFormBirthday.value = row.birthday != null && String(row.birthday).length > 0 ? String(row.birthday).substring(0, 10) : ''
	leadFormIntention.value = row.intentionLevel != null ? Number(row.intentionLevel) : 1
	leadFormError.value = ''
	leadFormSheetVisible.value = true
}
const chooseLeadPhoto = () => {
	uni.chooseImage({
		count: 1,
		sizeType: ['compressed'],
		sourceType: ['album', 'camera'],
		success: async (res: any) => {
			const paths: any[] = res.tempFilePaths != null ? (res.tempFilePaths as any[]) : []
			if (paths.length == 0) return
			showToast('照片上传中…')
			try {
				const up = await uploadWorkspaceLeadPhoto(paths[0])
				if (up.success && up.data != null && up.data.url != null) {
					leadFormPhoto.value = String(up.data.url)
					showToast('照片已上传')
				} else {
					showToast(up.message != null ? String(up.message) : '照片上传失败')
				}
			} catch (e) {
				showToast('照片上传失败，请重试')
			}
		}
	})
}
const previewLeadPhoto = () => {
	if (leadFormPhoto.value.length == 0) return
	uni.previewImage({ urls: [leadFormPhoto.value] })
}
const onLeadFormBirthday = (event: any) => {
	leadFormBirthday.value = event.detail.value != null ? String(event.detail.value) : ''
}
// 联系方式唯一性：服务端做全局唯一校验（409），这里用已加载线索做即时预检。
const findLeadContactConflict = (phone: string, wechat: string, excludeLeadId: string): string => {
	for (let i = 0; i < workspaceLeads.value.length; i++) {
		const row = workspaceLeads.value[i]
		if (excludeLeadId.length > 0 && String(row.id) == excludeLeadId) continue
		const rowPhone = row.phone == '未提供' ? '' : String(row.phone).trim()
		const rowWechat = row.wechat == '未提供' ? '' : String(row.wechat).trim()
		if ((phone.length > 0 && rowPhone.length > 0 && rowPhone == phone) || (wechat.length > 0 && rowWechat.length > 0 && rowWechat == wechat)) {
			return String(row.name)
		}
	}
	return ''
}
const submitLeadForm = async () => {
	const name = leadFormName.value.trim()
	if (name.length == 0) {
		leadFormError.value = '请填写客户称呼'
		return
	}
	const phone = leadFormPhone.value.trim()
	const wechat = leadFormWechat.value.trim()
	if (phone.length == 0 && wechat.length == 0) {
		leadFormError.value = '电话与微信至少填写一项'
		return
	}
	const conflictLeadName = findLeadContactConflict(phone, wechat, leadFormIsEdit.value ? leadFormLeadId.value : '')
	if (conflictLeadName.length > 0) {
		leadFormError.value = '该联系方式已存在于线索「' + conflictLeadName + '」，请勿重复录入'
		return
	}
	leadFormSubmitting.value = true
	leadFormError.value = ''
	try {
		const payload = { name: name, phone: phone, wechat: wechat, source: leadFormSource.value.trim(), intentionLevel: leadFormIntention.value, remark: leadFormRemark.value.trim(), photo: leadFormPhoto.value, gender: leadFormGender.value > 0 ? leadFormGender.value : null, birthday: leadFormBirthday.value.length > 0 ? leadFormBirthday.value : null }
		const result = leadFormIsEdit.value
			? await updateWorkspaceLead(leadFormLeadId.value, payload)
			: await createWorkspaceLead(payload)
		if (!result.success) {
			leadFormError.value = result.message != null && String(result.message).length > 0 ? String(result.message) : '保存失败，请稍后重试'
			return
		}
		leadFormSheetVisible.value = false
		leadFormName.value = ''
		leadFormPhone.value = ''
		leadFormWechat.value = ''
		leadFormSource.value = ''
		leadFormRemark.value = ''
		leadFormIntention.value = 1
		leadFormPhoto.value = ''
		leadFormGender.value = 0
		leadFormBirthday.value = ''
		showToast(leadFormIsEdit.value ? '线索已更新' : '线索已添加，等待跟进')
		await loadWorkspaceLeads()
	} catch (e) {
		leadFormError.value = '网络异常，请稍后重试'
	} finally {
		leadFormSubmitting.value = false
	}
}

// ===== 客源线索：放弃 / 恢复 / 入库确认 =====
const leadConfirmSheetVisible = ref(false)
const leadConfirmKind = ref('abandon')
const leadConfirmLeadId = ref('')
const leadConfirmReason = ref('')
const leadConfirmSubmitting = ref(false)
const leadConvertGender = ref(2)
const leadConfirmTip = computed(() => {
	if (leadConfirmKind.value == 'abandon') return '放弃后该线索将进入「已放弃线索」列表，可随时恢复。'
	if (leadConfirmKind.value == 'restore') return '恢复后客源将回到「客源线索」列表并分派给您跟进。'
	return '入库后将创建正式用户并进入公开资料审核阶段，请确认信息真实有效。'
})
const confirmAbandonLead = (row: any) => {
	leadConfirmKind.value = 'abandon'
	leadConfirmLeadId.value = String(row.id)
	leadConfirmReason.value = ''
	leadConfirmSheetVisible.value = true
}
const confirmRestoreLead = (row: any) => {
	leadConfirmKind.value = 'restore'
	leadConfirmLeadId.value = String(row.id)
	leadConfirmReason.value = ''
	leadConfirmSheetVisible.value = true
}
const confirmConvertLead = (row: any) => {
	if (row.phone == '未提供') {
		showToast('该线索未登记电话，无法入库建档，请先编辑补充')
		return
	}
	leadConfirmKind.value = 'convert'
	leadConfirmLeadId.value = String(row.id)
	leadConvertGender.value = 2
	leadConfirmSheetVisible.value = true
}
const submitLeadConfirm = async () => {
	if (leadConfirmSubmitting.value) return
	leadConfirmSubmitting.value = true
	try {
		let result: any = null
		if (leadConfirmKind.value == 'abandon') {
			if (leadConfirmReason.value.trim().length == 0) {
				showToast('请填写放弃原因')
				return
			}
			result = await abandonWorkspaceLead(leadConfirmLeadId.value, leadConfirmReason.value.trim())
		} else if (leadConfirmKind.value == 'restore') {
			result = await restoreWorkspaceLead(leadConfirmLeadId.value, leadConfirmReason.value.trim().length > 0 ? leadConfirmReason.value.trim() : '重新跟进')
		} else {
			result = await convertWorkspaceLead(leadConfirmLeadId.value, leadConvertGender.value)
		}
		if (!result.success) {
			showToast(result.message != null ? String(result.message) : '操作失败，请稍后重试')
			return
		}
		leadConfirmSheetVisible.value = false
		if (leadConfirmKind.value == 'convert') {
			showToast('已入库，该用户已进入资料待审')
		} else if (leadConfirmKind.value == 'abandon') {
			showToast('已放弃线索')
		} else {
			showToast('客源已恢复')
		}
		await loadWorkspaceLeads()
	} catch (e) {
		showToast('网络异常，请稍后重试')
	} finally {
		leadConfirmSubmitting.value = false
	}
}

// ===== 客源线索：复制资料弹窗（字段口径与后台 CopyProfileModal 一致）=====
const copyProfileVisible = ref(false)
const copyProfileLoading = ref(false)
const copyProfileError = ref('')
const copyProfileRows = ref<any[]>([])
const copyProfileCopied = ref(false)
const copyProfileCopyText = ref('')
let copyProfileLoadSeq = 0

const cpDash = (v: any): string => {
	const text = v == null ? '' : String(v).trim()
	return text.length > 0 ? text : '-'
}
const cpGender = (v: any): string => {
	if (v == null || String(v).trim() == '') return ''
	return Number(v) == 2 ? '女' : '男'
}
// 婚况编码与 16:13 扩展后的 7 值一致（2 为旧「离异」兼容值）。
const cpMarriage = (v: any): string => {
	const status = v == null ? -1 : Number(v)
	if (status == 1) return '未婚'
	if (status == 2) return '离异'
	if (status == 3) return '丧偶'
	if (status == 4) return '离婚未育'
	if (status == 5) return '离异未带孩'
	if (status == 6) return '离异带女孩'
	if (status == 7) return '离异带男孩'
	return ''
}
const cpEducation = (v: any): string => {
	const labels: any = { '1': '初中及以下', '2': '高中/中专', '3': '大专', '4': '本科', '5': '硕士', '6': '博士' }
	if (v == null) return ''
	const key = String(Number(v))
	return labels[key] != null ? labels[key] as string : ''
}
const cpIncome = (v: any): string => {
	const raw = v == null ? '' : String(v).trim()
	if (raw.length == 0) return ''
	const n = Number(raw)
	if (isNaN(n)) return raw
	if (n < 3000) return '3千元以下'
	if (n < 5000) return '3-5千元'
	if (n < 8000) return '5-8千元'
	if (n < 10000) return '8千-1万元'
	if (n < 20000) return '1-2万元'
	if (n < 50000) return '2万以上'
	return '5万以上'
}
// 择偶要求里的学历下限（user_partner_preference.education_min：1 最高 5 最低）。
const cpPrefEducation = (code: number): string => {
	if (code == 1) return '博士及以上'
	if (code == 2) return '硕士及以上'
	if (code == 3) return '本科及以上'
	if (code == 4) return '大专及以上'
	if (code == 5) return '高中及以上'
	return '学历不限'
}
const cpPartnerText = (detail: any, pref: any): string => {
	if (detail != null && detail.ideal_partner != null && String(detail.ideal_partner).trim().length > 0) {
		return String(detail.ideal_partner).trim()
	}
	if (pref == null) return ''
	const parts: string[] = []
	if (pref.age_min != null && Number(pref.age_min) > 0 && pref.age_max != null && Number(pref.age_max) > 0) {
		parts.push(Number(pref.age_min) + '-' + Number(pref.age_max) + '岁')
	} else {
		parts.push('年龄不限')
	}
	parts.push(pref.education_min != null ? cpPrefEducation(Number(pref.education_min)) : '学历不限')
	if (pref.height_min != null && Number(pref.height_min) > 0 && pref.height_max != null && Number(pref.height_max) > 0) {
		parts.push('身高' + Number(pref.height_min) + '-' + Number(pref.height_max) + 'cm')
	} else {
		parts.push('身高不限')
	}
	parts.push(pref.income_min != null && Number(pref.income_min) > 0 ? '收入' + Number(pref.income_min) + '以上' : '收入不限')
	parts.push(pref.occupation_requirement != null && String(pref.occupation_requirement).trim().length > 0 ? '职业' + String(pref.occupation_requirement).trim() : '职业不限')
	return parts.join('，')
}
const buildCopyProfileRows = (leadName: string, detail: any, pref: any): any[] => {
	const d = detail != null ? detail : {}
	const nickname = d.nickname != null && String(d.nickname).trim().length > 0 ? String(d.nickname).trim() : leadName
	const birthdayRaw = d.birthday != null ? String(d.birthday) : ''
	const partner = cpPartnerText(d, pref)
	return [
		{ label: '昵称', value: cpDash(nickname) },
		{ label: '性别', value: cpDash(cpGender(d.gender)) },
		{ label: '出生', value: cpDash(birthdayRaw.length >= 10 ? birthdayRaw.substring(0, 10) : birthdayRaw) },
		{ label: '婚况', value: cpDash(cpMarriage(d.is_married)) },
		{ label: '身高', value: d.height != null && Number(d.height) > 0 ? Number(d.height) + 'cm' : '-cm' },
		{ label: '体重', value: d.weight != null && Number(d.weight) > 0 ? Number(d.weight) + 'kg' : '-kg' },
		{ label: '学历', value: cpDash(cpEducation(d.education_level)) },
		{ label: '工作', value: cpDash(d.occupation) },
		{ label: '收入', value: cpDash(cpIncome(d.income)) },
		{ label: '家乡', value: cpDash(d.hometown_display) },
		{ label: '现居', value: cpDash(d.residence_display) },
		{ label: '购房', value: cpDash(d.house) },
		{ label: '购车', value: cpDash(d.car) },
		{ label: '民族', value: cpDash(d.ethnicity) },
		{ label: '择偶要求', value: cpDash(partner) }
	]
}
const closeCopyProfile = () => {
	copyProfileVisible.value = false
	copyProfileCopied.value = false
}
const confirmCopyProfile = () => {
	if (copyProfileLoading.value) return
	if (copyProfileCopied.value) return
	uni.setClipboardData({
		data: copyProfileCopyText.value,
		success: () => {
			copyProfileCopied.value = true
			setTimeout(() => { copyProfileCopied.value = false }, 2000)
		},
		fail: () => showToast('复制失败，请重试')
	})
}
const openCopyProfile = async (row: any) => {
	const leadName = row.name != null ? String(row.name) : ''
	const memberId = row.convertedUserId != null && String(row.convertedUserId).length > 0 ? Number(row.convertedUserId) : 0
	copyProfileVisible.value = true
	copyProfileCopied.value = false
	copyProfileError.value = ''
	// 未入库客源没有关联会员，直接用线索昵称 + 全空占位（与后台口径一致）。
	if (memberId <= 0) {
		copyProfileRows.value = buildCopyProfileRows(leadName, null, null)
		copyProfileCopyText.value = copyProfileRows.value.map((r: any): string => r.label + '：' + r.value).join('\n')
		return
	}
	const seq = ++copyProfileLoadSeq
	copyProfileLoading.value = true
	copyProfileRows.value = buildCopyProfileRows(leadName, null, null)
	try {
		const profileResult = await getMatchmakerMemberProfile(String(memberId))
		if (seq != copyProfileLoadSeq) return
		if (!profileResult.success || profileResult.data == null) {
			copyProfileError.value = profileResult.message != null ? String(profileResult.message) : '资料加载失败'
			return
		}
		const detail: any = profileResult.data
		let pref: any = null
		try {
			const prefResult = await getMatchmakerMemberPreferences(String(memberId))
			if (seq == copyProfileLoadSeq && prefResult.success && prefResult.data != null) pref = prefResult.data
		} catch (e) {
			// 择偶要求拉取失败不阻塞整体展示。
		}
		copyProfileRows.value = buildCopyProfileRows(leadName, detail, pref)
		copyProfileCopyText.value = copyProfileRows.value.map((r: any): string => r.label + '：' + r.value).join('\n')
	} catch (e) {
		if (seq == copyProfileLoadSeq) copyProfileError.value = '网络异常，请稍后重试'
	} finally {
		if (seq == copyProfileLoadSeq) copyProfileLoading.value = false
	}
}
const copyLeadProfile = (row: any) => {
	openCopyProfile(row)
}

let introductionFallbackUsed: string[] = []
const getIntroductionFallbackAvatar = (memberId: any, gender: string, memberName: string = ''): string => {
	// 真实头像优先；兜底头像按 ID/姓名稳定分配，避免牵线嘉宾全部使用同一张图。
	const seedText = String(memberId || '') + ':' + String(memberName || '')
	let seed = 0
	for (let i = 0; i < seedText.length; i++) seed = (seed * 31 + seedText.charCodeAt(i)) >>> 0
	// 82 张动漫头像池（static/avatars），男会员取 001-041，女会员取 042-082。
	const maleAvatars: string[] = []
	const femaleAvatars: string[] = []
	for (let i = 1; i <= 41; i++) {
		const padded = i < 10 ? '00' + String(i) : (i < 100 ? '0' + String(i) : String(i))
		maleAvatars.push('/static/avatars/matchmaking-anime-' + padded + '.jpg')
		const fj = i + 41
		const fpadded = fj < 100 ? '0' + String(fj) : String(fj)
		femaleAvatars.push('/static/avatars/matchmaking-anime-' + fpadded + '.jpg')
	}
	const neutralAvatars = maleAvatars.concat(femaleAvatars)
	const normalizedGender = String(gender || '')
	const avatars = normalizedGender == '男' || normalizedGender == 'MALE' ? maleAvatars : (normalizedGender == '女' || normalizedGender == 'FEMALE' ? femaleAvatars : neutralAvatars)
	let index = seed % avatars.length
	for (let offset = 0; offset < avatars.length; offset++) {
		const candidate = avatars[(index + offset) % avatars.length]
		if (introductionFallbackUsed.indexOf(candidate) < 0) {
			introductionFallbackUsed.push(candidate)
			return candidate
		}
	}
	const candidate = avatars[index]
	introductionFallbackUsed.push(candidate)
	return candidate
}

const loadWorkspaceMatches = async () => {
	workspaceMatchesLoading.value = true
	workspaceMatchesError.value = ''
	workspaceMatchesLoaded.value = false
	workspaceMatchesUsingDemoData.value = false
	try {
		const result = await getMatchmakerWorkspaceIntroductions()
		if (!result.success || result.data == null) {
			workspaceMatches.value = []
			workspaceMatchesError.value = result.message != null ? String(result.message) : '牵线记录加载失败'
			return
		}
		const statusLabels: any = { PENDING: '待我牵线', IN_PROGRESS: '牵线中', SUCCEEDED: '牵线成功', FAILED: '牵线失败' }
		const statusTones: any = { PENDING: 'pending', IN_PROGRESS: 'progress', SUCCEEDED: 'succeeded', FAILED: 'failed' }
		const owner = managementCenterSnapshot.value != null && managementCenterSnapshot.value.identity != null
			? String(managementCenterSnapshot.value.identity.name || '服务红娘')
			: '服务红娘'
		const source = result.data
		const items = Array.isArray(source.items) ? source.items : []
		workspaceMatchesUsingDemoData.value = source.isDemo == true
		introductionFallbackUsed = []
		workspaceMatches.value = items.map((item: any) => {
			const fromUser = item.fromUser != null ? item.fromUser : {}
			const toUser = item.toUser != null ? item.toUser : {}
			return {
				id: item.id != null ? String(item.id) : '',
				status: item.status != null ? String(item.status) : 'PENDING',
				statusLabel: statusLabels[item.status] != null ? String(statusLabels[item.status]) : '待我牵线',
				statusTone: statusTones[item.status] != null ? String(statusTones[item.status]) : 'pending',
				time: item.createdAt != null ? String(item.createdAt).substring(0, 16) : '',
				failureReason: item.failureReason != null ? String(item.failureReason) : '',
				fromUser: {
					id: fromUser.id != null ? String(fromUser.id) : '',
					name: fromUser.name != null ? String(fromUser.name) : '未命名会员',
					gender: fromUser.gender != null ? String(fromUser.gender) : '未填写',
					avatar: fromUser.avatar != null && String(fromUser.avatar).length > 0 ? String(fromUser.avatar) : getIntroductionFallbackAvatar(fromUser.id, String(fromUser.gender), String(fromUser.name))
				},
				toUser: {
					id: toUser.id != null ? String(toUser.id) : '',
					name: toUser.name != null ? String(toUser.name) : '未命名会员',
					gender: toUser.gender != null ? String(toUser.gender) : '未填写',
					avatar: toUser.avatar != null && String(toUser.avatar).length > 0 ? String(toUser.avatar) : getIntroductionFallbackAvatar(toUser.id, String(toUser.gender), String(toUser.name))
				},
				owner: owner
			}
		})
		workspaceMatchesLoaded.value = true
		syncBusinessMetricCountsFromWorkspace()
	} catch (e) {
		workspaceMatches.value = []
		workspaceMatchesUsingDemoData.value = false
		workspaceMatchesError.value = '网络数据加载失败，请检查本地服务后重试'
	} finally {
		workspaceMatchesLoading.value = false
	}
}

// 判断牵线记录中的会员是否为会员专区（VIP）会员，用于卡片上的 VIP 徽章。
const isVipPerson = (person: any): boolean => person != null && Number(person.isVip) == 1

// 点击「联系Ta」→ 打开查看联系方式弹窗（受审计读取，超级红娘可查全部会员）。
const workspaceContactVisible = ref(false)
const workspaceContactLoading = ref(false)
const workspaceContactNickname = ref('')
const workspaceContactRealName = ref('')
const workspaceContactPhone = ref('')
const workspaceContactWechat = ref('')
const workspaceContactScope = ref('SERVED')
const workspaceContactError = ref('')
const workspaceContactMemberId = ref(0)

const resetWorkspaceContact = () => {
	workspaceContactNickname.value = ''
	workspaceContactRealName.value = ''
	workspaceContactPhone.value = ''
	workspaceContactWechat.value = ''
	workspaceContactScope.value = 'SERVED'
	workspaceContactError.value = ''
}

const closeWorkspaceContact = () => {
	workspaceContactVisible.value = false
	workspaceContactMemberId.value = 0
	resetWorkspaceContact()
}

// 遮罩点击守卫：打开后 360ms 内忽略遮罩点击，避免「打开弹窗的那一次点击」穿透关闭弹窗。
const workspaceContactReady = ref(false)

// 名称行：昵称去掉「（演示）」后缀 + 实名，两者相同只显示一个。
const workspaceContactNameText = computed<string>((): string => {
	const nick = workspaceContactNickname.value.length > 0 ? workspaceContactNickname.value.replace('（演示）', '').replace('(演示)', '').trim() : ''
	const real = workspaceContactRealName.value.trim()
	if (nick.length > 0 && real.length > 0 && nick != real) return nick + ' | ' + real
	if (nick.length > 0) return nick
	if (real.length > 0) return real
	return '会员联系方式'
})

const workspaceContactTipText = computed<string>((): string => {
	if (workspaceContactScope.value == 'ALL') return '您当前是超级红娘，可以查看所有会员的联系方式；请勿外泄，每次查看都会记录到服务审计日志。'
	return '超级红娘可以查看所有会员的联系方式；普通红娘仅能查看所服务会员的联系方式。本次查看已记录到服务审计日志。'
})

const copyWorkspaceContact = (value: string) => {
	if (value.length == 0) return
	uni.setClipboardData({
		data: value,
		success: () => { uni.showToast({ title: '已复制', icon: 'none' }) }
	})
}

const callWorkspaceContact = () => {
	const phone = workspaceContactPhone.value.trim()
	if (phone.length == 0) {
		uni.showToast({ title: '该会员未绑定手机号', icon: 'none' })
		return
	}
	uni.makePhoneCall({
		phoneNumber: phone,
		fail: () => { uni.showToast({ title: '拨号未成功，可先复制号码', icon: 'none' }) }
	})
}

const onWorkspaceContactOverlay = () => {
	if (!workspaceContactReady.value) return
	closeWorkspaceContact()
}

// 资料待审里的「联系」→ 上抛会员，复用页面里同一个弹窗（避免重复实现弹层）。
const onPendingReviewContact = (member: any) => {
	const id = member != null && member.user_id != null ? String(member.user_id).trim() : ''
	const name = member != null && member.nickname != null ? String(member.nickname) : ''
	openWorkspaceContact({ id: id, name: name })
}

// 解析会员编号：演示数据（如 W10001）会得到 NaN，必须用「非正数」判断兜住，否则会带着 NaN 去请求接口。
const parseMemberId = (person: any): number => {
	const raw = person != null && person.id != null ? String(person.id).trim() : ''
	if (raw.length == 0) return 0
	const value = Number(raw)
	if (!(value > 0)) return 0
	return Math.floor(value)
}

const openWorkspaceContact = async (person: any) => {
	const id = parseMemberId(person)
	if (id <= 0) {
		showToast('该会员为本地演示数据，暂不支持查看联系方式')
		return
	}
	workspaceContactMemberId.value = id
	resetWorkspaceContact()
	// 先用卡片上的姓名占位，避免弹窗加载期间标题为空。
	workspaceContactNickname.value = person != null && person.name != null ? String(person.name) : ''
	// 打开瞬间屏蔽遮罩点击（同一次点击可能落到刚出现的遮罩上）。
	workspaceContactReady.value = false
	setTimeout(() => { workspaceContactReady.value = true }, 360)
	workspaceContactLoading.value = true
	workspaceContactVisible.value = true
	try {
		const result = await getMatchmakerMemberContact(String(id))
		if (workspaceContactMemberId.value != id) return
		if (!result.success || result.data == null) {
			// 读取失败时保持弹窗打开并就地提示，避免「一闪而过」看起来像没反应。
			workspaceContactError.value = result.message != null && String(result.message).length > 0 ? String(result.message) : '联系方式加载失败，请稍后重试'
			return
		}
		const data: any = result.data
		if (data.nickname != null && String(data.nickname).length > 0) workspaceContactNickname.value = String(data.nickname)
		workspaceContactRealName.value = data.realName != null ? String(data.realName) : ''
		workspaceContactPhone.value = data.phone != null ? String(data.phone) : ''
		workspaceContactWechat.value = data.wechat != null ? String(data.wechat) : ''
		workspaceContactScope.value = data.scope != null ? String(data.scope) : 'SERVED'
	} catch (e) {
		workspaceContactError.value = '网络异常，请稍后重试'
	} finally {
		workspaceContactLoading.value = false
	}
}

// 点击牵线记录里的会员头像 → 以红娘权限查看该会员主页。
const openWorkspaceMemberProfile = (person: any) => {
	const id = parseMemberId(person)
	if (id <= 0) {
		showToast('该会员为本地演示数据，暂无主页')
		return
	}
	uni.navigateTo({
		url: '/pagesSub/userExtra/user/detail?userId=' + String(id) + '&matchmakerView=1',
		fail: () => showToast('打开会员主页失败')
	})
}

const getWorkspaceMeetingPresentation = (requestStatus: string, meeting: any) => {
	if (meeting != null) {
		const meetingStatus = meeting.status != null ? String(meeting.status) : ''
		if (meetingStatus == 'SCHEDULED' || meetingStatus == 'REMINDED' || meetingStatus == 'CHECKED_IN') {
			return { phase: 'UPCOMING', statusLabel: '待见面', statusTone: 'upcoming', detail: '已安排约见，请按计划完成服务跟进' }
		}
		if (meetingStatus == 'COMPLETED') {
			return { phase: 'COMPLETED', statusLabel: '已完成', statusTone: 'completed', detail: '本次约见已完成，可继续记录后续服务进展' }
		}
		return { phase: 'ENDED', statusLabel: meetingStatus == 'NO_SHOW' ? '未按约到场' : '已结束', statusTone: 'ended', detail: meeting.cancelReason != null && String(meeting.cancelReason).length > 0 ? String(meeting.cancelReason) : '本次约见已结束' }
	}
	if (requestStatus == 'SUBMITTED') return { phase: 'PROCESSING', statusLabel: '待处理', statusTone: 'submitted', detail: '已收到约见申请，等待服务红娘跟进' }
	if (requestStatus == 'CONTACTED') return { phase: 'PROCESSING', statusLabel: '跟进中', statusTone: 'processing', detail: '正在协调双方可约见时间' }
	if (requestStatus == 'ACCEPTED') return { phase: 'PROCESSING', statusLabel: '待安排', statusTone: 'processing', detail: '双方已同意，等待安排具体约见' }
	return { phase: 'ENDED', statusLabel: requestStatus == 'DECLINED' ? '未达成约见' : '已关闭', statusTone: 'ended', detail: '本次约见申请已结束' }
}

const loadWorkspaceMeetings = async () => {
	workspaceMeetingsLoading.value = true
	workspaceMeetingsError.value = ''
	workspaceMeetingsLoaded.value = false
	workspaceMeetingsUsingDemoData.value = false
	try {
		const result = await getMatchmakerWorkspaceMeetingRequests()
		if (!result.success || result.data == null) {
			workspaceMeetings.value = []
			workspaceMeetingsError.value = result.message != null ? String(result.message) : '约见申请加载失败'
			return
		}
		const source = result.data
		const items = Array.isArray(source.items) ? source.items : []
		workspaceMeetingsUsingDemoData.value = source.isDemo == true
		introductionFallbackUsed = []
		workspaceMeetings.value = items.map((item: any) => {
			const applicant = item.applicant != null ? item.applicant : {}
			const target = item.target != null ? item.target : {}
			const meeting = item.meeting != null ? item.meeting : null
			const presentation = getWorkspaceMeetingPresentation(item.status != null ? String(item.status) : 'SUBMITTED', meeting)
			return {
				id: item.id != null ? String(item.id) : '',
				phase: presentation.phase,
				statusLabel: presentation.statusLabel,
				statusTone: presentation.statusTone,
				detail: presentation.detail,
				requestStatus: item.status != null ? String(item.status) : 'SUBMITTED',
				createdAt: item.createdAt != null ? String(item.createdAt).substring(0, 16) : '',
				owner: item.matchmakerName != null && String(item.matchmakerName) != '' ? String(item.matchmakerName) : '待分派',
				note: item.note != null ? String(item.note) : '',
				meeting: meeting != null ? {
					id: meeting.id != null ? String(meeting.id) : '',
					status: meeting.status != null ? String(meeting.status) : '',
					scheduledAt: meeting.scheduledAt != null ? String(meeting.scheduledAt).substring(0, 16) : '',
					location: meeting.location != null ? String(meeting.location) : ''
				} : null,
				applicant: {
					id: applicant.id != null ? String(applicant.id) : '',
					name: applicant.name != null ? String(applicant.name) : '未命名会员',
					gender: applicant.gender != null ? String(applicant.gender) : '未填写',
					isVip: applicant.isVip === true || applicant.isVip === 1,
					avatar: applicant.avatar != null && String(applicant.avatar).length > 0 ? String(applicant.avatar) : getIntroductionFallbackAvatar(applicant.id, String(applicant.gender), String(applicant.name))
				},
				target: {
					id: target.id != null ? String(target.id) : '',
					name: target.name != null ? String(target.name) : '未命名会员',
					gender: target.gender != null ? String(target.gender) : '未填写',
					isVip: target.isVip === true || target.isVip === 1,
					avatar: target.avatar != null && String(target.avatar).length > 0 ? String(target.avatar) : getIntroductionFallbackAvatar(target.id, String(target.gender), String(target.name))
				}
			}
		})
		workspaceMeetingsLoaded.value = true
		syncBusinessMetricCountsFromWorkspace()
	} catch (e) {
		workspaceMeetings.value = []
		workspaceMeetingsUsingDemoData.value = false
		workspaceMeetingsError.value = '网络数据加载失败，请检查本地服务后重试'
	} finally {
		workspaceMeetingsLoading.value = false
	}
}

// ===== 牵线管理：添加牵线记录 =====
const matchAddSheetVisible = ref(false)
const matchAddPickerVisible = ref(false)
const matchAddPickerKind = ref('from')
const matchAddFromId = ref('')
const matchAddFromName = ref('')
const matchAddToId = ref('')
const matchAddToName = ref('')
const matchAddAppliedAt = ref('')
const matchAddFinishedAt = ref('')
const matchAddResult = ref('SUCCEEDED')
const matchAddFailureReason = ref('')
const matchAddError = ref('')
const matchAddSubmitting = ref(false)
const matchAddLoading = ref(false)
const matchAddCandidates = ref<any[]>([])
// 会员选择弹层支持按名字 / 编号搜索（待我牵线 → 添加牵线记录）
const matchAddSearch = ref('')
const onMatchAddSearchInput = (event: any) => {
	matchAddSearch.value = event.detail.value
}
const matchAddFilteredCandidates = computed(() => {
	const rows = matchAddCandidates.value
	const keyword = matchAddSearch.value.trim().toLowerCase()
	if (keyword.length == 0) return rows
	return rows.filter((item: any): boolean => {
		const content = (String(item.name) + String(item.id) + String(item.gender)).toLowerCase()
		return content.indexOf(keyword) >= 0
	})
})
const openMatchAddSheet = () => {
	matchAddFromId.value = ''
	matchAddFromName.value = ''
	matchAddToId.value = ''
	matchAddToName.value = ''
	matchAddAppliedAt.value = ''
	matchAddFinishedAt.value = ''
	matchAddResult.value = 'SUCCEEDED'
	matchAddFailureReason.value = ''
	matchAddError.value = ''
	matchAddSheetVisible.value = true
}
const openMatchAddPicker = async (kind: string) => {
	matchAddPickerKind.value = kind
	matchAddSearch.value = ''
	matchAddPickerVisible.value = true
	if (matchAddCandidates.value.length == 0) {
		matchAddLoading.value = true
		try {
			await loadWorkspaceMembers()
			const rows = workspaceMembers.value
			const options: any[] = []
			for (let i = 0; i < rows.length; i++) {
				const row = rows[i]
				options.push({ id: String(row.id), name: String(row.name || '未命名会员'), gender: String(row.gender || '未填写') })
			}
			matchAddCandidates.value = options
		} catch (e) {
			showToast('会员列表加载失败')
		} finally {
			matchAddLoading.value = false
		}
	}
}
const isMatchAddPicked = (id: string) => {
	return (matchAddPickerKind.value == 'from' && matchAddToId.value == id) || (matchAddPickerKind.value == 'to' && matchAddFromId.value == id)
}
const pickMatchAddMember = (m: any) => {
	if (matchAddPickerKind.value == 'from') {
		matchAddFromId.value = m.id
		matchAddFromName.value = m.name
	} else {
		matchAddToId.value = m.id
		matchAddToName.value = m.name
	}
	matchAddPickerVisible.value = false
}
const submitMatchAdd = async () => {
	if (matchAddSubmitting.value) return
	if (matchAddFromId.value.length == 0) { matchAddError.value = '请选择牵线会员'; return }
	if (matchAddToId.value.length == 0) { matchAddError.value = '请选择被牵线会员'; return }
	if (matchAddFromId.value == matchAddToId.value) { matchAddError.value = '牵线双方不能是同一人'; return }
	if (matchAddResult.value == 'SUCCEEDED' && matchAddFinishedAt.value == '') { matchAddError.value = '牵线成功需要选择牵线完成时间'; return }
	if (matchAddResult.value == 'FAILED' && matchAddFailureReason.value.trim().length == 0) { matchAddError.value = '牵线失败需要填写失败原因'; return }
	matchAddSubmitting.value = true
	matchAddError.value = ''
	try {
		const result = await createMatchmakerIntroduction({
			fromUserId: matchAddFromId.value, toUserId: matchAddToId.value,
			appliedAt: matchAddAppliedAt.value || '', finishedAt: matchAddFinishedAt.value || '',
			result: matchAddResult.value, failureReason: matchAddFailureReason.value
		})
		if (!result.success) {
			matchAddError.value = result.message != null && String(result.message).length > 0 ? String(result.message) : '添加失败，请稍后重试'
			return
		}
		matchAddSheetVisible.value = false
		showToast('牵线记录已添加')
		await loadWorkspaceMatches()
	} catch (e) {
		matchAddError.value = '网络异常，请稍后重试'
	} finally {
		matchAddSubmitting.value = false
	}
}

// ===== 牵线管理：牵线状态弹窗（失败必填原因，其他状态无备注） =====
const matchStatusSheetVisible = ref(false)
const matchStatusRow = ref<any>(null)
const matchStatusChoice = ref('IN_PROGRESS')
const matchFailureReason = ref('')
const matchStatusSubmitting = ref(false)
const matchStatusOptions = [
	{ value: 'IN_PROGRESS', label: '牵线中' },
	{ value: 'PENDING', label: '待牵线' },
	{ value: 'SUCCEEDED', label: '牵线成功' },
	{ value: 'FAILED', label: '牵线失败' }
]
const openMatchStatusSheet = (row: any) => {
	matchStatusRow.value = row
	matchStatusChoice.value = String(row.status) == 'PENDING' ? 'IN_PROGRESS' : String(row.status)
	matchFailureReason.value = ''
	matchStatusSheetVisible.value = true
}
const submitMatchStatus = async () => {
	const row = matchStatusRow.value
	if (row == null || matchStatusSubmitting.value) return
	if (matchStatusChoice.value == 'FAILED' && matchFailureReason.value.trim().length == 0) {
		showToast('牵线失败需要填写失败原因')
		return
	}
	matchStatusSubmitting.value = true
	try {
		const result = await updateMatchmakerIntroductionStatus(String(row.id), matchStatusChoice.value, matchFailureReason.value)
		if (!result.success) {
			showToast(result.message != null && String(result.message).length > 0 ? String(result.message) : '状态更新失败')
			return
		}
		matchStatusSheetVisible.value = false
		showToast('牵线状态已更新')
		await loadWorkspaceMatches()
	} catch (e) {
		showToast('网络异常，请稍后重试')
	} finally {
		matchStatusSubmitting.value = false
	}
}

