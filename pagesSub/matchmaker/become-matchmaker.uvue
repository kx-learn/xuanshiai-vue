<template>
	<view class="become-page">
		<!-- 顶部导航栏 -->
		<view class="nav-bar">
			<view class="nav-back" @click="handlePageBack">
				<view class="nav-back-chevron"></view>
			</view>
			<text class="nav-title">{{ pendingReviewVisible ? '资料待审' : (workspaceVisible ? workspaceTitle : (managementCenterVisible || managementCenterLoading ? '红娘管理中心' : '我要做红娘')) }}</text>
			<view v-if="pendingReviewVisible || workspaceVisible" class="nav-help" @click="closeWorkspace">
				<text class="nav-help-text">返回</text>
			</view>
			<view v-else-if="managementCenterVisible" class="nav-entries">
				<view class="nav-entry" @click="openMyAccount">
					<view class="entry-person"><view class="entry-person-head"></view><view class="entry-person-body"></view><view class="entry-person-dot"></view></view>
				</view>
				<view class="nav-entry" @click="serviceNavVisible = true">
					<view class="entry-lines"><view></view><view></view><view></view></view>
				</view>
			</view>
			<view v-else-if="!managementCenterLoading" class="nav-help" @click="showHelp">
				<text class="nav-help-text">帮助</text>
			</view>
		</view>

		<MatchmakerPendingReview
			v-if="pendingReviewVisible"
			:initial-tab="pendingReviewInitialTab"
			@servedCount="onPendingReviewServedCount"
			@contact="onPendingReviewContact"
		/>
		<scroll-view v-else-if="workspaceVisible" scroll-y class="workspace-scroller" :show-scrollbar="false" :scroll-top="workspaceScrollTop">
			<view class="workspace-content">
				<view class="workspace-heading">
					<text class="workspace-title">{{ workspaceTitle }}</text>
					<text class="workspace-copy">{{ workspaceKind == 'entry' ? '提交后自动分派到您名下，信息仅用于平台牵线服务。' : '仅展示服务端已提供的数据，未开放能力不会创建本地记录。' }}</text>
				</view>
				<view v-if="workspaceKind != 'entry'" class="workspace-tabs">
					<view v-for="item in workspaceTabs" :key="item" class="workspace-tab" :class="{ active: workspaceActiveTab == item }" @click="selectWorkspaceTab(item)"><text>{{ item }}</text></view>
				</view>
				<view v-if="workspaceKind != 'entry'" class="workspace-search"><text class="workspace-search-glyph">⌕</text><input :placeholder="workspaceSearchPlaceholder" :value="workspaceKeyword" @input="onWorkspaceKeywordInput"/><view class="workspace-search-submit" @click="runWorkspaceSearch"><text class="workspace-search-glyph">⌕</text></view></view>

				<view v-if="workspaceKind == 'commission'">
					<view class="workspace-cash"><text>资金结算</text><text class="workspace-cash-value">--</text><text>分成、账本和提现不在本期范围内。</text></view>
					<view class="workspace-notice"><text class="workspace-notice-title">温馨提示</text><text>专属推广链接与海报将在后端配置后开放。</text></view>
					<view v-for="row in workspaceCommissionRows" :key="row.time" class="workspace-commission-row"><text>{{ row.time }}</text><view><image :src="row.avatar" mode="aspectFill"/><view><text>{{ row.name }}</text><text>{{ row.item }}</text></view><text>{{ row.amount }}</text></view></view>
				</view>

				<view v-else-if="workspaceKind == 'lead'">
					<view v-if="leadFollowPanelVisible" class="workspace-lead-follow-panel">
						<view class="workspace-follow-head">
							<text class="workspace-follow-back" @click="closeLeadFollowPanel">‹ 返回</text>
							<text class="workspace-follow-title">{{ leadFollowLeadName }} 的跟进记录</text>
						</view>
						<view v-if="leadFollowLoading" class="workspace-state"><text>正在加载跟进记录…</text></view>
						<view v-else-if="leadFollowError.length > 0" class="workspace-state"><text>{{ leadFollowError }}</text><text class="workspace-state-action" @click="loadLeadFollowRecords">重新加载</text></view>
						<view v-else-if="leadFollowRecords.length == 0" class="workspace-state"><text>暂时没有跟进记录，添加第一条跟进吧</text></view>
						<view v-else class="workspace-follow-list">
							<view v-for="rec in leadFollowRecords" :key="rec.id" class="workspace-follow-item">
								<view class="workspace-follow-item-top"><text class="workspace-follow-method">{{ rec.methodLabel }}</text><text class="workspace-follow-time">{{ rec.time }}</text></view>
								<text class="workspace-follow-content">{{ rec.content }}</text>
								<text v-if="rec.intentionLabel.length > 0" class="workspace-follow-intention">意向：{{ rec.intentionLabel }}</text>
							</view>
						</view>
						<view class="workspace-follow-form">
							<text class="workspace-follow-form-title">添加跟进</text>
							<view class="workspace-follow-methods">
								<view v-for="m in leadFollowMethods" :key="m.value" class="workspace-follow-method-chip" :class="{ active: leadFollowMethod == m.value }" @click="leadFollowMethod = m.value"><text>{{ m.label }}</text></view>
							</view>
							<textarea class="workspace-follow-textarea" :value="leadFollowContent" @input="leadFollowContent = $event.detail.value" placeholder="记录本次沟通内容（必填）" :maxlength="500" auto-height/>
							<view class="workspace-follow-submit" @click="submitLeadFollowUp"><text>提交跟进</text></view>
						</view>
					</view>
					<view v-else>
					<view class="workspace-lead-toolbar">
						<view class="workspace-lead-tool" :class="{ active: leadExceptionOnly }" @click="toggleLeadException"><text>{{ leadExceptionOnly ? '返回全部' : '异常线索' }}</text></view>
						<view class="workspace-lead-tool" :class="{ active: leadFilterStatus.length > 0 || leadFilterIntention > 0 }" @click="openLeadFilterSheet"><text>筛选</text></view>
						<view class="workspace-lead-tool primary" @click="openLeadAddSheet"><text>+ 添加线索</text></view>
					</view>
					<view class="workspace-notice"><text>超级红娘可查看全部客源线索，普通红娘仅查看已分派的客源。</text></view>
					<view v-if="workspaceLeadsLoading" class="workspace-state"><text>正在加载客源数据…</text></view>
					<view v-else-if="workspaceLeadsError.length > 0" class="workspace-state"><text>{{ workspaceLeadsError }}</text><text class="workspace-state-action" @click="loadWorkspaceLeads">重新加载</text></view>
					<view v-else-if="workspaceVisibleLeads.length == 0" class="workspace-state"><text>没有符合条件的客源</text></view>
					<view v-else>
						<view v-for="row in workspaceVisibleLeads" :key="row.id" class="workspace-lead-card">
							<view class="workspace-lead-top">
								<view class="workspace-lead-name">
									<text class="workspace-lead-title">{{ row.name }}</text>
									<text class="workspace-lead-age">{{ row.genderAge }}</text>
								</view>
								<text class="workspace-lead-time">{{ row.time }}</text>
							</view>
								<view class="workspace-lead-rows">
									<view><text>电话</text><text>{{ row.phone }}</text></view>
									<view><text>微信</text><text>{{ row.wechat }}</text></view>
									<view><text>来源</text><text>{{ row.source }}</text></view>
									<view><text>备注</text><text>{{ row.remark || '暂无备注' }}</text></view>
								<view class="workspace-lead-status-row" @click="openLeadStatusSheet(row)">
									<text>状态</text>
									<text :class="'workspace-lead-status-' + row.statusTone">{{ row.statusLabel }} ›</text>
								</view>
								<view @click="openLeadAssignSheet(row)">
									<text>分派跟进</text>
									<text>{{ row.owner }} ›</text>
								</view>
								<view @click="openLeadFollowPanel(row)">
									<text>跟进</text>
									<text :class="{ 'workspace-lead-stale': row.isStale }">{{ row.followSummary }} ›</text>
								</view>
								<view class="workspace-lead-click-row" @click="openLeadIntentionSheet(row)"><text>意向</text><text class="workspace-lead-intention">{{ row.intentionLabel }} ›</text></view>
							</view>
							<view class="workspace-actions">
								<text @click="openLeadEditSheet(row)">编辑</text>
								<text @click="copyLeadProfile(row)">复制资料</text>
								<text v-if="row.status != 'LOST'" @click="confirmAbandonLead(row)">放弃线索</text>
								<text v-else @click="confirmRestoreLead(row)">恢复客源</text>
													<text v-if="row.status != 'CONVERTED' && row.status != 'CLOSED' && row.status != 'LOST'" @click="confirmConvertLead(row)">一键入库</text>
													<text v-else-if="row.status == 'LOST'" @click="confirmRestoreLead(row)">先恢复客源</text>
													<text v-else @click="showToast('已入库，编号 ' + row.convertedUserId)">已入库</text>
							</view>
						</view>
					</view>
					</view>
				</view>

				<view v-else-if="workspaceKind == 'match'">
					<view class="workspace-filter-note"><text>仅显示当前服务范围；此列表不展示双方联系方式。</text></view>
					<view v-if="workspaceMatchesUsingDemoData" class="workspace-demo-notice"><text>当前显示本地测试数据；服务端产生记录后将自动切换为真实数据。</text></view>
					<view v-if="workspaceMatchesLoading" class="workspace-state"><text>正在加载牵线记录…</text></view>
					<view v-else-if="workspaceMatchesError.length > 0" class="workspace-state"><text>{{ workspaceMatchesError }}</text><text class="workspace-state-action" @click="loadWorkspaceMatches">重新加载</text></view>
					<view v-else-if="workspaceVisibleMatches.length == 0" class="workspace-state"><text>没有符合条件的牵线记录</text></view>
					<view v-else><view v-for="row in workspaceVisibleMatches" :key="row.id" class="workspace-match-card"><view class="workspace-match-card-top"><text>申请时间：{{ row.time }}</text><view class="workspace-match-status-btn" :class="'t-' + row.status" @click="openMatchStatusSheet(row)"><text>{{ row.statusLabel }}</text><view class="workspace-match-status-arrow"><i></i></view></view></view><view class="workspace-match-person"><view class="workspace-match-person-side"><view class="workspace-match-avatar-wrap" @click="openWorkspaceMemberProfile(row.fromUser)"><image :src="row.fromUser.avatar" mode="aspectFill"/><text class="workspace-match-role role-applicant">申请人</text></view><view class="workspace-match-person-copy"><view class="workspace-match-person-name"><text>{{ row.fromUser.name }}</text><text class="workspace-match-gender" :class="row.fromUser.gender == '女' ? 'female' : 'male'">{{ row.fromUser.gender == '女' ? '♀' : '♂' }}</text><text v-if="isVipPerson(row.fromUser)" class="workspace-match-vip">VIP</text></view><text class="workspace-match-person-code">编号：{{ row.fromUser.id }}</text></view></view><view class="workspace-match-contact" @tap="openWorkspaceContact(row.fromUser)"><text>联系Ta</text></view></view><view class="workspace-match-person"><view class="workspace-match-person-side"><view class="workspace-match-avatar-wrap" @click="openWorkspaceMemberProfile(row.toUser)"><image :src="row.toUser.avatar" mode="aspectFill"/><text class="workspace-match-role role-target">牵线人</text></view><view class="workspace-match-person-copy"><view class="workspace-match-person-name"><text>{{ row.toUser.name }}</text><text class="workspace-match-gender" :class="row.toUser.gender == '女' ? 'female' : 'male'">{{ row.toUser.gender == '女' ? '♀' : '♂' }}</text><text v-if="isVipPerson(row.toUser)" class="workspace-match-vip">VIP</text></view><text class="workspace-match-person-code">编号：{{ row.toUser.id }}</text></view></view><view class="workspace-match-contact" @tap="openWorkspaceContact(row.toUser)"><text>联系Ta</text></view></view><text v-if="row.failureReason.length > 0" class="workspace-match-reason">失败原因：{{ row.failureReason }}</text><text class="workspace-match-owner">服务红娘：{{ row.owner }}</text></view></view>
				</view>
				<view v-else-if="workspaceKind == 'meeting'">
					<view class="workspace-meeting-intro"><view class="workspace-meeting-intro-head"><text class="workspace-meeting-intro-mark">T</text><text class="workspace-meeting-intro-title">须知</text></view><text class="workspace-meeting-intro-text">在这里您可以看到所有会员在平台上点击"申请安排见面"提交的记录，平台和红娘可以通过该信息进行精准销售或牵线服务，利用本功能可大大提升将会员引导到线下门店面谈的成功率。</text></view>
					<view v-if="workspaceMeetingsUsingDemoData" class="workspace-demo-notice"><text>当前显示本地测试数据；服务端产生记录后将自动切换为真实数据。</text></view>
					<view v-if="workspaceMeetingsLoading" class="workspace-state"><text>正在加载约见申请…</text></view>
					<view v-else-if="workspaceMeetingsError.length > 0" class="workspace-state"><text>{{ workspaceMeetingsError }}</text><text class="workspace-state-action" @click="loadWorkspaceMeetings">重新加载</text></view>
					<view v-else-if="workspaceVisibleMeetings.length == 0" class="workspace-state"><text>没有符合条件的约见申请</text></view>
					<view v-else><view v-for="row in workspaceVisibleMeetings" :key="row.id" class="workspace-meeting-card"><view class="workspace-meeting-pair"><view class="workspace-meeting-person"><view class="workspace-meeting-avatar-wrap" @click="openWorkspaceMemberProfile(row.applicant)"><image :src="row.applicant.avatar" mode="aspectFill"/><text class="workspace-meeting-gender" :class="row.applicant.gender == '女' ? 'female' : 'male'">{{ row.applicant.gender == '女' ? '♀' : '♂' }}</text></view><view class="workspace-meeting-name-row" @click="openWorkspaceMemberProfile(row.applicant)"><text class="workspace-meeting-name">{{ row.applicant.name }}</text><text v-if="isVipPerson(row.applicant)" class="workspace-meeting-vip">VIP</text></view><text class="workspace-meeting-person-code">编号：{{ row.applicant.id }}</text></view><view class="workspace-meeting-wish"><text>想约见</text></view><view class="workspace-meeting-person"><view class="workspace-meeting-avatar-wrap" @click="openWorkspaceMemberProfile(row.target)"><image :src="row.target.avatar" mode="aspectFill"/><text class="workspace-meeting-gender" :class="row.target.gender == '女' ? 'female' : 'male'">{{ row.target.gender == '女' ? '♀' : '♂' }}</text></view><view class="workspace-meeting-name-row" @click="openWorkspaceMemberProfile(row.target)"><text class="workspace-meeting-name">{{ row.target.name }}</text><text v-if="isVipPerson(row.target)" class="workspace-meeting-vip">VIP</text></view><text class="workspace-meeting-person-code">编号：{{ row.target.id }}</text></view></view><view class="workspace-meeting-meta"><view class="workspace-meeting-meta-line"><text class="workspace-meeting-meta-glyph">🕐</text><text>提交时间：{{ row.createdAt }}</text></view><view class="workspace-meeting-meta-line"><text class="workspace-meeting-meta-glyph">👤</text><text>服务红娘：{{ row.owner }}</text></view></view><view v-if="row.meeting != null" class="workspace-meeting-arrangement"><text>约见安排</text><view><text>{{ row.meeting.scheduledAt }}</text></view></view><view class="workspace-meeting-foot"><view v-if="row.phase == 'PROCESSING'" class="workspace-meeting-status-btn pending" @click="openMeetingStatusSheet(row)"><text>处理状态</text><view class="workspace-meeting-status-arrow"><i></i></view></view><view v-if="row.phase == 'PROCESSING' && row.requestStatus == 'ACCEPTED'" class="workspace-meeting-status-btn done" @click="openMeetingScheduleSheet(row)"><text>安排约见</text><view class="workspace-meeting-status-arrow"><i></i></view></view><view v-if="row.phase == 'UPCOMING'" class="workspace-meeting-status-btn pending" @click="openMeetingRecordSheet(row)"><text>约见管理</text><view class="workspace-meeting-status-arrow"><i></i></view></view><view class="workspace-meeting-delete" @click="openMeetingDeleteSheet(row)"><text>删除记录</text></view></view></view></view>
					<view v-if="workspaceKind == 'meeting' && workspaceMeetingsLoaded && workspaceVisibleMeetings.length > 0" class="workspace-scroll-top" @click="scrollWorkspaceTop"><text class="workspace-scroll-top-arrow">↑</text></view>
				</view>

				<view v-else-if="workspaceKind == 'entry' && workspaceTitle == '录入会员'" class="workspace-entry-page">
					<view class="workspace-entry-hero">
						<view class="workspace-entry-hero-copy">
							<text class="workspace-entry-hero-title">分派提示</text>
							<text class="workspace-entry-hero-sub">录入的会员进入待审核名单并挂到您名下，审核通过后开始参与匹配推荐</text>
						</view>
						<view class="workspace-entry-demo" @click="fillMemberDemo"><text>{{ memberEntryFilled ? '清空示例' : '填充示例' }}</text></view>
					</view>

					<view class="workspace-entry-formcard">
						<view class="workspace-entry-card-head"><text class="workspace-entry-step">1</text><view class="workspace-entry-card-head-copy"><text class="workspace-entry-card-title">基础信息</text><text class="workspace-entry-card-require">昵称、姓名、手机为必填</text></view></view>
						<view class="workspace-entry-row"><text class="workspace-entry-label">昵称</text><input :value="memberEntry.nickname" @input="memberEntry.nickname = $event.detail.value" placeholder="会员展示昵称" :maxlength="20"/></view>
						<view class="workspace-entry-row"><text class="workspace-entry-label">姓名</text><input :value="memberEntry.realName" @input="memberEntry.realName = $event.detail.value" placeholder="真实姓名（保密存储）" :maxlength="20"/></view>
						<view class="workspace-entry-row"><text class="workspace-entry-label">性别</text><view class="workspace-entry-chips"><view v-for="g in memberGenderOptions" :key="g.value" class="workspace-entry-chip" :class="{ active: memberEntry.gender == g.value }" @click="memberEntry.gender = g.value"><text>{{ g.label }}</text></view></view></view>
						<view class="workspace-entry-row"><text class="workspace-entry-label">手机</text><input :value="memberEntry.phone" @input="memberEntry.phone = $event.detail.value" placeholder="11 位手机号" type="number" :maxlength="11"/></view>
						<view class="workspace-entry-row last"><text class="workspace-entry-label">微信</text><input :value="memberEntry.wechat" @input="memberEntry.wechat = $event.detail.value" placeholder="微信号"/></view>
					</view>

					<view class="workspace-entry-formcard">
						<view class="workspace-entry-card-head"><text class="workspace-entry-step">2</text><view class="workspace-entry-card-head-copy"><text class="workspace-entry-card-title">身体与属地</text><text class="workspace-entry-card-require">选填</text></view></view>
						<picker mode="date" :value="memberEntry.birthday" start="1950-01-01" end="2007-12-31" @change="memberEntry.birthday = $event.detail.value"><view class="workspace-entry-row"><text class="workspace-entry-label">生日</text><view class="workspace-entry-picker"><text>{{ memberEntry.birthday }}</text><i></i></view></view></picker>
						<view class="workspace-entry-row"><text class="workspace-entry-label">身高</text><input :value="memberEntry.height" @input="memberEntry.height = $event.detail.value" placeholder="cm，如 165" type="number" :maxlength="3"/></view>
						<view class="workspace-entry-row"><text class="workspace-entry-label">体重</text><input :value="memberEntry.weight" @input="memberEntry.weight = $event.detail.value" placeholder="kg，如 50" type="number" :maxlength="3"/></view>
						<view class="workspace-entry-row"><text class="workspace-entry-label">家乡</text><input :value="memberEntry.hometown" @input="memberEntry.hometown = $event.detail.value" placeholder="如：江苏省 南京市"/></view>
						<view class="workspace-entry-row" @click="openMemberResidencePicker('residence')"><text class="workspace-entry-label">现居</text><view class="workspace-entry-picker"><text>{{ memberEntry.residence.length > 0 ? memberEntry.residence : '请选择省市区' }}</text><i></i></view></view>
						<view class="workspace-entry-row last" @click="openMemberResidencePicker('household')"><text class="workspace-entry-label">户口</text><view class="workspace-entry-picker"><text>{{ memberEntry.household.length > 0 ? memberEntry.household : '请选择省市区' }}</text><i></i></view></view>
					</view>

					<view class="workspace-entry-formcard">
						<view class="workspace-entry-card-head"><text class="workspace-entry-step">3</text><view class="workspace-entry-card-head-copy"><text class="workspace-entry-card-title">教育与婚况</text><text class="workspace-entry-card-require">点选即填</text></view></view>
						<view class="workspace-entry-block"><text class="workspace-entry-block-label">学历</text><view class="workspace-entry-chips"><view v-for="e in memberEducationOptions" :key="e" class="workspace-entry-chip" :class="{ active: memberEntry.education == e }" @click="memberEntry.education = memberEntry.education == e ? '' : e"><text>{{ e }}</text></view></view></view>
						<view class="workspace-entry-block"><text class="workspace-entry-block-label">婚况</text><view class="workspace-entry-chips"><view v-for="m in memberMaritalOptions" :key="m" class="workspace-entry-chip" :class="{ active: memberEntry.maritalStatus == m }" @click="memberEntry.maritalStatus = m"><text>{{ m }}</text></view></view></view>
						<view class="workspace-entry-block">
							<text class="workspace-entry-block-label">职业</text>
							<view class="workspace-entry-chips">
								<view v-for="o in memberOccupationOptions" :key="o" class="workspace-entry-chip" :class="{ active: memberEntry.occupation == o }" @click="memberEntry.occupation = memberEntry.occupation == o ? '' : o"><text>{{ o }}</text></view>
								<view class="workspace-entry-chip" :class="{ active: memberEntry.occupation == '其他' }" @click="memberEntry.occupation = memberEntry.occupation == '其他' ? '' : '其他'"><text>其他</text></view>
							</view>
							<input v-if="memberEntry.occupation == '其他'" class="workspace-entry-custom-input" :value="memberEntry.occupationCustom" @input="memberEntry.occupationCustom = $event.detail.value" placeholder="请填写具体职业"/>
						</view>
						<view class="workspace-entry-block"><text class="workspace-entry-block-label">月收入</text><view class="workspace-entry-chips"><view v-for="i in memberIncomeOptions" :key="i" class="workspace-entry-chip" :class="{ active: memberEntry.income == i }" @click="memberEntry.income = memberEntry.income == i ? '' : i"><text>{{ i }}</text></view></view></view>
						<view class="workspace-entry-block">
							<text class="workspace-entry-block-label">民族</text>
							<picker :range="memberEthnicityOptions" :value="memberEthnicityIndex" @change="onMemberEthnicityChange"><view class="workspace-entry-picker"><text>{{ memberEntry.ethnicity.length > 0 ? memberEntry.ethnicity : '请选择民族' }}</text><i></i></view></picker>
						</view>
						<view class="workspace-entry-block last"><text class="workspace-entry-block-label">属相</text><view class="workspace-entry-chips"><view v-for="z in memberZodiacOptions" :key="z" class="workspace-entry-chip" :class="{ active: memberEntry.zodiac == z }" @click="memberEntry.zodiac = memberEntry.zodiac == z ? '' : z"><text>{{ z }}</text></view></view></view>
					</view>

					<view class="workspace-entry-formcard">
						<view class="workspace-entry-card-head"><text class="workspace-entry-step">4</text><view class="workspace-entry-card-head-copy"><text class="workspace-entry-card-title">生活与习惯</text><text class="workspace-entry-card-require">点选即填</text></view></view>
						<view class="workspace-entry-block"><text class="workspace-entry-block-label">购房</text><view class="workspace-entry-chips"><view v-for="h in memberHouseOptions" :key="h" class="workspace-entry-chip" :class="{ active: memberEntry.housing == h }" @click="memberEntry.housing = h"><text>{{ h }}</text></view></view></view>
						<view class="workspace-entry-block"><text class="workspace-entry-block-label">购车</text><view class="workspace-entry-chips"><view v-for="v in memberCarOptions" :key="v" class="workspace-entry-chip" :class="{ active: memberEntry.vehicle == v }" @click="memberEntry.vehicle = v"><text>{{ v }}</text></view></view></view>
						<view class="workspace-entry-block"><text class="workspace-entry-block-label">吸烟</text><view class="workspace-entry-chips"><view v-for="s in memberSmokeOptions" :key="s" class="workspace-entry-chip" :class="{ active: memberEntry.smoking == s }" @click="memberEntry.smoking = s"><text>{{ s }}</text></view></view></view>
						<view class="workspace-entry-block last"><text class="workspace-entry-block-label">喝酒</text><view class="workspace-entry-chips"><view v-for="d in memberDrinkOptions" :key="d" class="workspace-entry-chip" :class="{ active: memberEntry.drinking == d }" @click="memberEntry.drinking = d"><text>{{ d }}</text></view></view></view>
					</view>

					<view class="workspace-entry-formcard">
						<view class="workspace-entry-card-head"><text class="workspace-entry-step">5</text><view class="workspace-entry-card-head-copy"><text class="workspace-entry-card-title">补充说明</text><text class="workspace-entry-card-require">选填</text></view></view>
						<view class="workspace-entry-row"><text class="workspace-entry-label">宗教</text><input :value="memberEntry.religion" @input="memberEntry.religion = $event.detail.value" placeholder="如：无"/></view>
						<view class="workspace-entry-row"><text class="workspace-entry-label">结婚计划</text><input :value="memberEntry.marriagePlan" @input="memberEntry.marriagePlan = $event.detail.value" placeholder="如：两年内"/></view>
						<view class="workspace-entry-block"><text class="workspace-entry-block-label">会员标签</text><view class="workspace-entry-chips"><view v-for="t in memberTagOptions" :key="t" class="workspace-entry-chip" :class="{ active: memberEntry.tags.indexOf(t) >= 0 }" @click="toggleMemberTag(t)"><text>{{ t }}</text></view></view></view>
						<view class="workspace-entry-block last"><text class="workspace-entry-block-label">备注</text><textarea class="workspace-entry-textarea" :value="memberEntry.remark" @input="memberEntry.remark = $event.detail.value" placeholder="性格、兴趣爱好、择偶要求等补充信息" :maxlength="500" auto-height/></view>
					</view>

					<view class="workspace-entry-formcard">
						<view class="workspace-entry-card-head"><text class="workspace-entry-step">6</text><view class="workspace-entry-card-head-copy"><text class="workspace-entry-card-title">择偶要求</text><text class="workspace-entry-card-require">选填，帮助精准匹配</text></view></view>
						<view class="workspace-entry-block">
							<text class="workspace-entry-block-label">年龄</text>
							<view class="member-range-controls">
								<view class="member-range-slider">
									<text class="member-range-tag">最小</text>
									<slider class="member-slider" :min="18" :max="90" :value="memberEntry.pref.ageMin" :step="1" activeColor="#c18cf6" backgroundColor="#e9e5f2" block-size="22" @change="onMemberPrefAgeMin"/>
									<text class="member-range-val">{{ memberEntry.pref.ageMin }} 岁</text>
								</view>
								<view class="member-range-slider">
									<text class="member-range-tag">最大</text>
									<slider class="member-slider" :min="18" :max="90" :value="memberEntry.pref.ageMax" :step="1" activeColor="#c18cf6" backgroundColor="#e9e5f2" block-size="22" @change="onMemberPrefAgeMax"/>
									<text class="member-range-val">{{ memberEntry.pref.ageMax }} 岁</text>
								</view>
							</view>
						</view>
						<view class="workspace-entry-block">
							<text class="workspace-entry-block-label">身高</text>
							<view class="member-range-controls">
								<view class="member-range-slider">
									<text class="member-range-tag">最小</text>
									<slider class="member-slider" :min="150" :max="200" :value="memberEntry.pref.heightMin" :step="1" activeColor="#c18cf6" backgroundColor="#e9e5f2" block-size="22" @change="onMemberPrefHeightMin"/>
									<text class="member-range-val">{{ memberEntry.pref.heightMin }} cm</text>
								</view>
								<view class="member-range-slider">
									<text class="member-range-tag">最大</text>
									<slider class="member-slider" :min="150" :max="200" :value="memberEntry.pref.heightMax" :step="1" activeColor="#c18cf6" backgroundColor="#e9e5f2" block-size="22" @change="onMemberPrefHeightMax"/>
									<text class="member-range-val">{{ memberEntry.pref.heightMax }} cm</text>
								</view>
							</view>
						</view>
						<view class="workspace-entry-block"><text class="workspace-entry-block-label">收入</text><view class="workspace-entry-chips"><view v-for="i in memberPrefIncomeOptions" :key="i" class="workspace-entry-chip" :class="{ active: memberEntry.pref.income == i }" @click="memberEntry.pref.income = i"><text>{{ i }}</text></view></view></view>
						<view class="workspace-entry-block"><text class="workspace-entry-block-label">学历</text><view class="workspace-entry-chips"><view v-for="e in memberPrefEducationOptions" :key="e" class="workspace-entry-chip" :class="{ active: memberEntry.pref.education == e }" @click="memberEntry.pref.education = e"><text>{{ e }}</text></view></view></view>
						<view class="workspace-entry-block">
							<text class="workspace-entry-block-label">职业</text>
							<picker :range="memberPrefOccupationRange" :value="memberPrefOccupationIndex" @change="onMemberPrefOccupationChange"><view class="workspace-entry-picker"><text>{{ memberEntry.pref.occupation.length > 0 ? memberEntry.pref.occupation : '不限' }}</text><i></i></view></picker>
						</view>
						<view class="workspace-entry-block"><text class="workspace-entry-block-label">婚况</text><view class="workspace-entry-chips"><view v-for="m in memberPrefMarriageOptions" :key="m" class="workspace-entry-chip" :class="{ active: memberEntry.pref.marriageAccept == m }" @click="memberEntry.pref.marriageAccept = m"><text>{{ m }}</text></view></view></view>
						<view class="workspace-entry-block"><text class="workspace-entry-block-label">住房</text><view class="workspace-entry-chips"><view v-for="h in memberPrefHousingOptions" :key="h" class="workspace-entry-chip" :class="{ active: memberEntry.pref.housing == h }" @click="memberEntry.pref.housing = h"><text>{{ h }}</text></view></view></view>
						<view class="workspace-entry-block"><text class="workspace-entry-block-label">吸烟</text><view class="workspace-entry-chips"><view v-for="s in memberPrefSmokingOptions" :key="s" class="workspace-entry-chip" :class="{ active: memberEntry.pref.smoking == s }" @click="memberEntry.pref.smoking = s"><text>{{ s }}</text></view></view></view>
						<view class="workspace-entry-block last"><text class="workspace-entry-block-label">结婚</text><view class="workspace-entry-chips"><view v-for="w in memberPrefWeddingOptions" :key="w" class="workspace-entry-chip" :class="{ active: memberEntry.pref.weddingPlan == w }" @click="memberEntry.pref.weddingPlan = w"><text>{{ w }}</text></view></view></view>
					</view>

					<view v-if="memberEntryError.length > 0" class="workspace-form-error"><text>{{ memberEntryError }}</text></view>

					<view class="workspace-entry-submit" :class="{ disabled: memberEntrySubmitting }" @click="submitMemberEntry"><text>{{ memberEntrySubmitting ? '提交中…' : '完成录入' }}</text></view>
					<view class="workspace-entry-foot"><text>提交后进入待审核状态，仅用于平台牵线服务</text></view>

					<!-- 现居/户口省市区三级选择弹层 -->
					<view v-if="memberResidencePickerVisible" class="cp-overlay open" @tap="closeMemberResidencePicker">
						<view class="cp-card" @tap.stop>
							<view class="cp-head"><text class="cp-title">{{ memberRegionPickerTitle }}</text><view class="cp-close" @tap="closeMemberResidencePicker"><text>✕</text></view></view>
							<view v-if="memberResidencePickerLoading" class="cp-state"><text>正在加载省市数据…</text></view>
							<picker v-else mode="multiSelector" :range="memberResidenceRange" :value="memberResidenceValue" @columnchange="onMemberResidenceColumnChange" @change="onMemberResidenceChange">
								<view class="workspace-entry-picker"><text>{{ memberRegionPickerValue }}</text><i></i></view>
							</picker>
						</view>
					</view>
				</view>

				<view v-else-if="workspaceKind == 'entry' && workspaceTitle == '录入客源线索'" class="workspace-entry-page">
					<view class="workspace-entry-hero">
						<view class="workspace-entry-hero-copy">
							<text class="workspace-entry-hero-title">分派提示</text>
							<text class="workspace-entry-hero-sub">您录入的客源将挂到您名下，平台核实后即可开始跟进</text>
						</view>
						<view class="workspace-entry-demo" @click="fillLeadDemo"><text>{{ leadDemoFilled ? '清空示例' : '填充示例' }}</text></view>
					</view>

					<view class="workspace-entry-formcard">
						<view class="workspace-entry-card-head"><text class="workspace-entry-step">1</text><view class="workspace-entry-card-head-copy"><text class="workspace-entry-card-title">联系方式</text><text class="workspace-entry-card-require">电话、微信至少填一项</text></view></view>
						<view class="workspace-entry-row"><text class="workspace-entry-label">称呼</text><input :value="leadFormName" @input="leadFormName = $event.detail.value" placeholder="如：李阿姨介绍的小雅" :maxlength="20"/></view>
						<view class="workspace-entry-row"><text class="workspace-entry-label">电话</text><input :value="leadFormPhone" @input="leadFormPhone = $event.detail.value" placeholder="11 位手机号" type="number" :maxlength="11"/></view>
						<view class="workspace-entry-row last"><text class="workspace-entry-label">微信</text><input :value="leadFormWechat" @input="leadFormWechat = $event.detail.value" placeholder="微信号，可与电话相同"/></view>
					</view>

					<view class="workspace-entry-formcard">
						<view class="workspace-entry-card-head"><text class="workspace-entry-step">2</text><view class="workspace-entry-card-head-copy"><text class="workspace-entry-card-title">客源画像</text><text class="workspace-entry-card-require">选填，帮助快速判断意向</text></view></view>
						<view class="workspace-entry-block">
							<text class="workspace-entry-block-label">性别</text>
							<view class="workspace-entry-chips">
								<view class="workspace-entry-chip" :class="{ active: leadFormGender == 1 }" @click="leadFormGender = leadFormGender == 1 ? 0 : 1"><text>男</text></view>
								<view class="workspace-entry-chip" :class="{ active: leadFormGender == 2 }" @click="leadFormGender = leadFormGender == 2 ? 0 : 2"><text>女</text></view>
							</view>
						</view>
						<view class="workspace-entry-block">
							<text class="workspace-entry-block-label">出生年月日</text>
							<picker class="workspace-entry-picker" mode="date" :value="leadFormBirthday" start="1940-01-01" end="2008-12-31" @change="onLeadFormBirthday">
								<text>{{ leadFormBirthday.length > 0 ? leadFormBirthday : '请选择出生年月日' }}</text><i></i>
							</picker>
						</view>
						<view class="workspace-entry-block">
							<text class="workspace-entry-block-label">照片</text>
							<view class="lead-photo-upload">
								<image v-if="leadFormPhoto.length > 0" class="lead-photo-preview" :src="leadFormPhoto" mode="aspectFill" @click="previewLeadPhoto"/>
								<view v-else class="lead-photo-add" @click="chooseLeadPhoto"><text class="lead-photo-plus">＋</text><text>上传照片</text></view>
								<text v-if="leadFormPhoto.length > 0" class="lead-photo-remove" @click="leadFormPhoto = ''">移除</text>
							</view>
						</view>
						<view class="workspace-entry-block">
							<text class="workspace-entry-block-label">来源渠道</text>
							<view class="workspace-entry-chips">
								<view v-for="c in leadSourceOptions" :key="c" class="workspace-entry-chip" :class="{ active: leadFormSource == c }" @click="leadFormSource = leadFormSource == c ? '' : c"><text>{{ c }}</text></view>
							</view>
						</view>
						<view class="workspace-entry-block">
							<text class="workspace-entry-block-label">意向程度</text>
							<view class="workspace-entry-chips">
								<view v-for="lv in leadEntryIntentionOptions" :key="lv.value" class="workspace-entry-chip" :class="{ active: leadFormIntention == lv.value }" @click="leadFormIntention = lv.value"><text>{{ lv.label }}</text></view>
							</view>
						</view>
						<view class="workspace-entry-block last">
							<text class="workspace-entry-block-label">补充描述</text>
							<textarea class="workspace-entry-textarea" :value="leadFormRemark" @input="leadFormRemark = $event.detail.value" placeholder="职业、学历、身高、婚况、收入、择偶需求等，便于后续匹配推荐" :maxlength="500" auto-height/>
						</view>
					</view>

					<view v-if="leadFormError.length > 0" class="workspace-form-error"><text>{{ leadFormError }}</text></view>

					<view class="workspace-entry-submit" :class="{ disabled: leadFormSubmitting }" @click="submitLeadForm"><text>{{ leadFormSubmitting ? '提交中…' : '确定提交' }}</text></view>
					<view class="workspace-entry-foot"><text>提交即表示信息经本人确认，仅用于平台牵线服务</text></view>
				</view>

				<view v-else-if="workspaceKind == 'member'">
					<view v-if="workspaceMembersLoading" class="workspace-state"><text>正在加载会员数据…</text></view>
					<view v-else-if="workspaceMembersError.length > 0" class="workspace-state"><text>{{ workspaceMembersError }}</text><text class="workspace-state-action" @click="loadWorkspaceMembers">重新加载</text></view>
					<view v-else-if="workspaceVisibleMembers.length == 0" class="workspace-state"><text>没有符合条件的会员</text></view>
					<view v-else><view v-for="member in workspaceVisibleMembers" :key="member.id" class="workspace-info-card"><view class="workspace-member-header"><image :src="member.avatar" mode="aspectFill"/><view><text>{{ member.name }} · {{ member.gender }}</text><text>编号：{{ member.id }} · {{ member.type }}</text></view></view><view><text>服务红娘</text><text>{{ member.owner }}</text></view><view><text>资料状态</text><text>{{ member.status }}</text></view><view class="workspace-actions"><text @click="showToast('已打开会员资料')">详细资料</text><text @click="showToast('已打开服务跟进')">服务跟进</text><text @click="showToast('已打开牵线记录')">牵线记录</text></view></view></view>
				</view>

				<view v-else-if="workspaceKind == 'activity'">
					<view v-for="activity in workspaceActivities" :key="activity.title" class="workspace-info-card"><text>{{ activity.title }}</text><text class="workspace-muted">{{ activity.time }} · {{ activity.city }}</text><view><text>报名人数</text><text>{{ activity.count }} 人</text></view><view><text>审核状态</text><text>{{ activity.status }}</text></view><view class="workspace-actions"><text @click="showToast('已打开报名名单')">报名名单</text><text @click="showToast('已打开活动编辑')">编辑</text><text @click="showToast('报名审核已保存')">报名审核</text></view></view>
				</view>

				<view v-else-if="workspaceKind == 'video'" class="workspace-info-card"><text>视频管理</text><text class="workspace-muted">该能力尚未在移动工作台开放。</text></view>

				<view v-else><view v-for="row in workspaceGenericRows" :key="row.title" class="workspace-generic-card"><view><text>{{ row.icon }}</text></view><view><text>{{ row.title }}</text><text>{{ row.desc }}</text></view><text @click="showToast(row.action)">{{ row.action }} ></text></view></view>
			</view>
			<view v-if="workspaceKind != 'meeting' && workspaceKind != 'entry'" class="workspace-add" :class="{ 'match-add': workspaceKind == 'match' }" @click="workspaceKind == 'lead' ? openLeadAddSheet() : (workspaceKind == 'match' ? openMatchAddSheet() : showToast('新增记录表单已打开'))"><text>+</text><text>添加</text></view>
		</scroll-view>
		<MatchmakerManagementCenter
			v-else-if="managementCenterVisible && managementCenterSnapshot != null"
			:snapshot="managementCenterSnapshot"
			@exit="exitManagementCenter"
			@refresh="refreshManagementCenter"
			@identity="openMatchmakerIdentity"
			@action="handleManagementCenterAction"
		/>
		<view v-else-if="managementCenterLoading" class="management-center-loading">
			<view class="management-loading-card management-loading-identity"></view>
			<view class="management-loading-tabs">
				<view class="management-loading-pill"></view>
				<view class="management-loading-pill"></view>
				<view class="management-loading-pill short"></view>
			</view>
			<view class="management-loading-heading"></view>
			<view class="management-loading-grid">
				<view class="management-loading-card"></view>
				<view class="management-loading-card"></view>
				<view class="management-loading-card"></view>
				<view class="management-loading-card"></view>
			</view>
		</view>

		<scroll-view v-else scroll-y class="page-scroller" :show-scrollbar="false">
			<view class="page-content">
				<!-- Banner 宣传区域 -->
				<view class="banner-card">
					<view class="banner-copy">
						<text class="banner-kicker">红娘招募</text>
						<text class="banner-title">用你的真诚经验，帮助更多人稳稳靠近幸福</text>
						<text class="banner-desc">提交资料后，平台将尽快联系你确认服务信息。</text>
					</view>
				</view>

				<!-- 服务端确认服务红娘角色有效后即可进入；本期不以支付作为门槛。 -->
				<view class="management-entry" :class="{ ready: canEnterManagementCenter }">
					<view class="management-entry-copy">
					<view class="management-entry-title-row">
						<text class="management-entry-title">红娘管理中心</text>
					</view>
						<text class="management-entry-desc">{{ managementAccessDescription }}</text>
					</view>
					<view
						class="management-entry-action"
						:class="{ disabled: !canEnterManagementCenter || managementAccessLoading || managementCenterLoading }"
						@click="openManagementCenter"
					>
						<text>{{ managementAccessActionText }}</text>
					</view>
				</view>

				<!-- 基本信息 -->
				<view class="form-card">
					<text class="section-title">基本信息</text>
					<text class="section-desc">用于身份核验与平台联系，信息不会对外公开。</text>

					<view class="form-field">
						<text class="field-label">真实姓名 <text class="required">*</text></text>
						<input
							class="field-input"
							:value="realName"
							placeholder="请填写真实姓名"
							@input="onRealNameInput"
						/>
					</view>

					<view class="form-field">
						<text class="field-label">手机号 <text class="required">*</text></text>
						<input
							class="field-input"
							type="number"
							maxlength="11"
							:value="phone"
							placeholder="用于接收审核通知"
							@input="onPhoneInput"
						/>
					</view>

					<view class="form-field">
						<text class="field-label">微信号 <text class="required">*</text></text>
						<input
							class="field-input"
							:value="wechat"
							placeholder="便于平台工作人员后续沟通"
							@input="onWechatInput"
						/>
					</view>
				</view>

				<!-- 红娘资料 -->
				<view class="form-card">
					<text class="section-title">红娘资料</text>
					<text class="section-desc">展示给用户的专业形象，建议完整填写。</text>

					<!-- 上传头像 -->
					<view class="form-field">
						<text class="field-label">上传头像 <text class="required">*</text></text>
						<view class="avatar-upload" @click="uploadAvatar">
							<image
								v-if="avatar.length > 0"
								class="avatar-preview"
								:src="avatar"
								mode="aspectFill"
							></image>
							<view v-else class="avatar-placeholder">
								<text class="avatar-plus">+</text>
								<text class="avatar-hint">点击上传头像</text>
							</view>
						</view>
						<text class="field-hint">建议使用真实、清晰的正面照，裁剪比例 1:1</text>
					</view>

					<!-- 个人简介 -->
					<view class="form-field">
						<text class="field-label">个人简介 <text class="required">*</text></text>
						<textarea
							class="field-textarea"
							:value="introduction"
							maxlength="200"
							placeholder="简短介绍你的背景、经验和风格，例如：专注高知青年牵线服务，已有5年经验。"
							@input="onIntroductionInput"
						/>
						<text class="field-counter">{{ introduction.length }}/200</text>
					</view>

					<!-- 擅长领域 -->
					<view class="form-field">
						<text class="field-label">擅长领域 <text class="required">*</text></text>
						<view class="specialty-grid">
							<view
								v-for="item in specialtyOptions"
								:key="item"
								class="specialty-chip"
								:class="{ selected: specialties.indexOf(item) >= 0 }"
								@click="toggleSpecialty(item)"
							>
								<text>{{ item }}</text>
							</view>
						</view>
					</view>

					<!-- 服务价格 -->
					<view class="form-field">
						<text class="field-label">服务价格 <text class="optional">选填</text></text>
						<view class="price-input-row">
							<text class="price-prefix">¥</text>
							<input
								class="price-input"
								type="digit"
								:value="price"
								placeholder="不填则默认免费咨询"
								@input="onPriceInput"
							/>
							<text class="price-suffix">/次</text>
						</view>
					</view>
				</view>

				<!-- 成功案例 -->
				<view class="form-card">
					<view class="section-title-row">
						<text class="section-title">成功案例</text>
						<text class="optional-label">选填</text>
					</view>
					<text class="section-desc">展示过往牵线经验，增强可信度。内容需脱敏处理，避免泄露用户隐私。</text>

					<view
						v-for="(caseItem, index) in successCases"
						:key="index"
						class="case-block"
					>
						<view class="case-block-header">
							<text class="case-block-title">案例 {{ index + 1 }}</text>
							<view class="case-delete" @click="removeCase(index)">
								<text>删除</text>
							</view>
						</view>

						<view class="form-field">
							<text class="field-label">案例描述</text>
							<textarea
								class="field-textarea case-textarea"
								:value="caseItem.description"
								maxlength="200"
								placeholder="例如：成功帮助一位教师与工程师牵线。"
								@input="(e: any) => onCaseDescriptionInput(index, e)"
							/>
						</view>

						<view class="form-field">
							<text class="field-label">案例图片</text>
							<view class="case-images">
								<view
									v-for="(img, imgIndex) in caseItem.images"
									:key="imgIndex"
									class="case-image-item"
								>
									<image class="case-image-preview" :src="img" mode="aspectFill"></image>
									<view class="case-image-delete" @click="removeCaseImage(index, imgIndex)">
										<text>×</text>
									</view>
								</view>
								<view
									v-if="caseItem.images.length < 3"
									class="case-image-add"
									@click="uploadCaseImage(index)"
								>
									<text class="case-add-plus">+</text>
								</view>
							</view>
						</view>
					</view>

					<view class="add-case-button" @click="addCase" v-if="successCases.length < 3">
						<text>+ 添加案例</text>
					</view>
				</view>

				<!-- 审核流程 -->
				<view class="form-card process-card">
					<text class="section-title">审核流程</text>
					<text class="section-desc">提交申请后，预计 1-3 个工作日内完成审核。</text>

					<view class="process-steps">
						<view
							v-for="(step, index) in processSteps"
							:key="step.title"
							class="process-step"
						>
							<view class="step-indicator" :class="{ active: index === 0, done: index < currentStep }">
								<text v-if="index < currentStep">✓</text>
								<text v-else>0{{ index + 1 }}</text>
							</view>
							<view class="step-copy">
								<text class="step-title">{{ step.title }}</text>
								<text class="step-desc">{{ step.desc }}</text>
							</view>
							<view v-if="index < processSteps.length - 1" class="step-line"></view>
						</view>
					</view>

					<!-- 咨询入口 -->
					<view class="consult-icons">
						<view class="phone-slot" @click="callConsult">
							<image class="phone-brand" src="/static/icons/phone-call.svg" mode="aspectFit"></image>
						</view>
						<view class="wechat-slot" @click="wechatConsult">
							<image class="wechat-brand" src="/static/icons/wechat-bubble.svg" mode="aspectFit"></image>
						</view>
					</view>
				</view>

				<!-- 微信二维码弹窗 -->
				<view class="qr-overlay" v-if="qrVisible" @click="qrVisible = false">
					<view class="qr-card" @click.stop>
						<view class="qr-close" @click="qrVisible = false">
							<text>×</text>
						</view>
						<text class="qr-title">微信扫码咨询</text>
						<text class="qr-subtitle">添加客服微信，备注"红娘入驻咨询"</text>
						<view class="qr-image-wrap">
							<image class="qr-image" src="/static/qrcodes/kefu-wechat.png" mode="aspectFit"></image>
						</view>
						<text class="qr-tip">长按识别二维码添加</text>
					</view>
				</view>

				<!-- 隐私声明 -->
				<view class="privacy-card">
					<text class="privacy-title">隐私与安全</text>
					<text class="privacy-copy">你所提交的全部资料将受到平台隐私协议保护，仅用于红娘资质审核与服务安排。请如实填写，不要提交他人的联系方式或敏感身份信息。审核通过后，你可在个人设置中随时管理展示范围。</text>
				</view>

				<!-- 底部占位 -->
				<view class="bottom-spacer"></view>
			</view>
		</scroll-view>

		<!-- 底部提交按钮 -->
		<view v-if="!pendingReviewVisible && !workspaceVisible && !managementCenterVisible && !managementCenterLoading" class="footer-safe">
			<view
				class="submit-button"
				:class="{ disabled: !canSubmit || submitting }"
				@click="submitApplication"
			>
				<text>{{ submitting ? '提交中…' : (canSubmit ? '提交申请' : '请补全必填信息') }}</text>
			</view>
		</view>

		<!-- 线索：状态选择 -->
		<XsaSheet :visible="leadStatusSheetVisible" title="状态" @close="leadStatusSheetVisible = false">
			<view class="workspace-option-list">
				<view v-for="opt in leadStatusOptions" :key="opt.value" class="workspace-option" :class="{ disabled: opt.disabled, selected: leadStatusCurrent == opt.value }" @click="opt.disabled ? showToast('已入库的客源不可回退') : selectLeadStatus(opt.value)">
					<text>{{ opt.label }}</text>
					<text v-if="leadStatusCurrent == opt.value" class="workspace-option-check">✓</text>
				</view>
			</view>
		</XsaSheet>

		<!-- 线索：意向选择 -->
		<XsaSheet :visible="leadIntentionSheetVisible" title="意向" @close="leadIntentionSheetVisible = false">
			<view class="workspace-option-list">
				<view v-for="opt in leadIntentionOptions" :key="opt.value" class="workspace-option" :class="{ selected: leadIntentionCurrent == opt.value }" @click="selectLeadIntention(opt.value)">
					<text>{{ opt.label }}</text>
					<text v-if="leadIntentionCurrent == opt.value" class="workspace-option-check">✓</text>
				</view>
			</view>
		</XsaSheet>

		<!-- 线索：分派跟进 -->
		<XsaSheet :visible="leadAssignSheetVisible" title="分派跟进" @close="leadAssignSheetVisible = false">
			<view v-if="leadFollowersLoading" class="workspace-state"><text>正在加载红娘列表…</text></view>
			<view v-else class="workspace-option-list">
				<view v-for="f in leadFollowers" :key="f.userId" class="workspace-option" :class="{ selected: leadAssignCurrent == f.userId }" @click="selectLeadAssign(f)">
					<text>{{ f.displayName }}{{ f.isSelf ? '（我）' : '' }}</text>
					<text v-if="leadAssignCurrent == f.userId" class="workspace-option-check">✓</text>
				</view>
			</view>
		</XsaSheet>

		<!-- 线索：筛选 -->
		<XsaSheet :visible="leadFilterSheetVisible" title="筛选客源" @close="leadFilterSheetVisible = false">
			<view class="workspace-filter-group">
				<text class="workspace-filter-label">状态</text>
				<view class="workspace-filter-chips">
					<view class="workspace-filter-chip" :class="{ active: leadFilterStatus.length == 0 }" @click="leadFilterStatus = []"><text>全部</text></view>
					<view v-for="opt in leadStatusOptions" :key="opt.value" class="workspace-filter-chip" :class="{ active: leadFilterStatus.indexOf(opt.value) >= 0 }" @click="toggleLeadFilterStatus(opt.value)"><text>{{ opt.label }}</text></view>
				</view>
			</view>
			<view class="workspace-filter-group">
				<text class="workspace-filter-label">意向级别</text>
				<view class="workspace-filter-chips">
					<view class="workspace-filter-chip" :class="{ active: leadFilterIntention == 0 }" @click="leadFilterIntention = 0"><text>全部</text></view>
					<view v-for="opt in leadIntentionOptions" :key="opt.value" class="workspace-filter-chip intention-filter-chip" :class="{ active: leadFilterIntention == opt.value }" @click="leadFilterIntention = opt.value"><text>{{ opt.label }}</text></view>
				</view>
			</view>
			<view class="workspace-sheet-actions">
				<view class="workspace-sheet-btn ghost" @click="resetLeadFilter"><text>重置</text></view>
				<view class="workspace-sheet-btn" @click="applyLeadFilter"><text>确认</text></view>
			</view>
		</XsaSheet>

		<!-- 线索：添加 / 编辑 -->
		<XsaSheet :visible="leadFormSheetVisible" :title="leadFormIsEdit ? '编辑线索' : '添加线索'" @close="leadFormSheetVisible = false">
			<view class="workspace-lead-form">
				<view class="workspace-form-row"><text>称呼</text><input :value="leadFormName" @input="leadFormName = $event.detail.value" placeholder="客户称呼（必填）"/></view>
				<view class="workspace-form-row"><text>电话</text><input :value="leadFormPhone" @input="leadFormPhone = $event.detail.value" placeholder="手机号" type="number"/></view>
				<view class="workspace-form-row"><text>微信</text><input :value="leadFormWechat" @input="leadFormWechat = $event.detail.value" placeholder="微信号"/></view>
				<view class="workspace-form-row"><text>性别</text>
					<view class="workspace-entry-options">
						<view class="workspace-entry-option" :class="{ selected: leadFormGender == 1 }" @click="leadFormGender = leadFormGender == 1 ? 0 : 1"><text class="workspace-entry-radio"></text><text>男</text></view>
						<view class="workspace-entry-option" :class="{ selected: leadFormGender == 2 }" @click="leadFormGender = leadFormGender == 2 ? 0 : 2"><text class="workspace-entry-radio"></text><text>女</text></view>
					</view>
				</view>
				<picker class="workspace-form-row workspace-form-picker" mode="date" :value="leadFormBirthday" start="1940-01-01" end="2008-12-31" @change="onLeadFormBirthday">
					<text>出生年月日</text>
					<view class="workspace-form-picker-value"><text>{{ leadFormBirthday.length > 0 ? leadFormBirthday : '请选择' }}</text><text class="workspace-entry-chevron">›</text></view>
				</picker>
				<view class="workspace-form-row"><text>照片</text>
					<view class="lead-photo-upload">
						<image v-if="leadFormPhoto.length > 0" class="lead-photo-preview" :src="leadFormPhoto" mode="aspectFill" @click="previewLeadPhoto"/>
						<view v-else class="lead-photo-add" @click="chooseLeadPhoto"><text class="lead-photo-plus">＋</text><text>上传照片</text></view>
						<text v-if="leadFormPhoto.length > 0" class="lead-photo-remove" @click="leadFormPhoto = ''">移除</text>
					</view>
				</view>
				<view class="workspace-form-row"><text>来源渠道</text>
					<view class="workspace-entry-options workspace-entry-options-wrap">
						<view v-for="c in leadSourceOptions" :key="c" class="workspace-entry-chip" :class="{ active: leadFormSource == c }" @click="leadFormSource = leadFormSource == c ? '' : c"><text>{{ c }}</text></view>
					</view>
				</view>
				<view class="workspace-form-row"><text>备注</text><input :value="leadFormRemark" @input="leadFormRemark = $event.detail.value" placeholder="补充说明"/></view>
				<view v-if="leadFormError.length > 0" class="workspace-form-error"><text>{{ leadFormError }}</text></view>
				<view class="workspace-sheet-actions">
					<view class="workspace-sheet-btn ghost" @click="leadFormSheetVisible = false"><text>取消</text></view>
					<view class="workspace-sheet-btn" :class="{ disabled: leadFormSubmitting }" @click="submitLeadForm"><text>{{ leadFormSubmitting ? '保存中…' : '保存' }}</text></view>
				</view>
			</view>
		</XsaSheet>

		<!-- 约见申请：审核状态 / 删除确认 -->
		<XsaSheet :visible="matchStatusSheetVisible" title="牵线状态" @close="matchStatusSheetVisible = false">
			<view class="workspace-match-status-form">
				<view class="workspace-match-status-choices">
					<view v-for="opt in matchStatusOptions" :key="opt.value" class="workspace-match-status-choice" :class="{ active: matchStatusChoice == opt.value }" @click="matchStatusChoice = opt.value"><text>{{ opt.label }}</text></view>
				</view>
				<textarea v-if="matchStatusChoice == 'FAILED'" class="workspace-entry-textarea" :value="matchFailureReason" @input="matchFailureReason = $event.detail.value" placeholder="请填写失败原因，如：超出时间未完成牵线，次数已退回" :maxlength="500" auto-height/>
				<view class="workspace-match-status-submit" :class="{ disabled: matchStatusSubmitting }" @click="submitMatchStatus"><text>{{ matchStatusSubmitting ? '提交中…' : '提交' }}</text></view>
			</view>
		</XsaSheet>
				<XsaSheet :visible="matchAddSheetVisible" title="添加牵线记录" @close="matchAddSheetVisible = false">
			<view class="workspace-match-add-form">
				<view class="workspace-match-add-row" @click="openMatchAddPicker('from')"><text class="workspace-match-add-label">牵线会员</text><view class="workspace-match-add-picker"><text :class="{ placeholder: matchAddFromName == '' }">{{ matchAddFromName == '' ? '请选择' : matchAddFromName }}</text><i></i></view></view>
				<view class="workspace-match-add-row" @click="openMatchAddPicker('to')"><text class="workspace-match-add-label">被牵线会员</text><view class="workspace-match-add-picker"><text :class="{ placeholder: matchAddToName == '' }">{{ matchAddToName == '' ? '请选择' : matchAddToName }}</text><i></i></view></view>
				<picker mode="date" :value="matchAddAppliedAt" start="2020-01-01" end="2030-12-31" @change="matchAddAppliedAt = $event.detail.value"><view class="workspace-match-add-row"><text class="workspace-match-add-label">牵线申请时间</text><view class="workspace-match-add-picker"><text :class="{ placeholder: matchAddAppliedAt == '' }">{{ matchAddAppliedAt == '' ? '请选择' : matchAddAppliedAt }}</text><i></i></view></view></picker>
				<picker mode="date" :value="matchAddFinishedAt" start="2020-01-01" end="2030-12-31" @change="matchAddFinishedAt = $event.detail.value"><view class="workspace-match-add-row last"><text class="workspace-match-add-label">牵线完成时间</text><view class="workspace-match-add-picker"><text :class="{ placeholder: matchAddFinishedAt == '' }">{{ matchAddFinishedAt == '' ? '请选择' : matchAddFinishedAt }}</text><i></i></view></view></picker>
				<view class="workspace-match-add-row last"><text class="workspace-match-add-label">牵线结果</text><view class="workspace-match-add-result"><view class="workspace-match-add-radio" :class="{ active: matchAddResult == 'SUCCEEDED' }" @click="matchAddResult = 'SUCCEEDED'"><text v-if="matchAddResult == 'SUCCEEDED'">✓</text></view><text :class="{ 'radio-on': matchAddResult == 'SUCCEEDED' }">牵线成功</text><view class="workspace-match-add-radio" :class="{ active: matchAddResult == 'FAILED' }" @click="matchAddResult = 'FAILED'"><text v-if="matchAddResult == 'FAILED'">✓</text></view><text :class="{ 'radio-on': matchAddResult == 'FAILED' }">牵线失败</text></view></view>
				<textarea v-if="matchAddResult == 'FAILED'" class="workspace-entry-textarea" :value="matchAddFailureReason" @input="matchAddFailureReason = $event.detail.value" placeholder="请填写失败原因（必填）" :maxlength="500" auto-height/>
				<view class="workspace-match-add-note"><text class="workspace-match-add-note-mark">T</text><text>牵线成功：从牵线会员的账号中扣除1次牵线次数；
牵线失败：不扣除牵线次数。</text></view>
				<view v-if="matchAddError.length > 0" class="workspace-form-error"><text>{{ matchAddError }}</text></view>
				<view class="workspace-match-add-submit" :class="{ disabled: matchAddSubmitting }" @click="submitMatchAdd"><text>{{ matchAddSubmitting ? '提交中…' : '提交' }}</text></view>
			</view>
		</XsaSheet>

		<!-- 会员选择弹层（添加牵线记录用） -->
		<XsaSheet :visible="matchAddPickerVisible" :title="matchAddPickerKind == 'from' ? '选择牵线会员' : '选择被牵线会员'" @close="matchAddPickerVisible = false">
			<view class="workspace-match-add-picker">
				<view v-if="!matchAddLoading && matchAddCandidates.length > 0" class="workspace-search"><text class="workspace-search-glyph">⌕</text><input placeholder="输入名字 / 编号搜索会员" :value="matchAddSearch" @input="onMatchAddSearchInput"/></view>
				<view v-if="matchAddLoading" class="workspace-state"><text>正在加载会员…</text></view>
				<view v-else-if="matchAddCandidates.length == 0" class="workspace-state"><text>服务范围内暂无会员</text></view>
				<view v-else-if="matchAddFilteredCandidates.length == 0" class="workspace-state"><text>没有匹配「{{ matchAddSearch }}」的会员</text></view>
				<view v-else class="workspace-option-list">
					<view v-for="m in matchAddFilteredCandidates" :key="m.id" class="workspace-option" :class="{ selected: isMatchAddPicked(m.id) }" @click="pickMatchAddMember(m)">
						<text>{{ m.name }}（{{ m.gender }} · {{ m.id }}）</text>
						<text v-if="isMatchAddPicked(m.id)" class="workspace-option-check">✓</text>
					</view>
				</view>
			</view>
		</XsaSheet>

<XsaSheet :visible="meetingStatusSheetVisible" title="审核状态" @close="meetingStatusSheetVisible = false">
			<view class="workspace-meeting-status-form">
				<view class="workspace-meeting-status-pair">
					<view class="workspace-meeting-status-pill" :class="{ active: meetingStatusChoice == 'SUBMITTED' }" @click="meetingStatusChoice = 'SUBMITTED'"><text>待处理</text></view>
					<view class="workspace-meeting-status-pill" :class="{ active: meetingStatusChoice == 'ACCEPTED' }" @click="meetingStatusChoice = 'ACCEPTED'"><text>已处理</text></view>
				</view>
				<view class="workspace-match-status-submit" :class="{ disabled: meetingStatusSubmitting }" @click="submitMeetingStatus"><text>{{ meetingStatusSubmitting ? '提交中…' : '提交' }}</text></view>
			</view>
		</XsaSheet>
		<XsaSheet :visible="meetingDeleteSheetVisible" title="删除记录" @close="meetingDeleteSheetVisible = false">
			<view class="workspace-meeting-status-form">
				<text v-if="meetingDeleteRow != null" class="workspace-confirm-tip">确定删除 #{{ meetingDeleteRow.id }}（{{ meetingDeleteRow.applicant.name }} × {{ meetingDeleteRow.target.name }}）的约见申请吗？关联的约见安排会一并删除，删除后不可恢复。</text>
				<view class="workspace-sheet-actions">
					<view class="workspace-sheet-btn ghost" @click="meetingDeleteSheetVisible = false"><text>取消</text></view>
					<view class="workspace-sheet-btn" :class="{ disabled: meetingDeleteSubmitting }" @click="submitMeetingDelete"><text>{{ meetingDeleteSubmitting ? '删除中…' : '确认删除' }}</text></view>
				</view>
			</view>
		</XsaSheet>

		<!-- 约见：安排约见弹层（仅双方接受的申请） -->
		<XsaSheet :visible="meetingScheduleSheetVisible" title="安排约见" @close="meetingScheduleSheetVisible = false">
			<view class="workspace-meeting-status-form">
				<text v-if="meetingScheduleRow != null" class="workspace-confirm-tip">{{ meetingScheduleRow.applicant.name }} × {{ meetingScheduleRow.target.name }} 已同意约见，请协调双方时间后安排。</text>
				<picker mode="date" :value="meetingScheduleDate" :start="meetingScheduleMinDate" end="2030-12-31" @change="onMeetingScheduleDate">
					<view class="workspace-match-add-row"><text class="workspace-match-add-label">约见日期</text><view class="workspace-match-add-picker"><text :class="{ placeholder: meetingScheduleDate == '' }">{{ meetingScheduleDate == '' ? '请选择' : meetingScheduleDate }}</text><i></i></view></view>
				</picker>
				<picker mode="time" :value="meetingScheduleTime" @change="onMeetingScheduleTime">
					<view class="workspace-match-add-row"><text class="workspace-match-add-label">约见时间</text><view class="workspace-match-add-picker"><text :class="{ placeholder: meetingScheduleTime == '' }">{{ meetingScheduleTime == '' ? '请选择' : meetingScheduleTime }}</text><i></i></view></view>
				</picker>
				<view class="workspace-form-row"><text>约见地点</text><input :value="meetingScheduleLocation" @input="meetingScheduleLocation = $event.detail.value" placeholder="请填写约见地点（必填）" :maxlength="128"/></view>
				<view v-if="meetingScheduleError.length > 0" class="workspace-form-error"><text>{{ meetingScheduleError }}</text></view>
				<view class="workspace-match-status-submit" :class="{ disabled: meetingScheduleSubmitting }" @click="submitMeetingSchedule"><text>{{ meetingScheduleSubmitting ? '提交中…' : '确认安排' }}</text></view>
			</view>
		</XsaSheet>

		<!-- 约见：约见安排状态弹层（完成 / 取消 / 爽约） -->
		<XsaSheet :visible="meetingRecordSheetVisible" title="约见安排状态" @close="meetingRecordSheetVisible = false">
			<view class="workspace-meeting-status-form">
				<view class="workspace-filter-chips">
					<view class="workspace-filter-chip" :class="{ active: meetingRecordChoice == 'REMINDED' }" @click="meetingRecordChoice = 'REMINDED'"><text>已提醒</text></view>
					<view class="workspace-filter-chip" :class="{ active: meetingRecordChoice == 'CHECKED_IN' }" @click="meetingRecordChoice = 'CHECKED_IN'"><text>已到场</text></view>
					<view class="workspace-filter-chip" :class="{ active: meetingRecordChoice == 'COMPLETED' }" @click="meetingRecordChoice = 'COMPLETED'"><text>已完成</text></view>
					<view class="workspace-filter-chip" :class="{ active: meetingRecordChoice == 'CANCELLED' }" @click="meetingRecordChoice = 'CANCELLED'"><text>已取消</text></view>
					<view class="workspace-filter-chip" :class="{ active: meetingRecordChoice == 'NO_SHOW' }" @click="meetingRecordChoice = 'NO_SHOW'"><text>爽约</text></view>
				</view>
				<textarea v-if="meetingRecordChoice == 'CANCELLED' || meetingRecordChoice == 'NO_SHOW'" class="workspace-follow-textarea" :value="meetingRecordReason" @input="meetingRecordReason = $event.detail.value" :placeholder="meetingRecordChoice == 'CANCELLED' ? '请填写取消原因（必填）' : '请填写爽约说明（必填）'" :maxlength="200"/>
				<view class="workspace-sheet-actions">
					<view class="workspace-sheet-btn ghost" @click="meetingRecordSheetVisible = false"><text>取消</text></view>
					<view class="workspace-sheet-btn" :class="{ disabled: meetingRecordSubmitting }" @click="submitMeetingRecordStatus"><text>{{ meetingRecordSubmitting ? '提交中…' : '提交' }}</text></view>
				</view>
			</view>
		</XsaSheet>

		<!-- 线索：放弃 / 入库确认 -->
		<XsaSheet :visible="leadConfirmSheetVisible" :title="leadConfirmKind == 'abandon' ? '放弃线索' : (leadConfirmKind == 'restore' ? '恢复客源' : '一键入库')" @close="leadConfirmSheetVisible = false">
			<view class="workspace-lead-confirm">
				<text class="workspace-confirm-tip">{{ leadConfirmTip }}</text>
				<view v-if="leadConfirmKind == 'convert'" class="workspace-confirm-gender">
					<text>客户性别（入库建档用）</text>
					<view class="workspace-filter-chips">
						<view class="workspace-filter-chip" :class="{ active: leadConvertGender == 2 }" @click="leadConvertGender = 2"><text>女</text></view>
						<view class="workspace-filter-chip" :class="{ active: leadConvertGender == 1 }" @click="leadConvertGender = 1"><text>男</text></view>
					</view>
				</view>
				<textarea v-if="leadConfirmKind != 'convert'" class="workspace-follow-textarea" :value="leadConfirmReason" @input="leadConfirmReason = $event.detail.value" :placeholder="leadConfirmKind == 'abandon' ? '请填写放弃原因（必填）' : '恢复原因（选填）'" :maxlength="200"/>
				<view class="workspace-sheet-actions">
					<view class="workspace-sheet-btn ghost" @click="leadConfirmSheetVisible = false"><text>取消</text></view>
					<view class="workspace-sheet-btn" :class="{ disabled: leadConfirmSubmitting }" @click="submitLeadConfirm"><text>{{ leadConfirmSubmitting ? '处理中…' : '确认' }}</text></view>
				</view>
			</view>
		</XsaSheet>

		<!-- 查看联系方式（设计稿：手机号/微信号分别复制、拨打 + 红娘权限说明）
		     这里内联实现而不是独立组件：常驻挂载 + open 类控制显隐（与 XsaSheet 同款），
		     既避免新增组件文件在微信开发者工具热编译时不被识别，也避免关闭时用 opacity 过渡。 -->
		<view class="xsa-contact-overlay" :class="{ open: workspaceContactVisible }" @tap="onWorkspaceContactOverlay">
			<view class="xsa-contact-card" @tap.stop>
				<view class="xsa-contact-head">
					<view class="xsa-contact-head-icon">
						<view class="cc-avatar"><view class="cc-avatar-head"></view><view class="cc-avatar-body"></view></view>
						<view class="cc-lens"></view>
					</view>
					<text class="xsa-contact-title">查看联系方式</text>
				</view>

				<text class="xsa-contact-name">{{ workspaceContactNameText }}</text>

				<view v-if="workspaceContactLoading" class="xsa-contact-state"><text>正在读取联系方式…</text></view>
				<view v-else-if="workspaceContactError.length > 0" class="xsa-contact-state error"><text>{{ workspaceContactError }}</text></view>
				<view v-else class="xsa-contact-rows">
					<view class="xsa-contact-row phone">
						<view class="cc-badge phone"><image class="cc-badge-img" src="/static/icons/phone-call-white.svg" mode="aspectFit"></image></view>
						<text class="cc-value">{{ workspaceContactPhone.length > 0 ? workspaceContactPhone : '该会员未绑定手机号' }}</text>
						<view v-if="workspaceContactPhone.length > 0" class="cc-actions">
							<view class="cc-btn phone" @tap="copyWorkspaceContact(workspaceContactPhone)"><text>复制</text></view>
							<view class="cc-btn phone" @tap="callWorkspaceContact"><text>拨打</text></view>
						</view>
					</view>

					<view class="xsa-contact-row wechat">
						<view class="cc-badge wechat"><image class="cc-badge-img" src="/static/icons/wechat-bubble-white.svg" mode="aspectFit"></image></view>
						<text class="cc-value">{{ workspaceContactWechat.length > 0 ? workspaceContactWechat : '该会员未绑定微信号' }}</text>
						<view v-if="workspaceContactWechat.length > 0" class="cc-btn wechat" @tap="copyWorkspaceContact(workspaceContactWechat)"><text>复制</text></view>
					</view>
				</view>

				<view class="xsa-contact-tip">
					<view class="cc-tip-head">
						<view class="cc-tip-mark"><text>T</text></view>
						<text class="cc-tip-title">温馨提示</text>
					</view>
					<text class="cc-tip-copy">{{ workspaceContactTipText }}</text>
				</view>

				<view class="xsa-contact-close" @tap="closeWorkspaceContact"><text>关闭</text></view>
			</view>
		</view>

		<!-- 复制资料（设计稿：居中弹窗 + 浅紫字段卡片 + 渐变一键复制；字段口径与后台 CopyProfileModal 一致，
		     同样内联实现：常驻挂载 + open 类控制显隐，避免新增组件文件热编译不识别） -->
		<view class="cp-overlay" :class="{ open: copyProfileVisible }" @tap="closeCopyProfile">
			<view class="cp-card" @tap.stop>
				<view class="cp-head">
					<text class="cp-title">复制资料</text>
					<view class="cp-close" @tap="closeCopyProfile"><text>✕</text></view>
				</view>
				<scroll-view scroll-y class="cp-body" :show-scrollbar="false">
					<view v-if="copyProfileLoading" class="cp-state"><text>资料加载中...</text></view>
					<view v-else class="cp-rows">
						<view v-if="copyProfileError.length > 0" class="cp-error"><text>{{ copyProfileError }}</text></view>
						<view v-for="row in copyProfileRows" :key="row.label" class="cp-row"><text class="cp-row-text">{{ row.label }}：{{ row.value }}</text></view>
					</view>
				</scroll-view>
				<view class="cp-copy-btn" :class="{ disabled: copyProfileLoading }" @tap="confirmCopyProfile"><text>{{ copyProfileCopied ? '已复制到剪贴板 ✓' : '一键复制' }}</text></view>
			</view>
		</view>

		<XsaToast :visible="toastVisible" :message="toastMessage" @hide="toastVisible = false" />
		<MatchmakerServiceNavSheet :visible="serviceNavVisible" member-center-label="我的账号" hide-video-entry hide-member-center-entry tone="deep" @close="serviceNavVisible = false" @select="onServiceNavSelect" />
	</view>
</template>

<script setup lang="uts">
import XsaToast from '@/components/XsaToast.uvue'
import XsaSheet from '@/components/XsaSheet.uvue'
import MatchmakerManagementCenter from '@/components/MatchmakerManagementCenter.uvue'
import MatchmakerPendingReview from '@/components/MatchmakerPendingReview.uvue'
import MatchmakerServiceNavSheet from '@/components/MatchmakerServiceNavSheet.uvue'
import {
	getMatchmakerManagementCenterAccess,
	getMatchmakerManagementCenterSnapshot,
	getMatchmakerReviewMembers,
	getMatchmakerWorkspaceProfile,
	getMatchmakerWorkspaceLeads,
	getWorkspaceLeadFollowUps,
	addWorkspaceLeadFollowUp,
	getWorkspaceLeadFollowers,
	assignWorkspaceLead,
	abandonWorkspaceLead,
	restoreWorkspaceLead,
	convertWorkspaceLead,
	updateWorkspaceLead,
	createWorkspaceLead,
	uploadWorkspaceLeadPhoto,
	createMatchmakerWorkspaceMember,
	updateMatchmakerMeetingStatus,
	updateMatchmakerMeetingRecordStatus,
	scheduleMatchmakerMeeting,
	updateMatchmakerIntroductionStatus,
	createMatchmakerIntroduction,
	deleteMatchmakerMeetingRequest,
	getMatchmakerWorkspaceIntroductions,
	getMatchmakerWorkspaceMeetingRequests,
	getMatchmakerMemberContact,
	getMatchmakerMemberProfile,
	getMatchmakerMemberPreferences,
	getRegionProvinces,
	getRegionCities,
	getRegionDistricts,
	submitMatchmakerApplication
} from '@/api'

// ===== 基本信息 =====
const realName = ref('')
const phone = ref('')
const wechat = ref('')

// ===== 红娘资料 =====
const avatar = ref('')
const introduction = ref('')
const specialties = ref<string[]>([])
const price = ref('')

// ===== 成功案例 =====
interface CaseItem {
	description: string
	images: string[]
}
const successCases = ref<CaseItem[]>([])

// ===== 状态 =====
const submitting = ref(false)
const toastVisible = ref(false)
const toastMessage = ref('')
const qrVisible = ref(false)
const currentStep = ref(0)
const managementAccess = ref<any>(null)
const managementCenterSnapshot = ref<any>(null)
const managementAccessLoading = ref(true)
const managementCenterLoading = ref(false)
const managementCenterVisible = ref(false)
const pendingReviewVisible = ref(false)
const pendingReviewInitialTab = ref('PENDING')
// 会员主页「编辑资料」入口深链：进入页面后自动打开资料待审列表
const autoOpenPendingReview = ref(false)
// 支持从其他页面直达某个工作区：?workspace=meeting（约见申请）/ ?workspace=match（待我牵线）
const autoOpenWorkspace = ref('')
const workspaceVisible = ref(false)
const workspaceTitle = ref('')
const workspaceKind = ref('general')
const workspaceActiveTab = ref('全部')
const workspaceKeyword = ref('')
const workspaceMembersLoading = ref(false)
const workspaceMembersError = ref('')
const workspaceLeadsLoading = ref(false)
const workspaceLeadsError = ref('')
const workspaceMatchesLoading = ref(false)
const workspaceMatchesError = ref('')
const workspaceMeetingsLoading = ref(false)
const workspaceMeetingsError = ref('')
const workspaceDefaultTabs = ['全部', '进行中', '已完成']
const workspaceCommissionTabs = ['分成明细', '分成标准']
const workspaceLeadTabs = ['客源线索', '已放弃线索']
const workspaceMatchTabs = ['全部', '待牵线', '牵线中', '成功', '失败']
const workspaceMeetingTabs = ['全部', '待处理', '待见面', '已完成', '已结束']
const workspaceTabs = computed(() => {
	if (workspaceKind.value == 'commission') return workspaceCommissionTabs
	if (workspaceKind.value == 'lead') return workspaceLeadTabs
	if (workspaceKind.value == 'match') return workspaceMatchTabs
	if (workspaceKind.value == 'meeting') return workspaceMeetingTabs
	return workspaceDefaultTabs
})
const workspaceSearchPlaceholder = computed(() => {
	if (workspaceKind.value == 'lead') return '请输入昵称、手机或微信'
	if (workspaceKind.value == 'match') return '请输入申请人昵称、姓名或编号'
	if (workspaceKind.value == 'meeting') return '请输入申请人、邀约对象或编号'
	return '请输入关键词'
})
const workspaceCommissionRows: any[] = []
const workspaceLeads = ref<any[]>([])
// 九级意向独立保存，便于按 A-J 完整筛选与回显。
const leadIntentionDetails = ref<any>({})
const workspaceMatches = ref<any[]>([])
const workspaceMeetings = ref<any[]>([])
const workspaceMatchesLoaded = ref(false)
const workspaceMeetingsLoaded = ref(false)
const workspaceMatchesUsingDemoData = ref(false)
const workspaceMeetingsUsingDemoData = ref(false)

const applyBusinessMetricCounts = (pendingIntroduction: number, introductionSucceeded: number, meetingRequests: number, pendingMeeting: number) => {
	if (managementCenterSnapshot.value == null || !Array.isArray(managementCenterSnapshot.value.storeMetrics)) return
	const metricValues: any = {
		pending_introduction: String(pendingIntroduction),
		introduction_succeeded: String(introductionSucceeded),
		meeting_requests: String(meetingRequests),
		pending_meeting: String(pendingMeeting)
	}
	managementCenterSnapshot.value = {
		...managementCenterSnapshot.value,
		storeMetrics: managementCenterSnapshot.value.storeMetrics.map((item: any) => metricValues[item.key] != null
			? { ...item, value: metricValues[item.key] }
			: item)
	}
}

const syncBusinessMetricCountsFromWorkspace = () => {
	if (!workspaceMatchesLoaded.value || !workspaceMeetingsLoaded.value) return
	const pendingIntroduction = workspaceMatches.value.filter((item: any): boolean => item.status == 'PENDING').length
	const introductionSucceeded = workspaceMatches.value.filter((item: any): boolean => item.status == 'SUCCEEDED').length
	const meetingRequests = workspaceMeetings.value.filter((item: any): boolean => item.phase == 'PROCESSING').length
	const pendingMeeting = workspaceMeetings.value.filter((item: any): boolean => item.phase == 'UPCOMING').length
	applyBusinessMetricCounts(pendingIntroduction, introductionSucceeded, meetingRequests, pendingMeeting)
}

const refreshBusinessMetricCounts = async () => {
	try {
		const results = await Promise.all([getMatchmakerWorkspaceIntroductions(), getMatchmakerWorkspaceMeetingRequests()])
		const introductionsResult = results[0]
		const meetingsResult = results[1]
		if (!introductionsResult.success || introductionsResult.data == null || !meetingsResult.success || meetingsResult.data == null) return
		const introductions = Array.isArray(introductionsResult.data.items) ? introductionsResult.data.items : []
		const meetings = Array.isArray(meetingsResult.data.items) ? meetingsResult.data.items : []
		const pendingIntroduction = introductions.filter((item: any): boolean => item.status == 'PENDING').length
		const introductionSucceeded = introductions.filter((item: any): boolean => item.status == 'SUCCEEDED').length
		const meetingRequests = meetings.filter((item: any): boolean => getWorkspaceMeetingPresentation(String(item.status), item.meeting).phase == 'PROCESSING').length
		const pendingMeeting = meetings.filter((item: any): boolean => getWorkspaceMeetingPresentation(String(item.status), item.meeting).phase == 'UPCOMING').length
		applyBusinessMetricCounts(pendingIntroduction, introductionSucceeded, meetingRequests, pendingMeeting)
	} catch (e) {
		// 统计接口失败时保留聚合快照，避免用空数据覆盖上一次有效统计。
	}
}
const workspaceMembers = ref<any[]>([])
// 「我服务的」以会员列表真实数据（matchmaker_id == 当前红娘）为准，实时覆盖简报里的服务端统计。
const selfMatchmakerUserId = ref(0)
const ensureSelfMatchmakerUserId = async (): Promise<number> => {
	if (selfMatchmakerUserId.value != 0) return selfMatchmakerUserId.value
	try {
		const result = await getMatchmakerWorkspaceProfile()
		if (result.success && result.data != null && result.data.user_id != null) {
			selfMatchmakerUserId.value = Number(result.data.user_id)
		}
	} catch (e) {
	}
	return selfMatchmakerUserId.value
}
const applyServedMemberCount = (count: number) => {
	if (managementCenterSnapshot.value == null || !Array.isArray(managementCenterSnapshot.value.storeMetrics)) return
	const value = Math.max(0, Math.round(Number(count) || 0))
	managementCenterSnapshot.value = {
		...managementCenterSnapshot.value,
		storeMetrics: managementCenterSnapshot.value.storeMetrics.map((item: any) => item.key == 'served_members'
			? { ...item, value: String(value) }
			: item)
	}
}
const countServedMembers = async (items: any[]) => {
	const selfId = await ensureSelfMatchmakerUserId()
	if (selfId == 0) return
	applyServedMemberCount(items.filter((item: any): boolean => Number(item.matchmaker_id) == selfId).length)
}
const refreshServedMemberCount = async () => {
	try {
		const result = await getMatchmakerReviewMembers()
		if (!result.success || result.data == null) return
		countServedMembers(Array.isArray(result.data.items) ? result.data.items : [])
	} catch (e) {
		// 统计失败时保留上一次有效数字，与业务指标刷新策略一致。
	}
}
const onPendingReviewServedCount = (count: number) => { applyServedMemberCount(Number(count)) }
const workspaceActivities: any[] = []
const workspaceGenericRows: any[] = []
const workspaceVisibleMembers = computed(() => {
	let rows = workspaceMembers.value
	if (workspaceActiveTab.value == '进行中') rows = rows.filter((item: any) => item.reviewStatus == 'PENDING')
	if (workspaceActiveTab.value == '已完成') rows = rows.filter((item: any) => item.reviewStatus != 'PENDING')
	const keyword = workspaceKeyword.value.trim().toLowerCase()
	if (keyword.length == 0) return rows
	return rows.filter((item: any) => {
		const content = (String(item.name) + String(item.id) + String(item.status) + String(item.gender)).toLowerCase()
		return content.indexOf(keyword) >= 0
	})
})
const workspaceVisibleLeads = computed(() => {
	let rows = workspaceLeads.value
	if (workspaceActiveTab.value == '已放弃线索') rows = rows.filter((item: any) => item.status == 'LOST')
	if (workspaceActiveTab.value == '客源线索') rows = rows.filter((item: any) => item.status != 'LOST')
	if (leadExceptionOnly.value) rows = rows.filter((item: any) => item.isStale == true)
	if (leadFilterStatus.value.length > 0) rows = rows.filter((item: any) => leadFilterStatus.value.indexOf(item.status) >= 0)
	if (leadFilterIntention.value > 0) rows = rows.filter((item: any) => Number(item.intentionValue) == leadFilterIntention.value)
	const keyword = workspaceKeyword.value.trim().toLowerCase()
	if (keyword.length == 0) return rows
	return rows.filter((item: any) => {
		const content = (String(item.name) + String(item.phone) + String(item.wechat) + String(item.source)).toLowerCase()
		return content.indexOf(keyword) >= 0
	})
})
const workspaceVisibleMatches = computed(() => {
	let rows = workspaceMatches.value
	if (workspaceActiveTab.value == '待牵线') rows = rows.filter((item: any) => item.status == 'PENDING')
	if (workspaceActiveTab.value == '牵线中') rows = rows.filter((item: any) => item.status == 'IN_PROGRESS')
	if (workspaceActiveTab.value == '成功') rows = rows.filter((item: any) => item.status == 'SUCCEEDED')
	if (workspaceActiveTab.value == '失败') rows = rows.filter((item: any) => item.status == 'FAILED')
	const keyword = workspaceKeyword.value.trim().toLowerCase()
	if (keyword.length == 0) return rows
	return rows.filter((item: any) => {
		const content = (String(item.id) + String(item.statusLabel) + String(item.fromUser.name) + String(item.toUser.name)).toLowerCase()
		return content.indexOf(keyword) >= 0
	})
})
const workspaceVisibleMeetings = computed(() => {
	let rows = workspaceMeetings.value
	if (workspaceActiveTab.value == '待处理') rows = rows.filter((item: any) => item.phase == 'PROCESSING')
	if (workspaceActiveTab.value == '待见面') rows = rows.filter((item: any) => item.phase == 'UPCOMING')
	if (workspaceActiveTab.value == '已完成') rows = rows.filter((item: any) => item.phase == 'COMPLETED')
	if (workspaceActiveTab.value == '已结束') rows = rows.filter((item: any) => item.phase == 'ENDED')
	const keyword = workspaceKeyword.value.trim().toLowerCase()
	if (keyword.length == 0) return rows
	return rows.filter((item: any) => {
		const content = (String(item.id) + String(item.applicant.name) + String(item.target.name) + String(item.statusLabel)).toLowerCase()
		return content.indexOf(keyword) >= 0
	})
})

const specialtyOptions = [
	'高知青年', '同城牵线', '离异再婚', '大龄脱单',
	'海归交友', '理工专属', '情感修复', '婚前辅导',
	'沟通指导', '形象建议', '约会策划', '家庭关系'
]

const processSteps = [
	{ title: '填写申请', desc: '填写完整资料并提交' },
	{ title: '平台审核', desc: '运营人员对资料进行审核' },
	{ title: '审核通过', desc: '获得服务红娘身份' },
	{ title: '成为服务红娘', desc: '可正式在平台提供牵线服务' }
]

// ===== 计算属性 =====
const canSubmit = computed(() => {
	return realName.value.trim().length >= 2
		&& realName.value.trim().length <= 64
		&& /^1[3-9]\d{9}$/.test(phone.value.trim())
		&& wechat.value.trim().length > 0
		&& wechat.value.trim().length <= 128
		&& avatar.value.length > 0
		&& avatar.value.length <= 512
		&& introduction.value.trim().length >= 10
		&& introduction.value.trim().length <= 2000
		&& specialties.value.length > 0
		&& isValidOptionalPrice()
})

const canEnterManagementCenter = computed(() => {
	return managementAccess.value != null && managementAccess.value.canAccess == true
})

const managementAccessDescription = computed(() => {
	if (managementAccessLoading.value) return '正在核验服务红娘开通状态…'
	if (managementAccess.value == null) return '暂时无法核验开通状态，请稍后重试。'
	if (canEnterManagementCenter.value) {
		return '服务开通已确认，可进入工作台处理门店服务事项。'
	}
	if (managementAccess.value.roleStatus != 'active') return '服务红娘申请审核通过并激活后，即可进入管理中心。'
	return managementAccess.value.message != null && String(managementAccess.value.message).length > 0
		? String(managementAccess.value.message)
		: '当前账号暂未获得管理中心权限。'
})

const managementAccessActionText = computed(() => {
	if (managementAccessLoading.value) return '核验中'
	if (managementCenterLoading.value) return '进入中'
	if (canEnterManagementCenter.value) return '进入中心'
	return '暂不可进入'
})

// ===== Toast =====
const showToast = (msg: string) => {
	toastMessage.value = msg
	toastVisible.value = true
}

const selectWorkspaceTab = (tab: string) => {
	workspaceActiveTab.value = tab
}

const onWorkspaceKeywordInput = (event: any) => {
	workspaceKeyword.value = event.detail.value
}

const runWorkspaceSearch = () => {
	if (workspaceKind.value == 'member') {
		showToast('已筛选 ' + String(workspaceVisibleMembers.value.length) + ' 位会员')
		return
	}
	if (workspaceKind.value == 'lead') {
		showToast('已筛选 ' + String(workspaceVisibleLeads.value.length) + ' 条客源')
		return
	}
	if (workspaceKind.value == 'match') {
		showToast('已筛选 ' + String(workspaceVisibleMatches.value.length) + ' 条牵线记录')
		return
	}
	if (workspaceKind.value == 'meeting') {
		showToast('已筛选 ' + String(workspaceVisibleMeetings.value.length) + ' 条约见申请')
		return
	}
	if (workspaceKeyword.value.trim().length == 0) {
		showToast('请输入搜索关键词')
		return
	}
	showToast('该工作台能力正在接入服务端数据')
}

const copyWorkspaceText = (value: string) => {
	uni.setClipboardData({
		data: value,
		success: () => showToast('已复制')
	})
}

const copyWorkspaceLink = () => { showToast('专属推广链接尚未开放') }

const loadManagementAccess = async () => {
	managementAccessLoading.value = true
	try {
		const result = await getMatchmakerManagementCenterAccess()
		if (result.success && result.data != null) {
			managementAccess.value = result.data
		} else {
			managementAccess.value = null
		}
	} catch (e) {
		managementAccess.value = null
	} finally {
		managementAccessLoading.value = false
	}
}

const openManagementCenter = async () => {
	if (managementAccessLoading.value || managementCenterLoading.value) return
	if (!canEnterManagementCenter.value) {
		showToast(managementAccessDescription.value)
		return
	}
	try {
		managementCenterLoading.value = true
		const result = await getMatchmakerManagementCenterSnapshot()
		if (result.success && result.data != null) {
			managementCenterSnapshot.value = result.data
			await Promise.all([refreshBusinessMetricCounts(), refreshServedMemberCount()])
			managementCenterVisible.value = true
		} else {
			showToast(result.message != null ? String(result.message) : '工作台加载失败，请稍后重试')
		}
	} catch (e) {
		showToast('工作台加载失败，请检查网络后重试')
	} finally {
		managementCenterLoading.value = false
	}
}

const exitManagementCenter = () => {
	pendingReviewVisible.value = false
	workspaceVisible.value = false
	managementCenterVisible.value = false
}

const openPendingReview = (initialTab: string = 'PENDING') => {
	if (!managementCenterVisible.value) return
	pendingReviewInitialTab.value = initialTab
	pendingReviewVisible.value = true
}

const closePendingReview = () => {
	pendingReviewVisible.value = false
}

const closeWorkspace = () => {
	if (pendingReviewVisible.value) {
		closePendingReview()
		return
	}
	workspaceVisible.value = false
}

const loadWorkspaceMembers = async () => {
	workspaceMembersLoading.value = true
	workspaceMembersError.value = ''
	try {
		const result = await getMatchmakerReviewMembers()
		if (!result.success || result.data == null) {
			workspaceMembers.value = []
			workspaceMembersError.value = result.message != null ? String(result.message) : '会员数据加载失败'
			return
		}
		const source = result.data
		const items = Array.isArray(source.items) ? source.items : []
		const owner = managementCenterSnapshot.value != null && managementCenterSnapshot.value.identity != null
			? String(managementCenterSnapshot.value.identity.name || '服务红娘')
			: '服务红娘'
		workspaceMembers.value = items.map((item: any) => {
			const gender = Number(item.gender) == 1 ? '男' : (Number(item.gender) == 2 ? '女' : '未填写')
			const reviewStatus = item.review_status != null ? String(item.review_status) : 'PENDING'
			return {
				id: String(item.user_id),
				avatar: item.avatar != null && String(item.avatar).length > 0
					? String(item.avatar)
					: (Number(item.gender) == 1 ? '/static/portraits/profile-man-light.jpg' : '/static/portraits/profile-woman-main.jpg'),
				name: item.nickname != null ? String(item.nickname) : '未命名会员',
				gender: gender,
				type: Number(item.profile_completion_score) >= 90 ? '资料完善' : '待完善',
				owner: owner,
				status: reviewStatus == 'PASSED' ? '已通过' : (reviewStatus == 'REJECTED' ? '需补充资料' : '资料待审'),
				reviewStatus: reviewStatus
			}
		})
		countServedMembers(items)
	} catch (e) {
		workspaceMembers.value = []
		workspaceMembersError.value = '网络数据加载失败，请检查本地服务后重试'
	} finally {
		workspaceMembersLoading.value = false
	}
}

const leadStatusMeta: any[] = [
	{ value: 'NEW', label: '找对象中' },
	{ value: 'CONTACTED', label: '接触中' },
	{ value: 'INTENDED', label: '恋爱中' },
	{ value: 'CLOSED', label: '已结婚' },
	{ value: 'CONVERTED', label: '已到门店' },
	{ value: 'LOST', label: '已放弃', disabled: true }
]
const leadStatusTones: any = { NEW: 'new', CONTACTED: 'ok', INTENDED: 'warn', CONVERTED: 'ok', CLOSED: 'muted', LOST: 'muted' }
const leadStatusOptions = leadStatusMeta.filter((item: any): boolean => item.value != 'LOST')
const intentionLabels: any = { 1: '低', 2: '中', 3: '高' }
const leadIntentionOptions = [
	{ value: 1, label: 'A类 未接', level: 1 },
	{ value: 2, label: 'B类 初步沟通', level: 2 },
	{ value: 3, label: 'C类 深入沟通未缔结', level: 2 },
	{ value: 4, label: 'D类 待确定到店时间', level: 3 },
	{ value: 5, label: 'E类 已确定到店', level: 3 },
	{ value: 6, label: 'F类 毁约需二邀', level: 2 },
	{ value: 7, label: 'G类 已到店未签约', level: 2 },
	{ value: 8, label: 'I类 已签单', level: 3 },
	{ value: 9, label: 'J类 放弃资源', level: 1 }
]
const followUpMethodLabels: any = { PHONE: '电话', WECHAT: '微信', VISIT: '到店', OTHER: '其他' }

const leadStatusLabel = (status: string): string => {
	for (let i = 0; i < leadStatusMeta.length; i++) {
		if (leadStatusMeta[i].value == status) return leadStatusMeta[i].label as string
	}
	return '找对象中'
}

const formatLeadTime = (value: any): string => {
	if (value == null) return ''
	return String(value).replace('T', ' ').substring(0, 16)
}

const daysBetweenNow = (timeText: string): number => {
	if (timeText.length == 0) return 0
	const past = new Date(timeText.replace(' ', 'T') + ':00').getTime()
	if (isNaN(past)) return 0
	return Math.floor((Date.now() - past) / 86400000)
}

const loadWorkspaceLeads = async () => {
	workspaceLeadsLoading.value = true
	workspaceLeadsError.value = ''
	try {
		const result = await getMatchmakerWorkspaceLeads()
		if (!result.success || result.data == null) {
			workspaceLeads.value = []
			workspaceLeadsError.value = result.message != null ? String(result.message) : '客源数据加载失败'
			return
		}
		const source = result.data
		const items = Array.isArray(source.items) ? source.items : []
		workspaceLeads.value = items.map((item: any) => {
			const status = item.status != null ? String(item.status) : 'NEW'
			const intentionLevel = item.intention_level != null ? Number(item.intention_level) : 1
			const sourceIntentionValue = item.intention_value != null ? Number(item.intention_value) : (item.intentionValue != null ? Number(item.intentionValue) : 0)
			const knownIntention = leadIntentionDetails.value[String(item.id)] != null ? Number(leadIntentionDetails.value[String(item.id)]) : (sourceIntentionValue >= 1 && sourceIntentionValue <= 9 ? sourceIntentionValue : leadIntentionDefaultValue(intentionLevel))
			const lastFollowAt = item.last_follow_up_at != null ? formatLeadTime(item.last_follow_up_at) : ''
			const staleDays = lastFollowAt.length > 0 ? daysBetweenNow(lastFollowAt) : daysBetweenNow(formatLeadTime(item.created_at))
			return {
				id: String(item.id),
				name: item.name != null ? String(item.name) : '未命名客源',
				phone: item.phone != null && String(item.phone).length > 0 ? String(item.phone) : '未提供',
				wechat: item.wechat != null && String(item.wechat).length > 0 ? String(item.wechat) : '未提供',
				source: item.source != null ? String(item.source) : '未知来源',
				status: status,
				statusLabel: leadStatusLabel(status),
				statusTone: leadStatusTones[status] != null ? leadStatusTones[status] as string : 'new',
				time: formatLeadTime(item.created_at),
				owner: item.matchmaker_name != null && String(item.matchmaker_name).length > 0 ? String(item.matchmaker_name) : '未分派',
				matchmakerId: item.matchmaker_id != null ? Number(item.matchmaker_id) : 0,
				remark: item.remark != null ? String(item.remark) : '',
				intentionLevel: intentionLevel,
				intentionValue: knownIntention,
				intentionLabel: leadIntentionOption(knownIntention).label as string,
				lastFollowAt: lastFollowAt,
				isStale: status != 'LOST' && status != 'CLOSED' && status != 'CONVERTED' && staleDays >= 10,
				followSummary: lastFollowAt.length > 0 ? '最近跟进 ' + lastFollowAt.substring(5, 10) : '暂无跟进记录',
				convertedUserId: item.converted_user_id != null ? String(item.converted_user_id) : '',
				photo: item.photo != null ? String(item.photo) : '',
				gender: item.gender != null ? Number(item.gender) : 0,
				birthday: item.birthday != null ? String(item.birthday) : '',
				genderAge: ''
			}
		})
	} catch (e) {
		workspaceLeads.value = []
		workspaceLeadsError.value = '网络数据加载失败，请检查本地服务后重试'
	} finally {
		workspaceLeadsLoading.value = false
	}
}

// ===== 客源线索：工具栏与筛选 =====
const leadExceptionOnly = ref(false)
const leadFilterStatus = ref<string[]>([])
const leadFilterIntention = ref(0)

const toggleLeadException = () => {
	leadExceptionOnly.value = !leadExceptionOnly.value
	leadFilterStatus.value = []
	leadFilterIntention.value = 0
}

const leadFilterSheetVisible = ref(false)
const openLeadFilterSheet = () => { leadFilterSheetVisible.value = true }
const toggleLeadFilterStatus = (value: string) => {
	const idx = leadFilterStatus.value.indexOf(value)
	if (idx >= 0) {
		leadFilterStatus.value = leadFilterStatus.value.filter((item: string): boolean => item != value)
	} else {
		leadFilterStatus.value = leadFilterStatus.value.concat([value])
	}
}
const resetLeadFilter = () => {
	leadFilterStatus.value = []
	leadFilterIntention.value = 0
}
const applyLeadFilter = () => {
	leadFilterSheetVisible.value = false
	showToast('已按条件筛选 ' + String(workspaceVisibleLeads.value.length) + ' 条客源')
}

// ===== 客源线索：状态选择 =====
const leadStatusSheetVisible = ref(false)
const leadStatusCurrent = ref('')
const leadStatusLeadId = ref('')
const openLeadStatusSheet = (row: any) => {
	leadStatusLeadId.value = String(row.id)
	leadStatusCurrent.value = String(row.status)
	leadStatusSheetVisible.value = true
}
const selectLeadStatus = async (value: string) => {
	if (value == leadStatusCurrent.value) {
		leadStatusSheetVisible.value = false
		return
	}
	try {
		const result = await updateWorkspaceLead(leadStatusLeadId.value, { status: value })
		if (!result.success) {
			showToast(result.message != null ? String(result.message) : '状态修改失败')
			return
		}
		leadStatusSheetVisible.value = false
		showToast('状态已更新为「' + leadStatusLabel(value) + '」')
		await loadWorkspaceLeads()
	} catch (e) {
		showToast('网络异常，请稍后重试')
	}
}

const leadIntentionOption = (value: number): any => {
	for (let i = 0; i < leadIntentionOptions.length; i++) {
		if (leadIntentionOptions[i].value == value) return leadIntentionOptions[i]
	}
	return leadIntentionOptions[0]
}

const leadIntentionDefaultValue = (level: number): number => {
	if (level == 2) return 2
	if (level == 3) return 4
	return 1
}

// ===== 客源线索：意向选择 =====
const leadIntentionSheetVisible = ref(false)
const leadIntentionCurrent = ref(1)
const leadIntentionLeadId = ref('')
const openLeadIntentionSheet = (row: any) => {
	leadIntentionLeadId.value = String(row.id)
	leadIntentionCurrent.value = Number(row.intentionValue) >= 1 && Number(row.intentionValue) <= 9 ? Number(row.intentionValue) : leadIntentionDefaultValue(Number(row.intentionLevel))
	leadIntentionSheetVisible.value = true
}
const selectLeadIntention = async (value: number) => {
	if (value == leadIntentionCurrent.value) {
		leadIntentionSheetVisible.value = false
		return
	}
	try {
		const option = leadIntentionOption(value)
		const result = await updateWorkspaceLead(leadIntentionLeadId.value, { intentionLevel: option.level, intentionValue: value })
		if (!result.success) {
			showToast(result.message != null ? String(result.message) : '意向更新失败')
			return
		}
		leadIntentionDetails.value[leadIntentionLeadId.value] = value
		leadIntentionSheetVisible.value = false
		showToast('意向已更新')
		await loadWorkspaceLeads()
	} catch (e) {
		showToast('网络异常，请稍后重试')
	}
}

// ===== 客源线索：分派跟进 =====
const leadAssignSheetVisible = ref(false)
const leadAssignCurrent = ref(0)
const leadAssignLeadId = ref('')
const leadFollowers = ref<any[]>([])
const leadFollowersLoading = ref(false)
const leadFollowersLoaded = ref(false)
const openLeadAssignSheet = async (row: any) => {
	leadAssignLeadId.value = String(row.id)
	leadAssignCurrent.value = Number(row.matchmakerId)
	leadAssignSheetVisible.value = true
	if (!leadFollowersLoaded.value) {
		leadFollowersLoading.value = true
		try {
			const result = await getWorkspaceLeadFollowers()
			if (result.success && result.data != null) {
				const list = Array.isArray(result.data) ? result.data : []
				leadFollowers.value = list.map((item: any) => ({
					userId: Number(item.user_id),
					displayName: item.display_name != null ? String(item.display_name) : '服务红娘',
					isSelf: item.is_self == true
				}))
				leadFollowersLoaded.value = true
			} else {
				showToast(result.message != null ? String(result.message) : '红娘列表加载失败')
			}
		} catch (e) {
			showToast('网络异常，请稍后重试')
		} finally {
			leadFollowersLoading.value = false
		}
	}
}
const selectLeadAssign = async (follower: any) => {
	if (follower.userId == leadAssignCurrent.value) {
		leadAssignSheetVisible.value = false
		return
	}
	try {
		const result = await assignWorkspaceLead(leadAssignLeadId.value, follower.userId)
		if (!result.success) {
			showToast(result.message != null ? String(result.message) : '分派失败')
			return
		}
		leadAssignSheetVisible.value = false
		showToast('已分派给 ' + follower.displayName + ' 跟进')
		await loadWorkspaceLeads()
	} catch (e) {
		showToast('网络异常，请稍后重试')
	}
}

// ===== 客源线索：跟进记录面板 =====
const leadFollowPanelVisible = ref(false)
const leadFollowLeadId = ref('')
const leadFollowLeadName = ref('')
const leadFollowLoading = ref(false)
const leadFollowError = ref('')
const leadFollowRecords = ref<any[]>([])
const leadFollowMethods = [
	{ value: 'PHONE', label: '电话' },
	{ value: 'WECHAT', label: '微信' },
	{ value: 'VISIT', label: '到店' },
	{ value: 'OTHER', label: '其他' }
]
const leadFollowMethod = ref('PHONE')
const leadFollowContent = ref('')
const openLeadFollowPanel = (row: any) => {
	leadFollowLeadId.value = String(row.id)
	leadFollowLeadName.value = String(row.name)
	leadFollowPanelVisible.value = true
	loadLeadFollowRecords()
}
const closeLeadFollowPanel = () => {
	leadFollowPanelVisible.value = false
	leadFollowContent.value = ''
}
const loadLeadFollowRecords = async () => {
	leadFollowLoading.value = true
	leadFollowError.value = ''
	try {
		const result = await getWorkspaceLeadFollowUps(leadFollowLeadId.value)
		if (!result.success || result.data == null) {
			leadFollowRecords.value = []
			leadFollowError.value = result.message != null ? String(result.message) : '跟进记录加载失败'
			return
		}
		const items = Array.isArray(result.data.items) ? result.data.items : []
		leadFollowRecords.value = items.map((item: any) => ({
			id: String(item.id),
			methodLabel: followUpMethodLabels[item.method] != null ? followUpMethodLabels[item.method] as string : '其他',
			content: item.content != null ? String(item.content) : '',
			time: formatLeadTime(item.created_at),
			intentionLabel: item.intention_level != null ? (intentionLabels[Number(item.intention_level)] as string) : ''
		}))
	} catch (e) {
		leadFollowRecords.value = []
		leadFollowError.value = '网络数据加载失败，请检查本地服务后重试'
	} finally {
		leadFollowLoading.value = false
	}
}
const submitLeadFollowUp = async () => {
	const content = leadFollowContent.value.trim()
	if (content.length == 0) {
		showToast('请填写跟进内容')
		return
	}
	try {
		const result = await addWorkspaceLeadFollowUp(leadFollowLeadId.value, { method: leadFollowMethod.value, content: content })
		if (!result.success) {
			showToast(result.message != null ? String(result.message) : '跟进保存失败')
			return
		}
		leadFollowContent.value = ''
		showToast('跟进已记录')
		await loadLeadFollowRecords()
		await loadWorkspaceLeads()
	} catch (e) {
		showToast('网络异常，请稍后重试')
	}
}

