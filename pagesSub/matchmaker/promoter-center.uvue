2rpx;background:#eeeef1;color:#898b92;font-size:22rpx}.method text.checked{background:#d673ea;color:#fff}.gradient-btn{min-height:82rpx;margin-top:8rpx;background:linear-gradient(90deg,#dea0f6,#f6bff1);color:#20212a;font-size:29rpx;font-weight:800}.empty{min-height:300rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:20rpx;color:#b5b7be;font-size:25rpx;text-align:center}.level-card{padding:25rpx;display:flex;flex-direction:column;gap:13rpx;color:#777a83;font-size:23rpx;line-height:1.55}.level-card text:first-child{color:#292b31;font-size:31rpx;font-weight:900}.level-card text:nth-child(3){align-self:flex-end;color:#b24fd4}.level-row{padding:22rpx 0;border-bottom:1rpx solid #e3e4e8;display:flex;flex-direction:column;gap:8rpx;color:#747781;font-size:22rpx}.level-row text:first-child{color:#2e3037;font-size:28rpx;font-weight:800}.summary{padding:26rpx;display:flex;flex-direction:row;flex-wrap:wrap;gap:18rpx}.summary>text{width:100%;padding:16rpx;border-radius:14rpx;background:#f3f5fc;color:#717585;font-size:22rpx;line-height:1.5}.tabs{display:flex;flex-direction:row;justify-content:space-around;min-height:70rpx;align-items:center;font-size:28rpx;font-weight:800}.tabs text{color:#737680}.tabs text.active{color:#24262c;border-bottom:7rpx solid #a946ea;padding-bottom:15rpx}.search{min-height:78rpx;padding:8rpx 10rpx 8rpx 22rpx;border-radius:999rpx;background:#fff;display:flex;flex-direction:row;align-items:center}.search input{flex:1;min-width:0;font-size:24rpx}.search>text{min-width:108rpx;height:60rpx;border-radius:999rpx;background:#e8b2f5;display:flex;flex-direction:row;align-items:center;justify-content:center;font-size:25rpx;font-weight:800}.record,.member{position:relative;padding:24rpx;border-radius:25rpx;background:#fff;display:flex;flex-direction:column;gap:9rpx;color:#666a74;font-size:23rpx}.record text:nth-child(2),.member text:first-child{font-size:28rpx;color:#292b32;font-weight:800}.amount{position:absolute;right:22rpx;top:50rpx;color:#ec4d7e!important;font-size:32rpx!important}.report-link{color:#b04acd!important}.notice{padding:18rpx;border:1rpx solid #c9d2ec;border-radius:15rpx;background:#f3f5fc;color:#555d70;font-size:24rpx}.field{min-height:104rpx;border-bottom:1rpx solid #e7e8eb;display:flex;flex-direction:row;align-items:center;justify-content:space-between;font-size:29rpx;font-weight:800}.field input{width:62%;text-align:right;font-size:25rpx;color:#70737b}.field.column{align-items:flex-start;flex-direction:column;padding:22rpx 0;gap:18rpx}.field textarea{width:100%;min-height:180rpx;font-size:23rpx;line-height:1.6}.gender{display:flex;flex-direction:row;gap:12rpx}.gender text{padding:9rpx 26rpx;border-radius:999rpx;background:#eeeef2;font-size:23rpx}.gender text.active{background:#e4b1f5;color:#7f31a7}.table-head{padding:22rpx;display:flex;flex-direction:row;justify-content:space-between;background:#ececf2;font-size:22rpx;font-weight:800}.mall-page{min-height:calc(100vh - 100rpx)}.merchant-tabs{display:flex;flex-direction:row;justify-content:space-around;min-height:82rpx;align-items:center;font-size:23rpx}.merchant-tabs .active{color:#603df3;font-weight:800}.merchant-bottom{margin-top:auto;padding:20rpx;background:#fff;display:flex;flex-direction:row;justify-content:space-around;font-size:21rpx}.mall-banner{height:180rpx;border-radius:28rpx;background:#edeef1}.funds{gap:18rpx}.funds>view{width:50%;min-height:210rpx;padding:27rpx;border-radius:29rpx;background:linear-gradient(135deg,#e6b5f9,#edb8ee);display:flex;flex-direction:column;gap:13rpx;color:#fff;font-size:24rpx;font-weight:800}.funds>view:nth-child(2){background:linear-gradient(135deg,#a7e8f5,#8fd7e9)}.funds text:nth-child(2){font-size:50rpx}.funds text:last-child{align-self:flex-start;padding:10rpx 20rpx;border-radius:999rpx;background:#fff;color:#c257d4;font-size:23rpx}.float-add{position:fixed;right:28rpx;bottom:90rpx;width:84rpx;height:84rpx;border-radius:50%;background:#de91f4;display:flex;align-items:center;justify-content:center;font-size:21rpx;font-weight:800}.overlay{position:fixed;inset:0;z-index:30;background:rgba(0,0,0,.52);display:flex;flex-direction:row;align-items:center;justify-content:center;padding:32rpx}.dialog,.contact{width:100%;padding:30rpx;border-radius:30rpx;background:#fff;display:flex;flex-direction:column;gap:20rpx}.bottom{position:absolute;left:0;right:0;bottom:0;width:auto;border-radius:32rpx 32rpx 0 0}.dialog-head{display:flex;flex-direction:row;align-items:center;justify-content:space-between;font-size:32rpx;font-weight:800}.dialog-head text:last-child{color:#999ba3;font-size:22rpx}.team-option{padding:23rpx;text-align:center;border-radius:18rpx;background:#f6f6f7;font-size:27rpx}.contact{align-items:center;text-align:center;font-size:28rpx;font-weight:800}.contact image{width:310rpx;height:310rpx}.contact>text:nth-child(3){font-size:23rpx;color:#6d7078}.contact>view{padding:10rpx 28rpx;border-radius:999rpx;background:#eeeef0;color:#777;font-size:22rpx}.dialog-actions{display:flex;flex-direction:row;gap:16rpx}.dialog-actions text{flex:1;padding:18rpx;text-align:center;border-radius:16rpx;background:#f0f0f2}.dialog-actions text:last-child{background:#e7a9f3}.loading{padding:28rpx;display:flex;flex-direction:column;gap:22rpx}.loading view{height:180rpx;border-radius:28rpx;background:#e7e8eb}.loading view:first-child{height:240rpx}
.promoter-nav {
	height: calc(100rpx + var(--status-bar-height));
	padding: var(--status-bar-height) 24rpx 0;
	box-sizing: border-box;
}

/* 与“申请推广红娘”页面统一：复用青瓷绿主色、冷白卡片和低对比阴影。 */
.promoter-page { background: var(--canvas); color: var(--ink); }
.promoter-nav { background: var(--surface); border-bottom: 1rpx solid var(--line); color: var(--ink); }
.back view { border-color: var(--ink); }
.menu view { background: var(--accent2); }
.content { gap: 20rpx; }
.cash-card, .cash-card.compact { min-height: 216rpx; border-radius: 20rpx; background: var(--match-mist); color: var(--ink); box-shadow: var(--shadow-sm); }
.cash-card:after { display: none; }
.cash-button, .gradient-btn { border-radius: 14rpx; background: var(--accent); color: var(--paper); }
.cash-bottom { color: var(--ink2); }
.data-card, .list-card, .summary, .level-card, .form-card, .record, .member { border-radius: 20rpx; background: var(--surface); box-shadow: var(--shadow-sm); color: var(--ink2); }
.hint, .notice, .summary > text, .method text:first-child, .gender text, .table-head { border-radius: 14rpx; background: var(--match-mist); color: var(--ink2); }
.hint text:first-child, .level-card text:first-child, .record text:nth-child(2), .member text:first-child, .row > text:first-child { color: var(--ink); }
.promo-card { border-radius: 20rpx; background: var(--accent-bg); color: var(--accent2); }
.promo-card > view text { border-radius: 14rpx; background: var(--surface); color: var(--accent2); }
.row, .method, .field, .level-row { border-color: var(--line); }
.row > text:nth-child(2), .metrics text:last-child, .summary > view:not(:last-child) text:last-child, .empty { color: var(--muted); }
.row i { border-color: var(--muted); }
.form-card input, .dialog input { border-radius: 14rpx; background: var(--paper); color: var(--ink); }
.method text.checked, .gender text.active { background: var(--accent); color: var(--paper); }
.tabs text.active { color: var(--accent2); border-color: var(--accent); }
.search { border: 1rpx solid var(--line); background: var(--surface); box-shadow: var(--shadow-sm); }
.search > text { border-radius: 14rpx; background: var(--accent); color: var(--paper); }
.amount, .report-link, .level-card text:nth-child(3) { color: var(--accent2) !important; }
.funds > view, .funds > view:nth-child(2) { border-radius: 20rpx; background: var(--match-mist); color: var(--ink); }
.funds > view:nth-child(2) { background: var(--match-sky); }
.funds text:last-child { background: var(--surface); color: var(--accent2); }
.float-add { background: var(--accent); color: var(--paper); }
.overlay { background: var(--accent-glow); }
.dialog, .contact { border-radius: 20rpx; background: var(--surface); }
.bottom { border-radius: 20rpx 20rpx 0 0; }
.team-option { border-radius: 14rpx; background: var(--paper); color: var(--ink); }
.contact > view, .dialog-actions text { background: var(--warm); color: var(--ink2); }
.dialog-actions text:last-child { background: var(--accent); color: var(--paper); }
.loading view { border-radius: 20rpx; background: var(--warm); }

/* 推广红娘管理中心首页：收益概览、审核漏斗、推广工具和业务入口按工作优先级排列。 */
.promoter-home { gap: 20rpx; padding-bottom: calc(env(safe-area-inset-bottom) + 44rpx); }
.promoter-fund-card { position: relative; min-height: 216rpx; padding: 30rpx 30rpx 22rpx; overflow: hidden; border-radius: 20rpx; background: var(--match-mist); box-shadow: var(--shadow-sm); display: flex; flex-direction: row; justify-content: space-between; box-sizing: border-box; }
.promoter-fund-card:after { content: ''; position: absolute; right: -70rpx; top: -86rpx; width: 270rpx; height: 270rpx; border: 26rpx solid var(--accent-bg); border-radius: 50%; opacity: .6; }
.promoter-fund-main { z-index: 1; display: flex; flex-direction: column; gap: 10rpx; }
.promoter-fund-main text:first-child { color: var(--ink2); font-size: 24rpx; font-weight: 700; }
.promoter-fund-main text:last-child { color: var(--ink); font-size: 57rpx; line-height: 1; font-weight: 800; }
.promoter-withdraw { z-index: 1; align-self: flex-start; min-width: 148rpx; height: 62rpx; border-radius: 14rpx; background: var(--surface); display: flex; align-items: center; justify-content: center; box-shadow: var(--shadow-sm); }
.promoter-withdraw text { color: var(--accent2); font-size: 23rpx; font-weight: 800; }
.promoter-fund-foot { position: absolute; z-index: 1; left: 30rpx; right: 30rpx; bottom: 20rpx; display: flex; flex-direction: row; align-items: center; gap: 9rpx; }
.promoter-user-mark { width: 38rpx; height: 38rpx; border-radius: 50%; background: var(--surface); display: flex; align-items: center; justify-content: center; }
.promoter-user-mark text { color: var(--accent2); font-size: 20rpx; font-weight: 800; }
.promoter-fund-foot > text { color: var(--ink2); font-size: 22rpx; }
.promoter-fund-foot > text:last-child { margin-left: auto; }
.promoter-review-card { padding: 26rpx; border-radius: 20rpx; background: var(--surface); box-shadow: var(--shadow-sm); }
.promoter-review-metrics { display: flex; flex-direction: row; }
.promoter-review-metrics > view { width: 33.333%; display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.promoter-review-metrics > view + view { border-left: 1rpx solid var(--line); }
.promoter-review-metrics text:first-child { color: var(--ink); font-size: 46rpx; line-height: 1; font-weight: 800; }
.promoter-review-metrics text:last-child { color: var(--muted); font-size: 22rpx; }
.promoter-notice { margin-top: 24rpx; padding: 18rpx; border-radius: 14rpx; background: var(--paper); display: flex; flex-direction: row; gap: 12rpx; }
.promoter-notice-mark { width: 30rpx; height: 30rpx; margin-top: 2rpx; border-radius: 50%; background: var(--accent-bg); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.promoter-notice-mark text { color: var(--accent2); font-size: 20rpx; font-weight: 800; }
.promoter-notice > view:last-child { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 6rpx; }
.promoter-notice > view:last-child text:first-child { color: var(--ink); font-size: 23rpx; font-weight: 800; }
.promoter-notice > view:last-child text:last-child { color: var(--ink2); font-size: 22rpx; line-height: 1.58; }
.promoter-share-card { padding: 22rpx; border-radius: 20rpx; background: var(--accent-bg); display: flex; flex-direction: column; gap: 18rpx; }
.promoter-share-head { display: flex; flex-direction: row; align-items: center; gap: 11rpx; }
.promoter-share-icon { width: 38rpx; height: 38rpx; border-radius: 10rpx; background: var(--surface); display: flex; align-items: center; justify-content: center; }
.promoter-share-icon text { color: var(--accent2); font-size: 24rpx; font-weight: 800; }
.promoter-share-head > text { color: var(--ink2); font-size: 22rpx; font-weight: 700; }
.promoter-share-actions { display: flex; flex-direction: row; gap: 14rpx; }
.promoter-share-actions > view { flex: 1; min-height: 58rpx; border-radius: 14rpx; background: var(--surface); display: flex; align-items: center; justify-content: center; }
.promoter-share-actions text { color: var(--accent2); font-size: 22rpx; font-weight: 800; }
.promoter-menu-card { overflow: hidden; border-radius: 20rpx; background: var(--surface); box-shadow: var(--shadow-sm); }
.promoter-menu-row { min-height: 94rpx; margin: 0 24rpx; border-bottom: 1rpx solid var(--line); display: flex; flex-direction: row; align-items: center; gap: 14rpx; }
.promoter-menu-row.last { border-bottom: 0; }
.promoter-menu-icon { width: 34rpx; height: 34rpx; border-radius: 9rpx; background: var(--accent-bg); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.promoter-menu-icon text { color: var(--accent2); font-size: 18rpx; font-weight: 800; }
.promoter-menu-icon.level, .promoter-menu-icon.commission { background: var(--match-sky); }.promoter-menu-icon.reward, .promoter-menu-icon.partner { background: var(--match-blush); }.promoter-menu-icon.members, .promoter-menu-icon.withdraw { background: var(--sage-soft); }.promoter-menu-icon.leads, .promoter-menu-icon.offline { background: var(--warm); }
.promoter-menu-row > text { color: var(--ink); font-size: 25rpx; font-weight: 700; }
.promoter-menu-value { flex: 1; min-width: 0; display: flex; flex-direction: row; align-items: center; justify-content: flex-end; gap: 12rpx; }
.promoter-menu-value text { max-width: 260rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--muted); font-size: 22rpx; }
.promoter-menu-value i { width: 12rpx; height: 12rpx; border-top: 2rpx solid var(--muted); border-right: 2rpx solid var(--muted); transform: rotate(45deg); }
.promoter-fund-card:active, .promoter-withdraw:active, .promoter-share-actions > view:active, .promoter-menu-row:active { opacity: .78; transform: scale(.99); }

/* 商家联盟：三页签 + 异业合作介绍卡（详情洽谈直达客服）+ 页面级底部导航。 */
.merchant-page { min-height: calc(100vh - 100rpx); gap: 20rpx; }
.merchant-tabs-row { display: flex; flex-direction: row; justify-content: space-around; min-height: 70rpx; align-items: center; font-size: 28rpx; font-weight: 800; }
.merchant-tabs-row text { color: var(--muted); padding-bottom: 14rpx; }
.merchant-tabs-row text.active { color: var(--accent2); border-bottom: 6rpx solid var(--accent2); }
.merchant-coop-card { flex: 1; min-height: 760rpx; padding: 40rpx 32rpx 30rpx; border-radius: 24rpx; background: var(--surface); box-shadow: var(--shadow-sm); display: flex; flex-direction: column; align-items: center; }
.merchant-coop-badge { width: 110rpx; height: 110rpx; border-radius: 24rpx; background: var(--accent-bg); display: flex; align-items: center; justify-content: center; font-size: 52rpx; }
.merchant-coop-title { margin-top: 26rpx; color: var(--ink); font-size: 32rpx; font-weight: 900; }
.merchant-coop-line { margin-top: 10rpx; color: var(--ink2); font-size: 23rpx; line-height: 1.5; }
.merchant-coop-empty { margin-top: 30rpx; padding: 20rpx 40rpx; border-radius: 14rpx; background: var(--match-mist); }
.merchant-coop-empty text { color: var(--muted); font-size: 22rpx; }
.merchant-coop-foot { margin-top: auto; padding: 14rpx 34rpx; border-radius: 999rpx; background: var(--paper); border: 1rpx solid var(--line); display: flex; flex-direction: row; align-items: center; gap: 8rpx; }
.merchant-coop-foot text { color: var(--ink2); font-size: 24rpx; font-weight: 700; }
.merchant-coop-foot:active { opacity: .75; transform: scale(.98); }
.merchant-tabbar { display: flex; flex-direction: row; justify-content: space-around; padding: 18rpx 0 calc(env(safe-area-inset-bottom) + 14rpx); border-radius: 24rpx; background: var(--surface); box-shadow: var(--shadow-sm); }
.merchant-tabbar > view { display: flex; flex-direction: column; align-items: center; gap: 6rpx; }
.merchant-tabbar .merchant-bar-icon { font-size: 34rpx; }
.merchant-tabbar > view > text:last-child { color: var(--muted); font-size: 22rpx; }
.merchant-tabbar > view:active { opacity: .7; }

/* 隶属团队：选择小窗与变更提示，团队卡选中态与加入按钮联动。 */
.team-picker { width: 100%; padding: 34rpx 30rpx calc(env(safe-area-inset-bottom) + 34rpx); border-radius: 28rpx; background: var(--surface); display: flex; flex-direction: column; gap: 24rpx; }
.team-picker-head { display: flex; flex-direction: row; align-items: center; justify-content: space-between; }
.team-picker-title { color: var(--ink); font-size: 32rpx; font-weight: 800; }
.team-picker-close { width: 52rpx; height: 52rpx; border-radius: 50%; background: var(--warm); display: flex; align-items: center; justify-content: center; }
.team-picker-close text { color: var(--ink2); font-size: 24rpx; font-weight: 800; }
.team-picker-search { min-height: 78rpx; padding: 8rpx 8rpx 8rpx 22rpx; border-radius: 999rpx; background: var(--paper); border: 1rpx solid var(--line); display: flex; flex-direction: row; align-items: center; gap: 10rpx; }
.team-picker-search-icon { color: var(--muted); font-size: 30rpx; font-weight: 800; }
.team-picker-search input { flex: 1; min-width: 0; height: 62rpx; color: var(--ink); font-size: 24rpx; }
.team-picker-search-btn { min-width: 108rpx; height: 62rpx; border-radius: 999rpx; background: var(--accent-bg); display: flex; align-items: center; justify-content: center; }
.team-picker-search-btn text { color: var(--accent2); font-size: 25rpx; font-weight: 800; }
.team-picker-empty { padding: 36rpx 0; display: flex; align-items: center; justify-content: center; }
.team-picker-empty text { color: var(--muted); font-size: 24rpx; }
.team-option-card { min-height: 88rpx; padding: 20rpx 26rpx; border-radius: 16rpx; background: var(--paper); border: 1rpx solid var(--line); display: flex; flex-direction: row; align-items: center; justify-content: center; }
.team-option-card.selected { border-color: var(--accent2); background: var(--match-mist); }
.team-option-name { color: var(--ink); font-size: 27rpx; font-weight: 700; }
.team-option-check { margin-left: 12rpx; width: 36rpx; height: 36rpx; border-radius: 50%; background: var(--accent2); display: flex; align-items: center; justify-content: center; }
.team-option-check text { color: var(--paper); font-size: 20rpx; font-weight: 900; }
.team-picker-join { min-height: 84rpx; border-radius: 999rpx; background: linear-gradient(90deg, var(--accent), var(--accent2)); display: flex; align-items: center; justify-content: center; }
.team-picker-join text { color: var(--paper); font-size: 29rpx; font-weight: 800; }
.team-picker-join.disabled { opacity: .55; }
.team-picker-join:active, .team-option-card:active { opacity: .8; transform: scale(.99); }

/* 团队变更提示：情感化占位 + 知道了回执，确认后直达客服。 */
.team-change-dialog { width: 100%; padding: 40rpx 32rpx 32rpx; border-radius: 28rpx; background: var(--surface); display: flex; flex-direction: column; align-items: center; gap: 14rpx; }
.team-change-face { width: 96rpx; height: 96rpx; border-radius: 50%; background: var(--accent-bg); display: flex; align-items: center; justify-content: center; }
.team-change-face text { color: var(--accent2); font-size: 52rpx; }
.team-change-title { color: var(--ink); font-size: 31rpx; font-weight: 800; }
.team-change-copy { color: var(--muted); font-size: 23rpx; line-height: 1.6; text-align: center; }
.team-change-btn { width: 100%; min-height: 80rpx; margin-top: 12rpx; border-radius: 999rpx; background: linear-gradient(90deg, var(--accent), var(--accent2)); display: flex; align-items: center; justify-content: center; }
.team-change-btn text { color: var(--paper); font-size: 27rpx; font-weight: 800; }
.team-change-btn:active { opacity: .8; transform: scale(.99); }

/* 分成级别：渐变横幅衔接 hero 卡，四级阶梯清单逐级列示奖励与分成口径。 */
.level-section { padding-bottom: 48rpx; }
.level-banner { height: 150rpx; margin: -28rpx -28rpx 0; border-radius: 0 0 36rpx 36rpx; background: linear-gradient(135deg, var(--accent), var(--accent2)); }
.level-hero { position: relative; margin-top: -110rpx; padding: 28rpx; border-radius: 24rpx; background: var(--surface); box-shadow: var(--shadow-sm); display: flex; flex-direction: column; gap: 22rpx; }
.level-hero-head { display: flex; flex-direction: row; align-items: center; gap: 18rpx; }
.level-hero-avatar { width: 84rpx; height: 84rpx; border-radius: 50%; background: var(--accent-bg); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.level-hero-avatar text { color: var(--accent2); font-size: 32rpx; font-weight: 800; }
.level-hero-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 10rpx; }
.level-hero-name { display: flex; flex-direction: row; align-items: center; gap: 12rpx; }
.level-hero-name > text:first-child { color: var(--ink); font-size: 30rpx; font-weight: 800; }
.level-hero-badge { padding: 4rpx 14rpx; border-radius: 10rpx; background: var(--match-mist); }
.level-hero-badge text { color: var(--accent2); font-size: 21rpx; font-weight: 800; }
.level-hero-progress { display: flex; flex-direction: row; flex-wrap: wrap; align-items: baseline; color: var(--muted); font-size: 22rpx; }
.level-hero-num { color: var(--accent2); font-size: 26rpx; font-weight: 900; }
.level-hero-next { color: var(--match-coral); font-size: 22rpx; font-weight: 700; }
.level-hero-tip { padding: 20rpx; border-radius: 16rpx; background: var(--match-mist); display: flex; flex-direction: row; gap: 12rpx; }
.level-hero-tip-mark { color: var(--accent2); font-size: 22rpx; font-weight: 800; }
.level-hero-tip-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 8rpx; }
.level-hero-tip-title { color: var(--accent2); font-size: 24rpx; font-weight: 800; }
.level-hero-tip-text { color: var(--ink2); font-size: 22rpx; line-height: 1.6; }
.level-list { border-radius: 20rpx; background: var(--surface); box-shadow: var(--shadow-sm); padding: 8rpx 28rpx; }
.level-item { padding: 26rpx 0; border-bottom: 1rpx solid var(--line); display: flex; flex-direction: column; gap: 10rpx; }
.level-item:last-child { border-bottom: none; }
.level-item-head { display: flex; flex-direction: row; align-items: center; gap: 12rpx; }
.level-item-icon { width: 40rpx; height: 40rpx; border-radius: 10rpx; display: flex; align-items: center; justify-content: center; font-size: 20rpx; flex-shrink: 0; }
.level-item-icon.teal { background: var(--match-mist); color: var(--accent2); }
.level-item-icon.orange { background: var(--match-sky); color: var(--accent2); }
.level-item-icon.rose { background: var(--match-blush); color: var(--match-coral); }
.level-item-icon.violet { background: var(--accent-bg); color: var(--accent2); }
.level-item-name { color: var(--ink); font-size: 28rpx; font-weight: 800; }
.level-item-need { color: var(--muted); font-size: 22rpx; }
.level-item-line { color: var(--ink2); font-size: 23rpx; line-height: 1.55; }

/* 注册奖励：统计与标准构成概览，时间线卡片突出会员与奖励口径。 */
.reward-hero { border-radius: 20rpx; background: var(--surface); box-shadow: var(--shadow-sm); padding: 26rpx; display: flex; flex-direction: column; gap: 18rpx; }
.reward-stats { display: flex; flex-direction: row; }
.reward-stat { width: 33.333%; display: flex; flex-direction: column; align-items: center; gap: 7rpx; }
.reward-stat + .reward-stat { border-left: 1rpx solid var(--line); }
.reward-stat text:first-child { color: var(--ink); font-size: 42rpx; font-weight: 900; }
.reward-stat text:last-child { color: var(--muted); font-size: 22rpx; }
.reward-standard { min-height: 62rpx; padding: 0 18rpx; border-radius: 12rpx; background: var(--match-mist); display: flex; flex-direction: row; align-items: center; gap: 16rpx; }
.reward-standard-tag { padding: 5rpx 12rpx; border-radius: 8rpx; background: var(--accent2); }
.reward-standard-tag text { color: var(--paper); font-size: 20rpx; font-weight: 800; }
.reward-standard > text { color: var(--ink2); font-size: 22rpx; font-weight: 700; }
.reward-hero-note { color: var(--muted); font-size: 22rpx; }
.reward-timeline { display: flex; flex-direction: column; gap: 20rpx; }
.reward-item { display: flex; flex-direction: column; gap: 12rpx; }
.reward-item-time { color: var(--muted); font-size: 22rpx; }
.reward-item-card { padding: 22rpx; border-radius: 18rpx; background: var(--surface); box-shadow: var(--shadow-sm); display: flex; flex-direction: column; gap: 18rpx; }
.reward-member-row { display: flex; flex-direction: row; align-items: center; gap: 14rpx; }
.reward-member-avatar { width: 64rpx; height: 64rpx; border-radius: 50%; overflow: hidden; background: var(--accent-bg); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.reward-member-avatar image { width: 64rpx; height: 64rpx; border-radius: 50%; }
.reward-member-avatar text { color: var(--accent2); font-size: 26rpx; font-weight: 800; }
.reward-member-name { color: var(--ink); font-size: 28rpx; font-weight: 800; }
.reward-member-gender { padding: 2rpx 10rpx; border-radius: 999rpx; font-size: 20rpx; font-weight: 800; }
.reward-member-gender.female { background: var(--match-blush); color: var(--match-coral); }
.reward-member-gender.male { background: var(--match-sky); color: var(--accent2); }
.reward-member-foot { display: flex; flex-direction: row; align-items: center; gap: 16rpx; }
.reward-passed { padding: 6rpx 16rpx; border-radius: 999rpx; background: var(--sage-soft); }
.reward-passed text { color: var(--sage); font-size: 20rpx; font-weight: 800; }
.reward-link { display: flex; flex-direction: row; align-items: center; gap: 6rpx; }
.reward-link text { color: var(--muted); font-size: 21rpx; }
.reward-link i { width: 10rpx; height: 10rpx; border-top: 2rpx solid var(--muted); border-right: 2rpx solid var(--muted); transform: rotate(45deg); }
.reward-amount { margin-left: auto; display: flex; flex-direction: column; align-items: flex-end; gap: 2rpx; }
.reward-amount-num { color: var(--match-coral); font-size: 32rpx; font-weight: 900; }
.reward-amount-caption { color: var(--muted); font-size: 20rpx; }
.member-list-end-row { padding: 20rpx 0 6rpx; display: flex; flex-direction: row; align-items: center; justify-content: center; gap: 14rpx; }
.member-list-end-row view { width: 66rpx; height: 1rpx; background: var(--line); }
.member-list-end-row text { color: var(--muted); font-size: 22rpx; }

/* 名下会员：双 Tab + 跟进过滤 + 档案卡（时间头部、性别徽标、编号）。 */
.member-hero { border-radius: 20rpx; background: var(--surface); box-shadow: var(--shadow-sm); padding: 26rpx; display: flex; flex-direction: column; gap: 18rpx; }
.member-stats { display: flex; flex-direction: row; }
.member-stat { width: 33.333%; display: flex; flex-direction: column; align-items: center; gap: 7rpx; }
.member-stat + .member-stat { border-left: 1rpx solid var(--line); }
.member-stat text:first-child { color: var(--ink); font-size: 42rpx; font-weight: 900; }
.member-stat text:last-child { color: var(--muted); font-size: 22rpx; }
.member-warmtip { padding: 18rpx; border-radius: 14rpx; background: var(--match-mist); display: flex; flex-direction: column; gap: 8rpx; }
.member-warmtip-head { display: flex; flex-direction: row; align-items: center; gap: 8rpx; }
.member-warmtip-heart { color: var(--match-coral); font-size: 22rpx; }
.member-warmtip-head > text:last-child { color: var(--accent2); font-size: 23rpx; font-weight: 800; }
.member-warmtip-text { color: var(--ink2); font-size: 22rpx; line-height: 1.6; }
.member-recent { display: flex; flex-direction: row; align-items: center; gap: 10rpx; padding: 4rpx 4rpx 0; }
.member-recent-box { width: 34rpx; height: 34rpx; border: 1rpx solid var(--line); border-radius: 8rpx; background: var(--surface); display: flex; align-items: center; justify-content: center; }
.member-recent-box.checked { background: var(--accent2); border-color: var(--accent2); }
.member-recent-box text { color: var(--paper); font-size: 20rpx; font-weight: 900; }
.member-recent > text:last-child { color: var(--ink2); font-size: 23rpx; }
.member-incomplete-note { padding: 14rpx 18rpx; border-radius: 12rpx; background: var(--paper); border: 1rpx solid var(--line); }
.member-incomplete-note text { color: var(--muted); font-size: 22rpx; line-height: 1.55; }
.member-empty { gap: 18rpx; }
.member-empty-art { width: 120rpx; height: 120rpx; border-radius: 28rpx; background: var(--accent-bg); display: flex; align-items: center; justify-content: center; }
.member-empty-art text { color: var(--accent2); font-size: 48rpx; font-weight: 900; }
.member-empty-link { color: var(--accent2); font-size: 23rpx; font-weight: 700; }
.member-card { border-radius: 18rpx; background: var(--surface); box-shadow: var(--shadow-sm); display: flex; flex-direction: column; }
.member-card-head { min-height: 66rpx; padding: 0 22rpx; border-bottom: 1rpx solid var(--line); display: flex; flex-direction: row; align-items: center; justify-content: space-between; }
.member-card-time { color: var(--muted); font-size: 22rpx; }
.member-card-status { color: var(--sage); font-size: 22rpx; font-weight: 800; }
.member-card-status.pending { color: var(--match-coral); }
.member-card-body { padding: 20rpx 22rpx; display: flex; flex-direction: row; align-items: center; gap: 16rpx; }
.member-card-avatar { width: 84rpx; height: 84rpx; border-radius: 16rpx; overflow: hidden; background: var(--accent-bg); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.member-card-avatar image { width: 84rpx; height: 84rpx; }
.member-card-avatar text { color: var(--accent2); font-size: 30rpx; font-weight: 800; }
.member-card-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 8rpx; }
.member-card-name { display: flex; flex-direction: row; align-items: center; gap: 10rpx; min-width: 0; }
.member-card-name > text:first-child { max-width: 240rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--ink); font-size: 28rpx; font-weight: 800; }
.member-card-gender { padding: 2rpx 10rpx; border-radius: 999rpx; font-size: 20rpx; font-weight: 800; flex-shrink: 0; }
.member-card-gender.female { background: var(--match-blush); color: var(--match-coral); }
.member-card-gender.male { background: var(--match-sky); color: var(--accent2); }
.member-card-code { color: var(--muted); font-size: 22rpx; }
.member-card-link { display: flex; flex-direction: row; align-items: center; gap: 6rpx; flex-shrink: 0; }
.member-card-link text { color: var(--accent2); font-size: 22rpx; font-weight: 700; }
.member-card-link i { width: 10rpx; height: 10rpx; border-top: 2rpx solid var(--accent2); border-right: 2rpx solid var(--accent2); transform: rotate(45deg); }
.member-card:active, .reward-item-card:active { opacity: .85; transform: scale(.995); }

/* 客源线索：统计与温馨提示、图层插画空态、档案卡与录入表单。 */
.lead-hero { border-radius: 20rpx; background: var(--surface); box-shadow: var(--shadow-sm); padding: 26rpx; display: flex; flex-direction: column; gap: 18rpx; }
.lead-stats { display: flex; flex-direction: row; }
.lead-stat { width: 33.333%; display: flex; flex-direction: column; align-items: center; gap: 7rpx; }
.lead-stat + .lead-stat { border-left: 1rpx solid var(--line); }
.lead-stat text:first-child { color: var(--ink); font-size: 42rpx; font-weight: 900; }
.lead-stat text:last-child { color: var(--muted); font-size: 22rpx; }
.lead-warmtip { padding: 18rpx; border-radius: 14rpx; background: var(--match-mist); display: flex; flex-direction: column; gap: 8rpx; }
.lead-warmtip-head { display: flex; flex-direction: row; align-items: center; gap: 8rpx; }
.lead-warmtip-icon { color: var(--accent2); font-size: 22rpx; font-weight: 800; }
.lead-warmtip-head > text:nth-child(2) { flex: 1; color: var(--accent2); font-size: 23rpx; font-weight: 800; }
.lead-warmtip-link { color: var(--accent2); font-size: 22rpx; font-weight: 700; }
.lead-warmtip-text { color: var(--ink2); font-size: 22rpx; line-height: 1.6; }
.lead-empty { padding: 60rpx 0 40rpx; display: flex; flex-direction: column; align-items: center; gap: 20rpx; }
.lead-empty-art { position: relative; width: 150rpx; height: 120rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.lead-empty-layer { position: absolute; width: 110rpx; height: 64rpx; border-radius: 16rpx; background: var(--accent-bg); display: flex; align-items: center; justify-content: center; transform: translateY(14rpx); }
.lead-empty-layer.mid { background: var(--match-mist); transform: translateY(0); z-index: 1; }
.lead-empty-layer text { color: var(--accent2); font-size: 22rpx; font-weight: 800; }
.lead-empty-text { color: var(--muted); font-size: 25rpx; }
.lead-empty-btn { min-width: 320rpx; min-height: 78rpx; border-radius: 999rpx; background: linear-gradient(90deg, var(--accent), var(--accent2)); display: flex; align-items: center; justify-content: center; }
.lead-empty-btn text { color: var(--paper); font-size: 27rpx; font-weight: 800; }
.lead-empty-btn:active { opacity: .8; transform: scale(.98); }
.lead-list { display: flex; flex-direction: column; gap: 16rpx; }
.lead-card { border-radius: 18rpx; background: var(--surface); box-shadow: var(--shadow-sm); padding: 22rpx; display: flex; flex-direction: column; gap: 12rpx; }
.lead-card-head { display: flex; flex-direction: row; align-items: center; justify-content: space-between; }
.lead-card-name { color: var(--ink); font-size: 28rpx; font-weight: 800; }
.lead-card-status { font-size: 22rpx; font-weight: 800; }
.lead-card-status.ok { color: var(--sage); }
.lead-card-status.bad { color: var(--match-coral); }
.lead-card-status.wait { color: var(--accent2); }
.lead-card-body { display: flex; flex-direction: column; gap: 8rpx; }
.lead-card-line { color: var(--ink2); font-size: 22rpx; }
.lead-card-line.muted { color: var(--muted); font-size: 22rpx; }
.lead-float-add { width: 92rpx; height: 92rpx; }
.lead-float-icon { font-size: 30rpx; font-weight: 900; }
.lead-float-label { font-size: 20rpx; font-weight: 700; }

/* 录入表单：须知条、行内勾选、选择器行与照片占位。 */
.lead-notice { padding: 14rpx 18rpx; border-radius: 12rpx; background: var(--paper); border: 1rpx solid var(--line); display: flex; flex-direction: row; align-items: center; gap: 8rpx; }
.lead-notice-icon { color: var(--accent2); font-size: 20rpx; font-weight: 800; }
.lead-notice text:last-child { color: var(--muted); font-size: 22rpx; }
.lead-form-card { border-radius: 20rpx; background: var(--surface); box-shadow: var(--shadow-sm); padding: 0 26rpx; }
.field.column-tight { align-items: flex-start; flex-direction: column; padding: 20rpx 0; gap: 12rpx; border-bottom: 1rpx solid #E7E8EB; }
.field.column-tight input { width: 100%; text-align: right; }
.field-check { display: flex; flex-direction: row; align-items: center; gap: 8rpx; }
.field-check-box { width: 32rpx; height: 32rpx; border: 1rpx solid var(--line); border-radius: 6rpx; background: var(--surface); display: flex; align-items: center; justify-content: center; }
.field-check-box.checked { background: var(--accent2); border-color: var(--accent2); }
.field-check-box.checked text { color: var(--paper); font-size: 19rpx; font-weight: 900; }
.field-check > text:last-child { color: var(--muted); font-size: 22rpx; }
.lead-field-picker { flex: 1; display: flex; flex-direction: row; align-items: center; justify-content: flex-end; gap: 10rpx; }
.lead-field-picker text { color: var(--ink2); font-size: 25rpx; }
.lead-field-picker i { width: 12rpx; height: 12rpx; border-top: 2rpx solid var(--muted); border-right: 2rpx solid var(--muted); transform: rotate(45deg); }
.lead-photo-add { width: 132rpx; height: 132rpx; border-radius: 16rpx; background: var(--paper); border: 1rpx dashed var(--line); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6rpx; }
.lead-photo-plus { color: var(--muted); font-size: 36rpx; font-weight: 700; }
.lead-photo-label { color: var(--muted); font-size: 20rpx; }
.lead-photo-add:active { opacity: .7; }
.lead-submit { margin-top: 6rpx; }

/* 消费分成：渐变横幅衔接 hero 卡（级别徽章+分成标准入口），空态为档案插画。 */
.commission-section { padding-bottom: 48rpx; }
.commission-banner { height: 150rpx; margin: -28rpx -28rpx 0; border-radius: 0 0 36rpx 36rpx; background: linear-gradient(135deg, var(--accent), var(--accent2)); }
.commission-hero { position: relative; margin-top: -110rpx; padding: 28rpx; border-radius: 24rpx; background: var(--surface); box-shadow: var(--shadow-sm); display: flex; flex-direction: column; gap: 20rpx; }
.commission-hero-head { display: flex; flex-direction: row; align-items: center; gap: 16rpx; }
.commission-hero-avatar { width: 84rpx; height: 84rpx; border-radius: 50%; background: var(--accent-bg); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.commission-hero-avatar text { color: var(--accent2); font-size: 32rpx; font-weight: 800; }
.commission-hero-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 10rpx; }
.commission-hero-name { color: var(--ink); font-size: 30rpx; font-weight: 800; }
.commission-hero-level { display: flex; flex-direction: row; align-items: center; gap: 8rpx; }
.commission-hero-level > text:first-child { color: var(--muted); font-size: 22rpx; }
.commission-hero-badge { padding: 4rpx 14rpx; border-radius: 10rpx; background: var(--match-mist); }
.commission-hero-badge text { color: var(--accent2); font-size: 21rpx; font-weight: 800; }
.commission-hero-link { display: flex; flex-direction: row; align-items: center; gap: 6rpx; padding: 10rpx 18rpx; border-radius: 999rpx; background: var(--accent-bg); flex-shrink: 0; }
.commission-hero-link text { color: var(--accent2); font-size: 22rpx; font-weight: 800; }
.commission-hero-link i { width: 10rpx; height: 10rpx; border-top: 2rpx solid var(--accent2); border-right: 2rpx solid var(--accent2); transform: rotate(45deg); }
.commission-hero-tip { padding: 18rpx; border-radius: 14rpx; background: var(--match-mist); display: flex; flex-direction: row; gap: 12rpx; }
.commission-hero-tip-mark { color: var(--accent2); font-size: 22rpx; font-weight: 800; }
.commission-hero-tip-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 6rpx; }
.commission-hero-tip-title { color: var(--accent2); font-size: 23rpx; font-weight: 800; }
.commission-hero-tip-text { color: var(--ink2); font-size: 22rpx; line-height: 1.6; }
.commission-list-card { border-radius: 20rpx; background: var(--surface); box-shadow: var(--shadow-sm); padding: 26rpx; }
.commission-empty { padding: 60rpx 0; display: flex; flex-direction: column; align-items: center; gap: 22rpx; }
