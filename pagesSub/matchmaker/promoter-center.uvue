<template>
	<view class="promoter-page">
		<view class="promoter-nav"><view class="back" @click="goBack"><view></view></view><text>{{ title }}</text><view class="menu"><view></view><view></view></view></view>
		<scroll-view scroll-y class="scroll" :show-scrollbar="false">
			<view v-if="loading" class="loading"><view></view><view></view><view></view></view>
			<view v-else-if="page == 'home'" class="content promoter-home">
				<view class="promoter-fund-card">
					<view class="promoter-fund-main"><text>可提现额度（元）</text><text>{{ availableBalance }}</text></view>
					<view class="promoter-withdraw" @click="open('withdraw')"><text>立即提现</text></view>
					<view class="promoter-fund-foot"><view class="promoter-user-mark"><text>{{ promoterInitial }}</text></view><text>{{ profile.nickname || '推广红娘' }}</text><text>累计推广：{{ totalPromoted }} 人</text></view>
				</view>

				<view class="promoter-review-card">
					<view class="promoter-review-metrics"><view><text>{{ pendingMemberCount }}</text><text>待审人数</text></view><view><text>{{ effectiveMembers.length }}</text><text>通过人数</text></view><view><text>{{ rejectedMemberCount }}</text><text>未通过人数</text></view></view>
					<view class="promoter-notice"><view class="promoter-notice-mark"><text>i</text></view><view><text>温馨提示</text><text>登录状态下分享会员详情、会员海报或活动页，链接会包含您的专属参数；引流注册的会员通过资料审核后，将归入您的推广名下。</text></view></view>
				</view>

				<view class="promoter-share-card"><view class="promoter-share-head"><view class="promoter-share-icon"><text>↗</text></view><text>分享专属推广链接，邀请新会员注册</text></view><view class="promoter-share-actions"><view @click="copyLink"><text>复制专属推广码</text></view><view @click="savePoster"><text>推广海报</text></view></view></view>

				<view class="promoter-menu-card">
					<view class="promoter-menu-row" @click="openTeamEntry"><view class="promoter-menu-icon team"><text>团</text></view><text>隶属团队</text><view class="promoter-menu-value"><text>{{ profile.teamName || '暂未加入团队' }}</text><i></i></view></view>
					<view class="promoter-menu-row" @click="open('level')"><view class="promoter-menu-icon level"><text>级</text></view><text>分成级别</text><view class="promoter-menu-value"><text>{{ profile.level || '初级' }}</text><i></i></view></view>
					<view class="promoter-menu-row" @click="showToast('注册奖励将在服务端结算接入后展示')"><view class="promoter-menu-icon reward"><text>奖</text></view><text>注册奖励</text><view class="promoter-menu-value"><text>待结算</text><i></i></view></view>
					<view class="promoter-menu-row" @click="open('members')"><view class="promoter-menu-icon members"><text>会</text></view><text>名下会员</text><view class="promoter-menu-value"><text>有效会员 {{ effectiveMembers.length }} 人</text><i></i></view></view>
					<view class="promoter-menu-row" @click="open('leads')"><view class="promoter-menu-icon leads"><text>线</text></view><text>客源线索</text><view class="promoter-menu-value"><text>录入</text><i></i></view></view>
					<view class="promoter-menu-row" @click="open('commission')"><view class="promoter-menu-icon commission"><text>分</text></view><text>消费分成</text><view class="promoter-menu-value"><text>待结算</text><i></i></view></view>
					<view class="promoter-menu-row" @click="open('merchant')"><view class="promoter-menu-icon merchant-entry"><text>商</text></view><text>商家联盟</text><view class="promoter-menu-value"><text>待开放</text><i></i></view></view>
					<view class="promoter-menu-row" @click="open('offline')"><view class="promoter-menu-icon offline"><text>单</text></view><text>线下开单</text><view class="promoter-menu-value"><text>签约后可见</text><i></i></view></view>
					<view class="promoter-menu-row" @click="open('withdraw')"><view class="promoter-menu-icon withdraw"><text>提</text></view><text>申请提现</text><view class="promoter-menu-value"><text>待开放</text><i></i></view></view>
					<view class="promoter-menu-row" @click="contactVisible = true"><view class="promoter-menu-icon support"><text>服</text></view><text>联系客服</text><view class="promoter-menu-value"><text>需要帮助请联系</text><i></i></view></view>
					<view class="promoter-menu-row" @click="goApplyPartner"><view class="promoter-menu-icon partner"><text>合</text></view><text>申请合伙</text><view class="promoter-menu-value"><text>申请成为合伙人</text><i></i></view></view>
					<view class="promoter-menu-row last" @click="showToast('账号资料请在“我的”页面设置')"><view class="promoter-menu-icon account"><text>我</text></view><text>我的账号</text><view class="promoter-menu-value"><text>设置</text><i></i></view></view>
				</view>
			</view>

			<view v-else class="content sub-content">
				<view v-if="page == 'withdraw'" class="section">
					<view class="cash-card compact"><view><text>可提现额度（元）</text><text>{{ money(profile.balance) }}</text></view><view class="cash-button" @click="withdrawForm = !withdrawForm"><text>{{ withdrawForm ? '提现记录' : '申请提现' }}</text></view></view>
					<view v-if="withdrawForm" class="form-card">
						<view class="wd-balance-line"><text>可提现余额</text><text class="wd-balance-num">{{ money(profile.balance) }} 元</text></view>
						<view class="wd-amount-line"><text class="wd-yuan">¥</text><input type="digit" placeholder="输入金额(1-1000元)" :value="withdrawAmount" @input="withdrawAmount = $event.detail.value"/></view>
						<view class="method" v-for="item in methods" :key="item" @click="withdrawMethod = item"><text :class="{ checked: withdrawMethod == item }">{{ withdrawMethod == item ? '选中' : '选择' }}</text><text>提现到{{ item }}</text></view>
						<input placeholder="输入收款账号" :value="withdrawAccount" @input="withdrawAccount = $event.detail.value"/>
						<input placeholder="输入收款人姓名" :value="withdrawPayee" @input="withdrawPayee = $event.detail.value"/>
						<view class="gradient-btn" @click="submitWithdraw"><text>确认提现</text></view>
					</view>
					<view v-else class="offline-list-card">
						<view class="commission-empty">
							<view class="commission-empty-art"><view class="commission-empty-doc"><view class="commission-empty-face"><text>人</text></view><view class="commission-empty-line"></view><view class="commission-empty-line short"></view></view><view class="commission-empty-lens"></view></view>
							<text class="commission-empty-text">什么都没有哦</text>
						</view>
					</view>
				</view>
				<view v-else-if="page == 'level'" class="section level-section">
					<view class="level-banner"></view>
					<view class="level-hero">
						<view class="level-hero-head">
							<view class="level-hero-avatar"><text>{{ promoterInitial }}</text></view>
							<view class="level-hero-copy">
								<view class="level-hero-name"><text>{{ profile.nickname || '推广红娘' }}</text><view class="level-hero-badge"><text>{{ profile.level || '初级' }}</text></view></view>
								<view class="level-hero-progress"><block v-if="nextLevelName != ''"><text>还差 </text><text class="level-hero-num">{{ nextLevelGap }}</text><text> 位有效会员可升级到 </text><text class="level-hero-next">{{ nextLevelName }}</text></block><block v-else><text>您已是最高级别，感谢您的持续贡献</text></block></view>
							</view>
						</view>
						<view class="level-hero-tip"><text class="level-hero-tip-mark">ⓘ</text><view class="level-hero-tip-copy"><text class="level-hero-tip-title">温馨提示</text><text class="level-hero-tip-text">推广红娘设有4个级别，每个级别可享有不同的分成标准，根据名下的有效会员数自动升级对应级别。</text></view></view>
					</view>
					<view class="level-list">
						<view v-for="item in promoterLevels" :key="item.name" class="level-item">
							<view class="level-item-head"><view class="level-item-icon" :class="item.tone"><text>★</text></view><text class="level-item-name">{{ item.name }}</text><text v-if="item.need != ''" class="level-item-need">（{{ item.need }}）</text></view>
							<text class="level-item-line">会员注册奖励：♂ 男会员0元/人　♀ 女会员0元/人</text>
							<text class="level-item-line">会员消费分成：{{ item.rate }}</text>
						</view>
					</view>
				</view>
				<view v-else-if="page == 'rewards'" class="section">
					<view class="reward-hero">
						<view class="reward-stats"><view class="reward-stat"><text>0</text><text>待审人数</text></view><view class="reward-stat"><text>{{ rewards.length }}</text><text>通过人数</text></view><view class="reward-stat"><text>0</text><text>未过人数</text></view></view>
						<view class="reward-standard"><view class="reward-standard-tag"><text>奖励标准</text></view><text>♂ 男会员0元/人</text><text>♀ 女会员0元/人</text></view>
						<text class="reward-hero-note">资料审核通过后才可获得奖励哦</text>
					</view>
					<view class="search"><input placeholder="请输入会员昵称或编号" :value="keyword" @input="keyword = $event.detail.value"/><text @click="checkSearch">搜索</text></view>
					<view v-if="filteredRewards.length == 0" class="empty"><text>什么都还没有哦</text></view>
					<view v-else class="reward-timeline">
						<view v-for="item in filteredRewards" :key="item.id" class="reward-item">
							<text class="reward-item-time">{{ item.createdAt }}</text>
							<view class="reward-item-card">
								<view class="reward-member-row">
									<view class="reward-member-avatar"><image v-if="item.avatar" :src="item.avatar" mode="aspectFill"/><text v-else>{{ promoterInitial }}</text></view>
									<text class="reward-member-name">{{ item.memberName }}</text>
									<text v-if="item.gender != ''" class="reward-member-gender" :class="item.gender == '女' ? 'female' : 'male'">{{ item.gender == '女' ? '♀' : '♂' }}</text>
								</view>
								<view class="reward-member-foot">
									<view class="reward-passed"><text>已通过</text></view>
									<view class="reward-link" @click="viewMemberHome(item)"><text>去看看</text><i></i></view>
									<view class="reward-amount"><text class="reward-amount-num">+{{ money(item.amount) }}</text><text class="reward-amount-caption">奖励(元)</text></view>
								</view>
							</view>
						</view>
						<view class="member-list-end-row"><view></view><text>没有更多了</text><view></view></view>
					</view>
				</view>
				<view v-else-if="page == 'members'" class="section">
					<view class="member-hero">
						<view class="member-stats"><view class="member-stat"><text>{{ effectiveMembers.length }}</text><text>有效会员</text></view><view class="member-stat"><text>{{ maleCount }}</text><text>男会员</text></view><view class="member-stat"><text>{{ femaleCount }}</text><text>女会员</text></view></view>
						<view class="member-warmtip"><view class="member-warmtip-head"><text class="member-warmtip-heart">♥</text><text>温馨提示</text></view><text class="member-warmtip-text">您发展来的会员在通过平台资料审核后将被纳入到您名下有效会员，您将获得有效的注册奖励和消费分成</text></view>
					</view>
					<view class="tabs"><text :class="{ active: memberTab == 'effective' }" @click="memberTab = 'effective'">有效会员</text><text :class="{ active: memberTab == 'incomplete' }" @click="memberTab = 'incomplete'">未完善资料</text></view>
					<view class="search"><input placeholder="请输入会员昵称或ID" :value="keyword" @input="keyword = $event.detail.value"/><text @click="checkSearch">搜索</text></view>
					<view v-if="memberTab == 'effective' && memberRows.length > 0" class="member-recent" @click="recentOnly = !recentOnly"><view class="member-recent-box" :class="{ checked: recentOnly }"><text v-if="recentOnly">✓</text></view><text>7日内有新的跟进</text></view>
					<view v-if="memberTab == 'incomplete'" class="member-incomplete-note"><text>ⓘ 以下是已进入平台进行了推广，但并未完善资料，推广者未确认您在名额中。</text></view>
					<view v-if="memberRows.length == 0" class="empty member-empty">
						<view class="member-empty-art"><text>会</text></view>
						<text>{{ memberTab == 'effective' ? '什么都没有认领' : '什么都没有认领' }}</text>
						<text v-if="memberTab == 'incomplete'" class="member-empty-link" @click="open('lead-form')">向有效的新人发起牵线吧 ></text>
					</view>
					<view v-for="item in memberRows" :key="item.id" class="member-card">
						<view class="member-card-head"><text class="member-card-time">注册时间：{{ item.registerAt }}</text><text v-if="memberTab == 'effective'" class="member-card-status">审核通过</text><text v-else class="member-card-status pending">待完善</text></view>
						<view class="member-card-body">
							<view class="member-card-avatar"><image v-if="item.avatar" :src="item.avatar" mode="aspectFill"/><text v-else>{{ avatarChar(item.name) }}</text></view>
							<view class="member-card-copy">
								<view class="member-card-name"><text>{{ item.name }}</text><text v-if="item.gender != ''" class="member-card-gender" :class="item.gender == '女' ? 'female' : 'male'">{{ item.gender == '女' ? '♀' : '♂' }}</text></view>
								<text class="member-card-code">会员编号：{{ item.memberCode != '' ? item.memberCode : item.id }}</text>
							</view>
							<view v-if="memberTab == 'effective' && isPositiveUserId(item.id)" class="member-card-link" @click="viewMemberHome(item)"><text>去看看</text><i></i></view>
						</view>
					</view>
				</view>
				<view v-else-if="page == 'leads'" class="section">
					<view class="lead-hero">
						<view class="lead-stats"><view class="lead-stat"><text>{{ pendingCount }}</text><text>待审核</text></view><view class="lead-stat"><text>{{ validLeadCount }}</text><text>有效</text></view><view class="lead-stat"><text>{{ invalidLeadCount }}</text><text>无效</text></view></view>
						<view class="lead-warmtip"><view class="lead-warmtip-head"><text class="lead-warmtip-icon">ⓘ</text><text>温馨提示</text><text class="lead-warmtip-link" @click="open('report')">数据报表 ></text></view><text class="lead-warmtip-text">将您获取到的单身信息录入到系统中，待平台核实为有效客源后您将获得奖励</text></view>
					</view>
					<view class="search"><input placeholder="请输入称呼/手机/微信" :value="keyword" @input="keyword = $event.detail.value"/><text @click="checkSearch">搜索</text></view>
					<view v-if="filteredLeads.length == 0" class="lead-empty">
						<view class="lead-empty-art"><view class="lead-empty-layer"><text>客</text></view><view class="lead-empty-layer mid"><text>源</text></view><view class="lead-empty-layer"><text>库</text></view></view>
						<text class="lead-empty-text">还没有任何客源呢</text>
						<view class="lead-empty-btn" @click="open('lead-form')"><text>立即添加 ></text></view>
					</view>
					<view v-else class="lead-list">
						<view v-for="item in filteredLeads" :key="item.id" class="lead-card">
							<view class="lead-card-head"><text class="lead-card-name">{{ item.nickname || item.realName || item.name || '未称呼' }}</text><text class="lead-card-status" :class="item.status == '有效' ? 'ok' : (item.status == '无效' ? 'bad' : 'wait')">{{ item.status }}</text></view>
							<view class="lead-card-body">
								<text v-if="item.phone != null && String(item.phone) != ''" class="lead-card-line">手机：{{ item.phone }}</text>
								<text v-if="item.wechat != null && String(item.wechat) != ''" class="lead-card-line">微信：{{ item.wechat }}</text>
								<text class="lead-card-line">来源：{{ item.source }}</text>
								<text class="lead-card-line muted">录入时间：{{ item.createdAt }}</text>
							</view>
						</view>
						<view class="member-list-end-row"><view></view><text>没有更多了</text><view></view></view>
					</view>
					<view class="float-add lead-float-add" @click="open('lead-form')"><text class="lead-float-icon">⊞</text><text class="lead-float-label">添加</text></view>
				</view>
				<view v-else-if="page == 'lead-form'" class="section form-page">
					<view class="lead-notice"><text class="lead-notice-icon">ⓘ</text><text>须知：您录入的信息提交后将被平台进行核实</text></view>
					<view class="lead-form-card">
						<view class="field"><text>来源</text><input :placeholder="leadFields[0].placeholder" :value="leadForm.source" @input="updateLead('source', $event.detail.value)"/></view>
						<view class="field"><text>手机</text><input type="number" placeholder="请输入" :value="leadForm.phone" @input="updateLead('phone', $event.detail.value)"/></view>
						<view class="field column-tight"><text>微信</text><input placeholder="请输入" :value="leadForm.wechat" @input="updateLead('wechat', $event.detail.value)"/><view class="field-check" @click="leadForm.wechatSameAsPhone = !leadForm.wechatSameAsPhone"><view class="field-check-box" :class="{ checked: leadForm.wechatSameAsPhone }"><text v-if="leadForm.wechatSameAsPhone">✓</text></view><text>同手机号</text></view></view>
						<view class="field column-tight"><text>称呼</text><input placeholder="请输入" :value="leadForm.nickname" @input="updateLead('nickname', $event.detail.value)"/><view class="field-check" @click="leadForm.autoNickname = !leadForm.autoNickname"><view class="field-check-box" :class="{ checked: leadForm.autoNickname }"><text v-if="leadForm.autoNickname">✓</text></view><text>自动生成</text></view></view>
						<view class="field"><text>姓名</text><input placeholder="请输入" :value="leadForm.realName" @input="updateLead('realName', $event.detail.value)"/></view>
						<view class="field"><text>性别</text><view class="lead-field-picker" @click="pickGender"><text>{{ leadForm.gender }}</text><i></i></view></view>
						<view class="field"><text>出生</text><view class="lead-field-picker" @click="pickBirth"><text>{{ leadForm.birth }}</text><i></i></view></view>
						<view class="field"><text>体重</text><view class="lead-field-picker" @click="pickWeight"><text>{{ leadForm.weight != '' ? leadForm.weight + 'kg' : '未填写' }}</text><i></i></view></view>
						<view class="field"><text>身高</text><view class="lead-field-picker" @click="pickHeight"><text>{{ leadForm.height != '' ? leadForm.height + 'cm' : '未填写' }}</text><i></i></view></view>
						<view class="field column"><text>描述</text><textarea placeholder="尽可能的将了解到的信息进行一段描述，如：职业、学历、身高、婚况、收入、择偶需求等等" :value="leadForm.description" @input="leadForm.description = $event.detail.value"></textarea></view>
						<view class="field column-tight"><text>照片</text><view class="lead-photo-add" @click="addLeadPhoto"><text class="lead-photo-plus">＋</text><text class="lead-photo-label">上传图片</text></view></view>
					</view>
					<view class="gradient-btn lead-submit" @click="submitLead"><text>确定提交</text></view>
				</view>
				<view v-else-if="page == 'report'" class="section report"><view class="table-head"><text>月份</text><text>有效(男)</text><text>有效(女)</text><text>待审</text><text>无效</text></view><view class="lead-empty report-empty"><view class="lead-empty-art"><view class="lead-empty-layer"><text>报</text></view><view class="lead-empty-layer mid"><text>表</text></view><view class="lead-empty-layer"><text>库</text></view></view><text class="lead-empty-text">还没有任何报表呢</text></view></view>
				<view v-else-if="page == 'commission'" class="section commission-section">
					<view class="commission-banner"></view>
					<view class="commission-hero">
						<view class="commission-hero-head">
							<view class="commission-hero-avatar"><text>{{ promoterInitial }}</text></view>
							<view class="commission-hero-copy">
								<text class="commission-hero-name">{{ profile.nickname || '推广红娘' }}</text>
								<view class="commission-hero-level"><text>您的分成级别：</text><view class="commission-hero-badge"><text>{{ profile.level || '初级' }}</text></view></view>
							</view>
							<view class="commission-hero-link" @click="open('level')"><text>分成标准</text><i></i></view>
						</view>
						<view class="commission-hero-tip"><text class="commission-hero-tip-mark">ⓘ</text><view class="commission-hero-tip-copy"><text class="commission-hero-tip-title">温馨提示</text><text class="commission-hero-tip-text">您可以获得您名下有效会员在平台中的消费分成。</text></view></view>
					</view>
					<view class="commission-list-card">
						<view v-if="commissions.length == 0" class="commission-empty">
							<view class="commission-empty-art"><view class="commission-empty-doc"><view class="commission-empty-face"><text>人</text></view><view class="commission-empty-line"></view><view class="commission-empty-line short"></view></view><view class="commission-empty-lens"></view></view>
							<text class="commission-empty-text">什么都没有哦</text>
						</view>
						<view v-else class="commission-records">
							<view v-for="item in commissions" :key="item.id" class="reward-item">
								<text class="reward-item-time">{{ item.createdAt }}</text>
								<view class="reward-item-card">
									<view class="reward-member-row"><text class="reward-member-name">{{ item.itemName }}</text><text v-if="item.memberName != null && String(item.memberName) != ''" class="reward-member-sub">{{ item.memberName }}</text></view>
									<view class="reward-amount"><text class="reward-amount-num">+{{ money(item.amount) }}</text><text class="reward-amount-caption">分成(元)</text></view>
								</view>
							</view>
							<view class="member-list-end-row"><view></view><text>没有更多了</text><view></view></view>
						</view>
					</view>
				</view>
				<view v-else-if="page == 'merchant'" class="section merchant-page">
					<view class="merchant-tabs-row">
						<text v-for="tab in merchantTabs" :key="tab.key" :class="{ active: merchantTab == tab.key }" @click="merchantTab = tab.key">{{ tab.label }}</text>
					</view>
					<view class="merchant-coop-card">
						<view class="merchant-coop-badge"><text>🤝</text></view>
						<text class="merchant-coop-title">同城商家异业联盟合作</text>
						<text class="merchant-coop-line">我们推广销售您的商品或服务</text>
						<text class="merchant-coop-line">您推广我们的婚恋交友服务</text>
						<view v-if="merchantTab != 'goods'" class="merchant-coop-empty"><text>{{ merchantTab == 'orders' ? '还没有任何订单呢' : '还没有任何核销记录呢' }}</text></view>
						<view class="merchant-coop-foot" @click="merchantNegotiate"><text>🤝 详情洽谈</text></view>
					</view>
					<view class="merchant-tabbar">
						<view v-for="bar in merchantBar" :key="bar.key" @click="merchantBarTap(bar)"><text class="merchant-bar-icon">{{ bar.icon }}</text><text>{{ bar.label }}</text></view>
					</view>
				</view>
				<view v-else-if="page == 'mall'" class="section mall-page"><view class="mall-banner"></view><view class="merchant-tabs"><text class="active">全部</text><text>推荐餐饮</text><text>新奇体验</text><text>休闲玩乐</text></view><view class="empty"><text>什么都还没有哦</text></view></view>
				<view v-else-if="page == 'offline'" class="section">
					<view class="offline-notice"><text class="offline-notice-icon">ⓘ</text><view class="offline-notice-copy"><text class="offline-notice-title">须知</text><text class="offline-notice-text">以下是您名下客源成功做单成为我们平台旗下VIP服务客户的记录。数据信息若有误差，请与工作人员核对为准。</text></view></view>
					<view class="offline-list-card">
						<view v-if="offlineOrders.length == 0" class="commission-empty">
							<view class="commission-empty-art"><view class="commission-empty-doc"><view class="commission-empty-face"><text>人</text></view><view class="commission-empty-line"></view><view class="commission-empty-line short"></view></view><view class="commission-empty-lens"></view></view>
							<text class="commission-empty-text">什么都没有哦</text>
						</view>
						<view v-else class="offline-records">
							<view v-for="item in offlineOrders" :key="item.id" class="reward-item">
								<text class="reward-item-time">{{ item.createdAt }}</text>
								<view class="reward-item-card">
									<view class="reward-member-row"><text class="reward-member-name">{{ item.customer }}</text><view class="status-pill-small" :class="{ pending: item.status != '已结算' }"><text>{{ item.status }}</text></view></view>
									<view class="reward-amount"><text class="reward-amount-num">{{ money(item.amount) }}</text><text class="reward-amount-caption">开单金额(元)</text></view>
								</view>
							</view>
							<view class="member-list-end-row"><view></view><text>没有更多了</text><view></view></view>
						</view>
					</view>
				</view>
				<view v-else-if="page == 'finance'" class="section"><view class="funds"><view><text>余额（元）</text><text>{{ money(profile.balance) }}</text><text @click="open('withdraw')">提现</text></view><view><text>积分（金市）</text><text>{{ profile.points }}</text><text @click="showToast('充值功能待后端接入')">充值</text></view></view><view class="tabs"><text :class="{ active: financeTab == 'expense' }" @click="financeTab = 'expense'">支出明细</text><text :class="{ active: financeTab == 'balance' }" @click="financeTab = 'balance'">余额明细</text><text :class="{ active: financeTab == 'points' }" @click="financeTab = 'points'">积分明细</text></view><view class="empty"><text>什么都还没有哦</text></view></view>
				<view v-else-if="page == 'account'" class="section">
					<view class="funds">
						<view><text>余额（元）</text><text>{{ money(profile.balance) }}</text><view><text @click="open('withdraw')">提现</text><text @click="open('finance')">财务明细 ></text></view></view>
						<view><text>积分（金币）</text><text>{{ profile.points != null ? profile.points : 0 }}</text><view><text @click="showToast('兑换礼物将在积分商城开放后可用')">兑换礼物 ></text></view></view>
					</view>
					<view class="list-card">
						<view class="row"><text>头像</text><view class="account-avatar"><text>{{ promoterInitial }}</text></view></view>
						<view class="row" @click="accountEditVisible = true"><text>昵称</text><text>{{ profile.nickname || '未完善资料' }}</text><i></i></view>
						<view class="row" @click="accountEditVisible = true"><text>手机</text><text>{{ maskedPhone }}</text><i></i></view>
						<view class="row"><text>微信</text><text>{{ profile.wechatBound ? '已绑定' : '未绑定' }}</text></view>
						<view class="row" @click="showToast('密码修改需在账号安全页完成')"><text>密码</text><text>修改</text><i></i></view>
						<view class="row"><text>注册</text><text>{{ profile.registerAt || '暂无记录' }}</text></view>
						<view class="account-logout" @click="confirmLogout"><text>退出登录</text></view>
						<view class="account-deactivate" @click="deactivateVisible = true"><text>注销账号</text></view>
					</view>
				</view>
			</view>
		</scroll-view>

		<view v-if="teamPickerVisible" class="overlay" @click="teamPickerVisible = false"><view class="team-picker" @click.stop><view class="team-picker-head"><text class="team-picker-title">选择合伙团队</text><view class="team-picker-close" @click="teamPickerVisible = false"><text>✕</text></view></view><view class="team-picker-search"><text class="team-picker-search-icon">⌕</text><input placeholder="请输入团队关键词" :value="teamSearch" @input="teamSearch = $event.detail.value"/><view class="team-picker-search-btn" @click="applyTeamSearch"><text>搜索</text></view></view><view v-if="filteredTeamOptions.length == 0" class="team-picker-empty"><text>{{ teamSearch.trim() == '' ? '暂无可加入的合伙团队' : '未找到匹配的团队' }}</text></view><view v-for="team in filteredTeamOptions" :key="team.id" class="team-option-card" :class="{ selected: selectedTeamId == team.id }" @click="selectTeam(team)"><text class="team-option-name">{{ team.name }}</text><view v-if="selectedTeamId == team.id" class="team-option-check"><text>✓</text></view></view><view class="team-picker-join" :class="{ disabled: selectedTeamId == null }" @click="joinSelectedTeam"><text>立即加入</text></view></view></view>
		<view v-if="teamChangeTipVisible" class="overlay" @click="teamChangeTipVisible = false"><view class="team-change-dialog" @click.stop><view class="team-change-face"><text>☹</text></view><text class="team-change-title">抱歉</text><text class="team-change-copy">您想变更已加入的团队吗？请联系客服处理</text><view class="team-change-btn" @click="onTeamChangeAck"><text>知道了</text></view></view></view>
		<view v-if="contactVisible" class="overlay" @click="contactVisible = false"><view class="contact-wrap" @click.stop><view class="contact-dialog"><view class="contact-hero"><view class="contact-badge"><text>客服</text></view><text class="contact-head-title">联系客服</text><view class="contact-hero-arc"></view></view><view class="contact-body"><view class="contact-qr-card"><image class="contact-qr" src="/static/qrcodes/kefu-wechat.png" mode="aspectFit"></image></view><view class="contact-quote"><text class="contact-quote-mark">“</text><text class="contact-copy">您有任何疑问请联系我们的工作人员</text><text class="contact-quote-mark">”</text></view></view></view><view class="contact-close" @click="contactVisible = false"><text>✕</text></view></view></view>
		<view v-if="accountEditVisible" class="overlay" @click="accountEditVisible = false"><view class="dialog" @click.stop><view class="dialog-head"><text>修改账号资料</text><text @click="accountEditVisible = false">关闭</text></view><input placeholder="输入昵称" :value="accountNickname" @input="accountNickname = $event.detail.value"/><input type="number" placeholder="输入手机号" :value="accountPhone" @input="accountPhone = $event.detail.value"/><view class="gradient-btn" @click="saveAccount"><text>保存</text></view></view></view>
		<view v-if="deactivateVisible" class="overlay"><view class="dialog" @click.stop><text>注销账号</text><text>注销后本机保存的推广红娘资料和业务记录将无法恢复。</text><view class="dialog-actions"><text @click="deactivateVisible = false">取消</text><text @click="showToast('账号注销需平台人工核验'); deactivateVisible = false">申请注销</text></view></view></view>
		<XsaToast :visible="toastVisible" :message="toastMessage" @hide="toastVisible = false" />
	</view>
</template>

<script setup lang="uts">
import XsaToast from '@/components/XsaToast.uvue'
import { addPromoterLead, createPromoterPromotionCode, createPromoterWithdrawal, getPromoterCenterSnapshot, updatePromoterCenterProfile } from '@/api'
import { logout as logoutApi } from '@/api/auth'
const page = ref('home'), loading = ref(true), snapshot = ref<any>({ profile: {}, teamOptions: [], leads: [], effectiveMembers: [], incompleteMembers: [], rewards: [], commissions: [], offlineOrders: [] }), toastVisible = ref(false), toastMessage = ref(''), keyword = ref(''), memberTab = ref('effective'), financeTab = ref('balance'), teamPickerVisible = ref(false), teamChangeTipVisible = ref(false), contactVisible = ref(false), accountEditVisible = ref(false), deactivateVisible = ref(false), withdrawForm = ref(false), withdrawAmount = ref(''), withdrawAccount = ref(''), withdrawPayee = ref(''), withdrawMethod = ref('微信'), accountNickname = ref(''), accountPhone = ref(''), teamSearch = ref(''), teamSearchApplied = ref(''), selectedTeamId = ref(null as string | null), recentOnly = ref(false), merchantTab = ref('goods')
const methods = ['微信', '银行卡', '支付宝']
const leadForm = ref<any>({ source: '', phone: '', wechat: '', wechatSameAsPhone: false, autoNickname: false, nickname: '', realName: '', gender: '男', birth: '1990-01-01', height: '', weight: '', description: '', photos: [] as any[] })
const leadFields = [{ key: 'source', label: '来源', placeholder: '请输入来源' }, { key: 'phone', label: '手机', placeholder: '请输入' }, { key: 'wechat', label: '微信', placeholder: '请输入' }, { key: 'nickname', label: '称呼', placeholder: '请输入' }, { key: 'realName', label: '姓名', placeholder: '请输入' }, { key: 'birth', label: '出生', placeholder: '1990-01-01' }, { key: 'weight', label: '体重', placeholder: '未填写' }, { key: 'height', label: '身高', placeholder: '未填写' }]
const merchantTabs = [ { key: 'goods', label: '在售商品' }, { key: 'orders', label: '订单记录' }, { key: 'verify', label: '核销记录' } ]
const merchantBar = [ { key: 'home', icon: '⌂', label: '商家首页' }, { key: 'shop', icon: '🏪', label: '我的店铺' }, { key: 'orders', icon: '📋', label: '订单核销' }, { key: 'settle', icon: '¥', label: '分成结算' } ]
const merchantNegotiate=()=>{contactVisible.value=true}
const goApplyPartner=()=>{uni.navigateTo({url:'/pagesSub/matchmaker/become-partner'})}
const merchantBarTap=(bar:any)=>{if(bar.key=='settle'){showToast('分成结算将在商家联盟开通后开放');return};if(bar.key=='orders'){merchantTab.value='orders';return};if(bar.key=='shop'){showToast('店铺管理将在商家联盟开通后开放');return};merchantTab.value='goods'}
const promoterLevels = [
	{ name: '初级', need: '', threshold: 0, rate: '无分成', tone: 'teal' },
	{ name: '推广大师', need: '有效会员数≥51人', threshold: 51, rate: '无分成', tone: 'orange' },
	{ name: '推广大使', need: '有效会员数≥100人', threshold: 100, rate: '无分成', tone: 'rose' },
	{ name: '推广天使', need: '有效会员数≥500人', threshold: 500, rate: '无分成', tone: 'violet' }
]
const profile = computed(() => snapshot.value.profile || {}), teamOptions = computed(() => snapshot.value.teamOptions || []), leads = computed(() => snapshot.value.leads || []), effectiveMembers = computed(() => snapshot.value.effectiveMembers || []), incompleteMembers = computed(() => snapshot.value.incompleteMembers || []), rewards = computed(() => snapshot.value.rewards || []), commissions = computed(() => snapshot.value.commissions || []), offlineOrders = computed(() => snapshot.value.offlineOrders || [])
const title = computed(() => { const dict:any = { home: '推广红娘管理中心', withdraw: '余额提现', level: '分成级别', rewards: '会员注册奖励', members: '名下会员', leads: '客源线索', 'lead-form': '录入客源', report: '数据报表', commission: '消费分成', merchant: '商家联盟', mall: '优选合作商城', offline: '线下开单', finance: '财务明细', account: '我的账号' }; return dict[page.value] || '推广红娘管理中心' })
const pendingCount = computed(() => leads.value.filter((x:any)=>x.status=='待审核').length), validLeadCount = computed(() => leads.value.filter((x:any)=>x.status=='有效').length), invalidLeadCount = computed(() => leads.value.filter((x:any)=>x.status=='无效').length), maleCount = computed(() => effectiveMembers.value.filter((x:any)=>x.gender=='男').length), femaleCount = computed(() => effectiveMembers.value.length-maleCount.value)
const pendingMemberCount = computed(() => incompleteMembers.value.length)
const rejectedMemberCount = computed(() => 0)
const totalPromoted = computed(() => effectiveMembers.value.length + incompleteMembers.value.length)
const effectiveTotal = computed(() => effectiveMembers.value.length)
const nextLevel = computed(() => { for (let i = 0; i < promoterLevels.length; i++) { if (effectiveTotal.value < promoterLevels[i].threshold) return promoterLevels[i] } return null })
const nextLevelName = computed(() => nextLevel.value != null ? nextLevel.value.name : '')
const nextLevelGap = computed(() => nextLevel.value != null ? String(nextLevel.value.threshold - effectiveTotal.value) : '0')
const availableBalance = computed(() => { const amount = Number(profile.value.balance); return isNaN(amount) || amount < 0 ? '0.00' : amount.toFixed(2) })
const promoterInitial = computed(() => { const name = profile.value.nickname == null ? '' : String(profile.value.nickname).trim(); return name.length > 0 ? name.substring(0, 1) : '推' })
function listFilter(list:any[]) { const key=keyword.value.trim().toLowerCase(); return key==''?list:list.filter((x:any)=>(String(x.name||'')+String(x.id||'')+String(x.memberName||'')+String(x.memberCode||'')+String(x.phone||'')).toLowerCase().indexOf(key)>=0) }
const pickGender=()=>{leadForm.value.gender=leadForm.value.gender=='男'?'女':'男'}
const pickBirth=()=>{uni.showActionSheet({itemList:['1990-01-01','1992-06-15','1995-03-20','1998-11-08'],success:(r)=>{leadForm.value.birth=['1990-01-01','1992-06-15','1995-03-20','1998-11-08'][r.tapIndex]}})}
const pickWeight=()=>{uni.showActionSheet({itemList:['45kg','50kg','55kg','60kg','65kg'],success:(r)=>{leadForm.value.weight=['45','50','55','60','65'][r.tapIndex]}})}
const pickHeight=()=>{uni.showActionSheet({itemList:['155cm','160cm','165cm','170cm','175cm'],success:(r)=>{leadForm.value.height=['155','160','165','170','175'][r.tapIndex]}})}
const addLeadPhoto=()=>{uni.chooseImage({count:3,sizeType:['compressed'],success:(r)=>{const paths:any[]=r.tempFilePaths as any[];leadForm.value.photos=leadForm.value.photos.concat(paths).slice(0,3);showToast('已添加'+paths.length+'张照片，仅随客源信息一并提交')}})}
function isWithinDays(timeValue:any, days:number):boolean { const t = String(timeValue == null ? '' : timeValue).replace('T', ' ').replace('-', '/').replace('-', '/').replace('-', '/'); const parts = t.split(' '); const dateParts = parts.length > 0 ? parts[0].split('/') : [] as any[]; if (dateParts.length < 3) return false; const y = Number(dateParts[0]), m = Number(dateParts[1]), d = Number(dateParts[2]); if (isNaN(y) || isNaN(m) || isNaN(d)) return false; const registerMs = new Date(y, m - 1, d).getTime(); return Date.now() - registerMs <= days * 86400000 }
function isPositiveUserId(idValue:any):boolean { const n = Number(idValue); return !isNaN(n) && n > 0 }
const avatarChar=(name:any)=>{const v=name==null?'':String(name).trim();return v.length>0?v.substring(0,1):'会'}
const viewMemberHome=(item:any)=>{const memberId = Number(item.id);if(isNaN(memberId)||memberId<=0){showToast('会员主页编号待服务端同步');return};uni.navigateTo({url:'/pagesSub/userExtra/user/detail?userId='+memberId})}
const filteredLeads = computed(()=>listFilter(leads.value)), filteredRewards = computed(()=>listFilter(rewards.value)), memberRows = computed(()=>{let rows=listFilter(memberTab.value=='effective'?effectiveMembers.value:incompleteMembers.value);if(memberTab.value=='effective'&&recentOnly.value)rows=rows.filter((x:any)=>isWithinDays(x.registerAt,7));return rows})
const money=(v:any)=>{if(v==null||v==='')return '--';const n=Number(v);return isNaN(n)?'--':n.toFixed(2)}, showToast=(v:string)=>{toastMessage.value=v;toastVisible.value=true}, open=(v:string)=>{if(v=='withdraw'||v=='mall'||v=='finance'){showToast('资金与商业结算能力不在本期范围内');return};page.value=v;keyword.value='';withdrawForm.value=false;recentOnly.value=false}, goBack=()=>{if(page.value=='home')uni.navigateBack();else page.value='home'}, checkSearch=()=>{if(keyword.value.trim()=='')showToast('请输入搜索关键词')}, updateLead=(key:string,value:string)=>{leadForm.value[key]=value}
const copyLink=async()=>{if(profile.value.promotionCode){uni.setClipboardData({data:String(profile.value.promotionCode),success:()=>showToast('推广码已复制')});return};const r=await createPromoterPromotionCode();if(!r.success||r.data==null){showToast(r.message||'推广码生成失败');return};uni.setClipboardData({data:String(r.data.code),success:()=>showToast('推广码已复制')});await load()}, savePoster=()=>showToast('专属推广海报待平台配置后开放')
const selectTeam=async(team:any)=>{selectedTeamId.value=String(team.id)}
const applyTeamSearch=()=>{if(teamSearch.value.trim()==''){showToast('请输入团队关键词');return};teamSearchApplied.value=teamSearch.value.trim()}
const openTeamEntry=()=>{if(profile.value.teamName!=null&&String(profile.value.teamName)!=''){teamChangeTipVisible.value=true;return};teamSearch.value='';teamSearchApplied.value='';selectedTeamId.value=null;teamPickerVisible.value=true}
const joinSelectedTeam=()=>{if(selectedTeamId.value==null){showToast('请先选择要加入的合伙团队');return};const picked=teamOptions.value.find((t:any)=>String(t.id)==selectedTeamId.value);teamPickerVisible.value=false;if(picked!=null)showToast('已提交加入「'+picked.name+'」，等待合伙人确认');else showToast('请重新选择团队')}
const onTeamChangeAck=()=>{teamChangeTipVisible.value=false;contactVisible.value=true}
const maskedPhone=computed(()=>{const p=String(profile.value.phone||'');if(p=='')return '未绑定';if(/^1[3-9]\d{9}$/.test(p))return p.substring(0,3)+'****'+p.substring(7);return p})
const confirmLogout=async()=>{await logoutApi();try{uni.removeStorageSync('xsa_user_id')}catch(e){};showToast('已退出登录');setTimeout(()=>{uni.reLaunch({url:'/pages/auth/login'})},600)}
const filteredTeamOptions=computed(()=>{const key=teamSearchApplied.value.trim().toLowerCase();if(key=='')return teamOptions.value;return teamOptions.value.filter((t:any)=>String(t.name).toLowerCase().indexOf(key)>=0)})
const submitLead=async()=>{const form=leadForm.value;if(form.wechatSameAsPhone&&form.phone!=''&&form.wechat=='')form.wechat=form.phone;if(form.autoNickname&&form.nickname=='')form.nickname=(form.gender=='女'?'女会员':'男会员')+form.phone.slice(-4);const r=await addPromoterLead(form);if(r.success){showToast(r.message);leadForm.value={source:'',phone:'',wechat:'',wechatSameAsPhone:false,autoNickname:false,nickname:'',realName:'',gender:'男',birth:'1990-01-01',height:'',weight:'',description:'',photos:[] as any[]};await load();page.value='leads'}else showToast(r.message)}
const submitWithdraw=async()=>{const r=await createPromoterWithdrawal({amount:withdrawAmount.value,method:withdrawMethod.value,account:withdrawAccount.value,payee:withdrawPayee.value});if(r.success){showToast(r.message);withdrawForm.value=false;await load()}else showToast(r.message)}
const saveAccount=async()=>{const p=accountPhone.value.trim();if(p!=''&&!/^1[3-9]\d{9}$/.test(p)){showToast('请输入正确的11位手机号');return};const r=await updatePromoterCenterProfile({nickname:accountNickname.value.trim(),phone:p});if(r.success){snapshot.value=r.data;accountEditVisible.value=false;showToast('账号资料已保存')}else showToast(r.message)}
const load=async()=>{loading.value=true;try{const r=await getPromoterCenterSnapshot();if(r.success&&r.data!=null){snapshot.value=r.data;accountNickname.value=String(profile.value.nickname||'');accountPhone.value=String(profile.value.phone||'')}else showToast(r.message)}catch(e){showToast('网络数据加载失败')}finally{loading.value=false}}
onMounted(()=>load())
</script>

<style scoped>
.promoter-page{min-height:100vh;background:#F4F5FA;color:#282A30;display:flex;flex-direction:column}.promoter-nav{height:100rpx;background:#fff;display:flex;flex-direction:row;align-items:center;justify-content:center;font-size:34rpx;font-weight:800;flex-shrink:0}.back{position:absolute;left:22rpx;width:72rpx;height:72rpx;display:flex;align-items:center;justify-content:center}.back view{width:24rpx;height:24rpx;border-left:5rpx solid #272A30;border-bottom:5rpx solid #272A30;transform:rotate(45deg)}.menu{position:absolute;right:26rpx;width:48rpx;display:flex;flex-direction:column;gap:9rpx}.menu view{height:5rpx;border-radius:999rpx;background:#2b2d32}.scroll{flex:1;height:0}.content{padding:28rpx 28rpx calc(env(safe-area-inset-bottom) + 40rpx);display:flex;flex-direction:column;gap:26rpx}.cash-card{position:relative;min-height:210rpx;overflow:hidden;padding:34rpx 34rpx 26rpx;border-radius:32rpx;background:linear-gradient(135deg,#e3a9fc,#fac8f2);display:flex;flex-direction:row;justify-content:space-between}.cash-card:after{content:'';position:absolute;right:-45rpx;bottom:-128rpx;width:300rpx;height:300rpx;border:25rpx solid rgba(255,255,255,.17);border-radius:50%}.cash-card>view:first-child{z-index:1;display:flex;flex-direction:column;gap:10rpx;font-size:27rpx;font-weight:800}.cash-card>view:first-child text:last-child{font-size:63rpx;line-height:1}.cash-button{z-index:1;align-self:flex-start;min-width:174rpx;height:70rpx;border-radius:999rpx;background:#fff;display:flex;flex-direction:row;align-items:center;justify-content:center;color:#bb4bd0;font-size:27rpx;font-weight:800}.cash-bottom{position:absolute!important;z-index:1;left:34rpx;right:34rpx;bottom:20rpx;display:flex!important;flex-direction:row!important;justify-content:space-between;font-size:22rpx!important}.compact{min-height:170rpx}.data-card,.list-card,.summary,.level-card,.form-card{border-radius:32rpx;background:#fff;box-shadow:0 12rpx 28rpx rgba(70,70,105,.06)}.data-card{padding:28rpx}.metrics,.funds{d