/* 申请提现表单：余额行、金额区间与方式卡片对齐设计稿；底部固定确认条。 */
.withdraw-balance-line { display: flex; flex-direction: row; align-items: baseline; gap: 10rpx; color: var(--muted); font-size: 24rpx; }
