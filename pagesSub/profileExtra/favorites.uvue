<template>
	<view class="empty-page"><view class="empty-nav"><text class="ic ic-sys ic-fanhui back" @tap="back"></text><text>宣誓爱</text><view class="placeholder"></view></view><view class="tabs"><view class="tab" :class="{ active: activeTab === 0 }" @tap="activeTab = 0"><text>我的收藏({{ favorites.length }})</text><view></view></view><view class="tab" :class="{ active: activeTab === 1 }" @tap="activeTab = 1"><text>谁收藏我({{ receivedFavorites.length }})</text><view></view></view></view><scroll-view v-if="activeTab === 0 && favorites.length > 0" class="favorite-list" scroll-y><view v-for="item in favorites" :key="item.id" class="favorite-row" @tap="openUser(item.userId)"><image :src="item.avatar" class="favorite-avatar" mode="aspectFill"></image><view class="favorite-info"><text class="favorite-name">{{ item.name }}</text><text class="favorite-meta">{{ item.age }}岁 · {{ item.city }}</text></view></view></scroll-view><scroll-view v-else-if="activeTab === 1 && receivedFavorites.length > 0" class="favorite-list" scroll-y><view v-for="item in receivedFavorites" :key="item.id" class="favorite-row" @tap="openUser(item.userId)"><image :src="item.avatar" class="favorite-avatar" mode="aspectFill"></image><view class="favorite-info"><text class="favorite-name">{{ item.name }}</text><text class="favorite-meta">{{ item.age }}岁 · {{ item.city }}</text></view></view></scroll-view><view v-else class="empty-content"><text class="ic ic-home ic-search empty-icon"></text><text class="empty-copy">什么都还没有哦</text></view></view>
</template>
<script setup lang="uts">
import { getDiscoveryFavorites, getReceivedFavorites } from '@/api'
import { resolveMediaUrl } from '@/api/config.uts'
const back = () => uni.navigateBack({ delta: 1 })
const activeTab = ref(0)
const favorites = ref<any[]>([])
const receivedFavorites = ref<any[]>([])
const openUser = (id: number) => { if (id > 0) uni.navigateTo({ url: '/pagesSub/userExtra/user/detail?userId=' + id }) }
const loadFavorites = async () => {
	const res = await getDiscoveryFavorites(1, 20)
	if (!res.success || res.data == null) return
	const rows = res.data.items != null && Array.isArray(res.data.items) ? res.data.items as any[] : []
	const result: any[] = []
	for (let i = 0; i < rows.length; i++) {
		const row = rows[i]
		result.push({ id: Number(row.user_id), userId: Number(row.user_id), name: row.nickname != null ? row.nickname : '用户', age: row.age != null ? row.age : '', city: row.city_code != null ? row.city_code : '未填写', avatar: resolveMediaUrl(row.avatar) })
	}
	favorites.value = result
}
const loadReceivedFavorites = async () => {
	const res = await getReceivedFavorites(1, 20)
	if (!res.success || res.data == null) return
	receivedFavorites.value = (res.data as any).items as any[]
}
onMounted(() => { loadFavorites(); loadReceivedFavorites() })
</script>
<style scoped>
.empty-page { min-height: 100vh; background: #F7F4F0; color: #2C2C2C; }.empty-nav { height: 100px; padding: 44px 18px 0; box-sizing: border-box; display: flex; flex-direction: row; align-items: center; justify-content: space-between; background: #FFFFFF; font-size: 20px; font-weight: 800; }.back,.placeholder { width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; }.back { font-size: 38px; font-weight: 300; }.tabs { height: 56px; display: flex; flex-direction: row; background: #FFFFFF; }.tab { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; gap: 8px; color: #8E8E8A; font-size: 16px; }.tab view { width: 28px; height: 5px; border-radius: 3px; background: transparent; }.tab.active { color: #2C2C2C; font-weight: 700; }.tab.active view { background: #8FA88A; }.empty-content { display: flex; flex-direction: column; align-items: center; padding-top: 45px; color: #C5C3BE; }.empty-icon { width: 100px; height: 100px; display: flex; align-items: center; justify-content: center; background: #FFFFFF; font-size: 64px; color: #D8D2CB; }.empty-copy { margin-top: 10px; font-size: 14px; color: #B8B2AB; }
.favorite-list { height: calc(100vh - 156px); padding: 16px; box-sizing: border-box; }.favorite-row { display: flex; flex-direction: row; align-items: center; gap: 12px; padding: 12px 0; border-bottom: 1px solid #E7E3DD; }.favorite-avatar { width: 52px; height: 52px; border-radius: 26px; background: #F1ECE6; }.favorite-info { display: flex; flex-direction: column; gap: 5px; }.favorite-name { font-size: 15px; font-weight: 700; }.favorite-meta { color: #8E8E8A; font-size: 12px; }
@font-face { font-family: "iconfont-home"; src: url('/static/婚恋小程序图标/首页推荐与匹配/iconfont.woff2') format('woff2'); }
@font-face { font-family: "iconfont-sys"; src: url('/static/婚恋小程序图标/系统通用/iconfont.woff2') format('woff2'); }
.ic { font-style: normal; }.ic-home { font-family: "iconfont-home" !important; }.ic-sys { font-family: "iconfont-sys" !important; }.ic-fanhui:before { content: "\e606"; }.ic-search:before { content: "\e600"; }
.back { width: 40px; height: 40px; border-radius: 20px; background: #FFFFFF; display: flex; align-items: center; justify-content: center; font-size: 16px; color: #2C2C2C; }
</style>
