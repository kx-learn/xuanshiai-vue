<template>
	<view class="page">

		<!-- 导航栏 -->
		<view class="nav-bar">
			<view class="nav-back" @tap="goBack">
				<text class="nav-back-symbol">‹</text>
			</view>
			<text class="nav-title">我的动态</text>
			<view class="nav-spacer"></view>
		</view>

		<!-- 内容区 -->
		<scroll-view
			scroll-y
			class="content-scroll"
			enhanced
			show-scrollbar="false"
			@scrolltolower="onLoadMore"
			:refresher-enabled="true"
			:refresher-triggered="refreshing"
			@refresherrefresh="onRefresh"
		>
			<!-- 个人头部区域 -->
			<view class="profile-header">
				<!-- 背景墙 -->
				<image v-if="profile.cover != ''" class="cover-bg" :src="profile.cover" mode="aspectFill"></image>
				<view class="cover-scrim"></view>

				<!-- 头像（悬浮在背景墙下方） -->
				<view class="avatar-circle">
					<image v-if="profile.avatar != ''" class="avatar-img" :src="profile.avatar" mode="aspectFill"></image>
				</view>

				<!-- 信息卡片 -->
				<view class="info-card">
					<!-- 昵称 -->
					<text class="nickname">{{ profile.nickname }}</text>

					<!-- 统计数据行 -->
					<view class="stats-row">
						<view class="stat-item">
							<text class="stat-value">{{ profile.postCount }}</text>
							<text class="stat-label">动态</text>
						</view>
						<view class="stat-item">
							<text class="stat-value">{{ profile.likeCount }}</text>
							<text class="stat-label">获赞</text>
						</view>
						<view class="stat-item">
							<text class="stat-value">{{ profile.followingCount }}</text>
							<text class="stat-label">关注</text>
						</view>
					</view>

					<!-- 发布动态入口 -->
					<view class="publish-prompt" @tap="goPublish">
						<text class="publish-icon">✏️</text>
						<text class="publish-text">分享你的生活点滴…</text>
						<view class="publish-btn">
							<text class="publish-btn-text">发布</text>
						</view>
					</view>
				</view>
			</view>

			<!-- 加载中 -->
			<view v-if="loading && feedList.length === 0" class="state-wrap">
				<text class="state-text">加载中…</text>
			</view>

			<!-- 空状态 -->
			<view v-else-if="!loading && loadError != ''" class="state-wrap">
				<text class="state-title">动态加载失败</text>
				<text class="state-desc">{{ loadError }}</text>
				<view class="state-btn" @tap="reloadAll"><text class="state-btn-text">重新加载</text></view>
			</view>
			<view v-else-if="!loading && feedList.length === 0" class="state-wrap">
				<text class="state-emoji">📝</text>
				<text class="state-title">还没有动态</text>
				<text class="state-desc">去社区发布你的第一条动态吧</text>
				<view class="state-btn" @tap="goPublish">
					<text class="state-btn-text">去发布</text>
				</view>
			</view>

			<!-- 动态列表 -->
			<view v-else class="feed-list">
				<view class="feed-card" v-for="(feed, fi) in feedList" :key="fi" @tap="goPostDetail(feed.id)">
					<!-- 卡片头部：头像 + 用户信息 -->
					<view class="feed-card-header">
						<image
							class="feed-card-avatar"
							:src="feed.user != null ? feed.user.avatar : ''"
							mode="aspectFill"
						></image>
						<view class="feed-card-user-col">
							<text class="feed-card-name">{{ feed.user != null ? feed.user.name : '' }}</text>
							<text class="feed-card-meta">{{ feed.timeText }} · {{ feed.location || feed.city || '' }}</text>
						</view>
					</view>

					<!-- 正文 -->
					<text class="feed-card-content">{{ feed.content }}</text>

					<!-- 图片 -->
					<view class="feed-card-photos" v-if="feed.photos != null && feed.photos.length > 0">
						<image
							v-for="(photo, pi) in feed.photos"
							:key="pi"
							class="feed-photo"
							:class="feed.photos.length === 1 ? 'feed-photo-single' : 'feed-photo-double'"
							:src="photo"
							mode="aspectFill"
						></image>
					</view>

					<!-- 标签 -->
					<view class="feed-card-tags" v-if="feed.tags != null && feed.tags.length > 0">
						<text class="feed-tag" v-for="(tag, ti) in feed.tags" :key="ti">{{ tag }}</text>
					</view>

					<!-- 话题 -->
					<view class="feed-card-topic" v-if="feed.topicTitle != null && feed.topicTitle != ''" @tap.stop="goTopicDetail(feed.topicId)">
						<text class="feed-topic-text">{{ feed.topicTitle }}</text>
					</view>

					<view class="feed-card-divider"></view>

					<!-- 底部操作栏 -->
					<view class="feed-card-footer">
						<text class="feed-date">{{ feed.location || feed.city || '' }}</text>
						<view class="feed-actions">
							<view class="feed-action" @tap.stop="onLike(feed, fi)">
								<text class="ic ic-social feed-action-icon" :class="{ liked: feed.liked }">{{ likeIcon }}</text>
								<text class="feed-action-count">{{ feed.likeCount }}</text>
							</view>
							<view class="feed-action" @tap.stop="goPostDetail(feed.id)">
								<text class="ic ic-social feed-action-icon">{{ commentIcon }}</text>
								<text class="feed-action-count">{{ feed.commentCount }}</text>
							</view>
							<view class="feed-action" @tap.stop="onDelete(feed, fi)">
								<text class="ic ic-me ic-shezhi feed-action-icon feed-action-delete"></text>
							</view>
						</view>
					</view>
				</view>

				<!-- 加载更多 -->
				<view v-if="loadingMore" class="load-more">
					<text class="load-more-text">加载中…</text>
				</view>
				<view v-else-if="!hasMore && feedList.length > 0" class="load-more">
					<text class="load-more-text">— 没有更多了 —</text>
				</view>

				<!-- 底部留白 -->
				<view class="scroll-bottom-spacer"></view>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
import { getMyPosts, getOwnProfile, getProfileOverview, likeDynamic, deleteDynamic } from '@/api'
import { resolveMediaUrl } from '@/api/config.uts'
import { guardCommunityVerification } from '@/utils/realNameGate.uts'

// 个人资料数据
const profile = ref({
	nickname: '',
	postCount: 0,
	likeCount: 0,
	followingCount: 0,
	avatar: '',
	cover: ''
})

const feedList = ref<any[]>([])
const loading = ref(true)
const loadingMore = ref(false)
const refreshing = ref(false)
const page = ref(1)
const pageSize = 10
const hasMore = ref(true)
const total = ref(0)
const loadError = ref('')
const hasLoadedOnce = ref(false)
const likeIcon = String.fromCharCode(0xec8c)
const commentIcon = String.fromCharCode(0xe679)

const loadProfile = async () => {
	const profileRes = await getOwnProfile()
	if (profileRes.success && profileRes.data != null) {
		const data = profileRes.data as any
		profile.value.nickname = data.nickname != null ? '' + data.nickname : ''
		profile.value.avatar = resolveMediaUrl(data.avatar)
		profile.value.cover = resolveMediaUrl(data.background_wall)
		if (profile.value.cover == '' && data.photos != null && Array.isArray(data.photos) && data.photos.length > 0) {
			const first = data.photos[0] as any
			profile.value.cover = resolveMediaUrl(first.file_url != null ? first.file_url : first.url)
		}
	}
	const overviewRes = await getProfileOverview()
	if (overviewRes.success && overviewRes.data != null) {
		const overview = overviewRes.data as any
		const likeValue = overview.like_count != null
			? overview.like_count
			: (overview.received_like_count != null ? overview.received_like_count : overview.community_like_count)
		const followingValue = overview.following_count != null
			? overview.following_count
			: (overview.following_user_count != null ? overview.following_user_count : overview.follow_count)
		if (likeValue != null) profile.value.likeCount = Number(likeValue)
		if (followingValue != null) profile.value.followingCount = Number(followingValue)
	}
}

// ========== 数据加载 ==========

const fetchData = async (isRefresh: boolean = false) => {
	if (isRefresh) {
		page.value = 1
		hasMore.value = true
	}
	try {
		if (isRefresh) loadError.value = ''
		const res = await getMyPosts({ page: page.value, pageSize })
		if (res.success && res.data != null) {
			const data = res.data as any
			const list = data.list != null ? (data.list as any[]) : []
			if (isRefresh || page.value === 1) {
				feedList.value = list
			} else {
				const current = feedList.value as any[]
				for (let i = 0; i < list.length; i++) {
					current.push(list[i])
				}
				feedList.value = current
			}
			hasMore.value = data.hasMore == true
			total.value = data.total != null ? (data.total as number) : 0
			profile.value.postCount = total.value
			if (profile.value.likeCount == 0 && list.length > 0) {
				let likes = 0
				for (let i = 0; i < list.length; i++) likes += Number(list[i].likeCount || 0)
				profile.value.likeCount = likes
			}
		} else {
			loadError.value = res.message != null ? '' + res.message : '请稍后重试'
		}
	} catch (e) {
		console.error('获取我的动态失败', e)
		if (isRefresh || page.value === 1) {
			feedList.value = []
			loadError.value = '网络异常，请稍后重试'
		}
	} finally {
		loading.value = false
		loadingMore.value = false
		refreshing.value = false
	}
}

const onRefresh = () => {
	refreshing.value = true
	fetchData(true)
}

const reloadAll = async () => {
	loading.value = true
	await loadProfile()
	await fetchData(true)
}

const onLoadMore = () => {
	if (loadingMore.value || !hasMore.value) return
	loadingMore.value = true
	page.value += 1
	fetchData(false)
}

// ========== 交互 ==========

const goBack = () => {
	uni.navigateBack({})
}

const goPublish = async () => {
	// 发布动态要求实名 + 人脸
	const ok = await guardCommunityVerification()
	if (!ok) return
	uni.navigateTo({ url: '/pagesSub/community/publish' })
}

const goPostDetail = (postId: number) => {
	uni.navigateTo({ url: '/pagesSub/community/post-detail?id=' + postId })
}

const goTopicDetail = (topicId: number) => {
	if (topicId > 0) {
		uni.navigateTo({ url: '/pagesSub/community/topic-detail?topicId=' + topicId })
	}
}

const onLike = async (feed: any, index: number) => {
	try {
		const res = await likeDynamic(feed.id as number)
		if (res.success && res.data != null) {
			const data = res.data as any
			const list = feedList.value as any[]
			list[index].liked = data.liked == true
			list[index].likeCount = data.likeCount != null ? (data.likeCount as number) : (list[index].likeCount as number)
			feedList.value = list.slice()
		} else {
			uni.showToast({ title: res.message != null ? '' + res.message : '点赞失败，请重试', icon: 'none' })
		}
	} catch (e) {
		console.error('点赞失败', e)
	}
}

const onDelete = (feed: any, index: number) => {
	uni.showModal({
		title: '删除动态',
		content: '确定要删除这条动态吗？',
		confirmText: '删除',
		confirmColor: '#E56262',
		cancelText: '取消',
		success: async (res: any) => {
			if (res.confirm) {
				try {
					const delRes = await deleteDynamic(feed.id as number)
					if (delRes.success) {
						const list = feedList.value as any[]
						list.splice(index, 1)
						feedList.value = list.slice()
						total.value = Math.max(0, total.value - 1)
						profile.value.postCount = total.value
						uni.showToast({ title: '已删除', icon: 'success' })
					} else {
						uni.showToast({ title: delRes.message != null ? '' + delRes.message : '删除失败，请重试', icon: 'none' })
					}
				} catch (e) {
					console.error('删除动态失败', e)
					uni.showToast({ title: '删除失败，请重试', icon: 'none' })
				}
			}
		}
	})
}

// ========== 生命周期 ==========
onMounted(async () => {
	await loadProfile()
	await fetchData(true)
	hasLoadedOnce.value = true
})

onShow(async () => {
	if (!hasLoadedOnce.value) return
	await loadProfile()
	await fetchData(true)
})
</script>

<style scoped>
