		--primary-dark: #854B35;
		--warm-gold: #C29F68;
		--surface: #FFFFFF;
		--surface-warm: #FAF7F2;
		--line: #E8E2D8;
		--border-card: #D8D2C7;
		--ink: #23201E;
		--ink2: #6C665F;
		--muted: #9E978E;
		--text-invert: #FFFFFF;
	}

	.mpr-nav {
		position: sticky;
		top: 0;
		z-index: 100;
		box-sizing: content-box;
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		padding-left: 10px;
		padding-bottom: 8px;
		background: var(--canvas);
		border-bottom: 1px solid rgba(232, 226, 216, 0.7);
	}

	.mpr-nav-side {
		z-index: 1;
		min-width: 44px;
		height: 40px;
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: flex-end;
	}

	.mpr-nav-back {
		justify-content: flex-start;
	}

	.mpr-nav-back-text {
		font-size: 28px;
		color: #23201E;
		padding: 0 8px;
		line-height: 1;
	}

	.mpr-nav-title {
		position: absolute;
		left: 0;
		right: 0;
		height: 40px;
		line-height: 40px;
		text-align: center;
		font-size: 17px;
		font-weight: 700;
		color: #23201E;
		pointer-events: none;
		z-index: 1;
	}

	.mpr-state {
		padding: 80px 24px 48px;
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.mpr-loading-dot {
		width: 14px;
		height: 14px;
		border-radius: 999px;
		background: #9C5B42;
		margin-bottom: 16px;
		box-shadow: 0 2px 8px rgba(156, 91, 66, 0.3);
	}

	.mpr-state-title {
		font-size: 18px;
		color: #23201E;
		font-weight: 700;
		text-align: center;
	}

	.mpr-state-copy {
		font-size: 13px;
		color: #6C665F;
		line-height: 1.65;
		text-align: center;
		margin-top: 10px;
		max-width: 320px;
	}

	.mpr-fail {
		color: #C04A2B;
	}

	.mpr-scroll {
		height: calc(100vh - 48px);
	}

	.mpr-body {
		padding: 16px 16px 48px;
	}

	.mpr-paper {
		background: #FFFFFF;
		padding: 24px 18px;
		border: 1px solid #E8E2D8;
		border-radius: 16px;
		box-shadow: 0 4px 16px rgba(156, 91, 66, 0.05);
	}

	.mpr-kicker {
		display: inline-block;
		align-self: center;
		font-size: 11px;
		color: #9C5B42;
		background-color: #F5EAE4;
		padding: 3px 10px;
		border-radius: 6px;
		font-weight: 600;
		letter-spacing: 0.04em;
		text-align: center;
		margin: 0 auto;
	}

	.mpr-title {
		display: block;
		margin-top: 14px;
		font-size: 22px;
		color: #23201E;
		font-weight: 700;
		text-align: center;
		line-height: 1.35;
	}

	.mpr-preview-content {
		display: block;
		margin-top: 16px;
		font-size: 15px;
		color: #23201E;
		line-height: 1.75;
		white-space: pre-wrap;
	}

	.mpr-tags {
		display: flex;
		flex-direction: row;
		flex-wrap: wrap;
		justify-content: center;
		gap: 8px;
		margin-top: 14px;
	}

	.mpr-tag {
		padding: 4px 12px;
		border-radius: 20px;
		background: #FAF7F2;
		border: 1px solid #E8E2D8;
