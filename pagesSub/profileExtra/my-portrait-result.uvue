	.mpr-card-mask { position: fixed; z-index: 120; inset: 0; display: flex; align-items: flex-end; background: rgba(12, 19, 19, 0.36); }
	.mpr-card-sheet { width: 100%; height: 82vh; box-sizing: border-box; padding: 22px 18px calc(22px + env(safe-area-inset-bottom)); border-radius: 20px 20px 0 0; background: var(--surface); display: flex; flex-direction: column; gap: 12px; }
	.mpr-card-title { flex-shrink: 0; color: var(--ink); font-size: 20px; font-weight: 700; }
	.mpr-card-scroll { flex: 1; height: 0; min-height: 0; width: 100%; }
	.mpr-card-content { display: flex; flex-direction: column; gap: 12px; padding-bottom: 12px; }
	.mpr-card-copy, .mpr-card-row-value { color: var(--ink2); font-size: 13px; line-height: 1.55; }
	.mpr-card-state { display: flex; flex-direction: column; gap: 12px; padding: 18px 0; color: var(--ink2); font-size: 14px; }
	.mpr-card-boundary { margin-top: 4px; }
	.mpr-card-limit { display: block; margin-top: 6px; color: var(--primary-dark); font-size: 12px; line-height: 1.5; }
	.mpr-card-replace { display: flex; flex-direction: column; gap: 8px; margin-top: 8px; padding: 8px; box-sizing: border-box; border-radius: 8px; background: var(--surface-warm); color: var(--ink2); font-size: 12px; }
	.mpr-card-replace-value { color: var(--primary); font-weight: 700; }
	.mpr-card-row { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; padding: 12px 0; border-bottom: 1px solid var(--line); }
	.mpr-card-limit, .mpr-card-replace { width: 100%; }
	.mpr-card-row-copy { flex: 1; display: flex; flex-direction: column; gap: 4px; }
	.mpr-card-row-label { color: var(--ink); font-size: 14px; font-weight: 700; }
	.mpr-card-row-toggle { min-height: 44px; display: flex; align-items: center; color: var(--primary); font-size: 13px; font-weight: 700; }
	.mpr-card-editor { width: 100%; min-height: 100px; padding: 8px; box-sizing: border-box; border-radius: 8px; background: var(--surface-warm); color: var(--ink2); font-size: 14px; line-height: 1.6; }
	.mpr-card-tags { width: 100%; display: flex; flex-wrap: wrap; gap: 8px; }
	.mpr-card-tag { min-height: 44px; box-sizing: border-box; display: flex; align-items: center; padding: 6px 10px; border-radius: 12px; background: var(--surface-warm); color: var(--ink2); font-size: 13px; }
	.mpr-card-tag-selected { color: var(--primary); border: 1px solid var(--primary); }
	.mpr-card-actions { flex-shrink: 0; display: flex; gap: 10px; margin-top: 4px; }
	.mpr-card-actions .mpr-btn { flex: 1; min-width: 0; }
	.mpr-field-row { padding: 14px 0; border-bottom: 1px solid var(--line); }
	.mpr-field-editor { width: 100%; box-sizing: border-box; min-height: 88px; padding: 12px; margin-top: 10px; color: var(--ink); background: var(--surface-warm); border: 1px solid var(--line); border-radius: 10px; font-size: 14px; line-height: 1.6; }
	.mpr-field-change { display: block; color: var(--primary); font-size: 12px; line-height: 1.6; margin-top: 8px; }
	.mpr-field-remove { display: flex; align-items: center; min-height: 44px; color: var(--primary); font-size: 13px; }
	.mpr-boundary-warning, .mpr-review-notice { display: block; padding: 12px; margin-top: 14px; background: var(--surface-warm); border-radius: 10px; color: var(--primary-dark); font-size: 13px; line-height: 1.6; text-align: left; }
	.mpr-body { padding-bottom: calc(48px + env(safe-area-inset-bottom)); }
	.mpr-nav-side { min-height: 44px; }
</style>
