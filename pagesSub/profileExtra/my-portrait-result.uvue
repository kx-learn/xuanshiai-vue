	.mpr-btn-text {
		font-size: 14px;
		color: #23201E;
		font-weight: 600;
	}

	.mpr-btn-primary-text {
		font-size: 14px;
		color: #FFFFFF;
		font-weight: 700;
	}

	.mpr-btn-ghost .mpr-btn-text {
		color: #6C665F;
		font-weight: 500;
	}

	.mpr-hint {
		display: block;
		margin-top: 16px;
		font-size: 12px;
		color: #9E978E;
		line-height: 1.6;
		text-align: center;
		padding: 0 12px;
	}

	.mpr-emotional-insight {
		padding: 16px 14px;
		border: 1px solid #E8E2D8;
