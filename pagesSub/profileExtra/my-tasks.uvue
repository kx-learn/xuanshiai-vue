.invite-share-mask { position: fixed; z-index: 30; left: 0; right: 0; top: 0; bottom: 0; display: flex; flex-direction: column; justify-content: flex-end; background-color: rgba(12, 19, 19, 0.68); }
.invite-share-sheet { align-self: stretch; width: 100%; padding: 24rpx 32rpx 26rpx; display: flex; flex-direction: column; border-radius: 28rpx 28rpx 0 0; background-color: #EDF1EC; }
.invite-share-handle { width: 64rpx; height: 6rpx; margin: 0 auto 32rpx; border-radius: 999rpx; background-color: #D7DDD5; }
.invite-share-title { margin-bottom: 28rpx; color: #1A1A1A; font-size: 30rpx; font-weight: 600; }
.invite-share-options { display: flex; flex-direction: row; gap: 24rpx; }
.invite-share-option { flex: 1; height: 220rpx; padding: 20rpx 8rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; border: 1px solid #B9CFB5; border-radius: 24rpx; background-color: #F8FAF7; }
.invite-share-option + .invite-share-option { border-color: #D5B477; background-color: #FCF8EF; }
.invite-share-option-icon { width: 72rpx; height: 72rpx; margin-bottom: 20rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; font-size: 34rpx; }
.invite-share-option-icon-green { color: #627A5F; background-color: #E2EBE0; }
