.quantity-button { width: 56rpx; height: 56rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; font-size: 32rpx; }
.quantity-minus { color: var(--task-green-deep); background-color: var(--task-sage); }
.quantity-plus { color: var(--task-paper); background-color: var(--task-green); }
