	height: 100vh;
	display: flex;
	flex-direction: column;
	background-color: #EDF1EC;
	color: #1A1A1A;
	--task-bg: #EDF1EC;
	--task-paper: #FFFFFF;
	--task-card: #F8F9F6;
	--task-text: #1A1A1A;
	--task-secondary: #4B5563;
	--task-muted: #9CA3AF;
	--task-sage: #E2EBE0;
	--task-green: #A8C0A5;
	--task-green-deep: #627A5F;
	--task-green-light: #EDF4EC;
	--task-border: #E8EAE4;
	--task-gold-light: #F7F1E5;
	--task-gold: #C9A96E;
	--task-gold-text: #B8944A;
}
.top-bar { position: relative; flex-shrink: 0; display: flex; flex-direction: row; align-items: center; justify-content: center; padding-left: 32rpx; padding-right: 32rpx; box-sizing: border-box; background-color: var(--task-paper); }
.top-back { position: absolute; left: 32rpx; width: 56rpx; font-size: 36rpx; color: var(--task-text); }
.top-title { color: var(--task-text); font-size: 34rpx; font-weight: 500; }
.content-scroll { flex: 1; min-height: 0; box-sizing: border-box; background-color: var(--task-bg); }
.points-section, .checkin-section { padding: 28rpx 32rpx 0; }
.points-card { display: flex; flex-direction: column; align-items: center; gap: 20rpx; padding: 36rpx 36rpx 28rpx; border-radius: 32rpx; background: linear-gradient(135deg, #E8EDE4 0%, #DCE5D6 60%, #F0EBE0 100%); }
.points-display { display: flex; flex-direction: column; align-items: center; gap: 4rpx; }
.points-label { color: var(--task-secondary); font-size: 26rpx; font-weight: 400; }
.points-value { color: var(--task-text); font-family: var(--serif); font-size: 72rpx; line-height: 1.1; font-weight: 700; }
.points-actions { display: flex; flex-direction: row; align-items: center; justify-content: center; gap: 24rpx; }
.outline-pill { padding: 20rpx 36rpx; border: 1px solid var(--task-green); border-radius: 9999rpx; color: var(--task-green-deep); background-color: var(--task-sage); font-size: 26rpx; font-weight: 500; }
.points-note { color: var(--task-muted); font-size: 24rpx; font-weight: 400; }
.section-heading { display: flex; flex-direction: row; align-items: center; justify-content: space-between; margin-bottom: 24rpx; }
.section-title { color: var(--task-text); font-size: 32rpx; font-weight: 600; }
.streak-badge { display: flex; flex-direction: row; align-items: center; gap: 8rpx; padding: 12rpx 24rpx; border-radius: 9999rpx; color: var(--task-gold-text); background-color: var(--task-gold-light); font-size: 24rpx; font-weight: 500; }
.daily-draw-card { min-height: 260rpx; padding: 36rpx 28rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10rpx; border: 1px solid var(--task-border); border-radius: 24rpx; box-sizing: border-box; text-align: center; background-color: var(--task-paper); }
.daily-draw-card-done { background-color: var(--task-card); }
.draw-card-label { color: var(--task-green-deep); font-size: 20rpx; font-weight: 700; }
.draw-card-number { color: var(--task-gold-text); font-family: var(--serif); font-size: 42rpx; font-weight: 700; line-height: 1.1; }
.draw-card-message { color: var(--task-text); font-family: var(--serif); font-size: 28rpx; font-weight: 700; line-height: 1.45; }
.draw-card-action { margin-top: 6rpx; color: var(--task-green-deep); font-size: 22rpx; font-weight: 700; }
.earn-section { display: flex; flex-direction: column; gap: 24rpx; padding: 24rpx 32rpx 0; }
.earn-card { display: flex; flex-direction: row; align-items: center; padding: 32rpx; border: 1px solid var(--task-border); border-radius: 24rpx; background-color: var(--task-card); box-shadow: 0 2px 10px rgba(36, 55, 40, 0.04); }
.earn-icon { width: 80rpx; height: 80rpx; margin-right: 24rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; color: var(--task-green-deep); background-color: var(--task-sage); font-size: 40rpx; }
.earn-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4rpx; }
.earn-title { color: var(--task-text); font-size: 28rpx; font-weight: 400; }
.earn-desc { color: var(--task-muted); font-size: 24rpx; line-height: 1.6; font-weight: 400; }
.small-action { padding: 16rpx 32rpx; border-radius: 9999rpx; color: var(--task-green-deep); background-color: var(--task-green-light); font-size: 26rpx; font-weight: 500; white-space: nowrap; }
.small-action-done { color: var(--task-muted); background-color: var(--task-sage); }
.usage-section { display: flex; flex-direction: column; gap: 16rpx; padding: 32rpx 40rpx 48rpx; }
.usage-title { color: var(--task-muted); font-size: 26rpx; font-weight: 600; }
.usage-line { color: var(--task-muted); font-size: 24rpx; line-height: 1.6; font-weight: 400; }
.bottom-space { height: 48rpx; }
.sheet-mask { position: fixed; z-index: 20; left: 0; right: 0; top: 0; bottom: 0; display: flex; flex-direction: column; justify-content: flex-end; background-color: rgba(26, 35, 29, 0.42); }
.bottom-sheet { display: flex; flex-direction: column; padding: 24rpx 32rpx 32rpx; border-radius: 24rpx 24rpx 0 0; background-color: var(--task-bg); }
.sheet-handle { width: 72rpx; height: 8rpx; margin: 0 auto 28rpx; border-radius: 9999rpx; background-color: #D7DDD5; }
.sheet-title { margin-bottom: 28rpx; color: var(--task-text); font-size: 32rpx; font-weight: 600; }
.package-grid { display: flex; flex-direction: row; flex-wrap: wrap; gap: 16rpx; }
.package-item { width: calc((100% - 32rpx) / 3); padding: 24rpx 8rpx; display: flex; flex-direction: column; align-items: center; border: 1px solid transparent; border-radius: 16rpx; background-color: var(--task-card); }
.package-selected { border-color: var(--task-green); background-color: var(--task-paper); }
.package-points { color: var(--task-text); font-family: var(--serif); font-size: 28rpx; font-weight: 700; }
.package-unit { color: var(--task-muted); font-size: 22rpx; }
.package-price { margin-top: 8rpx; color: var(--task-gold-text); font-size: 24rpx; }
.payment-title { margin-top: 28rpx; color: var(--task-muted); font-size: 24rpx; }
.payment-row { height: 64rpx; margin-top: 12rpx; display: flex; flex-direction: row; align-items: center; gap: 12rpx; padding: 0 24rpx; border: 1px solid var(--task-green); border-radius: 16rpx; color: var(--task-secondary); font-size: 24rpx; }
.payment-check { color: var(--task-green-deep); font-size: 26rpx; }
.sheet-primary-button { min-height: 72rpx; margin-top: 24rpx; display: flex; align-items: center; justify-content: center; border-radius: 16rpx; color: var(--task-text); background: linear-gradient(90deg, #D4E4D0 0%, #BCD4B6 100%); font-size: 26rpx; font-weight: 600; }
.exchange-balance { display: flex; flex-direction: row; justify-content: center; align-items: center; color: var(--task-muted); font-size: 24rpx; }
.balance-value { color: var(--task-text); font-weight: 700; }
.exchange-options { display: flex; flex-direction: row; gap: 16rpx; margin-top: 24rpx; }
.exchange-option { flex: 1; display: flex; flex-direction: column; align-items: center; padding: 24rpx 8rpx; border: 1px solid transparent; border-radius: 16rpx; background-color: var(--task-card); }
