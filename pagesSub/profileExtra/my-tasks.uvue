.invite-share-note { margin: 28rpx 4rpx 24rpx; color: #9CA3AF; font-size: 20rpx; line-height: 1.5; text-align: center; }
.invite-share-cancel { height: 72rpx; display: flex; align-items: center; justify-content: center; border-radius: 36rpx; background-color: rgba(255, 255, 255, 0.22); color: #627A5F; font-size: 24rpx; }
</style>
