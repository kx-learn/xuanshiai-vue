<template>
	<view class="page">
		<view class="top-bar" :style="{ paddingTop: (statusBarHeight + topBarOffset) + 'px', height: (statusBarHeight + 44 + topBarOffset) + 'px' }">
			<view class="top-back" @tap="goBack"><text>←</text></view>
			<text class="top-title">我的任务</text>
		</view>

		<scroll-view scroll-y class="content-scroll" show-scrollbar="false">
			<view class="points-section">
				<view class="points-card">
					<view class="points-display">
						<text class="points-label">当前积分</text>
						<text class="points-value">{{ pointsText }}</text>
					</view>
					<view class="points-actions">
						<view class="outline-pill" @tap="openPurchase"><text>购买积分</text></view>
						<view class="outline-pill" @tap="openExchange"><text>兑换</text></view>
					</view>
					<text class="points-note">积分是平台通用虚拟货币，可兑换各类功能次数</text>
				</view>
			</view>

			<view class="checkin-section">
				<view class="section-heading">
					<text class="section-title">每日抽签</text>
					<view class="streak-badge"><text>🔥</text><text>已连续签到 {{ streakDays }} 天</text></view>
				</view>
				<view class="daily-draw-card" :class="checkInDone ? 'daily-draw-card-done' : ''" @tap="drawCheckIn">
					<text class="draw-card-label">DAILY BLESSING</text>
					<text class="draw-card-number">{{ drawResult != null ? drawResult.number : '—' }}</text>
					<text class="draw-card-message">{{ drawResult != null ? drawResult.message : '轻触翻开今天的祝福' }}</text>
					<text class="draw-card-action">{{ checkInDone ? '今日祝福已收下 · 积分 +10' : '轻触抽签，领取今日祝福' }}</text>
				</view>
			</view>

			<view class="earn-section">
				<text class="section-title">积分获取</text>
				<view class="earn-card">
					<view class="earn-icon"><text>📅</text></view>
					<view class="earn-copy"><text class="earn-title">每日抽签领积分</text><text class="earn-desc">每天抽一支签，收下一句温柔祝福</text></view>
					<view class="small-action" :class="checkInDone ? 'small-action-done' : ''" @tap="drawCheckIn"><text>{{ checkInDone ? '已抽签' : '抽签领积分' }}</text></view>
				</view>
				<view class="earn-card">
					<view class="earn-icon"><text>👥</text></view>
					<view class="earn-copy"><text class="earn-title">邀请好友赚积分</text><text class="earn-desc">每成功邀请1位好友注册，双方各得50积分</text></view>
					<view class="small-action" @tap="openInvite"><text>立即邀请</text></view>
				</view>
			</view>

			<view class="usage-section">
				<text class="usage-title">积分使用范围</text>
				<text class="usage-line">• 可兑换申请认识次数、纸飞机</text>
				<text class="usage-line">• 可解锁筛选后他人名片</text>
				<text class="usage-line">• 免费查看名片额度耗尽后可通过积分兑换次数</text>
			</view>
			<view class="bottom-space"></view>
		</scroll-view>

		<view v-if="activeSheet === 'purchase'" class="sheet-mask" @tap="closeSheet">
			<view class="bottom-sheet" @tap.stop>
				<view class="sheet-handle"></view>
				<text class="sheet-title">购买积分</text>
				<view class="package-grid">
					<view v-for="(item, index) in purchasePackages" :key="item.points" class="package-item" :class="selectedPackage === index ? 'package-selected' : ''" @tap="selectPackage(index)">
						<text class="package-points">{{ item.pointsText }}</text>
						<text class="package-unit">积分</text>
						<text class="package-price">¥{{ item.price }}</text>
					</view>
				</view>
				<text class="payment-title">支付方式</text>
				<view class="payment-row"><text class="payment-check">☑</text><text>微信支付</text></view>
				<view class="sheet-primary-button" @tap="confirmPurchase"><text>确认充值</text></view>
			</view>
		</view>

		<view v-if="activeSheet === 'exchange'" class="sheet-mask" @tap="closeSheet">
			<view class="bottom-sheet exchange-sheet" @tap.stop>
				<view class="sheet-handle"></view>
				<text class="sheet-title">积分兑换</text>
				<view class="exchange-balance"><text>当前积分：</text><text class="balance-value">{{ pointsText }} 积分</text></view>
				<view class="exchange-options">
					<view v-for="(item, index) in exchangeItems" :key="item.key" class="exchange-option" :class="selectedExchangeItem === index ? 'exchange-selected' : ''" @tap="selectExchangeItem(index)">
						<text class="exchange-name">{{ item.name }}</text>
						<text class="exchange-cost">{{ item.cost }} 积分/次</text>
					</view>
				</view>
				<view class="quantity-card">
					<text class="quantity-label">兑换数量</text>
					<view class="quantity-row">
						<view class="quantity-button quantity-minus" @tap="decreaseExchange"><text>−</text></view>
						<text class="quantity-value">{{ exchangeQuantity }}</text>
						<view class="quantity-button quantity-plus" @tap="increaseExchange"><text>＋</text></view>
					</view>
				</view>
				<view class="cost-row"><text>共需</text><text class="cost-value">{{ exchangeCost }} 积分</text></view>
				<view class="sheet-primary-button" @tap="confirmExchange"><text>立即兑换</text></view>
			</view>
		</view>

		<view v-if="activeSheet === 'invite'" class="invite-share-mask" @tap="closeSheet">
			<view class="invite-share-sheet" @tap.stop>
				<view class="invite-share-handle"></view>
				<text class="invite-share-title">分享邀请好友</text>
				<view class="invite-share-options">
					<view class="invite-share-option" @tap="shareToWechat">
						<view class="invite-share-option-icon invite-share-option-icon-green"><text class="invite-share-symbol">↗</text></view>
						<text class="invite-share-option-label">发送给朋友</text>
					</view>
					<view class="invite-share-option" @tap="goMyPosters">
						<view class="invite-share-option-icon invite-share-option-icon-gold"><text class="invite-share-symbol">▧</text></view>
						<text class="invite-share-option-label">生成海报</text>
					</view>
				</view>
				<text class="invite-share-note">好友通过你的分享卡片/海报完成注册后，邀请人和新好友双方均可获得平台积分，分享可兑现奖励。</text>
				<view class="invite-share-cancel" @tap="closeSheet"><text>取消</text></view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
type PurchasePackage = { points: number; pointsText: string; price: number }
type ExchangeItem = { key: string; name: string; cost: number }
type DrawBlessing = { number: string; title: string; message: string }

const points = ref(1280)
const systemInfo = uni.getSystemInfoSync()
const statusBarHeight = systemInfo.statusBarHeight != null ? systemInfo.statusBarHeight : 20
const topBarOffset = 16
const checkedDays = ref<number[]>([1, 2, 3])
const activeSheet = ref('')
const selectedPackage = ref(0)
const selectedExchangeItem = ref(0)
const exchangeQuantity = ref(1)
const drawResult = ref(null as DrawBlessing | null)

const purchasePackages: PurchasePackage[] = [
	{ points: 100, pointsText: '100', price: 6 },
	{ points: 300, pointsText: '300', price: 18 },
	{ points: 500, pointsText: '500', price: 28 },
	{ points: 1000, pointsText: '1,000', price: 58 },
	{ points: 3000, pointsText: '3,000', price: 168 },
	{ points: 5000, pointsText: '5,000', price: 268 }
]
const exchangeItems: ExchangeItem[] = [
	{ key: 'apply', name: '申请认识次数', cost: 50 },
	{ key: 'plane_catch', name: '捡纸飞机次数', cost: 50 },
	{ key: 'plane_throw', name: '扔纸飞机次数', cost: 50 }
]
const drawBlessings: DrawBlessing[] = [
	{ number: '01', title: '静候花开签', message: '愿你今天从容表达，也被认真倾听。' },
	{ number: '02', title: '温柔相待签', message: '愿你保留真诚，也遇见尊重这份真诚的人。' },
	{ number: '03', title: '平安顺遂签', message: '愿你把日子过稳，把喜欢留给值得的人。' }
]

const pointsText = computed(() => points.value.toLocaleString())
const streakDays = computed(() => checkedDays.value.length)
const checkInDone = computed(() => checkedDays.value.indexOf(4) >= 0)
const exchangeCost = computed(() => exchangeItems[selectedExchangeItem.value].cost * exchangeQuantity.value)

const goBack = () => { uni.navigateBack() }
const openPurchase = () => { activeSheet.value = 'purchase' }
const openExchange = () => { activeSheet.value = 'exchange'; exchangeQuantity.value = 1 }
const openInvite = () => { activeSheet.value = 'invite' }
const closeSheet = () => { activeSheet.value = '' }
const selectPackage = (index: number) => { selectedPackage.value = index }
const selectExchangeItem = (index: number) => { selectedExchangeItem.value = index; exchangeQuantity.value = 1 }
const increaseExchange = () => { exchangeQuantity.value += 1 }
const decreaseExchange = () => { if (exchangeQuantity.value > 1) exchangeQuantity.value -= 1 }

const drawCheckIn = () => {
	if (checkInDone.value) return
	drawResult.value = drawBlessings[checkedDays.value.length % drawBlessings.length]
	checkedDays.value.push(4)
	points.value += 10
	uni.showToast({ title: '抽签成功，积分 +10', icon: 'success' })
}

const confirmPurchase = () => {
	const item = purchasePackages[selectedPackage.value]
	points.value += item.points
	activeSheet.value = ''
	uni.showToast({ title: `充值成功，积分 +${item.pointsText}`, icon: 'success' })
}

const confirmExchange = () => {
	const cost = exchangeCost.value
	if (points.value < cost) {
		uni.showToast({ title: '积分不足', icon: 'none' })
		return
	}
	points.value -= cost
	activeSheet.value = ''
	uni.showToast({ title: `兑换成功，获得${exchangeQuantity.value}次`, icon: 'success' })
}

const shareToWechat = () => {
	activeSheet.value = ''
	uni.showToast({ title: '已准备好分享内容', icon: 'success' })
}

const goMyPosters = () => {
	activeSheet.value = ''
	uni.navigateTo({ url: '/pagesSub/profileExtra/my-posters?userId=9001', fail: () => { uni.showToast({ title: '页面打开失败，请重试', icon: 'none' }) } })
}
</script>

<style scoped>
