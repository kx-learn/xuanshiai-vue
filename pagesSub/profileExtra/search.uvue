<template>
	<view class="search-page">
		<view v-if="resultState === 'idle'" class="search-form-screen">
		<view class="search-nav" :style="{ paddingTop: navTop + 'px', paddingRight: (menuButtonSpacing + 8) + 'px' }">
			<view class="nav-side" @tap="handleBack"><text class="nav-back">‹</text></view>
			<text class="nav-title" :style="{ top: navTop + 'px' }">搜索</text>
		</view>

		<view class="search-tabs" role="tablist">
			<view v-for="(tab, index) in tabs" :key="tab" class="search-tab" :class="{ active: activeTab === index }" @tap="activeTab = index"><text>{{ tab }}</text></view>
			<view class="search-history-btn" @tap="historyVisible = true"><text class="ic ic-home ic-history search-history-icon"></text></view>
		</view>

		<scroll-view class="search-scroll" scroll-y enhanced show-scrollbar="false">
			<view v-if="activeTab === 0" class="search-panel ai-panel">
				<view class="ai-input-wrap">
					<textarea class="ai-input" :value="aiQuery" maxlength="300" :placeholder="aiPlaceholder" @input="onAiInput"></textarea>
					<view class="ai-input-foot"><view class="ai-template-trigger" @tap="onAiSuggestTap"><text class="ai-trigger-text">{{ aiSuggestions.length > 0 ? '选择一条期待' : '读取可编辑建议' }}</text></view><button class="ai-submit-button" :disabled="aiGenerating || aiQuery.trim().length == 0" @tap="submitAiSearch">{{ aiGenerating ? '正在解析…' : '解析期待' }}</button></view>
					<view v-if="aiSuggestions.length > 0" class="ai-suggestion-row"><text v-for="item in aiSuggestions" :key="item" class="ai-suggestion-chip" @tap="typeAiText(item)">{{ item }}</text></view>
					<text class="panel-note">先把期待解析成条件，再由你确认后执行搜索；不会自动改写长期偏好。</text>
					<text v-if="aiGenerating" class="ai-task-inline">{{ aiDraftTaskStage }}</text>
					<!-- 解析失败时草稿区可能尚不存在：错误放在无草稿也可见的位置。 -->
					<text v-if="aiDraft == null && aiDraftError != ''" class="panel-error">{{ aiDraftError }}</text>
				</view>

				<view v-if="aiDraft != null" class="ai-draft-panel">
					<view class="ai-draft-heading"><text class="condition-label">请确认搜索条件</text><text class="ai-draft-status">{{ aiDraftStatusLabel }}</text></view>
					<text class="condition-help">条件来源于后端解析。可修改或移除，只有确认后才会执行搜索。</text>
					<view v-for="(condition, index) in aiConditions" :key="index" class="ai-condition-row">
						<view class="ai-condition-copy"><text class="ai-condition-name">{{ conditionLabel(condition) }}</text><text class="ai-condition-kind">{{ condition.kind == 'hard' ? '硬条件' : '软偏好' }} · {{ condition.confidence != null ? '置信度 ' + Math.round(Number(condition.confidence) * 100) + '%' : '后端返回' }}</text></view>
						<input class="ai-condition-input" :value="condition.localValueText" @input="onAiConditionValueInput(index, $event)" />
						<text v-if="condition.localValueInvalid" class="ai-condition-invalid">请输入有效的 {{ condition.localValueType == 'array' ? 'JSON 数组' : 'JSON 对象' }}</text>
						<view class="ai-condition-actions"><button :class="{ selected: condition.localAction == 'confirmed' }" @tap="setAiConditionAction(index, 'confirmed')">确认</button><button :class="{ selected: condition.localAction == 'removed' }" @tap="setAiConditionAction(index, 'removed')">移除</button></view>
					</view>
					<view v-if="aiUnknown.length > 0" class="ai-result-notice"><text class="ai-result-notice-title">暂未识别</text><text v-for="item in aiUnknown" :key="item">{{ item }}</text></view>
					<view v-if="aiConflicts.length > 0" class="ai-result-notice ai-result-notice-warn"><text class="ai-result-notice-title">需要处理冲突</text><text v-for="item in aiConflicts" :key="item">{{ item }}</text></view>
					<text v-if="aiDraftError != ''" class="panel-error">{{ aiDraftError }}</text>
					<button class="ai-confirm-button" :disabled="aiConfirming || aiConditions.length == 0" @tap="confirmAiSearch">{{ aiConfirming ? '正在确认并搜索…' : '确认条件并查看候选' }}</button>
				</view>
			</view>

			<view v-else-if="activeTab === 1" class="search-panel mbti-panel">
				<view class="personality-card" @tap="openSelfSheet">
					<text class="personality-label">我是</text>
					<text class="personality-value">{{ ownMbtiSummary }}</text>
					<text class="personality-note">{{ ownMbtiNote }}</text>
					<text class="personality-arrow">›</text>
				</view>
				<view class="personality-card seeking-card" @tap="openTargetSheet">
					<text class="personality-label">寻找</text>
					<text class="personality-value">理想的人格类型</text>
					<view v-if="targetMbtis.length > 0" class="selected-mbti-tags"><XsaTag v-for="item in targetMbtis" :key="item" variant="accent" size="small">{{ item }}</XsaTag></view>
					<text v-else class="personality-note">点击选择</text>
					<text class="personality-arrow">›</text>
				</view>
				<view class="mbti-tag-cloud"><text>INTJ</text><text>ENFP</text><text>INFJ</text><text>ENTP</text><text>ISFJ</text></view>
				<text class="mbti-balance-copy">同频的人，终会相遇</text>
				<text class="panel-unavailable-note">MBTI 筛选能力接入中：暂不支持按人格类型筛选</text>
			</view>

			<view v-else class="search-panel condition-panel">
				<view class="condition-group">
					<text class="condition-label">居住地偏好</text>
					<view class="condition-control location-row"><picker class="condition-picker" mode="selector" :range="residenceOptions" :value="residenceIndex" @change="onResidenceChange"><view class="picker-value"><text>{{ residenceOptions[residenceIndex] }}</text><text>⌄</text></view></picker><picker class="condition-add-picker" mode="selector" :range="residenceOptions" :value="residenceIndex" @change="onResidenceChange"><view class="condition-add"><text>＋ 添加</text></view></picker></view>
				</view>
				<view class="condition-group">
					<text class="condition-label">年龄偏好 {{ ageReadout }}</text>
					<view id="age-track" class="range-control" @touchstart="onAgeTrackTouchStart" @touchmove="onAgeTrackTouchMove" @touchend="onTrackTouchEnd"><view class="range-track"></view><view class="range-active" :style="{ left: ageLoPct + '%', width: ageZoneWidth + '%' }"></view><view class="range-handle" :style="{ left: ageLoPct + '%' }"></view><view class="range-handle" :style="{ left: ageHiPct + '%' }"></view></view>
				</view>
				<view class="condition-group condition-toggle-group">
					<view class="condition-toggle-copy"><text class="condition-label">仅认证用户</text><text class="condition-help">暂不支持：筛选接口暂无认证字段</text></view>
					<button class="condition-toggle" disabled :class="{ active: false }"><view class="toggle-knob"></view></button>
				</view>

				<view class="advanced-heading"><text class="condition-label">更多筛选</text></view>
				<view class="filter-hint"><text>可按需要补充筛选条件</text></view>
				<view class="condition-group advanced-condition-group">
					<text class="condition-label">身高偏好 {{ heightReadout }}</text>
					<view id="height-track" class="range-control" @touchstart="onHeightTrackTouchStart" @touchmove="onHeightTrackTouchMove" @touchend="onTrackTouchEnd"><view class="range-track"></view><view class="range-active" :style="{ left: heightLoPct + '%', width: heightZoneWidth + '%' }"></view><view class="range-handle" :style="{ left: heightLoPct + '%' }"></view><view class="range-handle" :style="{ left: heightHiPct + '%' }"></view></view>
				</view>
				<view class="condition-group advanced-condition-group">
					<text class="condition-label">收入偏好（年）{{ incomeReadout }}</text>
					<text class="condition-help">按资料中的年收入口径筛选</text>
					<view class="income-slider">
						<view id="income-track" class="range-control" @touchstart="onIncomeTrackTouchStart" @touchmove="onIncomeTrackTouchMove" @touchend="onTrackTouchEnd"><view class="range-track"></view><view class="range-active" :style="{ left: incomeLoPct + '%', width: incomeZoneWidth + '%' }"></view><view class="range-handle" :style="{ left: incomeLoPct + '%' }"></view><view class="range-handle" :style="{ left: incomeHiPct + '%' }"></view></view>
						<view class="range-scale"><text>5w</text><text>15w</text><text>30w</text><text>50w</text><text>100w</text><text>500w</text></view>
					</view>
				</view>
				<view class="condition-group advanced-condition-group">
					<text class="condition-label">家乡偏好</text>
					<view class="wide-picker-disabled"><text>暂不支持：筛选接口暂无家乡字段</text></view>
				</view>
				<view class="condition-group advanced-condition-group">
					<text class="condition-label">学历偏好</text>
					<text class="condition-help">按所选学历及以上筛选</text>
					<view class="condition-choice-grid education-grid"><view v-for="item in educationOptions" :key="item" class="choice-chip" :class="{ selected: education === item }" @tap="education = item"><text>{{ item }}</text></view></view>
				</view>
				<view class="condition-group advanced-condition-group">
					<text class="condition-label">婚况偏好</text>
					<view class="condition-choice-grid marriage-grid"><view v-for="item in marriageOptions" :key="item" class="choice-chip" :class="{ selected: marriage === item }" @tap="marriage = item"><text>{{ item }}</text></view></view>
				</view>
			</view>
		</scroll-view>

		<view class="bottom-actions">
			<button v-if="activeTab === 2" class="reset-button" @tap="resetCondition"><text>重置</text></button>
			<button class="search-button" :class="{ wide: activeTab !== 2 }" @tap="submitSearch"><text>开始搜索</text></button>
		</view>
		</view>

		<view v-else class="search-results-screen">
			<view class="result-nav" :style="{ paddingTop: navTop + 'px', paddingRight: (menuButtonSpacing + 8) + 'px' }">
				<view class="nav-side" @tap="handleBack"><text class="nav-back">‹</text></view>
				<text class="nav-title" :style="{ top: navTop + 'px' }">搜索结果</text>
				<view class="result-nav-action" @tap="openSearchEditor"><text>重搜</text></view>
			</view>

			<scroll-view class="result-scroll" scroll-y enhanced show-scrollbar="false">
				<view v-if="resultState === 'loading'" class="result-loading-state">
					<view v-if="activeTab == 0" class="ai-task-loading"><view class="ai-task-spinner"></view><text class="result-loading-title">{{ aiTaskStage }}</text><text class="result-loading-copy">后端任务完成前不会展示为最终结果</text></view>
					<view v-else class="result-orbit">
						<view class="result-orbit-ring result-orbit-ring-outer"></view><view class="result-orbit-ring result-orbit-ring-inner"></view><view class="result-orbit-spark spark-one"></view><view class="result-orbit-spark spark-two"></view><view class="result-orbit-spark spark-three"></view><view class="result-orbit-core"><text>{{ searchProgress }}%</text><text class="result-orbit-caption">匹配中</text></view>
					</view>
					<view v-if="activeTab != 0" class="result-progress-rail"><view class="result-progress-fill" :style="{ width: searchProgress + '%' }"></view></view>
					<text v-if="activeTab != 0" class="result-loading-title">正在为你寻找合适的人</text>
					<text v-if="activeTab != 0" class="result-loading-copy">{{ searchProgressCopy }}</text>
					<view v-if="activeTab != 0 && resultCandidates.length > 0 && searchProgress >= 64" class="result-preview-avatars"><image v-for="(item, index) in resultCandidates.slice(0, 6)" :key="item.id" class="result-preview-avatar" :style="{ animationDelay: index * 90 + 'ms' }" :src="resultAvatar(item)" mode="aspectFill"></image></view>
				</view>

				<view v-else-if="resultState === 'error'" class="result-message-state">
					<view class="result-message-mark"><text>!</text></view>
					<text class="result-message-title">搜索暂时没有完成</text>
					<text class="result-message-copy">{{ resultError }}</text>
					<button class="result-secondary-button" @tap="retrySearch"><text>重新搜索</text></button>
				</view>

				<view v-else-if="resultState === 'empty'" class="result-message-state">
					<view class="result-message-mark"><text>○</text></view>
					<text class="result-message-title">暂时没有找到合适的人</text>
					<text class="result-message-copy">可以放宽一点期待，再试一次。</text>
					<button class="result-secondary-button" @tap="openSearchEditor"><text>调整搜索条件</text></button>
				</view>

				<view v-else class="result-success-state">
					<view class="result-heading">
						<text class="result-heading-title">已为你找到合适人选</text>
						<text class="result-heading-copy">基于“{{ resultQuerySummary }}”整理，仅供参考</text>
					</view>
					<view v-for="(item, index) in resultCandidates" :key="item.id" class="result-card" :class="{ featured: index === 0 }" @tap="goToResultProfile(item)">
						<image class="result-avatar" :class="{ featured: index === 0 }" :src="resultAvatar(item)" mode="aspectFill"></image>
						<view class="result-card-body">
							<view class="result-card-topline"><text class="result-card-arrow">›</text></view>
							<text class="result-name">{{ resultName(item) }}</text>
							<text v-if="item.matchedConditions != null && item.matchedConditions.length > 0" class="result-card-hint">已命中：{{ item.matchedConditions.join('、') }}</text>
							<text v-if="item.isFuzzy === true" class="result-card-hint">当前为中间候选，最终结果仍以完整筛选为准</text>
							<text v-if="index === 0" class="result-card-hint">点击查看完整资料</text>
						</view>
					</view>
					<button v-if="hasMore && resultState === 'success'" class="load-more-button" :disabled="loadingMore" @tap="loadMoreResults"><text>{{ loadingMore ? '加载中…' : '加载更多' }}</text></button>
					<text class="result-disclaimer">结果按资料完整度与筛选条件返回，仅作认识参考</text>
				</view>
			</scroll-view>

			<view class="result-bottom-actions">
				<button class="result-primary-button" @tap="startNewSearch"><text>开始新的搜索</text></button>
			</view>
		</view>

		<XsaSheet :visible="historyVisible" title="搜索历史" @close="historyVisible = false"><view class="history-list"><view v-if="historyItems.length === 0" class="history-empty"><text>暂无搜索历史</text></view><view v-for="item in historyItems" :key="item.id" class="history-item" @tap="applyHistory(item)"><text>{{ item.label }}</text></view></view></XsaSheet>

		<XsaSheet :visible="mbtiSheetVisible" :title="mbtiSheetMode === 'self' ? '我的 MBTI' : '寻找的人格类型'" @close="closeMbtiSheet">
			<view v-if="mbtiSheetMode === 'self'" class="self-sheet-content"><text class="sheet-copy">可以先完成测评，也可以直接输入已知类型。</text><button class="sheet-secondary-button" @tap="goAssessment"><text>去测评</text></button><view class="manual-mbti-row"><input class="mbti-input" :value="ownMbtiDraft" maxlength="4" placeholder="输入 16 型，如 ENTP" @input="onOwnMbtiInput" /><button class="sheet-save-button" :disabled="savingOwnMbti" @tap="saveOwnMbti"><text>{{ savingOwnMbti ? '保存中' : '确定' }}</text></button></view></view>
			<view v-else class="target-sheet-content"><view class="sheet-selection-head"><text>{{ activeTrait || '轻触人格类型，查看相处标签' }}</text><text class="sheet-limit">最多 5 个</text></view><view class="mbti-grid"><button v-for="item in mbtiTypes" :key="item.code" class="mbti-type-button" :class="{ selected: targetMbtis.indexOf(item.code) >= 0 }" @tap="toggleTargetMbti(item.code, item.trait)"><text>{{ item.code }}</text></button></view><view class="sheet-selected-tags"><XsaTag v-for="item in targetMbtis" :key="item" variant="accent" size="small">{{ item }}</XsaTag><text v-if="targetMbtis.length === 0" class="sheet-empty-text">尚未选择</text></view><button class="sheet-primary-button" @tap="closeMbtiSheet"><text>完成选择</text></button></view>
		</XsaSheet>
	</view>
</template>

<script setup lang="uts">
	import XsaSheet from '@/components/XsaSheet.uvue'
	import XsaTag from '@/components/XsaTag.uvue'
	import { getOwnProfile, getEmotionLabSummary, setMyMbtiType, getDiscoveryRecommendations, createSearchDraft, getSearchDraft, patchSearchDraft, confirmSearchDraft, waitForSearchTask, getSearchSnapshotResults, getSearchSuggestions, generateSearchSuggestions, searchResultItems, searchNextCursor, searchDraftConditions, searchDraftUnknown, searchDraftConflicts, searchDraftRevision } from '@/api'

	const systemInfo = uni.getSystemInfoSync()
	const statusBarHeight = systemInfo.statusBarHeight != null ? systemInfo.statusBarHeight : 20
	const menuButtonInfo = uni.getMenuButtonBoundingClientRect()
	const navTop = menuButtonInfo != null && menuButtonInfo.top > statusBarHeight ? menuButtonInfo.top : statusBarHeight + 12
	const menuButtonSpacing = menuButtonInfo != null ? (systemInfo.windowWidth - menuButtonInfo.left) : 8

	const tabs = ['AI 觅遇', '灵魂契合', '精准甄选']
	const SEARCH_HISTORY_STORAGE_KEY = 'xsa_search_history_v1'
	const activeTab = ref(0)
	const historyVisible = ref(false)
	const historyItems = ref<any[]>([])
	const resultState = ref('idle')
	const searchProgress = ref(0)
	const searchProgressCopy = ref('正在理解你的搜索期待')
	const resultCandidates = ref<any[]>([])
	const resultError = ref('请检查网络后再试一次')
	let searchRunId = 0
	// 页面存活：退出后建议/任务回调不再更新界面。
	let searchPageAlive = true
	const nextCursor = ref('')
	const hasMore = ref(false)
	const loadingMore = ref(false)
	const updateSearchProgress = (value: number) => {
		searchProgress.value = Math.round(value)
		if (value < 35) searchProgressCopy.value = '正在理解你的搜索期待'
		else if (value < 72) searchProgressCopy.value = '正在梳理相处偏好与期待'
		else searchProgressCopy.value = '正在筛选可能与你合拍的人'
	}
	const animateSearchProgress = (runId: number, from: number, to: number, duration: number): Promise<boolean> => {
		return new Promise((resolve) => {
			const startedAt = Date.now()
			const timer = setInterval(() => {
				if (runId != searchRunId) {
					clearInterval(timer)
					resolve(false)
					return
				}
				const ratio = Math.min(1, (Date.now() - startedAt) / duration)
				const easedRatio = 1 - Math.pow(1 - ratio, 3)
				updateSearchProgress(from + (to - from) * easedRatio)
				if (ratio >= 1) {
					clearInterval(timer)
					resolve(true)
				}
			}, 32)
		})
	}

	const aiQuery = ref('')
	const aiGenerating = ref(false)
	let aiTypingTimer: any = null
	const aiDraft = ref<any>(null)
	const aiDraftId = ref('')
	const aiDraftTaskId = ref('')
	const aiDraftStatus = ref('')
	const aiDraftTaskStage = ref('等待解析')
	const aiDraftError = ref('')
	const aiDraftKeyQuery = ref('')
	const aiDraftIdempotencyKey = ref('')
	const aiPatchIdempotencyKey = ref('')
	const aiConfirmIdempotencyKey = ref('')
	const aiConfirming = ref(false)
	const aiSnapshotId = ref('')
	const aiConditions = ref<any[]>([])
	const aiUnknown = ref<string[]>([])
	const aiConflicts = ref<string[]>([])
	const aiSuggestions = ref<string[]>([])
	const aiSuggestionGenerating = ref(false)
	const aiSuggestionIdempotencyKey = ref('')
	const aiTaskStage = ref('正在等待后端任务完成')
	// confirm 已知成功后的任务/快照引用：成功响应丢失时用它重读结果，而不是重跑整链。
	let aiConfirmTaskId = ''
	const aiDraftStatusLabel = computed(() => aiDraftStatus.value == 'awaiting_confirmation' ? '待确认' : (aiDraftStatus.value == 'confirmed' ? '已确认' : (aiDraftStatus.value == 'failed' ? '解析失败' : '解析中')))
	const resetAiDraftState = (preserveDraftKey: boolean = false) => {
		aiDraft.value = null
		aiDraftId.value = ''
		aiDraftTaskId.value = ''
		aiDraftStatus.value = ''
		aiDraftTaskStage.value = '等待解析'
		aiDraftError.value = ''
		if (!preserveDraftKey) {
			aiDraftIdempotencyKey.value = ''
			aiDraftKeyQuery.value = ''
		}
		aiPatchIdempotencyKey.value = ''
		aiConfirmIdempotencyKey.value = ''
		aiConfirming.value = false
		// 草稿换人/换句后，上一轮的阶段成功标记与任务引用必须一起作废。
		aiPatchPhaseSucceeded = false
		aiConfirmSucceeded.value = false
		aiConfirmTaskId = ''
		aiSnapshotId.value = ''
		aiConditions.value = []
		aiUnknown.value = []
		aiConflicts.value = []
	}
	const conditionValueText = (value: any): string => {
		if (value == null) return ''
		if (Array.isArray(value) || (typeof value == 'object' && value != null)) return JSON.stringify(value)
		return String(value)
	}
	const setAiDraftResponse = (response: any) => {
		const payload = response != null && response.data != null ? response.data : response
		aiDraft.value = payload
		aiDraftStatus.value = payload != null && payload.status != null ? String(payload.status) : 'awaiting_confirmation'
		aiDraftId.value = payload != null && payload.draft_id != null ? String(payload.draft_id) : aiDraftId.value
		const sourceConditions = searchDraftConditions(payload)
		aiConditions.value = sourceConditions.map((condition: any, index: number) => {
			const rawValue = condition != null ? condition.value : null
			const hasConditionNo = condition != null && condition.condition_no != null && String(condition.condition_no).trim() != '' && !isNaN(Number(condition.condition_no))
			return { ...condition, sourceConditionIndex: index, actionConditionNo: hasConditionNo ? Number(condition.condition_no) : index, localValueType: rawValue == null ? 'null' : (Array.isArray(rawValue) ? 'array' : (typeof rawValue == 'object' ? 'object' : typeof rawValue)), localValueText: conditionValueText(rawValue), localAction: condition.user_action == 'removed' ? 'removed' : (condition.user_action == 'confirmed' ? 'confirmed' : 'pending'), localValueInvalid: false }
		})
		aiUnknown.value = searchDraftUnknown(payload)
		aiConflicts.value = searchDraftConflicts(payload)
	}
	const conditionLabel = (condition: any): string => {
		if (condition == null) return '未命名条件'
		const field = condition.field_key != null ? String(condition.field_key) : '条件'
		const operator = condition.operator != null ? String(condition.operator) : ''
		return operator.length > 0 ? field + ' · ' + operator : field
	}
	const aiConditionValue = (condition: any): any => {
		if (condition == null) return null
		const text = condition.localValueText != null ? String(condition.localValueText) : ''
		if (condition.localValueType == 'number') return text.trim() == '' || isNaN(Number(text)) ? null : Number(text)
		if (condition.localValueType == 'boolean') return text.trim().toLowerCase() == 'true'
		if (condition.localValueType == 'array' || condition.localValueType == 'object') return JSON.parse(text)
		return text
	}
	const onAiConditionValueInput = (index: number, event: any) => {
		if (index < 0 || index >= aiConditions.value.length) return
		const condition = aiConditions.value[index]
		// 先回写真实输入，再校验：不回写会让校验和后续 PATCH 都拿着旧值执行。
		const inputValue = event != null && event.detail != null && event.detail.value != null ? String(event.detail.value) : ''
		condition.localValueText = inputValue
		condition.localValueInvalid = false
		if (condition.localValueType == 'number') condition.localValueInvalid = condition.localValueText.trim() == '' || isNaN(Number(condition.localValueText))
		if (condition.localValueType == 'boolean') condition.localValueInvalid = condition.localValueText.trim().toLowerCase() != 'true' && condition.localValueText.trim().toLowerCase() != 'false'
		if (condition.localValueType == 'array' || condition.localValueType == 'object') {
			try {
				const parsed = JSON.parse(condition.localValueText)
				condition.localValueInvalid = condition.localValueType == 'array' ? !Array.isArray(parsed) : Array.isArray(parsed) || parsed == null || typeof parsed != 'object'
			} catch (error) { condition.localValueInvalid = true }
		}
		if (condition.localAction != 'removed') condition.localAction = 'confirmed'
		aiPatchIdempotencyKey.value = ''
	}
	const setAiConditionAction = (index: number, action: string) => {
		if (index < 0 || index >= aiConditions.value.length) return
		aiConditions.value[index].localAction = action
		aiPatchIdempotencyKey.value = ''
	}
	const loadAiSuggestions = async () => {
		const response = await getSearchSuggestions()
		if (response != null && response.success && response.data != null && Array.isArray(response.data.items)) aiSuggestions.value = response.data.items as string[]
	}
	const onAiSuggestTap = async () => {
		if (aiSuggestions.value.length > 0 || aiSuggestionGenerating.value) return
		aiSuggestionGenerating.value = true
		if (aiSuggestionIdempotencyKey.value == '') aiSuggestionIdempotencyKey.value = 'search-suggest-' + String(Date.now())
		try {
			await loadAiSuggestions()
			if (!searchPageAlive || aiSuggestions.value.length > 0) return
			const generated = await generateSearchSuggestions(aiSuggestionIdempotencyKey.value)
			if (!searchPageAlive) return
			if (generated != null && generated.success && generated.data != null) {
				const taskId = generated.data.task_id != null ? String(generated.data.task_id) : ''
				if (taskId != '') {
					const task = await waitForSearchTask(taskId, () => searchPageAlive)
					if (!searchPageAlive) return
					if (!task.done || task.status != 'succeeded') throw new Error(task.error != null ? String(task.error) : '建议生成未完成')
				}
				await loadAiSuggestions()
			}
			if (!searchPageAlive) return
			if (aiSuggestions.value.length == 0) uni.showToast({ title: '暂时没有可编辑建议，请直接描述期待', icon: 'none' })
		} catch (error) { if (searchPageAlive) uni.showToast({ title: '建议暂时无法读取，请直接描述期待', icon: 'none' })
		} finally { aiSuggestionGenerating.value = false }
	}

	const hometownOptions = ['不限', '江苏', '浙江', '上海', '安徽']
	const residenceOptions = ['不限', '南京', '杭州', '上海', '深圳']
	const AGE_MIN = 18
	const AGE_MAX = 60
	const HEIGHT_MIN = 140
	const HEIGHT_MAX = 220
	const INCOME_STOPS = [5, 15, 30, 50, 100, 500]
	// 学历选项与存储域（education_level 1=高中及以下 … 5=博士，编辑器写入域）对齐；
	// 小学/初中/技校在存储域不可表达，隐藏（后端字典冲突已单独记录）。
	const educationOptions = ['不限', '高中', '大专', '本科', '硕士', '博士']
	const marriageOptions = ['未婚', '离异']
	const hometownIndex = ref(0)
	const residenceIndex = ref(0)
	const ageMin = ref(null as any)
	const ageMax = ref(null as any)
	const heightMin = ref(null as any)
	const heightMax = ref(null as any)
	const incomeMin = ref(null as any)
	const incomeMax = ref(null as any)
	const education = ref('')
	const marriage = ref('')
	const certificationOnly = ref(true)

	const mbtiSheetVisible = ref(false)
	const mbtiSheetMode = ref('self')
	const ownMbti = ref('')
	const ownMbtiDraft = ref('')
	const ownGender = ref<any>(null)
	const savingOwnMbti = ref(false)
	const targetMbtis = ref<string[]>([])
	const activeTrait = ref('')
	const mbtiTypes = [
		{ code: 'INTJ', trait: 'INTJ 理性搭档' }, { code: 'INTP', trait: 'INTP 好奇探索' }, { code: 'ENTJ', trait: 'ENTJ 目标同行' }, { code: 'ENTP', trait: 'ENTP 思维碰撞' },
		{ code: 'INFJ', trait: 'INFJ 灵魂知己' }, { code: 'INFP', trait: 'INFP 温柔治愈' }, { code: 'ENFJ', trait: 'ENFJ 共情支持' }, { code: 'ENFP', trait: 'ENFP 热情灵感' },
		{ code: 'ISTJ', trait: 'ISTJ 稳定靠谱' }, { code: 'ISFJ', trait: 'ISFJ 细腻守护' }, { code: 'ESTJ', trait: 'ESTJ 执行默契' }, { code: 'ESFJ', trait: 'ESFJ 温暖联结' },
		{ code: 'ISTP', trait: 'ISTP 自在相处' }, { code: 'ISFP', trait: 'ISFP 感受共鸣' }, { code: 'ESTP', trait: 'ESTP 活力同游' }, { code: 'ESFP', trait: 'ESFP 快乐分享' }
	]
	const mbtiNames: any = { INTJ: '建筑师', INTP: '逻辑学家', ENTJ: '指挥官', ENTP: '辩论家', INFJ: '提倡者', INFP: '调停者', ENFJ: '主人公', ENFP: '竞选者', ISTJ: '物流师', ISFJ: '守卫者', ESTJ: '总经理', ESFJ: '执政官', ISTP: '鉴赏家', ISFP: '探险家', ESTP: '企业家', ESFP: '表演者' }
	const mbtiCompatibility: any = {
		INTJ: 'ENFP / ENTP', INTP: 'ENTJ / ENFJ', ENTJ: 'INTP / INFP', ENTP: 'INFJ / INTJ',
		INFJ: 'ENFP / ENTP', INFP: 'ENFJ / ENTJ', ENFJ: 'INFP / ISFP', ENFP: 'INFJ / INTJ',
		ISTJ: 'ESFP / ESTP', ISFJ: 'ESFP / ESTP', ESTJ: 'ISFP / ISTP', ESFJ: 'ISFP / ISTP',
		ISTP: 'ESFJ / ESTJ', ISFP: 'ENFJ / ESFJ', ESTP: 'ISFJ / ISTJ', ESFP: 'ISFJ / ISTJ'
	}
	const ownMbtiSummary = computed(() => ownMbti.value == '' ? '还未设置' : ownMbti.value + ' ' + (mbtiNames[ownMbti.value] != null ? mbtiNames[ownMbti.value] : ''))
	const ownMbtiNote = computed(() => {
		if (ownMbti.value == '') return '点击选择我的 MBTI'
		const matches = mbtiCompatibility[ownMbti.value]
		return matches != null ? '适配参考 ' + matches : '适配参考待完善'
	})

	const toText = (value: any): string => value == null ? '' : ('' + value)
	const aiTargetPronoun = computed(() => {
		const gender = toText(ownGender.value).toLowerCase()
		return ownGender.value == 2 || gender == '2' || gender == '女' || gender == 'female' ? '他' : '她'
	})
	const aiPlaceholder = computed(() => '你希望遇见什么样的' + aiTargetPronoun.value + '，一起体验往后的点点滴滴？')
	const validIndex = (value: any, length: number): number => {
		const index = Number(value)
		return index >= 0 && index < length ? index : 0
	}
	const profilePayload = (raw: any): any => raw != null && raw.profile != null ? raw.profile : (raw != null && raw.data != null && raw.data.profile != null ? raw.data.profile : (raw != null ? raw : {}))
	const loadOwnMbti = async () => {
		let fallbackMbti = ''
		try {
			const res = await getOwnProfile()
			if (res.success && res.data != null) {
				const data = profilePayload(res.data)
				ownGender.value = data.gender
				const value = toText(data.mbti).toUpperCase()
				if (mbtiNames[value] != null) fallbackMbti = value
			}
		} catch (error) {
			console.error('[Search] own profile load failed', error)
		}
		let confirmedMbti = ''
		try {
			const labRes = await getEmotionLabSummary()
			if (labRes != null && labRes.success == true && labRes.data != null && labRes.data.profileSource != null) {
				const value = toText(labRes.data.profileSource.mbtiType).toUpperCase()
				if (mbtiNames[value] != null) confirmedMbti = value
			}
		} catch (error) {
			console.error('[Search] own MBTI load failed', error)
		}
		ownMbti.value = confirmedMbti != '' ? confirmedMbti : fallbackMbti
	}

	const goBack = () => uni.navigateBack({ delta: 1 })
	const handleBack = () => { if (resultState.value != 'idle') openSearchEditor(); else goBack() }
	// 作废当前解析任务：旧任务已被替换，busy 必须立刻恢复，否则新提交会被
	// aiGenerating 永久拒绝（旧任务的 finally 因 runId 失配不会再清它）。
	const invalidateAiRun = () => {
		searchRunId += 1
		aiGenerating.value = false
		aiConfirming.value = false
	}
	const onAiInput = (event: any) => {
		const next = toText(event.detail.value)
		if (next == aiQuery.value) return
		invalidateAiRun()
		resetAiDraftState()
		aiQuery.value = next
	}
	const stopAiTyping = () => {
		if (aiTypingTimer != null) {
			clearInterval(aiTypingTimer)
			aiTypingTimer = null
		}
	}
	const typeAiText = (value: string) => {
		stopAiTyping()
		invalidateAiRun()
		aiQuery.value = ''
		resetAiDraftState()
		let index = 0
		aiTypingTimer = setInterval(() => {
			if (index >= value.length) { stopAiTyping(); return }
			aiQuery.value += value.charAt(index)
			index += 1
		}, 45)
	}
	const submitAiSearch = async () => {
		const query = aiQuery.value.trim()
		if (query.length == 0 || aiGenerating.value) return
		const runId = searchRunId + 1
		searchRunId = runId
		resultCandidates.value = []
		nextCursor.value = ''
		hasMore.value = false
		resultError.value = ''
		const reuseDraftKey = aiDraftKeyQuery.value == query && aiDraftIdempotencyKey.value.length > 0
		resetAiDraftState(reuseDraftKey)
		aiGenerating.value = true
		aiDraftTaskStage.value = '正在解析你的搜索期待'
		if (!reuseDraftKey) {
			aiDraftIdempotencyKey.value = 'search-draft-' + String(Date.now()) + '-' + String(Math.floor(Math.random() * 1000000))
			aiDraftKeyQuery.value = query
		}
		try {
			const created = await createSearchDraft(query, 'search_page', 'zh-CN', aiDraftIdempotencyKey.value)
			if (runId != searchRunId) return
			if (created == null || !created.success || created.data == null) { aiDraftError.value = created != null && created.message != null ? String(created.message) : '搜索期待解析失败'; return }
			const data = created.data
			aiDraftId.value = data.draft_id != null ? String(data.draft_id) : ''
			aiDraftTaskId.value = data.task_id != null ? String(data.task_id) : ''
			if (aiDraftId.value == '' || aiDraftTaskId.value == '') { aiDraftError.value = '搜索服务未返回有效解析任务'; return }
			const task = await waitForSearchTask(aiDraftTaskId.value, () => runId == searchRunId)
			if (runId != searchRunId) return
			if (!task.done || task.status != 'succeeded') { aiDraftError.value = task.error != null ? String(task.error) : '搜索期待解析未完成'; return }
			aiDraftTaskStage.value = '解析完成，等待你确认条件'
			const draft = await getSearchDraft(aiDraftId.value)
			if (runId != searchRunId) return
			if (!draft.success || draft.data == null) { aiDraftError.value = draft.message != null ? String(draft.message) : '解析条件读取失败'; return }
			setAiDraftResponse(draft)
			resultState.value = 'idle'
		} catch (error) {
			if (runId == searchRunId) aiDraftError.value = '网络异常，搜索期待未完成'
		} finally {
			if (runId == searchRunId) aiGenerating.value = false
		}
	}
	const buildAiConditionActions = (): any[] => {
		const actions: any[] = []
		for (let index = 0; index < aiConditions.value.length; index++) {
			const condition = aiConditions.value[index]
			// 已移除的条件不再因其旧非法值阻断其余条件，也不进入最终搜索；
			// 只对仍保留的条件做值校验。
			if (condition.localAction == 'removed') {
				actions.push({ condition_no: condition.actionConditionNo, action: 'remove' })
				continue
			}
			if (condition.localValueInvalid) {
				aiDraftError.value = '请先修正条件值格式后再确认'
				return []
			}
			const conditionNo = condition.actionConditionNo
			if (condition.localValueText != null && conditionValueText(aiConditionValue(condition)) != conditionValueText(condition.value)) actions.push({ condition_no: conditionNo, action: 'edit', value: aiConditionValue(condition) })
			else actions.push({ condition_no: conditionNo, action: 'confirm' })
		}
		return actions
	}
	const patchAiConditions = async (runId: number, draftId: string): Promise<boolean> => {
		if (draftId == '' || runId != searchRunId || draftId != aiDraftId.value) return false
		if (aiPatchIdempotencyKey.value.length == 0) aiPatchIdempotencyKey.value = 'search-patch-' + String(Date.now()) + '-' + String(Math.floor(Math.random() * 1000000))
		const actions = buildAiConditionActions()
		if (actions.length == 0 || runId != searchRunId || draftId != aiDraftId.value) return false
		const revision = searchDraftRevision(aiDraft.value)
		const response = await patchSearchDraft(draftId, actions, revision, aiPatchIdempotencyKey.value)
		if (runId != searchRunId || draftId != aiDraftId.value) return false
		if (response.success && response.data != null) { setAiDraftResponse(response); return true }
		if (response.code == 409) {
			const latest = await getSearchDraft(draftId)
			if (runId != searchRunId || draftId != aiDraftId.value) return false
			if (latest.success && latest.data != null) setAiDraftResponse(latest)
		}
		if (runId == searchRunId && draftId == aiDraftId.value) aiDraftError.value = response.message != null ? String(response.message) : '条件版本已变化，请检查后重试'
		return false
	}
	// 阶段化确认：PATCH 与 confirm 各自保存"已知成功"标记与请求快照。
	// 已知 PATCH 成功后重试只重放 confirm；条件被修改后两阶段键同时作废，
	// 否则会拿着旧 revision 的键去重放新内容，必然 409 死循环。
	let aiPatchPhaseSucceeded = false
	const aiConfirmSucceeded = ref(false)
	const confirmAiSearch = async () => {
		if (aiConfirming.value || aiDraftId.value == '') return
		const runId = searchRunId
		const draftId = aiDraftId.value
		aiConfirming.value = true
		aiDraftError.value = ''
		try {
			if (!aiPatchPhaseSucceeded) {
				if (!await patchAiConditions(runId, draftId) || runId != searchRunId || draftId != aiDraftId.value) return
				aiPatchPhaseSucceeded = true
			}
			let accepted: any = null
			if (aiConfirmSucceeded.value) {
				// confirm 已知成功（例如成功响应丢失后重试）：直接复用上次快照，
				// 不再重复执行同一次确认，避免重复创建任务。
				accepted = { success: true, data: aiSnapshotId.value != '' ? { snapshot_id: aiSnapshotId.value, task_id: aiConfirmTaskId } : null }
			} else {
				if (aiConfirmIdempotencyKey.value.length == 0) aiConfirmIdempotencyKey.value = 'search-confirm-' + String(Date.now()) + '-' + String(Math.floor(Math.random() * 1000000))
				accepted = await confirmSearchDraft(draftId, searchDraftRevision(aiDraft.value), aiConfirmIdempotencyKey.value)
			}
			if (runId != searchRunId || draftId != aiDraftId.value) return
			if (accepted == null || !accepted.success || accepted.data == null) { aiDraftError.value = accepted != null && accepted.message != null ? String(accepted.message) : '条件确认失败，请检查条件后重试'; return }
			const acceptedData = accepted.data
			aiSnapshotId.value = acceptedData.snapshot_id != null ? String(acceptedData.snapshot_id) : aiSnapshotId.value
			const taskId = acceptedData.task_id != null ? String(acceptedData.task_id) : aiConfirmTaskId
			aiConfirmTaskId = taskId
			if (aiSnapshotId.value == '' || taskId == '') { aiDraftError.value = '搜索服务未返回有效执行任务'; return }
			aiConfirmSucceeded.value = true
			resultState.value = 'loading'
			aiTaskStage.value = '正在执行已确认的搜索条件'
			const task = await waitForSearchTask(taskId, () => runId == searchRunId && draftId == aiDraftId.value)
			if (runId != searchRunId || draftId != aiDraftId.value) return
			if (!task.done || task.status != 'succeeded') {
				resultState.value = 'error'
				resultError.value = task.error != null ? String(task.error) : '搜索任务未完成'
				if (task.done) {
					// 任务明确失败：解除两阶段标记与幂等键，用户主动重试才产生新操作。
					aiConfirmIdempotencyKey.value = ''
					aiConfirmSucceeded.value = false
					aiPatchPhaseSucceeded = false
				}
				return
			}
			await loadSnapshotResults(runId, draftId)
		} catch (error) {
			if (runId == searchRunId && draftId == aiDraftId.value) { resultState.value = 'error'; resultError.value = '网络异常，搜索未完成' }
		} finally {
			if (runId == searchRunId && draftId == aiDraftId.value) aiConfirming.value = false
		}
	}
	// 结果读取单独成段：读结果失败只重读既有快照，不重跑 create/patch/confirm 整链。
	const loadSnapshotResults = async (runId: number, draftId: string): Promise<boolean> => {
		if (aiSnapshotId.value == '') return false
		aiTaskStage.value = '正在读取最终候选'
		const results = await getSearchSnapshotResults(aiSnapshotId.value, '', 20)
		if (runId != searchRunId || draftId != aiDraftId.value) return false
		if (results == null || !results.success || results.data == null) {
			resultState.value = 'error'
			resultError.value = results != null && results.message != null ? String(results.message) : '候选结果读取失败'
			return false
		}
		resultCandidates.value = searchResultItems(results)
		nextCursor.value = searchNextCursor(results)
		hasMore.value = nextCursor.value.length > 0
		resultState.value = resultCandidates.value.length > 0 ? 'success' : 'empty'
		return true
	}
	const onHometownChange = (event: any) => { hometownIndex.value = Number(event.detail.value) }
	const onResidenceChange = (event: any) => { residenceIndex.value = Number(event.detail.value) }
	const clampInt = (value: any, min: number, max: number, fallback: number): number => {
		if (value == null) return fallback
		const num = Number(value)
		if (isNaN(num)) return fallback
		return Math.min(max, Math.max(min, Math.round(num)))
	}
	const pctOf = (value: number, min: number, max: number): number => (value - min) / (max - min) * 100
	const ageLo = computed((): number => ageMin.value == null ? AGE_MIN : Number(ageMin.value))
	const ageHi = computed((): number => ageMax.value == null ? AGE_MAX : Number(ageMax.value))
	const heightLo = computed((): number => heightMin.value == null ? HEIGHT_MIN : Number(heightMin.value))
	const heightHi = computed((): number => heightMax.value == null ? HEIGHT_MAX : Number(heightMax.value))
	const ageLoPct = computed((): number => pctOf(ageLo.value, AGE_MIN, AGE_MAX))
	const ageHiPct = computed((): number => pctOf(ageHi.value, AGE_MIN, AGE_MAX))
	const ageZoneWidth = computed((): number => ageHiPct.value - ageLoPct.value)
	const heightLoPct = computed((): number => pctOf(heightLo.value, HEIGHT_MIN, HEIGHT_MAX))
	const heightHiPct = computed((): number => pctOf(heightHi.value, HEIGHT_MIN, HEIGHT_MAX))
	const heightZoneWidth = computed((): number => heightHiPct.value - heightLoPct.value)
	const ageReadout = computed((): string => {
		if (ageMin.value == null && ageMax.value == null) return '不限'
		if (ageMin.value == null) return '' + ageHi.value + ' 岁以内'
		if (ageMax.value == null) return '' + ageLo.value + ' 岁以上'
		return '' + ageLo.value + ' ~ ' + ageHi.value + ' 岁'
	})
	const heightReadout = computed((): string => {
		if (heightMin.value == null && heightMax.value == null) return '不限'
		if (heightMin.value == null) return '' + heightHi.value + ' cm 以内'
		if (heightMax.value == null) return '' + heightLo.value + ' cm 以上'
		return '' + heightLo.value + ' ~ ' + heightHi.value + ' cm'
	})
	const dragTarget = ref('')
	const dragRect = ref(null as any)
	const dragLo = ref(false)
	const dragStartX = ref(0)
	const dragPending = ref(false)
	const queryRect = (id: string, callback: (rect: any) => void) => {
		uni.createSelectorQuery().select('#' + id).boundingClientRect((rect: any) => {
			callback(rect)
		}).exec()
	}
	const applyTrackValue = (clientX: number, min: number, span: number, setLo: (v: number) => void, setHi: (v: number) => void, getLo: () => number, getHi: () => number) => {
		const rect = dragRect.value
		if (rect == null || Number(rect.width) <= 0) return
		let value = Math.round(min + (clientX - Number(rect.left)) / Number(rect.width) * span)
		value = Math.min(min + span, Math.max(min, value))
		if (dragLo.value) setLo(Math.min(value, getHi()))
		else setHi(Math.max(value, getLo()))
	}
	const resolveDragLo = (dx: number, min: number, max: number, getLo: () => number, getHi: () => number): boolean => {
		if (dx > 0) {
			if (getHi() < max) return false
			return getLo() < getHi()
		}
		if (getLo() > min) return true
		return getHi() > getLo()
	}
	const onAgeTrackTouchStart = (e: any) => {
		const touch = e.touches != null && e.touches.length > 0 ? e.touches[0] : null
		if (touch == null) return
		queryRect('age-track', (rect: any) => {
			if (rect == null) return
			dragRect.value = rect
			const x = Number(touch.clientX)
			const loX = Number(rect.left) + Number(rect.width) * (Number(ageMin.value == null ? AGE_MIN : ageMin.value) - AGE_MIN) / (AGE_MAX - AGE_MIN)
			const hiX = Number(rect.left) + Number(rect.width) * (Number(ageMax.value == null ? AGE_MAX : ageMax.value) - AGE_MIN) / (AGE_MAX - AGE_MIN)
			const tie = Math.abs(x - loX) == Math.abs(x - hiX)
			dragLo.value = Math.abs(x - loX) <= Math.abs(x - hiX)
			dragStartX.value = x
			dragPending.value = tie
			dragTarget.value = 'age'
			if (!tie) applyTrackValue(x, AGE_MIN, AGE_MAX - AGE_MIN,
				(v: number) => { ageMin.value = v },
				(v: number) => { ageMax.value = v },
				() : number => ageLo.value,
				() : number => ageHi.value)
		})
	}
	const onAgeTrackTouchMove = (e: any) => {
		if (dragTarget.value != 'age') return
		const touch = e.touches != null && e.touches.length > 0 ? e.touches[0] : null
		if (touch == null) return
		const x = Number(touch.clientX)
		if (dragPending.value) {
			const dx = x - Number(dragStartX.value)
			if (Math.abs(dx) < 2) return
			dragPending.value = false
			dragLo.value = resolveDragLo(dx, AGE_MIN, AGE_MAX, () : number => ageLo.value, () : number => ageHi.value)
		}
		applyTrackValue(x, AGE_MIN, AGE_MAX - AGE_MIN,
			(v: number) => { ageMin.value = v },
			(v: number) => { ageMax.value = v },
			() : number => ageLo.value,
			() : number => ageHi.value)
	}
	const onHeightTrackTouchStart = (e: any) => {
		const touch = e.touches != null && e.touches.length > 0 ? e.touches[0] : null
		if (touch == null) return
		queryRect('height-track', (rect: any) => {
			if (rect == null) return
			dragRect.value = rect
			const x = Number(touch.clientX)
			const loX = Number(rect.left) + Number(rect.width) * (Number(heightMin.value == null ? HEIGHT_MIN : heightMin.value) - HEIGHT_MIN) / (HEIGHT_MAX - HEIGHT_MIN)
			const hiX = Number(rect.left) + Number(rect.width) * (Number(heightMax.value == null ? HEIGHT_MAX : heightMax.value) - HEIGHT_MIN) / (HEIGHT_MAX - HEIGHT_MIN)
			const tie = Math.abs(x - loX) == Math.abs(x - hiX)
			dragLo.value = Math.abs(x - loX) <= Math.abs(x - hiX)
			dragStartX.value = x
			dragPending.value = tie
			dragTarget.value = 'height'
			if (!tie) applyTrackValue(x, HEIGHT_MIN, HEIGHT_MAX - HEIGHT_MIN,
				(v: number) => { heightMin.value = v },
				(v: number) => { heightMax.value = v },
				() : number => heightLo.value,
				() : number => heightHi.value)
		})
	}
	const onHeightTrackTouchMove = (e: any) => {
		if (dragTarget.value != 'height') return
		const touch = e.touches != null && e.touches.length > 0 ? e.touches[0] : null
		if (touch == null) return
		const x = Number(touch.clientX)
		if (dragPending.value) {
			const dx = x - Number(dragStartX.value)
			if (Math.abs(dx) < 2) return
			dragPending.value = false
			dragLo.value = resolveDragLo(dx, HEIGHT_MIN, HEIGHT_MAX, () : number => heightLo.value, () : number => heightHi.value)
		}
		applyTrackValue(x, HEIGHT_MIN, HEIGHT_MAX - HEIGHT_MIN,
			(v: number) => { heightMin.value = v },
			(v: number) => { heightMax.value = v },
			() : number => heightLo.value,
			() : number => heightHi.value)
	}
	const onTrackTouchEnd = () => { dragTarget.value = ''; dragPending.value = false }
	const incomeStopIndex = (value: number): number => {
		let best = 0
		for (let i = 1; i < INCOME_STOPS.length; i++) {
			if (Math.abs(INCOME_STOPS[i] - value) < Math.abs(INCOME_STOPS[best] - value)) best = i
		}
		return best
	}
	const incomeLoIdx = computed((): number => incomeMin.value == null ? 0 : incomeStopIndex(Number(incomeMin.value)))
	const incomeHiIdx = computed((): number => incomeMax.value == null ? INCOME_STOPS.length - 1 : incomeStopIndex(Number(incomeMax.value)))
	const incomeLoPct = computed((): number => incomeLoIdx.value / (INCOME_STOPS.length - 1) * 100)
	const incomeHiPct = computed((): number => incomeHiIdx.value / (INCOME_STOPS.length - 1) * 100)
	const incomeZoneWidth = computed((): number => incomeHiPct.value - incomeLoPct.value)
	const incomeReadout = computed((): string => {
		const loOpen = incomeMin.value == null
		const hiIdx = incomeHiIdx.value
		if (loOpen && hiIdx == INCOME_STOPS.length - 1) return '不限'
		if (hiIdx == INCOME_STOPS.length - 1) return '' + INCOME_STOPS[incomeLoIdx.value] + 'w 以上'
		if (loOpen) return '' + INCOME_STOPS[hiIdx] + 'w 以内'
		return '' + INCOME_STOPS[incomeLoIdx.value] + 'w ~ ' + INCOME_STOPS[hiIdx] + 'w'
	})
	const applyIncomeTrackValue = (clientX: number) => {
		const rect = dragRect.value
		if (rect == null || Number(rect.width) <= 0) return
		let ratio = (clientX - Number(rect.left)) / Number(rect.width)
		ratio = Math.min(1, Math.max(0, ratio))
		const idx = Math.round(ratio * (INCOME_STOPS.length - 1))
		if (dragLo.value) incomeMin.value = INCOME_STOPS[Math.min(idx, incomeHiIdx.value)]
		else incomeMax.value = INCOME_STOPS[Math.max(idx, incomeLoIdx.value)]
	}
	const onIncomeTrackTouchStart = (e: any) => {
		const touch = e.touches != null && e.touches.length > 0 ? e.touches[0] : null
		if (touch == null) return
		queryRect('income-track', (rect: any) => {
			if (rect == null) return
			dragRect.value = rect
			const x = Number(touch.clientX)
			const cell = Number(rect.width) / (INCOME_STOPS.length - 1)
			const loX = Number(rect.left) + cell * incomeLoIdx.value
			const hiX = Number(rect.left) + cell * incomeHiIdx.value
			const tie = Math.abs(x - loX) == Math.abs(x - hiX)
			dragLo.value = Math.abs(x - loX) <= Math.abs(x - hiX)
			dragStartX.value = x
			dragPending.value = tie
			dragTarget.value = 'income'
			if (!tie) applyIncomeTrackValue(x)
		})
	}
	const onIncomeTrackTouchMove = (e: any) => {
		if (dragTarget.value != 'income') return
		const touch = e.touches != null && e.touches.length > 0 ? e.touches[0] : null
		if (touch == null) return
		const x = Number(touch.clientX)
		if (dragPending.value) {
			const dx = x - Number(dragStartX.value)
			if (Math.abs(dx) < 2) return
			dragPending.value = false
			dragLo.value = resolveDragLo(dx, 0, INCOME_STOPS.length - 1, () : number => incomeLoIdx.value, () : number => incomeHiIdx.value)
		}
		applyIncomeTrackValue(x)
	}
	const resetCondition = () => { hometownIndex.value = 0; residenceIndex.value = 0; ageMin.value = null; ageMax.value = null; heightMin.value = null; heightMax.value = null; incomeMin.value = null; incomeMax.value = null; education.value = ''; marriage.value = ''; certificationOnly.value = false }
	const loadHistory = () => {
		try {
			const stored = uni.getStorageSync(SEARCH_HISTORY_STORAGE_KEY)
			if (Array.isArray(stored)) historyItems.value = stored as any[]
		} catch (error) {
			console.error('[Search] history load failed', error)
		}
	}
	const buildHistoryRecord = (): any => {
		const record: any = {
			id: '' + Date.now(),
			tab: activeTab.value,
			label: '',
			aiQuery: aiQuery.value,
			targetMbtis: targetMbtis.value.slice(),
			hometownIndex: hometownIndex.value,
			residenceIndex: residenceIndex.value,
			ageMin: ageMin.value,
			ageMax: ageMax.value,
			heightMin: heightMin.value,
			heightMax: heightMax.value,
			incomeMin: incomeMin.value,
			incomeMax: incomeMax.value,
			education: education.value,
			marriage: marriage.value,
			certificationOnly: certificationOnly.value
		}
		if (record.tab == 0) record.label = `AI：${aiQuery.value.trim()}`
		else if (record.tab == 1) record.label = `MBTI：${targetMbtis.value.join(' / ')}`
		else record.label = `条件：${residenceOptions[residenceIndex.value]}，${ageReadout.value}`
		return record
	}
	const saveHistory = (record: any) => {
		const next: any[] = []
		for (let index = 0; index < historyItems.value.length; index++) {
			const item = historyItems.value[index]
			if (item != null && item.label != record.label) next.push(item)
		}
		next.unshift(record)
		if (next.length > 10) next.splice(10)
		historyItems.value = next
		try {
			uni.setStorageSync(SEARCH_HISTORY_STORAGE_KEY, next)
		} catch (error) {
			console.error('[Search] history save failed', error)
		}
	}
	const resultQuerySummary = computed(() => {
		if (activeTab.value == 0) return aiQuery.value.trim()
		if (activeTab.value == 1) return 'MBTI ' + targetMbtis.value.join(' / ')
		return residenceOptions[residenceIndex.value] + '，' + ageReadout.value
	})
	const resultProfile = (item: any): any => item != null && item.profile != null ? item.profile : (item != null ? item : {})
	const resultAvatar = (item: any): string => {
		const profile = resultProfile(item)
		return toText(profile.avatar) || '/static/portraits/profile-woman-main.webp'
	}
	const resultName = (item: any): string => {
		const profile = resultProfile(item)
		return toText(profile.name) || '认真生活的人'
	}
	const resultMeta = (item: any): string => {
		const profile = resultProfile(item)
		const age = toText(profile.age)
		const education = toText(profile.education)
		const job = toText(profile.job)
		const city = toText(profile.city)
		const parts: string[] = []
		if (age != '') parts.push(age + '岁')
		if (education != '') parts.push(education)
		if (job != '') parts.push(job)
		if (city != '') parts.push(city)
		return parts.join(' | ')
	}
	const normalizeResultList = (response: any): any[] => {
		if (response == null) return []
		const payload = response.data != null ? response.data : response
		if (Array.isArray(payload)) return payload as any[]
		if (payload.items != null && Array.isArray(payload.items)) return payload.items as any[]
		return []
	}
	const buildCurrentQuery = (): any => {
		return buildStructuredSearchParams({
			ageMin: ageMin.value,
			ageMax: ageMax.value,
			heightMin: heightMin.value,
			heightMax: heightMax.value,
			incomeMinWan: incomeMin.value,
			incomeMaxWan: incomeMax.value,
			education: education.value,
			marriage: marriage.value,
			residenceLabel: residenceOptions[residenceIndex.value]
		})
	}
	const beginSearch = async () => {
		const runId = searchRunId + 1
		searchRunId = runId
		resultState.value = 'loading'
		// 筛选变化即重置旧游标与旧结果（契约：cursor 只在同一条件集内推进）
		nextCursor.value = ''
		hasMore.value = false
		loadingMore.value = false
		updateSearchProgress(35)
		searchProgressCopy.value = '正在按条件筛选'
		resultCandidates.value = []
		resultError.value = '请检查网络后再试一次'
		try {
			const params = buildCurrentQuery()
			params.page = 1
			params.page_size = 20
			const response = await getDiscoveryRecommendations(params)
			if (runId != searchRunId) return
			if (response == null || !response.success || response.data == null) {
				resultState.value = 'error'
				resultError.value = response != null && response.message != null && ('' + response.message).trim() != '' ? '' + response.message : '搜索服务暂时不可用，请稍后再试'
				return
			}
			resultCandidates.value = response.data.items != null && Array.isArray(response.data.items) ? response.data.items as any[] : []
			nextCursor.value = response.data.nextCursor != null ? '' + response.data.nextCursor : ''
			hasMore.value = response.data.hasMore == true
			if (!await animateSearchProgress(runId, 35, 100, 420) || runId != searchRunId) return
			if (resultCandidates.value.length > 0) {
				searchProgressCopy.value = '已按条件整理出结果'
				resultState.value = 'success'
			} else {
				resultState.value = 'empty'
			}
		} catch (error) {
			if (runId != searchRunId) return
			searchRunId += 1
			console.error('[Search] result loading failed', error)
			resultState.value = 'error'
			resultError.value = '搜索服务暂时不可用，请稍后再试'
		}
	}
	const loadMoreResults = async () => {
		if (loadingMore.value || !hasMore.value || nextCursor.value == '') return
		const runId = searchRunId
		loadingMore.value = true
		try {
			if (activeTab.value == 0 && aiSnapshotId.value != '') {
				const response = await getSearchSnapshotResults(aiSnapshotId.value, nextCursor.value, 20)
				if (runId != searchRunId) return
				if (response == null || !response.success || response.data == null) { uni.showToast({ title: '加载更多失败，请稍后再试', icon: 'none' }); return }
				resultCandidates.value = resultCandidates.value.concat(searchResultItems(response))
				nextCursor.value = searchNextCursor(response)
				hasMore.value = nextCursor.value.length > 0
				return
			}
			const params = buildCurrentQuery()
			params.cursor = nextCursor.value
			params.page_size = 20
			const response = await getDiscoveryRecommendations(params)
			if (runId != searchRunId) return
			if (response == null || !response.success || response.data == null) { uni.showToast({ title: '加载更多失败，请稍后再试', icon: 'none' }); return }
			const items = response.data.items != null && Array.isArray(response.data.items) ? response.data.items as any[] : []
			resultCandidates.value = resultCandidates.value.concat(items)
			nextCursor.value = response.data.nextCursor != null ? '' + response.data.nextCursor : ''
			hasMore.value = response.data.hasMore == true
		} catch (error) {
			if (runId != searchRunId) return
			console.error('[Search] load more failed', error)
			uni.showToast({ title: '加载更多失败，请稍后再试', icon: 'none' })
		} finally {
			if (runId == searchRunId) loadingMore.value = false
		}
	}
	const submitSearch = () => {
		if (activeTab.value == 0) { saveHistory(buildHistoryRecord()); submitAiSearch(); return }
		if (activeTab.value == 1) { uni.showToast({ title: 'MBTI 筛选暂未开放', icon: 'none' }); return }
		saveHistory(buildHistoryRecord())
		beginSearch()
	}
	const retrySearch = () => {
		if (activeTab.value == 0) {
			// 已经有快照时，失败原因只可能是"读结果"这一步：只重读既有快照，
			// 不重跑 create/patch/confirm 整链（否则会重复执行同一次搜索）。
			if (aiSnapshotId.value != '') {
				resultState.value = 'loading'
				loadSnapshotResults(searchRunId, aiDraftId.value)
				return
			}
			if (aiDraftId.value != '') confirmAiSearch()
			else submitAiSearch()
			return
		}
		beginSearch()
	}
	// 调整条件：保留当前条件草稿上下文（草稿、条件、修改），只回到编辑态。
	const openSearchEditor = () => {
		invalidateAiRun()
		resultState.value = 'idle'
		searchProgress.value = 0
		// 不调用 resetAiDraftState：用户改过的条件必须留在这里可继续编辑。
	}
	// 开始新的搜索：这才需要清掉上一轮草稿与快照上下文。
	const startNewSearch = () => {
		invalidateAiRun()
		resultState.value = 'idle'
		searchProgress.value = 0
		resetAiDraftState()
	}
	const goToResultProfile = (item: any) => {
		const profile = resultProfile(item)
		const userId = Number(profile.id != null ? profile.id : (item != null && item.user_id != null ? item.user_id : (item != null ? item.id : 0)))
		if (userId <= 0) return
		uni.navigateTo({ url: '/pagesSub/userExtra/user/detail?userId=' + userId })
	}
	const applyHistory = (item: any) => {
		const tab = Number(item != null ? item.tab : 0)
		if (tab == 1) {
			if (Array.isArray(item.targetMbtis)) targetMbtis.value = item.targetMbtis as string[]
			else targetMbtis.value = []
		} else if (tab == 2) {
			hometownIndex.value = validIndex(item.hometownIndex, hometownOptions.length)
			residenceIndex.value = validIndex(item.residenceIndex, residenceOptions.length)
			ageMin.value = item.ageMin == null ? null : clampInt(item.ageMin, AGE_MIN, AGE_MAX, AGE_MIN)
			ageMax.value = item.ageMax == null ? null : clampInt(item.ageMax, AGE_MIN, AGE_MAX, AGE_MAX)
			heightMin.value = item.heightMin == null ? null : clampInt(item.heightMin, HEIGHT_MIN, HEIGHT_MAX, HEIGHT_MIN)
			heightMax.value = item.heightMax == null ? null : clampInt(item.heightMax, HEIGHT_MIN, HEIGHT_MAX, HEIGHT_MAX)
			incomeMin.value = item.incomeMin == null ? null : INCOME_STOPS[incomeStopIndex(Number(item.incomeMin))]
			incomeMax.value = item.incomeMax == null ? null : INCOME_STOPS[incomeStopIndex(Number(item.incomeMax))]
			education.value = toText(item.education)
			marriage.value = toText(item.marriage)
			certificationOnly.value = item.certificationOnly == true
		} else {
			aiQuery.value = toText(item.aiQuery)
			resetAiDraftState()
			aiDraftIdempotencyKey.value = ''
		}
		activeTab.value = tab >= 0 && tab <= 2 ? tab : 0
		resultState.value = 'idle'
		historyVisible.value = false
	}

	const openSelfSheet = () => { ownMbtiDraft.value = ownMbti.value; mbtiSheetMode.value = 'self'; mbtiSheetVisible.value = true }
	const openTargetSheet = () => { activeTrait.value = ''; mbtiSheetMode.value = 'target'; mbtiSheetVisible.value = true }
	const closeMbtiSheet = () => { mbtiSheetVisible.value = false }
	const onOwnMbtiInput = (event: any) => { ownMbtiDraft.value = toText(event.detail.value).toUpperCase() }
	const goAssessment = () => {
		closeMbtiSheet()
		uni.navigateTo({ url: '/pages/emotion-lab/emotion-lab' })
	}
	const saveOwnMbti = async () => {
		const value = ownMbtiDraft.value.trim().toUpperCase()
		if (mbtiNames[value] == null) { uni.showToast({ title: '请输入 16 型 MBTI，例如 ENTP', icon: 'none' }); return }
		savingOwnMbti.value = true
		try {
			const res = await setMyMbtiType({ mbtiType: value, source: 'self_reported', confirmed: true })
			if (!res.success) { uni.showToast({ title: res.message != null ? toText(res.message) : '保存失败，请重试', icon: 'none' }); return }
			ownMbti.value = value
			closeMbtiSheet()
			uni.showToast({ title: '已保存我的 MBTI', icon: 'success' })
		} catch (error) {
			console.error('[Search] own MBTI save failed', error)
			uni.showToast({ title: '网络不可用，请重试', icon: 'none' })
		} finally {
			savingOwnMbti.value = false
		}
	}
	const toggleTargetMbti = (code: string, trait: string) => {
		const next = targetMbtis.value.slice()
		const index = next.indexOf(code)
		if (index >= 0) next.splice(index, 1)
		else {
			if (next.length >= 5) { uni.showToast({ title: '最多选择 5 个', icon: 'none' }); return }
			next.push(code)
		}
		targetMbtis.value = next
		activeTrait.value = trait
	}

	onLoad((options: any) => { if (options != null && String(options.suggest ?? '') == '1') setTimeout(() => { onAiSuggestTap() }, 120) })
	onShow(() => { loadOwnMbti(); loadHistory() })
	onUnmounted(() => {
		// 退出页面后作废请求上下文：建议/任务回调不再更新界面。
		searchPageAlive = false
		stopAiTyping()
	})
</script>

<style scoped>
@font-face { font-family: "iconfont-home"; src: url('/static/婚恋小程序图标/首页推荐与匹配/iconfont.woff2') format('woff2'), url('/static/婚恋小程序图标/首页推荐与匹配/iconfont.woff') format('woff'); }
.ic { font-style: normal; -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale; }
.ic-home { font-family: "iconfont-home" !important; }
.ic-history:before { content: "\e658"; }
.search-page { height: 100vh; display: flex; flex-direction: column; background: var(--paper); color: var(--ink); }
.search-form-screen, .search-results-screen { height: 100%; min-height: 0; display: flex; flex: 1; flex-direction: column; }
.search-nav { position: relative; flex: 0 0 auto; display: flex; flex-direction: row; align-items: center; padding: 0 40rpx 18rpx; }
.nav-side { z-index: 1; width: 68rpx; height: 68rpx; display: flex; flex-direction: row; align-items: center; justify-content: center; border: 1rpx solid var(--line); border-radius: 999rpx; background: var(--surface); color: var(--ink2); font-size: 24rpx; font-weight: 500; }
.nav-back { font-size: 52rpx; line-height: 1; font-weight: 300; }
.nav-title { position: absolute; right: 0; left: 0; height: 68rpx; font-family: var(--sans); font-size: 42rpx; font-weight: 700; line-height: 68rpx; text-align: center; }
.search-tabs { position: relative; flex: 0 0 auto; display: flex; flex-direction: row; align-items: center; justify-content: center; gap: 48rpx; padding: 8rpx 40rpx 20rpx; }
.search-tab { padding: 12rpx 0; color: var(--ink2); font-size: 30rpx; font-weight: 500; }
.search-tab.active { color: var(--ink); font-weight: 700; }
.search-history-btn { position: absolute; right: 40rpx; top: 8rpx; bottom: 20rpx; margin: auto 0; width: 56rpx; height: 56rpx; display: flex; flex-direction: row; align-items: center; justify-content: center; border-radius: 999rpx; background: var(--warm); }
.search-history-icon { font-size: 30rpx; color: var(--accent2); line-height: 1; }
.search-scroll { flex: 1; min-height: 0; touch-action: pan-y; }
.search-panel { min-height: 100%; padding: 24rpx 40rpx 40rpx; box-sizing: border-box; }
.ai-panel { display: flex; flex-direction: column; }
.ai-input-wrap { padding: 24rpx; border: 1rpx solid var(--line); border-radius: 20rpx; background: var(--canvas); }
.ai-input { width: 100%; height: 300rpx; padding: 0; border: 0; background: transparent; color: var(--ink); font-family: var(--sans); font-size: 28rpx; line-height: 1.75; }
.ai-input-foot { display: flex; flex-direction: row; align-items: center; justify-content: flex-end; min-height: 44rpx; }
.ai-template-trigger { position: relative; overflow: hidden; display: flex; flex-direction: row; align-items: center; gap: 12rpx; padding: 12rpx 26rpx; border-radius: 999rpx; background: var(--accent-bg); box-shadow: 0 6rpx 20rpx var(--accent-glow); }
.ai-trigger-star { color: var(--accent2); font-size: 22rpx; animation: ai-trigger-breathe 2.8s ease-in-out infinite; }
.ai-trigger-text { color: var(--accent2); font-size: 22rpx; font-weight: 600; letter-spacing: .04em; }
.ai-trigger-shine { position: absolute; top: -8rpx; right: auto; bottom: -8rpx; left: -40rpx; width: 52rpx; background: var(--paper); opacity: .7; transform: translateX(0) skewX(-16deg); animation: ai-trigger-shine 4.4s ease-in-out infinite; }
.ai-drift-field { position: relative; height: 640rpx; margin-top: 8rpx; overflow: hidden; }
.drift-word { position: absolute; color: var(--ink); font-family: var(--sans); letter-spacing: .1em; animation: ai-drift 9s ease-in-out infinite alternate; }
.drift-caption { position: absolute; bottom: 32rpx; right: 0; left: 0; color: var(--muted); font-family: var(--sans); font-size: 26rpx; font-weight: 500; letter-spacing: .22em; text-align: center; }
.dw-1 { left: 6%; top: 10%; font-size: 44rpx; opacity: .12; }
.dw-2 { right: 8%; top: 7%; font-size: 32rpx; opacity: .08; animation-delay: 1.2s; }
.dw-3 { left: 40%; top: 29%; font-size: 28rpx; opacity: .1; animation-delay: 2.1s; }
.dw-4 { left: 8%; top: 50%; font-size: 26rpx; opacity: .09; animation-delay: 3s; }
.dw-5 { right: 12%; top: 45%; font-size: 38rpx; opacity: .07; animation-delay: 1.7s; }
.dw-6 { left: 17%; top: 70%; font-size: 30rpx; opacity: .1; animation-delay: 2.6s; }
.dw-7 { right: 19%; top: 69%; font-size: 42rpx; opacity: .11; animation-delay: 3.4s; }
@keyframes ai-trigger-breathe { 0% { transform: scale(1); opacity: .75; } 50% { transform: scale(1.3); opacity: 1; } 100% { transform: scale(1); opacity: .75; } }
@keyframes ai-trigger-shine { 0% { transform: translateX(0) skewX(-16deg); } 48% { transform: translateX(200px) skewX(-16deg); } 100% { transform: translateX(200px) skewX(-16deg); } }
@keyframes ai-drift { from { transform: translateY(0); } to { transform: translateY(-9px); } }
.choice-chip { flex: 0 0 auto; padding: 14rpx 22rpx; border: 1rpx solid var(--line); border-radius: 999rpx; background: var(--surface); color: var(--ink2); font-size: 24rpx; font-weight: 500; line-height: 1; }
.choice-chip.selected { border-color: var(--accent); background: var(--accent-bg); color: var(--accent2); }
.mbti-panel { display: flex; flex-direction: column; }
.personality-card { position: relative; min-height: 230rpx; padding: 34rpx; border: 1rpx solid var(--line); border-radius: 20rpx; background: var(--surface); }
.seeking-card { margin-top: 24rpx; background: var(--warm); }
.personality-label { display: block; color: var(--ink2); font-size: 25rpx; font-weight: 600; }
.personality-value { display: block; margin-top: 26rpx; color: var(--ink); font-size: 42rpx; font-weight: 600; }
.personality-note { display: block; margin-top: 12rpx; color: var(--ink2); font-size: 23rpx; font-weight: 500; }
.personality-arrow { position: absolute; right: 34rpx; bottom: 32rpx; color: var(--accent2); font-size: 42rpx; font-weight: 300; }
.selected-mbti-tags { display: flex; flex-direction: row; flex-wrap: wrap; gap: 10rpx; margin-top: 16rpx; padding-right: 48rpx; }
.mbti-tag-cloud { position: relative; height: 150rpx; margin: 16rpx 24rpx 0; color: var(--muted); opacity: .45; font-size: 24rpx; letter-spacing: .08em; }
.mbti-tag-cloud text { position: absolute; font-weight: 500; }
.mbti-tag-cloud text:nth-child(1) { top: 16rpx; left: 4%; font-size: 22rpx; }
.mbti-tag-cloud text:nth-child(2) { top: 4rpx; right: 6%; font-size: 28rpx; }
.mbti-tag-cloud text:nth-child(3) { top: 62rpx; left: 38%; font-size: 34rpx; }
.mbti-tag-cloud text:nth-child(4) { right: 20%; bottom: 6rpx; font-size: 24rpx; }
.mbti-tag-cloud text:nth-child(5) { bottom: 18rpx; left: 16%; font-size: 20rpx; }
.mbti-balance-copy { margin: auto 0 24rpx; color: var(--muted); font-family: var(--sans); font-size: 26rpx; font-weight: 500; letter-spacing: .18em; line-height: 1.8; text-align: center; }
.condition-panel { display: flex; flex-direction: column; gap: 0; padding-top: 4rpx; }
.condition-group { min-height: 112rpx; display: flex; flex-direction: row; align-items: center; justify-content: space-between; gap: 24rpx; border-bottom: 1rpx solid var(--line); }
.condition-label { width: 176rpx; flex-shrink: 0; color: var(--ink); font-size: 24rpx; font-weight: 600; line-height: 1.45; }
.condition-control { min-width: 0; flex: 1; display: flex; flex-direction: row; align-items: center; justify-content: flex-end; gap: 14rpx; }
.location-row .condition-picker, .location-row .condition-add-picker { min-width: 0; flex: 1; }
.picker-value, .condition-add { width: 100%; min-height: 78rpx; display: flex; flex-direction: row; align-items: center; justify-content: center; gap: 12rpx; padding: 0 18rpx; border: 1rpx solid transparent; border-radius: 20rpx; background: var(--canvas); color: var(--ink2); font-size: 24rpx; font-weight: 500; }
.range-control { position: relative; min-width: 0; flex: 1; height: 68rpx; margin: 0 18rpx; }
.range-track { position: absolute; left: 0; right: 0; top: 31rpx; height: 6rpx; border-radius: 999rpx; background: var(--line); }
.range-active { position: absolute; top: 31rpx; height: 6rpx; border-radius: 999rpx; background: var(--accent); }
.range-handle { position: absolute; top: 19rpx; width: 30rpx; height: 30rpx; margin-left: -15rpx; border: 1rpx solid var(--line); border-radius: 999rpx; background: var(--surface); box-shadow: var(--shadow-sm); }
.income-slider { min-width: 0; flex: 1; display: flex; flex-direction: column; }
.income-slider .range-control { flex: 0 0 auto; }
.range-scale { display: flex; flex-direction: row; justify-content: space-between; margin: 0 18rpx; color: var(--muted); font-size: 18rpx; }
.condition-range-picker { min-width: 0; flex: 1; }
.condition-toggle-group { min-height: 124rpx; }
.condition-toggle-copy { min-width: 0; flex: 1; display: flex; flex-direction: column; gap: 6rpx; }
.condition-toggle-copy .condition-label { width: auto; }
.condition-help { color: var(--ink2); font-size: 22rpx; font-weight: 500; }
.condition-toggle { width: 88rpx; height: 50rpx; flex-shrink: 0; display: flex; flex-direction: row; align-items: center; justify-content: flex-start; padding: 5rpx; border-radius: 999rpx; background: var(--line); }
.condition-toggle.active { justify-content: flex-end; background: var(--accent); }
.toggle-knob { width: 40rpx; height: 40rpx; border-radius: 999rpx; background: var(--surface); box-shadow: var(--shadow-sm); }
.advanced-heading { display: flex; flex-direction: row; align-items: center; justify-content: space-between; padding: 34rpx 0 16rpx; }
.advanced-heading .condition-label { width: auto; font-size: 29rpx; }
.filter-hint { display: flex; flex-direction: row; align-items: center; margin-bottom: 8rpx; padding: 20rpx 22rpx; border-radius: 16rpx; background: var(--canvas); color: var(--ink2); font-size: 24rpx; font-weight: 500; }
.advanced-condition-group { min-height: 120rpx; }
.condition-choice-grid { min-width: 0; flex: 1; display: flex; flex-direction: row; flex-wrap: wrap; justify-content: flex-end; gap: 12rpx; }
.condition-choice-grid .choice-chip { min-height: 66rpx; display: flex; flex-direction: row; align-items: center; justify-content: center; padding: 0 8rpx; border-color: transparent; border-radius: 16rpx; background: var(--canvas); font-size: 23rpx; font-weight: 500; text-align: center; }
.condition-choice-grid .choice-chip.selected { border-color: transparent; background: var(--accent-bg); }
.education-grid .choice-chip, .marriage-grid .choice-chip { width: 46%; }
.wide-condition-picker { min-width: 0; flex: 1; }
.wide-picker-value { width: 100%; min-height: 78rpx; display: flex; flex-direction: row; align-items: center; justify-content: space-between; padding: 0 22rpx; border-radius: 20rpx; background: var(--canvas); color: var(--ink2); font-size: 24rpx; font-weight: 500; }
.bottom-actions { flex: 0 0 auto; display: flex; flex-direction: row; align-items: center; gap: 20rpx; padding: 20rpx 40rpx calc(env(safe-area-inset-bottom) + 24rpx); background: var(--paper); box-shadow: var(--shadow-sm); }
.reset-button, .search-button { height: 96rpx; display: flex; align-items: center; justify-content: center; border-radius: 24rpx; font-size: 29rpx; font-weight: 700; }
.reset-button { width: 176rpx; border: 1rpx solid var(--line); background: var(--surface); color: var(--ink2); }
.search-button { flex: 1; background: var(--accent2); color: var(--text-invert); box-shadow: var(--shadow-md); }
.search-button.wide { width: 100%; }
.result-nav { position: relative; flex: 0 0 auto; display: flex; flex-direction: row; align-items: center; padding: 0 40rpx 18rpx; }
.result-nav-action { z-index: 1; min-width: 68rpx; color: var(--accent2); font-size: 25rpx; font-weight: 700; line-height: 68rpx; text-align: right; }
.result-scroll { min-height: 0; flex: 1; background: var(--canvas); }
.result-loading-state, .result-message-state { min-height: 980rpx; display: flex; flex-direction: column; align-items: center; box-sizing: border-box; padding: 150rpx 48rpx 80rpx; text-align: center; }
.result-orbit { position: relative; width: 246rpx; height: 246rpx; display: flex; flex-direction: row; align-items: center; justify-content: center; border-radius: 999rpx; background: var(--accent-bg); box-shadow: var(--shadow-md); overflow: visible; }
.result-orbit-ring { position: absolute; border: 1rpx solid var(--accent); border-radius: 999rpx; opacity: .6; }
.result-orbit-ring-outer { width: 246rpx; height: 246rpx; animation: result-orbit-pulse 2s ease-out infinite; }
.result-orbit-ring-inner { width: 206rpx; height: 206rpx; border-color: var(--line); border-right-color: var(--accent); animation: result-orbit-spin 3.6s linear infinite; }
.result-orbit-spark { position: absolute; width: 14rpx; height: 14rpx; border-radius: 999rpx; background: var(--accent); box-shadow: var(--shadow-sm); }
.spark-one { top: 3rpx; left: 50%; margin-left: -7rpx; animation: result-spark-one 2.4s linear infinite; }
.spark-two { right: 20rpx; bottom: 28rpx; opacity: .85; animation: result-spark-two 2.4s linear infinite; }
.spark-three { bottom: 8rpx; left: 34rpx; opacity: .7; animation: result-spark-three 2.4s linear infinite; }
.result-orbit-core { z-index: 1; width: 170rpx; height: 170rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; border: 1rpx solid var(--line); border-radius: 999rpx; background: var(--surface); color: var(--accent2); font-family: var(--sans); font-size: 48rpx; font-weight: 700; animation: result-core-breathe 2s ease-in-out infinite; }
.result-orbit-caption { margin-top: 4rpx; color: var(--ink2); font-family: var(--sans); font-size: 22rpx; font-weight: 600; letter-spacing: .12em; }
.result-progress-rail { width: 350rpx; height: 8rpx; margin-top: 52rpx; border-radius: 999rpx; background: var(--line); overflow: hidden; }
.result-progress-fill { height: 100%; border-radius: inherit; background: var(--accent); transition: width 32ms linear; }
.result-loading-title { display: block; margin-top: 54rpx; color: var(--ink); font-family: var(--sans); font-size: 38rpx; font-weight: 700; }
.result-loading-copy, .result-message-copy { display: block; margin-top: 18rpx; color: var(--ink2); font-size: 25rpx; font-weight: 500; line-height: 1.7; }
.result-preview-avatars { display: flex; flex-direction: row; justify-content: center; margin-top: 58rpx; padding-left: 18rpx; }
.result-preview-avatar { width: 72rpx; height: 72rpx; margin-left: -18rpx; border: 4rpx solid var(--canvas); border-radius: 999rpx; opacity: 0; animation: result-avatar-enter .45s ease-out forwards; }
@keyframes result-orbit-pulse { 0% { transform: scale(.9); opacity: .46; } 70% { transform: scale(1.16); opacity: 0; } 100% { transform: scale(1.16); opacity: 0; } }
@keyframes result-orbit-spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
@keyframes result-core-breathe { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.035); } }
@keyframes result-spark-one { from { transform: rotate(0deg) translateY(-2rpx); } to { transform: rotate(360deg) translateY(-2rpx); } }
@keyframes result-spark-two { from { transform: rotate(120deg) translateY(-12rpx); } to { transform: rotate(480deg) translateY(-12rpx); } }
@keyframes result-spark-three { from { transform: rotate(240deg) translateY(-8rpx); } to { transform: rotate(600deg) translateY(-8rpx); } }
@keyframes result-avatar-enter { from { transform: translateY(16rpx) scale(.86); opacity: 0; } to { transform: translateY(0) scale(1); opacity: .66; } }
.result-message-state { justify-content: center; padding-top: 40rpx; }
.result-message-mark { width: 104rpx; height: 104rpx; display: flex; flex-direction: row; align-items: center; justify-content: center; border: 1rpx solid var(--line); border-radius: 999rpx; background: var(--surface); color: var(--accent2); font-family: var(--sans); font-size: 48rpx; }
.result-message-title { display: block; margin-top: 32rpx; color: var(--ink); font-family: var(--sans); font-size: 36rpx; font-weight: 700; }
.result-secondary-button { width: 320rpx; height: 88rpx; margin-top: 46rpx; display: flex; align-items: center; justify-content: center; border: 1rpx solid var(--line); border-radius: 999rpx; background: var(--surface); color: var(--accent2); font-size: 27rpx; font-weight: 700; }
.result-success-state { min-height: 100%; padding: 34rpx 40rpx 56rpx; box-sizing: border-box; }
.result-heading { padding: 18rpx 0 36rpx; }
.result-heading-title { display: block; color: var(--ink); font-family: var(--sans); font-size: 42rpx; font-weight: 700; }
.result-heading-copy { display: block; margin-top: 14rpx; color: var(--ink2); font-size: 24rpx; font-weight: 500; line-height: 1.6; }
.result-card { min-height: 180rpx; display: flex; flex-direction: row; align-items: stretch; padding: 24rpx; border: 1rpx solid var(--line); border-radius: 24rpx; background: var(--surface); box-sizing: border-box; }
.result-card + .result-card { margin-top: 18rpx; }
.result-card.featured { min-height: 218rpx; border-color: var(--accent-bg); background: var(--paper); box-shadow: var(--shadow-sm); }
.result-avatar { width: 132rpx; height: 132rpx; flex-shrink: 0; align-self: center; border-radius: 16rpx; background: var(--warm); }
.result-avatar.featured { width: 164rpx; height: 164rpx; border-radius: 20rpx; }
.result-card-body { min-width: 0; flex: 1; display: flex; flex-direction: column; margin-left: 22rpx; }
.result-card-topline { min-height: 32rpx; display: flex; flex-direction: row; align-items: center; justify-content: space-between; }
.result-match-count { color: var(--accent2); font-size: 21rpx; font-weight: 700; }
.result-card-arrow { color: var(--muted); font-size: 38rpx; line-height: .8; }
.result-name { display: block; margin-top: 9rpx; color: var(--ink); font-family: var(--sans); font-size: 33rpx; font-weight: 700; }
.result-meta { display: block; margin-top: 8rpx; overflow: hidden; color: var(--ink2); font-size: 23rpx; font-weight: 500; line-height: 1.45; text-overflow: ellipsis; white-space: nowrap; }
.result-reasons { display: flex; flex-direction: row; flex-wrap: wrap; gap: 8rpx; margin-top: 14rpx; }
.result-reason { padding: 7rpx 14rpx; border-radius: 999rpx; background: var(--accent-bg); color: var(--accent2); font-size: 22rpx; font-weight: 500; }
.result-card-hint { display: block; margin-top: auto; padding-top: 13rpx; color: var(--ink2); font-size: 22rpx; font-weight: 500; }
.result-disclaimer { display: block; padding: 34rpx 12rpx 0; color: var(--ink2); font-size: 22rpx; font-weight: 500; line-height: 1.65; text-align: center; }
.result-bottom-actions { flex: 0 0 auto; padding: 20rpx 40rpx calc(env(safe-area-inset-bottom) + 24rpx); background: var(--paper); box-shadow: var(--shadow-sm); }
.result-primary-button { width: 100%; height: 96rpx; display: flex; align-items: center; justify-content: center; border-radius: 999rpx; background: var(--accent); color: var(--text-invert); box-shadow: var(--shadow-md); font-size: 29rpx; font-weight: 700; }
.history-list { display: flex; flex-direction: column; gap: 16rpx; }
.history-empty { padding: 36rpx 24rpx; color: var(--ink2); font-size: 26rpx; font-weight: 500; text-align: center; }
.history-item { padding: 24rpx; border-radius: 16rpx; background: var(--canvas); color: var(--ink); font-size: 26rpx; font-weight: 500; }
.sheet-copy { display: block; color: var(--ink2); font-size: 25rpx; font-weight: 500; line-height: 1.65; }
.sheet-secondary-button, .sheet-primary-button { width: 100%; height: 90rpx; margin-top: 28rpx; display: flex; align-items: center; justify-content: center; border-radius: 20rpx; font-size: 27rpx; font-weight: 700; }
.sheet-secondary-button { background: var(--accent-bg); color: var(--accent2); }
.sheet-primary-button { background: var(--accent); color: var(--text-invert); }
.manual-mbti-row { display: flex; flex-direction: row; align-items: center; gap: 16rpx; margin-top: 18rpx; }
.mbti-input { flex: 1; min-width: 0; height: 90rpx; padding: 0 22rpx; border: 1rpx solid var(--line); border-radius: 20rpx; background: var(--surface); color: var(--ink); font-size: 27rpx; text-transform: uppercase; }
.sheet-save-button { width: 124rpx; height: 90rpx; display: flex; align-items: center; justify-content: center; border-radius: 20rpx; background: var(--ink); color: var(--paper); font-size: 25rpx; font-weight: 600; }
.sheet-selection-head { display: flex; flex-direction: row; align-items: center; justify-content: space-between; min-height: 44rpx; margin-bottom: 20rpx; color: var(--accent2); font-size: 24rpx; }
.sheet-limit { color: var(--ink2); font-weight: 500; }
.mbti-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14rpx; }
.mbti-type-button { height: 86rpx; display: flex; align-items: center; justify-content: center; border: 1rpx solid var(--line); border-radius: 16rpx; background: var(--surface); color: var(--ink2); font-size: 26rpx; font-weight: 500; }
.mbti-type-button.selected { border-color: var(--accent); background: var(--accent-bg); color: var(--accent2); }
.sheet-selected-tags { display: flex; flex-direction: row; flex-wrap: wrap; align-items: center; gap: 10rpx; min-height: 54rpx; margin-top: 22rpx; }
.sheet-empty-text { color: var(--ink2); font-size: 23rpx; font-weight: 500; }

/* —— 接线收尾新增状态样式 —— */
.panel-unavailable-note { display: block; margin-top: 16rpx; color: var(--muted); font-size: 24rpx; line-height: 1.6; }
.ai-template-trigger--disabled { opacity: 0.5; }
.wide-picker-disabled { width: 100%; padding: 20rpx 24rpx; border-radius: 16rpx; background: #F1EDE6; color: var(--muted); font-size: 26rpx; }
.load-more-button { margin: 24rpx auto 8rpx; padding: 18rpx 48rpx; border-radius: 40rpx; background: #FFFFFF; border: 1rpx solid #E5E1DA; color: var(--ink); font-size: 26rpx; }
.panel-note { display: block; margin-top: 14rpx; color: var(--muted); font-size: 23rpx; line-height: 1.6; }
.ai-task-inline { display: block; margin-top: 10rpx; color: var(--accent2); font-size: 23rpx; line-height: 1.5; }
.ai-input-foot { gap: 12rpx; }
.ai-submit-button { min-width: 178rpx; height: 68rpx; padding: 0 24rpx; border-radius: 34rpx; background: var(--accent); color: var(--text-invert); font-size: 24rpx; font-weight: 700; }
.ai-submit-button[disabled] { opacity: .45; }
.ai-suggestion-row { display: flex; flex-direction: row; flex-wrap: wrap; gap: 12rpx; margin-top: 16rpx; }
.ai-suggestion-chip { padding: 10rpx 16rpx; border: 1rpx solid var(--line); border-radius: 999rpx; background: var(--surface); color: var(--ink2); font-size: 22rpx; line-height: 1.35; }
.ai-draft-panel { margin-top: 20rpx; padding: 24rpx; border: 1rpx solid var(--line); border-radius: 20rpx; background: var(--surface); }
.ai-draft-heading { display: flex; flex-direction: row; align-items: center; justify-content: space-between; }
.ai-draft-status { padding: 6rpx 14rpx; border-radius: 999rpx; background: var(--accent-bg); color: var(--accent2); font-size: 21rpx; }
.ai-condition-row { display: flex; flex-direction: row; flex-wrap: wrap; align-items: center; gap: 10rpx; padding: 18rpx 0; border-bottom: 1rpx solid var(--line); }
.ai-condition-copy { flex: 1; min-width: 180rpx; display: flex; flex-direction: column; gap: 4rpx; }
.ai-condition-name { color: var(--ink); font-size: 25rpx; font-weight: 700; }
.ai-condition-kind { color: var(--muted); font-size: 20rpx; line-height: 1.4; }
.ai-condition-input { width: 180rpx; height: 62rpx; padding: 0 12rpx; border: 1rpx solid var(--line); border-radius: 10rpx; background: var(--paper); color: var(--ink); font-size: 22rpx; }
.ai-condition-actions { display: flex; flex-direction: row; gap: 8rpx; }
.ai-condition-actions button { min-width: 70rpx; height: 56rpx; padding: 0 10rpx; border: 1rpx solid var(--line); border-radius: 10rpx; background: var(--surface); color: var(--ink2); font-size: 20rpx; }
.ai-condition-actions button.selected { border-color: var(--accent); background: var(--accent-bg); color: var(--accent2); }
.ai-result-notice { display: flex; flex-direction: column; gap: 5rpx; margin-top: 14rpx; padding: 14rpx; border-radius: 10rpx; background: var(--warm); color: var(--ink2); font-size: 21rpx; line-height: 1.5; }
.ai-result-notice-warn { background: var(--accent-bg); }
.ai-result-notice-title { color: var(--ink); font-weight: 700; }
.panel-error { display: block; margin-top: 14rpx; color: var(--accent2); font-size: 22rpx; line-height: 1.5; }
.ai-confirm-button { width: 100%; height: 76rpx; margin-top: 20rpx; border-radius: 38rpx; background: var(--accent); color: var(--text-invert); font-size: 25rpx; font-weight: 700; }
.ai-confirm-button[disabled] { opacity: .45; }
.ai-task-loading { display: flex; flex-direction: column; align-items: center; justify-content: center; padding-top: 100rpx; }
.ai-task-spinner { width: 120rpx; height: 120rpx; border: 6rpx solid var(--accent-bg); border-top-color: var(--accent); border-radius: 999rpx; animation: ai-task-spin 1s linear infinite; }
@keyframes ai-task-spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
