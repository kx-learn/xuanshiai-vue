.aia-nav {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	padding: 0 12px 10px;
}

.aia-nav-side {
	width: 40px;
	height: 40px;
	display: flex;
	align-items: center;
	justify-content: center;
}

.aia-back-icon {
	font-size: 18px;
	color: var(--aia-text);
}

.aia-nav-title {
	font-size: 17px;
	font-weight: 600;
	color: var(--aia-text);
}

/* ==================== Tab 切换 ==================== */
.aia-tabs {
	margin: 6px 16px 0;
	background-color: #ECE8E1;
	border-radius: 14px;
	padding: 4px;
	display: flex;
	flex-direction: row;
	flex-shrink: 0;
}

.aia-tab {
	flex: 1;
	height: 36px;
	border-radius: 11px;
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;
	gap: 5px;
}

.aia-tab-active {
	background-color: #FFFFFF;
}

.aia-tab-text {
	font-size: 13px;
	color: var(--aia-text-2);
}

.aia-tab-text-active {
	color: var(--aia-text);
	font-weight: 600;
}

.aia-tab-count {
	background-color: var(--aia-rose);
	border-radius: 9px;
	min-width: 17px;
	height: 17px;
	padding: 0 5px;
	display: flex;
	align-items: center;
	justify-content: center;
}

.aia-tab-count-text {
	font-size: 10px;
	font-weight: 700;
	color: #FFFFFF;
}

/* ==================== 列表区 ==================== */
.aia-body {
	flex: 1;
	min-height: 0;
	padding: 14px 16px 0;
}

.aia-state {
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	min-height: 300px;
	padding: 24px;
	text-align: center;
}

.aia-state-title {
	font-size: 15px;
	font-weight: 600;
	color: var(--aia-text);
}

.aia-state-copy {
	margin-top: 8px;
	font-size: 12px;
	line-height: 1.6;
	color: var(--aia-text-2);
}

.aia-retry {
	margin-top: 16px;
	padding: 9px 18px;
	border-radius: 8px;
	background-color: var(--aia-accent-deep);
	color: #FFFFFF;
	font-size: 12px;
}

.aia-tip {
	display: flex;
	font-size: 11px;
	line-height: 1.6;
	color: var(--aia-text-2);
	padding: 0 2px 12px;
}

.aia-bottom-spacer {
	height: 40px;
	flex-shrink: 0;
}

.aia-add-spacer {
	height: 84px;
	flex-shrink: 0;
}

/* ---------- 添加新的问答（底部固定按钮） ---------- */
.aia-add-btn {
	position: fixed;
	left: 24px;
	right: 24px;
	bottom: 24px;
	height: 52px;
	border-radius: 26px;
	background-color: var(--aia-dark);
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;
	gap: 8px;
	z-index: 10;
}

.aia-add-btn-symbol {
	font-size: 18px;
	font-weight: 600;
	color: #FFFFFF;
	line-height: 1;
}

.aia-add-btn-text {
	font-size: 15px;
	font-weight: 600;
	color: #FFFFFF;
}

/* ---------- 对话记录 ---------- */
.aia-chat-item {
	background-color: var(--aia-card);
	border-radius: 16px;
	padding: 14px 16px;
	margin-bottom: 12px;
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 12px;
}

.aia-chat-avatar {
	width: 44px;
	height: 44px;
	border-radius: 22px;
	background-color: #F0EDE7;
	display: flex;
	align-items: center;
	justify-content: center;
	flex-shrink: 0;
}

.aia-chat-avatar-icon {
	font-size: 22px;
	color: var(--aia-text-muted);
}

.aia-chat-main {
	flex: 1;
	display: flex;
	flex-direction: column;
	gap: 3px;
}

.aia-chat-name {
	font-size: 14px;
	font-weight: 600;
	color: var(--aia-text);
}

.aia-chat-topic {
	font-size: 12px;
	color: var(--aia-text-2);
}

.aia-chat-meta {
	font-size: 11px;
	color: var(--aia-text-muted);
}

/* ---------- 待回答 ---------- */
.aia-qa-item {
	background-color: var(--aia-card);
	border-radius: 18px;
	padding: 18px;
	margin-bottom: 12px;
	display: flex;
	flex-direction: column;
}

.aia-qa-head {
	display: flex;
	flex-direction: row;
	gap: 4px;
}

.aia-qa-quote {
	font-size: 34px;
	line-height: 1;
	color: var(--aia-rose);
	font-weight: 700;
	margin-top: 4px;
}

.aia-qa-q {
	flex: 1;
	font-size: 15px;
	font-weight: 600;
	line-height: 1.6;
	color: var(--aia-text);
	padding-top: 4px;
}

.aia-qa-foot {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	margin-top: 14px;
	padding-left: 26px;
}

.aia-qa-asked {
	font-size: 11px;
	color: var(--aia-text-muted);
}

/* ---------- 通用删除按钮 ---------- */
.aia-del {
	width: 26px;
	height: 26px;
	border-radius: 13px;
	display: flex;
	align-items: center;
	justify-content: center;
	flex-shrink: 0;
}

.aia-del-text {
	font-size: 17px;
	line-height: 1;
	color: var(--aia-text-muted);
}

/* ---------- 我的回答 ---------- */
.aia-ans-item {
	background-color: var(--aia-card);
	border-radius: 18px;
	padding: 18px;
	margin-bottom: 12px;
	display: flex;
	flex-direction: column;
}

.aia-ans-top {
	display: flex;
	flex-direction: row;
	align-items: flex-start;
	gap: 10px;
}

.aia-ans-q {
	flex: 1;
	display: flex;
	flex-direction: row;
	gap: 8px;
}

.aia-q-badge {
	width: 22px;
	height: 22px;
	border-radius: 8px;
	background-color: var(--aia-rose-tint);
	display: flex;
	align-items: center;
	justify-content: center;
	flex-shrink: 0;
	margin-top: 1px;
}

.aia-q-badge-text {
	font-size: 11px;
	font-weight: 700;
	color: var(--aia-rose-deep);
}

.aia-ans-q-text {
	flex: 1;
	font-size: 13px;
	line-height: 1.6;
	color: var(--aia-text-2);
}

.aia-ans-a {
	margin-top: 12px;
	border-radius: 14px;
	padding: 14px 16px;
	background-image: linear-gradient(135deg, #F5F8F3 0%, #FBF6F1 100%);
}

.aia-ans-a-text {
	font-size: 14px;
	line-height: 1.7;
	color: var(--aia-text);
}

.aia-ans-foot {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	margin-top: 12px;
}

.aia-ans-time {
	font-size: 11px;
	color: var(--aia-text-muted);
}

.aia-ans-edit {
	font-size: 12px;
	font-weight: 600;
	color: var(--aia-accent-deep);
}

/* ==================== 空状态 ==================== */
.aia-empty {
	display: flex;
	flex-direction: column;
	align-items: center;
	padding: 56px 24px;
}

.aia-empty-icon {
	width: 96px;
	height: 96px;
	border-radius: 48px;
	background-color: #F0EDE7;
	display: flex;
	align-items: center;
	justify-content: center;
	margin-bottom: 18px;
}

.aia-empty-icon-text {
	font-size: 40px;
	color: var(--aia-text-muted);
}

.aia-empty-title {
	font-size: 15px;
	font-weight: 600;
	color: var(--aia-text);
}

.aia-empty-sub {
	font-size: 12px;
	line-height: 1.7;
	color: var(--aia-text-2);
	margin-top: 8px;
	text-align: center;
}

/* ==================== 回答弹窗 ==================== */
.aia-mask {
	position: fixed;
	left: 0;
	right: 0;
	top: 0;
	bottom: 0;
	z-index: 30;
	background-color: rgba(44, 44, 44, 0.45);
	display: flex;
	align-items: center;
	justify-content: center;
	padding: 24px;
}

.aia-sheet {
	width: 100%;
	background-color: #FFFFFF;
	border-radius: 22px;
	padding: 20px 18px 18px;
	display: flex;
	flex-direction: column;
	position: relative;
}

.aia-sheet-head {
	display: flex;
	flex-direction: row;
	align-items: flex-start;
	gap: 8px;
}

.aia-sheet-close {
	width: 36px;
	height: 36px;
	border-radius: 18px;
	background-color: #F5F3EF;
	display: flex;
	align-items: center;
	justify-content: center;
	flex-shrink: 0;
}

.aia-sheet-close-text {
	font-size: 18px;
	line-height: 1;
	color: var(--aia-text-2);
}

.aia-sheet-q {
	flex: 1;
	display: flex;
	flex-direction: row;
	gap: 9px;
	align-items: flex-start;
}

.aia-sheet-q-text {
	flex: 1;
	font-size: 15px;
	font-weight: 600;
	line-height: 1.6;
	color: var(--aia-text);
}

.aia-sheet-q-input {
	flex: 1;
	font-size: 15px;
	font-weight: 600;
	color: var(--aia-text);
	border-bottom-width: 1px;
	border-bottom-style: solid;
	border-bottom-color: #ECE8E1;
	padding: 2px 0 8px;
}

.aia-sheet-input {
	margin-top: 14px;
	background-color: #F5F6F4;
	border-radius: 14px;
	padding: 13px 14px;
}

.aia-textarea {
	width: 100%;
	height: 120px;
	font-size: 14px;
	line-height: 1.7;
	color: var(--aia-text);
}

.aia-ph {
	color: #B9B7B1;
}

.aia-sheet-foot {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	margin-top: 12px;
}

.aia-count {
	font-size: 12px;
	color: var(--aia-text-muted);
}

.aia-submit {
	width: 44px;
	height: 44px;
	border-radius: 22px;
	background-color: #ECEAE4;
	display: flex;
	align-items: center;
	justify-content: center;
}

.aia-submit-ready {
	background-color: var(--aia-dark);
}

.aia-submit-icon {
	font-size: 16px;
	color: var(--aia-text);
}

.aia-submit-ready .aia-submit-icon {
	color: #FFFFFF;
}

