<template>
	<view class="aia-page">
		<!-- 导航栏 -->
		<view class="aia-nav" :style="{ paddingTop: statusBarHeight + 'px' }">
			<view class="aia-nav-side" @tap="back">
				<text class="ic ic-sys ic-fanhui aia-back-icon"></text>
			</view>
			<text class="aia-nav-title">我的AI分身</text>
			<view class="aia-nav-side"></view>
		</view>

		<!-- Tab 切换 -->
		<view class="aia-tabs">
			<view class="aia-tab" :class="{ 'aia-tab-active': activeTab == 0 }" @tap="switchTab(0)">
				<text class="aia-tab-text" :class="{ 'aia-tab-text-active': activeTab == 0 }">对话记录</text>
			</view>
			<view class="aia-tab" :class="{ 'aia-tab-active': activeTab == 1 }" @tap="switchTab(1)">
				<text class="aia-tab-text" :class="{ 'aia-tab-text-active': activeTab == 1 }">待回答</text>
				<view v-if="pendingQuestions.length > 0" class="aia-tab-count">
					<text class="aia-tab-count-text">{{ pendingQuestions.length }}</text>
				</view>
			</view>
			<view class="aia-tab" :class="{ 'aia-tab-active': activeTab == 2 }" @tap="switchTab(2)">
				<text class="aia-tab-text" :class="{ 'aia-tab-text-active': activeTab == 2 }">我的回答</text>
			</view>
		</view>

		<!-- 列表区 -->
		<scroll-view scroll-y class="aia-body" enhanced show-scrollbar="false">
			<view v-if="loading" class="aia-state">
				<text class="aia-state-title">正在读取 AI 分身数据</text>
			</view>
			<view v-else-if="errorMessage != ''" class="aia-state">
				<text class="aia-state-title">AI 分身暂时无法打开</text>
				<text class="aia-state-copy">{{ errorMessage }}</text>
				<view class="aia-retry" @tap="loadDashboard"><text>重新加载</text></view>
			</view>
			<view v-else>
			<!-- Tab 1：对话记录 -->
			<view v-if="activeTab == 0">
				<text class="aia-tip">为保护双方隐私，访客身份与具体聊天内容对你不可见，仅展示匿名话题摘要。当前数据保存在本设备，仅用于前端演示。</text>
				<view v-if="chatRecords.length > 0">
					<view class="aia-chat-item" v-for="item in chatRecords" :key="item.id">
						<view class="aia-chat-avatar">
							<text class="ic ic-social ic-touxiang aia-chat-avatar-icon"></text>
						</view>
						<view class="aia-chat-main">
							<text class="aia-chat-name">匿名访客</text>
							<text class="aia-chat-topic">{{ item.topic }}</text>
							<text class="aia-chat-meta">{{ item.count }} 条对话 · {{ item.time }}</text>
						</view>
					</view>
				</view>
				<view v-else class="aia-empty">
					<view class="aia-empty-icon">
						<text class="ic ic-social ic-pinglun aia-empty-icon-text"></text>
					</view>
					<text class="aia-empty-title">还没有访客与你的分身对话</text>
					<text class="aia-empty-sub">完善个人资料，分身会更好地替你回答访客的提问</text>
				</view>
			</view>

			<!-- Tab 2：待回答 -->
			<view v-if="activeTab == 1">
			<text class="aia-tip">这些问题来自访客与 AI 分身的对话。你提交回答后，会用于后续 AI 分身回复；访客不会看到你的私人资料或联系方式。</text>
				<view v-if="pendingQuestions.length > 0">
					<view class="aia-qa-item" v-for="item in pendingQuestions" :key="item.id" @tap="openPending(item)">
						<view class="aia-qa-head">
							<text class="aia-qa-quote">“</text>
							<text class="aia-qa-q">{{ item.question }}</text>
						</view>
						<view class="aia-qa-foot">
							<text class="aia-qa-asked">被问 {{ item.askedCount }} 次</text>
							<view class="aia-del" @tap.stop="deletePending(item.id)">
								<text class="aia-del-text">×</text>
							</view>
						</view>
					</view>
				</view>
				<view v-else class="aia-empty">
					<view class="aia-empty-icon">
						<text class="ic ic-sys ic-shiming aia-empty-icon-text"></text>
					</view>
					<text class="aia-empty-title">太棒了，没有待回答的问题</text>
					<text class="aia-empty-sub">分身目前能独立应对访客的提问</text>
				</view>
			</view>

			<!-- Tab 3：我的回答 -->
			<view v-if="activeTab == 2">
			<text class="aia-tip">这些是你为 AI 分身补充的回答，可编辑或删除。保存后会同步到服务端，访客下次提问时可能看到对应回答。</text>
				<view v-if="myAnswers.length > 0">
					<view class="aia-ans-item" v-for="item in myAnswers" :key="item.id" @tap="openEdit(item)">
						<view class="aia-ans-top">
							<view class="aia-ans-q">
								<view class="aia-q-badge"><text class="aia-q-badge-text">Q</text></view>
								<text class="aia-ans-q-text">{{ item.question }}</text>
							</view>
							<view class="aia-del" @tap.stop="deleteAnswer(item.id)">
								<text class="aia-del-text">×</text>
							</view>
						</view>
						<view class="aia-ans-a">
							<text class="aia-ans-a-text">{{ item.answer }}</text>
						</view>
						<view class="aia-ans-foot">
							<text class="aia-ans-time">{{ item.time }}</text>
							<text class="aia-ans-edit">再次编辑 ›</text>
						</view>
					</view>
				</view>
				<view v-else class="aia-empty">
					<view class="aia-empty-icon">
						<text class="ic ic-sys ic-tianjia aia-empty-icon-text"></text>
					</view>
					<text class="aia-empty-title">还没有回答过问题</text>
					<text class="aia-empty-sub">你的每一条回答都会让分身更懂你</text>
				</view>
			</view>
			<view class="aia-bottom-spacer"></view>
			<view v-if="activeTab == 2" class="aia-add-spacer"></view>
			</view>
		</scroll-view>

		<!-- 添加新的问答（我的回答 Tab 底部固定按钮） -->
		<view v-if="activeTab == 2" class="aia-add-btn" @tap="openNewQA">
			<text class="aia-add-btn-symbol">+</text>
			<text class="aia-add-btn-text">添加新的问答</text>
		</view>

		<!-- 回答弹窗 -->
		<view v-if="answerVisible" class="aia-mask" @tap="closeAnswer">
			<view class="aia-sheet" @tap.stop>
				<view class="aia-sheet-head">
					<view class="aia-sheet-q">
						<view class="aia-q-badge"><text class="aia-q-badge-text">Q</text></view>
						<text v-if="answerMode != 'new'" class="aia-sheet-q-text">{{ answerQuestion }}</text>
						<input v-else class="aia-sheet-q-input" :value="answerQuestion" @input="onQuestionInput" placeholder="请输入新的问答题目" placeholder-class="aia-ph" maxlength="50" />
					</view>
					<view class="aia-sheet-close" @tap.stop="closeAnswer">
						<text class="aia-sheet-close-text">×</text>
					</view>
				</view>
				<view class="aia-sheet-input">
					<textarea
						class="aia-textarea"
						:value="answerText"
						@input="onAnswerInput"
						maxlength="500"
						placeholder="输入你的回答"
						placeholder-class="aia-ph"
						:show-confirm-bar="false"
						:disable-default-padding="true"
						:cursor-spacing="16"
					/>
				</view>
				<view class="aia-sheet-foot">
					<text class="aia-count">{{ answerText.length }}/500</text>
					<view class="aia-submit" :class="{ 'aia-submit-ready': answerText.length > 0 }" @tap="submitAnswer">
						<text class="ic ic-sys ic-jiantou-you aia-submit-icon"></text>
					</view>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
import {
	getAiAvatarOwnerId,
	getAiAvatarOwnerDashboard,
	submitAiAvatarOwnerAnswer,
	addAiAvatarOwnerAnswer,
	deleteAiAvatarOwnerQuestion,
	deleteAiAvatarOwnerAnswer
} from '@/api'

const systemInfo = uni.getSystemInfoSync()
const statusBarHeight = systemInfo.statusBarHeight != null ? systemInfo.statusBarHeight : 20

const activeTab = ref(0)
const ownerId = ref(0)
const loading = ref(true)
const errorMessage = ref('')
const chatRecords = ref<any[]>([])
const pendingQuestions = ref<any[]>([])
const myAnswers = ref<any[]>([])

const answerVisible = ref(false)
const answerMode = ref('pending') // pending=回答转交问题 / edit=编辑已有回答 / new=新增问答
const answerQuestion = ref('')
const answerText = ref('')
const editingId = ref('')

const applyDashboard = (data: any) => {
	const value = data != null && typeof data == 'object' ? data : {}
	chatRecords.value = Array.isArray(value.chatRecords) ? value.chatRecords : []
	pendingQuestions.value = Array.isArray(value.pendingQuestions) ? value.pendingQuestions : []
	myAnswers.value = Array.isArray(value.myAnswers) ? value.myAnswers : []
}

const loadDashboard = async () => {
	loading.value = true
	errorMessage.value = ''
	ownerId.value = getAiAvatarOwnerId()
	try {
		const res = await getAiAvatarOwnerDashboard(ownerId.value)
		if (!res.success || res.data == null) {
			errorMessage.value = res.message != null ? String(res.message) : '请先登录后管理 AI 分身'
			return
		}
		applyDashboard(res.data)
	} catch (error) {
		console.error('AI 分身管理数据加载失败', error)
		errorMessage.value = '网络或本地数据异常，请稍后重试'
	} finally {
		loading.value = false
	}
}

const back = () => { uni.navigateBack({ delta: 1 }) }
const switchTab = (idx: number) => { activeTab.value = idx }

const openPending = (item: any) => {
	answerMode.value = 'pending'
	editingId.value = String(item.id)
	answerQuestion.value = '' + item.question
	answerText.value = ''
	answerVisible.value = true
}

const openEdit = (item: any) => {
	answerMode.value = 'edit'
	editingId.value = String(item.id)
	answerQuestion.value = '' + item.question
	answerText.value = '' + item.answer
	answerVisible.value = true
}

const closeAnswer = () => {
	answerText.value = ''
	answerVisible.value = false
}

const openNewQA = () => {
	answerMode.value = 'new'
	editingId.value = ''
	answerQuestion.value = ''
	answerText.value = ''
	answerVisible.value = true
}

const onQuestionInput = (e: any) => { answerQuestion.value = e.detail.value }

const onAnswerInput = (e: any) => { answerText.value = e.detail.value }

const submitAnswer = async () => {
	const value = answerText.value != null ? String(answerText.value).trim() : ''
	const question = answerQuestion.value != null ? String(answerQuestion.value).trim() : ''
	if (answerMode.value == 'new' && question == '') {
		uni.showToast({ title: '先输入新的问答题目', icon: 'none' })
		return
	}
	if (value == '') {
		uni.showToast({ title: '先写点内容再提交', icon: 'none' })
		return
	}
	if (answerMode.value == 'new') {
		const res = await addAiAvatarOwnerAnswer(ownerId.value, question, value)
		if (!res.success) {
			uni.showToast({ title: res.message != null ? String(res.message) : '添加失败', icon: 'none' })
			return
		}
		if (res.data != null) applyDashboard(res.data)
		uni.showToast({ title: '已添加，将同步给你的分身', icon: 'none' })
	} else if (answerMode.value == 'pending') {
		const res = await submitAiAvatarOwnerAnswer(ownerId.value, editingId.value, value)
		if (!res.success) {
			uni.showToast({ title: res.message != null ? String(res.message) : '提交失败', icon: 'none' })
			return
		}
		if (res.data != null) applyDashboard(res.data)
		uni.showToast({ title: '已保存到 AI 分身', icon: 'none' })
	} else {
		const res = await submitAiAvatarOwnerAnswer(ownerId.value, editingId.value, value)
		if (!res.success) {
			uni.showToast({ title: res.message != null ? String(res.message) : '保存失败', icon: 'none' })
			return
		}
		if (res.data != null) applyDashboard(res.data)
		uni.showToast({ title: '已保存修改', icon: 'none' })
	}
	answerText.value = ''
	answerVisible.value = false
}

const deletePending = (id: any) => {
	uni.showModal({
		title: '删除待回答问题',
		content: '删除后不会再显示这个问题，确定继续吗？',
		confirmText: '删除',
		success: async (result: any) => {
			if (result.confirm !== true) return
			const res = await deleteAiAvatarOwnerQuestion(ownerId.value, String(id))
			if (res.success && res.data != null) applyDashboard(res.data)
			uni.showToast({ title: res.success ? '已删除' : '删除失败', icon: 'none' })
		}
	})
}

const deleteAnswer = (id: any) => {
	uni.showModal({
		title: '删除本人回答',
		content: '删除后 AI 分身将不再使用这条演示答案，确定继续吗？',
		confirmText: '删除',
		success: async (result: any) => {
			if (result.confirm !== true) return
			const res = await deleteAiAvatarOwnerAnswer(ownerId.value, String(id))
			if (res.success && res.data != null) applyDashboard(res.data)
			uni.showToast({ title: res.success ? '已删除' : '删除失败', icon: 'none' })
		}
	})
}

onMounted(() => { loadDashboard() })
onShow(() => { if (!answerVisible.value) loadDashboard() })
</script>

<style>
/* ==================== 页面级变量（与「我的」页一致的暖调色系） ==================== */
page {
	--aia-bg: #F7F4F0;
	--aia-card: #FFFFFF;
	--aia-dark: #3A3A3A;
	--aia-accent: #8FA88A;
	--aia-accent-deep: #6E8A6A;
	--aia-accent-tint: #EDF2EA;
	--aia-rose: #D4A89E;
	--aia-rose-deep: #B98A7E;
	--aia-rose-tint: #F9EFE9;
	--aia-text: #2C2C2C;
	--aia-text-2: #8E8E8A;
	--aia-text-muted: #C5C3BE;
	background-color: var(--aia-bg);
}

.aia-page {
	height: 100vh;
	min-height: 100vh;
	background-color: var(--aia-bg);
	display: flex;
	flex-direction: column;
	overflow: hidden;
}

