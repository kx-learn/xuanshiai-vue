<template>
	<view class="mm-page">
		<!-- 导航栏 -->
		<view class="mm-nav" :style="{ paddingTop: navPadTop + 'px', paddingRight: (menuButtonSpacing + 8) + 'px' }">
			<view class="mm-nav-side mm-nav-back" @tap="navBack">
				<text class="mm-nav-back-text">‹</text>
			</view>
			<text class="mm-nav-title" :style="{ top: navPadTop + 'px' }">与知遇聊聊</text>
			<view class="mm-nav-side"></view>
		</view>

		<!-- Phase 2 P2-02/P2-04 —— 双阶段卡(墨相师首页,no buildMode 时展示)。
			移除顶部主体 Tab;每张卡只打开自己的独立会话。 -->
		<view v-if="!buildMode && stateResponse != null" class="mm-journey-cards">
			<view class="mm-stage-card" :class="stageCardClass('personal')" @tap="onEnterSubject('personal')">
				<text class="mm-stage-card-title">我的真实画像</text>
				<text class="mm-stage-card-sub">{{ stageCardSub('personal') }}</text>
				<text v-if="stageCardPercent('personal') > 0" class="mm-stage-card-pct">{{ stageCardPercent('personal') }}%</text>
				<view v-if="stageHasPublished('personal')" class="mm-stage-card-btn" @tap.stop="goPortrait('personal')">
					<text class="mm-stage-card-btn-text">查看成稿</text>
				</view>
				<view v-else-if="stageHasUnfinishedDraft('personal')" class="mm-stage-card-btn" @tap.stop="goPortrait('personal')">
					<text class="mm-stage-card-btn-text">继续整理</text>
				</view>
			</view>
			<view class="mm-stage-card" :class="stageCardClass('ideal_partner')" @tap="onEnterSubject('ideal_partner')">
				<text class="mm-stage-card-title">期待的长期关系</text>
				<text class="mm-stage-card-sub">{{ stageCardSub('ideal_partner') }}</text>
				<text v-if="stageCardPercent('ideal_partner') > 0" class="mm-stage-card-pct">{{ stageCardPercent('ideal_partner') }}%</text>
				<view v-if="stageHasPublished('ideal_partner')" class="mm-stage-card-btn" @tap.stop="goPortrait('ideal_partner')">
					<text class="mm-stage-card-btn-text">查看成稿</text>
				</view>
				<view v-else-if="stageHasUnfinishedDraft('ideal_partner')" class="mm-stage-card-btn" @tap.stop="goPortrait('ideal_partner')">
					<text class="mm-stage-card-btn-text">继续整理</text>
				</view>
			</view>
		</view>

		<!-- 兼容旧入口:进入某主体后,展示 MoxiangEntryState(授权/首次/恢复)。
			仅在用户已点击双阶段卡、但 buildMode 仍未就绪时显示。 -->
		<view v-if="!buildMode && stateResponse != null && pendingSubject != ''" class="mm-entry-wrap">
			<MoxiangEntryState :state="stateResponse" :subject="pendingSubject" :errorMessage="stateError" @grant-consent="grantConsentFlow" @start-chat="startChatFlow" @continue-chat="continueChatFlow" @retry="retryConnect" />
			<view class="mm-entry-back" @tap="onBackToCards">
				<text class="mm-entry-back-text">← 返回两幅画像</text>
			</view>
		</view>

		<!-- P1-D 收尾：网络/授权错误兜底(state 拉取失败但用户已 connected 时,允许重试回到 entry) -->
		<view v-if="!buildMode && stateResponse == null && stateError != ''" class="mm-entry-wrap">
			<view class="mm-state">
				<text class="mm-state-text">暂时连不上{{ masterRoleName }}</text>
				<text class="mm-state-sub">{{ stateError }}</text>
				<view class="mm-state-btn" @tap="retryConnect">
					<text class="mm-state-btn-text">重试</text>
				</view>
			</view>
		</view>

		<!-- 六维理解进度由旅程 WebSocket 实时驱动。 -->
		<MoxiangProgressPanel
			v-if="buildMode && currentSubjectSummary != null"
			:metrics="currentSubjectSummary"
			:livePercent="liveProgressPercent"
			:extractionStatus="currentExtractionStatus"
		/>
		<!-- 邀请卡仅在服务端声明的 building 阶段出现，且始终绑定其主体。 -->
		<MoxiangBuildInviteCard
			v-if="buildMode && inviteVisibleInStage && currentPendingInvite != null"
			:invite="currentPendingInvite"
			:busy="inviteBusy"
			@accept="acceptInvite"
			@snooze="snoozeInvite"
		/>
		<!-- 角色形象区 -->
		<view class="mm-hero" :class="'mm-hero-' + masterState">
			<MoxiangMasterAvatar :state="masterState" size="large" />
			<text class="mm-hero-name">{{ masterRoleName }}</text>
			<text class="mm-hero-sub">{{ statusLabel }}</text>
		</view>

		<!-- 连接中 -->
		<view v-if="connecting" class="mm-state">
			<view class="mm-steam">
				<view class="mm-steam-dot mm-steam-dot-1"></view>
				<view class="mm-steam-dot mm-steam-dot-2"></view>
				<view class="mm-steam-dot mm-steam-dot-3"></view>
			</view>
			<text class="mm-state-text">正在连接{{ masterRoleName }}</text>
		</view>

		<!-- 错误/降级 -->
		<view v-else-if="connectError != ''" class="mm-state">
			<text class="mm-state-text">连接失败</text>
			<text class="mm-state-sub">{{ connectError }}</text>
			<view class="mm-state-btn" @tap="retryConnect">
				<text class="mm-state-btn-text">重试</text>
			</view>
		</view>

		<!-- 对话主体 -->
		<view v-else-if="sessionStarted" class="mm-body">
			<!-- 消息流 -->
			<scroll-view scroll-y class="mm-flow" enhanced :show-scrollbar="false" :scroll-into-view="scrollAnchor" :scroll-with-animation="true">
				<view v-if="visibleMessages.length == 0" class="mm-empty">
					<text class="mm-empty-title">从一句近况开始</text>
					<text class="mm-empty-sub">说说最近在想什么，{{ masterRoleName }}会帮你慢慢整理。</text>
				</view>
				<view v-for="msg in visibleMessages" :key="msg.id" :id="'msg-' + msg.id">
					<!-- 墨相师消息(左) -->
					<view v-if="msg.role == 'master'" class="mm-msg mm-msg-left">
						<view class="mm-msg-avatar">
							<MoxiangMasterAvatar :state="masterState" size="small" />
						</view>
						<view class="mm-bubble mm-bubble-master">
							<text class="mm-bubble-text">{{ msg.text }}</text>
							<view v-if="msg.canListen && msg.text != ''" class="mm-listen" @tap="playTTS(msg.text)">
								<text class="mm-listen-text">听它读</text>
							</view>
						</view>
					</view>

					<!-- 用户消息(右) -->
					<view v-if="msg.role == 'user'" class="mm-msg mm-msg-right">
						<view class="mm-bubble mm-bubble-user">
							<text class="mm-bubble-text">{{ msg.text }}</text>
						</view>
					</view>

					<!-- 思考中 -->
					<view v-if="msg.role == 'typing'" class="mm-msg mm-msg-left">
						<view class="mm-msg-avatar">
						<MoxiangMasterAvatar state="thinking" size="small" />
						</view>
						<view class="mm-bubble mm-bubble-master mm-typing">
							<view class="mm-dot"></view>
							<view class="mm-dot"></view>
							<view class="mm-dot"></view>
						</view>
					</view>

					<!-- 确认卡片(建构模式) -->
					<view v-if="msg.role == 'card' && msg.card != null" class="mm-msg mm-msg-left">
						<view class="mm-msg-avatar">
						<MoxiangMasterAvatar state="thinking" size="small" />
						</view>
						<view class="mm-card">
							<view class="mm-card-head" @tap="toggleCard(msg)">
								<text class="mm-card-title">我想和你确认一件小事</text>
								<text class="mm-card-fold">{{ cardProgressLabel(msg) }}</text>
							</view>
							<view v-if="msg.collapsed != true" class="mm-card-list">
								<view v-for="item in msg.card.items" :key="item.fieldKey">
									<view v-if="item.fieldKey == currentCardItemKey(msg)" class="mm-card-item">
										<text v-if="item.category != ''" class="mm-card-cat">{{ categoryLabel(item.category) }}</text>
										<text v-if="item.content != ''" class="mm-card-content">{{ item.content }}</text>
										<text v-if="item.displayValue != ''" class="mm-card-value">{{ cardValueText(item) }}</text>
										<view class="mm-card-actions">
											<view class="mm-card-btn mm-card-btn-primary" :class="{ 'mm-card-btn-disabled': msg.confirming == true }" @tap="confirmCardItem(msg)">
												<text class="mm-card-btn-text-primary">✓ 确认这一条</text>
											</view>
											<view class="mm-card-btn" @tap="startEdit(item)">
												<text class="mm-card-btn-text">需要修改</text>
											</view>
											<view class="mm-card-btn" @tap="deleteItem(msg.card, item)">
												<text class="mm-card-btn-text">删除</text>
											</view>
										</view>
										<view v-if="editingKey == item.fieldKey" class="mm-card-edit">
											<textarea class="mm-card-textarea" v-model="editText" :maxlength="200" placeholder="改成…" />
											<view class="mm-card-actions">
												<view class="mm-card-btn mm-card-btn-primary" @tap="submitEdit(msg.card, item)">
													<text class="mm-card-btn-text-primary">保存修改</text>
												</view>
												<view class="mm-card-btn" @tap="cancelEdit">
													<text class="mm-card-btn-text">取消</text>
												</view>
											</view>
										</view>
									</view>
								</view>
							</view>
						</view>
					</view>
				</view>
				<view class="mm-flow-bottom"></view>
			</scroll-view>

			<!-- 语音实时转写(说话中显示) -->
			<view v-if="masterState == 'listening' && partialText != ''" class="mm-partial">
				<text class="mm-partial-text">{{ partialText }}</text>
			</view>

			<!-- 语音模式 TTS 播报提示 -->
			<view v-if="lastTTSUrl != ''" class="mm-tts-bar">
				<text class="mm-tts-label">{{ masterRoleName }}说完了</text>
				<view class="mm-tts-replay" @tap="replayTTS">
					<text class="mm-tts-replay-text">再听一遍</text>
				</view>
				<view class="mm-tts-close" @tap="closeTTS">
					<text class="mm-tts-close-text">收起</text>
				</view>
			</view>

			<!-- 底部输入区 -->
			<view class="mm-input-bar">
				<!-- 文字模式 -->
				<view v-if="inputMode == 'text'" class="mm-input-row">
					<input
						class="mm-input"
						v-model="inputText"
						placeholder="告诉知遇你的想法，或者聊聊今天的心情…"
						:adjust-position="true"
						confirm-type="send"
						@confirm="sendText"
						:disabled="masterState == 'thinking'"
					/>
					<view
						class="mm-send-btn"
						:class="{ 'mm-send-active': inputText.length > 0 && masterState != 'thinking' }"
						@tap="sendText"
					>
						<text class="mm-send-text">发送</text>
					</view>
					<view class="mm-mode-btn" @tap="switchToVoice">
						<text class="mm-mode-btn-icon">🎤</text>
					</view>
				</view>

				<!-- 语音模式 -->
				<view v-else class="mm-input-row">
					<view class="mm-mode-btn" @tap="switchToText">
						<text class="mm-mode-btn-icon">⌨</text>
					</view>
					<view
						class="mm-voice-btn"
						:class="{ 'mm-voice-active': masterState == 'listening' }"
						@tap="toggleVoice"
					>
						<text class="mm-voice-btn-text">{{ voiceActionLabel }}</text>
					</view>
					<view
						v-if="masterState == 'idle' && lastReplyText != ''"
						class="mm-listen-btn"
						@tap="requestTTS"
					>
						<text class="mm-listen-btn-text">听它读</text>
					</view>
				</view>
			</view>
		</view>
		<XsaMoxiangTrace :trace="devMoxiangTrace" />
	</view>
</template>

<script setup lang="uts">
import MoxiangMasterAvatar from '@/components/MoxiangMasterAvatar.uvue'
import MoxiangEntryState from '@/components/moxiang/MoxiangEntryState.uvue'
import MoxiangProgressPanel from '@/components/moxiang/MoxiangProgressPanel.uvue'
import MoxiangBuildInviteCard from '@/components/moxiang/MoxiangBuildInviteCard.uvue'
import XsaMoxiangTrace from '@/components/XsaMoxiangTrace.uvue'
import { MasterWS, MASTER_ROLE_NAME, ConfirmCardPayload, ConfirmCardItem, BuildInvitePayload, JourneyStage, JourneyProgress, ExtractionStatus, classifyMasterWSError } from '@/api/voice-master-ws.uts'
import { resolveMediaUrl } from '@/api/config.uts'
import { ProfileSubject, getProfileDraft, patchProfileDraft, fieldAction, getAiConsents, grantProfileTextConsent } from '@/api/ai-profile.uts'
import { getMoxiangState, getSessionTurns, getMoxiangArchive, MoxiangStateResponse, MoxiangSubjectSummary, MoxiangTurn, MoxiangArchiveResponse, ArchiveSubject } from '@/api/ai-moxiang.uts'
import { displayFieldValue } from '@/utils/profile-field-display.uts'
import { categoryLabel } from '@/utils/moxiang-dimension.uts'
import { loadMoxiangTrace } from '@/utils/moxiangTrace.uts'
import { PcmPlayer } from '@/utils/pcm-player.uts'

// ===== 导航与安全区域 =====
const systemInfo = uni.getSystemInfoSync()
const statusBarHeight = systemInfo.statusBarHeight != null ? systemInfo.statusBarHeight : 20
const menuButtonInfo = uni.getMenuButtonBoundingClientRect()
const navPadTop = menuButtonInfo != null && menuButtonInfo.top > statusBarHeight ? menuButtonInfo.top : statusBarHeight + 6
const menuButtonSpacing = menuButtonInfo != null ? (systemInfo.windowWidth - menuButtonInfo.left) : 8

// ===== 状态 =====
// 产品能力仍叫“墨相”，对话中的 AI 角色使用独立身份名，避免把 LLM
// provider/model 或能力名误当成用户正在交流的对象。
const masterRoleName = MASTER_ROLE_NAME
const connecting = ref(true)
const connectError = ref('')
const sessionStartFailed = ref(false)
const masterState = ref('idle')  // idle / thinking / listening / speaking
const inputMode = ref('text')    // text / voice
const inputText = ref('')
const partialText = ref('')
const lastReplyText = ref('')
const lastTTSUrl = ref('')
const lastTTSDuration = ref(0)
const scrollAnchor = ref('')
const messages = ref([] as any[])

// ===== 建构模式状态 =====
const buildMode = ref(false)
const currentSubject = ref<ProfileSubject>('personal')
// Phase 2 P2-02：pendingSubject 记录用户从双阶段卡选择但 buildMode 还没就绪的主体;
// buildMode=true 后由 currentSubject 接管。空字符串表示用户还在双阶段卡。
const pendingSubject = ref<ProfileSubject | ''>('')
const personalExtractionStatus = ref('')
const idealPartnerExtractionStatus = ref('')
const personalLiveProgress = ref<number | null>(null)
const idealPartnerLiveProgress = ref<number | null>(null)
// 服务端 readiness 事件可能在重连时重放；按主体记忆本次页面生命周期内
// 是否已经询问过，避免同一门槛重复弹窗。
const buildPromptShown = ref<{ personal: boolean; ideal_partner: boolean }>({
	personal: false,
	ideal_partner: false
})
let personalDraft: ConfirmCardPayload | null = null
let idealPartnerDraft: ConfirmCardPayload | null = null
let personalCard: ConfirmCardPayload | null = null
let idealPartnerCard: ConfirmCardPayload | null = null
const visibleMessages = computed((): any[] => {
	const subject = currentSubject.value
	return messages.value.filter((msg: any) => msg.subject == subject)
})

// ===== Phase 1 Contract v1.1 P1-D：state / history / build_invite =====
const stateResponse = ref<MoxiangStateResponse | null>(null)
const stateError = ref('')
// 档案聚合：入口卡「查看成稿 / 继续整理」按钮的数据源。发布后活动会话关闭、
// state 无 session，archive 是唯一能同时看到 currentRevision 与 activeDraft
// 的只读聚合；拉取失败只影响成稿入口，不阻塞对话。
const portraitArchive = ref<MoxiangArchiveResponse | null>(null)
// 组件用 camelCase 字段；WS payload 本身是 snake_case，这里适配为组件 shape。
interface InviteViewItem {
	profileDimension: string
	content: string
	confidence: number
}
interface InviteView {
	inviteId: string
	subject: ProfileSubject
	journeyStage: JourneyStage
	candidateCount: number
	dimensionCount: number
	effectiveTurnCount: number
	summaryItems: InviteViewItem[]
}
const pendingInvite = ref<InviteView | null>(null)
const inviteBusy = ref(false)
const sessionStarted = ref(false)
const restoredTurnIds = ref<Set<string>>(new Set())
// One-time openings are identified by subject + server session + text so a
// stale/replayed event is deduped while an explicit new session can welcome
// the user again.
const openingMessageKeys = new Set<string>()
const showEntry = computed((): boolean => stateResponse.value == null)
const currentSubjectSummary = computed((): MoxiangSubjectSummary | null => {
	if (stateResponse.value == null) return null
	return currentSubject.value == 'ideal_partner'
		? stateResponse.value.idealPartner
		: stateResponse.value.personal
})
// P1-D 收尾：build_invite 仅在 journey_stage=building 时展示，避免误触发。
const currentJourneyStage = computed((): string => {
	const summary = currentSubjectSummary.value
	if (summary == null) return 'chatting'
	return summary.journeyStage
})
const inviteVisibleInStage = computed((): boolean => {
	return currentJourneyStage.value == 'building'
})
const currentPendingInvite = computed((): InviteView | null => {
	const invite = pendingInvite.value
	if (invite == null || invite.subject != currentSubject.value) return null
	return invite
})

/**
 * 只负责询问并启动建档；旅程邀请先接受后生成草稿卡，绝不自动发布。
 * subject 在回调里再次校验，防止用户切换主体后误打开另一幅画像。
 */
function maybePromptBuild(subject: ProfileSubject, inviteId: string = '') {
	if (buildPromptShown.value[subject]) return
	if (subject != currentSubject.value) return
	buildPromptShown.value[subject] = true
	const title = subject == 'personal' ? '我的墨相可以开始构建了' : '愿遇之相可以开始构建了'
	uni.showModal({
		title,
		content: '我们已经收集到足够内容。现在开始构建画像吗？构建后会先给你一份可审阅的预览，确认后才会发布。',
		confirmText: '现在构建',
		cancelText: '稍后再说',
		success: (res: any) => {
			if (res.confirm && subject == currentSubject.value) {
				// 旅程门槛由 build_invite 权威确认；先接受邀请生成草稿，
				// 再由服务端推送 confirm_card，不能把候选直接当成已发布画像。
				if (inviteId == '') return
				if (ws == null || !ws.isConnected()) {
					inviteBusy.value = false
					uni.showToast({ title: '整理邀请尚未连接，请稍后重试', icon: 'none' })
					return
				}
				inviteBusy.value = true
				ws.acceptBuildInvite(subject, inviteId)
			}
		}
	})
}

function syncGateFromState(subject: ProfileSubject) {
	const response = stateResponse.value
	if (response == null) return
	const summary = subject == 'ideal_partner' ? response.idealPartner : response.personal
	const inviteId = String(summary.pendingBuildInviteId ?? '')
	if (summary.journeyStage == 'building' && inviteId != '' && ws != null && ws.isConnected()) {
		maybePromptBuild(subject, inviteId)
	}
}

function draftBySubject(subject: ProfileSubject): ConfirmCardPayload | null {
	return subject == 'personal' ? personalDraft : idealPartnerDraft
}

function cardBySubject(subject: ProfileSubject): ConfirmCardPayload | null {
	return subject == 'personal' ? personalCard : idealPartnerCard
}

function sessionIdForSubject(subject: ProfileSubject): string {
	if (stateResponse.value == null) return ''
	const summary = subject == 'ideal_partner' ? stateResponse.value.idealPartner : stateResponse.value.personal
	if (summary.sessionId == null) return ''
	return String(summary.sessionId)
}

function setSessionIdForSubject(subject: ProfileSubject, sessionId: string) {
	if (sessionId == '' || stateResponse.value == null) return
	const summary = subject == 'ideal_partner' ? stateResponse.value.idealPartner : stateResponse.value.personal
	summary.sessionId = sessionId
}

function setDraftBySubject(subject: ProfileSubject, card: ConfirmCardPayload | null) {
	if (subject == 'personal') personalDraft = card
	else idealPartnerDraft = card
}

function setCardBySubject(subject: ProfileSubject, card: ConfirmCardPayload | null) {
	if (subject == 'personal') personalCard = card
	else idealPartnerCard = card
}

// 兼容既有测试命名，同时确保动作始终读取卡片自身 subject/revision。
function draftState(subject: ProfileSubject): ConfirmCardPayload | null {
	return draftBySubject(subject)
}

const currentExtractionStatus = computed((): string => {
	return currentSubject.value == 'personal'
		? personalExtractionStatus.value
		: idealPartnerExtractionStatus.value
})
const liveProgressPercent = computed((): number | null => {
	return currentSubject.value == 'personal'
		? personalLiveProgress.value
		: idealPartnerLiveProgress.value
})
const editingKey = ref('')
const editText = ref('')

let ws: MasterWS | null = null
let recorderManager: any = null
let audioContext: any = null
let chunkSeq = 0
let isRecording = false
let typingMsgId = 0

// ===== 实时语音 v2（SenseAudio,开发开关默认关;开启后走 PCM 流式播放链路）=====
const MOXIANG_REALTIME_V2_DEV = false
let realtimeV2Active = false
let currentGenerationId = ''
let lastProgressReportMs = 0
const pcmPlayer = new PcmPlayer({
	onStarted: (generationId: string) => {
		if (masterState.value == 'listening') masterState.value = 'idle'
		currentGenerationId = generationId
	},
	onProgress: (generationId: string, playedMs: number) => {
		if (generationId != currentGenerationId) return
		const now = Date.now()
		if (now - lastProgressReportMs < 500) return
		lastProgressReportMs = now
		ws?.sendPlaybackProgress(generationId, playedMs)
	},
	onFinished: (generationId: string, status: string, playedMs: number) => {
		if (generationId != currentGenerationId && status != 'interrupted') return
		currentGenerationId = ''
		ws?.sendPlaybackFinished(generationId, status, playedMs)
		// completed 后不本地抢跑:等服务端 voice_ready 自动开麦
	}
})

// ===== 计算属性 =====
const statusLabel = computed(() : string => {
	if (connecting.value) return '正在连接'
	if (masterState.value == 'thinking') return '思考中'
	if (masterState.value == 'listening') return '倾听中'
	if (masterState.value == 'speaking') return '说话中'
	return 'AI 引路人'
})

// Keep user-facing labels as plain computed strings so the mini-program
// template never renders an intermediate boolean or expression value.
const voiceActionLabel = computed(() : string => {
	return masterState.value == 'listening' ? '说完' : '说话'
})

const stageLabel = computed(() : string => {
	return currentSubject.value == 'personal' ? '正在认识你自己' : '正在聊你期待的关系'
})

// ===== Phase 2 P2-02/P2-04 双阶段卡(墨相师首页) =====
function stageCardClass(subject: ProfileSubject): string {
	if (stateResponse.value == null) return 'mm-stage-card-locked'
	const isPartner = subject == 'ideal_partner'
	const canStart = isPartner ? stateResponse.value.canStartIdealPartner : true
	if (!canStart) return 'mm-stage-card-locked'
	const summary = isPartner ? stateResponse.value.idealPartner : stateResponse.value.personal
	if (summary == null) return 'mm-stage-card-locked'
	// published → 已完成高亮;其他可点
	if (summary.publishedRevisionId != null) return 'mm-stage-card-done'
	return 'mm-stage-card-active'
}

function stageCardSub(subject: ProfileSubject): string {
	if (stateResponse.value == null) return '加载中...'
	const isPartner = subject == 'ideal_partner'
	if (isPartner && !stateResponse.value.canStartIdealPartner) return '请先完成我的墨相'
	const summary = isPartner ? stateResponse.value.idealPartner : stateResponse.value.personal
	if (summary == null) return '还没有开始'
	if (summary.publishedRevisionId != null) return '已发布'
	if (summary.sessionId != null && summary.sessionId != '') return '继续完善'
	return '开始聊聊'
}

function stageCardPercent(subject: ProfileSubject): number {
	if (stateResponse.value == null) return 0
	const summary = subject == 'ideal_partner' ? stateResponse.value.idealPartner : stateResponse.value.personal
	if (summary == null) return 0
	return Math.round(Number(summary.overallPercent ?? 0))
}

// ===== 入口卡成稿出口（发布后可见性修复）=====
function stageArchiveBlock(subject: ProfileSubject): ArchiveSubject | null {
	if (portraitArchive.value == null) return null
	return subject == 'ideal_partner' ? portraitArchive.value.idealPartner : portraitArchive.value.personal
}

// 已发布：state 的 publishedRevisionId（B3 后无活动会话也可见）或档案 currentRevision。
function stageHasPublished(subject: ProfileSubject): boolean {
	if (stateResponse.value != null) {
		const summary = subject == 'ideal_partner' ? stateResponse.value.idealPartner : stateResponse.value.personal
		if (summary != null && summary.publishedRevisionId != null) return true
	}
	const block = stageArchiveBlock(subject)
	return block != null && block.currentRevision != null
}

// 有草稿/预览但没走完发布：给「继续整理」出口。
function stageHasUnfinishedDraft(subject: ProfileSubject): boolean {
	const block = stageArchiveBlock(subject)
	if (block == null) return false
	if (block.activeDraft != null) return true
	return block.preview != null && block.preview.status == 'active'
}

async function loadPortraitArchive() {
	try {
		portraitArchive.value = await getMoxiangArchive()
	} catch (e: any) {
		// 静默：成稿入口按钮只是锦上添花，不能拖累对话主流程。
	}
}

// ===== 连接 =====
function connectWS() {
	// A retry creates a fresh socket, but the local message stream belongs to the
	// page/session and must survive the transport replacement.
	if (ws != null) {
		ws.disconnect()
		ws = null
	}
	connecting.value = true
	connectError.value = ''
	sessionStartFailed.value = false
	ws = new MasterWS({
		onSubjectChanged: (subject: ProfileSubject, sessionId?: string) => {
			currentSubject.value = subject
			setSessionIdForSubject(subject, String(sessionId ?? ''))
			removeVisibleCardMessages()
			const cached = cardBySubject(subject)
			if (cached != null) addCardMessage(cached)
			// subject_switch only acknowledges the subject; restore the target
			// session from its own state summary without mixing turn IDs/cards.
			if (stateResponse.value != null) {
				const summary = subject == 'ideal_partner' ? stateResponse.value.idealPartner : stateResponse.value.personal
				if (summary.sessionId != null && summary.sessionId != '') {
					loadSessionHistory(summary.sessionId, null, subject)
				}
				const inviteId = String(summary.pendingBuildInviteId ?? '')
				if (summary.journeyStage == 'building' && inviteId != '') {
					maybePromptBuild(subject, inviteId)
				}
			}
		},
		onJourneyReady: (subject: ProfileSubject, sessionId: string, journeyStage: JourneyStage, resumed: boolean, protocolVersion?: number) => {
			connecting.value = false
			// 实时语音 v2:仅当服务端确认 protocol_version=2 才启用 PCM 播放链路。
			realtimeV2Active = protocolVersion != null && protocolVersion == 2
			if (realtimeV2Active) {
				pcmPlayer.stopAll()
			}
			currentSubject.value = subject
			sessionStarted.value = true
			buildMode.value = true
			if (sessionId != '') {
				setSessionIdForSubject(subject, sessionId)
				loadSessionHistory(sessionId, null, subject)
			}
			if (resumed && stateResponse.value != null) {
				const bucket = subject == 'ideal_partner' ? stateResponse.value.idealPartner : stateResponse.value.personal
				bucket.sessionId = sessionId
				bucket.journeyStage = journeyStage
			}
			// REST state may restore a pending invite before the WS replays any
			// candidate events. Once the socket is ready, ask exactly once and pass
			// the server-owned invite id through the accept path.
			if (stateResponse.value != null) {
				const bucket = subject == 'ideal_partner' ? stateResponse.value.idealPartner : stateResponse.value.personal
				const inviteId = String(bucket.pendingBuildInviteId ?? '')
				if (journeyStage == 'building' && inviteId != '') {
					maybePromptBuild(subject, inviteId)
				}
			}
			if (resumed) {
				// 服务端会在重连时重放确认卡；稍等其到达，仍缺失才走 REST 兜底。
				setTimeout(() => {
					restoreConfirmCardFromRest(subject)
				}, 1500)
			}
		},
		onExtractionStatus: (status: ExtractionStatus) => {
			if (status.subject == 'personal') personalExtractionStatus.value = status.status
			else idealPartnerExtractionStatus.value = status.status
		},
		 onJourneyProgress: (progress: JourneyProgress) => {
			if (stateResponse.value == null) return
			const summary = progress.subject == 'ideal_partner'
				? stateResponse.value.idealPartner
				: stateResponse.value.personal
			if (progress.subject == 'personal') personalLiveProgress.value = progress.overallPercent
			else idealPartnerLiveProgress.value = progress.overallPercent
			summary.overallPercent = progress.overallPercent
			for (const key in progress.dimensions) {
				const incoming = progress.dimensions[key]
				const dimension: any = (summary.dimensions as any)[key]
				if (dimension != null) {
					dimension.percent = incoming.percent
					dimension.evidenceCount = incoming.evidenceCount
				}
			}
		},
		onBuildInvite: (invite: BuildInvitePayload) => {
			// P1-D 收尾：journey_stage≠building 时静默忽略,
			// 不在 chatting/ready/published 期间意外弹出邀请卡。
			if (invite.journey_stage != 'building') {
				return
			}
			const rawItems: any[] = Array.isArray(invite.summary_items) ? (invite.summary_items as any[]) : []
			const items: InviteViewItem[] = rawItems.map((it: any) => ({
				profileDimension: String(it.profile_dimension != null ? it.profile_dimension : ''),
				content: String(it.content != null ? it.content : ''),
				confidence: Number(it.confidence ?? 0)
			}))
			pendingInvite.value = {
				inviteId: String(invite.invite_id != null ? invite.invite_id : ''),
				subject: invite.subject,
				journeyStage: invite.journey_stage,
				candidateCount: Number(invite.candidate_count ?? 0),
				dimensionCount: Number(invite.dimension_count ?? 0),
				effectiveTurnCount: Number(invite.effective_turn_count ?? 0),
				summaryItems: items
			}
			// build_invite 同时是服务端阶段切换的权威通知；同步本地摘要，
			// 这样用户点“稍后再说”时邀请卡仍会留在当前对话中。
			if (stateResponse.value != null) {
				const bucket = invite.subject == 'ideal_partner'
					? stateResponse.value.idealPartner
					: stateResponse.value.personal
				bucket.journeyStage = invite.journey_stage
				bucket.pendingBuildInviteId = String(invite.invite_id ?? '')
			}
			// 门槛由服务端候选计数判定；当前主体收到邀请时先给出一次
			// 明确的“是否构建”确认。取消后保留邀请卡，用户仍可稍后处理。
			if (invite.subject == currentSubject.value) {
				maybePromptBuild(invite.subject, String(invite.invite_id ?? ''))
			}
		},
			onBuildInviteResolved: (resolution) => {
			if (pendingInvite.value != null && pendingInvite.value.inviteId == resolution.invite_id) {
				if (resolution.resolution == 'accepted') {
					pendingInvite.value = null
				} else {
					pendingInvite.value = null
				}
				inviteBusy.value = false
			}
			if (stateResponse.value != null) {
				const bucket = resolution.subject == 'ideal_partner' ? stateResponse.value.idealPartner : stateResponse.value.personal
				bucket.journeyStage = resolution.journey_stage
				bucket.pendingBuildInviteId = null
			}
		},
		onPartialTranscript: (text: string) => {
			partialText.value = text
		},
		onFinalTranscript: (text: string) => {
			partialText.value = ''
			// 把用户语音转写加入消息流
			addMessage('user', text)
		},
		onAIThinking: () => {
			masterState.value = 'thinking'
			// 在消息流末尾添加 typing 占位
			typingMsgId = Date.now()
			messages.value.push({
				id: typingMsgId,
				role: 'typing',
				text: '',
				canListen: false,
				subject: currentSubject.value
			})
			scrollToBottom()
		},
		onAIContent: (text: string) => {
			// 流式增量:把 typing 占位替换为实际内容,逐段追加
			const idx = findMsgIndex(typingMsgId)
			if (idx >= 0) {
				const m = messages.value[idx]
				m.text = m.text + text
				scrollToBottom()
			}
		},
		onAIReply: (text: string, isOpening?: boolean) => {
			if (isOpening === true) {
				// Include the server session id so a real new session can show its
				// own welcome while replayed events on the same session stay deduped.
				const openingKey = currentSubject.value + '|' + sessionIdForSubject(currentSubject.value) + '|' + text
				if (openingMessageKeys.has(openingKey)) return
				openingMessageKeys.add(openingKey)
			}
			// 完整回复:替换 typing 占位为正式消息
			const idx = findMsgIndex(typingMsgId)
			if (idx >= 0) {
				messages.value.splice(idx, 1)
			}
			addMessage('master', text, true)
			lastReplyText.value = text
			masterState.value = 'idle'
		},
		onTTSAudio: (audioUrl: string, durationMs: number) => {
			lastTTSUrl.value = audioUrl
			lastTTSDuration.value = durationMs
			masterState.value = 'speaking'
			playAudio(audioUrl)
		},
		onConfirmCard: (card: ConfirmCardPayload) => {
			// REST 兜底可能已按同一草稿重建过卡片；WS 重放同 draftId 时不再重复入流。
			const cached = cardBySubject(card.subject)
			if (cached != null && cached.draftId == card.draftId) return
			setDraftBySubject(card.subject, card)
			setCardBySubject(card.subject, card)
			editingKey.value = ''
			editText.value = ''
			if (card.subject == currentSubject.value) addCardMessage(card)
		},
		onError: (code: string, message: string) => {
			if (connecting.value) {
				sessionStartFailed.value = true
				connectError.value = message
				connecting.value = false
				// Do not let MasterWS auto-reconnect after a rejected session_start;
				// a later onSessionReady from that stale socket must not be mistaken
				// for a usable conversation.
				if (ws != null) {
					ws.disconnect()
					ws = null
				}
			} else {
				// 去重：下列 kind 由 onTypedError → handleTypedWSFailure 负责展示
				// （文案更具体）。此处只做状态清理，不再弹通用 toast，否则同一
				// 条下行 error 会连弹两个提示（会话阶段 connecting 已为 false）。
				if (!isTypedFailureHandledFor(code)) {
					uni.showToast({ title: message, icon: 'none' })
				}
				// 邀请接受/暂缓等待服务端回执；失败时解除忙状态，
				// 保留邀请卡以便用户重试，不把界面锁死。
				inviteBusy.value = false
				masterState.value = 'idle'
				// 移除 typing 占位
				const idx = findMsgIndex(typingMsgId)
				if (idx >= 0) messages.value.splice(idx, 1)
			}
		},
		// 类型化错误：按 docs/api/语音.md §4 区分「授权已撤回」与「稍后重试」。
		// 去重契约：policy_denied / temporarily_unavailable / quota_exceeded
		// 的提示在此展示，onError 通过 isTypedFailureHandledFor 跳过通用 toast
		// （会话阶段 connecting 已为 false，两条回调都会到达消费方，否则双 toast）。
		onTypedError: (kind: string, code: string, message: string) => {
			if (connecting.value) return
			handleTypedWSFailure(kind, message)
		},
		// ===== 实时语音 v2 事件(未协商成功时服务端不会推送) =====
		onVoiceReady: () => {
			if (!realtimeV2Active) return
			pcmPlayer.stopAll()
			startRecordingV2()
		},
		onInputClosed: () => {
			if (!realtimeV2Active) return
			// 服务端已关输入窗口;直接停麦,不发 audio_end(v2 由供应商 VAD 定稿)
			if (isRecording) {
				isRecording = false
				if (recorderManager != null) {
					recorderManager.stop()
				}
			}
			if (masterState.value == 'listening') masterState.value = 'thinking'
		},
		onAudioOutputStart: (generationId: string, responseId: string, sampleRate: number, format: string) => {
			if (!realtimeV2Active) return
			currentGenerationId = generationId
		},
		onAudioChunk: (generationId: string, seq: number, base64Data: string) => {
			if (!realtimeV2Active) return
			pcmPlayer.enqueue(generationId, base64Data, seq)
		},
		onAudioOutputEnd: (generationId: string, responseId: string) => {
			if (!realtimeV2Active) return
			pcmPlayer.finish(generationId)
		},
		onResponseDone: (generationId: string, status: string) => {
			if (!realtimeV2Active) return
			if (status != 'completed') {
				// 失败/打断的回复:停掉播放残留,等服务端 voice_ready 或用户操作
				if (currentGenerationId == generationId) {
					pcmPlayer.stopAll()
				}
			} else {
				pcmPlayer.finish(generationId)
			}
		},
		onCancelled: (generationId: string) => {
			if (!realtimeV2Active) return
			if (currentGenerationId == generationId || generationId != '') {
				pcmPlayer.stopAll()
			}
		},
		onClose: () => {
			inviteBusy.value = false
			pcmPlayer.stopAll()
			if (!connecting.value && sessionStarted.value) {
				uni.showToast({ title: masterRoleName + '已离开', icon: 'none' })
			}
		}
	})
	// 实时语音 v2:开发开关打开时声明协议版本与 PCM 播放能力(默认关)。
	if (MOXIANG_REALTIME_V2_DEV && ws != null) {
		ws.enableRealtimeV2()
	}
	// 双画像共用一条自然对话旅程 WebSocket；主体切换只改变当前会话绑定。
	if (ws != null) {
		ws.startJourneyMode(currentSubject.value, 'profile-text-v1')
	}
	ws.connect()
}

// ===== 消息管理 =====
function addMessage(role: string, text: string, canListen: boolean = false, subject: ProfileSubject = currentSubject.value) {
	messages.value.push({
		id: Date.now() + Math.floor(Math.random() * 1000),
		role: role,
		text: text,
		canListen: canListen,
		subject: subject
	})
	scrollToBottom()
}

function findMsgIndex(id: number) : number {
	for (let i = 0; i < messages.value.length; i++) {
		if (messages.value[i].id == id) return i
	}
	return -1
}

function scrollToBottom() {
	nextTick(() => {
		scrollAnchor.value = ''
		const last = messages.value[messages.value.length - 1]
		if (last != null) {
			scrollAnchor.value = 'msg-' + last.id
		}
	})
}

// ===== 建构模式:确认卡片 =====
function addCardMessage(card: ConfirmCardPayload) {
	// 当前阶段只显示自身的活动卡片，另一主体卡片缓存到切回时恢复。
	removeVisibleCardMessages()
	messages.value.push({
		id: Date.now() + Math.floor(Math.random() * 1000),
		role: 'card',
		text: '',
		canListen: false,
		subject: card.subject,
		card: card,
		collapsed: false,
		confirmIndex: 0,
		confirming: false
	})
	scrollToBottom()
}

function removeVisibleCardMessages() {
	for (let i = messages.value.length - 1; i >= 0; i--) {
		const m = messages.value[i]
		if (m.role == 'card') {
			messages.value.splice(i, 1)
		}
	}
}

function findCardMsgIndex(cardId: string) : number {
	for (let i = 0; i < messages.value.length; i++) {
		const m = messages.value[i]
		if (m.role == 'card' && m.card != null && m.card.cardId == cardId) return i
	}
	return -1
}

function removeCardMessage(cardId: string) {
	const idx = findCardMsgIndex(cardId)
	if (idx >= 0) {
		messages.value.splice(idx, 1)
	}
}

function removeCardItem(cardId: string, fieldKey: string) {
	const idx = findCardMsgIndex(cardId)
	if (idx < 0) return
	const card = messages.value[idx].card
	const items: any[] = card.items != null ? (card.items as any[]) : []
	const next: any[] = []
	for (let i = 0; i < items.length; i++) {
		if (items[i].fieldKey != fieldKey) {
			next.push(items[i])
		}
	}
	card.items = next
	if (next.length == 0) {
		// 全部删完:卡片随之下线
		removeCardMessage(cardId)
		setCardBySubject(card.subject, null)
	} else if (messages.value[idx].confirmIndex != null) {
		messages.value[idx].confirmIndex = Math.min(Number(messages.value[idx].confirmIndex), next.length - 1)
	}
}

function updateCardItemValue(cardId: string, fieldKey: string, newText: string) {
	const idx = findCardMsgIndex(cardId)
	if (idx < 0) return
	const card = messages.value[idx].card
	const items: any[] = card.items != null ? (card.items as any[]) : []
	for (let i = 0; i < items.length; i++) {
		if (items[i].fieldKey == fieldKey) {
			items[i].displayValue = newText
		}
	}
}

function toggleCard(msg: any) {
	msg.collapsed = msg.collapsed != true
}

function currentCardItemKey(msg: any): string {
	if (msg == null || msg.card == null || msg.card.items == null) return ''
	const items: any[] = msg.card.items as any[]
	const index = Number(msg.confirmIndex ?? 0)
	if (index < 0 || index >= items.length) return ''
	return String(items[index].fieldKey != null ? items[index].fieldKey : '')
}

function cardProgressLabel(msg: any): string {
	if (msg == null || msg.card == null || msg.card.items == null) return ''
	const total = (msg.card.items as any[]).length
	if (total == 0) return '已完成'
	const index = Math.max(0, Math.min(total - 1, Number(msg.confirmIndex ?? 0)))
	return '第 ' + (index + 1) + ' 条，共 ' + total + ' 条'
}

// #18：确认卡的结构化字段 display_value 是后端裸码（如 330100/4/single），
// 按 fieldKey 映射成中文；无映射时回落原串。entry 条目走 content，不经过这里。
function cardValueText(item: any): string {
	if (item == null) return ''
	const key = item.fieldKey != null ? String(item.fieldKey) : ''
	const dv = item.displayValue != null ? String(item.displayValue) : ''
	if (key == '' || dv == '') return dv
	const shown = displayFieldValue(key, dv, '')
	return shown != '' ? shown : dv
}

function currentRevision(card: ConfirmCardPayload) : number {
	return card.expectedRevision
}

// 乐观锁刷新链:后端每次 PATCH 都推进 expected_revision,成功动作后从草稿读最新值
async function refreshDraftState(card: ConfirmCardPayload) {
	const res = await getProfileDraft(card.draftId)
	const ds = draftState(card.subject)
	if (res.success && res.data != null && ds != null && ds.draftId == card.draftId) {
		const rev = res.data.expected_revision
		if (rev != null) {
			ds.expectedRevision = Number(rev)
			card.expectedRevision = Number(rev)
		}
	}
}

	async function confirmAll(card: ConfirmCardPayload) {
		const rev = currentRevision(card)
		const actions: any[] = []
		for (let i = 0; i < card.items.length; i++) {
			actions.push(fieldAction(card.items[i].fieldKey, 'confirm', null, rev))
		}
		const res = await patchProfileDraft(card.draftId, actions, rev)
		if (res.success) {
			removeCardMessage(card.cardId)
			setCardBySubject(card.subject, null)
			// 同步反馈走消息流而不是 toast：toast 在 redirectTo 跳转时不可靠。
			const synced = (res.data != null && res.data.synced_profile_fields != null) ? (res.data.synced_profile_fields as any[]) : []
			if (synced.length > 0 && card.subject == 'personal') {
				addMessage('master', '这几项我已顺手帮你补进了「编辑资料」，以后不用再手动填一遍。', false, card.subject)
			}
			await refreshDraftState(card)
			await loadMoxiangState()
			// 确认完成 ≠ 发布：必须把用户送到结果页点「发布这份成稿」，
			// 否则草稿永远停在已确认未发布，「我的画像」看不到成稿。
			goPortrait()
		} else {
			const msg = res.message != null ? ('' + res.message) : '确认失败,请重试'
			uni.showToast({ title: msg, icon: 'none' })
		}
	}

async function confirmCardItem(msg: any) {
	if (msg == null || msg.card == null || msg.confirming == true) return
	const card = msg.card as ConfirmCardPayload
	const itemKey = currentCardItemKey(msg)
	if (itemKey == '') return
	let item: ConfirmCardItem | null = null
	for (let i = 0; i < card.items.length; i++) {
		if (card.items[i].fieldKey == itemKey) {
			item = card.items[i]
			break
		}
	}
	if (item == null) return

		msg.confirming = true
		try {
			const rev = currentRevision(card)
			const res = await patchProfileDraft(card.draftId, [fieldAction(item.fieldKey, 'confirm', null, rev)], rev)
			if (!res.success) {
				const message = res.message != null ? ('' + res.message) : '确认失败,请重试'
				uni.showToast({ title: message, icon: 'none' })
				return
			}
			const synced = (res.data != null && res.data.synced_profile_fields != null) ? (res.data.synced_profile_fields as any[]) : []
			if (synced.length > 0 && card.subject == 'personal') {
				// 同步反馈走消息流：单条确认还留在对话里，用知遇的话术告知即可。
				addMessage('master', '这一条我也顺手帮你补进了「编辑资料」，不用再手动填。', false, card.subject)
			}
			await refreshDraftState(card)
		// 单条确认会改变六维确认数；立即重拉状态，避免进度条停留在旧快照。
		await loadMoxiangState()
		const nextIndex = Number(msg.confirmIndex ?? 0) + 1
		if (nextIndex < card.items.length) {
			msg.confirmIndex = nextIndex
			addMessage('master', '好,这一条我记下了。我们继续确认下一点。', true, card.subject)
		} else {
			removeCardMessage(card.cardId)
			setCardBySubject(card.subject, null)
			addMessage('master', '这一组内容已经逐一确认完成。我会把它整理成最后的总结,确认后就会出现在“我的墨相”。', true, card.subject)
			// 与 confirmAll 同口径：逐条确认走完也要接上发布出口。
			goPortrait()
		}
	} finally {
		msg.confirming = false
	}
}

async function deleteItem(card: ConfirmCardPayload, item: ConfirmCardItem) {
	const rev = currentRevision(card)
	const actions: any[] = [fieldAction(item.fieldKey, 'delete', null, rev)]
	const res = await patchProfileDraft(card.draftId, actions, rev)
	if (res.success) {
		removeCardItem(card.cardId, item.fieldKey)
		uni.showToast({ title: '已删除', icon: 'none' })
		await refreshDraftState(card)
		await loadMoxiangState()
	} else {
		const msg = res.message != null ? ('' + res.message) : '删除失败,请重试'
		uni.showToast({ title: msg, icon: 'none' })
	}
}

// ===== 建构模式:内联修改 =====
function startEdit(item: ConfirmCardItem) {
	editingKey.value = item.fieldKey
	editText.value = item.displayValue != '' ? item.displayValue : item.content
}

function cancelEdit() {
	editingKey.value = ''
	editText.value = ''
}

async function submitEdit(card: ConfirmCardPayload, item: ConfirmCardItem) {
	const newText = editText.value.trim()
	if (newText == '') {
		uni.showToast({ title: '内容不能为空', icon: 'none' })
		return
	}
	const rev = currentRevision(card)
	const actions: any[] = [fieldAction(item.fieldKey, 'replace', newText, rev)]
	const res = await patchProfileDraft(card.draftId, actions, rev)
	if (res.success) {
		updateCardItemValue(card.cardId, item.fieldKey, newText)
		cancelEdit()
		uni.showToast({ title: '已更新', icon: 'none' })
		await refreshDraftState(card)
		await loadMoxiangState()
	} else {
		const msg = res.message != null ? ('' + res.message) : '修改失败,请重试'
		uni.showToast({ title: msg, icon: 'none' })
	}
}

// ===== 建构模式:统一结果页 =====
// subjectArg 为空时沿用当前主体；入口卡「查看成稿/继续整理」显式传入。
async function goPortrait(subjectArg?: string) {
	const subject: ProfileSubject = subjectArg != null && subjectArg != ''
		? (subjectArg == 'ideal_partner' ? 'ideal_partner' : 'personal')
		: currentSubject.value
	const card = draftState(subject)
	if (card != null) {
		uni.navigateTo({
			url: '/pagesSub/profileExtra/my-portrait-result?subject=' + subject
				+ '&draft_id=' + card.draftId
				+ '&expected_revision=' + card.expectedRevision
		})
		return
	}

	// 页面恢复后 WS 卡片可能尚未重放；从档案聚合恢复 active preview/draft。
	try {
		const archive = await getMoxiangArchive()
		const block = subject == 'ideal_partner' ? archive.idealPartner : archive.personal
		let url = '/pagesSub/profileExtra/my-portrait-result?subject=' + subject
		if (block.preview != null && block.preview.status == 'active') {
			url += '&preview_id=' + block.preview.previewId
		} else if (block.activeDraft != null) {
			url += '&draft_id=' + block.activeDraft.draftId
				+ '&expected_revision=' + block.activeDraft.expectedRevision
		} else if (block.currentRevision == null) {
			uni.showToast({ title: '暂时没有可整理的成稿', icon: 'none' })
			return
		}
		uni.navigateTo({ url: url })
	} catch (e) {
		uni.showToast({ title: '读取成稿失败,请稍后重试', icon: 'none' })
	}
}

// Phase 2 P2-02 / P2-04 —— 双阶段卡入口
function onEnterSubject(subject: ProfileSubject) {
	if (subject == 'ideal_partner' && stateResponse.value != null && !stateResponse.value.canStartIdealPartner) {
		uni.showToast({ title: '请先完成我的墨相', icon: 'none' })
		return
	}
	if (subject == 'ideal_partner' && stateResponse.value != null && stateResponse.value.canStartIdealPartner) {
		// 老用户恢复路径:理想伴侣已经有会话/草稿 → 直接进入该主体的 master session。
		currentSubject.value = 'ideal_partner'
		pendingSubject.value = ''
		enterSubjectSession('ideal_partner')
		return
	}
	currentSubject.value = subject
	pendingSubject.value = subject
	// 如果已经有会话(state 显示 sessionId),直接进入 buildMode;否则等用户在 MoxiangEntryState 点开始。
	loadMoxiangState().then(() => {
		const summary = subject == 'ideal_partner' ? stateResponse.value?.idealPartner : stateResponse.value?.personal
		if (summary != null && summary.sessionId != null && summary.sessionId != '') {
			enterSubjectSession(subject)
		}
	})
}

function enterSubjectSession(subject: ProfileSubject) {
	if (subject == 'ideal_partner') {
		// ideal_partner 走独立会话入口(可能为老用户恢复或新开启)
		startChatFlowFor(subject)
		return
	}
	startChatFlowFor('personal')
}

function onBackToCards() {
	// 双阶段卡 → MoxiangEntryState → 返回双阶段卡(无任何数据丢失)
	pendingSubject.value = ''
}

// ===== 文字模式 =====
function sendText() {
	const text = inputText.value.trim()
	if (text == '') return
	if (ws == null || !ws.isConnected() || !sessionStarted.value) {
		uni.showToast({ title: masterRoleName + '正在准备中', icon: 'none' })
		return
	}
	if (masterState.value == 'thinking') return
	addMessage('user', text)
	inputText.value = ''
	ws.sendTextMessage(text)
}

function switchToVoice() {
	inputMode.value = 'voice'
}

function switchToText() {
	inputMode.value = 'text'
	// 如果正在录音,停止
	if (isRecording) {
		stopRecording()
	}
}

// ===== 语音模式 =====
function toggleVoice() {
	// v2 播放中点击语音按钮 = 点击打断("我来说")
	if (realtimeV2Active && pcmPlayer.isPlaying()) {
		interruptCurrentReply()
		return
	}
	if (realtimeV2Active) {
		// v2 空闲时点击:仅在服务端 voice_ready 后才真正可录;
		// audio_start 触发上游建立,voice_ready 到达后自动开麦。
		if (ws != null && ws.isConnected() && sessionStarted.value) {
			ws.sendAudioStart()
		}
		return
	}
	if (masterState.value == 'listening') {
		stopRecording()
	} else {
		startRecording()
	}
}

// ===== 实时语音 v2 =====
function startRecordingV2() {
	if (ws == null || !ws.isConnected() || isRecording) return
	ensureRecorder()
	isRecording = true
	chunkSeq = 0
	partialText.value = ''
	masterState.value = 'listening'
	// v2 不发 audio_start(开麦已在打断/轮转时触发);只上报幂等身份
	ws.sendVoiceInputBegin('' + Date.now() + '-' + Math.floor(Math.random() * 1000000))
	recorderManager.start({
		format: 'pcm',
		sampleRate: 16000,
		numberOfChannels: 1,
		frameSize: 4
	})
}

function interruptCurrentReply() {
	const generationId = currentGenerationId
	// 立即停播,不等网络
	pcmPlayer.stopAll()
	currentGenerationId = ''
	if (ws != null && ws.isConnected() && generationId != '') {
		ws.sendInterrupt(generationId)
	}
	// 服务端打断后轮转上游,voice_ready 到达时自动恢复"我在听"
}

function ensureRecorder() {
	if (recorderManager != null) return
	recorderManager = uni.getRecorderManager()
	recorderManager.onFrameRecorded((res: any) => {
		if (!isRecording || ws == null || !ws.isConnected()) return
		const frameBuffer = res.frameBuffer
		if (frameBuffer == null) return
		const base64Data = arrayBufferToBase64(frameBuffer)
		if (base64Data != '') {
			chunkSeq++
			ws.sendAudioChunk(base64Data, chunkSeq)
		}
		if (res.isLastFrame === true) {
			if (ws != null && ws.isConnected()) {
				ws.sendAudioEnd()
			}
		}
	})
	recorderManager.onStop((res: any) => {
		// onFrameRecorded isLastFrame 已处理 audio_end
		// onStop 仅用于状态清理
	})
}

function arrayBufferToBase64(buffer: any) : string {
	return uni.arrayBufferToBase64(buffer)
}

function startRecording() {
	if (ws == null || !ws.isConnected()) {
		uni.showToast({ title: '未连接', icon: 'none' })
		return
	}
	ensureRecorder()
	isRecording = true
	chunkSeq = 0
	partialText.value = ''
	masterState.value = 'listening'
	ws.sendAudioStart()
	recorderManager.start({
		format: 'pcm',
		sampleRate: 16000,
		numberOfChannels: 1,
		frameSize: 4
	})
}

function stopRecording() {
	if (!isRecording) return
	isRecording = false
	if (recorderManager != null) {
		recorderManager.stop()
	}
	// audio_end 由 onFrameRecorded isLastFrame 发送
	// 兜底:如果未触发 isLastFrame,手动发
	if (ws != null && ws.isConnected()) {
		ws.sendAudioEnd()
	}
}

// ===== TTS 播报 =====
function requestTTS() {
	if (ws != null && ws.isConnected() && lastReplyText.value != '') {
		ws.sendListen()
	}
}

function playTTS(text: string) {
	// 从消息流中点击"听它读":发送 revise 让后端重新合成
	if (ws != null && ws.isConnected() && text != '') {
		ws.sendReviseText(text)
		ws.sendListen()
	}
}

/**
 * 该 code 是否已由 handleTypedWSFailure 展示过（用于 onError 去重）。
 * 判定复用 WS 模块的 classifyMasterWSError，保证与 onTypedError 同一分类源。
 */
function isTypedFailureHandledFor(code: string): boolean {
	const kind = classifyMasterWSError(code)
	return kind == 'policy_denied' || kind == 'temporarily_unavailable' || kind == 'quota_exceeded'
}

/**
 * 按后端下行 error.code 的文档语义（docs/api/语音.md §4）区分处理：
 * - policy_denied：账号撤权/注销/签名上下文失效 → 停止播放并丢弃旧音频
 *   URL（不得复用），提示重新获取会话；
 * - temporarily_unavailable：ASR/TTS/模型暂时失败 → 停播保状态，提示稍后重试；
 * - quota_exceeded：额度用尽；
 * - 其他：沿用通用 toast（与既有 onError 行为一致）。
 */
function handleTypedWSFailure(kind: string, message: string) {
	if (kind == 'policy_denied' || kind == 'temporarily_unavailable') {
		stopAudioPlayback()
		// 授权已撤回时会话/音频上下文已失效，旧 URL 不可复用。
		if (kind == 'policy_denied') {
			lastTTSUrl.value = ''
		}
	}
	if (kind == 'policy_denied') {
		masterState.value = 'idle'
		uni.showToast({ title: '授权已撤回，请重新进入对话', icon: 'none' })
		return
	}
	if (kind == 'temporarily_unavailable') {
		masterState.value = 'idle'
		uni.showToast({ title: '语音服务暂时不可用，请稍后重试', icon: 'none' })
		return
	}
	if (kind == 'quota_exceeded') {
		masterState.value = 'idle'
		uni.showToast({ title: '本次额度已用完', icon: 'none' })
		return
	}
}

function stopAudioPlayback() {
	if (audioContext != null) {
		try {
			audioContext.stop()
			audioContext.destroy()
		} catch (e) {}
		audioContext = null
	}
	masterState.value = 'idle'
}

function playAudio(url: string) {
	const fullUrl = resolveMediaUrl(url)
	if (fullUrl == '') return
	if (audioContext != null) {
		try { audioContext.destroy() } catch (e) {}
	}
	audioContext = uni.createInnerAudioContext()
	audioContext.src = fullUrl
	audioContext.onEnded(() => {
		masterState.value = 'idle'
		lastTTSUrl.value = ''
	})
	audioContext.onError(() => {
		masterState.value = 'idle'
		lastTTSUrl.value = ''
	})
	audioContext.play()
}

function replayTTS() {
	if (lastTTSUrl.value != '') {
		playAudio(lastTTSUrl.value)
	}
}

function closeTTS() {
	lastTTSUrl.value = ''
	if (audioContext != null) {
		try { audioContext.stop() } catch (e) {}
	}
	masterState.value = 'idle'
}

// ===== 重试 =====
function retryConnect() {
	// Keep both visible turns and the dedupe index.  Only a transient typing
	// placeholder is safe to remove when the transport is retried.
	const typingIndex = findMsgIndex(typingMsgId)
	if (typingIndex >= 0) messages.value.splice(typingIndex, 1)
	typingMsgId = 0
	connectError.value = ''
	stateError.value = ''
	// 重新拉 state,只有存在可恢复会话时才建立 WS；新用户回到入口卡片。
	loadStateAndMaybeConnect()
}

// ===== Phase 1 Contract v1.1 P1-D：state / history / build_invite =====
// 进入页面:GET /ai/moxiang state → 渲染 entry → 用户点开始 → 建立 WS → GET history
async function loadMoxiangState() {
	stateError.value = ''
	try {
		stateResponse.value = await getMoxiangState()
		syncGateFromState('personal')
		syncGateFromState('ideal_partner')
	} catch (e: any) {
		stateError.value = (e?.message != null ? ('' + e.message) : '加载失败，请重试')
		stateResponse.value = null
	}
}

// State loading and socket startup are separate concerns. In particular, a
// first-time visitor has no session to connect to and must not remain in the
// full-page connecting state forever.
async function loadStateAndMaybeConnect() {
	await loadMoxiangState()
	loadPortraitArchive()
	const summary = currentSubjectSummary.value
	const shouldConnect = summary != null && summary.sessionId != null && summary.sessionId != ''
	if (shouldConnect) {
		connectWS()
	} else {
		connecting.value = false
	}
}

// 确认卡 REST 兜底：卡片正常由 WS 推送（含服务端重连重放）；若重放丢失或
// 通道异常，用档案里的未完成草稿重建卡片，避免旅程卡死在 building 无人确认。
async function restoreConfirmCardFromRest(subject: ProfileSubject) {
	if (stateResponse.value == null) return
	const summary = subject == 'ideal_partner' ? stateResponse.value.idealPartner : stateResponse.value.personal
	if (summary == null || summary.pendingConfirmCard != true) return
	if (cardBySubject(subject) != null) return
	try {
		let archive = portraitArchive.value
		if (archive == null) {
			archive = await getMoxiangArchive()
			portraitArchive.value = archive
		}
		if (archive == null) return
		const block = subject == 'ideal_partner' ? archive.idealPartner : archive.personal
		const draft = block.activeDraft
		if (draft == null) return
		const res = await getProfileDraft(draft.draftId)
		const data: any = res != null && res.success == true && res.data != null ? res.data : null
		if (data == null || !Array.isArray(data.fields)) return
		const items: ConfirmCardItem[] = []
		for (let i = 0; i < data.fields.length; i++) {
			const f: any = data.fields[i]
			if (String(f.confirmation_status ?? '') != 'suggested') continue
			const item: ConfirmCardItem = {
				fieldKey: String(f.field_key ?? ''),
				kind: String(f.field_kind ?? 'structured'),
				category: String(f.category ?? ''),
				content: String(f.content ?? ''),
				displayValue: String(f.display_value ?? '')
			}
			items.push(item)
		}
		if (items.length == 0) return
		const card: ConfirmCardPayload = {
			subject: subject,
			cardId: 'rest-' + draft.draftId,
			draftId: draft.draftId,
			expectedRevision: Number(draft.expectedRevision ?? 0),
			items: items
		}
		setDraftBySubject(subject, card)
		setCardBySubject(subject, card)
		if (subject == currentSubject.value && sessionStarted.value) addCardMessage(card)
	} catch (e: any) {
		// 兜底失败静默：下一次重连的服务端重放仍会覆盖此场景。
	}
}

// 按 turn_id 去重合并服务端历史到本地消息流
async function loadSessionHistory(sessionId: string, beforeTurnNo: number | null, subject: ProfileSubject = currentSubject.value) {
	try {
		const res = await getSessionTurns(sessionId, beforeTurnNo, 50)
		for (let i = 0; i < res.turns.length; i++) {
			const t: MoxiangTurn = res.turns[i]
			if (restoredTurnIds.value.has(t.turnId)) continue
			restoredTurnIds.value.add(t.turnId)
			if (t.role == 'assistant') {
				addMessage('master', t.content, false, subject)
			} else {
				addMessage('user', t.content, false, subject)
			}
		}
	} catch (e: any) {
		// 历史读取失败不替换本地已有消息,提示重试
		stateError.value = '重新加载历史'
	}
}

// 用户从 entry 点 "开始聊聊" / "继续上次对话" → 切换到聊天视图并建立 WS
function startChatFlow() {
	return startChatFlowFor(currentSubject.value)
}

function startChatFlowFor(subject: ProfileSubject) {
	if (subject == 'ideal_partner' && stateResponse.value != null && !stateResponse.value.canStartIdealPartner) {
		uni.showToast({ title: '请先完成我的墨相', icon: 'none' })
		pendingSubject.value = ''
		return
	}
	const switchingSubject = sessionStarted.value && currentSubject.value != subject
	pendingSubject.value = ''
	if (ws == null) {
		currentSubject.value = subject
		connectWS()
		return
	}
	if (switchingSubject) {
		if (ws.isConnected()) {
			ws.switchSubject(subject)
		} else {
			// The socket's onOpen will replay this target subject after reconnect.
			currentSubject.value = subject
			ws.startJourneyMode(subject, 'profile-text-v1')
		}
	} else if (!sessionStarted.value) {
		currentSubject.value = subject
		ws.startJourneyMode(subject, 'profile-text-v1')
	} else {
		currentSubject.value = subject
	}
}

function continueChatFlow() {
	startChatFlow()
}

async function grantConsentFlow() {
	// P1-D 收尾:真正调用授权 API,而不是直接 startChatFlow。
	// 后端要求 X-Expected-Privacy-Revision 头与 GET /ai/consents 返回的
	// privacy_revision 匹配,先拉一次再调授权。
	try {
		const consentsRes = await getAiConsents()
		const privacyRevision = Number(consentsRes?.data?.privacy_revision ?? 0)
		const res = await grantProfileTextConsent(privacyRevision)
		if (res.success) {
			stateError.value = ''
			startChatFlow()
			// 重新拉 state 以更新 entry 视图的 consentGranted
			loadMoxiangState()
		} else {
			const msg = res.message != null ? ('' + res.message) : '授权失败,请稍后再试'
			stateError.value = msg
		}
	} catch (e: any) {
		stateError.value = (e?.message != null ? ('' + e.message) : '授权失败,请稍后再试')
	}
}

function acceptInvite(inviteId: string) {
	if (ws == null || inviteBusy.value) return
	inviteBusy.value = true
	ws.acceptBuildInvite(currentSubject.value, inviteId)
}

function snoozeInvite(inviteId: string) {
	if (ws == null || inviteBusy.value) return
	inviteBusy.value = true
	ws.snoozeBuildInvite(currentSubject.value, inviteId)
}

// ===== 导航 =====
function navBack() {
	if (isRecording) stopRecording()
	if (audioContext != null) {
		try { audioContext.destroy() } catch (e) {}
	}
	if (ws != null) {
		ws.disconnect()
		ws = null
	}
	// 页面栈兜底:直开/分享进入时栈内仅当前页,navigateBack 无效则回首页
	const pages = getCurrentPages()
	if (pages.length > 1) {
		uni.navigateBack({ delta: 1 })
	} else {
		uni.reLaunch({ url: '/pages/index/index' })
	}
}

// ===== 生命周期 =====
onLoad((options: any) => {
	if (options != null && String(options.subject != null ? options.subject : '') == 'ideal_partner') {
		currentSubject.value = 'ideal_partner'
	}
	// Phase 1 P1-D:先 GET state 再决定是否连接 WS
	loadStateAndMaybeConnect()
	// Dev-only:挂载前异步拉取最近一次回放 trace
	loadMoxiangTrace().then((trace) => {
		devMoxiangTrace.value = trace
	})
})

onUnmounted(() => {
	pcmPlayer.stopAll()
	pcmPlayer.destroy()
	if (isRecording) stopRecording()
	if (audioContext != null) {
		try { audioContext.destroy() } catch (e) {}
		audioContext = null
	}
	if (ws != null) {
		ws.disconnect()
		ws = null
	}
})

// Dev-only trace(由 ``XsaMoxiangTrace`` 折叠层消费,生产 __DEV__ 替换后恒为 null)
const devMoxiangTrace = ref<any>(null)
