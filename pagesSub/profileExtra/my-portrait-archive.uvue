<template>
	<view class="mpa-page">
		<!-- 导航栏 -->
		<view class="mpa-nav" :style="{ paddingTop: navPadTop + 'px', paddingRight: (menuButtonSpacing + 8) + 'px' }">
			<view class="mpa-nav-side mpa-nav-back" @tap="navBack">
				<text class="mpa-nav-back-text">‹</text>
			</view>
			<text class="mpa-nav-title" :style="{ top: navPadTop + 'px' }">我的画像档案</text>
			<view class="mpa-nav-side"></view>
		</view>

		<view v-if="loading" class="mpa-loading">
			<view class="mpa-loading-dot"></view>
			<text class="mpa-loading-text">正在整理档案…</text>
		</view>

		<view v-else-if="errorMessage" class="mpa-error">
			<text class="mpa-error-text">{{ errorMessage }}</text>
			<view class="mpa-error-btn" @tap="loadArchive"><text class="mpa-error-btn-text">重试</text></view>
		</view>

		<view v-else class="mpa-body">
			<!-- 自我画像资产卡 -->
			<view class="mpa-subject mpa-subject-personal">
				<view class="mpa-subject-head">
					<view class="mpa-subject-title-box">
						<text class="mpa-subject-title">我的画像</text>
						<text class="mpa-subject-tag">关于我</text>
					</view>
					<text v-if="personalConsentActive" class="mpa-badge">授权中</text>
					<text v-else class="mpa-badge mpa-badge-off">未授权</text>
				</view>
				<text class="mpa-subject-sub">{{ personalStateSub }}</text>
				<view v-if="personalOverallPercent > 0" class="mpa-progress">
					<view class="mpa-progress-track"><view class="mpa-progress-fill" :style="{ width: personalOverallPercent + '%' }"></view></view>
					<text class="mpa-progress-num">{{ personalOverallPercent }}%</text>
				</view>
				<view class="mpa-subject-actions">
					<view class="mpa-btn" @tap="goMaster('personal')">
						<text class="mpa-btn-text">{{ personalCta }}</text>
					</view>
					<view v-if="archive.personal.currentRevision" class="mpa-btn mpa-btn-ghost" @tap="goResult('personal')">
						<text class="mpa-btn-text">看成稿</text>
					</view>
					<view v-if="archive.personal.currentRevision" class="mpa-btn mpa-btn-ghost" @tap="goPoster('personal')">
						<text class="mpa-btn-text">生成海报</text>
					</view>
				</view>
				<view v-if="archive.personal.history.length > 0" class="mpa-history">
					<text class="mpa-history-title">历史版本</text>
					<view v-for="(item, idx) in archive.personal.history" :key="idx" class="mpa-history-item">
						<text class="mpa-history-no">#{{ item.revisionNo }}</text>
						<text class="mpa-history-time">{{ formatTime(item.publishedAt) }}</text>
						<text class="mpa-history-fields">{{ item.fieldCount }} 字段</text>
					</view>
				</view>
				<view v-if="archive.personal.preview" class="mpa-preview-tip">
					<text class="mpa-preview-tip-text">草稿上有未发布的预览 (rev {{ archive.personal.preview.expectedRevision }})</text>
				</view>
			</view>

			<!-- 伴侣画像资产卡 -->
			<view class="mpa-subject mpa-subject-ideal">
				<view class="mpa-subject-head">
					<view class="mpa-subject-title-box">
						<text class="mpa-subject-title">伴侣画像</text>
						<text class="mpa-subject-tag">期待的关系</text>
					</view>
					<text v-if="idealConsentActive" class="mpa-badge">授权中</text>
					<text v-else class="mpa-badge mpa-badge-off">未授权</text>
				</view>
				<text class="mpa-subject-sub">{{ idealPartnerStateSub }}</text>
				<view v-if="idealOverallPercent > 0" class="mpa-progress">
					<view class="mpa-progress-track"><view class="mpa-progress-fill" :style="{ width: idealOverallPercent + '%' }"></view></view>
					<text class="mpa-progress-num">{{ idealOverallPercent }}%</text>
				</view>
				<view class="mpa-subject-actions">
					<view class="mpa-btn" @tap="goMaster('ideal_partner')">
						<text class="mpa-btn-text">{{ idealPartnerCta }}</text>
					</view>
					<view v-if="archive.idealPartner.currentRevision" class="mpa-btn mpa-btn-ghost" @tap="goResult('ideal_partner')">
						<text class="mpa-btn-text">看成稿</text>
					</view>
				</view>
				<view v-if="archive.idealPartner.history.length > 0" class="mpa-history">
					<text class="mpa-history-title">历史版本</text>
					<view v-for="(item, idx) in archive.idealPartner.history" :key="idx" class="mpa-history-item">
						<text class="mpa-history-no">#{{ item.revisionNo }}</text>
						<text class="mpa-history-time">{{ formatTime(item.publishedAt) }}</text>
						<text class="mpa-history-fields">{{ item.fieldCount }} 字段</text>
					</view>
				</view>
				<view v-if="archive.idealPartner.preview" class="mpa-preview-tip">
					<text class="mpa-preview-tip-text">草稿上有未发布的预览 (rev {{ archive.idealPartner.preview.expectedRevision }})</text>
				</view>
			</view>

			<!-- 记忆管理卡片 -->
			<view class="mpa-memory-entry" @tap="openMemorySheet">
				<view class="mpa-memory-entry-icon">
					<text class="mpa-memory-entry-icon-text">记</text>
				</view>
				<view class="mpa-memory-entry-copy">
					<text class="mpa-memory-entry-title">记忆管理</text>
					<text class="mpa-memory-entry-sub">查看、确认或停止使用 AI 从对话中梳理的理解</text>
				</view>
				<view class="mpa-memory-entry-arrow-box">
					<text class="mpa-memory-entry-arrow">➔</text>
				</view>
			</view>
		</view>
		<MemoryManagementSheet :visible="memorySheetVisible" @close="closeMemorySheet" />
	</view>
</template>

<script lang="uts">
	/**
	 * Phase 3 P3-03 —— 我的墨相档案
	 *
	 * 路径: pagesSub/profileExtra/my-portrait-archive
	 * 入口: 我的页面"我的墨相档案"双入口(配合墨相师入口)
	 *
	 * 行为契约:
	 * 1. 永远 GET /ai/moxiang/archive(200),不依赖其它状态
	 * 2. 双主体资产卡独立展示,主体互不干扰
	 * 3. 撤回授权后,主体资产卡仍可读(只把 consentActive 标 false)
	 */
	import { getMoxiangArchive, getMoxiangState, type MoxiangArchiveResponse, type ArchiveSubject, type MoxiangStateResponse } from '@/api/ai-moxiang.uts'
	import MemoryManagementSheet from '@/components/MemoryManagementSheet.uvue'

	function emptySubject(subject: 'personal' | 'ideal_partner'): ArchiveSubject {
		return {
			subject,
			consentActive: false,
			currentRevision: null,
			activeDraft: null,
			summaryExcerpt: null,
			history: [],
			preview: null
		}
	}

	function emptyState(): MoxiangStateResponse {
		return {
			consentGranted: false,
			activeSubject: 'personal',
			personal: {
				sessionId: null,
				journeyStage: null,
				lastTurnAt: null,
				lastTopicExcerpt: '',
				overallPercent: 0,
				dimensions: {} as any,
				pendingBuildInviteId: null,
				pendingConfirmCard: false,
				publishedRevisionId: null,
				canStartIdealPartner: false
			},
			idealPartner: {
				sessionId: null,
				journeyStage: null,
				lastTurnAt: null,
				lastTopicExcerpt: '',
				overallPercent: 0,
				dimensions: {} as any,
				pendingBuildInviteId: null,
				pendingConfirmCard: false,
				publishedRevisionId: null,
				canStartIdealPartner: false
			},
			canStartIdealPartner: false
		}
	}

	const systemInfo = uni.getSystemInfoSync()
	const statusBarHeight = systemInfo.statusBarHeight != null ? systemInfo.statusBarHeight : 20
	const menuButtonInfo = uni.getMenuButtonBoundingClientRect()
	const navPadTop = menuButtonInfo != null && menuButtonInfo.top > statusBarHeight ? menuButtonInfo.top : statusBarHeight + 6
	const menuButtonSpacing = menuButtonInfo != null ? (systemInfo.windowWidth - menuButtonInfo.left) : 8

	export default {
		components: { MemoryManagementSheet },
		data() {
			return {
				navPadTop: navPadTop,
				menuButtonSpacing: menuButtonSpacing,
				loading: true,
				errorMessage: '',
				memorySheetVisible: false,
				archive: {
					personal: emptySubject('personal'),
					idealPartner: emptySubject('ideal_partner'),
					fallbackAvailable: false
				} as MoxiangArchiveResponse,
				state: emptyState() as MoxiangStateResponse | null
			}
		},
		computed: {
			personalOverallPercent(): number {
				const s = this.state
				if (s == null) return 0
				return Math.round(Number(s.personal.overallPercent ?? 0))
			},
			idealOverallPercent(): number {
				const s = this.state
				if (s == null) return 0
				return Math.round(Number(s.idealPartner.overallPercent ?? 0))
			},
			personalConsentActive(): boolean {
				if (this.state != null) return this.state.consentGranted
				return this.archive.personal.consentActive
			},
			idealConsentActive(): boolean {
				if (this.state != null) return this.state.consentGranted
				return this.archive.idealPartner.consentActive
			},
			personalStateSub(): string {
				const p = this.archive.personal
				if (p.currentRevision) return '已发布第 ' + p.currentRevision.revisionNo + ' 版'
				if (p.activeDraft) return '草稿进行中 · rev ' + p.activeDraft.expectedRevision
				if (this.personalOverallPercent > 0) return '知遇已理解你 ' + this.personalOverallPercent + '% · 继续聊聊就能成稿'
				return '尚未开始'
			},
			idealPartnerStateSub(): string {
				const p = this.archive.idealPartner
				if (p.currentRevision) return '已发布第 ' + p.currentRevision.revisionNo + ' 版'
				if (p.activeDraft) return '草稿进行中 · rev ' + p.activeDraft.expectedRevision
				if (this.idealOverallPercent > 0) return '知遇已理解你的期待 ' + this.idealOverallPercent + '% · 继续聊聊就能成稿'
				if (this.state != null && !this.state.canStartIdealPartner) return '需要先完成自我画像'
				return '尚未开始'
			},
			personalCta(): string {
				const p = this.archive.personal
				if (p.currentRevision) return '继续完善'
				if (p.activeDraft || this.personalOverallPercent > 0) return '继续聊聊'
				return '开始聊聊'
			},
			idealPartnerCta(): string {
				const p = this.archive.idealPartner
				if (p.currentRevision) return '继续完善'
				if (p.activeDraft || this.idealOverallPercent > 0) return '继续聊聊'
				if (this.state != null && !this.state.canStartIdealPartner) return '先完成我的画像'
				return '开始聊聊'
			}
		},
		onLoad() {
			this.loadArchive()
		},
		onShow() {
			// 从结果页发布/恢复后,档案可能变化,自动重拉
			if (!this.loading) this.loadArchive()
		},
		methods: {
			openMemorySheet() {
				this.memorySheetVisible = true
			},
			closeMemorySheet() {
				this.memorySheetVisible = false
			},
			navBack() {
				uni.navigateBack({ delta: 1, fail: () => {
					uni.switchTab({ url: '/pages/profile/profile' })
				} })
			},
			async loadArchive() {
				this.loading = true
				this.errorMessage = ''
				try {
					// archive 只覆盖已发布/草稿资产；旅程中的理解进度在 state 里，两个都要。
					const results = await Promise.all([
						getMoxiangArchive(),
						getMoxiangState().catch((e: any) => {
							console.warn('moxiang state load failed', e)
							return null
						})
					])
					this.archive = results[0]
					this.state = results[1]
				} catch (e: any) {
					this.errorMessage = '读取档案失败:' + (e?.message ?? String(e))
				} finally {
					this.loading = false
				}
			},
			goMaster(subject: string) {
				// 伴侣画像需先完成（发布）我的画像，锁定时提示而不是推进聊天。
				if (subject == 'ideal_partner' && this.state != null && !this.state.canStartIdealPartner) {
					uni.showToast({ title: '先完成「我的画像」发布，再开启伴侣画像', icon: 'none', duration: 2500 })
					return
				}
				uni.redirectTo({ url: '/pagesSub/profileExtra/my-portrait-master?subject=' + subject })
			},
			goResult(subject: string) {
				uni.navigateTo({ url: '/pagesSub/profileExtra/my-portrait-result?subject=' + subject })
			},
			goPoster(subject: string) {
				uni.navigateTo({ url: '/pagesSub/profileExtra/my-portrait-result?subject=' + subject + '&openPoster=1' })
			},
			formatTime(t: string | null): string {
				if (!t) return ''
				if (t.length >= 10) return t.substring(0, 10)
				return t
			}
		}
	}
</script>

<style>
