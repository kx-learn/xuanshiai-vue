.error-mark { width: 82px; height: 82px; margin-bottom: 26px; display: flex; align-items: center; justify-content: center; border: 1px solid var(--line); border-radius: 26px; background: var(--surface); box-shadow: var(--shadow-md); }
.error-mark text { color: var(--accent2); font-size: 42px; font-weight: 700; line-height: 1; }
.error-title { color: var(--ink); font-size: 18px; font-weight: 700; }
.error-description { max-width: 560rpx; margin-top: 12px; color: var(--ink2); font-size: 14px; line-height: 1.5; text-align: center; }
.error-hint { margin-top: 6px; color: var(--muted); font-size: 12px; }
.error-actions { display: flex; flex-direction: row; align-items: center; gap: 12px; margin-top: 28px; }
.error-retry, .error-cancel { height: 42px; padding: 0 24px; box-sizing: border-box; display: flex; align-items: center; justify-content: center; border-radius: 21px; font-size: 14px; }
.error-retry { min-width: 116px; background: var(--sage); color: var(--text-invert); box-shadow: var(--shadow-sm); }
.error-cancel { min-width: 76px; border: 1px solid var(--line); background: var(--surface); color: var(--ink2); }
.state-title { font-size: 16px; font-weight: 700; color: var(--ink); }
.state-description { font-size: 13px; color: var(--muted); }
.detail-scroll { width: 100%; height: 100vh; }
.vip-detail-page { min-height: 100%; background-color: var(--canvas); }
