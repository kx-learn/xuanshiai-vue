.vip-cover-img { width: 100%; height: 100%; }
.vip-avatar-circle { position: absolute; z-index: 3; left: 32rpx; bottom: -40rpx; width: 160rpx; height: 160rpx; overflow: hidden; border: 6rpx solid var(--surface); border-radius: 50%; background-color: var(--warm); box-sizing: border-box; }
.vip-avatar { width: 100%; height: 100%; }
.vip-profile-header { display: flex; flex-direction: column; gap: 14rpx; padding: 62rpx 40rpx 32rpx; background-color: var(--surface); }
.vip-name-row { display: flex; flex-direction: row; align-items: center; justify-content: space-between; gap: 20rpx; }
.vip-name-group { display: flex; min-width: 0; flex: 1; flex-direction: row; align-items: center; gap: 16rpx; }
.vip-name { max-width: 380rpx; overflow: hidden; color: var(--ink); font-family: var(--serif); font-size: 42rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.vip-age { flex-shrink: 0; color: var(--ink2); font-size: 28rpx; }
.vip-meta { color: var(--ink2); font-size: 24rpx; line-height: 1.5; }
.visitor-count-text { color: var(--ink3); font-size: 22rpx; line-height: 1.4; }
.vip-bio { color: var(--ink2); font-size: 25rpx; line-height: 1.65; }
.vip-detail-content { display: flex; flex-direction: column; gap: 24rpx; padding: 24rpx 32rpx 36rpx; }
.vip-section-card { display: flex; flex-direction: column; gap: 24rpx; padding: 32rpx; border-radius: 20rpx; background-color: var(--surface); box-shadow: var(--shadow-sm); }
.vip-section-title { color: var(--ink); font-family: var(--serif); font-size: 30rpx; font-weight: 700; }
.ordinary-detail-page { padding: 0; }
.ordinary-profile-card { overflow: hidden; border-radius: 0; background-color: var(--surface); box-shadow: none; }
.ordinary-cover, .locked-cover-area { position: relative; width: 100%; height: 560rpx; overflow: hidden; background-color: var(--warm); }
.ordinary-cover-img, .locked-cover-img { width: 100%; height: 100%; }
.cover-actions { position: absolute; top: 32rpx; right: 32rpx; left: 32rpx; display: flex; flex-direction: row; justify-content: space-between; }
.round-action { display: flex; align-items: center; justify-content: center; width: 72rpx; height: 72rpx; border-radius: 50%; background-color: rgba(12, 19, 19, 0.45); }
.round-action-text { color: var(--text-invert); font-size: 36rpx; font-weight: 700; }
.share-symbol { transform: rotate(-45deg); }
.ordinary-cover-user { position: absolute; right: 24rpx; bottom: 24rpx; left: 24rpx; display: flex; flex-direction: row; align-items: flex-end; gap: 20rpx; }
.ordinary-avatar { width: 128rpx; height: 128rpx; flex-shrink: 0; border: 6rpx solid var(--surface); border-radius: 50%; background-color: var(--warm); }
.ordinary-cover-copy { flex: 1; display: flex; flex-direction: column; gap: 8rpx; padding: 18rpx; border-radius: 18rpx; background-color: rgba(12, 19, 19, 0.45); }
.ordinary-name-row, .locked-name-vip-row, .section-heading-row, .activity-row, .spot-heading, .spot-heading-left, .dynamic-footer { display: flex; flex-direction: row; align-items: center; }
.ordinary-name-row, .locked-name-vip-row, .section-heading-row, .activity-row, .spot-heading, .dynamic-footer { justify-content: space-between; }
.ordinary-name { color: var(--text-invert); font-family: var(--serif); font-size: 34rpx; font-weight: 700; }
.ordinary-cover-meta, .ordinary-active { color: var(--text-invert); font-size: 22rpx; }
.vip-badge { display: flex; flex-direction: row; align-items: center; gap: 6rpx; padding: 6rpx 14rpx; border-radius: 999px; background-color: var(--plane-yellow); }
.vip-badge-large { padding: 10rpx 18rpx; }
.vip-badge-text { color: var(--ink); font-size: 20rpx; font-weight: 700; }
.vip-crown { color: var(--ink); font-size: 22rpx; }
.ordinary-card-body { padding: 24rpx 32rpx 32rpx; background-color: var(--canvas); }
.ordinary-section { display: flex; flex-direction: column; gap: 24rpx; padding: 28rpx 0; border-bottom: 2rpx solid var(--line); }
.ordinary-section-title, .locked-section-title { font-family: var(--serif); font-size: 30rpx; font-weight: 700; color: var(--ink); }
.tag-row { display: flex; flex-direction: row; flex-wrap: wrap; gap: 12rpx; }
.profile-tag { padding: 8rpx 18rpx; border-radius: 999px; background-color: var(--accent-bg); }
.profile-tag-text { color: var(--accent2); font-size: 22rpx; font-weight: 600; }
.about-text, .locked-bio { color: var(--ink2); font-size: 25rpx; line-height: 1.65; }
.cert-summary { display: flex; flex-direction: row; flex-wrap: wrap; align-items: center; gap: 16rpx; }
.cert-summary-label { color: var(--muted); font-size: 22rpx; }
.cert-summary-item { color: var(--accent2); font-size: 22rpx; }
.ai-match-section { display: flex; flex-direction: row; align-items: center; gap: 24rpx; margin: 24rpx 0 0; padding: 24rpx; border-radius: 20rpx; background-color: var(--accent-bg); }
.match-score { display: flex; align-items: center; justify-content: center; width: 104rpx; height: 104rpx; flex-shrink: 0; border: 8rpx solid var(--accent); border-radius: 50%; background-color: var(--surface); }
.match-score-value { color: var(--accent2); font-size: 28rpx; font-weight: 800; }
.match-copy { flex: 1; display: flex; flex-direction: column; gap: 8rpx; }
.match-title { color: var(--ink); font-size: 28rpx; font-weight: 700; }
.match-desc { color: var(--ink2); font-size: 22rpx; line-height: 1.5; }
.basic-info-grid { display: flex; flex-direction: column; gap: 12rpx; }
.basic-info-row { display: flex; flex-direction: row; gap: 12rpx; }
.basic-info-cell { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 6rpx; padding: 18rpx 8rpx; border-radius: 12rpx; background-color: var(--canvas); }
.basic-info-label { color: var(--muted); font-size: 20rpx; }
.basic-info-value { color: var(--ink); font-size: 24rpx; font-weight: 600; }
.moment-hero { width: 100%; height: 380rpx; border-radius: 16rpx; background-color: var(--warm); }
.qa-card { display: flex; flex-direction: column; gap: 12rpx; padding: 24rpx; border-radius: 16rpx; background-color: var(--canvas); }
.qa-question { color: var(--accent2); font-size: 24rpx; font-weight: 700; }
.qa-answer { color: var(--ink2); font-size: 24rpx; line-height: 1.6; }
.section-more { color: var(--accent2); font-size: 22rpx; }
.dynamic-card { display: flex; flex-direction: column; gap: 18rpx; padding: 24rpx; border-radius: 18rpx; background-color: var(--canvas); }
.dynamic-user-row { display: flex; flex-direction: row; align-items: center; gap: 16rpx; }
.dynamic-avatar { width: 72rpx; height: 72rpx; border-radius: 50%; background-color: var(--warm); }
.dynamic-user-copy { display: flex; flex-direction: column; gap: 4rpx; }
.dynamic-name { color: var(--ink); font-size: 24rpx; font-weight: 700; }
.dynamic-time { color: var(--muted); font-size: 20rpx; }
.dynamic-content { color: var(--ink2); font-size: 24rpx; line-height: 1.6; }
.dynamic-photo { width: 100%; height: 320rpx; border-radius: 14rpx; background-color: var(--warm); }
.dynamic-topic { color: var(--accent2); font-size: 22rpx; }
.dynamic-count { color: var(--muted); font-size: 21rpx; }
.more-dynamics { display: flex; align-items: center; justify-content: center; padding: 18rpx; }
.more-dynamics-text { color: var(--accent2); font-size: 24rpx; font-weight: 600; }
.activity-row { padding-top: 28rpx; }
.activity-text { color: var(--accent2); font-size: 22rpx; }
.viewed-text { color: var(--muted); font-size: 22rpx; }
