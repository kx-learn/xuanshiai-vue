<template>
	<view class="detail-page">
		<view v-if="detailLoading" class="state-block">
			<text class="state-title">正在加载资料</text>
			<text class="state-description">请稍候，正在读取最新信息</text>
		</view>
		<view v-else-if="detailError != ''" class="error-state">
			<view class="error-mark"><text>!</text></view>
			<text class="error-title">{{ detailQuotaExhausted ? '今日浏览额度已用完' : '资料暂时无法打开' }}</text>
			<text class="error-description">{{ detailError }}</text>
			<text class="error-hint">{{ detailQuotaExhausted ? '开通会员可增加每日浏览额度' : '请检查网络后重试' }}</text>
			<view class="error-actions">
				<view class="error-retry" @tap="handleDetailErrorAction"><text>{{ detailQuotaExhausted ? '开通会员' : '重新加载' }}</text></view>
				<view class="error-cancel" @tap="onBack"><text>返回</text></view>
			</view>
		</view>
		<scroll-view v-else scroll-y class="detail-scroll" :scroll-into-view="scrollAnchor" enhanced show-scrollbar="false">
			<view v-if="!isLockedView" class="vip-detail-page">
				<view class="vip-cover-area">
					<image class="vip-cover-img" :src="user.cover != '' ? user.cover : user.avatar" mode="aspectFill"></image>
					<view class="vip-avatar-circle"><image class="vip-avatar" :src="user.avatar" mode="aspectFill"></image></view>
				</view>

				<view class="vip-profile-header">
					<view class="vip-name-row">
						<view class="vip-name-group"><text class="vip-name">{{ user.name }}</text><text class="vip-age">{{ user.age }}岁</text></view>
						<view v-if="user.isVIP" class="vip-badge vip-badge-large"><text class="vip-crown">♛</text><text class="vip-badge-text">VIP会员</text></view>
					</view>
					<text class="vip-meta">{{ user.job }} · {{ user.edu }}　{{ user.city }}　<text :class="['online-text', ('' + user.online).indexOf('离线') >= 0 ? 'online-text-off' : '']">{{ user.online }}</text><text v-if="user.distance != ''"> · {{ user.distance }}</text></text>
					<text v-if="visitorCount != null" class="visitor-count-text">已有 {{ visitorCount }} 人看过 Ta</text>
					<view v-if="user.tags.length > 0" class="tag-row"><view v-for="tag in user.tags" :key="tag" class="profile-tag"><text class="profile-tag-text">{{ tag }}</text></view></view>
					<text v-if="user.bio != ''" class="vip-bio">{{ user.bio }}</text>
				</view>

				<view class="vip-detail-content">
					<view class="vip-section-card">
						<text class="vip-section-title">基础资料</text>
						<view class="basic-info-grid">
							<view v-for="(row, ri) in user.basicInfo" :key="ri" class="basic-info-row">
								<view v-for="(item, ii) in row" :key="ii" class="basic-info-cell"><text class="basic-info-label">{{ item.label }}</text><text class="basic-info-value">{{ item.value }}</text></view>
							</view>
						</view>
					</view>

					<view v-if="certs.length > 0" class="vip-section-card">
						<text class="vip-section-title">认证信息</text>
						<view v-for="cert in certs" :key="cert.label" class="cert-item"><view class="cert-icon-wrap"><text class="cert-icon">{{ cert.icon }}</text></view><view class="cert-copy"><text class="cert-label">{{ cert.label }}</text><text class="cert-desc">{{ cert.desc }}</text></view><text class="cert-check">✓</text></view>
					</view>

					<view v-if="user.lifePhotos.length > 0" id="anchor-moments" class="vip-section-card">
						<text class="vip-section-title">Ta的瞬间</text>
						<image v-for="(photo, index) in user.lifePhotos" :key="index" class="moment-hero" :src="photo" mode="aspectFill"></image>
					</view>

					<view v-if="user.expect.length > 0" class="vip-section-card">
						<text class="vip-section-title">Ta的期待</text>
						<view v-for="(item, index) in user.expect" :key="index" class="qa-card"><text class="qa-answer">{{ item }}</text></view>
					</view>

					<view v-if="dynamics.length > 0" id="anchor-dynamics" class="vip-section-card">
						<view class="section-heading-row"><text class="vip-section-title">Ta的动态</text><text class="section-more">查看全部 ›</text></view>
						<view v-for="item in dynamics" :key="item.id" class="dynamic-card"><view class="dynamic-user-row"><image class="dynamic-avatar" :src="user.avatar" mode="aspectFill"></image><view class="dynamic-user-copy"><text class="dynamic-name">{{ user.name }}</text><text class="dynamic-time">{{ item.time }}</text></view></view><text class="dynamic-content">{{ item.content }}</text><image v-if="item.photo != ''" class="dynamic-photo" :src="item.photo" mode="aspectFill"></image><view class="dynamic-footer"><text class="dynamic-topic">{{ item.topic }}</text><text class="dynamic-count">♡ {{ item.likes }}　◌ {{ item.comments }}</text></view></view>
					</view>
				</view>
			</view>

			<view v-else class="locked-detail-page">
				<view class="locked-cover-area">
					<image class="locked-cover-img" :src="user.cover != '' ? user.cover : user.avatar" mode="aspectFill"></image>
					<view class="locked-avatar-circle"><image class="locked-avatar" :src="user.avatar" mode="aspectFill"></image></view>
				</view>

				<view class="locked-profile-header">
					<view class="locked-name-vip-row">
						<view class="locked-name-group"><text class="locked-name">{{ user.name }}</text><text class="locked-age">{{ user.age }}岁</text></view>
						<view v-if="user.isVIP" class="vip-badge vip-badge-large"><text class="vip-crown">♛</text><text class="vip-badge-text">VIP会员</text></view>
					</view>
					<text class="locked-meta">{{ user.job }} · {{ user.edu }}　{{ user.city }}　<text class="online-text">在线</text></text>
					<view class="tag-row">
						<view v-for="tag in user.tags" :key="tag" class="profile-tag"><text class="profile-tag-text">{{ tag }}</text></view>
					</view>
					<text class="locked-bio">{{ user.bio }}</text>
				</view>

				<view class="locked-detail-content">
					<view class="locked-section-card">
						<text class="locked-section-title">基础资料</text>
						<view class="vip-exclusive-card">
							<text class="exclusive-lock">▢</text>
							<text class="exclusive-title">VIP会员专属内容</text>
							<text class="exclusive-desc">开通VIP会员即可解锁Ta的语音介绍</text>
							<view class="unlock-button" @tap="openVipUnlock"><text class="unlock-button-text">去开通</text></view>
						</view>
					</view>

					<view class="locked-section-card certification-section">
						<text class="locked-section-title">认证信息</text>
						<view v-for="cert in certs" :key="cert.label" class="cert-item">
							<view class="cert-icon-wrap"><text class="cert-icon">{{ cert.icon }}</text></view>
							<view class="cert-copy"><text class="cert-label">{{ cert.label }}</text><text class="cert-desc">{{ cert.desc }}</text></view>
							<text class="cert-check">✓</text>
						</view>
					</view>

					<view class="locked-section-card">
						<text class="locked-section-title">Ta的瞬间</text>
						<view class="vip-exclusive-card">
							<text class="exclusive-lock">▢</text>
							<text class="exclusive-title">VIP会员专属内容</text>
							<text class="exclusive-desc">开通VIP会员即可解锁Ta的语音介绍</text>
							<view class="unlock-button" @tap="openVipUnlock"><text class="unlock-button-text">去开通</text></view>
						</view>
					</view>

					<view class="locked-section-card">
						<text class="locked-section-title">Ta的问答</text>
						<view class="vip-exclusive-card">
							<text class="exclusive-lock">▢</text>
							<text class="exclusive-title">VIP会员专属内容</text>
							<text class="exclusive-desc">开通VIP会员即可查看TA的择偶标准与期待</text>
							<view class="unlock-button" @tap="openVipUnlock"><text class="unlock-button-text">去开通</text></view>
						</view>
					</view>

				</view>
			</view>

			<view class="scroll-bottom-spacer"></view>
		</scroll-view>

			<!-- AI分身悬浮按钮：与首页同款液态玻璃·气泡低语图标，右下悬浮位（原合拍度悬浮球位置） -->
			<view v-if="!isOwnProfile && !isPreview && !detailLoading && detailError == ''" class="detail-ai-float" @tap="openAiAvatar">
				<view class="detail-ai-float-glass">
					<view class="detail-ai-float-halo"></view>
					<view class="detail-ai-float-bubble">
						<view class="detail-ai-float-dot detail-ai-float-dot1"></view>
						<view class="detail-ai-float-dot detail-ai-float-dot2"></view>
						<view class="detail-ai-float-dot detail-ai-float-dot3"></view>
					</view>
				</view>
			</view>
			<view v-if="showAiGuide" class="ai-guide-bubble" @tap="dismissAiGuide"><text class="ai-guide-text">与对方的AI分身聊天获取更多信息</text></view>

			<view v-if="isOwnProfile && !isPreview && !detailLoading && detailError == ''" class="bottom-bar bottom-bar-own">
				<view class="primary-action edit-only-btn" @tap="goEdit"><text class="primary-action-text">编辑资料</text></view>
			</view>
			<!-- 底部操作栏：与首页推荐页同款（分享 + 申请认识 + 收藏爱心） -->
			<view v-if="!isOwnProfile && !isPreview && !detailLoading && detailError == ''" class="float-bar">
				<view class="share-btn" @tap="onShare"><text class="ic ic-sys ic-fenxiang share-icon"></text></view>
				<view class="chat-btn" @tap="onMatch"><text class="ic ic-home ic-hello chat-icon"></text><text class="chat-text">申请认识</text></view>
				<view class="like-btn" @tap="onLike">
					<text v-if="isLikedUser" class="heart-icon heart-font heart-solid"></text>
					<text v-else class="heart-icon heart-font heart-outline"></text>
				</view>
			</view>

		<XsaApplySheet :visible="applyVisible" :user-id="applyUserId" @close="applyVisible = false" @success="onApplySuccess" />
		<XsaPaymentSheet :visible="spotlightPaymentVisible" :amount="SPOTLIGHT_AMOUNT" :loading="spotlightPaying" confirm-text="确认支付爆灯" notice="爆灯 9.9 元/次：确认后展示爆灯成功状态。" @close="closeSpotlightPayment" @confirm="confirmSpotlightPayment" />
		<XsaSpotlightSuccessSheet :visible="spotlightSuccessVisible" :target="spotlightTarget" @close="closeSpotlightSuccess" />

		<XsaSheet :visible="matchVisible" title="AI 合拍度解读" @close="matchVisible = false">
			<view class="match-sheet">
				<view class="match-sheet-score"><text>{{ user.match > 0 ? user.match + '%' : '暂无评分' }}</text></view>
				<view class="match-interpret">
					<view class="match-interpret-head"><text class="match-interpret-mark">✦</text><text class="match-interpret-title">AI 解读</text></view>
					<text class="match-interpret-text">{{ detailInterpretation }}</text>
				</view>
				<view class="match-sheet-tip"><text>基于公开资料与兴趣交集生成，不代表平台承诺结果。建议从共同兴趣或城市周末安排开始聊。</text></view>
			</view>
		</XsaSheet>
	</view>
</template>

<script setup lang="uts">
import { ref, computed } from 'vue'
import XsaApplySheet from '@/components/XsaApplySheet.uvue'
import XsaPaymentSheet from '@/components/XsaPaymentSheet.uvue'
import XsaSpotlightSuccessSheet from '@/components/XsaSpotlightSuccessSheet.uvue'
import XsaSheet from '@/components/XsaSheet.uvue'
import { getUserDetail, likeUser, getOwnProfile, getMyPosts, getMembershipStatus, getUserVisitorCount, saveAiAvatarProfileSnapshot, getDynamicList } from '@/api'
import { resolveMediaUrl, getAccessToken } from '@/api/config.uts'
import locationJson from '@/data/location.json'
import { SPOTLIGHT_AMOUNT, paySpotlight } from '@/api/spotlight.uts'
import { guardRealName } from '@/utils/realNameGate.uts'

const isLockedView = ref(false)
const viewerIsVip = ref(false)
const isOwnProfile = ref(false)
const isPreview = ref(false)
const isLikedUser = ref(false)
const showAiGuide = ref(false)
const scrollAnchor = ref('')
const matchVisible = ref(false)
const detailLoading = ref(true)
const detailError = ref('')
const detailQuotaExhausted = ref(false)
const applyVisible = ref(false)
const applyUserId = ref(1)
const spotlightPaymentVisible = ref(false)
const spotlightSuccessVisible = ref(false)
const spotlightPaying = ref(false)
const spotlightTarget = ref({ id: 0, name: '', avatar: '', meta: '' })
const visitorCount = ref<number | null>(null)

const user = ref({
	id: 0,
	detailLocked: false,
	name: '', age: '', avatar: '', isVIP: false, job: '', edu: '', city: '',
	online: '', distance: '', recentActivity: '', match: 0, mbti: '', tags: [], bio: '',
	cover: '', photos: [], lifePhotos: [], expect: [], basicInfo: []
})

const certs = ref([
	{ icon: '盾', shortLabel: '实名', label: '实名认证', desc: '已通过平台实名认证' },
	{ icon: '学', shortLabel: '学历', label: '学历认证', desc: '学历信息已核验' },
	{ icon: '像', shortLabel: '头像', label: '头像认证', desc: '头像为本人真实照片' },
	{ icon: '房', shortLabel: '房产', label: '房产认证', desc: '房产信息已认证' }
])

const dynamics = ref([] as any[])

const textValue = (value: any, fallback: string): string => {
	return value != null && value != '' ? '' + value : fallback
}

const firstField = (raw: any, keys: string[]): any => {
	if (raw == null) return null
	for (const key of keys) if (raw[key] != null && raw[key] != '') return raw[key]
	return null
}

const locationTextByCodes = (raw: any, provinceKey: string, cityKey: string, districtKey: string): string => {
	const provinceCode = raw != null ? textValue(raw[provinceKey], '') : ''
	const cityCode = raw != null ? textValue(raw[cityKey], '') : ''
	const districtCode = raw != null ? textValue(raw[districtKey], '') : ''
	if (provinceCode == '' || cityCode == '' || districtCode == '') return ''
	const provinces = Array.isArray(locationJson) ? locationJson as any[] : []
	for (const province of provinces) {
		if ('' + province.code != provinceCode) continue
		const cities = Array.isArray(province.city) ? province.city as any[] : []
		for (const city of cities) {
			if ('' + city.code != cityCode) continue
			const areas = Array.isArray(city.area) ? city.area as any[] : []
			for (const area of areas) if ('' + area.code == districtCode) return province.name + ' ' + city.name + ' ' + area.name
		}
	}
	return ''
}

const locationTextByPrefix = (raw: any, prefix: string): string => {
	const province = firstField(raw, [prefix + '_province_code', prefix + '_province'])
	const city = firstField(raw, [prefix + '_city_code', prefix + '_city'])
	const district = firstField(raw, [prefix + '_district_code', prefix + '_district', prefix + '_area_code', prefix + '_area'])
	if (province != null && city != null && district != null) {
		const provinces = Array.isArray(locationJson) ? locationJson as any[] : []
		for (const item of provinces) {
			if ('' + item.code != '' + province && '' + item.name != '' + province) continue
			const cities = Array.isArray(item.city) ? item.city as any[] : []
			for (const cityItem of cities) {
				if ('' + cityItem.code != '' + city && '' + cityItem.name != '' + city) continue
				const areas = Array.isArray(cityItem.area) ? cityItem.area as any[] : []
				for (const area of areas) if ('' + area.code == '' + district || '' + area.name == '' + district) return item.name + ' ' + cityItem.name + ' ' + area.name
			}
		}
	}
	return ''
}

const constellationFromBirthday = (birthday: any): string => {
	const value = textValue(birthday, '')
	if (value.length < 10) return ''
	const month = Number(value.substring(5, 7))
	const day = Number(value.substring(8, 10))
	const signs = ['摩羯座', '水瓶座', '双鱼座', '白羊座', '金牛座', '双子座', '巨蟹座', '狮子座', '处女座', '天秤座', '天蝎座', '射手座']
	const cutoffs = [20, 19, 21, 21, 21, 22, 23, 23, 23, 23, 22, 22]
	if (month < 1 || month > 12 || day < 1 || day > 31) return ''
	return signs[(day < cutoffs[month - 1] ? month - 1 : month) % 12]
}

const locationTextByCityCode = (rawCode: any): string => {
	const cityCode = textValue(rawCode, '')
	if (cityCode == '') return ''
	const provinces = Array.isArray(locationJson) ? locationJson as any[] : []
	for (const province of provinces) {
		const cities = Array.isArray(province.city) ? province.city as any[] : []
		for (const city of cities) {
			if ('' + city.code == cityCode) return province.name + ' ' + city.name
		}
	}
	return ''
}

const formatDimension = (raw: any, unit: string): string => {
	if (raw == null || raw === '' || Number(raw) <= 0) return '未填写'
	const output = '' + raw
	return output.endsWith(unit) ? output : output + unit
}

const formatIncome = (raw: any): string => {
	if (raw == null || raw === '') return '未填写'
	const text = '' + raw
	const amount = Number(text)
	if (!isNaN(amount) && text.trim() != '') {
		// 初始登录问卷把收入文本换算成数字存储，这里反向映射回登录时的枚举文案，保证口径一致
		if (amount == 50000) return '小于10w'
		if (amount == 150000) return '10-20w'
		if (amount == 400000) return '30-50w'
		if (amount == 750000) return '50-100w'
		if (amount >= 1000000) return '100w以上'
		const wan = Math.round(amount / 1000) / 10
		return (wan % 1 == 0 ? '' + Math.round(wan) : '' + wan) + 'w'
	}
	return text.replace(/万/g, 'w')
}

user.value = {
	id: 0, name: '', detailLocked: false, age: '', avatar: '', isVIP: false, job: '', edu: '', city: '',
	online: '', distance: '', recentActivity: '', match: 0, tags: [], bio: '',
	cover: '', photos: [], lifePhotos: [], expect: [], basicInfo: []
}
dynamics.value = []
certs.value = []

const mapDetailUser = (raw: any, id: number) => {
	if (raw == null) return
	const envelope = raw.data != null ? raw.data : raw
	if (envelope == null) return
	const card = envelope.card != null ? envelope.card : envelope
	const profile = envelope.profile != null ? envelope.profile : envelope
	const account = envelope.user != null ? envelope.user : {}
	const value = (primary: any, secondary: any, fallback: string): string => {
		return textValue(primary, textValue(secondary, fallback))
	}
	const missing = '未填写'
	const age = value(card.age, profile.age, missing)
	const educationLabel = (level: any): string => {
		const labels = ['', '博士', '硕士', '本科', '大专', '高中', '中专', '初中', '小学']
		if (level == null || level === '') return ''
		const text = '' + level
		const index = Number(text)
		if (!isNaN(index) && text.trim() != '') return index > 0 && index < labels.length ? labels[index] : ''
		return text
	}
	const educationValue = firstField(card, ['education', 'education_level', 'edu']) || firstField(profile, ['education', 'education_level', 'edu'])
	const edu = educationLabel(educationValue) == '' ? missing : educationLabel(educationValue)
	const job = value(card.occupation, profile.occupation, value(card.job, profile.job, missing))
	const residenceText = value(profile.residence_display, card.residence_display, value(envelope.residence_display, '', locationTextByCodes(profile, 'residence_province_code', 'residence_city_code', 'residence_district_code') || locationTextByPrefix(profile, 'residence') || locationTextByPrefix(envelope, 'residence') || locationTextByCityCode(card.city_code)))
	const hometownText = value(profile.hometown_display, card.hometown_display, value(envelope.hometown_display, '', locationTextByCodes(profile, 'hometown_province_code', 'hometown_city_code', 'hometown_district_code') || locationTextByPrefix(profile, 'hometown') || locationTextByPrefix(envelope, 'hometown')))
	const city = value(residenceText, card.residence, value(profile.residence, value(card.city, profile.city, missing), missing))
	const height = formatDimension(card.height != null ? card.height : profile.height, 'cm')
	const weight = formatDimension(card.weight != null ? card.weight : profile.weight, 'kg')
	const birthday = firstField(card, ['birthday', 'birth_date', 'date_of_birth']) || firstField(profile, ['birthday', 'birth_date', 'date_of_birth']) || firstField(envelope, ['birthday', 'birth_date', 'date_of_birth'])
	const constellation = value(card.constellation, profile.constellation, constellationFromBirthday(birthday) == '' ? missing : constellationFromBirthday(birthday))
	const hometown = value(hometownText, card.hometown, value(profile.hometown, missing, missing))
	const incomeValue = firstField(profile, ['income_display', 'income', 'salary']) || firstField(card, ['income_display', 'income', 'salary']) || firstField(envelope, ['income_display', 'income', 'salary'])
	const income = formatIncome(incomeValue)
	const marriageStatus = card.is_married != null ? card.is_married : profile.is_married
	const marriage = value(card.marriage, marriageStatus == 1 ? '未婚' : marriageStatus == 2 ? '离异' : marriageStatus == 3 ? '丧偶' : null, '未填写')
	const mbti = value(card.mbti, profile.mbti, '未填写')
	const activeStatus = value(card.activeStatus, card.active_status, '未填写')
	const avatar = resolveMediaUrl(value(card.avatar, profile.avatar, value(envelope.avatar, account.avatar, '')))
	const background = resolveMediaUrl(value(card.background_wall, profile.background_wall, value(envelope.background_wall, '', '')))
	const nickname = value(card.nickname, profile.nickname, value(envelope.nickname, account.nickname, ''))
	const detailLocked = card.detail_locked === true || envelope.detail_locked === true
	if (envelope.is_vip_viewer != null) viewerIsVip.value = envelope.is_vip_viewer === true
	const rawPhotos = card.photos != null ? card.photos : profile.photos
	const photos = Array.isArray(rawPhotos)
		? (rawPhotos as any[]).map((photo: any) => photo != null && typeof photo === 'object' ? resolveMediaUrl(value(photo.url, photo.file_url, avatar)) : resolveMediaUrl(photo))
		: []
	const lifePhotos = photos
	const tags = Array.isArray(card.interest_tags) ? card.interest_tags as string[] : Array.isArray(card.tags) ? card.tags as string[] : Array.isArray(profile.interest_tags) ? profile.interest_tags as string[] : []
	const tagWithMbti = mbti != '' && mbti != '未填写' ? [mbti].concat(tags) : tags
	const expectations = profile.tag_selections != null && Array.isArray(profile.tag_selections.relationship_expectation)
		? profile.tag_selections.relationship_expectation as string[]
		: Array.isArray(card.expect) && card.expect.length > 0 ? card.expect as string[] : []
	const mappedInfo = [
		[{ label: '年龄', value: age == missing ? missing : age + '岁' }, { label: '身高', value: height }, { label: '体重', value: weight }],
		[{ label: '星座', value: constellation }, { label: '学历', value: edu }, { label: '职业', value: job }],
		[{ label: '现居', value: city }, { label: '家乡', value: hometown }, { label: '收入', value: income }],
		[{ label: '婚姻', value: marriage }, { label: 'MBTI', value: mbti }, { label: '状态', value: activeStatus }]
	]
	user.value = {
		...user.value,
		id: envelope.user_id != null ? Number(envelope.user_id) : (card.id != null ? Number(card.id) : id),
		name: value(nickname, card.name, user.value.name),
		detailLocked,
		age,
		avatar,
		isVIP: card.is_vip === true || card.isVip === true || card.isVIP === true || profile.is_vip === true || profile.isVip === true || profile.isVIP === true,
		job,
		edu,
		city,
		online: value(card.online, card.online_status, ''),
		distance: value(card.distance, card.distance_km != null ? '距你 ' + card.distance_km + 'km' : null, ''),
		recentActivity: value(card.recentActivity, card.activeStatus, ''),
		match: card.match_score != null ? Number(card.match_score) : (card.match != null ? Number(card.match) : 0),
		mbti,
		tags: tagWithMbti,
		bio: value(card.intro, profile.self_intro, value(card.introduction, profile.introduction, '')),
		cover: background != '' ? background : (photos.length > 0 ? photos[0] : avatar),
		photos,
		lifePhotos,
		expect: expectations,
		basicInfo: mappedInfo
	}
	applyUserId.value = user.value.id
}

const load = async () => {
	detailLoading.value = true
	detailError.value = ''
	detailQuotaExhausted.value = false
	visitorCount.value = null
	try {
		let res: any = null
		if (isOwnProfile.value) {
			res = await getOwnProfile()
		} else {
			res = await getUserDetail(user.value.id)
		}
		if (res != null && res.success === true && res.data != null) {
			mapDetailUser(res, user.value.id)
			if (!isOwnProfile.value && !isPreview.value && user.value.id > 0) {
				const visitorRes = await getUserVisitorCount(user.value.id)
				if (visitorRes != null && visitorRes.success === true && visitorRes.data != null) {
					const count = Number((visitorRes.data as any).visitor_count)
					if (!isNaN(count) && count >= 0) visitorCount.value = count
				}
			}
			if (isOwnProfile.value) {
				const postsRes = await getMyPosts({ page: 1, pageSize: 50 })
				if (postsRes.success && postsRes.data != null) {
					const rawPosts = postsRes.data.list != null ? postsRes.data.list as any[] : []
					dynamics.value = rawPosts.map((post: any) => ({
						id: post.id,
						time: post.timeText != null ? '' + post.timeText : '',
						content: post.content != null ? '' + post.content : '',
						photo: post.photos != null && post.photos.length > 0 ? '' + post.photos[0] : '',
						topic: post.topicTitle != null ? '' + post.topicTitle : '',
						likes: post.likeCount != null ? Number(post.likeCount) : 0,
						comments: post.commentCount != null ? Number(post.commentCount) : 0
					}))
				}
			} else if (!isPreview.value && user.value.id > 0) {
				await loadUserDynamics(user.value.id)
			}
		} else {
			const message = res != null && res.message != null ? '' + res.message : '请稍后重试'
			detailQuotaExhausted.value = res != null && Number(res.code) == 429 && message.indexOf('浏览额度') >= 0
			detailError.value = detailQuotaExhausted.value ? '今日完整浏览额度已用完' : message
		}
	} catch (e) {
		detailError.value = '网络异常，请稍后重试'
	} finally {
		detailLoading.value = false
		refreshLockedView()
	}
}

const loadUserDynamics = async (targetUserId: number) => {
	if (targetUserId <= 0) return
	const collected: any[] = []
	for (let page = 1; page <= 5; page++) {
		const res = await getDynamicList({ tab: 'discover', page: page, pageSize: 20 })
		if (!res.success || res.data == null) break
		const data = res.data as any
		const rows = data.list != null && Array.isArray(data.list) ? data.list as any[] : []
		for (let i = 0; i < rows.length; i++) {
			const row = rows[i]
			const author = row.user != null ? row.user : {}
			const authorId = Number(author.id != null ? author.id : (author.userId != null ? author.userId : 0))
			if (authorId != targetUserId) continue
			const rowPhotos = row.photos != null && Array.isArray(row.photos) ? row.photos as any[] : []
			const rowTags = row.tags != null && Array.isArray(row.tags) ? row.tags as any[] : []
			collected.push({
				id: Number(row.id || 0),
				time: row.timeText != null ? '' + row.timeText : '',
				content: row.content != null ? '' + row.content : '',
				photo: rowPhotos.length > 0 ? resolveMediaUrl(rowPhotos[0]) : '',
				topic: rowTags.length > 0 ? '' + rowTags[0] : '',
				likes: Number(row.likeCount || 0),
				comments: Number(row.commentCount || 0)
			})
		}
		if (data.hasMore != true) break
	}
	dynamics.value = collected
}

const refreshLockedView = () => {
	const targetIsVip = user.value.isVIP === true
	isLockedView.value =
		!isPreview.value &&
		!isOwnProfile.value &&
		viewerIsVip.value !== true && targetIsVip
}

const loadViewerMembership = async () => {
	if (isOwnProfile.value || isPreview.value) return
	const res = await getMembershipStatus()
	if (res.success && res.data != null) viewerIsVip.value = (res.data as any).is_vip == true
}

const redirectParentRoute = (): boolean => {
	let storedMode: any = null
	try { storedMode = uni.getStorageSync('xsa_onboarding_mode') } catch (e) {}
	if (storedMode == null || String(storedMode) != 'parent') return false
	uni.reLaunch({ url: '/pages/parent/parent' })
	return true
}

onMounted(async () => {
	if (redirectParentRoute()) return
	const pages = getCurrentPages()
	const currentPage = pages[pages.length - 1]
	const options = currentPage.options
	isPreview.value = options.preview === 'true' || options.preview === true

	let parsed = 1
	if (options.userId != null && options.userId != '') {
		const candidate = Number(options.userId)
		if (!isNaN(candidate) && candidate > 0) parsed = candidate
	}
	let viewerId = 0
	try {
		const storedViewerId = uni.getStorageSync('xsa_user_id')
		if (storedViewerId != null && storedViewerId != '') {
			const candidateViewerId = Number(storedViewerId)
			if (!isNaN(candidateViewerId) && candidateViewerId > 0) viewerId = candidateViewerId
		}
	} catch (e) {}
	isOwnProfile.value = options.own === 'true' || options.own === true || isPreview.value || (viewerId > 0 && viewerId == parsed)
	user.value.id = parsed
	applyUserId.value = parsed
	await loadViewerMembership()
	await load()
	if (!isOwnProfile.value && !isPreview.value && uni.getStorageSync('xsa_ai_avatar_guide_shown') != true) showAiGuide.value = true
	if (options.anchor != null && ('' + options.anchor) != '') {
		const anchorId = '' + options.anchor
		setTimeout(() => { scrollAnchor.value = anchorId }, 400)
	}
})

onShow(async () => {
	if (redirectParentRoute()) return
	await loadViewerMembership()
	refreshLockedView()
})

const onBack = () => { uni.navigateBack({ delta: 1 }) }
const openQuotaMembership = () => { uni.navigateTo({ url: '/pagesSub/profileExtra/vip' }) }
const handleDetailErrorAction = () => { if (detailQuotaExhausted.value) openQuotaMembership(); else load() }
const onShare = () => { uni.showToast({ title: '分享给朋友', icon: 'none' }) }
const goEdit = () => { uni.navigateTo({ url: '/pagesSub/userExtra/user/edit' }) }
const dismissAiGuide = () => {
	if (!showAiGuide.value) return
	showAiGuide.value = false
	uni.setStorageSync('xsa_ai_avatar_guide_shown', true)
}

const detailInterpretation = computed((): string => {
	const score = Number(user.value.match || 0)
	const tagList = user.value.tags as any[]
	const interests = tagList != null && tagList.length > 0 ? tagList.join('、') : ''
	const parts: string[] = []
	if (interests != '') parts.push('在' + interests + '上你们交集明显，很适合作为第一次聊天的切入点')
	if (score >= 80) parts.push('整体契合度较高，建议先从共同话题开始慢慢了解')
	else parts.push('契合度还有上升空间，多聊聊彼此的生活节奏会更清楚')
	return parts.join('。') + '。'
})
const openAiAvatar = () => {
	dismissAiGuide()
	if (isOwnProfile.value) return
	if (getAccessToken() == '') {
		uni.showToast({ title: '请先登录后使用 AI 分身', icon: 'none' })
		setTimeout(() => { uni.navigateTo({ url: '/pages/auth/login' }) }, 350)
		return
	}
	const snapshotRes = saveAiAvatarProfileSnapshot(user.value.id, {
		id: user.value.id,
		name: user.value.name,
		avatar: user.value.avatar,
		age: user.value.age,
		city: user.value.city,
		job: user.value.job,
		education: user.value.edu,
		tags: user.value.tags,
		intro: user.value.bio,
		expectations: isLockedView.value ? [] : user.value.expect,
		dynamicSummary: isLockedView.value ? [] : dynamics.value.map((item: any) => item.content)
	}, isLockedView.value)
	if (!snapshotRes.success) {
		uni.showToast({ title: snapshotRes.message != null ? String(snapshotRes.message) : '公开资料读取失败', icon: 'none' })
		return
	}
	const url = '/pagesSub/chat/detail?mode=ai-avatar&userId=' + String(user.value.id)
		+ '&userName=' + encodeURIComponent(String(user.value.name))
		+ '&locked=' + (isLockedView.value ? 'true' : 'false')
	uni.navigateTo({ url: url, fail: () => { uni.showToast({ title: 'AI 分身打开失败，请重试', icon: 'none' }) } })
}
const onSpotlight = () => {
	if (isOwnProfile.value) {
		uni.showToast({ title: '不能向自己爆灯', icon: 'none' })
		return
	}
	if (spotlightPaying.value) return
	spotlightTarget.value = { id: Number(user.value.id), name: '' + user.value.name, avatar: '' + user.value.avatar, meta: '' + user.value.age + '岁 · ' + user.value.job }
	spotlightPaymentVisible.value = true
}
const closeSpotlightPayment = () => { if (!spotlightPaying.value) spotlightPaymentVisible.value = false }
const closeSpotlightSuccess = () => {
	spotlightSuccessVisible.value = false
	spotlightTarget.value = { id: 0, name: '', avatar: '', meta: '' }
}
const confirmSpotlightPayment = async () => {
	if (spotlightPaying.value) return
	spotlightPaying.value = true
	try {
		const res = await paySpotlight(spotlightTarget.value)
		if (res.success !== true) {
			uni.showToast({ title: res.message != null ? '' + res.message : '支付失败，请重试', icon: 'none' })
			return
		}
		spotlightPaymentVisible.value = false
		spotlightSuccessVisible.value = true
	} catch (e) {
		uni.showToast({ title: '网络异常，支付未完成', icon: 'none' })
	} finally {
		spotlightPaying.value = false
	}
}
const openVipUnlock = () => {
	const redirect = '/pagesSub/userExtra/user/detail?userId=' + user.value.id
	uni.navigateTo({
		url: '/pagesSub/profileExtra/vip?source=user-detail&userId=' + user.value.id + '&redirect=' + encodeURIComponent(redirect)
	})
}
const onMatch = async () => {
	if (isOwnProfile.value) {
		uni.showToast({ title: '不能向自己申请认识', icon: 'none' })
		return
	}
	const ok = await guardRealName('apply')
	if (!ok) return
	applyUserId.value = user.value.id
	applyVisible.value = true
}
const onApplySuccess = (_payload: any) => {
	applyVisible.value = false
	uni.showToast({ title: '申请已送达，等待对方回应', icon: 'none' })
}
const onLike = async () => {
	if (isOwnProfile.value) {
		uni.showToast({ title: '不能喜欢自己', icon: 'none' })
		return
	}
	const ok = await guardRealName('like')
	if (!ok) return
	const id = user.value.id != null ? Number(user.value.id) : 1
	try {
		const res = await likeUser(id)
		if (res.success && res.data != null) {
			const liked = res.data.liked == true
			isLikedUser.value = liked
			uni.showToast({ title: liked ? '已收藏，仅你自己可见' : '已取消收藏', icon: 'none' })
		} else {
			uni.showToast({ title: '操作失败，请重试', icon: 'none' })
		}
	} catch (e) {
		uni.showToast({ title: '操作失败，请重试', icon: 'none' })
	}
}
</script>

<style scoped>
.detail-page { position: relative; width: 100%; max-width: 750rpx; height: 100vh; margin: 0 auto; background-color: var(--canvas); color: var(--ink);
	/* 底部操作栏/悬浮球专用：与首页 .page 作用域同源的暖绿 token（非页面全局青瓷绿） */
