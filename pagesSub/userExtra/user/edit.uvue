.pledge-actions { display: flex; flex-direction: row; gap: 12px; margin-top: 22px; }
.pledge-cancel, .pledge-confirm { flex: 1; height: 44px; display: flex; align-items: center; justify-content: center; border-radius: 22px; font-size: 14px; font-weight: 700; }
.pledge-cancel { border: 1px solid var(--line); color: var(--ink2); background: var(--paper); }
.pledge-confirm { color: var(--text-invert); background: var(--sage); }
