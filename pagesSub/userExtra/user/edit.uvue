<template>
	<view class="edit-page">
		<view class="nav-bar">
			<view class="nav-back" @tap="onCancel"><text class="nav-back-icon">‹</text></view>
			<text class="nav-title">编辑资料</text>
		</view>

		<view v-if="loading" class="state-block">
			<view class="loading-orbit"><view class="loading-ring"></view><view class="loading-core"><text>宣</text></view></view>
			<text class="state-title">正在准备你的资料</text>
			<text class="state-description">读取最新信息，请稍候</text>
			<view class="loading-dots"><view></view><view></view><view></view></view>
		</view>
		<view v-else-if="loadError != '' && !profileLoaded" class="error-state">
			<view class="error-mark"><text>!</text></view>
			<text class="error-title">资料暂时无法打开</text>
			<text class="error-description">{{ loadError }}</text>
			<text class="error-hint">请检查网络后重试</text>
			<view class="error-actions">
				<view class="error-retry" @tap="load"><text>重新加载</text></view>
				<view class="error-cancel" @tap="onCancel"><text>返回</text></view>
			</view>
		</view>

		<scroll-view v-else class="scroll-content" scroll-y enhanced show-scrollbar="false" refresher-enabled="true" :refresher-triggered="refreshing" @refresherrefresh="onPullRefresh" @refresherrestore="refreshing = false">
			<view class="progress-section">
				<view class="progress-header"><text class="progress-label">资料完整度</text><text class="progress-value">{{ completeness }}%</text></view>
				<view class="progress-track"><view class="progress-fill" :style="{ width: completeness + '%' }"></view></view>
				<text class="progress-hint">资料越完整，推荐权重越高，更容易遇见对的人</text>
				<text v-if="missingCompletionSummary != ''" class="progress-missing">待完善：{{ missingCompletionSummary }}</text>
			</view>

			<view class="section-card avatar-section">
				<view class="section-heading">
					<text class="section-title">头像{{ completionSuffix('avatar', 15) }}</text>
					<view class="heading-actions"><view class="preview-action" @tap="onPreview"><text>主页预览</text><text class="preview-action-arrow">›</text></view><view class="pill-action" @tap="changeBackground"><text class="pill-action-text">更换背景</text><text class="pill-action-arrow">›</text></view></view>
				</view>
				<view class="avatar-row">
					<view class="avatar-box" @tap="chooseAvatar">
						<image class="avatar-image" :src="formData.avatar" mode="aspectFill"></image>
						<view class="camera-badge"><text class="camera-icon">⌾</text></view>
					</view>
					<view class="avatar-copy"><text class="avatar-title">上传真实头像</text><text class="avatar-description">正面高清照，衣着得体，提高推荐排名</text></view>
				</view>
				<text class="avatar-rule">⚠ 他人照片、看不清脸、P图过度、非人物照将无法通过审核</text>
			</view>

			<view class="section-card album-card">
				<view class="section-heading"><text class="section-title">我的相册{{ completionSuffix('album', 8) }}</text><text class="section-caption">{{ formData.photos.length }}/9</text></view>
				<view class="album-grid">
					<view class="album-cell" v-for="(photo, index) in formData.photos" :key="photo.id != null ? photo.id : index">
						<image class="album-photo" :src="photo.url" mode="aspectFill"></image>
						<view class="album-delete" @tap="deletePhoto(index)"><text>×</text></view>
					</view>
					<view v-if="formData.photos.length < 9" class="album-cell add-cell" @tap="addPhoto"><text class="add-icon">+</text></view>
				</view>
				<text class="media-note" v-if="uploadingMedia">正在上传媒体，请稍候</text>
			</view>

			<view class="section-card nickname-card">
				<view class="section-heading">
					<text class="section-title">昵称</text>
				</view>
				<view class="nickname-edit-row">
					<input class="nickname-edit-input" :value="formData.nickname" placeholder="请输入昵称" @input="onInput('nickname', $event)" />
					<view class="nickname-edit-save" @tap="saveNickname"><text>保存</text></view>
				</view>
			</view>

			<view class="section-card preview-card">
				<view class="section-heading">
					<text class="section-title">基础信息</text>
					<view class="pill-action" @tap="openBasicEditor"><text class="pill-action-text">编辑</text><text class="pill-action-arrow">›</text></view>
				</view>
				<view class="preview-list">
					<view class="preview-row"><text class="preview-label">性别</text><text class="preview-value">{{ completionText('gender', genderText == '未选择' ? '' : genderText, '未填写', 7) }}</text></view>
					<view class="preview-row"><text class="preview-label">年龄</text><text class="preview-value">{{ completionText('birthday', agePreview == '未填写' ? '' : agePreview, '未填写', 7) }}</text></view>
				<view class="preview-row"><text class="preview-label">星座</text><text class="preview-value">{{ constellationText != '' ? constellationText : '未填写' }}</text></view>
					<view class="preview-row"><text class="preview-label">身高</text><text class="preview-value">{{ completionText('height', formData.height != '' ? formData.height + ' cm' : '', '未填写', 4) }}</text></view>
					<view class="preview-row"><text class="preview-label">体重</text><text class="preview-value">{{ completionText('weight', formData.weight != '' ? formData.weight + ' kg' : '', '未填写', 4) }}</text></view>
					<view class="preview-row"><text class="preview-label">学历</text><text class="preview-value">{{ completionText('education', educationText == '未选择' ? '' : educationText, '未填写', 4) }}</text></view>
					<view class="preview-row"><text class="preview-label">现居地</text><text class="preview-value">{{ completionText('location', formData.residenceCityCode, '未填写', 5) }}</text></view>
					<view class="preview-row"><text class="preview-label">家乡</text><text class="preview-value">{{ completionText('hometown', formData.hometown, '未填写', 4) }}</text></view>
					<view class="preview-row"><text class="preview-label">职业</text><text class="preview-value">{{ completionText('occupation', occupationPreview == '未填写' ? '' : occupationPreview, '未填写', 4) }}</text></view>
					<view class="preview-row"><text class="preview-label">收入</text><text class="preview-value">{{ completionText('income', incomePreview == '未填写' ? '' : incomePreview, '未填写', 4) }}</text></view>
					<view class="preview-row"><text class="preview-label">婚姻状况</text><text class="preview-value">{{ completionText('marriage', maritalText == '未选择' ? '' : maritalText, '未填写', 5) }}</text></view>
					<view class="preview-row"><text class="preview-label">MBTI</text><text class="preview-value">{{ completionText('mbti', formData.mbti, '未填写', 2) }}</text></view>
					<view class="preview-row"><text class="preview-label">微信号</text><text class="preview-value">{{ formData.wechat || '仅作为紧急联系' }}</text></view>
				</view>
			</view>

			<view class="section-card certification-card">
				<view class="section-heading">
					<text class="section-title">四重认证</text>
					<text class="section-caption">已完成 {{ completedCertCount }}/4{{ completionSuffix('realname', 5, ' · 实名') }}{{ completionSuffix('single_pledge', 1, ' · 单身承诺') }}</text>
				</view>
				<view class="cert-row" v-for="cert in certifications" :key="cert.key">
					<view class="cert-icon-wrap" :class="{ 'cert-icon-done': cert.passed }"><text class="cert-icon">{{ cert.icon }}</text></view>
					<view class="cert-copy"><text class="cert-label">{{ cert.label }}</text><text class="cert-description">{{ cert.desc }}</text></view>
					<view v-if="cert.passed" class="cert-done-pill"><text class="cert-done-text">已认证</text></view>
					<view v-else class="cert-pending" @tap="goCertification(cert.key)"><text class="cert-pending-text">去认证</text></view>
				</view>
			</view>

			<view class="section-card intro-card">
				<view class="section-heading"><text class="section-title">自我介绍{{ completionSuffix('intro', 10) }}</text><view class="pill-action" @tap="saveIntroduction"><text class="pill-action-text">保存</text></view></view>
				<textarea class="intro-main-input" :class="{ 'has-content': introHasContent }" :value="formData.introduction" maxlength="500" placeholder="分享一下你的性格、爱好、生活态度...让TA更快了解你" @input="onInput('introduction', $event)"></textarea>
				<text class="section-caption">超有趣的自我介绍会被更多人看见哦！完成后建议搭配照片验证</text>
				<text v-if="!completionPassed('intro')" class="completion-warning">自我介绍：少于后台要求的 20 字</text>
			</view>

			<view class="section-card tags-card" @tap="goTagsEdit('interest')">
				<view class="section-heading"><text class="section-title">兴趣标签{{ completionSuffix('interest', 5) }}</text><view class="pill-action"><text class="pill-action-text">编辑</text><text class="pill-action-arrow">›</text></view></view>
				<text class="section-caption">选择能代表你的兴趣爱好</text>
				<view class="tag-list">
					<view class="tag-chip" v-for="tag in interestDisplayTags" :key="'interest-' + tag"><text>{{ tag }}</text></view>
					<view v-if="interestDisplayTags.length == 0" class="tag-empty"><text>暂未填写</text></view>
				</view>
				<text v-if="!completionPassed('interest')" class="completion-warning">兴趣标签：少于 3 个</text>
			</view>

			<view class="section-card tags-card" @tap="goTagsEdit('personality')">
				<view class="section-heading"><text class="section-title">性格标签{{ completionSuffix('personality', 3) }}</text><view class="pill-action"><text class="pill-action-text">编辑</text><text class="pill-action-arrow">›</text></view></view>
				<text class="section-caption">选择能代表你的性格特征</text>
				<view class="tag-list">
					<view class="tag-chip tag-accent" v-for="tag in personalityDisplayTags" :key="'personality-' + tag"><text>{{ tag }}</text></view>
					<view v-if="personalityDisplayTags.length == 0" class="tag-empty"><text>暂未填写</text></view>
				</view>
				<text v-if="!completionPassed('personality')" class="completion-warning">性格标签：少于 3 个</text>
			</view>

			<navigator class="section-card preference-card" url="/pagesSub/userExtra/user/preference" hover-class="none">
				<view class="section-heading"><text class="section-title">择偶标准{{ completionSuffix('preference', 3) }}</text><view class="pill-action"><text class="pill-action-text">编辑</text><text class="pill-action-arrow">›</text></view></view>
				<text class="section-caption">设置你期待的年龄、身高、学历和距离范围</text>
				<view class="preference-summary"><text>{{ preferencePreview }}</text></view>
				<text v-if="!completionPassed('preference')" class="completion-warning">择偶要求：未看到有效年龄范围</text>
			</navigator>

			<view class="section-card qa-card">
				<text class="section-title">关于我</text>
				<text class="section-caption">你的回答将展示在个人主页，帮助对方更深入了解你</text>
				<view class="qa-item" v-for="(qa, index) in qaItems" :key="qa.id" @tap="openQaEditor(index)">
					<text class="qa-question">{{ qa.question }}</text>
					<view class="qa-answer-row">
						<text class="qa-hint" v-if="textValue(qa.answer) == ''">点击填写你的回答...</text>
						<text class="qa-answer-text" v-else>{{ qa.answer }}</text>
						<text class="qa-edit-icon">✎</text>
					</view>
				</view>
			</view>

			<view class="scroll-bottom-spacer"></view>
		</scroll-view>

		<view v-if="singlePledgeVisible" class="pledge-overlay" @tap="closeSinglePledge">
			<view class="pledge-dialog" @tap.stop>
				<text class="pledge-title">单身承诺</text>
				<text class="pledge-copy">我确认当前为单身状态，并承诺填写的信息真实有效。如状态发生变化，我会及时更新资料。</text>
				<view class="pledge-actions">
					<view class="pledge-cancel" @tap="closeSinglePledge"><text>暂不承诺</text></view>
					<view class="pledge-confirm" :class="{ disabled: singlePledgeSubmitting }" @tap="confirmSinglePledge"><text>{{ singlePledgeSubmitting ? '提交中...' : '同意并承诺' }}</text></view>
				</view>
			</view>
		</view>

		<view class="sheet-overlay" v-if="detailSheetVisible" @click="detailSheetVisible = false">
			<view class="sheet-panel" @click.stop>
				<view class="sheet-handle"></view>
				<view class="sheet-nav">
					<text class="sheet-title">编辑资料</text>
					<text class="sheet-close" @tap="detailSheetVisible = false">✕</text>
				</view>
				<scroll-view class="sheet-body" scroll-y enhanced show-scrollbar="false">
					<view v-if="editSheetMode == 'basic'">
					<view class="sheet-row">
						<text class="sheet-row-label">昵称</text>
						<input class="sheet-input" :value="formData.nickname" placeholder="请输入昵称" @input="onInput('nickname', $event)" /><text class="sheet-row-arrow">›</text>
					</view>
					<view class="sheet-divider"></view>
					<view class="sheet-row">
						<text class="sheet-row-label">性别</text>
						<picker class="sheet-row-right" mode="selector" :range="genderOptions" :disabled="isIdentityLocked" @change="onGenderChange"><text class="sheet-row-value">{{ genderText == '未选择' ? '请选择' : genderText }}</text><text class="sheet-row-arrow">›</text></picker>
					</view>
					<text v-if="isIdentityLocked" class="sheet-locked-note">实名认证后不可修改性别和生日</text>
					<view class="sheet-divider"></view>
					<view class="sheet-row">
						<text class="sheet-row-label">生日</text>
						<picker class="sheet-row-right" mode="date" :value="formData.birthday" start="1966-01-01" end="2008-07-30" :disabled="isIdentityLocked" @change="onBirthdayChange"><text class="sheet-row-value">{{ formData.birthday || '请选择出生日期' }}</text><text class="sheet-row-arrow">›</text></picker>
					</view>
					<view class="sheet-divider"></view>
					<view class="sheet-row">
						<text class="sheet-row-label">身高</text>
						<picker class="sheet-row-right" mode="selector" :range="heightOptions" :value="heightPickerIndex" @change="onHeightChange"><text class="sheet-row-value">{{ formData.height != '' ? formData.height + ' cm' : '请选择' }}</text><text class="sheet-row-arrow">›</text></picker>
					</view>
					<view class="sheet-divider"></view>
					<view class="sheet-row">
						<text class="sheet-row-label">体重</text>
						<picker class="sheet-row-right" mode="selector" :range="weightOptions" :value="weightPickerIndex" @change="onWeightChange"><text class="sheet-row-value">{{ formData.weight != '' ? formData.weight + ' kg' : '请选择' }}</text><text class="sheet-row-arrow">›</text></picker>
					</view>
					<view class="sheet-divider"></view>
					<view class="sheet-row">
						<text class="sheet-row-label">现居地</text>
						<picker class="sheet-row-right" mode="region" @change="onResidenceChange"><text class="sheet-row-value">{{ formData.residenceCityCode || '请选择' }}</text><text class="sheet-row-arrow">›</text></picker>
					</view>
					<view class="sheet-divider"></view>
					<view class="sheet-row">
						<text class="sheet-row-label">家乡</text>
						<picker class="sheet-row-right" mode="region" @change="onHometownChange"><text class="sheet-row-value">{{ formData.hometown || '请选择' }}</text><text class="sheet-row-arrow">›</text></picker>
					</view>
					<view class="sheet-divider"></view>
					<view class="sheet-row">
						<text class="sheet-row-label">婚姻状况</text>
						<picker class="sheet-row-right" mode="selector" :range="maritalOptions" @change="onMaritalChange"><text class="sheet-row-value">{{ maritalText == '未选择' ? '请选择' : maritalText }}</text><text class="sheet-row-arrow">›</text></picker>
					</view>
					<view class="sheet-divider"></view>
					<view class="sheet-row">
						<text class="sheet-row-label">学历</text>
						<picker class="sheet-row-right" mode="selector" :range="educationOptions" @change="onEducationChange"><text class="sheet-row-value">{{ educationText == '未选择' ? '请选择' : educationText }}</text><text class="sheet-row-arrow">›</text></picker>
					</view>
					<view class="sheet-divider"></view>
					<view class="sheet-row">
						<text class="sheet-row-label">职业</text>
						<input class="sheet-input" :value="formData.occupation" placeholder="请选择" @input="onInput('occupation', $event)" /><text class="sheet-row-arrow">›</text>
					</view>
					<view class="sheet-divider"></view>
					<view class="sheet-row">
						<text class="sheet-row-label">公司</text>
						<input class="sheet-input" :value="formData.company" placeholder="搜索公司名称" @input="onCompanyInput" /><text class="sheet-row-arrow">›</text>
					</view>
					<view v-if="companySuggestions.length > 0" class="sheet-suggestion-list"><view v-for="company in companySuggestions" :key="company" class="sheet-suggestion" @tap="chooseCompany(company)"><text>{{ company }}</text></view></view>
					<view class="sheet-divider"></view>
					<view class="sheet-row">
						<text class="sheet-row-label">收入</text>
						<picker class="sheet-row-right" mode="selector" :range="incomeOptions" :value="incomePickerIndex" @change="onIncomeChange"><text class="sheet-row-value">{{ incomeText }}</text><text class="sheet-row-arrow">›</text></picker>
					</view>
					<view class="sheet-divider"></view>
					<view class="sheet-row">
						<text class="sheet-row-label">MBTI</text>
						<picker class="sheet-row-right" mode="selector" :range="mbtiOptions" :value="mbtiPickerIndex" @change="onMbtiChange"><text class="sheet-row-value">{{ formData.mbti || '请选择' }}</text><text class="sheet-row-arrow">›</text></picker>
					</view>
					<view class="sheet-divider"></view>
					<view class="sheet-row">
						<text class="sheet-row-label">微信号</text>
						<input class="sheet-input" :value="formData.wechat" placeholder="仅作为紧急联系" @input="onInput('wechat', $event)" /><text class="sheet-row-arrow">›</text>
					</view>
					</view>
					<view class="sheet-bottom-spacer"></view>
				</scroll-view>
				<view class="sheet-footer">
					<view class="cancel-button" @tap="cancelDetailEdit"><text>取消</text></view>
					<view class="save-button" :class="{ disabled: saving || uploadingMedia }" @tap="handleSave"><text>{{ saving ? '保存中...' : '保存' }}</text></view>
				</view>
			</view>
		</view>

		<view class="sheet-overlay" v-if="qaSheetVisible" @tap="closeQaEditor">
			<view class="sheet-panel" @tap.stop>
				<view class="sheet-handle"></view>
				<view class="sheet-nav">
					<text class="sheet-title">编辑回答</text>
					<text class="sheet-close" @tap="closeQaEditor">✕</text>
				</view>
				<view class="qa-sheet-body">
					<text class="qa-sheet-question">{{ qaEditingQuestion }}</text>
					<textarea class="qa-sheet-textarea" :value="qaDraft" maxlength="300" placeholder="真诚的表达最能打动人..." @input="onQaDraftInput"></textarea>
					<text class="qa-sheet-count">{{ qaDraft.length }}/300</text>
				</view>
				<view class="sheet-footer">
					<view class="cancel-button" @tap="closeQaEditor"><text>取消</text></view>
					<view class="save-button" :class="{ disabled: qaSaving }" @tap="saveQaAnswer"><text>{{ qaSaving ? '保存中...' : '保存' }}</text></view>
				</view>
			</view>
		</view>

		<view v-if="cropVisible" class="crop-overlay">
			<view class="crop-panel" @tap.stop>
				<text class="crop-title">{{ cropKind == 'avatar' ? '预览并裁剪头像' : '预览并裁剪背景' }}</text>
				<view class="crop-stage" :class="{ 'crop-stage-background': cropKind == 'background' }" @touchstart="startCropDrag" @touchmove.stop.prevent="moveCropDrag" @touchend="endCropDrag">
					<image class="crop-preview-image" :style="{ transform: 'translate(' + cropOffsetX + 'px, ' + cropOffsetY + 'px)' }" :src="cropPath" mode="aspectFill"></image>
					<view class="crop-frame" :class="{ 'crop-frame-background': cropKind == 'background' }"></view>
				</view>
				<text class="crop-hint">已按{{ cropKind == 'avatar' ? '正方形头像' : '横向背景' }}比例预览，确认后裁剪上传</text>
				<view class="crop-actions">
					<view class="crop-cancel" @tap="cancelCrop"><text>取消</text></view>
					<button class="crop-confirm" :disabled="uploadingMedia || cropConfirming" @tap="onCropConfirmTap" @click="onCropConfirmTap">{{ uploadingMedia || cropConfirming ? '处理中...' : '裁剪并上传' }}</button>
				</view>
			</view>
			<canvas canvas-id="profileCropCanvas" class="crop-canvas" width="800" height="800"></canvas>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { getOwnProfile, updateOwnProfile, updateOwnNickname, getOwnPreferences, uploadUserProfileMedia, deleteUserProfilePhoto, getMeProfile, getProfileCompletion, getAgreementVersions, acceptAgreement } from '@/api'
	import { resolveMediaUrl } from '@/api/config.uts'
	import locationJson from '@/data/location.json'

	const loading = ref(true)
	const refreshing = ref(false)
	const loadError = ref('')
	const profileLoaded = ref(false)
	const saving = ref(false)
	const uploadingMedia = ref(false)
	const cropConfirming = ref(false)
	const cropVisible = ref(false)
	const cropPath = ref('')
	const cropKind = ref('avatar')
	const cropOffsetX = ref(0)
	const cropOffsetY = ref(0)
	const cropDragStartX = ref(0)
	const cropDragStartY = ref(0)
	const cropDragOriginX = ref(0)
	const cropDragOriginY = ref(0)
	const cropDragging = ref(false)
	const detailSheetVisible = ref(false)
	const editSheetMode = ref('basic')
	const singlePledgeVisible = ref(false)
	const singlePledgeSubmitting = ref(false)
	const singlePledgePassed = ref(false)
	const realNameStatus = ref('missing')
	const educationStatus = ref('missing')
	const genderOptions = ['未选择', '男', '女']
	const numericOptions = (start: number, end: number): string[] => {
		const options = [] as string[]
		for (let value = start; value <= end; value++) options.push('' + value)
		return options
	}
	const heightOptions = numericOptions(140, 220)
	const weightOptions = numericOptions(40, 120)
	const educationOptions = ['未选择', '高中及以下', '大专', '本科', '硕士', '博士']
	const maritalOptions = ['未选择', '未婚', '离异', '丧偶']
	const incomeOptions = ['请选择', '小于10w', '10-20w', '30-50w', '50-100w', '100w以上', '保密']
	const mbtiOptions = ['未选择', 'INTJ', 'INTP', 'ENTJ', 'ENTP', 'INFJ', 'INFP', 'ENFJ', 'ENFP', 'ISTJ', 'ISFJ', 'ESTJ', 'ESFJ', 'ISTP', 'ISFP', 'ESTP', 'ESFP']
	const companyDirectory = ['腾讯', '阿里巴巴', '字节跳动', '华为', '京东', '美团', '小米', '网易', '比亚迪', '中国平安', '招商银行', '中国移动']
	const companySuggestions = ref([] as string[])
	const formData = ref({
		userId: 0,
		nickname: '',
		gender: null as any,
		birthday: '',
		height: '' as any,
		weight: '' as any,
		educationLevel: null as any,
		residenceCityCode: '',
		residenceApiCityCode: '',
		residenceProvinceCode: '',
		residenceDistrictCode: '',
		hometown: '',
		hometownProvinceCode: '',
		hometownCityCode: '',
		hometownDistrictCode: '',
		occupation: '',
		industry: '',
		company: '',
		income: '',
		isMarried: null as any,
		mbti: '',
		introduction: '',
		wechat: '',
		interestTags: [] as string[],
		personalityTags: [] as string[],
		tagSelections: {} as any,
		avatar: '',
		coverBg: '',
		photos: [] as any[],
		ageMin: '' as any,
		ageMax: '' as any,
		heightMin: '' as any,
		heightMax: '' as any,
		educationMin: '' as any,
		acceptLongDistance: true,
		acceptCrossProvince: true,
		extraRequirement: ''
	})
	const completionScore = ref(0)
	const completionItems = ref({} as any)
	const usingLocalDraft = ref(false)

	const textValue = (value: any): string => value == null ? '' : '' + value
	const optionalNumber = (value: any): any => {
		if (value == null || ('' + value).trim() == '') return null
		const parsed = Number(value)
		return isNaN(parsed) ? null : parsed
	}
	const profileMedia = (raw: any): any[] => {
		const list = raw != null && Array.isArray(raw) ? raw as any[] : []
		return list.filter((item: any) => item != null).map((item: any) => {
			if (typeof item == 'string') return { id: 0, url: resolveMediaUrl(item), sortOrder: 0 }
			return { id: item.id, url: resolveMediaUrl(item.file_url != null ? item.file_url : item.url), sortOrder: item.sort_order }
		})
	}
	const incomeValue = (value: any): any => {
		const text = textValue(value)
		if (text == '') return null
		if (text == '小于10w') return 50000
		if (text == '10-20w') return 150000
		if (text == '30-50w') return 400000
		if (text == '50-100w') return 750000
		if (text == '100w以上') return 1000000
		if (text == '保密') return null
		const numeric = Number(value)
		return isNaN(numeric) ? null : numeric
	}
	const incomeDisplay = (value: any): string => {
		const numeric = Number(value)
		if (isNaN(numeric) || numeric <= 0) return ''
		// 初始登录问卷把收入文本换算成数字存储，这里反向映射回登录时的枚举文案，保证口径一致
		if (numeric == 50000) return '小于10w'
		if (numeric == 150000) return '10-20w'
		if (numeric == 400000) return '30-50w'
		if (numeric == 750000) return '50-100w'
		if (numeric >= 1000000) return '100w以上'
		const wan = numeric / 10000
		return (wan % 1 == 0 ? '' + wan : wan.toFixed(1)) + 'w'
	}
	const locationCodesByNames = (values: string[]): any => {
		const raw = Array.isArray(locationJson) ? locationJson as any[] : []
		for (const province of raw) {
			if (province.name != values[0]) continue
			const cities = Array.isArray(province.city) ? province.city as any[] : []
			for (const city of cities) {
				if (city.name != values[1]) continue
				const areas = Array.isArray(city.area) ? city.area as any[] : []
				for (const area of areas) {
					if (area.name == values[2]) return { province: '' + province.code, city: '' + city.code, district: '' + area.code }
				}
			}
		}
		return { province: '', city: '', district: '' }
	}
	const locationTextByCodes = (provinceCode: any, cityCode: any, districtCode: any): string => {
		const p = textValue(provinceCode)
		const c = textValue(cityCode)
		const d = textValue(districtCode)
		const raw = Array.isArray(locationJson) ? locationJson as any[] : []
		for (const province of raw) {
			if ('' + province.code != p) continue
			const cities = Array.isArray(province.city) ? province.city as any[] : []
			for (const city of cities) {
				if ('' + city.code != c) continue
				const areas = Array.isArray(city.area) ? city.area as any[] : []
				for (const area of areas) if ('' + area.code == d) return province.name + ' ' + city.name + ' ' + area.name
			}
		}
		return ''
	}

	const applyProfile = (raw: any) => {
		const data = raw != null ? raw : {}
		formData.value.userId = data.user_id != null ? Number(data.user_id) : 0
		formData.value.nickname = textValue(data.nickname)
		formData.value.gender = data.gender
		formData.value.birthday = textValue(data.birthday)
		formData.value.height = data.height != null ? data.height : ''
		formData.value.weight = data.weight != null ? data.weight : ''
		formData.value.educationLevel = data.education_level
		formData.value.residenceProvinceCode = textValue(data.residence_province_code)
		formData.value.residenceApiCityCode = textValue(data.residence_city_code)
		formData.value.residenceDistrictCode = textValue(data.residence_district_code)
		formData.value.residenceCityCode = locationTextByCodes(data.residence_province_code, data.residence_city_code, data.residence_district_code) || formData.value.residenceApiCityCode
		formData.value.hometownProvinceCode = textValue(data.hometown_province_code)
		formData.value.hometownCityCode = textValue(data.hometown_city_code)
		formData.value.hometownDistrictCode = textValue(data.hometown_district_code)
		formData.value.hometown = locationTextByCodes(data.hometown_province_code, data.hometown_city_code, data.hometown_district_code) || textValue(data.hometown)
		formData.value.occupation = textValue(data.occupation)
		formData.value.industry = textValue(data.industry)
		formData.value.company = textValue(data.company)
		formData.value.income = incomeDisplay(data.income) || textValue(data.income_range)
		formData.value.isMarried = data.is_married
		formData.value.mbti = textValue(data.mbti)
		formData.value.introduction = textValue(data.self_intro)
		applyQaAnswers(data.qa_answers)
		formData.value.wechat = textValue(data.wechat)
		formData.value.interestTags = data.interest_tags != null ? data.interest_tags : []
		formData.value.personalityTags = data.personality_tags != null ? data.personality_tags : []
		formData.value.tagSelections = data.tag_selections != null ? data.tag_selections : {}
		formData.value.avatar = resolveMediaUrl(data.avatar)
		formData.value.coverBg = resolveMediaUrl(data.background_wall)
		formData.value.photos = profileMedia(data.photos)
		completionScore.value = data.completion_score != null ? Math.round(Number(data.completion_score)) : 0
	}

	const applyPreferences = (raw: any) => {
		const data = raw != null ? raw : {}
		formData.value.ageMin = data.age_min != null ? data.age_min : ''
		formData.value.ageMax = data.age_max != null ? data.age_max : ''
		formData.value.heightMin = data.height_min != null ? data.height_min : ''
		formData.value.heightMax = data.height_max != null ? data.height_max : ''
		formData.value.educationMin = data.education_min != null ? data.education_min : ''
		formData.value.acceptLongDistance = data.accept_long_distance == true
		formData.value.acceptCrossProvince = data.accept_cross_province == true
		formData.value.extraRequirement = textValue(data.extra_requirement)
	}

	const profilePayload = (raw: any): any => {
		if (raw != null && typeof raw == 'object' && raw.profile != null && typeof raw.profile == 'object') return raw.profile
		if (raw != null && typeof raw == 'object' && raw.data != null && typeof raw.data == 'object' && raw.data.profile != null) return raw.data.profile
		return raw
	}

	const refreshCompletion = async () => {
		try {
			const completion = await getProfileCompletion()
			if (!completion.success || completion.data == null) return
			const data = completion.data as any
			const returnedScore = data.score != null ? data.score : data.completion_score
			if (returnedScore != null) completionScore.value = Math.round(Number(returnedScore))
			const items = Array.isArray(data.items) ? data.items as any[] : []
			const nextItems = {} as any
			for (const item of items) {
				if (item.key == null) continue
				nextItems['' + item.key] = { completed: item.completed == true, weight: Number(item.weight) }
				if (item.key == 'single_pledge') singlePledgePassed.value = item.completed == true
			}
			completionItems.value = nextItems
		} catch (e) {
			console.error('[EditProfile] completion refresh failed', e)
		}
	}

	const load = async () => {
		loading.value = true
		loadError.value = ''
		profileLoaded.value = false
		try {
			const profileRes = await getOwnProfile()
			if (!profileRes.success || profileRes.data == null) {
				loadError.value = profileRes.message != null ? '' + profileRes.message : '个人资料接口暂不可用'
				return
			}
			profileLoaded.value = true
			try {
				applyProfile(profilePayload(profileRes.data))
			} catch (profileError) {
				console.error('[EditProfile] profile response mapping failed', profileError)
			}
			try {
				const preferenceRes = await getOwnPreferences()
				if (preferenceRes.success && preferenceRes.data != null) applyPreferences(preferenceRes.data)
			} catch (preferenceError) {
				console.error('[EditProfile] preferences unavailable', preferenceError)
			}
			try {
				const meRes = await getMeProfile()
				if (meRes.success && meRes.data != null) {
					realNameStatus.value = meRes.data.realNameStatus != null ? '' + meRes.data.realNameStatus : 'missing'
					educationStatus.value = meRes.data.educationStatus != null ? '' + meRes.data.educationStatus : 'missing'
				}
			} catch (meError) {
				console.error('[EditProfile] auth profile unavailable', meError)
			}
			await refreshCompletion()
		} catch (e) {
			loadError.value = '网络不可用，请重试'
		} finally {
			loading.value = false
		}
	}

	const hasPreferenceValues = (): boolean => formData.value.ageMin != '' || formData.value.ageMax != '' || formData.value.heightMin != '' || formData.value.heightMax != '' || formData.value.educationMin != '' || formData.value.acceptLongDistance || formData.value.acceptCrossProvince || textValue(formData.value.extraRequirement).trim() != ''
	const completeness = computed(() => completionScore.value)
	const fallbackCompletion = (key: string): boolean => {
		if (key == 'avatar') return formData.value.avatar != ''
		if (key == 'album') return formData.value.photos.length > 0
		if (key == 'intro') return textValue(formData.value.introduction).trim() != ''
		if (key == 'weight') return formData.value.weight != ''
		if (key == 'hometown') return textValue(formData.value.hometown).trim() != ''
		if (key == 'interest') return formData.value.interestTags.length >= 3
		if (key == 'personality') return formData.value.personalityTags.length >= 3
		if (key == 'preference') return formData.value.ageMin != '' || formData.value.ageMax != ''
		return false
	}
	const completionPassed = (key: string): boolean => {
		if (key == 'interest') return interestDisplayTags.value.length >= 3
		if (key == 'personality') return personalityDisplayTags.value.length >= 3
		const item = completionItems.value[key]
		return item != null ? item.completed == true : fallbackCompletion(key)
	}
	const completionWeight = (key: string, fallback: number): number => {
		const weights: any = {
			gender: 7, birthday: 7, location: 5, marriage: 5, occupation: 4, education: 4, income: 4,
			height: 4, weight: 4, hometown: 4, avatar: 15, intro: 10, album: 8, interest: 5,
			personality: 3, mbti: 2, preference: 3, realname: 5, single_pledge: 1
		}
		return weights[key] != null ? weights[key] : fallback
	}
	const completionSuffix = (key: string, fallback: number, prefix: string = ' ·'): string => completionPassed(key) ? '' : prefix + ' +' + completionWeight(key, fallback) + '%'
	const completionText = (key: string, value: any, emptyText: string, fallback: number): string => {
		const text = textValue(value).trim()
		return completionPassed(key) && text != '' ? text : emptyText + completionSuffix(key, fallback)
	}
	const missingCompletionSummary = computed(() => {
		const keys = Object.keys(completionItems.value)
		if (keys.length == 0) return ''
		const missing = keys.filter((key: string) => completionItems.value[key].completed != true)
		if (missing.length == 0) return ''
		const labels: any = {
			gender: '性别', birthday: '出生日期', location: '所在地区', marriage: '婚姻状况', occupation: '职业',
			education: '学历', income: '收入', height: '身高', weight: '体重', hometown: '家乡', avatar: '头像',
			intro: '自我介绍', album: '相册', interest: '兴趣标签', personality: '性格标签', mbti: 'MBTI',
			preference: '择偶要求', realname: '实名认证', single_pledge: '单身承诺'
		}
		const names = missing.map((key: string) => labels[key] || key)
		return names.length > 4 ? names.slice(0, 4).join('、') + '等' + names.length + '项' : names.join('、')
	})
	const isIdentityLocked = computed(() => realNameStatus.value == 'passed')
	const heightPickerIndex = computed(() => {
		const value = Number(formData.value.height)
		return value >= 140 && value <= 220 ? value - 140 : 0
	})
	const weightPickerIndex = computed(() => {
		const value = Number(formData.value.weight)
		return value >= 40 && value <= 120 ? value - 40 : 0
	})
	const genderText = computed(() => formData.value.gender == 1 ? '男' : formData.value.gender == 2 ? '女' : '未选择')
	const educationText = computed(() => formData.value.educationLevel != null ? educationOptions[Number(formData.value.educationLevel)] || '未选择' : '未选择')
	const maritalText = computed(() => formData.value.isMarried != null ? maritalOptions[Number(formData.value.isMarried)] || '未选择' : '未选择')
	const incomeText = computed(() => formData.value.income != '' ? textValue(formData.value.income) : '请选择')
	const incomePickerIndex = computed(() => {
		const index = incomeOptions.indexOf(textValue(formData.value.income))
		return index >= 0 ? index : 0
	})
	const mbtiPickerIndex = computed(() => {
		const index = mbtiOptions.indexOf(textValue(formData.value.mbti))
		return index >= 0 ? index : 0
	})
	const agePreview = computed(() => {
		const birthday = textValue(formData.value.birthday)
		if (birthday.length < 4) return '未填写'
		const year = Number(birthday.substring(0, 4))
		const month = birthday.length >= 7 ? Number(birthday.substring(5, 7)) : 1
		const day = birthday.length >= 10 ? Number(birthday.substring(8, 10)) : 1
		const now = new Date()
		let age = now.getFullYear() - year
		if (now.getMonth() + 1 < month || (now.getMonth() + 1 == month && now.getDate() < day)) age--
		return age >= 0 ? '' + age + '岁' : '未填写'
	})
	const occupationPreview = computed(() => {
		const parts = [formData.value.occupation, formData.value.industry].filter((v: any) => v != null && ('' + v).trim() != '')
		return parts.length > 0 ? parts.join(' · ') : '未填写'
	})
	// 星座由生日自动推算，不独立手选，保证与生日永远一致
	const constellationText = computed(() => {
		const birthday = textValue(formData.value.birthday)
		if (birthday.length < 10) return ''
		const month = Number(birthday.substring(5, 7))
		const day = Number(birthday.substring(8, 10))
		if (isNaN(month) || isNaN(day) || month < 1 || month > 12 || day < 1 || day > 31) return ''
		const signs: string[] = ['摩羯', '水瓶', '双鱼', '白羊', '金牛', '双子', '巨蟹', '狮子', '处女', '天秤', '天蝎', '射手']
		const boundaries: number[] = [20, 19, 21, 20, 21, 22, 23, 23, 23, 24, 23, 22]
		const idx = day >= boundaries[month - 1] ? month % 12 : month - 1
		return signs[idx] + '座'
	})
	const incomePreview = computed(() => formData.value.income != null && ('' + formData.value.income).trim() != '' ? ('' + formData.value.income) : '未填写')
	const incomePreviewText = computed(() => formData.value.income != null && ('' + formData.value.income).trim() != '' ? ('' + formData.value.income) : '请选择')
	const introHasContent = computed(() => textValue(formData.value.introduction).trim() != '')
	const completedCertCount = computed(() => certifications.value.filter((c: any) => c.passed).length)
	const interestDisplayTags = computed(() => {
		return formData.value.interestTags.slice(0, 5)
	})
	const personalityDisplayTags = computed(() => {
		return formData.value.personalityTags.slice(0, 5)
	})
	const preferencePreview = computed(() => {
		const age = formData.value.ageMin != '' || formData.value.ageMax != '' ? (formData.value.ageMin || '不限') + '-' + (formData.value.ageMax || '不限') + '岁' : '年龄不限'
		const height = formData.value.heightMin != '' || formData.value.heightMax != '' ? (formData.value.heightMin || '不限') + '-' + (formData.value.heightMax || '不限') + 'cm' : '身高不限'
		const education = formData.value.educationMin != '' ? educationOptions[Number(formData.value.educationMin)] || '学历不限' : '学历不限'
		return age + ' · ' + height + ' · ' + education
	})
	const preferenceHasContent = computed(() => hasPreferenceValues())
	const realNameDescription = computed(() => {
		if (realNameStatus.value == 'passed') return '已通过平台实名认证'
		if (realNameStatus.value == 'reviewing') return '认证资料正在审核或人工复核'
		if (realNameStatus.value == 'rejected') return '实名认证未通过，请重新认证'
		if (realNameStatus.value == 'revoked') return '实名认证已撤销，请重新认证'
		return '需通过平台实名认证'
	})
	const certifications = computed(() => [
		{ key: 'realname', label: '实名认证', icon: '盾', passed: realNameStatus.value == 'passed', desc: realNameDescription.value },
		{ key: 'education', label: '学历认证', icon: '学', passed: educationStatus.value == 'passed', desc: educationStatus.value == 'passed' ? '学历信息已核验' : '需核验学历信息' },
		{ key: 'avatar', label: '头像认证', icon: '像', passed: false, desc: '上传真实本人照片' },
		{ key: 'single_pledge', label: '单身承诺', icon: '誓', passed: singlePledgePassed.value, desc: singlePledgePassed.value ? '已签署单身承诺' : '确认当前为单身状态' }
	])

	onMounted(() => load())
	onShow(() => {
		if (!loading.value) {
			load()
		}
	})

	const onInput = (field: string, event: any) => {
		(formData.value as any)[field] = event.detail.value
	}
	const onSwitchChange = (field: string, event: any) => {
		(formData.value as any)[field] = event.detail.value == true
	}
	const onGenderChange = (event: any) => { if (!isIdentityLocked.value) formData.value.gender = Number(event.detail.value) == 1 ? 1 : Number(event.detail.value) == 2 ? 2 : null }
	const onEducationChange = (event: any) => formData.value.educationLevel = Number(event.detail.value) > 0 ? Number(event.detail.value) : null
	const onMaritalChange = (event: any) => formData.value.isMarried = Number(event.detail.value) > 0 ? Number(event.detail.value) : null
	const onBirthdayChange = (event: any) => { if (!isIdentityLocked.value) formData.value.birthday = event.detail.value }
	const onHeightChange = (event: any) => formData.value.height = Number(heightOptions[Number(event.detail.value)])
	const onWeightChange = (event: any) => formData.value.weight = Number(weightOptions[Number(event.detail.value)])
	const regionText = (event: any): string => {
		const values = event.detail.value as string[]
		return values.join(' ')
	}
	const onResidenceChange = (event: any) => {
		const values = event.detail.value as string[]
		const codes = locationCodesByNames(values)
		formData.value.residenceProvinceCode = codes.province
		formData.value.residenceApiCityCode = codes.city
		formData.value.residenceCityCode = regionText(event)
		formData.value.residenceDistrictCode = codes.district
	}
	const onPullRefresh = async () => {
		if (refreshing.value || loading.value) return
		refreshing.value = true
		try {
			await load()
		} finally {
			refreshing.value = false
		}
	}
	const onHometownChange = (event: any) => {
		const values = event.detail.value as string[]
		const codes = locationCodesByNames(values)
		formData.value.hometownProvinceCode = codes.province
		formData.value.hometownCityCode = codes.city
		formData.value.hometownDistrictCode = codes.district
		formData.value.hometown = regionText(event)
	}
	const onIncomeChange = (event: any) => {
		const index = Number(event.detail.value)
		formData.value.income = index > 0 ? incomeOptions[index] : ''
	}
	const onMbtiChange = (event: any) => {
		const index = Number(event.detail.value)
		formData.value.mbti = index > 0 ? mbtiOptions[index] : ''
	}
	const onCompanyInput = (event: any) => {
		formData.value.company = event.detail.value
		const keyword = textValue(event.detail.value).trim().toLowerCase()
		companySuggestions.value = keyword == '' ? [] : companyDirectory.filter((company: string) => company.toLowerCase().indexOf(keyword) >= 0).slice(0, 6)
	}
	const chooseCompany = (company: string) => {
		formData.value.company = company
		companySuggestions.value = []
	}
	const prepareUploadPath = (path: string): Promise<string> => new Promise((resolve) => {
		uni.compressImage({
			src: path,
			quality: 80,
			success: (res: any) => resolve(res != null && res.tempFilePath != null ? '' + res.tempFilePath : path),
			fail: () => resolve(path)
		})
	})

	const uploadMedia = async (path: string, kind: string) => {
		if (path == '') return null
		uploadingMedia.value = true
		try {
			const res = await uploadUserProfileMedia(path, kind)
			if (!res.success || res.data == null) {
				uni.showToast({ title: res.message != null ? '' + res.message : '上传失败，请重试', icon: 'none' })
				return null
			}
			await refreshCompletion()
			return res.data
		} catch (e) {
			uni.showToast({ title: '上传失败，请检查网络', icon: 'none' })
			return null
		} finally {
			uploadingMedia.value = false
		}
	}

	const selectCropImage = (kind: string) => {
		uni.chooseImage({ count: 1, sizeType: ['compressed'], sourceType: ['album', 'camera'], success: async (res: any) => {
			const path = res != null && res.tempFilePaths != null && res.tempFilePaths.length > 0 ? '' + res.tempFilePaths[0] : ''
			if (path == '') return
			const uploadPath = await prepareUploadPath(path)
			const media = await uploadMedia(uploadPath, kind)
			applyUploadedMedia(media, kind, uploadPath)
		} })
	}
	const chooseAvatar = () => selectCropImage('avatar')
	const changeBackground = () => selectCropImage('background')
	const cancelCrop = () => {
		if (uploadingMedia.value || cropConfirming.value) return
		cropVisible.value = false
		cropPath.value = ''
		cropOffsetX.value = 0
		cropOffsetY.value = 0
	}
	const onCropConfirmTap = () => {
		if (uploadingMedia.value || cropConfirming.value || cropPath.value == '') return
		cropConfirming.value = true
		confirmCrop()
	}
	const cropTouchPoint = (event: any): any => {
		if (event == null || event.touches == null || event.touches.length == 0) return null
		const touch = event.touches[0]
		return { x: Number(touch.clientX != null ? touch.clientX : touch.pageX), y: Number(touch.clientY != null ? touch.clientY : touch.pageY) }
	}
	const cropOffsetLimit = (): any => {
		const stageWidth = Math.max(240, uni.getSystemInfoSync().windowWidth - 80)
		const stageHeight = cropKind.value == 'avatar' ? 280 : 210
		const frameWidth = cropKind.value == 'avatar' ? 220 : stageWidth - 24
		const frameHeight = cropKind.value == 'avatar' ? 220 : 164
		return { x: Math.max(0, (stageWidth - frameWidth) / 2), y: Math.max(0, (stageHeight - frameHeight) / 2) }
	}
	const startCropDrag = (event: any) => {
		if (uploadingMedia.value) return
		const point = cropTouchPoint(event)
		if (point == null) return
		cropDragStartX.value = point.x
		cropDragStartY.value = point.y
		cropDragOriginX.value = cropOffsetX.value
		cropDragOriginY.value = cropOffsetY.value
		cropDragging.value = true
	}
	const moveCropDrag = (event: any) => {
		if (!cropDragging.value) return
		const point = cropTouchPoint(event)
		if (point == null) return
		const limit = cropOffsetLimit()
		cropOffsetX.value = Math.max(-limit.x, Math.min(limit.x, cropDragOriginX.value + point.x - cropDragStartX.value))
		cropOffsetY.value = Math.max(-limit.y, Math.min(limit.y, cropDragOriginY.value + point.y - cropDragStartY.value))
	}
	const endCropDrag = () => { cropDragging.value = false }
	const applyUploadedMedia = (media: any, kind: string, fallbackPath: string) => {
		if (media == null) return
		if (kind == 'avatar') formData.value.avatar = media.file_url != null ? resolveMediaUrl(media.file_url) : fallbackPath
		else formData.value.coverBg = media.file_url != null ? resolveMediaUrl(media.file_url) : fallbackPath
		cancelCrop()
	}
	const confirmCrop = () => {
		if (uploadingMedia.value || cropPath.value == '') {
			cropConfirming.value = false
			return
		}
		const sourcePath = cropPath.value
		const kind = cropKind.value
		uni.getImageInfo({
			src: sourcePath,
			success: (info: any) => {
				const sourceWidth = Number(info.width)
				const sourceHeight = Number(info.height)
				const ratio = kind == 'avatar' ? 1 : 16 / 9
				let cropWidth = sourceWidth
				let cropHeight = cropWidth / ratio
				if (cropHeight > sourceHeight) {
					cropHeight = sourceHeight
					cropWidth = cropHeight * ratio
				}
				const stageWidth = Math.max(240, uni.getSystemInfoSync().windowWidth - 80)
				const stageHeight = kind == 'avatar' ? 280 : 210
				const renderScale = Math.max(stageWidth / sourceWidth, stageHeight / sourceHeight)
				const cropX = Math.max(0, Math.min(sourceWidth - cropWidth, (sourceWidth - cropWidth) / 2 - cropOffsetX.value / renderScale))
				const cropY = Math.max(0, Math.min(sourceHeight - cropHeight, (sourceHeight - cropHeight) / 2 - cropOffsetY.value / renderScale))
				const outputWidth = kind == 'avatar' ? 600 : 800
				const outputHeight = Math.round(outputWidth / ratio)
				const context = uni.createCanvasContext('profileCropCanvas')
				context.clearRect(0, 0, outputWidth, outputHeight)
				context.drawImage(sourcePath, cropX, cropY, cropWidth, cropHeight, 0, 0, outputWidth, outputHeight)
				let exportStarted = false
				const exportCanvas = () => {
					if (exportStarted) return
					exportStarted = true
					uni.canvasToTempFilePath({ canvasId: 'profileCropCanvas', x: 0, y: 0, width: outputWidth, height: outputHeight, destWidth: outputWidth, destHeight: outputHeight, fileType: 'jpg', quality: 0.9, success: async (file: any) => {
						const media = await uploadMedia('' + file.tempFilePath, kind)
						cropConfirming.value = false
						applyUploadedMedia(media, kind, '' + file.tempFilePath)
					}, fail: (error: any) => {
						cropConfirming.value = false
						console.error('[EditProfile] crop export failed', error)
						uni.showToast({ title: '裁剪组件不可用，正在上传原图', icon: 'none' })
						setTimeout(async () => {
							const media = await uploadMedia(sourcePath, kind)
							applyUploadedMedia(media, kind, sourcePath)
						}, 250)
					} })
				}
				context.draw(false, exportCanvas)
				setTimeout(() => {
					if (!exportStarted) {
						exportCanvas()
					}
					if (!exportStarted) {
						cropConfirming.value = false
						uni.showToast({ title: '裁剪处理超时，请重试', icon: 'none' })
					}
				}, 8000)
			}, fail: () => {
				cropConfirming.value = false
				uni.showToast({ title: '图片裁剪不可用，正在上传原图', icon: 'none' })
				setTimeout(async () => {
					const media = await uploadMedia(sourcePath, kind)
					applyUploadedMedia(media, kind, sourcePath)
				}, 250)
			}
		})
	}

	const addPhoto = () => {
		const count = 9 - formData.value.photos.length
		if (count <= 0) return
		uni.chooseImage({ count, sizeType: ['compressed'], sourceType: ['album', 'camera'], success: async (res: any) => {
			const paths = res != null && res.tempFilePaths != null ? res.tempFilePaths as string[] : []
			for (let i = 0; i < paths.length; i++) {
				const uploadPath = await prepareUploadPath('' + paths[i])
				const media = await uploadMedia(uploadPath, 'photo')
				if (media != null) formData.value.photos.push({ id: media.id, url: media.file_url != null ? resolveMediaUrl(media.file_url) : '' + uploadPath })
			}
		} })
	}

	const deletePhoto = async (index: number) => {
		const list = formData.value.photos as any[]
		if (index < 0 || index >= list.length) return
		const item = list[index]
		if (item.id == null || Number(item.id) <= 0) return
		const res = await deleteUserProfilePhoto(Number(item.id))
		if (res.success) {
			list.splice(index, 1)
			await refreshCompletion()
		}
		else uni.showToast({ title: res.message != null ? '' + res.message : '删除失败，请重试', icon: 'none' })
	}

	const goCertification = (key: string) => {
		if (key == 'single_pledge') {
			singlePledgeVisible.value = true
			return
		}
		uni.navigateTo({ url: '/pagesSub/profileExtra/certification?type=' + key })
	}
	const closeSinglePledge = () => { if (!singlePledgeSubmitting.value) singlePledgeVisible.value = false }
	const confirmSinglePledge = async () => {
		if (singlePledgeSubmitting.value) return
		singlePledgeSubmitting.value = true
		try {
			const versionsRes = await getAgreementVersions()
			const versions = versionsRes.success && versionsRes.data != null ? versionsRes.data as any : {}
			const safetyPledge = versions.safety_pledge != null ? versions.safety_pledge : {}
			const version = safetyPledge.version != null ? '' + safetyPledge.version : 'v1'
			const res = await acceptAgreement('safety_pledge', version, 'profile')
			if (!res.success) {
				uni.showToast({ title: res.message != null ? '' + res.message : '提交失败，请重试', icon: 'none' })
				return
			}
			singlePledgePassed.value = true
			singlePledgeVisible.value = false
			await refreshCompletion()
			uni.showToast({ title: '单身承诺已完成', icon: 'success' })
		} finally {
			singlePledgeSubmitting.value = false
		}
	}
	const saveIntroduction = async () => {
		if (saving.value || uploadingMedia.value) return
		saving.value = true
		try {
			const res = await updateOwnProfile({ self_intro: textValue(formData.value.introduction) || null })
			if (!res.success) {
				uni.showToast({ title: res.message != null ? '' + res.message : '自我介绍保存失败', icon: 'none' })
				return
			}
			await refreshCompletion()
			uni.showToast({ title: '自我介绍已保存', icon: 'success' })
		} finally {
			saving.value = false
		}
	}
	/* ==================== 关于我·问答编辑 ==================== */
	// 云端字段：qa_answers=[{question_id, question, answer}]，随 PATCH /users/me/profile 提交；
	// 本地兜底：同步写 storage，云端尚未支持该字段或请求失败时，回答也不会丢。
	const QA_STORAGE_KEY = 'xsa_own_qa_answers_v1'
	const qaItems = ref([
		{ id: 1, question: '你理想中的另一半是什么样的', answer: '' },
		{ id: 2, question: '喜欢什么运动', answer: '' },
		{ id: 3, question: '你期待的爱情是什么样子的', answer: '' }
	])
	const qaSheetVisible = ref(false)
	const qaEditingIndex = ref(-1)
	const qaEditingQuestion = ref('')
	const qaDraft = ref('')
	const qaSaving = ref(false)
	const buildQaPayload = (editIndex: number, nextAnswer: string): any[] => {
		const payload: any[] = []
		for (let i = 0; i < qaItems.value.length; i++) {
			const qa = qaItems.value[i]
			payload.push({ question_id: qa.id, question: qa.question, answer: i == editIndex ? nextAnswer : textValue(qa.answer) })
		}
		return payload
	}
	const fillQaFromList = (list: any[]) => {
		for (let i = 0; i < qaItems.value.length; i++) {
			const item = qaItems.value[i]
			for (let j = 0; j < list.length; j++) {
				const row = list[j]
				if (row == null) continue
				const qid = row.question_id != null ? Number(row.question_id) : (row.id != null ? Number(row.id) : 0)
				if (qid == item.id && row.answer != null && textValue(row.answer) != '') item.answer = textValue(row.answer)
			}
		}
	}
	const applyQaAnswers = (raw: any) => {
		if (raw != null && Array.isArray(raw)) {
			fillQaFromList(raw as any[])
			return
		}
		try {
			const cached = uni.getStorageSync(QA_STORAGE_KEY) as any
			if (cached != null && Array.isArray(cached)) fillQaFromList(cached as any[])
		} catch (e: any) { }
	}
	const openQaEditor = (index: number) => {
		const item = qaItems.value[index]
		if (item == null) return
		qaEditingIndex.value = index
		qaEditingQuestion.value = item.question
		qaDraft.value = textValue(item.answer)
		qaSheetVisible.value = true
	}
	const closeQaEditor = () => { qaSheetVisible.value = false }
	const onQaDraftInput = (event: any) => { qaDraft.value = event != null && event.detail != null ? '' + event.detail.value : '' }
	const saveQaAnswer = async () => {
		if (qaSaving.value) return
		const index = qaEditingIndex.value
		if (index < 0 || index >= qaItems.value.length) return
		qaSaving.value = true
		const nextAnswer = textValue(qaDraft.value).trim()
		const payload = buildQaPayload(index, nextAnswer)
		try {
			const res = await updateOwnProfile({ qa_answers: payload })
			if (!res.success) throw new Error(res.message != null ? '' + res.message : 'save failed')
			uni.setStorageSync(QA_STORAGE_KEY, payload)
			qaItems.value[index].answer = nextAnswer
			qaSheetVisible.value = false
			uni.showToast({ title: '回答已保存', icon: 'success' })
		} catch (e: any) {
			// 云端失败时兜底存本地，返回资料页仍可回显
			uni.setStorageSync(QA_STORAGE_KEY, payload)
			qaItems.value[index].answer = nextAnswer
			qaSheetVisible.value = false
			uni.showToast({ title: '已本地保存，云端同步失败', icon: 'none' })
		} finally {
			qaSaving.value = false
		}
	}
	const goTagsEdit = (type: string = 'all') => uni.navigateTo({
		url: '/pagesSub/userExtra/mytags/edit?type=' + type,
		events: {
			tagsSaved: (payload: any) => {
				if (payload == null || !Array.isArray(payload.tags)) return
				const tags = (payload.tags as string[]).slice(0, 5)
				if (payload.type == 'personality') formData.value.personalityTags = tags
				else formData.value.interestTags = tags
				refreshCompletion()
			}
		}
	})
	const onPreview = () => uni.navigateTo({ url: '/pagesSub/userExtra/user/detail?own=true&preview=true' })

	const onCancel = () => {
		uni.navigateBack({ delta: 1 })
	}
	const openBasicEditor = () => {
		editSheetMode.value = 'basic'
		detailSheetVisible.value = true
	}
	const cancelDetailEdit = () => {
		if (!saving.value && !uploadingMedia.value) detailSheetVisible.value = false
	}

	const buildProfilePayload = () => {
		const payload: any = {
			gender: formData.value.gender,
			birthday: formData.value.birthday != '' ? formData.value.birthday : null,
			is_married: formData.value.isMarried,
			height: optionalNumber(formData.value.height),
			weight: optionalNumber(formData.value.weight),
			occupation: textValue(formData.value.occupation) || null,
			industry: textValue(formData.value.industry) || null,
			education_level: formData.value.educationLevel,
			income: incomeValue(formData.value.income),
			residence_province_code: textValue(formData.value.residenceProvinceCode) || null,
			residence_city_code: textValue(formData.value.residenceApiCityCode) || null,
			residence_district_code: textValue(formData.value.residenceDistrictCode) || null,
			hometown_province_code: textValue(formData.value.hometownProvinceCode) || null,
			hometown_city_code: textValue(formData.value.hometownCityCode) || null,
			hometown_district_code: textValue(formData.value.hometownDistrictCode) || null,
			self_intro: textValue(formData.value.introduction) || null,
			qa_answers: buildQaPayload(-1, ''),
			interest_tags: formData.value.interestTags.length >= 3 ? formData.value.interestTags.slice(0, 5) : null,
			personality_tags: formData.value.personalityTags.length >= 3 ? formData.value.personalityTags.slice(0, 5) : null,
			mbti: textValue(formData.value.mbti).toUpperCase() || null
		}
		const selections = formData.value.tagSelections
		if (selections != null && typeof selections === 'object') {
			const supportedSelections: any = {}
			const relationshipExpectation = selections.relationship_expectation
			if (Array.isArray(relationshipExpectation) && relationshipExpectation.length > 0) {
				supportedSelections.relationship_expectation = relationshipExpectation.slice(0, 5)
			}
			if (Object.keys(supportedSelections).length > 0) payload.tag_selections = supportedSelections
		}
		return payload
	}

	const saveNickname = async () => {
		if (saving.value || uploadingMedia.value) return
		const value = textValue(formData.value.nickname).trim()
		if (value == '') {
			uni.showToast({ title: '昵称不能为空', icon: 'none' })
			return
		}
		saving.value = true
		try {
			const res = await updateOwnNickname(value)
			if (!res.success) {
				uni.showToast({ title: res.message != null ? '' + res.message : '昵称保存失败', icon: 'none' })
				return
			}
			formData.value.nickname = value
			await refreshCompletion()
			uni.showToast({ title: '昵称已保存', icon: 'success' })
		} finally {
			saving.value = false
		}
	}

	const handleSave = async () => {
		if (saving.value || uploadingMedia.value) return
		const height = optionalNumber(formData.value.height)
		const weight = optionalNumber(formData.value.weight)
		if (height != null && (height < 140 || height > 220)) {
			uni.showToast({ title: '身高需在140至220厘米之间', icon: 'none' })
			return
		}
		if (weight != null && (weight < 40 || weight > 120)) {
			uni.showToast({ title: '体重需在40至120千克之间', icon: 'none' })
			return
		}
		saving.value = true
		try {
			const nicknameRes = await updateOwnNickname(textValue(formData.value.nickname))
			if (!nicknameRes.success) {
				uni.showToast({ title: nicknameRes.message != null ? '' + nicknameRes.message : '昵称保存失败', icon: 'none' })
				return
			}
			const profileRes = await updateOwnProfile(buildProfilePayload())
			if (!profileRes.success) {
				uni.showToast({ title: profileRes.message != null ? '' + profileRes.message : '基础资料保存失败', icon: 'none' })
				return
			}
			await refreshCompletion()
			uni.showToast({ title: '资料已保存', icon: 'success' })
			if (detailSheetVisible.value) detailSheetVisible.value = false
			else setTimeout(() => uni.navigateBack({ delta: 1 }), 700)
		} catch (e) {
			uni.showToast({ title: '网络异常，资料未保存', icon: 'none' })
		} finally {
			saving.value = false
		}
	}
</script>

<style scoped>
.crop-overlay { position: fixed; z-index: 200; left: 0; right: 0; top: 0; bottom: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; background: rgba(12,19,19,0.78); }
.crop-panel { position: relative; z-index: 2; width: calc(100% - 40px); padding: 20px; box-sizing: border-box; border-radius: 20px; background: var(--surface); }
.crop-title { display: block; color: var(--ink); font-size: 18px; font-weight: 700; text-align: center; }
.crop-stage { position: relative; width: 100%; height: 280px; margin-top: 18px; overflow: hidden; background: #101515; }
.crop-stage-background { height: 210px; }
.crop-preview-image { width: 100%; height: 100%; transform-origin: center center; }
.crop-frame { position: absolute; left: 50%; top: 50%; width: 220px; height: 220px; transform: translate(-50%, -50%); border: 2px solid #FFFFFF; box-shadow: 0 0 0 999px rgba(0,0,0,0.38); }
.crop-frame-background { width: calc(100% - 24px); height: 164px; }
.crop-hint { display: block; margin-top: 12px; color: var(--muted); font-size: 12px; text-align: center; }
.crop-actions { display: flex; flex-direction: row; gap: 12px; margin-top: 18px; }
.crop-cancel, .crop-confirm { flex: 1; height: 44px; display: flex; align-items: center; justify-content: center; border-radius: 22px; font-size: 14px; font-weight: 600; line-height: 44px; padding: 0; margin: 0; }
.crop-cancel { background: var(--warm); color: var(--ink2); }
.crop-confirm { border: none; background: var(--sage); color: var(--text-invert); }
.crop-canvas { position: fixed; left: -900px; top: -900px; z-index: 1; width: 800px; height: 800px; opacity: 0.01; pointer-events: none; }
.edit-page { min-height: 100vh; background: var(--canvas); display: flex; flex-direction: column; }
.nav-bar { height: 72px; margin-top: 32px; padding: 36px 16px 0; box-sizing: border-box; display: flex; flex-direction: row; align-items: center; justify-content: center; position: relative; background: var(--paper); border-bottom: 1px solid var(--line); }
.nav-back { position: absolute; left: 4px; top: 50%; transform: translateY(-50%); width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: var(--surface); }
.nav-back-icon { font-size: 28px; font-weight: 700; color: var(--ink); line-height: 1; }
.nav-title { font-size: 18px; font-weight: 700; color: var(--ink); }
.state-block { flex: 1; min-height: 420px; padding: 100px 24px 140px; box-sizing: border-box; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; background: linear-gradient(180deg, var(--canvas), var(--paper)); }
.error-state { flex: 1; min-height: 420px; padding: 72px 32px 140px; box-sizing: border-box; display: flex; flex-direction: column; align-items: center; justify-content: center; background: linear-gradient(180deg, var(--canvas), var(--paper)); }
.error-mark { width: 76px; height: 76px; margin-bottom: 24px; display: flex; align-items: center; justify-content: center; border: 1px solid var(--line); border-radius: 24px; background: var(--surface); box-shadow: var(--shadow-md); }
.error-mark text { color: var(--accent2); font-size: 38px; font-weight: 700; line-height: 1; }
.error-title { color: var(--ink); font-size: 18px; font-weight: 700; }
.error-description { max-width: 560rpx; margin-top: 12px; color: var(--ink2); font-size: 14px; line-height: 1.5; text-align: center; }
.error-hint { margin-top: 6px; color: var(--muted); font-size: 12px; }
.error-actions { display: flex; flex-direction: row; align-items: center; gap: 12px; margin-top: 28px; }
.error-retry, .error-cancel { height: 42px; padding: 0 24px; box-sizing: border-box; display: flex; align-items: center; justify-content: center; border-radius: 21px; font-size: 14px; }
.error-retry { min-width: 116px; background: var(--sage); color: var(--text-invert); box-shadow: var(--shadow-sm); }
.error-cancel { min-width: 76px; border: 1px solid var(--line); background: var(--surface); color: var(--ink2); }
.loading-orbit { position: relative; width: 92px; height: 92px; margin-bottom: 18px; display: flex; align-items: center; justify-content: center; }
.loading-ring { position: absolute; width: 78px; height: 78px; border: 4px solid var(--sage-soft); border-top-color: var(--sage); border-right-color: var(--accent); border-radius: 50%; animation: loading-spin 1.15s linear infinite; }
.loading-core { width: 50px; height: 50px; border-radius: 25px; display: flex; align-items: center; justify-content: center; background: var(--sage); box-shadow: 0 8px 20px rgba(51,141,107,0.2); }
.loading-core text { color: var(--text-invert); font-size: 22px; font-weight: 700; }
.state-title { font-size: 17px; font-weight: 700; color: var(--ink); }
.state-description { margin-top: 2px; font-size: 13px; color: var(--muted); }
.loading-dots { display: flex; flex-direction: row; gap: 6px; margin-top: 14px; }
.loading-dots view { width: 6px; height: 6px; border-radius: 3px; background: var(--sage); opacity: 0.35; animation: loading-pulse 1.2s ease-in-out infinite; }
.loading-dots view:nth-child(2) { animation-delay: 0.18s; }
.loading-dots view:nth-child(3) { animation-delay: 0.36s; }
@keyframes loading-spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
@keyframes loading-pulse { 0%, 100% { opacity: 0.3; transform: scale(0.8); } 50% { opacity: 1; transform: scale(1.15); } }
.scroll-content { flex: 1; height: 0; padding: 36px 16px 100px; box-sizing: border-box; }
.progress-section { padding: 12px 16px 4px; display: flex; flex-direction: column; gap: 6px; }
.progress-header, .section-heading { display: flex; flex-direction: row; align-items: center; justify-content: space-between; }
.heading-actions { display: flex; flex-direction: row; align-items: center; gap: 8px; }
.progress-label, .section-title { font-size: 16px; font-weight: 700; color: var(--ink); }
.progress-value { font-size: 14px; font-weight: 700; color: var(--sage); }
.progress-track { height: 6px; border-radius: 3px; background: var(--warm); overflow: hidden; }
.progress-fill { height: 100%; border-radius: 3px; background: linear-gradient(90deg, var(--sage), var(--accent)); }
.progress-hint { font-size: 11px; color: var(--muted); }
.progress-missing { font-size: 12px; line-height: 18px; color: var(--accent2); font-weight: 600; }
.completion-warning { display: block; margin-top: 8px; font-size: 12px; line-height: 18px; color: #D64545; font-weight: 600; }
.preview-action { display: flex; flex-direction: row; align-items: center; gap: 4px; padding: 8px 12px; border-radius: 16px; background: var(--sage-soft); color: var(--sage); }
.preview-action text { font-size: 13px; font-weight: 600; }
.preview-action-arrow { font-size: 16px !important; }
.section-caption { font-size: 12px; color: var(--sage); font-weight: 500; }
.section-card { margin-bottom: 14px; padding: 16px 18px; background: var(--surface); border-radius: 20px; box-shadow: var(--shadow-sm); display: flex; flex-direction: column; gap: 14px; }
.avatar-row { display: flex; flex-direction: row; gap: 16px; align-items: center; }
.avatar-box { position: relative; width: 72px; height: 72px; flex-shrink: 0; border-radius: 50%; overflow: hidden; background: var(--warm); }
.avatar-image { width: 100%; height: 100%; }
.camera-badge { position: absolute; right: 0; bottom: 0; width: 24px; height: 24px; border-radius: 50%; background: var(--sage); display: flex; align-items: center; justify-content: center; }
.camera-icon { font-size: 14px; color: var(--text-invert); }
.avatar-copy { flex: 1; display: flex; flex-direction: column; gap: 4px; }
.avatar-title { font-size: 14px; font-weight: 600; color: var(--ink); }
.avatar-description { font-size: 12px; color: var(--muted); line-height: 1.4; }
.avatar-rule { font-size: 11px; color: var(--ink2); line-height: 1.4; }

/* Pill action */
.pill-action { display: flex; flex-direction: row; align-items: center; gap: 4px; padding: 4px 12px; border-radius: 999px; background: var(--warm); }
.pill-action-text { font-size: 13px; color: var(--muted); }
.pill-action-arrow { font-size: 15px; color: var(--muted); }

/* Album */
.album-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
.album-cell { position: relative; height: 96px; overflow: hidden; border-radius: 12px; background: var(--warm); }
.album-photo { width: 100%; height: 100%; }
.album-delete { position: absolute; top: 4px; right: 4px; width: 22px; height: 22px; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: rgba(12,19,19,0.7); color: var(--text-invert); font-size: 16px; }
.add-cell { display: flex; align-items: center; justify-content: center; border: 1px dashed var(--line); }
.add-icon { font-size: 28px; color: var(--muted); }
.media-note { display: block; margin-top: 2px; color: var(--accent2); font-size: 12px; }

/* Preview */
.preview-list { display: flex; flex-direction: column; }
.nickname-card { gap: 12px; }
.nickname-edit-row { display: flex; flex-direction: row; align-items: center; gap: 12px; }
.nickname-edit-input { flex: 1; min-width: 0; height: 42px; padding: 0 14px; box-sizing: border-box; border-radius: 12px; background: var(--warm); color: var(--ink); font-size: 15px; }
.nickname-edit-save { flex-shrink: 0; min-width: 72px; height: 42px; display: flex; align-items: center; justify-content: center; border-radius: 21px; background: var(--sage-soft); color: var(--sage); font-size: 14px; font-weight: 700; }
.preview-row { display: flex; flex-direction: row; justify-content: space-between; align-items: center; padding: 10px 0; }
.preview-row + .preview-row { border-top: 1px solid var(--line); }
.preview-label { font-size: 13px; color: var(--muted); }
.preview-value { font-size: 13px; color: var(--ink); font-weight: 500; }

/* Certification */
.certification-card { gap: 10px; }
.cert-row { display: flex; flex-direction: row; align-items: center; gap: 12px; padding: 4px 0; }
.cert-row + .cert-row { border-top: 1px solid var(--line); padding-top: 12px; }
.cert-icon-wrap { width: 40px; height: 40px; flex-shrink: 0; border-radius: 50%; background: var(--warm); display: flex; align-items: center; justify-content: center; }
.cert-icon-wrap.cert-icon-done { background: var(--sage-soft); }
.cert-icon { font-size: 16px; color: var(--muted); font-weight: 700; }
.cert-icon-wrap.cert-icon-done .cert-icon { color: var(--sage); }
.cert-copy { flex: 1; display: flex; flex-direction: column; gap: 2px; }
.cert-label { font-size: 14px; color: var(--ink); font-weight: 600; }
.cert-description { font-size: 11px; color: var(--muted); }
.cert-done-pill { flex-shrink: 0; padding: 5px 12px; border-radius: 12px; background: var(--sage-soft); }
.cert-done-text { font-size: 12px; color: var(--sage); font-weight: 600; }
.cert-pending-text { font-size: 12px; color: var(--sage); font-weight: 600; }

/* Intro */
.intro-card { gap: 10px; }
.intro-main-input { width: 100%; min-height: 100px; padding: 12px; box-sizing: border-box; border: none; border-radius: 12px; background: var(--warm); color: var(--muted); font-size: 13px; line-height: 1.5; }
.intro-main-input.has-content { color: var(--ink); }

/* Tags */
.tags-card { gap: 6px; }
.tag-list { display: flex; flex-direction: row; flex-wrap: wrap; gap: 8px; margin-top: 4px; }
.tag-chip { padding: 6px 14px; border-radius: 999px; background: var(--warm); color: var(--ink2); font-size: 13px; font-weight: 500; }
.tag-chip.tag-accent { background: var(--sage-soft); color: var(--sage); }
.tag-chip.tag-add { background: var(--sage-soft); color: var(--sage); font-weight: 600; }
.tag-empty { padding: 6px 0; color: var(--muted); font-size: 13px; }
.preference-card { gap: 8px; }
.preference-summary { padding: 12px 14px; border-radius: 12px; background: var(--warm); color: var(--ink2); font-size: 13px; line-height: 1.5; }

/* QA */
.qa-card { gap: 8px; }
.qa-item { padding: 12px; border-radius: 12px; background: var(--warm); display: flex; flex-direction: column; gap: 6px; }
.qa-question { font-size: 13px; font-weight: 600; color: var(--ink); }
.qa-answer-row { display: flex; flex-direction: row; justify-content: space-between; align-items: center; }
.qa-hint { font-size: 12px; color: var(--muted); }
.qa-answer-text { flex: 1; font-size: 13px; color: var(--ink2); line-height: 1.6; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.qa-edit-icon { font-size: 14px; color: var(--sage); margin-left: 8px; flex-shrink: 0; }
.qa-sheet-body { padding: 4px 20px 0 20px; display: flex; flex-direction: column; gap: 10px; }
.qa-sheet-question { font-size: 15px; font-weight: 600; color: var(--ink); line-height: 1.5; }
.qa-sheet-textarea { width: 100%; height: 140px; padding: 12px; border-radius: 12px; background: var(--warm); font-size: 14px; color: var(--ink); line-height: 1.6; box-sizing: border-box; }
.qa-sheet-count { font-size: 12px; color: var(--muted); text-align: right; }

/* Bottom bar */
.cancel-button { flex: 1; height: 48px; border-radius: 24px; display: flex; align-items: center; justify-content: center; background: var(--warm); color: var(--ink2); font-size: 15px; font-weight: 600; }
.save-button { flex: 1; height: 48px; border-radius: 24px; display: flex; align-items: center; justify-content: center; background: var(--sage); color: var(--text-invert); font-size: 15px; font-weight: 700; box-shadow: 0 4px 12px rgba(51,141,107,0.25); }
.save-button.disabled { opacity: 0.55; }
.scroll-bottom-spacer { height: 60px; }

/* Sheet overlay */
.sheet-overlay { position: fixed; left: 0; right: 0; top: 0; bottom: 0; width: 100%; height: 100vh; background: rgba(12,19,19,0.36); z-index: 100; display: flex; align-items: flex-end; }
.pledge-overlay { position: fixed; z-index: 120; left: 0; right: 0; top: 0; bottom: 0; display: flex; align-items: center; justify-content: center; padding: 24px; box-sizing: border-box; background: rgba(12,19,19,0.38); }
.pledge-dialog { width: 100%; padding: 24px 20px 20px; box-sizing: border-box; border-radius: 20px; background: var(--surface); box-shadow: var(--shadow-md); }
.pledge-title { display: block; color: var(--ink); font-size: 18px; font-weight: 700; text-align: center; }
