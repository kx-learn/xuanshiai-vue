{
  "name": "xuanshiai",
  "version": "1.0.0",
  "description": "宣誓爱婚恋小程序",
  "scripts": {
    "dev:h5": "uni -p h5",
    "build:h5": "uni build -p h5",
    "dev:mp-weixin": "uni -p mp-weixin",
    "build:mp-weixin": "uni build -p mp-weixin",
    "verify:mp": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-mp-weixin.ps1 -MainPackageLimitBytes 2097152 -SubpackageLimitBytes 2097152 -MediaLimitBytes 204800",
    "verify:mp:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-mp-weixin.ps1 -MainPackageLimitBytes 3145728 -SubpackageLimitBytes 3145728 -MediaLimitBytes 307200",
    "test": "node tests/run-tests.cjs",
    "test:core": "node tests/run-tests.cjs",
    "test:all": "node tests/run-tests.cjs --all"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-4020920240930001",
    "@dcloudio/uni-app-plus": "3.0.0-4020920240930001",
    "@dcloudio/uni-components": "3.0.0-4020920240930001",
    "@dcloudio/uni-h5": "3.0.0-4020920240930001",
    "@dcloudio/uni-mp-weixin": "3.0.0-4020920240930001",
    "vue": "^3.4.21"
  },
  "devDependencies": {
    "@dcloudio/vite-plugin-uni": "3.0.0-4020920240930001",
    "@dcloudio/types": "^3.4.8",
    "vite": "5.2.8",
    "sass": "^1.77.0"
  }
}
