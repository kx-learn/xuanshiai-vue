<template>
	<view class="message-page">
		<scroll-view class="scroller" scroll-y @scrolltolower="handleLoadMore">
			<!-- 快捷入口 -->
			<view class="shortcuts">
				<view class="shortcut shortcut-application" @click="openApplications">
					<view class="shortcut-badge shortcut-badge-num" v-if="applicationsError == '' && !applicationLoading && incomingPendingCount > 0 && !incomingHasMore">
						<text class="badge-inner">{{ incomingPendingCount > 99 ? '99+' : incomingPendingCount }}</text>
					</view>
					<view class="shortcut-badge shortcut-badge-dot" v-else-if="applicationsError == '' && !applicationLoading && incomingPendingCount > 0"></view>
					<view class="sc-copy">
						<text class="sc-title">认识申请</text>
						<text class="sc-desc">{{ applicationHint }}</text>
					</view>
					<image class="sc-art sc-art-application" :src="iconApplication" mode="aspectFit"></image>
				</view>
				<view class="shortcut shortcut-plane" @click="openPaperPlane">
					<view class="sc-copy">
						<text class="sc-title">纸飞机</text>
						<text class="sc-desc">匿名投递心意</text>
					</view>
					<image class="sc-art sc-art-plane" :src="iconPlane" mode="aspectFit"></image>
				</view>
				<view class="shortcut shortcut-dynamic" @click="openDynamicNotice">
					<view class="sc-copy">
						<text class="sc-title">ta的动态</text>
						<text class="sc-desc">捕捉Ta的日常</text>
					</view>
					<image class="sc-art sc-art-dynamic" :src="iconDynamic" mode="aspectFit"></image>
				</view>
				<view class="shortcut shortcut-lab" @click="openEmotionLab">
					<view class="sc-copy">
						<text class="sc-title">情感实验室</text>
						<text class="sc-desc">完善你的匹配画像</text>
					</view>
					<image class="sc-art sc-art-lab" :src="iconLab" mode="aspectFit"></image>
				</view>
			</view>

			<!-- 聊天列表 -->
			<view class="chat-header">
				<text class="section-title">聊天</text>
				<text class="clear-read" :class="{ disabled: markingAllRead || !canMarkAllRead }" @click="clearUnreadNotices">全部已读</text>
			</view>
			<view v-if="hiddenSessionIds.length > 0" class="hidden-session-entry" @click="restoreHiddenSessions">
				<text>已隐藏 {{ hiddenSessionIds.length }} 个会话</text><text class="hidden-session-action">恢复</text>
			</view>

			<view v-if="messageError != '' && messageList.length == 0" class="message-state">
				<text class="message-state-text">{{ messageError }}</text>
				<view class="message-state-action" @click="retryMessages"><text>重试</text></view>
			</view>
			<view v-else-if="(loading || !messageLoaded) && messageList.length == 0" class="message-state"><text class="message-state-text">正在加载消息...</text></view>
			<XsaEmpty
				v-else-if="messageList.length == 0"
				text="暂无消息"
				description="申请通过后，对话会出现在这里"
				size="large"
			/>

			<view v-else class="list">
				<XsaMessageItem
					v-for="msg in displayMessageList"
					:key="msg.id"
					:message="msg"
					@click="handleMessageClick"
					@longpress="handleMessageLongPress"
				/>
			</view>
			<view v-if="messageError != '' && messageList.length > 0" class="inline-error"><text>{{ messageError }}</text><text class="inline-error-action" @click="retryMessages">重试</text></view>

			<view class="load-more" v-if="messageList.length > 0">
				<text class="load-text text-muted" v-if="loading">加载中...</text>
				<text class="load-text text-muted" v-else-if="messageError != ''" @click="retryMessages">加载失败，点击重试</text>
				<text class="load-text text-muted" v-else-if="!hasMore">没有更多了</text>
			</view>
		</scroll-view>

		<XsaSheet :visible="pinVisible" :show-handle="false" @close="closePinSheet">
			<view class="pin-actions">
				<XsaButton
					v-if="selectedMessage != null && selectedMessage.pinned === true"
					class="pin-btn pin-btn-primary"
					variant="primary"
					size="medium"
					@click="togglePin"
				>取消置顶</XsaButton>
				<XsaButton v-else class="pin-btn pin-btn-primary" variant="primary" size="medium" @click="togglePin">置顶</XsaButton>
				<XsaButton class="pin-btn pin-btn-delete" variant="secondary" size="medium" @click="hideSelectedMessage">隐藏会话</XsaButton>
				<XsaButton class="pin-btn pin-btn-cancel" variant="secondary" size="medium" @click="closePinSheet">取消</XsaButton>
			</view>
		</XsaSheet>

		<XsaToast :visible="toastVisible" :message="toastMessage" @hide="toastVisible = false" />
	</view>

	<!-- 自定义底部导航栏 -->
	<XsaTabBar />
</template>


<script setup lang="uts">
import XsaTabBar from '@/components/XsaTabBar.uvue'
	import XsaMessageItem from '@/components/XsaMessageItem.uvue'
	import XsaEmpty from '@/components/XsaEmpty.uvue'
	import XsaSheet from '@/components/XsaSheet.uvue'
	import XsaButton from '@/components/XsaButton.uvue'
	import XsaToast from '@/components/XsaToast.uvue'
	import { CURRENT_USER_ID_KEY } from '@/api/config.uts'
	import {
		getConversationPage,
		getApplicationPage,
		markConversationRead,
		markAllMessagesRead,
		setChatSessionPinned,
		hideChatSession,
		restoreChatSession
	} from '@/api'

	const PAGE_SIZE = 20
	const iconApplication = 'data:image/svg+xml;base64,'
	const iconPlane = 'data:image/svg+xml;base64,'
	const iconDynamic = 'data:image/svg+xml;base64,'
	const iconLab = 'data:image/svg+xml;base64,'
	const loading = ref(false)
	const hasMore = ref(true)
	const messageList = ref([] as any[])
	const messageLoaded = ref(false)
	const messageCursor = ref('')
	const messageError = ref('')
	const messageErrorMode = ref('')
	const unreadTotal = ref(0)
	const allReadConfirmed = ref(false)
	const applications = ref([] as any[])
	const incomingTotal = ref(0)
	const incomingHasMore = ref(false)
	const incomingPendingCount = ref(0)
	const applicationsError = ref('')
	const applicationLoading = ref(false)
	const hiddenSessionIds = ref([] as number[])
	const pinVisible = ref(false)
	const selectedMessage = ref<any>(null)
	const markingAllRead = ref(false)
	const sessionMutationId = ref(0)
	const toastVisible = ref(false)
	const toastMessage = ref('')
	let messageRequestSequence = 0
	let applicationRequestSequence = 0
	let mounted = false

	const displayMessageList = computed(() => (messageList.value as any[]).slice())
	const canMarkAllRead = computed(() => unreadTotal.value > 0 || (hasMore.value && messageList.value.length > 0 && !allReadConfirmed.value))

	const applicationHint = computed(() => {
		if (applicationsError.value != '') return applicationsError.value
		if (applicationLoading.value) return '正在加载申请...'
		if (incomingPendingCount.value > 0) {
			return incomingHasMore.value
				? `${incomingPendingCount.value} 条待处理（已加载）`
				: `${incomingPendingCount.value} 条待处理`
		}
		if (incomingTotal.value > 0) return `已收到 ${incomingTotal.value} 条申请`
		return '暂无新申请'
	})

	const openEmotionLab = () => {
		uni.navigateTo({ url: '/pages/emotion-lab/emotion-lab' })
	}

	const showToast = (message: string) => {
		toastMessage.value = message
		toastVisible.value = true
	}

	const responseMessage = (res: any, fallback: string): string => {
		if (res != null && res.message != null && res.message != '' && res.message != 'success') return '' + res.message
		if (res != null && res.data != null && res.data.message != null) return '' + res.data.message
		return fallback
	}

	const appendUnique = (current: any[], next: any[]): any[] => {
		const merged = current.slice()
		next.forEach((item: any) => {
			if (!merged.some((existing: any) => Number(existing.id) == Number(item.id))) merged.push(item)
		})
		return merged
	}

	const loadMessages = async (reset: boolean = true, preserveReadState: boolean = false): Promise<boolean> => {
		if (loading.value) return false
		if (!reset && !hasMore.value) return false
		const requestId = ++messageRequestSequence
		loading.value = true
		messageError.value = ''
		messageErrorMode.value = ''
		if (reset) {
			messageCursor.value = ''
			hasMore.value = true
			if (!preserveReadState) allReadConfirmed.value = false
		}
		const cursor = reset ? '' : messageCursor.value
		try {
			const res = await getConversationPage(cursor, PAGE_SIZE)
			if (requestId != messageRequestSequence) return false
			if (res == null || res.success != true || res.data == null) {
				throw new Error(responseMessage(res, '消息加载失败，请重试'))
			}
			const data = res.data as any
			const rows = Array.isArray(data.list) ? data.list as any[] : []
			messageList.value = reset ? rows : appendUnique(messageList.value as any[], rows)
			messageCursor.value = data.nextCursor != null ? '' + data.nextCursor : ''
			hasMore.value = data.hasMore == true
			unreadTotal.value = (messageList.value as any[]).reduce((sum: number, item: any) => sum + Number(item.unreadCount || 0), 0)
			messageError.value = ''
			return true
		} catch (error: any) {
			if (requestId != messageRequestSequence) return false
			messageError.value = error != null && error.message != null && error.message != '' ? '' + error.message : '消息加载失败，请重试'
			messageErrorMode.value = reset ? 'reset' : 'more'
			return false
		} finally {
			if (requestId == messageRequestSequence) {
				loading.value = false
				messageLoaded.value = true
			}
		}
	}

	const retryMessages = () => {
		loadMessages(messageErrorMode.value != 'more')
	}

	const loadApplications = async () => {
		if (applicationLoading.value) return
		const requestId = ++applicationRequestSequence
		applicationLoading.value = true
		applicationsError.value = ''
		try {
			const res = await getApplicationPage('incoming', '', PAGE_SIZE)
			if (requestId != applicationRequestSequence) return
			if (res == null || res.success != true || res.data == null) {
				throw new Error(responseMessage(res, '申请列表加载失败，请重试'))
			}
			const data = res.data as any
			const rows = Array.isArray(data.list) ? data.list as any[] : []
			applications.value = rows
			incomingTotal.value = Number(data.total != null ? data.total : rows.length)
			incomingHasMore.value = data.hasMore == true
			incomingPendingCount.value = rows.filter((item: any) => item.status == 'pending').length
		} catch (error: any) {
			if (requestId != applicationRequestSequence) return
			applicationsError.value = '申请列表加载失败，请重试'
			const detail = error != null && error.message != null && error.message != '' ? '' + error.message : ''
			if (detail != '') applicationsError.value = detail
		} finally {
			if (requestId == applicationRequestSequence) applicationLoading.value = false
		}
	}

	const getHiddenSessionStorageKey = (): string => {
		const userId = Number(uni.getStorageSync(CURRENT_USER_ID_KEY))
		return userId > 0 ? 'xsa-hidden-chat-session-ids:' + userId : ''
	}

	const loadHiddenSessionIds = () => {
		const key = getHiddenSessionStorageKey()
		if (key == '') {
			hiddenSessionIds.value = []
			return
		}
		try {
			const stored = uni.getStorageSync(key)
			const ids: number[] = []
			if (Array.isArray(stored)) {
				for (let index = 0; index < stored.length; index++) {
					const id = Number(stored[index])
					if (id > 0 && ids.indexOf(id) < 0) ids.push(id)
				}
			}
			hiddenSessionIds.value = ids
		} catch (error) {
			hiddenSessionIds.value = []
		}
	}

	const saveHiddenSessionIds = () => {
		const key = getHiddenSessionStorageKey()
		if (key == '') return
		try {
			uni.setStorageSync(key, hiddenSessionIds.value)
		} catch (error) {
			console.error(error)
		}
	}

	const openApplications = () => {
		uni.navigateTo({
			url: '/pagesSub/profileExtra/applications?tab=received',
			fail: () => { showToast('申请列表打开失败，请重试') }
		})
	}

	const openPaperPlane = () => {
		uni.navigateTo({ url: '/pagesSub/community/paper-plane' })
	}

	const openDynamicNotice = () => {
		try {
			uni.setStorageSync('xsa-community-entry-target', 'follow-all')
		} catch (error) {
			console.error(error)
		}
		uni.switchTab({
			url: '/pages/community/community',
			fail: () => {
				try { uni.removeStorageSync('xsa-community-entry-target') } catch (error) { console.error(error) }
				showToast('社区关注页打开失败，请重试')
			}
		})
	}

	const clearUnreadNotices = () => {
		if (!canMarkAllRead.value || markingAllRead.value) return
		uni.showModal({
			title: '全部标记为已读',
			content: '将把服务端可见的聊天会话全部标记为已读，不会删除消息。',
			confirmText: '确认',
			cancelText: '取消',
			success: (res) => {
				if (res.confirm) markAllUnread()
			}
		})
	}

	const markAllUnread = async () => {
		if (markingAllRead.value || !canMarkAllRead.value) return
		markingAllRead.value = true
		try {
			const res = await markAllMessagesRead()
			if (res == null || res.success != true || res.data == null || res.data.success != true) {
				showToast(responseMessage(res, '全部已读失败，请重试'))
				return
			}
			allReadConfirmed.value = true
			const refreshed = await loadMessages(true, true)
			showToast(refreshed ? '消息已全部标为已读' : '已标记成功，但列表刷新失败，请重试')
		} catch (error) {
			showToast('全部已读失败，请重试')
		} finally {
			markingAllRead.value = false
		}
	}

	const handleMessageLongPress = (message: any) => {
		selectedMessage.value = message
		pinVisible.value = true
	}

	const closePinSheet = () => {
		if (sessionMutationId.value != 0) return
		pinVisible.value = false
		selectedMessage.value = null
	}

	const togglePin = async () => {
		const message = selectedMessage.value
		const sessionId = Number(message != null ? message.sessionId : 0)
		if (sessionMutationId.value != 0 || sessionId <= 0) return
		const nextPinned = message.pinned !== true
		sessionMutationId.value = sessionId
		try {
			const res = await setChatSessionPinned(sessionId, nextPinned)
			if (res == null || res.success != true) {
				showToast(responseMessage(res, nextPinned ? '置顶失败，请重试' : '取消置顶失败，请重试'))
				return
			}
			message.pinned = nextPinned
			messageList.value = (messageList.value as any[]).slice()
			pinVisible.value = false
			selectedMessage.value = null
			showToast(nextPinned ? '已置顶该会话' : '已取消置顶')
			await loadMessages(true, true)
		} catch (error) {
			showToast(nextPinned ? '置顶失败，请重试' : '取消置顶失败，请重试')
		} finally {
			sessionMutationId.value = 0
		}
	}

	const hideSelectedMessage = () => {
		const message = selectedMessage.value
		if (message == null || Number(message.sessionId) <= 0 || sessionMutationId.value != 0) return
		pinVisible.value = false
		uni.showModal({
			title: '隐藏会话',
			content: '隐藏后不会删除历史消息、解除关系或拉黑对方；可在消息页恢复。',
			confirmText: '隐藏',
			cancelText: '取消',
			success: (res) => {
				if (res.confirm) hideSession(message)
				else selectedMessage.value = null
			}
		})
	}

	const hideSession = async (message: any) => {
		const sessionId = Number(message != null ? message.sessionId : 0)
		if (sessionMutationId.value != 0 || sessionId <= 0) return
		sessionMutationId.value = sessionId
		try {
			const res = await hideChatSession(sessionId)
			if (res == null || res.success != true) {
				showToast(responseMessage(res, '隐藏会话失败，请重试'))
				return
			}
			if (hiddenSessionIds.value.indexOf(sessionId) < 0) hiddenSessionIds.value.push(sessionId)
			saveHiddenSessionIds()
			messageList.value = (messageList.value as any[]).filter((item: any) => Number(item.sessionId) != sessionId)
			unreadTotal.value = (messageList.value as any[]).reduce((sum: number, item: any) => sum + Number(item.unreadCount || 0), 0)
			selectedMessage.value = null
			showToast('已隐藏会话，可在消息页恢复')
		} catch (error) {
			showToast('隐藏会话失败，请重试')
		} finally {
			sessionMutationId.value = 0
		}
	}

	const restoreHiddenSessions = () => {
		if (hiddenSessionIds.value.length == 0 || sessionMutationId.value != 0) return
		uni.showModal({
			title: '恢复隐藏会话',
			content: '恢复后会话和历史消息会重新出现在列表中。',
			confirmText: '恢复',
			cancelText: '取消',
			success: (res) => {
				if (res.confirm) restoreHiddenSessionList()
			}
		})
	}
	const restoreHiddenSessionList = async () => {
		if (sessionMutationId.value != 0) return
		const ids = (hiddenSessionIds.value as number[]).slice()
		if (ids.length == 0) return
		sessionMutationId.value = -1
		let restored: number[] = []
		let failed = 0
		try {
			for (let index = 0; index < ids.length; index++) {
				try {
					const res = await restoreChatSession(ids[index])
					if (res != null && res.success == true) restored.push(ids[index])
					else failed += 1
				} catch (error) {
					failed += 1
				}
			}
			hiddenSessionIds.value = ids.filter((id: number) => restored.indexOf(id) < 0)
			saveHiddenSessionIds()
			if (restored.length > 0) await loadMessages(true, true)
			if (failed == 0) showToast('已恢复隐藏会话')
			else showToast(`已恢复 ${restored.length} 个，${failed} 个失败，请重试`)
		} finally {
			sessionMutationId.value = 0
		}
	}

	const handleMessageClick = async (message: any) => {
		const userId = Number(message != null ? message.userId : 0)
		const sessionId = Number(message != null ? message.sessionId : 0)
		if (userId <= 0 || sessionId <= 0) {
			showToast('会话信息无效，请刷新后重试')
			return
		}
		const readRes = await markConversationRead(sessionId)
		if (readRes != null && readRes.success == true) {
			message.unreadCount = 0
			unreadTotal.value = (messageList.value as any[]).reduce((sum: number, item: any) => sum + Number(item.unreadCount || 0), 0)
			messageList.value = (messageList.value as any[]).slice()
		} else {
			showToast('已读状态暂时无法更新，仍保留未读提示')
		}
		uni.navigateTo({
			url: '/pagesSub/chat/detail?userId=' + userId + '&userName=' + encodeURIComponent(message.name != null ? '' + message.name : ''),
			fail: () => { showToast('聊天打开失败，请重试') }
		})
	}

	const handleLoadMore = () => {
		loadMessages(false)
	}

	onMounted(() => {
		mounted = true
		loadHiddenSessionIds()
		loadMessages(true)
		loadApplications()
	})

	onShow(() => {
		if (!mounted) return
		loadHiddenSessionIds()
		loadMessages(true)
		loadApplications()
	})

	onUnmounted(() => {
		messageRequestSequence += 1
		applicationRequestSequence += 1
		mounted = false
	})
</script>
<style scoped>
	.message-page {
		min-height: 100vh;
		background: #FDFDFD;
	}

	.scroller {
		height: 100vh;
		padding: 16px 16px 96px;
	}

	.section-title {
		display: block;
		margin-bottom: 12px;
		font-size: 28rpx;
		font-weight: 700;
		letter-spacing: 0.5rpx;
		color: #2A2A2A;
	}

	.shortcuts {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 24rpx;
		margin-bottom: 48rpx;
	}

	.shortcut {
		position: relative;
		min-height: 208rpx;
		padding: 32rpx 28rpx 36rpx;
		border-radius: 18rpx;
		display: flex;
		flex-direction: column;
		justify-content: flex-start;
		overflow: hidden;
		box-shadow: 0 4rpx 20rpx rgba(60, 60, 70, 0.035);
		transition: transform 0.18s ease-out;
	}

	.shortcut:active {
		transform: scale(0.98);
	}

	.shortcut-application {
		background: #F7F2FA;
	}

	.shortcut-plane {
		background: #F0F8FA;
	}

	.shortcut-dynamic {
		background: #F2F9F4;
	}

	.shortcut-lab {
		background: #FDF3EB;
	}

	.shortcut-badge {
		position: absolute;
		top: 24rpx;
		right: 24rpx;
		z-index: 4;
		display: flex;
		align-items: center;
		justify-content: center;
		background: #EF6B6B;
	}

	.shortcut-badge-num {
		min-width: 36rpx;
		height: 36rpx;
		border-radius: 18rpx;
		padding: 0 10rpx;
		box-sizing: border-box;
	}

	.badge-inner {
		font-size: 22rpx;
		font-weight: 600;
		color: #FFFFFF;
	}

	.sc-copy {
		position: relative;
		z-index: 2;
		max-width: 72%;
		display: flex;
		flex-direction: column;
		gap: 12rpx;
	}

	.sc-title {
		font-size: 28rpx;
		font-weight: 700;
		line-height: 40rpx;
		letter-spacing: 0.5rpx;
		color: #2A2A2A;
	}

	.sc-desc {
		font-size: 24rpx;
		font-weight: 400;
		line-height: 36rpx;
		color: #9AA0A6;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.sc-art {
		position: absolute;
		right: 28rpx;
		bottom: 24rpx;
		width: 128rpx;
		height: 128rpx;
		opacity: 0.42;
		pointer-events: none;
	}

	.art-chat {
		position: absolute;
		background: #C9B8E0;
		border-radius: 10px;
		transform: rotate(-8deg);
	}

	.art-chat-large {
		right: 0;
		top: 5px;
		width: 36px;
