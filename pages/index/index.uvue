						</view>
					</view>
				</view>

				<view class="vip-cat-tabs">
					<view class="vip-cat-tab" @tap="switchVipCat(0)"><text :class="['vip-cat-tab-text', vipCatIndex === 0 ? 'active' : '']">高颜值专区</text><view v-if="vipCatIndex === 0" class="vip-cat-indicator"></view></view>
					<view class="vip-cat-tab" @tap="switchVipCat(1)"><text :class="['vip-cat-tab-text', vipCatIndex === 1 ? 'active' : '']">高收入专区</text><view v-if="vipCatIndex === 1" class="vip-cat-indicator"></view></view>
					<view class="vip-cat-tab" @tap="switchVipCat(2)"><text :class="['vip-cat-tab-text', vipCatIndex === 2 ? 'active' : '']">高学历专区</text><view v-if="vipCatIndex === 2" class="vip-cat-indicator"></view></view>
					<view class="vip-cat-tab" @tap="switchVipCat(3)"><text :class="['vip-cat-tab-text', vipCatIndex === 3 ? 'active' : '']">95后专区</text><view v-if="vipCatIndex === 3" class="vip-cat-indicator"></view></view>
