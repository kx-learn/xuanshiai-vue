<template>
	<view class="page-shell">
		<!-- 欢迎页 -->
		<view v-if="welcomeVisible" class="welcome-screen">
			<image class="welcome-image" src="/static/portraits/profile-woman-main.webp" mode="aspectFill"></image>
			<view class="welcome-scrim"></view>
			<view class="welcome-service" @click="showWelcomeService">联系客服</view>
			<view class="welcome-copy">
				<view class="brand-mark"><image src="/static/logo.png" mode="aspectFit"></image></view>
				<text class="welcome-title">宣誓爱</text>
				<text class="welcome-subtitle">认真认识一个人，慢慢走进一段关系</text>
			</view>
			<view class="welcome-actions">
				<button class="welcome-start-button" @click="openWelcomeAgreement">开始邂逅</button>
			</view>
			<view v-if="welcomeAgreementVisible" class="agreement-mask" @click="closeWelcomeAgreement">
				<view class="agreement-dialog" @click.stop>
					<text class="agreement-title">欢迎来到宣誓爱</text>
					<text class="agreement-copy">为了给你更好的交友体验，请先阅读并同意</text>
					<view class="agreement-links">
						<text class="agreement-link" @click="openWelcomeDocument('terms')">《用户协议》</text>
						<text class="agreement-link-copy">与</text>
						<text class="agreement-link" @click="openWelcomeDocument('privacy')">《隐私政策》</text>
					</view>
					<view class="agreement-actions">
						<button class="agreement-cancel" @click="closeWelcomeAgreement">暂不进入</button>
						<button class="agreement-confirm" @click="acceptWelcomeAgreement">同意并继续</button>
					</view>
				</view>
			</view>
		</view>

		<view v-else class="page">
			<!-- 固定头部 -->
			<view class="sticky-header" :style="{ paddingTop: statusBarHeight + 'px' }">
			<!-- 导航栏 -->
			<view class="nav-bar">
				<view class="nav-tabs">
					<view class="nav-tab-item" v-for="(tab, i) in navTabs" :key="i" @click="switchTab(i)">
						<text :class="['nav-tab-text', currentTab === i ? 'active' : '']">{{ tab }}</text>
						<view v-if="currentTab === i" class="active-indicator"></view>
					</view>
				</view>
				<view class="history-btn" @tap="onHistory">
					<text class="ic ic-home ic-history history-icon"></text>
				</view>
			</view>

			<!-- 筛选搜索栏 -->
			<view v-if="currentTab === 0 || currentTab === 1" class="filter-bar">
				<view class="search-box" @click="onSearch">
					<text class="ic ic-home ic-search search-icon"></text>
					<text class="search-placeholder">{{ currentTab === 0 ? '按城市、年龄、学历、MBTI筛选…' : '按城市、年龄、学历、MBTI…' }}</text>
				</view>
			</view>

			</view>
			<!-- 推荐 Tab -->
			<scroll-view v-if="currentTab === 0" scroll-y class="content-scroll" enhanced show-scrollbar="false" @touchstart="onTouchStart" @touchend="onTouchEnd">
				<view v-if="discoveryError != ''" class="completion-reminder completion-reminder-error">
					<text class="completion-reminder-title">推荐暂时无法加载</text>
					<text class="completion-reminder-copy">{{ discoveryError }}</text>
					<view class="completion-gate-button" @tap="loadHomeDiscovery"><text>重新加载</text></view>
				</view>
				<view v-else-if="profileCompletionError != ''" class="completion-reminder completion-reminder-error">
					<text class="completion-reminder-title">资料状态暂时无法读取</text>
					<text class="completion-reminder-copy">{{ profileCompletionError }}，仍可浏览公开推荐。</text>
					<view class="completion-gate-button" @tap="loadHomeDiscovery"><text>重新加载</text></view>
				</view>
				<view v-else-if="profileCompletionLoaded && profileCompletion < 100" class="completion-reminder">
					<text class="completion-reminder-title">资料完善度 {{ profileCompletion }}%</text>
					<text class="completion-reminder-copy">完善资料后能获得更有参考价值的推荐；现在也可继续浏览。</text>
					<view class="completion-gate-progress"><view class="completion-gate-fill" :style="{ width: profileCompletion + '%' }"></view></view>
					<navigator class="completion-gate-button" url="/pagesSub/userExtra/user/edit" hover-class="none"><text>去完善资料</text></navigator>
				</view>
				<view v-if="recommendUsers.length === 0 && discoveryError == ''" class="completion-gate">
					<text class="completion-gate-title">暂时没有新的推荐</text>
					<text class="completion-gate-copy">我们正在更新公开推荐资料，请稍后再来看看。</text>
				</view>
				<view v-else-if="recommendUsers.length > 0" class="profile-card">
					<view class="cover-wrap">
						<image class="cover-img" :src="recommendBackground != '' ? recommendBackground : currentRecommendUser.avatar" mode="aspectFill"></image>
					</view>

					<!-- 头像在 profile-card 下独立定位，不被 card-body 盖住 -->
					<view class="avatar-wrap" @tap="goUserDetail(currentRecommendUser.id)">
						<image class="avatar-img" :src="currentRecommendUser.avatar" mode="aspectFill"></image>
					</view>
					<view class="card-body">
						<view class="user-info-header">
							<view class="user-name-line">
								<text class="name-age">{{ currentRecommendUser.name }}，{{ currentRecommendUser.age }}岁</text>
								<view v-if="currentRecommendUser.isVip === true" class="recommend-vip-badge">
									<text class="ic ic-vip ic-huiyuan recommend-vip-icon"></text>
									<text class="recommend-vip-text">VIP</text>
								</view>
							</view>
							<view class="basic-line">
								<text class="basic-text">{{ currentRecommendUser.education }}</text>
								<view class="dot-sep"></view>
								<text class="basic-text">{{ currentRecommendUser.job }}</text>
								<view class="dot-sep"></view>
								<text class="basic-text">{{ locationTextByCityCode(currentRecommendUser.city) }}</text>
							</view>
							<view class="online-row" :class="{ offline: currentRecommendUser.online !== true }">
								<view class="online-dot"></view>
											<text class="online-text">{{ currentRecommendUser.online === true ? '在线' : '离线' }}</text>
								<text class="distance-text">· 距你 {{ currentRecommendUser.distance }}km · 近期活跃</text>
							</view>
						</view>

						<view class="tags-row">
							<view class="tag accent-tag" v-if="currentRecommendUser.online === true"><view class="tag-dot"></view><text class="tag-text-accent">积极营业</text></view>
							<view class="tag" v-if="currentRecommendUser.mbti != null && currentRecommendUser.mbti != ''"><text class="tag-text">{{ currentRecommendUser.mbti }}</text></view>
							<view class="tag" v-for="tag in currentRecommendUser.interestTags" :key="tag"><text class="tag-text">{{ tag }}</text></view>
						</view>

						<view class="divider"></view>

						<view class="about-section">
							<text class="section-title">关于我</text>
							<text class="about-content">{{ currentRecommendUser.bio }}</text>
						</view>

						<view class="divider"></view>

						<view class="cert-section">
							<text class="cert-label">已认证:</text>
							<view class="cert-tag">
								<text class="ic ic-sys ic-shiming cert-icon"></text>
								<text class="cert-text">实名</text>
							</view>
							<view class="cert-tag">
								<text class="ic ic-me ic-xueli cert-icon"></text>
								<text class="cert-text">学历</text>
							</view>
							<view class="cert-tag">
								<text class="ic ic-home ic-heart cert-icon gold-icon"></text>
								<text class="cert-text">单身</text>
							</view>
							<view class="cert-tag">
								<text class="ic ic-social ic-paishe cert-icon"></text>
								<text class="cert-text">头像</text>
							</view>
						</view>

						<view class="divider"></view>

						<view class="match-section" @click="showAiScore">
							<view class="match-ring">
								<view class="ring-outer">
									<view class="ring-inner"></view>
								</view>
								<text class="ring-percent">{{ currentRecommendUser.matchScore }}%</text>
							</view>
							<view class="match-info">
								<text class="match-title">AI 匹配度分析</text>
								<text class="match-desc">MBTI高度契合 · 兴趣重合度高 · 三观相近</text>
							</view>
						</view>

						<view class="divider"></view>

						<view class="info-grid-section">
							<text class="section-title">基础资料</text>
							<view class="info-grid">
								<view class="info-row" v-for="(row, ri) in basicInfoRows" :key="ri">
									<view class="info-item" v-for="(item, ii) in row" :key="ii">
										<text class="info-label">{{ item.label }}</text>
										<text class="info-value">{{ item.value }}</text>
									</view>
								</view>
							</view>
						</view>

						<view class="divider"></view>

						<view class="photos-section">
							<view class="feed-section-header">
								<text class="section-title">Ta的瞬间</text>
								<text v-if="firstMomentPhoto != ''" class="feed-more" @click="viewAllMoments">查看全部 ›</text>
							</view>
							<image v-if="firstMomentPhoto != ''" class="photo-large" :src="firstMomentPhoto" mode="aspectFill"></image>
						</view>

						<view class="divider"></view>

<view class="divider"></view>

<!-- Ta的动态 -->

<view class="feed-section">

<view class="feed-section-header">

<text class="section-title">Ta的动态</text>

<text class="feed-more" @click="viewAllFeed">查看全部 ›</text>

</view>

<view class="feed-list">

<view class="feed-card" v-for="(feed, fi) in feedDynamics.slice(0, 1)" :key="fi" @tap="goPostDetail(feed.id)">

<view class="feed-card-header">

<image class="feed-card-avatar" :src="feed.avatar" mode="aspectFill"></image>

<view class="feed-card-user-col">

<text class="feed-card-name">{{ feed.name }}</text>

<text class="feed-card-meta">{{ feed.timeText }} · {{ feed.location }}</text>

</view>

</view>

<text class="feed-card-content">{{ feed.content }}</text>

<view class="feed-card-photos" v-if="feed.photos && feed.photos.length > 0">

<image v-for="(photo, pi) in feed.photos" :key="pi" class="feed-photo" :class="feed.photos.length === 1 ? 'feed-photo-single' : 'feed-photo-double'" :src="photo" mode="aspectFill"></image>

</view>

<view class="feed-card-tags" v-if="feed.tags && feed.tags.length > 0">

<text class="feed-tag" v-for="(tag, ti) in feed.tags" :key="ti">{{ tag }}</text>

</view>

<view class="feed-card-divider"></view>

<view class="feed-card-footer">

							<text class="feed-date">{{ feed.timeText }} · {{ feed.location }}</text>

<view class="feed-actions">

<view class="feed-action"><text class="ic ic-home ic-heart feed-action-icon"></text><text class="feed-action-count">{{ feed.likeCount }}</text></view>

<view class="feed-action"><text class="ic ic-social ic-pinglun feed-action-icon"></text><text class="feed-action-count">{{ feed.commentCount }}</text></view>

<view class="feed-action"><text class="ic ic-sys ic-fenxiang feed-action-icon"></text></view>

</view>

</view>

</view>

</view>

</view>

<!-- 动态区块结束 -->
						<view class="activity-row">
							<text class="ic ic-home ic-dingwei activity-dot"></text><text class="activity-text"> 近期活跃 · 距你 {{ currentRecommendUser.distance }}km</text>
							<text class="viewed-text">{{ currentRecommendUser.viewCount > 0 ? currentRecommendUser.viewCount + '人看过' : '' }}</text>
						</view>
					</view>
				</view>

				<!-- 屏蔽/举报行 -->
				<view v-if="canShowRecommendUsers" class="block-row">
					<view class="block-action" @tap="openReportPage"><text class="block-text">举报Ta</text></view><text class="block-divider">|</text><view class="block-action" @tap="handleBlockUser"><text class="block-text">拉黑Ta</text></view>
				</view>
				<view class="scroll-bottom-spacer"></view>
			</scroll-view>

			<!-- 广场 Tab -->
			<scroll-view v-if="currentTab === 1" scroll-y class="content-scroll" enhanced show-scrollbar="false">
				<view class="pinned-bar">
					<view class="pinned-left">
						<text class="ic ic-home ic-star pinned-flame"></text>
						<text class="pinned-title">置顶推荐</text>
						<view class="quality-badge"><text class="quality-text">优质</text></view>
					</view>
					<view class="want-top-btn" @tap="openTopPlacement">
						<text class="ic ic-sys ic-zhankai want-top-icon"></text>
						<text class="want-top-text">我要置顶</text>
					</view>
				</view>

				<view class="square-feed">
					<view v-if="squareUsers.length > 0" class="square-user-card" @tap="goUserDetail(squareAt(0).id)">
						<view class="sq-photo-wrap">
							<image class="sq-photo" :src="squareAt(0).avatar" mode="aspectFill"></image>
							<view v-if="squareAt(0).is_vip === true || squareAt(0).isVip === true" class="vip-tag"><text class="ic ic-vip ic-huiyuan vip-tag-icon"></text><text class="vip-tag-text"> VIP</text></view>
						</view>
						<view class="sq-card-info">
							<view class="sq-left-info">
								<view class="sq-name-row">
									<text class="sq-name">{{ squareAt(0).name }}</text>
									<text class="sq-age">{{ squareAt(0).age }}岁</text>
								</view>
								<view class="sq-meta-row">
									<text class="sq-meta-text"><text class="ic ic-home ic-dingwei sq-loc-icon"></text> 距你 {{ squareAt(0).distance }}km</text>
									<view class="sq-dot"></view>
									<text class="sq-meta-text">{{ squareAt(0).job }} · {{ squareAt(0).city }}</text>
								</view>
							</view>
							<view class="sq-like-btn" @click.stop="onLike(squareAt(0).id)">
								<text v-if="isLiked(squareAt(0).id)" class="sq-heart heart-font heart-solid"></text>
								<text v-else class="sq-heart heart-font heart-outline"></text>
							</view>
						</view>
					</view>

					<view v-if="squareUsers.length > 1" class="square-user-card" @tap="goUserDetail(squareAt(1).id)">
						<view class="sq-photo-wrap">
							<image class="sq-photo" :src="squareAt(1).avatar" mode="aspectFill"></image>
						</view>
						<view class="sq-card-info">
							<view class="sq-left-info">
								<view class="sq-name-row">
									<text class="sq-name">{{ squareAt(1).name }}</text>
									<text class="sq-age">{{ squareAt(1).age }}岁</text>
								</view>
								<view class="sq-meta-row">
									<text class="sq-meta-text"><text class="ic ic-home ic-dingwei sq-loc-icon"></text> 距你 {{ squareAt(1).distance }}km</text>
									<view class="sq-dot"></view>
									<text class="sq-meta-text">{{ squareAt(1).job }} · {{ squareAt(1).city }}</text>
								</view>
							</view>
							<view class="sq-like-btn" @click.stop="onLike(squareAt(1).id)">
								<text v-if="isLiked(squareAt(1).id)" class="sq-heart heart-font heart-solid"></text>
								<text v-else class="sq-heart heart-font heart-outline"></text>
							</view>
						</view>
					</view>

					<view v-if="vipSquareUsers.length > 0" class="sq-section">
						<view class="sq-section-header">
							<view class="sq-section-title-group">
								<text class="ic ic-vip ic-huiyuan sq-section-icon"></text>
								<text class="sq-section-title">会员专区</text>
						<text class="sq-section-count">{{ vipSquareUsers.length + '位' }}</text>
							</view>
							<text class="sq-section-more">查看全部 ›</text>
						</view>
						<view class="sq-vip-row">
							<view v-if="vipSquareUsers.length > 0" class="sq-vip-mini" @tap="goUserDetail(vipSquareAt(0).id)">
								<view class="sq-vip-content">
									<image class="sq-vip-photo" :src="vipSquareAt(0).avatar" mode="aspectFill"></image>
									<view v-if="vipSquareAt(0).is_vip === true || vipSquareAt(0).isVip === true" class="vip-tag sq-vip-tag"><text class="ic ic-vip ic-huiyuan vip-tag-icon"></text><text class="vip-tag-text"> VIP</text></view>
									<view class="sq-vip-info">
										<view class="sq-vip-left">
										<text class="sq-vip-name">{{ vipSquareAt(0).name }}</text>
										<text class="sq-vip-detail">{{ vipSquareAt(0).age }}岁 · {{ vipSquareAt(0).height }}cm</text>
										</view>
										<view class="sq-vip-like" @tap.stop="onLike(vipSquareAt(0).id)"><text v-if="isLiked(vipSquareAt(0).id)" class="sq-heart-sm heart-font heart-solid"></text><text v-else class="sq-heart-sm heart-font heart-outline"></text></view>
									</view></view>
							</view>
							<view v-if="vipSquareUsers.length > 1" class="sq-vip-mini" @tap="goUserDetail(vipSquareAt(1).id)">
								<view class="sq-vip-content">
									<image class="sq-vip-photo" :src="vipSquareAt(1).avatar" mode="aspectFill"></image>
									<view v-if="vipSquareAt(1).is_vip === true || vipSquareAt(1).isVip === true" class="vip-tag sq-vip-tag"><text class="ic ic-vip ic-huiyuan vip-tag-icon"></text><text class="vip-tag-text"> VIP</text></view>
									<view class="sq-vip-info">
										<view class="sq-vip-left">
										<text class="sq-vip-name">{{ vipSquareAt(1).name }}</text>
										<text class="sq-vip-detail">{{ vipSquareAt(1).age }}岁 · {{ vipSquareAt(1).height }}cm</text>
										</view>
										<view class="sq-vip-like" @tap.stop="onLike(vipSquareAt(1).id)"><text v-if="isLiked(vipSquareAt(1).id)" class="sq-heart-sm heart-font heart-solid"></text><text v-else class="sq-heart-sm heart-font heart-outline"></text></view>
									</view></view>
							</view>
						</view>
						<text v-if="vipSquareUsers.length === 0" class="sq-section-empty">暂无会员专区资料</text>
					</view>

					<view v-if="squareUsers.length > 4" class="square-user-card" @tap="goUserDetail(squareAt(4).id)">
						<view class="sq-photo-wrap">
							<image class="sq-photo" :src="squareAt(4).avatar" mode="aspectFill"></image>
						</view>
						<view class="sq-card-info">
							<view class="sq-left-info">
