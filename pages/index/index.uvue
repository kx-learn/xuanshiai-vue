							<text class="vip-priv-title">会员专属权益</text>
							<text class="vip-priv-subtitle">优先曝光 · 深度资料解锁 · 申请认识 7次/日</text>
						</view>
						<view class="vip-upgrade-btn" @tap="openVipPage">
							<text class="ic ic-vip ic-huiyuan vip-upgrade-icon"></text>
							<text class="vip-upgrade-text">立即开通</text>
						</view>
					</view>
				</view>

				<view class="vip-bottom-cta">
					<text class="ic ic-home ic-star vip-cta-icon"></text><text class="vip-cta-title"> 升级VIP会员</text>
					<text class="vip-cta-desc">解锁全部会员资料 · 无限牵线次数 · 优先展示曝光</text>
						<view class="vip-price-row">
							<view class="vip-price-opt">
							<text class="vip-price-period">{{ planAt(0).duration }}</text>
							<text class="vip-price-value">{{ planAt(0).price }}</text>
						</view>
							<view class="vip-price-opt recommended">
							<view class="vip-price-badge"><text class="vip-price-badge-text">推荐</text></view>
							<text class="vip-price-period">{{ planAt(1).duration }}</text>
							<text class="vip-price-value">{{ planAt(1).price }}</text>
						</view>
							<view class="vip-price-opt">
							<text class="vip-price-period">{{ planAt(2).duration }}</text>
							<text class="vip-price-value">{{ planAt(2).price }}</text>
						</view>
					</view>
					<view class="vip-cta-btn" @tap="openVipPage">
						<text class="vip-cta-btn-text">立即开通VIP</text>
					</view>
					<text class="vip-cta-hint">付费即同意《会员服务协议》· 可随时取消</text>
				</view>

				<view class="scroll-bottom-spacer"></view>
			</scroll-view>

			<!-- 底部操作栏（仅推荐页显示） -->
			<view v-if="currentTab === 0 && canShowRecommendUsers" class="bottom-bar">
				<view class="share-btn" @click="shareProfile">
					<text class="ic ic-sys ic-fenxiang share-icon"></text>
				</view>
				<view class="chat-btn" @click="openApplyModal">
					<text class="ic ic-home ic-hello chat-icon"></text>
						<text class="chat-text">申请认识</text>
				</view>
				<view class="like-btn" @click="onLike(recommendUserId)">
					<text v-if="isLiked(recommendUserId)" class="heart-icon heart-font heart-solid"></text>
					<text v-else class="heart-icon heart-font heart-outline"></text>
				</view>
			</view>

			<!-- AI分身悬浮按钮（仅推荐页显示）：与当前展示用户的AI分身聊天，液态玻璃·气泡低语 -->
			<view v-if="currentTab === 0 && canShowRecommendUsers" class="ai-float-btn" @click="openAiAvatarForCurrentUser">
				<view class="ai-float-glass">
					<view class="ai-float-halo"></view>
					<view class="ai-float-bubble">
						<view class="ai-float-dot ai-float-dot1"></view>
						<view class="ai-float-dot ai-float-dot2"></view>
						<view class="ai-float-dot ai-float-dot3"></view>
					</view>
				</view>
			</view>
		</view>

		<!-- ====== Sheets & Modals ====== -->
		<!-- AI 匹配度解读：MBTI 配对解析小窗（顶部横线可拖拽调整高度，内容区可滚动） -->
		<XsaAiMatchSheet
			:visible="aiVisible"
			my-name="你"
			:my-avatar="myAvatar"
			:my-mbti="myMbti"
			:other-name="aiOtherName"
			:other-avatar="aiOtherAvatar"
			:other-mbti="aiOtherMbti"
			:score="aiScore"
			@close="aiVisible = false"
		/>

		<!-- 申请认识：统一 XsaApplySheet（与社区同源） -->
		<XsaApplySheet
			:visible="applyVisible"
			:user-id="applyUserId"
			@close="applyVisible = false"
			@success="onApplySheetSuccess"
		/>

		<XsaModal :visible="successVisible" title="申请已送达" :icon="true" icon-type="success" cancel-text="查看申请" confirm-text="演示对方同意" @close="successVisible = false" @cancel="goMessages" @confirm="simulateMatch">
			<view class="apply-body">
				<text>平台已保护双方联系方式。只有双方都愿意，聊天才会开启。</text>
				<view class="apply-note">
					<text class="apply-desc">1. 申请已通过平台安全检查</text>
					<text class="apply-desc">2. 等待对方回应，通常在 24 小时内</text>
					<text class="apply-desc">3. 双方同意后开放聊天</text>
				</view>
			</view>
		</XsaModal>

		<XsaModal :visible="matchedVisible" title="你们都愿意认识彼此" :icon="true" icon-type="success" :show-cancel="false" confirm-text="开始聊天" @close="matchedVisible = false" @confirm="startChat">
			<view class="apply-body"><text>认真关系从一段真诚对话开始。请注意保护隐私与财产安全。</text></view>
		</XsaModal>

		<view v-if="blockVisible" class="block-mask" @tap="blockVisible = false">
			<view class="block-dialog" @tap.stop>
				<view class="block-dialog-title"><text class="block-success-icon">✓</text><text>您已将 {{ blockedUserName }} 拉入黑名单</text></view>
				<view class="block-dialog-card"><text class="block-dialog-note">黑名单中的人无法查看您的资料页</text><view class="blocked-user-row"><image :src="blockedUserAvatar" mode="aspectFill"></image><view class="blocked-user-info"><text>{{ blockedUserName }}</text><text>用户编号：{{ blockedUserId }}</text></view><view class="unblock-button" @tap="handleUnblock"><text>移除黑名单</text></view></view></view>
				<view class="block-back-button" @tap="blockVisible = false"><text>返回</text></view>
			</view>
		</view>

<!-- 自定义底部导航栏 -->

<XsaTabBar />

<!-- 每日查看配额用尽弹窗 -->
		<XsaModal
			:visible="quotaExhaustedVisible && !welcomeVisible"
			title="今日查看次数已用完"
			:show-cancel="false"
			confirm-text="开通会员"
			@close="quotaExhaustedVisible = false"
			@confirm="handleQuotaUpgrade"
		>
			<view class="apply-body">
				<text>{{ quotaExhaustedMessage }}</text>
			</view>
		</XsaModal>
		<XsaToast :visible="toastVisible" :message="toastMessage" @hide="toastVisible = false" />
	</view>
</template>

<script setup lang="uts">
	const systemInfo = uni.getSystemInfoSync()
	const statusBarHeight = systemInfo.statusBarHeight != null ? systemInfo.statusBarHeight : 20

	import XsaSheet from '@/components/XsaSheet.uvue'
	import XsaModal from '@/components/XsaModal.uvue'
	import XsaToast from '@/components/XsaToast.uvue'
	import XsaApplySheet from '@/components/XsaApplySheet.uvue'
	import XsaTabBar from '@/components/XsaTabBar.uvue'
	import XsaAiMatchSheet from '@/components/XsaAiMatchSheet.uvue'
	import { getEmotionLabSummary } from '@/api/emotionLab.uts'
	import { guardRealName } from '@/utils/realNameGate.uts'
	import { likeUser, blockUser, unblockUser, saveAiAvatarProfileSnapshot } from '@/api'
	import { getDiscoveryRecommendations, getDiscoveryPlaza, getDynamicList, getDynamicDetail, getUserDetail, getOwnProfile, getProfileCompletion } from '@/api'
	import { getMembershipPackages } from '@/api/discovery.uts'
	import { resolveMediaUrl, getAccessToken } from '@/api/config.uts'
	import locationJson from '@/data/location.json'
	import {
		recordProfileView,
		resetDailyIfNeeded,
		getDailyViewRemaining,
		getDailyViewQuota
	} from '@/utils/quota.uts'

	// ========== 欢迎页 ==========
	const welcomeVisible = ref(true)
	const welcomeAgreementVisible = ref(false)
	const WELCOME_AGREEMENT_KEY = 'xsa_welcome_agreed_v2'

	const showWelcomeService = () => { uni.showToast({ title: '客服功能将在完成登录后提供', icon: 'none' }) }
	const openWelcomeAgreement = () => { welcomeAgreementVisible.value = true }
	const closeWelcomeAgreement = () => { welcomeAgreementVisible.value = false }
	const openWelcomeDocument = (type: string) => {
		const url = type == 'privacy' ? '/pagesSub/about/article?type=privacy' : '/pagesSub/about/article?type=terms'
		uni.navigateTo({ url })
	}
	const acceptWelcomeAgreement = () => {
		uni.setStorageSync(WELCOME_AGREEMENT_KEY, true)
		uni.setStorageSync('xsa_welcome_agreed', true)
		uni.setStorageSync('xsa_login_agreed', true)
		uni.removeStorageSync('xsa_skip_welcome_once')
		welcomeAgreementVisible.value = false; welcomeVisible.value = false
		uni.navigateTo({ url: '/pages/auth/login' })
	}

	const routeParentMode = (): boolean => {
		const storedMode = uni.getStorageSync('xsa_onboarding_mode')
		if (storedMode == null || String(storedMode) != 'parent') return false
		uni.reLaunch({ url: '/pages/parent/parent' })
		return true
	}

	// ========== 导航 ==========
	const currentTab = ref(0)
	const navTabs = ['推荐', '广场', '会员专区']
	const switchTab = (index: number) => { currentTab.value = index }
	const openVipPage = () => {
		const redirect = '/pages/index/index?tab=' + currentTab.value
		uni.navigateTo({
			url: '/pagesSub/profileExtra/vip?redirect=' + encodeURIComponent(redirect),
			fail: () => { uni.showToast({ title: '会员页面打开失败，请重试', icon: 'none' }) }
		})
	}
	const openTopPlacement = () => {
		uni.navigateTo({
			url: '/pagesSub/userExtra/index/top-placement',
			fail: () => { uni.showToast({ title: '置顶页面打开失败，请重试', icon: 'none' }) }
		})
	}
	const onHistory = () => { uni.navigateTo({ url: '/pagesSub/profileExtra/history' }) }
	const onSearch = () => {
		uni.navigateTo({
			url: '/pagesSub/profileExtra/search',
			fail: () => uni.showToast({ title: '搜索页面打开失败，请重试', icon: 'none' })
		})
	}

	// ========== 推荐页数据 ==========
	const formatIncomeDisplay = (raw: any): string => {
		if (raw == null || raw === '') return '未填写'
		const text = '' + raw
		const amount = Number(text)
		if (!isNaN(amount) && text.trim() != '') {
			const wan = Math.round(amount / 1000) / 10
			return (wan % 1 == 0 ? '' + Math.round(wan) : '' + wan) + 'w'
		}
		return text.replace(/万/g, 'w')
	}
	const educationText = (raw: any): string => {
		const labels = ['', '博士', '硕士', '本科', '大专', '高中', '中专', '初中', '小学']
		if (raw == null || raw === '') return '未填写'
		const text = '' + raw
		const level = Number(text)
		if (!isNaN(level) && text.trim() != '') return level > 0 && level < labels.length ? labels[level] : '未填写'
		return text
	}
	const dimensionText = (raw: any, unit: string): string => {
		if (raw == null || raw === '' || Number(raw) <= 0) return '未填写'
		const text = '' + raw
		return text.endsWith(unit) ? text : text + unit
	}
	const zodiacFromBirthday = (birthday: any): string => {
		const value = birthday != null ? '' + birthday : ''
		if (value.length < 10) return ''
		const month = Number(value.substring(5, 7))
		const day = Number(value.substring(8, 10))
		const signs = ['摩羯座', '水瓶座', '双鱼座', '白羊座', '金牛座', '双子座', '巨蟹座', '狮子座', '处女座', '天秤座', '天蝎座', '射手座']
		const cutoffs = [20, 19, 21, 21, 21, 22, 23, 23, 23, 23, 22, 22]
		if (month < 1 || month > 12 || day < 1 || day > 31) return ''
		return signs[(day < cutoffs[month - 1] ? month - 1 : month) % 12]
	}
	const locationTextByCityCode = (rawCode: any): string => {
		const cityCode = rawCode != null ? '' + rawCode : ''
		if (cityCode == '') return '未填写'
		const provinces = Array.isArray(locationJson) ? locationJson as any[] : []
		for (const province of provinces) {
			const cities = Array.isArray(province.city) ? province.city as any[] : []
			for (const city of cities) if ('' + city.code == cityCode) return province.name + ' ' + city.name
		}
		return cityCode
	}
	const basicInfoRows = computed(() => [
		[
			{ label: '年龄', value: currentRecommendUser.value.age != null ? '' + currentRecommendUser.value.age + '岁' : '' },
			{ label: '身高', value: dimensionText(currentRecommendUser.value.height, 'cm') },
			{ label: '体重', value: dimensionText(currentRecommendUser.value.weight, 'kg') }
		],
		[
			{ label: '星座', value: currentRecommendUser.value.zodiac || '' },
			{ label: '学历', value: educationText(currentRecommendUser.value.education) },
			{ label: '职业', value: currentRecommendUser.value.job || '' }
		],
		[
			{ label: '现居', value: locationTextByCityCode(currentRecommendUser.value.city) },
			{ label: '家乡', value: currentRecommendUser.value.hometown || '未填写' },
			{ label: '收入', value: formatIncomeDisplay(currentRecommendUser.value.income) }
		]
	])

	// ========== 会员专区数据 ==========
	const vipCatIndex = ref(0)
	const switchVipCat = (index: number) => { vipCatIndex.value = index }

	// ========== 推荐页过滤 + 配额 ==========
	const recommendUsers = ref<any[]>([])
	const profileCompletion = ref(0)
	const profileCompletionLoaded = ref(false)
	const profileCompletionError = ref('')
	const discoveryError = ref('')
	const squareUsers = ref<any[]>([])
	const squareTotal = ref(0)
	const membershipPlans = ref<any[]>([])
	const planAt = (index: number): any => membershipPlans.value.length > index ? membershipPlans.value[index] : { duration: '', price: '' }
	const squareAt = (index: number): any => squareUsers.value.length > index ? squareUsers.value[index] : {}
	const vipSquareUsers = computed(() => squareUsers.value.filter((user: any) => user != null && (user.is_vip === true || user.isVip === true)))
	const vipSquareAt = (index: number): any => vipSquareUsers.value.length > index ? vipSquareUsers.value[index] : {}
	const vipUsersForCategory = computed(() => {
		if (vipCatIndex.value === 1) return vipSquareUsers.value.filter((user: any) => Number(user.income || 0) >= 300000)
		if (vipCatIndex.value === 2) return vipSquareUsers.value.filter((user: any) => Number(user.education_level || 0) > 0 && Number(user.education_level) <= 2)
		if (vipCatIndex.value === 3) return vipSquareUsers.value.filter((user: any) => Number(user.age || 0) >= 27 && Number(user.age || 0) <= 31)
		return vipSquareUsers.value
	})
	const toVipCard = (user: any): any => ({ id: Number(user.id || 0), name: user.name != null ? '' + user.name : '', age: user.age != null ? '' + user.age + '岁' : '', height: user.height != null ? '' + user.height + 'cm' : '', gender: user.gender != null ? '' + user.gender : '', photo: user.avatar != null ? '' + user.avatar : '' })
	const vipCardRows = computed(() => {
		const cards: any[] = []
		for (let i = 0; i < vipUsersForCategory.value.length && i < 9; i++) cards.push(toVipCard(vipUsersForCategory.value[i]))
		const rows: any[][] = []
		for (let i = 0; i < cards.length; i += 3) rows.push(cards.slice(i, Math.min(i + 3, cards.length)))
		return rows
	})
	const vipCardTotal = computed(() => vipUsersForCategory.value.length)
	const filteredRecommendUsers = computed(() => recommendUsers.value)
	const canShowRecommendUsers = computed(() => recommendUsers.value.length > 0)
	const currentRecommendIndex = ref(0)
	const recommendBackground = ref('')
	const currentRecommendUser = computed(() => {
		const list = filteredRecommendUsers.value as any[]
		if (list.length === 0) return { id: 0, name: '暂无推荐', age: 0, avatar: '', photos: [], education: '暂无数据', job: '', city: '', isVip: false }
		return list[currentRecommendIndex.value % list.length]
	})
	const loadRecommendBackground = async () => {
		const userId = Number(currentRecommendUser.value.id || 0)
		recommendBackground.value = ''
		if (userId <= 0) return
		const res = await getUserDetail(userId)
		if (!res.success || res.data == null) {
			if (Number(res.code) == 429) showQuotaExhausted(res.message != null ? '' + res.message : '')
			return
		}
		if (Number(currentRecommendUser.value.id || 0) != userId) return
		const detail = res.data as any
		const profile = detail.profile != null ? detail.profile : detail
		const current = currentRecommendUser.value as any
		const rawPhotos = profile.photos != null && Array.isArray(profile.photos) ? profile.photos as any[] : []
		const photos = rawPhotos.map((photo: any) => {
			if (photo != null && typeof photo === 'object') return resolveMediaUrl(photo.file_url != null ? photo.file_url : photo.url)
			return resolveMediaUrl(photo)
		}).filter((photo: string) => photo != '')
		const enriched = {
			...current,
			avatar: profile.avatar != null && profile.avatar != '' ? resolveMediaUrl(profile.avatar) : current.avatar,
			photos,
			height: profile.height != null ? Number(profile.height) : current.height,
			weight: profile.weight != null ? Number(profile.weight) : current.weight,
			education: educationText(profile.education_level != null ? profile.education_level : current.education),
			job: profile.occupation != null && profile.occupation != '' ? '' + profile.occupation : current.job,
			city: profile.residence_display != null && profile.residence_display != '' ? '' + profile.residence_display : locationTextByCityCode(current.city),
			hometown: profile.hometown_display != null && profile.hometown_display != '' ? '' + profile.hometown_display : (current.hometown != null && current.hometown != '' ? current.hometown : '未填写'),
			income: formatIncomeDisplay(profile.income_display != null && profile.income_display != '' ? profile.income_display : (profile.income != null ? profile.income : current.income)),
			zodiac: zodiacFromBirthday(profile.birthday) != '' ? zodiacFromBirthday(profile.birthday) : current.zodiac,
			bio: profile.self_intro != null && profile.self_intro != '' ? '' + profile.self_intro : current.bio
		}
		const currentIndex = currentRecommendIndex.value % recommendUsers.value.length
		if (currentIndex >= 0) recommendUsers.value.splice(currentIndex, 1, enriched)
		recommendBackground.value = resolveMediaUrl(profile.background_wall)
	}
	const loadProfileCompletion = async (): Promise<boolean> => {
		profileCompletionLoaded.value = false
		profileCompletionError.value = ''
		const response = await getProfileCompletion()
		if (response.success && response.data != null) {
			const data = response.data as any
			const score = Number(data.score != null ? data.score : data.completion_score)
			if (!isNaN(score)) {
				profileCompletion.value = Math.max(0, Math.min(100, score))
				profileCompletionLoaded.value = true
				return true
			}
		}
		const profileRes = await getOwnProfile()
		if (profileRes.success && profileRes.data != null) {
			const score = Number((profileRes.data as any).completion_score)
			if (!isNaN(score)) {
				profileCompletion.value = Math.max(0, Math.min(100, score))
				profileCompletionLoaded.value = true
				return true
			}
		}
		profileCompletionError.value = '请检查登录状态和网络后重试'
		return false
	}
	const loadHomeDiscovery = async () => {
		await loadProfileCompletion()
		discoveryError.value = ''
		const recommendRes = await getDiscoveryRecommendations({ page: 1, page_size: 20 })
		if (recommendRes != null && recommendRes.success && recommendRes.data != null) {
			recommendUsers.value = recommendRes.data.items as any[]
			currentRecommendIndex.value = 0
			loadRecommendBackground()
			loadFeedDynamics(Number(currentRecommendUser.value.id || 0))
		} else {
			recommendUsers.value = []
			recommendBackground.value = ''
			const message = recommendRes != null && recommendRes.message != null ? String(recommendRes.message).trim() : ''
			discoveryError.value = message != '' ? message : '请检查登录状态和网络后重试'
		}
		const plazaRes = await getDiscoveryPlaza({ page: 1, page_size: 20 })
		if (plazaRes.success && plazaRes.data != null) {
			squareUsers.value = plazaRes.data.items as any[]
			squareTotal.value = plazaRes.data.total != null ? Number(plazaRes.data.total) : squareUsers.value.length
		}
	}
	const loadMembershipPlans = async () => {
		const res = await getMembershipPackages()
		if (!res.success || res.data == null || !Array.isArray(res.data)) return
		const rows = res.data as any[]
		const plans: any[] = []
		for (let i = 0; i < rows.length; i++) {
			const row = rows[i]
			plans.push({ duration: row.duration_days != null ? '' + row.duration_days + '天' : '', price: row.price != null ? '¥' + row.price : '' })
		}
		membershipPlans.value = plans
	}
	const quotaExhaustedVisible = ref(false)
	const quotaExhaustedMessage = ref('')
	const showQuotaExhausted = (serverMessage: string = '') => {
		const message = serverMessage.trim()
		quotaExhaustedMessage.value = message != ''
			? message + '。开通会员可增加每日浏览额度。'
			: '今日完整浏览额度已用完，开通会员可增加每日浏览额度。'
		quotaExhaustedVisible.value = true
	}
	const handleQuotaUpgrade = () => { quotaExhaustedVisible.value = false; uni.navigateTo({ url: '/pagesSub/profileExtra/vip' }) }
	const switchToNextRecommend = () => {
		if (!recordProfileView()) { showQuotaExhausted(); return }
		const list = filteredRecommendUsers.value as any[]
		if (list.length === 0) return
			currentRecommendIndex.value = (currentRecommendIndex.value + 1) % list.length
		loadRecommendBackground()
		loadFeedDynamics(Number(currentRecommendUser.value.id || 0))
	}
	const blockVisible = ref(false)
	const blockedUserId = ref(0)
	const blockedUserName = ref('')
	const blockedUserAvatar = ref('')
	const openReportPage = () => {
		const user = currentRecommendUser.value as any
		const userId = user != null && user.id != null ? Number(user.id) : 0
		const userName = user != null && user.name != null ? '' + user.name : '该用户'
		uni.navigateTo({ url: '/pagesSub/profileExtra/report?userId=' + userId + '&userName=' + encodeURIComponent(userName), fail: () => showToast('举报页面打开失败，请重试') })
	}
	const handleBlockUser = async () => {
		const user = currentRecommendUser.value as any
		const userId = user != null && user.id != null ? Number(user.id) : 0
		blockedUserId.value = userId
		blockedUserName.value = user.name != null ? '' + user.name : '该用户'
		blockedUserAvatar.value = user.avatar != null ? '' + user.avatar : ''
		blockVisible.value = true
		if (userId <= 0) { showToast('当前为演示用户，已展示拉黑结果'); return }
		try {
			const res = await blockUser(userId)
			if (!res.success) showToast(res.message != null ? '' + res.message : '已显示拉黑结果，稍后同步')
		} catch (e) { showToast('已显示拉黑结果，网络恢复后同步') }
	}
	const handleUnblock = async () => {
		const res = await unblockUser(blockedUserId.value)
		if (res.success) { blockVisible.value = false; showToast('已移除黑名单') }
		else showToast('移除失败，请重试')
	}

	// 左滑换一个
	const touchStartX = ref(0)
	const touchStartY = ref(0)
	const onTouchStart = (e: any) => {
		const touch = e.touches != null && e.touches.length > 0 ? e.touches[0] : null
		if (touch != null) {
			touchStartX.value = touch.clientX
			touchStartY.value = touch.clientY
		}
	}
	const onTouchEnd = (e: any) => {
		const touch = e.changedTouches != null && e.changedTouches.length > 0 ? e.changedTouches[0] : null
		if (touch != null) {
			const deltaX = touchStartX.value - touch.clientX
			const deltaY = touchStartY.value - touch.clientY
			// 左滑（deltaX > 60）且水平位移大于垂直位移
			if (deltaX > 60 && Math.abs(deltaX) > Math.abs(deltaY)) {
				switchToNextRecommend()
			}
		}
	}

	// Ta的动态
	const feedDynamics = ref<any[]>([])
	const loadFeedDynamics = async (targetUserId: number = 0) => {
		if (targetUserId <= 0) {
			feedDynamics.value = []
			return
		}
		const res = await getDynamicList('discover', 1)
		if (!res.success || res.data == null) return
		const data = res.data as any
		const rows = data.list != null && Array.isArray(data.list) ? data.list as any[] : (data.items != null && Array.isArray(data.items) ? data.items as any[] : [])
		const mapped: any[] = []
		for (let i = 0; i < rows.length; i++) {
			const row = rows[i]
			const author = row.user != null ? row.user : {}
			const authorId = Number(author.id != null ? author.id : (author.userId != null ? author.userId : 0))
			if (authorId != targetUserId) continue
			mapped.push({ id: Number(row.id || 0), avatar: author.avatar != null ? resolveMediaUrl(author.avatar) : '', name: author.name != null ? author.name : '', timeText: row.timeText != null ? row.timeText : '', location: row.location != null ? row.location : '', content: row.content != null ? row.content : '', photos: row.photos != null && Array.isArray(row.photos) ? row.photos.map((photo: any) => resolveMediaUrl(photo)) : [], tags: row.tags != null && Array.isArray(row.tags) ? row.tags : [], likeCount: Number(row.likeCount || 0), commentCount: Number(row.commentCount || 0) })
		}
		// 列表统计可能是旧快照，详情接口返回单条动态的最新统计。
		for (let i = 0; i < mapped.length; i++) {
			const detailRes = await getDynamicDetail(Number(mapped[i].id || 0))
			if (!detailRes.success || detailRes.data == null) continue
			const detail = detailRes.data as any
			if (detail.likeCount != null) mapped[i].likeCount = Number(detail.likeCount)
			if (detail.commentCount != null) mapped[i].commentCount = Number(detail.commentCount)
		}
		feedDynamics.value = mapped
	}
		const viewAllFeed = () => { goUserDetailAnchored(recommendUserId.value, 'anchor-dynamics') }
		const goPostDetail = (postId: number) => {
			uni.navigateTo({ url: '/pagesSub/community/post-detail?id=' + postId })
		}

	// ========== AI 匹配度（MBTI 配对解析小窗） ==========
	const aiVisible = ref(false)
	const myMbti = ref('INFP')
	const myAvatar = ref('')
	const aiProfileLoaded = ref(false)

	// 自己的 MBTI 优先取情感实验室已确认的类型，头像取自己的资料
	const loadMyAiProfile = async () => {
		if (aiProfileLoaded.value) return
		try {
			const summaryRes = await getEmotionLabSummary()
			if (summaryRes.success && summaryRes.data != null) {
				const source = (summaryRes.data as any).profileSource
				const mbtiType = source != null && source.mbtiType != null ? '' + source.mbtiType : ''
				if (mbtiType.length == 4) myMbti.value = mbtiType.toUpperCase()
			}
		} catch (error) { }
		try {
			const profileRes = await getOwnProfile()
			if (profileRes.success && profileRes.data != null) {
				const data = profileRes.data as any
				const rawAvatar = data.avatar != null && data.avatar != '' ? '' + data.avatar : (data.profile != null && data.profile.avatar != null ? '' + data.profile.avatar : '')
				if (rawAvatar != '') myAvatar.value = resolveMediaUrl(rawAvatar)
			}
		} catch (error) { }
		aiProfileLoaded.value = true
	}

	const showAiScore = () => {
		aiVisible.value = true
		loadMyAiProfile()
	}

	const aiOtherName = computed((): string => {
		const user = currentRecommendUser.value as any
		return user.name != null ? '' + user.name : 'Ta'
	})
	const aiOtherAvatar = computed((): string => {
		const user = currentRecommendUser.value as any
		return user.avatar != null ? '' + user.avatar : ''
	})
	const aiOtherMbti = computed((): string => {
		const user = currentRecommendUser.value as any
		const mbti = user.mbti != null ? '' + user.mbti : ''
		return mbti.length == 4 ? mbti.toUpperCase() : 'ENTP'
	})
	const aiScore = computed((): number => {
		const user = currentRecommendUser.value as any
		const score = Number(user.matchScore || 0)
		return isNaN(score) ? 0 : score
	})

	const openAiAvatarForCurrentUser = () => {
		const user = currentRecommendUser.value as any
		const id = Number(user.id || 0)
		if (id <= 0) {
			showToast('暂无可聊天的AI分身')
			return
		}
		if (getAccessToken() == '') {
			showToast('请先登录后使用 AI 分身')
			setTimeout(() => { uni.navigateTo({ url: '/pages/auth/login' }) }, 350)
			return
		}
		try {
			const snapshotRes = saveAiAvatarProfileSnapshot(id, {
				id: id,
				name: user.name,
				avatar: user.avatar,
				age: user.age,
				city: user.city,
				job: user.job,
				education: user.education,
				tags: user.interestTags,
				intro: user.bio,
				expectations: [],
				dynamicSummary: feedDynamics.value.map((item: any) => '' + item.content)
			}, false)
			if (!snapshotRes.success) {
				showToast('公开资料读取失败')
				return
			}
		} catch (e) {
			showToast('公开资料读取失败')
			return
		}
		uni.navigateTo({
			url: '/pagesSub/chat/detail?mode=ai-avatar&userId=' + id + '&userName=' + encodeURIComponent(user.name != null ? '' + user.name : '') + '&locked=false',
			fail: () => { showToast('AI 分身打开失败，请重试') }
		})
	}

	// ========== 申请认识 ==========
	const applyVisible = ref(false)
	const applyUserId = ref(0)
	const successVisible = ref(false)
	const matchedVisible = ref(false)
	const toastVisible = ref(false)
	const toastMessage = ref('')

	const showToast = (m: string) => { toastMessage.value = m; toastVisible.value = true }

	const openApplyModal = async () => {
		const ok = await guardRealName('apply')
		if (!ok) return
		applyUserId.value = recommendUserId.value
		applyVisible.value = true
	}

	const onApplySheetSuccess = (payload: any) => {
		applyVisible.value = false
		// 产品规则：申请后不直接进入聊天
		successVisible.value = true
		if (payload != null && payload.code == 'ALREADY_PENDING') {
			showToast('申请已发送，请等待对方回应')
}
	}

	const goMessages = () => { successVisible.value = false; uni.switchTab({ url: '/pages/message/message' }) }
	const simulateMatch = () => { successVisible.value = false; matchedVisible.value = true }
	const startChat = () => { matchedVisible.value = false; const user = currentRecommendUser.value as any; uni.navigateTo({ url: '/pagesSub/chat/detail?userId=' + Number(user.id || 0) + '&userName=' + encodeURIComponent(user.name != null ? '' + user.name : '') }) }

	// ========== 通用操作 ==========
	const recommendUserId = computed(() => Number(currentRecommendUser.value.id || 0))
	const goUserDetail = (userId: number = 0) => {
		const id = Number(userId)
		if (id <= 0) return
		uni.navigateTo({ url: '/pagesSub/userExtra/user/detail?userId=' + id })
	}
	const goUserDetailAnchored = (userId: number = 0, anchor: string = '') => {
		const id = Number(userId)
		if (id <= 0) return
		const suffix = anchor != '' ? '&anchor=' + anchor : ''
		uni.navigateTo({ url: '/pagesSub/userExtra/user/detail?userId=' + id + suffix })
	}
	const firstMomentPhoto = computed((): string => {
		const photos = currentRecommendUser.value.photos as any[]
		return photos != null && photos.length > 0 ? '' + photos[0] : ''
	})
	const viewAllMoments = () => { goUserDetailAnchored(recommendUserId.value, 'anchor-moments') }
	const shareProfile = () => { showToast('已生成分享入口') }
	const likedUserIds = ref([] as number[])
	const isLiked = (userId: number): boolean => likedUserIds.value.indexOf(Number(userId)) >= 0
	const onLike = async (userId: number = 0) => {
		const id = userId > 0 ? userId : recommendUserId.value
		const ok = await guardRealName('like')
		if (!ok) return
		try {
			const res = await likeUser(id)
			if (res.success && res.data != null) {
				const liked = res.data.liked == true
				const idx = likedUserIds.value.indexOf(id)
				if (liked && idx < 0) likedUserIds.value.push(id)
				if (!liked && idx >= 0) likedUserIds.value.splice(idx, 1)
				showToast(liked ? '已收藏，仅你自己可见' : '已取消收藏')
			} else {
				showToast('操作失败，请重试')
			}
} catch (e) {
			showToast('操作失败，请重试')
}
	}

	// ========== 生命周期 ==========
	onMounted(() => {
		if (routeParentMode()) return
		const pages = getCurrentPages()
		const currentPage = pages[pages.length - 1]
		const options = currentPage.options
		const skipWelcomeOnce = uni.getStorageSync('xsa_skip_welcome_once') == true
		if (skipWelcomeOnce) uni.removeStorageSync('xsa_skip_welcome_once')
		welcomeVisible.value = !skipWelcomeOnce && (options.tab == null || options.tab == '')
		if (options.tab != null && options.tab != '') {
			const parsedTab = Number(options.tab)
			if (!isNaN(parsedTab) && parsedTab >= 0 && parsedTab < navTabs.length) {
				currentTab.value = parsedTab
			}
		}
		resetDailyIfNeeded()
		loadHomeDiscovery()
		loadMembershipPlans()
	})

	onShow(() => {
		const freshLaunch = uni.getStorageSync('xsa_new_app_launch') == true
		const skipWelcomeOnce = uni.getStorageSync('xsa_skip_welcome_once') == true
		if (freshLaunch) {
			uni.removeStorageSync('xsa_new_app_launch')
			if (skipWelcomeOnce) uni.removeStorageSync('xsa_skip_welcome_once')
			welcomeVisible.value = !skipWelcomeOnce
		} else if (skipWelcomeOnce) {
			uni.removeStorageSync('xsa_skip_welcome_once')
			welcomeVisible.value = false
		}
		if (!welcomeVisible.value) loadHomeDiscovery()
	})
</script>

<style scoped>
/* ============================================================
   欢迎页
   ============================================================ */
.welcome-screen { position: fixed; z-index: 60; top: 0; right: 0; bottom: 0; left: 0; overflow: hidden; background: var(--navy); }
.welcome-image, .welcome-scrim { position: absolute; top: 0; right: 0; bottom: 0; left: 0; width: 100%; height: 100%; }
.welcome-scrim { background: rgba(12, 19, 19, 0.28); }
.welcome-service { position: absolute; top: 48px; right: 20px; z-index: 1; padding: 8px 0; color: var(--text-invert); font-size: 14px; }
.welcome-copy { position: absolute; z-index: 1; top: 15%; left: 0; right: 0; display: flex; flex-direction: column; align-items: center; gap: 10px; color: var(--text-invert); }
.brand-mark { width: 52px; height: 52px; padding: 7px; background: var(--paper); border-radius: 12px; }
.brand-mark image { width: 100%; height: 100%; }
.welcome-title { font-family: var(--serif); font-size: 34px; font-weight: 700; }
.welcome-subtitle { font-family: var(--serif); font-size: 16px; }
.welcome-actions { position: absolute; z-index: 1; left: 12%; right: 12%; bottom: calc(40px + env(safe-area-inset-bottom)); }
.welcome-start-button { width: 100%; height: 50px; border-radius: 999px; border: 0; background: var(--accent2); color: var(--text-invert); font-weight: 800; font-size: 18px; line-height: 50px; }
.welcome-start-button:active { transform: scale(0.98); }
.agreement-mask { position: absolute; z-index: 2; top: 0; right: 0; bottom: 0; left: 0; display: flex; align-items: center; justify-content: center; padding: 20px; background: rgba(12, 19, 19, 0.36); }
.agreement-dialog { width: 100%; padding: 22px; background: var(--paper); border-radius: 12px; }
.agreement-title { display: block; margin-bottom: 12px; font-family: var(--serif); font-size: 20px; font-weight: 700; text-align: center; }
.agreement-copy { display: block; font-size: 14px; line-height: 1.7; color: var(--ink2); text-align: center; }
.agreement-links { display: flex; flex-direction: row; align-items: center; justify-content: center; margin-top: 2px; }
.agreement-link { color: var(--accent2); font-size: 14px; line-height: 1.7; }
.agreement-link-copy { color: var(--ink2); font-size: 14px; line-height: 1.7; }
.agreement-actions { display: flex; flex-direction: row; align-items: center; gap: 8px; margin-top: 18px; }
.agreement-cancel, .agreement-confirm { flex: 1; width: 0; min-width: 0; height: 44px; margin: 0; padding: 0 6px; border-radius: 999px; font-size: 14px; line-height: 44px; }
.agreement-cancel { border: 1px solid var(--line); background: var(--surface); color: var(--muted); }
.agreement-confirm { border: 1px solid var(--accent); background: var(--accent); color: var(--text-invert); }

/* ============================================================
   YYY 页面主体
   ============================================================ */
.page {
	position: relative;
	width: 100%;
	max-width: 750rpx;
	min-height: 100vh;
	margin: 0 auto;
	background-color: var(--bg-primary, #FAF8F5);
	display: flex;
	flex-direction: column;
	--accent: #7EC8A0;
	--accent-dark: #5BAF80;
	--accent-soft: #E8F5EE;
	--bg-primary: #FAF8F5;
	--bg-card: #FFFFFF;
	--bg-card-soft: #F5F9F2;
	--text-primary: #1A1A1A;
	--text-secondary: #5A6B5C;
	--text-muted: #A0B0A2;
	--text-inverse: #FFFFFF;
	--border-soft: #E8EDE6;
	--heart-red: #F08282;
	--gold: #C9A96E;
	--radius-sm: 12rpx;
	--radius-md: 24rpx;
	--radius-lg: 32rpx;
	--radius-xl: 40rpx;
	--radius-full: 9999rpx;
}


/* ==================== 导航栏 ==================== */
.nav-bar { display: flex; flex-direction: row; align-items: center; justify-content: space-between; padding: 0 40rpx 24rpx 40rpx; margin-right: -4rpx; }
.nav-tabs { display: flex; flex-direction: row; align-items: center; gap: 48rpx; }
.nav-tab-item { display: flex; flex-direction: column; align-items: center; gap: 12rpx; position: relative; }
.nav-tab-text { font-size: 28rpx; font-weight: 500; color: var(--text-muted); }
.nav-tab-text.active { font-size: 36rpx; font-weight: 700; color: var(--text-primary); }
.active-indicator { width: 40rpx; height: 6rpx; background-color: var(--accent); border-radius: 3rpx; }
.history-btn { width: 72rpx; height: 72rpx; border-radius: var(--radius-full); background-color: var(--bg-card-soft); display: flex; align-items: center; justify-content: center; margin-right: 184rpx; }
.history-icon { font-size: 32rpx; }

/* ==================== 筛选栏 ==================== */
.filter-bar { padding: 0 40rpx; }
.search-box { display: flex; flex-direction: row; align-items: center; gap: 16rpx; height: 80rpx; border-radius: var(--radius-xl); background-color: var(--bg-card); padding: 0 24rpx; }
.search-icon { font-size: 28rpx; opacity: 0.5; }
.search-placeholder { font-size: 26rpx; color: var(--text-muted); }

/* ==================== 滚动内容区 ==================== */

/* ==================== 个人资料卡 ==================== */
.profile-card { position: relative; display: flex; flex-direction: column; background-color: var(--bg-card); border-radius: 40rpx; box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.03); }
.cover-wrap { width: 100%; height: 440rpx; overflow: hidden; border-radius: 40rpx 40rpx 0 0; }
.card-body { display: flex; flex-direction: column; gap: 28rpx; padding: 32rpx; }
.cover-img { width: 100%; height: 100%; }
.user-info-header { display: flex; flex-direction: column; gap: 8rpx; padding-top: 8rpx; padding-left: 230rpx; }
.user-name-line { display: flex; flex-direction: row; align-items: center; gap: 12rpx; }
.recommend-vip-badge { display: flex; flex-direction: row; align-items: center; gap: 4rpx; padding: 5rpx 10rpx; border-radius: var(--radius-full); background-color: #FEF3D8; }
.recommend-vip-icon { color: var(--gold); font-size: 20rpx; }
.recommend-vip-text { color: var(--gold); font-size: 20rpx; font-weight: 700; }
.avatar-wrap { position: absolute; left: 30rpx; top: 348rpx; width: 184rpx; height: 184rpx; border-radius: 50%; overflow: hidden; border: 6rpx solid var(--bg-card); background-color: var(--bg-card-soft); z-index: 10; }
.avatar-img { width: 100%; height: 100%; }
.name-age { font-size: 44rpx; font-weight: 700; color: var(--text-primary); margin-top: 8rpx; }
.basic-line { display: flex; flex-direction: row; align-items: center; gap: 16rpx; }
.basic-text { font-size: 26rpx; color: var(--text-secondary); }
.dot-sep { width: 6rpx; height: 6rpx; border-radius: 50%; background-color: var(--text-muted); }
.online-row { display: flex; flex-direction: row; align-items: center; gap: 12rpx; }
.online-dot { width: 14rpx; height: 14rpx; border-radius: 50%; background-color: var(--accent); }
.online-text { font-size: 24rpx; color: var(--accent-dark); }
.online-row.offline .online-dot { background-color: var(--text-muted); }
.online-row.offline .online-text { color: var(--text-muted); }
.distance-text { font-size: 24rpx; color: var(--text-muted); }

/* 标签行 */
.tags-row { display: flex; flex-direction: row; flex-wrap: wrap; align-items: center; gap: 12rpx; }
.tag { display: flex; flex-direction: row; align-items: center; gap: 8rpx; padding: 8rpx 16rpx; border-radius: var(--radius-full); background-color: var(--bg-card-soft); }
.accent-tag { background-color: var(--accent-soft); }
.tag-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background-color: var(--accent); }
.tag-text-accent { font-size: 22rpx; font-weight: 600; color: var(--accent-dark); }
.tag-text { font-size: 22rpx; font-weight: 600; color: var(--text-secondary); }

/* 分割线 */
.divider { width: 100%; height: 2rpx; background-color: var(--border-soft); margin: 0; }

/* 关于我 */
.about-section { display: flex; flex-direction: column; gap: 20rpx; }
.section-title { font-size: 28rpx; font-weight: 700; color: var(--text-primary); }
.about-content { font-size: 26rpx; color: var(--text-secondary); line-height: 1.6; }

/* 认证信息 */
.cert-section { display: flex; flex-direction: row; align-items: center; gap: 16rpx; flex-wrap: wrap; }
.cert-label { font-size: 24rpx; color: var(--text-muted); }
.cert-tag { display: flex; flex-direction: row; align-items: center; gap: 8rpx; padding: 8rpx 16rpx; border-radius: 12rpx; background-color: var(--bg-card-soft); }
.cert-icon { font-size: 24rpx; }
.gold-icon { color: var(--gold); }
.cert-text { font-size: 22rpx; color: var(--text-secondary); }

/* AI匹配度 */
.match-section { display: flex; flex-direction: row; align-items: center; gap: 24rpx; padding: 24rpx; border-radius: var(--radius-md); background-color: var(--bg-card-soft); }
.match-ring { position: relative; width: 104rpx; height: 104rpx; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.ring-outer { position: absolute; top: 0; left: 0; width: 104rpx; height: 104rpx; border-radius: 50%; background-color: var(--accent-soft); display: flex; align-items: center; justify-content: center; }
.ring-inner { width: 84rpx; height: 84rpx; border-radius: 50%; background-color: var(--bg-card); }
.ring-percent { position: relative; z-index: 1; font-size: 30rpx; font-weight: 800; color: var(--accent-dark); }
.match-info { flex: 1; display: flex; flex-direction: column; gap: 8rpx; }
.match-title { font-size: 28rpx; font-weight: 700; color: var(--text-primary); }
.match-desc { font-size: 24rpx; color: var(--text-muted); }

/* 基础资料 */
.info-grid-section { display: flex; flex-direction: column; gap: 16rpx; }
.info-grid { display: flex; flex-direction: column; gap: 12rpx; }
.info-row { display: flex; flex-direction: row; gap: 12rpx; }
.info-item { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 4rpx; padding: 16rpx 0; border-radius: var(--radius-sm); background-color: var(--bg-primary); }
.info-label { font-size: 20rpx; color: var(--text-muted); }
.info-value { font-size: 26rpx; font-weight: 600; color: var(--text-primary); }

/* 照片区 */
.photos-section { display: flex; flex-direction: column; gap: 16rpx; }
.photo-large { width: 100%; height: 520rpx; border-radius: var(--radius-md); }
.qa-card { display: flex; flex-direction: column; gap: 8rpx; padding: 24rpx; border-radius: var(--radius-md); background-color: var(--bg-card-soft); }
.qa-question { font-size: 24rpx; font-weight: 700; color: var(--accent-dark); }
.qa-answer { font-size: 24rpx; color: var(--text-secondary); line-height: 1.5; }

/* 活跃信息 */
.activity-row { display: flex; flex-direction: row; justify-content: space-between; align-items: center; }
.activity-text { font-size: 24rpx; color: var(--text-muted); }
.viewed-text { font-size: 24rpx; color: var(--text-muted); }

/* 滚动区域底部留白 */
.scroll-bottom-spacer { height: 320rpx; }

/* ==================== 底部操作栏 ==================== */
.bottom-bar { position: fixed; bottom: 190rpx; left: 0; right: 0; display: flex; flex-direction: row; align-items: center; gap: 24rpx; padding: 24rpx 40rpx; z-index: 55; }
.share-btn { width: 88rpx; height: 88rpx; border-radius: 44rpx; background-color: var(--bg-card); display: flex; align-items: center; justify-content: center; flex-shrink: 0; box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04); }
.share-icon { font-size: 40rpx; font-weight: 700; color: var(--text-secondary); transform: rotate(-45deg); }
.chat-btn { flex: 1; height: 96rpx; border-radius: 48rpx; background-color: var(--accent); display: flex; flex-direction: row; align-items: center; justify-content: center; gap: 16rpx; }
.chat-icon { font-size: 36rpx; }
.chat-text { font-size: 30rpx; font-weight: 700; color: var(--text-inverse); }
.like-btn { width: 112rpx; height: 112rpx; border-radius: 56rpx; background-color: var(--bg-card); display: flex; align-items: center; justify-content: center; flex-shrink: 0; box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04); }
.heart-icon { font-size: 52rpx; }

/* ==================== AI悬浮按钮（液态玻璃·气泡低语，纯view+渐变绘制，不依赖clip-path/SVG） ==================== */
.ai-float-btn { position: fixed; right: 28rpx; bottom: 200rpx; width: 112rpx; height: 112rpx; border-radius: 56rpx; z-index: 10; }
.ai-float-glass { position: relative; width: 112rpx; height: 112rpx; border-radius: 56rpx; background: radial-gradient(circle at 24% 16%, rgba(255,255,255,0.95), rgba(255,255,255,0.22) 48%), rgba(255,255,255,0.30); border: 1px solid rgba(255,255,255,0.78); -webkit-backdrop-filter: blur(22px) saturate(150%); backdrop-filter: blur(22px) saturate(150%); box-shadow: inset 0 2rpx 0 rgba(255,255,255,0.95), inset 0 -14rpx 28rpx rgba(232,155,164,0.12), 0 21rpx 46rpx rgba(30, 90, 82, 0.24), 0 5rpx 14rpx rgba(0, 0, 0, 0.08); display: flex; align-items: center; justify-content: center; overflow: hidden; }
.ai-float-halo { position: absolute; left: 16%; right: 16%; bottom: 9%; height: 20%; border-radius: 50%; background: radial-gradient(ellipse at center, rgba(232,155,164,0.38), rgba(232,155,164,0)); }
.ai-float-bubble { position: relative; width: 50rpx; height: 38rpx; border-radius: 19rpx 19rpx 19rpx 5rpx; background: linear-gradient(140deg, #2D7C72 0%, #5FA99A 55%, #E89BA4 115%); box-shadow: 0 5rpx 14rpx rgba(30, 90, 82, 0.30), inset 0 2rpx 0 rgba(255,255,255,0.35); display: flex; flex-direction: row; align-items: center; justify-content: center; }
.ai-float-dot { width: 7rpx; height: 7rpx; border-radius: 4rpx; background: rgba(255,255,255,0.95); margin: 0 3rpx; animation: ai-float-blink 1.6s ease-in-out infinite; }
.ai-float-dot1 { animation-delay: 0s; }
.ai-float-dot2 { animation-delay: 0.25s; }
.ai-float-dot3 { animation-delay: 0.5s; }
@keyframes ai-float-blink { 0%, 70%, 100% { opacity: 0.45; transform: translateY(0); } 35% { opacity: 1; transform: translateY(-3rpx); } }

/* ==================== AI解读文案 ==================== */
.ai-interpret { display: flex; flex-direction: column; gap: 12rpx; padding: 24rpx; border-radius: var(--radius-md); background-color: var(--accent-soft); }
.ai-interpret-head { display: flex; flex-direction: row; align-items: center; gap: 10rpx; }
.ai-interpret-mark { font-size: 26rpx; color: var(--accent-dark); font-weight: 700; }
.ai-interpret-title { font-size: 26rpx; font-weight: 800; color: var(--accent-dark); }
.ai-interpret-text { font-size: 25rpx; color: var(--text-secondary); line-height: 1.7; }

/* ==================== 广场页面 ==================== */
.pinned-bar { display: flex; flex-direction: row; justify-content: space-between; align-items: center; padding: 32rpx 0 16rpx 0; }
.pinned-left { display: flex; flex-direction: row; align-items: center; gap: 16rpx; }
.pinned-flame { font-size: 36rpx; }
.pinned-title { font-size: 32rpx; font-weight: 700; color: var(--text-primary); }
.quality-badge { padding: 4rpx 12rpx; border-radius: 8rpx; background-color: #FEF3C7; }
.quality-text { font-size: 22rpx; font-weight: 600; color: #D97706; }
.want-top-btn { display: flex; flex-direction: row; align-items: center; gap: 8rpx; padding: 12rpx 28rpx; border-radius: var(--radius-full); background-color: var(--accent); }
.want-top-icon { font-size: 28rpx; color: var(--text-inverse); font-weight: 700; }
.want-top-text { font-size: 24rpx; color: var(--text-inverse); font-weight: 600; }

.square-feed { display: flex; flex-direction: column; gap: 28rpx; }
.square-empty-state { padding: 96rpx 24rpx; color: var(--text-muted); text-align: center; font-size: 26rpx; }
.square-user-card { display: flex; flex-direction: column; background-color: var(--bg-card); border-radius: var(--radius-xl); overflow: hidden; box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.03); }
.sq-photo-wrap { width: 100%; height: 440rpx; position: relative; overflow: hidden; }
.sq-photo { width: 100%; height: 100%; }
.vip-tag { position: absolute; top: 16rpx; left: 16rpx; display: flex; flex-direction: row; align-items: center; gap: 6rpx; padding: 6rpx 16rpx; border-radius: var(--radius-full); background-color: #C9A96E; }
.vip-tag-text { font-size: 22rpx; font-weight: 700; color: var(--text-inverse); }
.sq-card-info { display: flex; flex-direction: row; justify-content: space-between; align-items: center; padding: 24rpx; }
.sq-left-info { flex: 1; display: flex; flex-direction: column; gap: 8rpx; }
.sq-name-row { display: flex; flex-direction: row; align-items: center; gap: 16rpx; }
.sq-name { font-size: 32rpx; font-weight: 700; color: var(--text-primary); }
.sq-age { font-size: 26rpx; color: var(--text-secondary); }
.sq-meta-row { display: flex; flex-direction: row; align-items: center; gap: 12rpx; }
.sq-meta-text { font-size: 24rpx; color: var(--text-muted); }
.sq-dot { width: 6rpx; height: 6rpx; border-radius: 50%; background-color: var(--text-muted); }
.sq-like-btn { width: 80rpx; height: 80rpx; border-radius: 50%; background-color: #FFF0F0; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.sq-heart { font-size: 40rpx; }

.sq-section { display: flex; flex-direction: column; gap: 24rpx; }
.sq-section-header { display: flex; flex-direction: row; justify-content: space-between; align-items: center; }
.sq-section-title-group { display: flex; flex-direction: row; align-items: center; gap: 16rpx; }
.sq-section-icon { font-size: 36rpx; }
.sq-section-title { font-size: 30rpx; font-weight: 700; color: var(--gold); }
.sq-section-count { font-size: 24rpx; color: var(--gold); font-weight: 500; }
.sq-section-more { font-size: 24rpx; color: var(--text-muted); }
.sq-section-empty { padding: 12rpx 0 4rpx; color: var(--text-muted); font-size: 24rpx; text-align: center; }
.sq-vip-row { display: flex; flex-direction: row; gap: 24rpx; }
.sq-vip-mini { position: relative; flex: 1; display: flex; flex-direction: column; background-color: var(--bg-card); border-radius: var(--radius-xl); overflow: hidden; box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.03); }
.sq-vip-photo { width: 100%; height: 320rpx; }
.sq-vip-tag { top: 12rpx; left: 12rpx; }
.sq-vip-info { display: flex; flex-direction: row; justify-content: space-between; align-items: center; padding: 20rpx; }
.sq-vip-left { display: flex; flex-direction: column; gap: 4rpx; }
.sq-vip-name { font-size: 28rpx; font-weight: 600; color: var(--text-primary); }
.sq-vip-detail { font-size: 22rpx; color: var(--text-muted); }
.sq-vip-like { position: relative; z-index: 5; width: 64rpx; height: 64rpx; border-radius: 50%; background-color: #FFF0F0; display: flex; align-items: center; justify-content: center; }
.sq-heart-sm { font-size: 32rpx; }

/* ==================== 会员专区页面 ==================== */
.vip-hero { display: flex; flex-direction: column; justify-content: center; gap: 16rpx; height: 320rpx; padding: 40rpx 48rpx; background: linear-gradient(135deg, #2D4A3E, #1A3328); border-radius: var(--radius-xl); margin-bottom: 24rpx; }
.vip-hero-gold-line { width: 120rpx; height: 6rpx; background-color: var(--gold); border-radius: 3rpx; }
.vip-hero-content { display: flex; flex-direction: column; gap: 16rpx; }
.vip-hero-title { font-size: 44rpx; font-weight: 700; color: var(--text-inverse); }
.vip-hero-subtitle { font-size: 26rpx; color: #C9D5CA; }
.vip-hero-badges { display: flex; flex-direction: row; gap: 32rpx; padding-top: 24rpx; }
.vip-hero-badge { display: flex; flex-direction: row; align-items: center; gap: 12rpx; }
.vip-hero-badge-icon { font-size: 28rpx; color: var(--gold); }
.vip-hero-badge-text { font-size: 24rpx; color: #C9D5CA; }

.vip-cat-tabs { display: flex; flex-direction: row; background-color: var(--bg-card); border-radius: var(--radius-lg); padding: 0 8rpx; margin-bottom: 24rpx; }
.vip-cat-tab { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 16rpx; padding: 28rpx 0 20rpx 0; }
.vip-cat-tab-text { font-size: 26rpx; font-weight: 500; color: var(--text-muted); }
.vip-cat-tab-text.active { font-size: 28rpx; font-weight: 700; color: var(--text-primary); }
.vip-cat-indicator { width: 48rpx; height: 6rpx; background-color: var(--accent); border-radius: 3rpx; }

.vip-filter-row { display: flex; flex-direction: row; justify-content: space-between; align-items: center; padding: 24rpx 0; }
.vip-result-count { font-size: 28rpx; font-weight: 600; color: var(--text-primary); }
.vip-filter-right { display: flex; flex-direction: row; align-items: center; gap: 16rpx; }
.vip-accelerate-btn { display: flex; flex-direction: row; align-items: center; gap: 8rpx; padding: 10rpx 20rpx; border-radius: var(--radius-full); background-color: var(--accent); }
.vip-accel-icon { font-size: 24rpx; color: var(--text-inverse); }
.vip-accel-text { font-size: 24rpx; color: var(--text-inverse); font-weight: 600; }

.vip-card-grid { display: flex; flex-direction: column; gap: 20rpx; }
.vip-card-row { display: flex; flex-direction: row; gap: 20rpx; }
.vip-card-item { flex: 1; display: flex; flex-direction: column; background-color: var(--bg-card); border-radius: var(--radius-lg); overflow: hidden; box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.03); }
.vip-card-content { position: relative; display: flex; flex-direction: column; }
.vip-card-photo { width: 100%; height: 280rpx; position: relative; overflow: hidden; }
.vip-card-photo-img { width: 100%; height: 100%; }
.vip-card-crown { position: absolute; top: 12rpx; left: 12rpx; display: flex; align-items: center; padding: 4rpx 10rpx; border-radius: var(--radius-sm); background-color: #C9A96E; }
.vip-card-crown-icon { font-size: 16rpx; }
.vip-card-gender { position: absolute; top: 12rpx; right: 12rpx; display: flex; align-items: center; padding: 4rpx 10rpx; border-radius: var(--radius-sm); }
.vip-card-gender.female { background-color: #FFE4E6; }
.vip-card-gender.male { background-color: #DBEAFE; }
.vip-gender-icon { font-size: 20rpx; font-weight: 700; }
.vip-gender-icon.female { color: #E11D48; }
.vip-gender-icon.male { color: #2563EB; }
.vip-card-bottom { display: flex; flex-direction: column; gap: 8rpx; padding: 20rpx; }
.vip-card-name { font-size: 28rpx; font-weight: 600; color: var(--text-primary); }
.vip-card-meta { display: flex; flex-direction: row; align-items: center; gap: 8rpx; }
.vip-card-age { font-size: 24rpx; color: var(--text-secondary); }
.vip-card-dot { width: 4rpx; height: 4rpx; border-radius: 50%; background-color: var(--text-muted); }
.vip-card-height { font-size: 24rpx; color: var(--text-secondary); }

.vip-privilege-section { display: flex; flex-direction: column; gap: 24rpx; padding: 32rpx 16rpx; }
.vip-priv-header { display: flex; flex-direction: row; justify-content: space-between; align-items: center; }
.vip-priv-title { font-size: 30rpx; font-weight: 700; color: var(--text-primary); }
.vip-upgrade-btn { display: flex; flex-direction: row; align-items: center; gap: 8rpx; padding: 16rpx 32rpx; border-radius: var(--radius-full); background-color: var(--accent); }
.vip-upgrade-icon { font-size: 28rpx; }
.vip-upgrade-text { font-size: 26rpx; font-weight: 600; color: var(--text-inverse); }
.vip-priv-row { display: flex; flex-direction: row; gap: 20rpx; }
.vip-priv-title-group { display: flex; flex-direction: column; gap: 6rpx; }
.vip-priv-subtitle { font-size: 22rpx; color: var(--text-muted); }
.vip-priv-card { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 16rpx; padding: 28rpx; border-radius: var(--radius-lg); background-color: var(--bg-card); box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.03); }
.vip-priv-icon-circle { width: 88rpx; height: 88rpx; border-radius: 50%; background-color: #FEF9F0; display: flex; align-items: center; justify-content: center; }
.vip-priv-icon-text { font-size: 44rpx; }
.vip-priv-card-title { font-size: 26rpx; font-weight: 600; color: var(--text-primary); }
.vip-priv-card-desc { font-size: 22rpx; color: var(--text-muted); text-align: center; }

.vip-spotlight { display: flex; flex-direction: column; gap: 24rpx; padding: 32rpx 16rpx; }
.vip-spot-header { display: flex; flex-direction: row; justify-content: space-between; align-items: center; }
.vip-spot-title-group { display: flex; flex-direction: row; align-items: center; gap: 16rpx; }
.vip-spot-icon { font-size: 36rpx; }
.vip-spot-title { font-size: 30rpx; font-weight: 700; color: var(--text-primary); }
.vip-spot-count { font-size: 24rpx; color: var(--gold); font-weight: 600; }
.vip-spot-more { font-size: 24rpx; color: var(--text-muted); }
.vip-spot-desc { font-size: 24rpx; color: var(--text-muted); line-height: 1.5; }
.vip-spot-row { display: flex; flex-direction: row; gap: 20rpx; }
.vip-spot-card { flex: 1; display: flex; flex-direction: column; background-color: var(--bg-card); border-radius: var(--radius-lg); overflow: hidden; box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.03); }
.vip-spot-photo { width: 100%; height: 200rpx; overflow: hidden; background-color: var(--bg-card-soft); display: flex; align-items: center; justify-content: center; }
.vip-spot-photo-img { width: 100%; height: 100%; }
.vip-spot-photo-icon { font-size: 64rpx; color: var(--text-muted); }
.vip-spot-info { display: flex; flex-direction: column; gap: 4rpx; padding: 20rpx; }
.vip-spot-name { font-size: 26rpx; font-weight: 600; color: var(--text-primary); }
.vip-spot-age { font-size: 22rpx; color: var(--text-muted); }

.vip-bottom-cta { display: flex; flex-direction: column; align-items: center; gap: 20rpx; padding: 40rpx 32rpx 48rpx 32rpx; background: linear-gradient(135deg, #2D4A3E, #C9A96E); border-radius: var(--radius-xl); }
.vip-cta-title { font-size: 36rpx; font-weight: 700; color: #FFFFFF; }
.vip-cta-desc { font-size: 24rpx; color: #CCCCCC; text-align: center; line-height: 1.5; }
.vip-price-row { display: flex; flex-direction: row; gap: 16rpx; width: 100%; padding-top: 24rpx; }
.vip-price-opt { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 8rpx; padding: 28rpx 16rpx 16rpx 16rpx; border-radius: var(--radius-md); background-color: rgba(255, 255, 255, 0.1); position: relative; overflow: visible; }
.vip-price-opt.recommended { background-color: rgba(201, 169, 110, 0.2); border: 2rpx solid var(--gold); }
.vip-price-badge { position: absolute; top: -20rpx; left: 50%; transform: translateX(-50%); padding: 6rpx 18rpx; border-radius: var(--radius-sm); background-color: var(--gold); white-space: nowrap; z-index: 2; }
.vip-price-badge-text { font-size: 20rpx; color: #FFFFFF; font-weight: 600; line-height: 1.2; }
.vip-price-period { font-size: 24rpx; color: #CCCCCC; }
.vip-price-value { font-size: 36rpx; font-weight: 700; color: var(--gold); }
.vip-cta-btn { width: 100%; height: 96rpx; border-radius: 48rpx; background-color: var(--accent); display: flex; align-items: center; justify-content: center; }
.vip-cta-btn-text { font-size: 30rpx; font-weight: 700; color: #FFFFFF; }
.vip-cta-hint { font-size: 22rpx; color: #888888; text-align: center; }

/* ============================================================
   AI Sheet（已迁移至 components/XsaAiMatchSheet.uvue）
   ============================================================ */

/* ============================================================
   Modal
   ============================================================ */
.apply-body { display: flex; flex-direction: column; gap: 10px; }
.apply-desc { font-size: 12px; line-height: 1.6; color: var(--muted); }
.apply-note { padding: 10px; background: var(--warm); border-radius: 8px; font-size: 11px; }
.apply-note .em { color: var(--accent2); font-weight: 800; }
.apply-input { width: 100%; min-height: 72px; padding: 10px; border: 1px solid var(--line); border-radius: 8px; font-size: 12px; }

/* 固定头部 */
.sticky-header { position: fixed; top: 0; left: 0; right: 0; z-index: 20; max-width: 750rpx; margin: 0 auto; background-color: var(--bg-primary); }
.content-scroll { flex: 1; padding: 254rpx 32rpx 0 32rpx; }
.completion-reminder { margin-top: 28rpx; padding: 28rpx; display: flex; flex-direction: column; border: 1rpx solid var(--line); border-radius: 24rpx; background-color: var(--bg-card-soft); }
.completion-reminder-error { background-color: var(--warm); }
.completion-reminder-title { color: var(--text-primary); font-size: 28rpx; font-weight: 700; }
.completion-reminder-copy { margin-top: 10rpx; color: var(--text-secondary); font-size: 24rpx; line-height: 1.6; }
.completion-reminder .completion-gate-button { margin-top: 22rpx; }
.completion-gate { margin-top: 28rpx; padding: 64rpx 40rpx; display: flex; flex-direction: column; align-items: center; border-radius: 32rpx; background-color: var(--bg-card); box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.03); text-align: center; }
.completion-gate-mark { width: 128rpx; height: 128rpx; display: flex; align-items: center; justify-content: center; border: 10rpx solid var(--accent); border-radius: 50%; color: var(--accent-dark); font-size: 30rpx; font-weight: 800; box-sizing: border-box; }
.completion-gate-title { margin-top: 32rpx; color: var(--text-primary); font-size: 32rpx; font-weight: 700; }
.completion-gate-copy { margin-top: 18rpx; color: var(--text-secondary); font-size: 25rpx; line-height: 1.7; }
.completion-gate-progress { width: 100%; height: 12rpx; margin-top: 36rpx; overflow: hidden; border-radius: 6rpx; background-color: var(--bg-card-soft); }
.completion-gate-fill { height: 100%; border-radius: 6rpx; background-color: var(--accent); }
.completion-gate-button { width: 100%; height: 88rpx; margin-top: 36rpx; display: flex; align-items: center; justify-content: center; border-radius: 44rpx; background-color: var(--accent); color: var(--text-inverse); font-size: 28rpx; font-weight: 700; }
/* 屏蔽/举报行 */
.block-row { display: flex; flex-direction: row; justify-content: center; align-items: center; width: 100%; padding: 16rpx 0 8rpx 0; }
.block-action { display: flex; flex-direction: row; align-items: center; justify-content: center; padding: 10rpx 18rpx; }
.block-text { display: block; flex-shrink: 0; white-space: nowrap; font-size: 24rpx; color: var(--text-muted); }
.block-divider { margin: 0 12rpx; font-size: 22rpx; color: var(--line); }
.block-mask { position: fixed; z-index: 80; top: 0; right: 0; bottom: 0; left: 0; display: flex; align-items: center; justify-content: center; padding: 30px; background: rgba(0,0,0,.58); }
.block-dialog { width: 100%; padding: 28px 22px 22px; border-radius: 24px; background: linear-gradient(135deg, var(--paper), var(--accent-bg)); box-sizing: border-box; }
.block-dialog-title { display: flex; flex-direction: row; align-items: center; justify-content: center; gap: 6px; font-size: 20px; font-weight: 800; color: var(--ink); text-align: center; }
.block-success-icon { width: 28px; height: 28px; border-radius: 14px; display: flex; align-items: center; justify-content: center; background: var(--accent); color: var(--text-invert); font-size: 18px; }
.block-dialog-card { margin-top: 26px; padding: 18px 14px; border-radius: 10px; background: rgba(255,255,255,.82); }
.block-dialog-note { display: block; text-align: center; font-size: 13px; color: var(--muted); }
.blocked-user-row { display: flex; flex-direction: row; align-items: center; gap: 10px; margin-top: 16px; }
.blocked-user-row image { width: 48px; height: 48px; border-radius: 8px; flex-shrink: 0; }
.blocked-user-info { flex: 1; display: flex; flex-direction: column; gap: 5px; font-size: 14px; color: var(--ink); }
.blocked-user-info text:last-child { font-size: 12px; color: var(--muted); }
.unblock-button { padding: 10px 8px; border: 2px solid var(--accent2); border-radius: 6px; color: var(--accent2); font-size: 12px; white-space: nowrap; }
.block-back-button { height: 48px; margin-top: 22px; border-radius: 24px; display: flex; align-items: center; justify-content: center; background: linear-gradient(90deg, var(--accent), var(--accent2)); color: var(--text-invert); font-size: 18px; font-weight: 800; }
/* 底部操作栏 */

.ai-float-btn { z-index: 55; bottom: 360rpx; }
/* Ta的动态 */
.feed-section { display: flex; flex-direction: column; gap: 20rpx; }
.feed-section-header { display: flex; flex-direction: row; justify-content: space-between; align-items: center; }
.feed-more { font-size: 22rpx; font-weight: 500; color: var(--accent-dark); }
.feed-list { display: flex; flex-direction: column; gap: 24rpx; }
.feed-card { display: flex; flex-direction: column; background-color: var(--bg-card); border-radius: var(--radius-lg); box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.02); overflow: hidden; }
.feed-card-header { display: flex; flex-direction: row; align-items: center; gap: 20rpx; padding: 28rpx 28rpx 12rpx 28rpx; }
.feed-card-avatar { width: 64rpx; height: 64rpx; border-radius: 50%; background-color: var(--bg-card-soft); }
.feed-card-user-col { flex: 1; display: flex; flex-direction: column; gap: 2rpx; }
.feed-card-name { font-size: 26rpx; font-weight: 700; color: var(--text-primary); }
.feed-card-meta { font-size: 20rpx; color: var(--text-muted); }
.feed-card-content { padding: 0 28rpx 16rpx 28rpx; font-size: 24rpx; color: var(--text-secondary); line-height: 1.55; }
.feed-card-photos { display: flex; flex-direction: row; gap: 10rpx; padding: 0 28rpx 16rpx 28rpx; }
.feed-photo { border-radius: var(--radius-sm); background-color: var(--bg-card-soft); }
.feed-photo-single { width: 100%; height: 320rpx; }
.feed-photo-double { flex: 1; height: 220rpx; }
.feed-card-tags { display: flex; flex-direction: row; gap: 12rpx; padding: 0 28rpx 8rpx 28rpx; }
.feed-tag { padding: 8rpx 24rpx; border-radius: var(--radius-full); background-color: var(--bg-card-soft); font-size: 20rpx; font-weight: 500; color: var(--accent-dark); }
.feed-card-divider { width: 100%; height: 2rpx; background-color: var(--border-soft); }
.feed-card-footer { display: flex; flex-direction: row; justify-content: space-between; align-items: center; padding: 16rpx 28rpx 20rpx 28rpx; }
.feed-date { font-size: 20rpx; color: var(--text-muted); }
.feed-actions { display: flex; flex-direction: row; align-items: center; gap: 28rpx; }
.feed-action { display: flex; flex-direction: row; align-items: center; gap: 8rpx; }
.feed-action-icon { font-size: 26rpx; color: var(--text-muted); }
.feed-action-count { font-size: 20rpx; color: var(--text-muted); }
/* 内联图标 */
.sq-loc-icon { font-size: 24rpx; color: var(--text-muted); margin-right: 2rpx; }
.sq-arrow { font-size: 22rpx; color: var(--text-muted); }
.activity-dot { font-size: 24rpx; color: var(--accent); margin-right: 4rpx; }
.vip-tag-icon { font-size: 24rpx; color: var(--text-inverse); margin-right: 4rpx; }
.vip-cta-icon { font-size: 36rpx; color: var(--gold); margin-right: 8rpx; }

