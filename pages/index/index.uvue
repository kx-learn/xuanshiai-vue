								</view>
								<view class="sq-meta-row">
									<text class="sq-meta-text"><text class="ic ic-home ic-dingwei sq-loc-icon"></text> 距你 {{ squareAt(4).distance }}km</text>
									<view class="sq-dot"></view>
									<text class="sq-meta-text">{{ squareAt(4).job }} · {{ squareAt(4).city }}</text>
								</view>
							</view>
							<view class="sq-like-btn" @click.stop="onLike(squareAt(4).id)">
								<text v-if="isLiked(squareAt(4).id)" class="sq-heart heart-font heart-solid"></text>
								<text v-else class="sq-heart heart-font heart-outline"></text>
							</view>
						</view>
					</view>

					<view v-if="squareUsers.length > 5" class="square-user-card" @tap="goUserDetail(squareAt(5).id)">
						<view class="sq-photo-wrap">
							<image class="sq-photo" :src="squareAt(5).avatar" mode="aspectFill"></image>
						</view>
						<view class="sq-card-info">
							<view class="sq-left-info">
								<view class="sq-name-row">
									<text class="sq-name">{{ squareAt(5).name }}</text>
									<text class="sq-age">{{ squareAt(5).age }}岁</text>
								</view>
								<view class="sq-meta-row">
									<text class="sq-meta-text"><text class="ic ic-home ic-dingwei sq-loc-icon"></text> 距你 {{ squareAt(5).distance }}km</text>
									<view class="sq-dot"></view>
									<text class="sq-meta-text">{{ squareAt(5).job }} · {{ squareAt(5).city }}</text>
								</view>
							</view>
							<view class="sq-like-btn" @click.stop="onLike(squareAt(5).id)">
								<text v-if="isLiked(squareAt(5).id)" class="sq-heart heart-font heart-solid"></text>
								<text v-else class="sq-heart heart-font heart-outline"></text>
							</view>
						</view>
					</view>

					<view class="sq-section">
						<view class="sq-section-header">
							<view class="sq-section-title-group">
								<text class="ic ic-vip ic-huiyuan sq-section-icon"></text>
								<text class="sq-section-title">高收入专区</text>
						<text class="sq-section-count"></text>
							</view>
							<text class="sq-section-more">查看全部 ›</text>
						</view>
						<view class="sq-vip-row">
							<view v-if="squareUsers.length > 6" class="sq-vip-mini" @tap="goUserDetail(squareAt(6).id)">
								<view class="sq-vip-content">
									<image class="sq-vip-photo" :src="squareAt(6).avatar" mode="aspectFill"></image>
									<view v-if="squareAt(6).is_vip === true || squareAt(6).isVip === true" class="vip-tag sq-vip-tag"><text class="ic ic-vip ic-huiyuan vip-tag-icon"></text><text class="vip-tag-text"> VIP</text></view>
									<view class="sq-vip-info">
										<view class="sq-vip-left">
											<text class="sq-vip-name">{{ squareAt(6).name }}</text>
											<text class="sq-vip-detail">{{ squareAt(6).age }}岁 · {{ squareAt(6).height }}cm</text>
										</view>
										<view class="sq-vip-like" @tap.stop="onLike(squareAt(6).id)"><text v-if="isLiked(squareAt(6).id)" class="sq-heart-sm heart-font heart-solid"></text><text v-else class="sq-heart-sm heart-font heart-outline"></text></view>
									</view></view>
							</view>
							<view v-if="squareUsers.length > 7" class="sq-vip-mini" @tap="goUserDetail(squareAt(7).id)">
								<view class="sq-vip-content">
									<image class="sq-vip-photo" :src="squareAt(7).avatar" mode="aspectFill"></image>
									<view v-if="squareAt(7).is_vip === true || squareAt(7).isVip === true" class="vip-tag sq-vip-tag"><text class="ic ic-vip ic-huiyuan vip-tag-icon"></text><text class="vip-tag-text"> VIP</text></view>
									<view class="sq-vip-info">
										<view class="sq-vip-left">
											<text class="sq-vip-name">{{ squareAt(7).name }}</text>
											<text class="sq-vip-detail">{{ squareAt(7).age }}岁 · {{ squareAt(7).height }}cm</text>
										</view>
										<view class="sq-vip-like" @tap.stop="onLike(squareAt(7).id)"><text v-if="isLiked(squareAt(7).id)" class="sq-heart-sm heart-font heart-solid"></text><text v-else class="sq-heart-sm heart-font heart-outline"></text></view>
									</view></view>
							</view>
						</view>
						<text v-if="squareUsers.length < 7" class="sq-section-empty">暂无高收入专区资料</text>
					</view>

					<view class="sq-section">
						<view class="sq-section-header">
							<view class="sq-section-title-group">
								<text class="ic ic-vip ic-huiyuan sq-section-icon"></text>
								<text class="sq-section-title">高学历专区</text>
								<text class="sq-section-count"></text>
							</view>
							<text class="sq-section-more">查看全部 ›</text>
						</view>
						<text v-if="squareUsers.length < 9" class="sq-section-empty">暂无高学历专区资料</text>
					</view>

					<view v-if="squareUsers.length > 8" class="square-user-card" @tap="goUserDetail(squareAt(8).id)">
						<view class="sq-photo-wrap">
							<image class="sq-photo" :src="squareAt(8).avatar" mode="aspectFill"></image>
						</view>
						<view class="sq-card-info">
							<view class="sq-left-info">
								<view class="sq-name-row">
									<text class="sq-name">{{ squareAt(8).name }}</text>
									<text class="sq-age">{{ squareAt(8).age }}岁</text>
								</view>
								<view class="sq-meta-row">
									<text class="sq-meta-text"><text class="ic ic-home ic-dingwei sq-loc-icon"></text> 距你 {{ squareAt(8).distance }}km</text>
									<view class="sq-dot"></view>
									<text class="sq-meta-text">{{ squareAt(8).job }} · {{ squareAt(8).city }}</text>
								</view>
							</view>
							<view class="sq-like-btn" @click.stop="onLike(squareAt(8).id)">
								<text v-if="isLiked(squareAt(8).id)" class="sq-heart heart-font heart-solid"></text>
								<text v-else class="sq-heart heart-font heart-outline"></text>
							</view>
						</view>
					</view>

					<view v-if="squareUsers.length > 9" class="square-user-card" @tap="goUserDetail(squareAt(9).id)">
						<view class="sq-photo-wrap">
							<image class="sq-photo" :src="squareAt(9).avatar" mode="aspectFill"></image>
						</view>
						<view class="sq-card-info">
							<view class="sq-left-info">
								<view class="sq-name-row">
									<text class="sq-name">{{ squareAt(9).name }}</text>
									<text class="sq-age">{{ squareAt(9).age }}岁</text>
								</view>
								<view class="sq-meta-row">
									<text class="sq-meta-text"><text class="ic ic-home ic-dingwei sq-loc-icon"></text> 距你 {{ squareAt(9).distance }}km</text>
									<view class="sq-dot"></view>
									<text class="sq-meta-text">{{ squareAt(9).job }} · {{ squareAt(9).city }}</text>
								</view>
							</view>
							<view class="sq-like-btn" @click.stop="onLike(squareAt(9).id)">
								<text v-if="isLiked(squareAt(9).id)" class="sq-heart heart-font heart-solid"></text>
								<text v-else class="sq-heart heart-font heart-outline"></text>
							</view>
						</view>
