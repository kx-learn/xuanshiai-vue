<template>
	<view class="community-page">
		<!-- 主 Tab：关注 / 同城 / 发现；关注页「喜欢」= 喜欢用户的动态 -->
		<view class="subtabs">
			<view class="subtab" :class="{ active: currentTab === 'follow' }" @click="switchTab('follow')">
				<text>关注</text>
			</view>
			<view class="subtab" :class="{ active: currentTab === 'city' }" @click="switchTab('city')">
				<text>同城</text>
			</view>
			<view class="subtab" :class="{ active: currentTab === 'discover' }" @click="switchTab('discover')">
				<text>发现</text>
			</view>
			<view class="notify-chip" @click="openNotifications">
				<text class="notify-text">通知</text>
				<view class="badge" v-if="unreadCount > 0">
					<text class="badge-text">{{ unreadCount > 99 ? '99+' : unreadCount }}</text>
				</view>
			</view>
		</view>

		<!-- 二级筛选 -->
		<view class="filter-row">
			<view
				class="filter-chip"
				:class="{ active: currentFilter === f.key }"
				v-for="f in filterOptions"
				:key="f.key"
				@click="switchFilter(f.key)"
			>
				<text>{{ f.label }}</text>
			</view>
		</view>

		<scroll-view class="dynamic-list" scroll-y @scrolltolower="handleLoadMore">
			<!-- 发现·全部：TOPIC / 活动 / 纸飞机 轮播 -->
			<view v-if="currentTab === 'discover' && currentFilter === 'all'" class="discover-head">
				<swiper
					v-if="banners.length > 0"
					class="banner-swiper"
					circular
					autoplay
					:current="bannerIndex"
					:interval="4200"
					@change="onBannerChange"
				>
					<swiper-item v-for="b in banners" :key="b.id">
<!-- 话题面板：借浅绿主卡 + 主推 + 2×2 排版，保留宣誓爱文案 -->
								<view v-if="b.type === 'topic'" class="topic-panel" @click.stop>
									<view class="topic-panel-head">
										<text class="topic-head-title">热门话题</text>
										<view class="topic-head-more" @click="openTopics">
											<text>全部</text>
											<text class="topic-head-arrow">›</text>
										</view>
									</view>
									<view class="topic-feature" @click="openFeaturedTopic">
										<image
											v-if="featuredTopic != null && featuredTopic.cover != null"
											class="topic-feature-cover"
											:src="featuredTopic.cover"
											mode="aspectFill"
										></image>
										<view class="topic-feature-body">
											<text class="topic-feature-title">{{ featuredTopic != null ? featuredTopic.title : b.title }}</text>
											<text class="topic-feature-desc">{{ featuredTopic != null ? featuredTopic.description : b.description }}</text>
											<text class="topic-feature-meta" v-if="featuredTopic != null">
												{{ formatTopicViews(featuredTopic.viewCount) }} 浏览 · {{ featuredTopic.participantCount }} 人参与
											</text>
										</view>
									</view>
									<view class="topic-grid">
										<view class="topic-grid-item" v-for="t in hotTopics.slice(0, 4)" :key="t.id" @click="openTopic(t)">
											<text class="topic-grid-tag">{{ t.tag != null ? t.tag : '话题' }}</text>
											<text class="topic-grid-title">{{ t.title }}</text>
										</view>
									</view>
								</view>
						<!-- 活动 / 纸飞机 -->
						<view v-else class="feature" :class="'type-' + b.type" @click="openBanner(b)">
							<view v-if="b.type === 'plane'" class="plane-banner-art">
								<view class="plane-banner-blue-panel"></view>
								<text class="plane-banner-plane plane-banner-plane-main">✈</text>
								<text class="plane-banner-plane plane-banner-plane-blue">✈</text>
								<text class="plane-banner-plane plane-banner-plane-pink">✈</text>
							</view>
							<view v-if="b.type === 'activity'" class="activity-banner-art">
								<view class="activity-banner-circle"></view>
								<view class="activity-banner-triangle"></view>
								<view class="activity-banner-dot"></view>
							</view>
							<view class="feature-kicker-wrap">
								<view class="feature-kicker-dot"></view>
								<text class="feature-kicker">{{ b.kicker != null ? b.kicker : bannerKicker(b.type) }}</text>
							</view>
							<text class="feature-title">{{ b.title }}</text>
							<text class="feature-desc">{{ b.description }}</text>
							<view class="feature-btn">
								<text>{{ bannerCta(b.type) }}</text>
							</view>
						</view>
					</swiper-item>
				</swiper>
				<view class="banner-dots" v-if="banners.length > 1">
					<view
						class="banner-dot"
						:class="{ active: bannerIndex === i }"
						v-for="(b, i) in banners"
						:key="b.id"
						@click="setBannerIndex(i)"
					></view>
				</view>
			</view>

			<!-- 同城提示 -->
			<view v-if="currentTab === 'city'" class="city-bar">
				<text class="city-name">{{ cityName }}</text>
				<text class="city-switch text-accent" @click="switchCity">切换城市</text>
			</view>

			<view v-if="loading && dynamicList.length === 0" class="state-box">
				<text class="text-muted">加载中…</text>
			</view>

			<view v-else-if="loadError && dynamicList.length === 0" class="state-box">
				<text class="text-muted">{{ loadError }}</text>
				<text class="retry text-accent" @click="reload">点击重试</text>
			</view>

			<XsaEmpty
				v-else-if="dynamicList.length === 0 && !loading"
				:text="emptyTitle"
				:description="emptyDesc"
				:show-action="true"
				:action-text="emptyAction"
				@action="handleEmptyAction"
			/>

			<view v-else class="feed">
				<XsaDynamicCard
					v-for="item in dynamicList"
					:key="item.id"
					:dynamic="normalizeDynamic(item)"
					@user-click="handleUserClick"
					@like="handleLike"
					@comment="handleComment"
					@collect="handleCollect"
					@share="handleShare"
					@follow="handleFollow"
					@unfollow="handleUnfollow"
					@apply="handleApply"
					@more="handleMore"
					@topic="handleTopic"
					@open="handleOpen"
				/>
			</view>

			<view class="load-more" v-if="dynamicList.length > 0">
				<text class="load-text text-muted" v-if="loading">加载中...</text>
				<text class="load-text text-muted" v-else-if="!hasMore">没有更多了</text>
			</view>
		</scroll-view>

		<view class="publish-fab" @click="handlePublish">
			<text class="fab-icon">+</text>
		</view>

		<XsaApplySheet :visible="applyVisible" :user-id="applyUserId" @close="applyVisible = false" @success="onApplyOk" />
		<XsaReportSheet
			:visible="reportVisible"
			target-type="post"
			:target-id="reportTargetId"
			:user-id="reportUserId"
			@close="reportVisible = false"
			@blocked="onBlocked"
		/>
	</view>

	<!-- 自定义底部导航栏 -->
	<XsaTabBar />
</template>


<script setup lang="uts">
import XsaTabBar from '@/components/XsaTabBar.uvue'
	import XsaDynamicCard from '@/components/XsaDynamicCard.uvue'
	import XsaEmpty from '@/components/XsaEmpty.uvue'
	import XsaApplySheet from '@/components/XsaApplySheet.uvue'
	import XsaReportSheet from '@/components/XsaReportSheet.uvue'
	import {
		getDynamicList,
		getTopics,
		getActivities,
		getCommunityBanners,
		getUnreadNotificationCount,
		getCurrentCity,
		setCurrentCity,
		COMMUNITY_CITY_OPTIONS,
		likeDynamic,
		collectDynamic,
		shareDynamic,
		followUserFromCommunity,
		unfollowUserFromCommunity
	} from '@/api'
	import { guardCommunityVerification, guardRealName } from '@/utils/realNameGate.uts'

	// 主 Tab：follow | city | discover
	// 二级筛选：
	// follow: all / following / likedUsers
	// city: all / hot / latest
	// discover: all / mbti / alumni
	const currentTab = ref('discover')
	const currentFilter = ref('all')
	const COMMUNITY_ENTRY_TARGET_KEY = 'xsa-community-entry-target'
	const communityMounted = ref(false)
	const hasShown = ref(false)
	const loading = ref(false)
	const loadError = ref('')
	const hasMore = ref(true)
	const page = ref(1)
	const pageSize = 10
	const dynamicList = ref([])
	const topics = ref([])
	const featuredTopic = ref(null)
	const hotTopics = ref([])
	const activity = ref(null)
	const banners = ref([])
	const bannerIndex = ref(0)
const cityName = ref('')
			const cityCode = ref('')
			const unreadCount = ref(0)
		const applyVisible = ref(false)
		const applyUserId = ref(0)
		const reportVisible = ref(false)
	const reportTargetId = ref(0)
	const reportUserId = ref(0)
	const unfollowPendingUserId = ref(0)
		// 防止快速切换 Tab/筛选时旧请求覆盖新列表
		const loadSeq = ref(0)

		const isValidCity = (name: string) => {
			const n = name != null ? ('' + name).trim() : ''
			return n != '' && n != '未设置'
		}

		const defaultFilterForTab = (tab: string) => {
			return 'all'
		}

	const filterOptions = computed(() => {
		if (currentTab.value === 'follow') {
			return [
				{ key: 'all', label: '全部' },
				{ key: 'following', label: '关注' },
				{ key: 'likedUsers', label: '喜欢' }
			]
		}
		if (currentTab.value === 'city') {
			return [
				{ key: 'all', label: '全部' },
				{ key: 'hot', label: '热门' },
				{ key: 'latest', label: '最新' }
			]
		}
		return [
				{ key: 'all', label: '全部' },
				{ key: 'mbti', label: 'MBTI' },
				{ key: 'alumni', label: '校友' }
			]
	})

	const consumeEntryTarget = (): boolean => {
		let target = ''
		try {
			target = '' + uni.getStorageSync(COMMUNITY_ENTRY_TARGET_KEY)
			if (target != '') uni.removeStorageSync(COMMUNITY_ENTRY_TARGET_KEY)
		} catch (e) {
			console.error(e)
		}
		if (target != 'follow-all') return false
		currentTab.value = 'follow'
		currentFilter.value = 'all'
		bannerIndex.value = 0
		dynamicList.value = []
		return true
	}

	onMounted(async () => {
		consumeEntryTarget()
			await loadCity()
			await loadDynamics(true)
			loadTopics()
			loadActivity()
			loadBanners()
			loadUnread()
			communityMounted.value = true
		})

	onShow(() => {
		const firstShow = !hasShown.value
		hasShown.value = true
		const targeted = consumeEntryTarget()
		loadUnread()
		if (firstShow || !communityMounted.value) return
		// 从资料页喜欢用户返回后，关注流需要刷新
		if (targeted || currentTab.value === 'follow') {
			reload()
		}
	})

	const emptyTitle = computed(() => {
		if (currentTab.value === 'follow') {
			if (currentFilter.value === 'likedUsers') return '还没有喜欢用户的动态'
			if (currentFilter.value === 'following') return '还没有关注动态'
			return '关注与喜欢的动态都在这里'
		}
		if (currentTab.value === 'city') {
			if (!isValidCity(cityName.value)) return '请先选择同城城市'
			return '同城暂无动态'
		}
		if (currentFilter.value === 'mbti') return '暂无 MBTI 动态'
		if (currentFilter.value === 'alumni') return '暂无校友动态'
		return '暂无动态'
	})

	const emptyDesc = computed(() => {
		if (currentTab.value === 'follow') {
			if (currentFilter.value === 'likedUsers') return '在用户资料页点「喜欢」后，TA 的动态会出现在这里'
			return '关注认真嘉宾后，他们的动态会出现在这里'
		}
		if (currentTab.value === 'city') {
			if (!isValidCity(cityName.value)) return '点上方「切换城市」设置所在城市，再看同城动态'
			return '切换城市或发布一条同城动态'
		}
		return '快来发布第一条动态吧'
	})

const emptyAction = computed(() => {
			if (currentTab.value === 'follow') return '去发现'
			if (currentTab.value === 'city' && !isValidCity(cityName.value)) return '选择城市'
			return '发布动态'
		})

	const formatTime = (t: any) => {
		if (t == null) return ''
		if (typeof t === 'string') return t
		const diff = Date.now() - (t as number)
		if (diff < 60 * 1000) return '刚刚'
		if (diff < 60 * 60 * 1000) return Math.floor(diff / 60000) + ' 分钟前'
		if (diff < 24 * 60 * 60 * 1000) return Math.floor(diff / 3600000) + ' 小时前'
		return '昨天'
	}

const normalizeDynamic = (item: any) => {
			const photos = item.photos != null ? item.photos : item.media
			return {
				id: item.id,
				user: item.user,
				content: item.content,
				photos,
				location: item.location,
				time: item.timeText != null ? item.timeText : formatTime(item.time != null ? item.time : item.createdAt),
				timeText: item.timeText != null ? item.timeText : formatTime(item.time != null ? item.time : item.createdAt),
				likeCount: item.likeCount,
				commentCount: item.commentCount,
				collectCount: item.collectCount,
				liked: item.liked,
				collected: item.collected,
				followed: item.followed,
				applyStatus: item.applyStatus,
				topicId: item.topicId,
				tags: item.tags,
				declaration: item.declaration,
				cityTag: item.cityTag === true,
				relationTags: item.relationTags != null ? item.relationTags : [],
				topicTitle: item.topicTitle != null ? item.topicTitle : '',
				videos: item.videos != null ? item.videos : [],
				mediaType: item.mediaType != null ? item.mediaType : ''
			}
		}

	const extractListPayload = (data: any) => {
		// 新结构 { list, hasMore, total }；兼容旧数组
		if (data == null) {
			return { list: [] as any[], hasMore: false, total: 0 }
		}
		if (Array.isArray(data)) {
			return {
				list: data as any[],
				hasMore: (data as any[]).length >= pageSize,
				total: (data as any[]).length
			}
		}
		const list = data.list != null ? (data.list as any[]) : []
		const more = data.hasMore != null ? data.hasMore == true : list.length >= pageSize
		const total = data.total != null ? (data.total as number) : list.length
		return { list, hasMore: more, total }
	}

const loadDynamics = async (reset: boolean = false) => {
			// 非 reset 的加载更多仍需防重入；reset 必须可打断旧请求
			if (!reset && loading.value) return
			if (reset) {
				page.value = 1
				hasMore.value = true
				loadError.value = ''
				loadSeq.value = loadSeq.value + 1
			}
			if (!hasMore.value && !reset) return
			// 同城：未选城市时不发列表请求，避免默认城市误筛 / 422
			if (currentTab.value === 'city' && !isValidCity(cityName.value)) {
				if (reset) {
					dynamicList.value = []
					hasMore.value = false
					loadError.value = ''
				}
				loading.value = false
				return
			}
			const seq = loadSeq.value
			loading.value = true
			try {
const cityArg = isValidCity(cityName.value) ? cityName.value : ''
					const cityCodeArg = cityCode.value != null ? ('' + cityCode.value).trim() : ''
					const res = await getDynamicList({
						tab: currentTab.value,
						filter: currentFilter.value,
						page: page.value,
						pageSize,
						city: cityArg,
						cityCode: cityCodeArg
					})
				// 过期请求：用户已切换 Tab/筛选，丢弃结果
				if (seq != loadSeq.value) return
				if (res.success) {
					const payload = extractListPayload(res.data)
					if (reset) {
						dynamicList.value = payload.list
					} else {
						dynamicList.value = (dynamicList.value as any[]).concat(payload.list)
					}
					hasMore.value = payload.hasMore
					if (payload.list.length > 0) {
						page.value = page.value + 1
					}
				} else {
					loadError.value = '加载失败，请稍后重试'
					if (reset) {
						uni.showToast({ title: loadError.value, icon: 'none' })
					}
				}
			} catch (e) {
				if (seq != loadSeq.value) return
				loadError.value = '网络异常，请检查后重试'
				if (reset || dynamicList.value.length == 0) {
					uni.showToast({ title: loadError.value, icon: 'none' })
				}
			} finally {
				if (seq == loadSeq.value) {
					loading.value = false
				}
			}
		}

	const reload = () => {
		dynamicList.value = []
		loadDynamics(true)
	}

	const loadTopics = async () => {
		try {
			const res = await getTopics('hot')
			if (res.success) {
				const list = res.data as any[]
				topics.value = list
				featuredTopic.value = list.length > 0 ? list[0] : null
				// featured 用 list[0]，快捷入口取其后 4 个，避免重复
				hotTopics.value = list.slice(1, 5)
			}
		} catch (e) {
			// 次要模块，不打断主列表
		}
	}

	const loadActivity = async () => {
		try {
			const res = await getActivities('all')
			if (res.success && (res.data as any[]).length > 0) {
				activity.value = (res.data as any[])[0]
			}
		} catch (e) {}
	}

	const loadBanners = async () => {
		try {
			const res = await getCommunityBanners()
			if (res.success && res.data != null) {
				// 每个 type 只保留一个 entry：热门话题 / 纸飞机 / 线下活动 各出现一次，
				// 避免后端返回重复 topic 时在 banner 轮播里出现两块「热门话题」。
				const list = res.data as any[]
				const seen: Record<string, boolean> = {}
				const result: any[] = []
				const order = ['topic', 'plane', 'activity']
				for (const t of order) {
					const found = list.find((b: any) => b != null && b.type === t && !seen[t])
					if (found != null) {
						result.push(found)
						seen[t] = true
					}
				}
				// 其他未预见的 type 原样补齐，不重复
				for (const b of list) {
					if (b != null && !seen[b.type]) {
						result.push(b)
						seen[b.type] = true
					}
				}
				banners.value = result
			}
		} catch (e) {}
	}

	const loadUnread = async () => {
		try {
			const res = await getUnreadNotificationCount()
			if (res.success && res.data != null && res.data.count != null) {
				unreadCount.value = res.data.count as number
			}
		} catch (e) {}
	}

const loadCity = async () => {
				try {
					const res = await getCurrentCity()
					if (res.success && res.data != null && res.data.name != null) {
						const name = ('' + res.data.name).trim()
						cityName.value = name != '' ? name : '未设置'
						const code = res.data.code != null ? ('' + res.data.code).trim() : ''
						cityCode.value = code != '' && code != 'null' ? code : ''
					} else {
						cityName.value = '未设置'
						cityCode.value = ''
						const msg =
							res != null && res.message != null && ('' + res.message) != ''
								? ('' + res.message)
								: '城市加载失败'
						uni.showToast({ title: msg, icon: 'none' })
					}
				} catch (e) {
					cityName.value = '未设置'
					cityCode.value = ''
					uni.showToast({ title: '城市加载失败', icon: 'none' })
				}
			}

	const switchTab = (tab: string) => {
		if (currentTab.value === tab) return
		currentTab.value = tab
		currentFilter.value = defaultFilterForTab(tab)
		bannerIndex.value = 0
		dynamicList.value = []
		loadDynamics(true)
	}

	const switchFilter = (key: string) => {
		if (currentFilter.value === key) return
		currentFilter.value = key
		dynamicList.value = []
		loadDynamics(true)
	}

	const onBannerChange = (e: any) => {
		if (e != null && e.detail != null && e.detail.current != null) {
			bannerIndex.value = e.detail.current as number
		}
	}

	const setBannerIndex = (i: number) => {
		bannerIndex.value = i
	}

	const openFeaturedTopic = () => {
		if (featuredTopic.value == null) {
			openTopics()
			return
		}
		openTopic(featuredTopic.value)
	}

	const bannerKicker = (type: string) => {
		if (type === 'topic') return 'TOPIC'
		if (type === 'plane') return 'PAPER PLANE'
		return 'OFFLINE'
	}

const bannerCta = (type: string) => {
			if (type === 'topic') return '进入话题'
			if (type === 'plane') return '去漂流'
			return '查看活动'
		}

		const formatTopicViews = (n: any) => {
			const v = n != null ? Number(n) : 0
			if (v >= 100000000) {
				const y = Math.round((v / 100000000) * 10) / 10
				return '' + y + '亿'
			}
			if (v >= 10000) {
				const w = Math.round((v / 10000) * 10) / 10
				return '' + w + '万'
			}
			return '' + v
		}

		const openBanner = (b: any) => {
		if (b == null) return
		if (b.type === 'topic') {
			const tid = b.targetId != null ? b.targetId : (featuredTopic.value != null ? featuredTopic.value.id : 0)
			if (tid > 0) {
				uni.navigateTo({ url: '/pagesSub/community/topic-detail?id=' + tid })
			} else {
				uni.navigateTo({ url: '/pagesSub/community/topic-list' })
			}
			return
		}
		if (b.type === 'plane') {
			uni.navigateTo({ url: '/pagesSub/community/paper-plane' })
			return
		}
		if (b.type === 'activity') {
			const id = b.targetId != null ? b.targetId : (activity.value != null ? activity.value.id : 0)
			uni.navigateTo({ url: '/pagesSub/community/activity-detail?id=' + id })
			return
		}
	}

	const handleUserClick = (userId: number) => {
		uni.navigateTo({ url: '/pagesSub/userExtra/user/detail?userId=' + userId })
	}

const handleLike = async (dynamicId: number) => {
			const ok = await guardRealName('like')
			if (!ok) return
			try {
				const res = await likeDynamic(dynamicId)
				if (res.success && res.data != null) {
					const list = dynamicList.value as any[]
					const idx = list.findIndex((d: any) => d.id == dynamicId)
					if (idx >= 0) {
						list[idx].liked = res.data.liked
						list[idx].likeCount = res.data.likeCount
					}
				} else {
					const msg =
						res.data != null && res.data.message != null
							? res.data.message
							: res.message != null
								? res.message
								: '点赞失败，请重试'
					uni.showToast({ title: msg, icon: 'none' })
				}
			} catch (e) {
				uni.showToast({ title: '点赞失败，请重试', icon: 'none' })
			}
		}

	const handleComment = (dynamicId: number) => {
		uni.navigateTo({ url: '/pagesSub/community/post-detail?id=' + dynamicId })
	}

	const handleCollect = async (dynamicId: number) => {
		const ok = await guardRealName('collect')
		if (!ok) return
		try {
			const res = await collectDynamic(dynamicId)
			if (res.success && res.data != null) {
				const list = dynamicList.value as any[]
				const idx = list.findIndex((d: any) => d.id == dynamicId)
				if (idx >= 0) {
					list[idx].collected = res.data.collected == true
					if (res.data.collectCount != null) list[idx].collectCount = Number(res.data.collectCount)
				}
				dynamicList.value = list.slice()
			} else {
				const msg = res.message != null && res.message != '' ? '' + res.message : '收藏失败，请重试'
				uni.showToast({ title: msg, icon: 'none' })
			}
		} catch (e) {
			uni.showToast({ title: '收藏失败，请重试', icon: 'none' })
		}
	}

	const handleShare = async (dynamicId: number) => {
		try {
			const res = await shareDynamic(dynamicId)
			uni.showToast({ title: res.success ? '已生成分享内容，请使用右上角分享' : '分享暂不可用，请稍后重试', icon: 'none' })
		} catch (e) {
			uni.showToast({ title: '分享暂不可用，请稍后重试', icon: 'none' })
		}
	}

	const syncFollowed = (userId: number, followed: boolean) => {
		const list = dynamicList.value as any[]
		for (let i = 0; i < list.length; i++) {
			if (list[i].user != null && list[i].user.id == userId) {
				list[i].followed = followed
			}
		}
		dynamicList.value = list.slice()
	}

		const handleFollow = async (userId: number) => {
			const ok = await guardRealName('follow')
			if (!ok) return
			try {
				const res = await followUserFromCommunity(userId)
				if (res.success) {
					syncFollowed(userId, true)
					uni.showToast({ title: '已关注', icon: 'none' })
				} else {
					const msg =
						res.data != null && res.data.message != null
							? res.data.message
							: res.message != null
								? res.message
								: '关注失败，请重试'
					uni.showToast({ title: msg, icon: 'none' })
				}
			} catch (e) {
				uni.showToast({ title: '关注失败，请重试', icon: 'none' })
			}
		}

	const handleUnfollow = (userId: number) => {
		if (unfollowPendingUserId.value == userId) return
		uni.showModal({
			title: '取消关注',
			content: '确定不再关注这位用户吗？',
			cancelText: '取消',
			confirmText: '确定',
			success: async (modalRes: any) => {
				if (!modalRes.confirm) return
				unfollowPendingUserId.value = userId
				try {
					const res = await unfollowUserFromCommunity(userId)
					if (res.success) {
						syncFollowed(userId, false)
						if (currentTab.value === 'follow') reload()
						uni.showToast({ title: '已取消关注', icon: 'none' })
					} else {
						const msg =
							res.data != null && res.data.message != null
								? res.data.message
								: res.message != null
									? res.message
									: '取消关注失败，请重试'
						uni.showToast({ title: msg, icon: 'none' })
					}
				} catch (e) {
					uni.showToast({ title: '取消关注失败，请重试', icon: 'none' })
				} finally {
					if (unfollowPendingUserId.value == userId) {
						unfollowPendingUserId.value = 0
					}
				}
			}
		})
	}

	const handleApply = (userId: number) => {
		applyUserId.value = userId
		applyVisible.value = true
	}

	const onApplyOk = (payload: any) => {
		const status =
			payload != null && payload.applyStatus != null ? (payload.applyStatus as string) : 'pending'
		const list = dynamicList.value as any[]
		list.forEach((d: any) => {
			if (d.user != null && d.user.id == applyUserId.value) {
				d.applyStatus = status
			}
		})
	}

	const handleMore = (dynamicId: number, userId: number) => {
		reportTargetId.value = dynamicId
		reportUserId.value = userId
		reportVisible.value = true
	}

	const onBlocked = () => {
		const list = dynamicList.value as any[]
		dynamicList.value = list.filter((d: any) => d.user == null || d.user.id != reportUserId.value)
	}

	const handleTopic = (topicId: number) => {
		uni.navigateTo({ url: '/pagesSub/community/topic-detail?id=' + topicId })
	}

	const handleOpen = (dynamicId: number) => {
		uni.navigateTo({ url: '/pagesSub/community/post-detail?id=' + dynamicId })
	}

	const handlePublish = async () => {
		// 发布动态（含带话题发布）要求实名 + 人脸，见 PRODUCT.md §互动门槛
		const ok = await guardCommunityVerification()
		if (!ok) return
		uni.navigateTo({ url: '/pagesSub/community/publish' })
	}

const handleEmptyAction = () => {
			if (currentTab.value === 'follow') {
				switchTab('discover')
				return
			}
			if (currentTab.value === 'city' && !isValidCity(cityName.value)) {
				switchCity()
				return
			}
			handlePublish()
		}

	const openActivity = () => {
		if (activity.value == null) return
		uni.navigateTo({ url: '/pagesSub/community/activity-detail?id=' + activity.value.id })
	}

	const openTopics = () => {
		uni.navigateTo({ url: '/pagesSub/community/topic-list' })
	}

	const openTopic = (t: any) => {
		uni.navigateTo({ url: '/pagesSub/community/topic-detail?id=' + t.id })
	}

	const openNotifications = () => {
		uni.navigateTo({ url: '/pagesSub/community/notifications' })
	}

const switchCity = () => {
				const options = COMMUNITY_CITY_OPTIONS as any[]
				const labels: string[] = []
				for (let i = 0; i < options.length; i++) {
					const o = options[i]
					labels.push(o != null && o.name != null ? ('' + o.name) : '')
				}
				uni.showActionSheet({
					itemList: labels,
					success: async (res) => {
						const opt = options[res.tapIndex]
						if (opt == null || opt.name == null) return
						const name = '' + opt.name
						const code = opt.code != null ? ('' + opt.code) : ''
						if (name == cityName.value && code == cityCode.value) return
						try {
							const r = await setCurrentCity(name, code)
							if (r.success) {
								const saved =
									r.data != null && r.data.city != null && r.data.city.name != null
										? ('' + r.data.city.name)
										: name
								const savedCode =
									r.data != null && r.data.city != null && r.data.city.code != null
										? ('' + r.data.city.code)
										: code
								cityName.value = saved
								cityCode.value = savedCode
								if (currentTab.value === 'city') {
									dynamicList.value = []
									loadDynamics(true)
								}
								uni.showToast({ title: '已切换到' + cityName.value, icon: 'none' })
							} else {
								const msg =
									r.message != null && r.message != ''
										? ('' + r.message)
										: '切换城市失败'
								uni.showToast({ title: msg, icon: 'none' })
							}
						} catch (e) {
							uni.showToast({ title: '切换失败', icon: 'none' })
						}
					}
				})
			}

	const handleLoadMore = () => {
		if (loading.value || !hasMore.value) return
		loadDynamics(false)
	}
</script>

