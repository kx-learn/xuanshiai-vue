			line-height: 1.25;
		}

		.feature-desc {
			font-size: 11px;
			line-height: 1.4;
			color: var(--image-text-soft);
			max-width: 250px;
			overflow: hidden;
			text-overflow: ellipsis;
			display: -webkit-box;
			-webkit-box-orient: vertical;
			-webkit-line-clamp: 2;
			lines: 2;
		}

.feature-btn {
				margin-top: 2px;
				align-self: flex-start;
				height: 28px;
				padding: 0 11px;
				background: var(--soft);
				border-radius: 6px;
				display: flex;
				flex-direction: row;
				align-items: center;
		}

