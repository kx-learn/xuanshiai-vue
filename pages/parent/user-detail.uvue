<template>
	<view class="detail-page">
		<view class="detail-nav">
			<button class="back-button" @click="goBack"><text>←</text></button>
			<text class="nav-title">资料详情</text>
			<view class="nav-space"></view>
		</view>

		<scroll-view class="detail-scroll" scroll-y enhanced :show-scrollbar="false">
			<view class="detail-content">
				<view v-if="loading" class="state-panel"><text>正在加载</text></view>
				<view v-else-if="loadError.length > 0" class="state-panel">
					<text class="state-title">暂时无法查看</text>
					<text class="state-copy">{{ loadError }}</text>
					<button class="retry-button" @click="loadDetail">重新加载</button>
				</view>
					<ParentGateNotice v-else-if="!accessGate.allowed" :gate="accessGate" @action="handleGateAction" />

					<template v-else-if="candidate != null">
						<view class="photo-card">
						<image
							v-if="candidate.canViewClearPhoto"
							class="profile-photo"
							:src="candidate.clearAvatar"
							mode="aspectFill"
						></image>
						<view class="protected-photo-placeholder" v-else>
							<XsaIcon name="profile" size="large" />
							<view class="photo-label">
								<text>照片已保护，仅在本人明确允许后显示清晰照片</text>
							</view>
						</view>
					</view>

					<view class="identity-card">
						<text class="candidate-name">{{ candidate.displayName }}</text>
						<text class="candidate-meta">{{ candidate.genderText }} · {{ candidate.birthYear }}年 · {{ candidate.city }}</text>
						<text class="candidate-cert">{{ candidate.certificationText }}</text>
					</view>

					<view class="section-card">
						<text class="section-title">基础信息</text>
						<view class="fact-grid">
							<view class="fact-item"><text class="fact-label">身高</text><text class="fact-value">{{ candidate.height }}</text></view>
							<view class="fact-item"><text class="fact-label">学历</text><text class="fact-value">{{ candidate.education }}</text></view>
							<view class="fact-item"><text class="fact-label">工作</text><text class="fact-value">{{ candidate.job }}</text></view>
							<view class="fact-item"><text class="fact-label">收入</text><text class="fact-value">{{ candidate.income }}</text></view>
						</view>
					</view>

					<view class="section-card">
						<text class="section-title">个人介绍</text>
						<text class="section-body">{{ candidate.introduction }}</text>
					</view>

					<view class="section-card">
						<text class="section-title">相亲说明</text>
						<text class="section-body">{{ candidate.datingNotes }}</text>
					</view>

					<view class="section-card">
						<text class="section-title">择偶标准</text>
						<view class="expectation-list">
							<view v-for="item in candidate.expectations" :key="item" class="expectation-item"><text>{{ item }}</text></view>
						</view>
					</view>

					<ParentGateNotice :gate="accessGate" @action="handleGateAction" />

					<view class="safety-actions">
						<button class="safety-action" @click="handleReport">举报资料</button>
						<button class="safety-action" @click="handleBlock">屏蔽资料</button>
					</view>
				</template>
			</view>
		</scroll-view>

		<view v-if="accessGate.allowed && candidate != null" class="detail-actions">
			<button class="detail-action secondary" @click="handleLike">{{ candidate.liked ? '已喜欢' : '喜欢' }}</button>
			<button class="detail-action primary" @click="handleApply">申请认识</button>
		</view>

		<ParentApplySheet
			:visible="parentApplyVisible"
			:candidate-id="candidateId"
			:parent-context="parentContext"
			@close="parentApplyVisible = false"
			@success="handleParentApplySuccess"
		/>
	</view>
</template>

	<script setup lang="uts">
		import ParentApplySheet from '@/components/ParentApplySheet.uvue'
		import ParentGateNotice from '@/components/ParentGateNotice.uvue'
		import XsaIcon from '@/components/XsaIcon.uvue'
		import type { ParentContext } from '@/api'
		import {
		blockParentCandidate,
		getParentAccessGate,
		getParentAuthenticationGate,
		getParentCandidateDetail,
		getParentContext,
		reportParentCandidate,
		toggleParentLike,
		getCurrentAccountKey
	} from '@/api'

		const loading = ref(false)
		let pageAccountKey = ''
		const loadError = ref('')
		const candidateId = ref(0)
		const parentContext = ref(null as ParentContext | null)
		const candidate = ref<any>(null)
		const parentApplyVisible = ref(false)
			const accessClock = ref(Date.now())
			let authorizationExpiryTimer: any = null
			let parentRoleTimer: any = null
			let detailPageActive = false
			let detailRequestGeneration = 0
			const accessGate = computed(() => {
				accessClock.value
				return getParentAccessGate(parentContext.value)
			})

	onLoad((options: any) => {
		if (options != null && options.id != null) {
			const parsedId = Number(options.id)
			if (Number.isFinite(parsedId) && Math.floor(parsedId) == parsedId && parsedId > 0) {
				candidateId.value = parsedId
			}
		}
	})

			onShow(() => {
				detailPageActive = true
				pageAccountKey = getCurrentAccountKey()
				startParentRoleMonitor()
				if (ensureParentRole()) loadDetail()
			})

			onHide(() => {
				deactivateDetailPage()
			})
			onUnmounted(() => {
				deactivateDetailPage()
			})

		const scrubCandidatePhoto = () => {
			if (candidate.value == null) return
			candidate.value.canViewClearPhoto = false
			candidate.value.clearAvatar = ''
		}

			const clearAuthorizationExpiryTimer = () => {
				if (authorizationExpiryTimer == null) return
				clearTimeout(authorizationExpiryTimer)
				authorizationExpiryTimer = null
			}

			const stopParentRoleMonitor = () => {
				if (parentRoleTimer == null) return
				clearInterval(parentRoleTimer)
				parentRoleTimer = null
			}

			const startParentRoleMonitor = () => {
				stopParentRoleMonitor()
				parentRoleTimer = setInterval(() => ensureParentRole(), 2000)
			}

			const hasStoredParentRole = (): boolean => {
				const storedMode = uni.getStorageSync('xsa_onboarding_mode')
				return storedMode != null && String(storedMode) == 'parent' && pageAccountKey == getCurrentAccountKey()
			}

			const invalidateDetailRequest = () => {
				detailRequestGeneration += 1
				loading.value = false
			}

			const isDetailRequestCurrent = (requestId: number): boolean => {
				return detailPageActive &&
					requestId == detailRequestGeneration &&
					hasStoredParentRole()
			}

			const deactivateDetailPage = () => {
				detailPageActive = false
				invalidateDetailRequest()
				clearAuthorizationExpiryTimer()
				stopParentRoleMonitor()
				scrubCandidatePhoto()
				parentContext.value = null
				parentApplyVisible.value = false
			}

			const redirectToParentLogin = () => {
				deactivateDetailPage()
				candidate.value = null
				uni.reLaunch({ url: '/pages/auth/login' })
			}

			const handleParentAuthenticationFailure = (response: any): boolean => {
				if (response == null || response.code == null || String(response.code) != 'PARENT_AUTH_REQUIRED') {
					return false
				}
				redirectToParentLogin()
				return true
			}

			const scheduleAuthorizationExpiry = () => {
			clearAuthorizationExpiryTimer()
			if (parentContext.value == null || parentContext.value.child == null) return
			const expiresAt = new Date(parentContext.value.child.authorizationExpiresAt).getTime()
			if (isNaN(expiresAt)) {
				accessClock.value = Date.now()
				scrubCandidatePhoto()
				return
			}
				const delay = Math.min(Math.max(0, expiresAt - Date.now() + 20), 2147483647)
			authorizationExpiryTimer = setTimeout(() => {
				accessClock.value = Date.now()
				authorizationExpiryTimer = null
				if (getParentAccessGate(parentContext.value).allowed != true) scrubCandidatePhoto()
				if (expiresAt > Date.now()) scheduleAuthorizationExpiry()
			}, delay)
		}

		const ensureParentRole = (): boolean => {
			const authGate = getParentAuthenticationGate()
			if (authGate == null || authGate.allowed != true) {
				redirectToParentLogin()
				return false
			}
			if (hasStoredParentRole()) return true
			deactivateDetailPage()
			candidate.value = null
			uni.reLaunch({ url: '/pages/index/index' })
			return false
		}

		const ensureCurrentParentAccess = (): boolean => {
			if (!ensureParentRole()) return false
			accessClock.value = Date.now()
			const gate = getParentAccessGate(parentContext.value)
			if (gate.allowed == true) return true
			scrubCandidatePhoto()
			handleGateAction(gate)
			return false
		}

		const validSafetyCandidateId = (): number => {
			const rawId = candidate.value != null && candidate.value.id != null
				? candidate.value.id
				: candidateId.value
			const targetId = Number(rawId)
			if (Number.isFinite(targetId) && Math.floor(targetId) == targetId && targetId > 0) {
				return targetId
			}
			uni.showToast({ title: '候选资料编号无效', icon: 'none' })
			return 0
		}

		const responseMessage = (response: any, fallback: string): string => {
			if (response != null && response.message != null && String(response.message) != 'success') {
				return String(response.message)
			}
			if (response != null && response.data != null && response.data.message != null) {
				return String(response.data.message)
			}
			return fallback
		}

		const loadDetail = async () => {
			if (!detailPageActive || !ensureParentRole() || loading.value) return
			const requestId = ++detailRequestGeneration
			loading.value = true
			loadError.value = ''
			scrubCandidatePhoto()
			candidate.value = null
				try {
					const contextRes = await getParentContext()
					if (handleParentAuthenticationFailure(contextRes)) return
					if (!isDetailRequestCurrent(requestId)) return
				if (contextRes == null || contextRes.success != true || contextRes.data == null) {
					loadError.value = '父母端资料暂时不可用。'
					return
				}
				if (contextRes.data.mode != 'parent') {
					loadError.value = '当前账号不是父母身份。'
					return
				}
				const requestContext = contextRes.data as ParentContext
				parentContext.value = requestContext
				accessClock.value = Date.now()
				scheduleAuthorizationExpiry()
				if (!accessGate.value.allowed) return
				if (candidateId.value <= 0) {
					loadError.value = '缺少要查看的资料。'
					return
				}

					const detailRes = await getParentCandidateDetail(requestContext, candidateId.value)
					if (handleParentAuthenticationFailure(detailRes)) return
					if (!isDetailRequestCurrent(requestId)) return
				if (detailRes == null || detailRes.success != true || detailRes.data == null) {
					loadError.value = responseMessage(detailRes, '没有找到这份资料。')
					return
				}
				accessClock.value = Date.now()
				if (!getParentAccessGate(requestContext).allowed) {
					scrubCandidatePhoto()
					return
				}
				candidate.value = detailRes.data
			} catch (e) {
				if (!isDetailRequestCurrent(requestId)) return
				loadError.value = '网络异常，请稍后重试。'
			} finally {
				if (isDetailRequestCurrent(requestId)) loading.value = false
			}
		}

	const goBack = () => {
		uni.navigateBack({ delta: 1 })
	}

		const handleGateAction = (gate: any) => {
			if (gate != null && gate.code == 'PARENT_REALNAME_REQUIRED') {
				uni.navigateTo({ url: '/pagesSub/profileExtra/certification' })
				return
			}
			if (
				gate != null &&
				(gate.code == 'CHILD_AUTHORIZATION_REQUIRED' || gate.code == 'CHILD_AUTHORIZATION_EXPIRED')
			) {
				uni.showModal({
					title: '需要子女授权',
				content: '当前尚未取得有效授权，请由子女完成授权后再试。',
					showCancel: false,
					confirmText: '知道了'
				})
				return
			}
			uni.showToast({ title: gate != null && gate.message != null ? gate.message : '请完成访问条件', icon: 'none' })
		}

		const handleLike = async () => {
			if (candidate.value == null) return
			if (!ensureCurrentParentAccess()) return
			const requestId = detailRequestGeneration
			const requestContext = parentContext.value
			const targetId = candidate.value.id
			if (requestContext == null || !isDetailRequestCurrent(requestId)) return
			const res = await toggleParentLike(requestContext, targetId, candidate.value.liked != true)
			if (!isDetailRequestCurrent(requestId) || candidate.value == null || candidate.value.id != targetId) return
				if (res.success && res.data != null && res.data.success == true) {
					candidate.value.liked = res.data.liked == true
					uni.showToast({
						title: candidate.value.liked ? '已加入喜欢' : '已取消喜欢',
					icon: 'none'
				})
				return
		}
		uni.showToast({ title: res.message != null ? res.message : '操作失败', icon: 'none' })
	}

		const handleApply = () => {
			if (candidate.value == null) return
			if (!ensureCurrentParentAccess()) return
			parentApplyVisible.value = true
	}

	const handleParentApplySuccess = (_payload: any) => {
		if (!isDetailRequestCurrent(detailRequestGeneration)) return
		parentApplyVisible.value = false
	}

		const handleReport = async () => {
			if (!ensureParentRole()) return
			const requestId = detailRequestGeneration
			const targetId = validSafetyCandidateId()
			if (targetId <= 0) return
			const requestContext = parentContext.value
			if (requestContext == null || !isDetailRequestCurrent(requestId)) return
		const res = await reportParentCandidate(
			requestContext,
			targetId,
			'profile_inaccurate',
			'父母端资料举报'
		)
			if (!isDetailRequestCurrent(requestId)) return
			uni.showToast({ title: res != null && res.success == true ? '举报已提交' : '举报失败，请重试', icon: 'none' })
		}

		const handleBlock = () => {
			if (!ensureParentRole()) return
			const requestId = detailRequestGeneration
			const targetId = validSafetyCandidateId()
			if (targetId <= 0) return
			if (parentContext.value == null || !isDetailRequestCurrent(requestId)) return
		uni.showModal({
			title: '确认屏蔽这份资料？',
			content: '屏蔽后将不再展示这份资料。',
			confirmText: '确认屏蔽',
			success: async (modalRes: any) => {
				if (modalRes == null || modalRes.confirm != true || !ensureParentRole() || !isDetailRequestCurrent(requestId)) return
				const confirmedTargetId = validSafetyCandidateId()
				if (confirmedTargetId <= 0 || confirmedTargetId != targetId) return
				const requestContext = parentContext.value
				if (requestContext == null) return
				const res = await blockParentCandidate(requestContext, confirmedTargetId)
				if (!isDetailRequestCurrent(requestId)) return
					if (res != null && res.success == true) {
						uni.showToast({ title: '已屏蔽', icon: 'none' })
						setTimeout(() => uni.navigateBack({ delta: 1 }), 500)
					return
				}
				uni.showToast({ title: '屏蔽失败，请重试', icon: 'none' })
			}
		})
	}
</script>

<style scoped>
	.detail-page {
		min-height: 100vh;
		background: var(--canvas);
		color: var(--ink);
		display: flex;
		flex-direction: column;
	}

	.detail-nav {
		min-height: 88px;
		padding: calc(20px + env(safe-area-inset-top)) 16px 12px;
		background: var(--surface);
		border-bottom: 1px solid var(--line);
		display: grid;
		grid-template-columns: 48px 1fr 48px;
		align-items: center;
		flex-shrink: 0;
	}

	.back-button,
	.nav-space {
		width: 48px;
		min-height: 48px;
		margin: 0;
	}

	.back-button {
		border-radius: 14px;
		background: var(--paper);
		border: 1px solid var(--line);
		color: var(--ink);
		font-size: 22px;
		line-height: 48px;
	}

	.nav-title {
		align-self: center;
		font-size: 20px;
		font-family: var(--sans);
		font-weight: 800;
		text-align: center;
	}

	.detail-scroll {
		min-height: 0;
		flex: 1;
		height: 0;
	}

	.detail-content {
		display: flex;
		flex-direction: column;
		gap: 18px;
		padding: 20px 16px;
		padding-bottom: calc(124px + env(safe-area-inset-bottom));
	}

	.photo-card {
		position: relative;
		height: 288px;
		border-radius: 20px;
		box-shadow: var(--shadow-sm);
		overflow: hidden;
		background: var(--warm);
	}

	.profile-photo {
		width: 100%;
		height: 100%;
	}

	.protected-photo-placeholder {
		width: 100%;
		height: 100%;
		background: var(--warm);
		color: var(--accent2);
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 16px;
	}

	.photo-label {
		position: absolute;
		left: 16px;
		right: 16px;
		bottom: 14px;
		min-height: 48px;
		padding: 8px 14px;
		border-radius: 12px;
		background: var(--surface);
		color: var(--ink2);
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 14px;
		font-weight: 700;
	}

	.identity-card,
	.section-card,
	.state-panel {
		padding: 18px;
		border: 1px solid var(--line);
		border-radius: 18px;
		background: var(--surface);
		box-shadow: var(--shadow-sm);
	}

	.candidate-name {
		display: block;
		font-size: 22px;
		font-family: var(--sans);
		font-weight: 800;
		line-height: 1.35;
	}

	.candidate-meta {
		display: block;
		margin-top: 8px;
		font-size: 16px;
		line-height: 1.5;
		color: var(--ink2);
	}

	.candidate-cert {
		display: block;
		margin-top: 8px;
		font-size: 14px;
		font-weight: 700;
		color: var(--sage);
	}

	.section-title,
	.state-title {
		display: block;
		font-size: 20px;
		font-family: var(--sans);
		font-weight: 800;
		line-height: 1.4;
	}

	.section-body,
	.state-copy {
		display: block;
		margin-top: 10px;
		font-size: 16px;
		line-height: 1.7;
		color: var(--ink2);
	}

	.fact-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 10px;
		margin-top: 12px;
	}

	.fact-item {
		min-height: 72px;
		padding: 10px;
		border-radius: 12px;
		background: var(--paper);
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 4px;
	}

	.fact-label {
		font-size: 14px;
		color: var(--muted);
	}

	.fact-value {
		font-size: 16px;
		font-weight: 700;
	}

	.expectation-list {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-top: 12px;
	}

	.expectation-item {
		min-height: 48px;
		padding: 8px 14px;
		border: 1px solid var(--line);
		border-radius: 12px;
		background: var(--paper);
		display: flex;
		align-items: center;
		font-size: 16px;
	}

	.state-panel {
		min-height: 180px;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 12px;
		font-size: 16px;
		text-align: center;
	}

	.retry-button {
		min-height: 48px;
		margin: 0;
		padding: 0 18px;
		border-radius: 8px;
		background: var(--accent);
		color: var(--text-invert);
		font-size: 16px;
		font-weight: 700;
		line-height: 48px;
	}

	.detail-actions {
		position: fixed;
		left: 0;
		right: 0;
		bottom: 0;
		z-index: 20;
		display: grid;
		grid-template-columns: 1fr 1.4fr;
		gap: 10px;
		padding: 12px 16px calc(12px + env(safe-area-inset-bottom));
		background: var(--surface);
		border-top: 1px solid var(--line);
	}

	.safety-actions {
		display: flex;
		flex-direction: row;
		gap: 12px;
	}

	.safety-action {
		flex: 1;
		min-height: 48px;
		margin: 0;
		border: 1px solid var(--line);
		border-radius: 12px;
		background: var(--surface);
		color: var(--ink2);
		font-size: 14px;
		line-height: 48px;
	}

	.safety-action::after {
		border: none;
	}

	.detail-action {
		min-height: 48px;
		margin: 0;
		border-radius: 12px;
		font-size: 16px;
		font-weight: 700;
		line-height: 48px;
	}

	.detail-action.secondary {
		background: var(--paper);
		border: 1px solid var(--line);
		color: var(--ink);
	}

	.detail-action.primary {
		background: var(--accent);
		color: var(--text-invert);
	}

	@media (max-width: 360px) {
		.fact-grid {
			grid-template-columns: 1fr;
		}

		.safety-actions {
			flex-direction: column;
		}
	}
</style>
