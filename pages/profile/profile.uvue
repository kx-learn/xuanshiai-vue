<template>
	<view class="page">
		<!-- 导航栏 -->
		<view class="nav-bar" :style="{ paddingTop: (statusBarHeight + 12) + 'px', paddingRight: (menuButtonSpacing + 8) + 'px' }">
			<view class="nav-right">
				<view class="nav-icon-btn role-switch-btn" @tap="onSwitchToParent" aria-label="切换到父母端" title="切换到父母端">
					<text class="ic ic-sys ic-shuaxin nav-icon role-switch-icon"></text>
				</view>
				<view class="nav-icon-btn" @tap="onMessages">
					<text class="ic ic-social ic-tongzhi nav-icon"></text>
				</view>
				<view class="nav-icon-btn" @tap="onSettings">
					<text class="ic ic-me ic-shezhi nav-icon"></text>
				</view>
			</view>
		</view>

		<!-- 滚动内容区 -->
		<scroll-view scroll-y class="content-scroll" enhanced show-scrollbar="false">
			<view class="content-inner">
			<!-- 个人资料头部（横向布局） -->
			<view class="profile-header">
				<view class="avatar-wrap" @tap="onViewMyProfile">
					<image v-if="user.avatar != ''" class="avatar-image" :src="user.avatar" mode="aspectFill"></image>
					<text v-else class="ic ic-social ic-touxiang avatar-icon"></text>
				</view>
				<view class="profile-info">
					<text class="nickname">{{ user.nickname }}</text>
					<view class="vip-tag-row">
						<view v-if="user.isVip" class="vip-tag">
							<text class="vip-tag-text">VIP会员</text>
						</view>
						<text class="vip-tag-desc">{{ user.isVip ? '会员权益有效' : '开通会员解锁更多功能' }}</text>
					</view>
					<view class="progress-row">
						<view class="progress-bar">
							<view class="progress-fill" :style="{ width: user.vipProgress + '%' }"></view>
						</view>
						<text class="progress-percent">{{ user.vipProgress }}%</text>
					</view>
				</view>
				<view class="edit-profile-btn" @tap="onEditProfile">
					<text class="edit-profile-text">编辑资料</text>
					<text class="edit-profile-arrow">›</text>
				</view>
			</view>

			<!-- 统计数据行 -->
			<view class="stats-card">
				<view class="stat-item" v-for="stat in stats" :key="stat.label" @tap="openStatPage(stat.route)">
					<text class="stat-value">{{ stat.value }}</text>
					<text class="stat-label">{{ stat.label }}</text>
				</view>
			</view>

			<!-- AI 专区（墨相师为唯一画像建构入口） -->
			<view class="ai-zone">
				<view class="ai-zone-head">
					<view class="ai-zone-spark">
						<text class="ic ic-home ic-star ai-zone-spark-icon"></text>
					</view>
					<text class="ai-zone-title">宣誓爱 AI</text>
				</view>
				<text class="ai-zone-sub">用对话认识自己与期待的关系，也可以管理你的 AI 分身。</text>
				<view class="ai-zone-actions">
					<view class="zone-btn" @tap="onAiAvatar">
						<text class="ic ic-social ic-huati zone-btn-icon zone-btn-icon-rose"></text>
						<view class="zone-btn-text">
							<text class="zone-btn-name">我的AI分身</text>
							<text class="zone-btn-desc">管理你的数字分身</text>
						</view>
					</view>
				</view>
				<!-- 墨相师·主入口(继续聊) -->
				<view class="zone-master" @tap="onMoxiangMaster">
					<view class="zone-master-figure">
						<text class="zone-master-seal">墨</text>
					</view>
					<view class="zone-master-text">
						<text class="zone-master-name">墨相师 · 聊出你的两幅像</text>
						<text class="zone-master-desc">先认识自己，再聊你期待的关系</text>
					</view>
					<text class="zone-master-arrow">›</text>
				</view>
				<!-- P3-04 我的墨相档案·双入口(看成稿/历史/撤回授权) -->
				<view class="zone-master zone-master-archive" @tap="onMoxiangArchive">
					<view class="zone-master-figure zone-master-figure-archive">
						<text class="zone-master-seal">档</text>
					</view>
					<view class="zone-master-text">
						<text class="zone-master-name">我的墨相档案</text>
						<text class="zone-master-desc">看成稿、历史版本、撤回授权</text>
					</view>
					<text class="zone-master-arrow">›</text>
				</view>
			</view>

			<!-- VIP 会员卡 -->
			<view v-if="!user.isVip" class="vip-card" @tap="onOpenVIP">
				<view class="vip-crown-wrap">
					<text class="ic ic-vip ic-huiyuan vip-crown"></text>
				</view>
				<view class="vip-text-col">
					<text class="vip-card-title">开通会员</text>
					<text class="vip-card-sub">解锁全部功能，遇见更多可能</text>
				</view>
				<text class="ic ic-sys ic-jiantou-you vip-arrow"></text>
			</view>

			<!-- 主菜单 -->
			<view class="menu-card">
				<view class="menu-row" v-for="item in mainMenuItems" :key="item.label" @tap="handleMenuItem(item)">
					<view class="menu-icon-wrap" :style="{ backgroundColor: item.iconBg }">
						<text :class="item.iconClass + ' menu-icon'"></text>
					</view>
					<text class="menu-label">{{ item.label }}</text>
					<view v-if="item.badge" class="menu-badge">
						<text class="menu-badge-text">{{ item.badge }}</text>
					</view>
					<view class="menu-spacer"></view>
					<text class="ic ic-sys ic-jiantou-you menu-arrow"></text>
				</view>
			</view>

			<!-- 底部菜单 -->
			<view class="menu-card">
				<view class="menu-row" v-for="item in bottomMenuItems" :key="item.label" @tap="item.label == '安全中心' ? onSecurity() : handleMenuItem(item)">
					<view class="menu-icon-wrap" :style="{ backgroundColor: item.iconBg }">
						<text :class="item.iconClass + ' menu-icon'"></text>
					</view>
					<view class="menu-text-col">
						<text class="menu-label">{{ item.label }}</text>
						<text v-if="item.subtitle" class="menu-subtitle">{{ item.subtitle }}</text>
					</view>
					<view class="menu-spacer"></view>
					<text class="ic ic-sys ic-jiantou-you menu-arrow"></text>
				</view>
			</view>

			<!-- 底部留白 -->
			<view class="scroll-bottom-spacer"></view>
			</view>
		</scroll-view>
	</view>

	<!-- AI画像悬浮球：墨印印章式，点击按状态分流（有画像成稿→结果页，无→墨相师引导） -->
	<view class="ai-portrait-fab" @tap="onAiPortrait">
		<view class="ai-portrait-fab-ball">
			<view class="ai-portrait-fab-dot"></view>
			<text class="ai-portrait-fab-seal">像</text>
		</view>
		<text class="ai-portrait-fab-label">AI画像</text>
	</view>

	<!-- 邀请分享弹窗：复用“我的任务.pen”的邀请分享弹窗-遮罩 -->
	<view v-if="inviteShareVisible" class="invite-share-mask" @tap="closeInviteShare">
		<view class="invite-share-sheet" @tap.stop>
			<view class="invite-share-handle"></view>
			<text class="invite-share-title">分享邀请好友</text>
			<view class="invite-share-options">
				<view class="invite-share-option" @tap="shareToWechat">
					<view class="invite-share-option-icon invite-share-option-icon-green"><text class="invite-share-symbol">↗</text></view>
					<text class="invite-share-option-label">发送给朋友</text>
				</view>
				<view class="invite-share-option" @tap="goMyPoster">
					<view class="invite-share-option-icon invite-share-option-icon-gold"><text class="invite-share-symbol">▧</text></view>
					<text class="invite-share-option-label">生成海报</text>
				</view>
			</view>
			<text class="invite-share-note">好友通过你的分享卡片/海报完成注册后，邀请人和新好友双方均可获得平台积分，分享可兑现奖励。</text>
			<view class="invite-share-cancel" @tap="closeInviteShare"><text>取消</text></view>
		</view>
	</view>

	<!-- 自定义底部导航栏 -->
	<XsaTabBar />
</template>

<script setup lang="uts">
import XsaTabBar from '@/components/XsaTabBar.uvue'
import { getProfileOverview, getProfileCompletion, getMembershipStatus, getPortraitNarrative } from '@/api'
import { resolveMediaUrl } from '@/api/config.uts'

const systemInfo = uni.getSystemInfoSync()
const statusBarHeight = systemInfo.statusBarHeight != null ? systemInfo.statusBarHeight : 20
const menuButtonInfo = uni.getMenuButtonBoundingClientRect()
const menuButtonSpacing = menuButtonInfo != null ? (systemInfo.windowWidth - menuButtonInfo.left) : 8

const user = ref({
	nickname: '加载中',
	vipProgress: 0,
	isVip: false,
	avatar: '',
})

const stats = ref([
	{ value: '0', label: '我的申请', route: '/pagesSub/profileExtra/applications' },
	{ value: '0', label: '我看过谁/看过我', route: '/pagesSub/profileExtra/visitors' },
	{ value: '0', label: '我的收藏', route: '/pagesSub/profileExtra/favorites' },
	{ value: '0', label: '我的爆灯', route: '/pagesSub/profileExtra/spotlights' },
])

const loadOverview = async () => {
	try {
		const membershipRes = await getMembershipStatus()
		if (membershipRes.success && membershipRes.data != null) {
			user.value.isVip = (membershipRes.data as any).is_vip === true
		}
	} catch (error) {
		console.error('[Profile] membership refresh failed', error)
	}
	const res = await getProfileOverview()
	if (!res.success || res.data == null) return
	const data = res.data as any
	const profile = data.profile != null && typeof data.profile === 'object' ? data.profile : {}
	const account = data.user != null && typeof data.user === 'object' ? data.user : {}
	const nickname = data.nickname != null && data.nickname != ''
		? data.nickname
		: (profile.nickname != null && profile.nickname != '' ? profile.nickname : account.nickname)
	user.value.nickname = nickname != null && nickname != '' ? '' + nickname : '未设置昵称'
	const avatar = data.avatar != null && data.avatar != '' ? data.avatar : (profile.avatar != null && profile.avatar != '' ? profile.avatar : account.avatar)
	user.value.avatar = resolveMediaUrl(avatar)
	user.value.vipProgress = 0
	try {
		const completion = await getProfileCompletion()
		if (completion.success && completion.data != null) {
			const completionData = completion.data as any
			const score = completionData.score != null ? completionData.score : completionData.completion_score
			if (score != null) user.value.vipProgress = Math.round(Number(score))
		}
	} catch (error) {
		console.error('[Profile] completion refresh failed', error)
	}
	const incoming = data.incoming_application_count != null ? Number(data.incoming_application_count) : 0
	const outgoing = data.outgoing_application_count != null ? Number(data.outgoing_application_count) : 0
	stats.value[0].value = '' + (incoming + outgoing)
	stats.value[1].value = data.visitor_count != null ? '' + data.visitor_count : '0'
	stats.value[2].value = data.favorite_count != null ? '' + data.favorite_count : '0'
	stats.value[3].value = data.superlike_sent_count != null ? '' + data.superlike_sent_count : '0'
}

const onMessages = () => {
	uni.showToast({ title: '消息中心', icon: 'none' })
}

const onSettings = () => {
	uni.navigateTo({ url: '/pagesSub/profileExtra/settings' })
}

const onSwitchToParent = () => {
	uni.showModal({
		title: '切换至父母端',
		content: '父母端将使用独立的身份和授权视图。',
		cancelText: '暂不切换',
		confirmText: '确认切换',
		success: (result) => {
			if (result.confirm != true) return
			uni.setStorageSync('xsa_onboarding_mode', 'parent')
			uni.reLaunch({ url: '/pages/parent/parent' })
		}
	})
}

const onViewMyProfile = () => {
	uni.navigateTo({ url: '/pagesSub/userExtra/user/edit' })
}

const onEditProfile = () => {
	uni.navigateTo({
		url: '/pagesSub/userExtra/user/edit',
		fail: () => { uni.showToast({ title: '编辑资料打开失败，请重试', icon: 'none' }) }
	})
}

const onAiPortrait = () => {
	getPortraitNarrative('personal').then((res: any) => {
		const hasPortrait = res != null && res.success == true && res.data != null
		uni.navigateTo({
			url: hasPortrait ? '/pagesSub/profileExtra/my-portrait-result?subject=personal' : '/pagesSub/profileExtra/my-portrait-master?subject=personal',
			fail: () => { uni.showToast({ title: 'AI画像打开失败，请重试', icon: 'none' }) }
		})
	}).catch(() => {
		uni.navigateTo({
			url: '/pagesSub/profileExtra/my-portrait-master?subject=personal',
			fail: () => { uni.showToast({ title: 'AI画像打开失败，请重试', icon: 'none' }) }
		})
	})
}

const onOpenVIP = () => {
	uni.navigateTo({ url: '/pagesSub/profileExtra/vip', fail: () => { uni.showToast({ title: '会员页面打开失败，请重试', icon: 'none' }) } })
}

const onAiAvatar = () => {
	uni.navigateTo({
		url: '/pagesSub/profileExtra/my-ai-avatar',
		fail: () => { uni.showToast({ title: '页面打开失败，请重试', icon: 'none' }) }
	})
}

const onMoxiangMaster = () => {
	uni.navigateTo({
		url: '/pagesSub/profileExtra/my-portrait-master',
		fail: () => { uni.showToast({ title: '墨相师页面打开失败，请重试', icon: 'none' }) }
	})
}

const onMoxiangArchive = () => {
	uni.navigateTo({
		url: '/pagesSub/profileExtra/my-portrait-archive',
		fail: () => { uni.showToast({ title: '档案页面打开失败，请重试', icon: 'none' }) }
	})
}

const openStatPage = (url: string) => { if (url != '') uni.navigateTo({ url }) }

const onMyTasks = () => {
	uni.navigateTo({
		url: '/pagesSub/profileExtra/my-tasks',
		fail: () => { uni.showToast({ title: '页面打开失败，请重试', icon: 'none' }) }
	})
}

const onMyMoments = () => {
	uni.navigateTo({ url: '/pagesSub/profileExtra/my-moments' })
}

const onMyPoster = () => {
	uni.navigateTo({
		url: '/pagesSub/profileExtra/my-posters?userId=9001',
		fail: () => { uni.showToast({ title: '页面打开失败，请重试', icon: 'none' }) }
	})
}

const onMyRegistration = () => {
	uni.navigateTo({
		url: '/pagesSub/profileExtra/my-registration',
		fail: () => { uni.showToast({ title: '页面打开失败，请重试', icon: 'none' }) }
	})
}

const onCertification = () => {
	uni.navigateTo({ url: '/pagesSub/profileExtra/certification' })
}

const onInviteFriend = () => {
	inviteShareVisible.value = true
}

const inviteShareVisible = ref(false)

const closeInviteShare = () => { inviteShareVisible.value = false }

const shareToWechat = () => {
	inviteShareVisible.value = false
	uni.showToast({ title: '已准备好分享内容', icon: 'success' })
}

const goMyPoster = () => {
	inviteShareVisible.value = false
	uni.navigateTo({
		url: '/pagesSub/profileExtra/my-posters?userId=9001',
		fail: () => { uni.showToast({ title: '页面打开失败，请重试', icon: 'none' }) }
	})
}

const onMenuSettings = () => {
	uni.navigateTo({ url: '/pagesSub/profileExtra/settings' })
}

const onHelp = () => {
	uni.navigateTo({ url: '/pagesSub/profileExtra/help', fail: () => { uni.showToast({ title: '客服与帮助打开失败，请重试', icon: 'none' }) } })
}

const onAbout = () => {
	uni.navigateTo({ url: '/pagesSub/about/about' })
}

const onSecurity = () => {
	uni.navigateTo({
		url: '/pagesSub/profileExtra/security',
		animationType: 'slide-in-right',
		fail: (err) => {
			console.log('安全中心导航失败', err)
			uni.showToast({ title: '安全中心暂不可用，请重试', icon: 'none' })
		}
	})
}

const handleMenuItem = (item: any) => {
	if (item == null) return
	const directUrl = item.url != null ? '' + item.url : ''
	if (directUrl != '') {
		uni.navigateTo({ url: directUrl, fail: () => { uni.showToast({ title: '页面打开失败，请重试', icon: 'none' }) } })
		return
	}
	const label = item.label != null ? '' + item.label : ''
	if (label == '客服与帮助') {
		onHelp()
	} else if (label == '安全中心') {
		onSecurity()
	} else if (label == '设置') {
		onMenuSettings()
	} else if (label == '关于我们') {
		onAbout()
	} else if (label == '我的动态') {
		onMyMoments()
	} else if (label == '诚信认证') {
		onCertification()
	} else if (label == '会员中心') {
		onOpenVIP()
	} else if (item.action != null) {
		item.action()
	}
}

const onEmotionLab = () => {
	uni.navigateTo({ url: '/pages/emotion-lab/emotion-lab' })
}

const mainMenuItems = [
	{ iconClass: 'ic ic-vip ic-renwu', iconBg: '#EDE4F0', label: '我的任务', badge: 'NEW', action: onMyTasks },
	{ iconClass: 'ic ic-me ic-dongtai', iconBg: '#E4EDE8', label: '我的动态', action: onMyMoments },
	{ iconClass: 'ic ic-home ic-heart', iconBg: '#FDE8EC', label: '我的海报', action: onMyPoster },
	{ iconClass: 'ic ic-social ic-huodong', iconBg: '#FEF3E4', label: '我的报名', action: onMyRegistration },
	{ iconClass: 'ic ic-sys ic-shiming', iconBg: '#FEF3E4', label: '诚信认证', action: onCertification },
	{ iconClass: 'ic ic-sys ic-fenxiang', iconBg: '#FEF3E4', label: '推荐给好友', action: onInviteFriend },
	{ iconClass: 'ic ic-home ic-star', iconBg: '#E4EDE8', label: '情感实验室', action: onEmotionLab },
	{ iconClass: 'ic ic-me ic-shezhi', iconBg: '#FEF3E4', label: '设置', action: onMenuSettings },
]

const bottomMenuItems = [
	{ iconClass: 'ic ic-me ic-kefu', iconBg: '#F7F4F0', label: '客服与帮助', subtitle: 'AI客服 . 意见反馈', action: onHelp },
	{ iconClass: 'ic ic-me ic-bangzhu', iconBg: '#F7F4F0', label: '关于我们', subtitle: '版本 1.0.0', action: onAbout },
	{ iconClass: 'ic ic-sys ic-shiming', iconBg: '#FEF3E4', label: '安全中心', url: '/pagesSub/profileExtra/security', action: onSecurity },
]

onShow(() => { loadOverview() })
</script>

<style>
/* ==================== 页面级 CSS 变量 & 基础样式 ==================== */
/* 注意：此块不加 scoped，让 CSS 变量能在整页生效 */

page {
	--profile-bg: #F7F4F0;
	--profile-card: #FFFFFF;
	--profile-dark: #3A3A3A;
	--profile-accent: #8FA88A;
	--profile-rose: #D4A89E;
	--profile-text: #2C2C2C;
	--profile-text-secondary: #8E8E8A;
	--profile-text-muted: #C5C3BE;
	--profile-text-inverse: #FFFFFF;
	--profile-vip-sub: #B0B0B0;
	background-color: var(--profile-bg);
}

/* ==================== 页面容器 ==================== */
.page {
	position: relative;
	width: 100%;
	min-height: 100vh;
	background-color: var(--profile-bg);
	display: flex;
	flex-direction: column;
}


/* ==================== 导航栏 ==================== */
.nav-bar {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: flex-end;
	padding: 12px 16px 16px 16px;
}

.nav-title {
	font-size: 17px;
	font-weight: 600;
	color: var(--profile-text);
}

.nav-right {
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 8px;
}

.nav-icon-btn {
	width: 36px;
	height: 36px;
	border-radius: 18px;
	background-color: var(--profile-bg);
	display: flex;
	align-items: center;
	justify-content: center;
}

.nav-icon {
	font-size: 16px;
}

.role-switch-btn {
	background-color: #E4EDE8;
}

.role-switch-icon {
	color: var(--profile-accent);
}

/* ==================== 滚动内容区 ==================== */
.content-scroll {
	flex: 1;
}

.content-inner {
	display: flex;
	flex-direction: column;
	gap: 24px;
	padding: 0 24px;
}

/* ==================== 个人资料头部 ==================== */
.profile-header {
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 14px;
	width: 100%;
	padding-top: 8px;
}

/* ==================== 编辑资料入口（描边胶囊） ==================== */
.edit-profile-btn {
	flex-shrink: 0;
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 3px;
	padding: 6px 12px;
	border: 1px solid var(--profile-accent);
	border-radius: 999px;
	background-color: var(--profile-card);
}

.edit-profile-text {
	font-size: 12px;
	font-weight: 500;
	color: var(--profile-accent);
	line-height: 1.4;
}

.edit-profile-arrow {
	font-size: 13px;
	color: var(--profile-accent);
	line-height: 1.4;
}

/* ==================== AI画像悬浮球（墨印印章式） ==================== */
.ai-portrait-fab {
	position: fixed;
	right: 28rpx;
	bottom: 220rpx;
	z-index: 30;
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: 6rpx;
}

.ai-portrait-fab-ball {
	position: relative;
	width: 104rpx;
	height: 104rpx;
	border-radius: 52rpx;
	background-color: #FFFFFF;
	border: 2rpx solid #E3D3CC;
	box-shadow: var(--shadow-md);
	display: flex;
	align-items: center;
