	/* 三个入口卡片：底色/纹理取自参考图实测（纸色 #E1E7E1，纤维颗粒 sd≈2.5%%）。
	   贴图是 tools/paper_tex.py 按参考图统计特征合成的无缝平铺图，
	   源文件 static/textures/join-entry-paper.png；小程序 wxss 不能引用本地图片，故内联 base64。
	   尺寸 96rpx 让纹理在 3x 屏上约 1.5 倍放大，颗粒落在 2~3 物理像素，与参考图在手机上等大时的观感一致。 */
	.join-entry {
		position: relative;
		flex: 1;
		min-width: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 12rpx;
		padding: 20rpx 8rpx 18rpx;
		border-radius: 20rpx;
		background-color: #E1E7E1;
		background-image: url("data:image/png;base64,");
		background-repeat: repeat;
		background-size: 96rpx 96rpx;
		box-shadow: 0 7rpx 18rpx rgba(21, 74, 69, 0.10);
		border: 1px solid #D9E1D9;
	}

	/* 三张卡错开贴图原点，避免并排时露出同一块纹理 */
	.join-entry:nth-child(2) {
		background-position: -31rpx -17rpx;
	}

	.join-entry:nth-child(3) {
		background-position: -62rpx -34rpx;
	}

	/* 三个入口图标：深墨圆底 + 白色手绘线条（参考手作涂鸦风格），尺寸随屏幕等比 */
	.join-entry-icon {
		width: 80rpx;
		height: 80rpx;
	}

	.join-entry-label {
		font-size: 22rpx;
		font-weight: 700;
		color: var(--match-deep);
		text-align: center;
		line-height: 1.35;
	}

	.custom-apply-safe {
		position: fixed;
		left: 0;
		right: 0;
		bottom: 0;
		padding: 16rpx 24rpx calc(env(safe-area-inset-bottom) + 16rpx);
		background: rgba(250, 252, 252, 0.96);
		border-top: 1px solid var(--line);
		z-index: 30;
	}

	.custom-apply-button {
