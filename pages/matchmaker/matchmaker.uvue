<template>
	<view class="matchmaker-page">
		<view class="page-shell">
			<view class="page-head">
				<view class="hero-net">
					<view
						v-for="(lineStyle, li) in heroLineStyles"
						:key="li"
						class="hero-line"
						:style="lineStyle"
					></view>
					<view
						v-for="(dotStyle, di) in heroDotStyles"
						:key="di"
						class="hero-dot"
						:style="dotStyle"
					></view>
				</view>
				<text class="page-kicker">星河牵线</text>
				<text class="page-desc">每颗星都沿着自己的直线前行，谁也说不清哪一刻会靠近谁。可当它们真的靠近时，那一瞬间亮起的线，就是缘分被世界看见的样子。</text>
			</view>

			<view class="page-tabs">
				<view class="matchmaker-tab-bar">
					<view
						v-for="(tab, index) in tabs"
						:key="tab"
						class="matchmaker-tab"
						:class="{ active: currentTabIndex === index }"
						@click="handleTabChange(index)"
					>
						<text>{{ tab }}</text>
					</view>
				</view>
			</view>

			<scroll-view class="page-scroller" scroll-y enhanced :show-scrollbar="false">
				<view class="page-content" :class="{ 'service-page-content': currentTabValue === 'service' }">
					<view class="error-card" v-if="loadError.length > 0">
						<text class="error-title">部分内容加载失败</text>
						<text class="error-desc">{{ loadError }}</text>
						<view class="error-button" @click="reloadPage">
							<text>重新加载</text>
						</view>
					</view>

					<view v-if="currentTabValue === 'service'" class="tab-panel">
						<LiveMatchmakingPanel />
						<view class="service-empty" @click="uni.navigateTo({ url: '/pagesSub/live/lobby' })">
							<text class="section-title">四轮直播相亲 · 受邀场次</text>
							<text class="section-desc">查看邀请、预约与场次安排。业务演练会明确标注无音视频。</text>
						</view>
						<view class="service-showcase">
							<view class="section-header service-showcase-header">
								<view>
									<text class="section-title">服务红娘</text>
									<text class="section-desc">专业顾问会先理解你的关系目标，再决定如何帮你更稳地认识一个人。</text>
								</view>
							</view>

							<view v-if="serviceMatchmakers.length === 0 && !pageLoading" class="service-empty">
								<XsaEmpty
									text="暂无服务红娘"
									description="稍后再来看看，我们正在整理最新排期。"
									size="small"
								/>
							</view>

							<scroll-view v-else scroll-x enhanced :enable-flex="true" :show-scrollbar="false" class="service-card-scroll">
								<view class="service-card-list" :style="'width: ' + serviceCardListWidth + 'rpx;'">
									<view v-for="item in serviceMatchmakers" :key="item.id" class="service-card-item">
										<MatchmakerCard
											:data="item"
											actionText="联系她"
											@detail="handleMatchmakerDetail"
											@contact="handleMatchmakerContact"
										/>
									</view>
								</view>
							</scroll-view>
						</view>

						<MatchmakerRank v-if="rankList.length > 0" :list="rankList" @item-click="handleMatchmakerDetail" />
					<view class="join-entry-row">
						<view class="join-entry" @click="handleBecomeMatchmaker">
							<image class="join-entry-icon" src="/static/icons/join-matchmaker.png" mode="aspectFit"></image>
							<text class="join-entry-label">我要做红娘</text>
						</view>
						<view class="join-entry" @click="handleBecomePartner">
							<image class="join-entry-icon" src="/static/icons/join-partner.png" mode="aspectFit"></image>
							<text class="join-entry-label">申请合伙人</text>
						</view>
						<view class="join-entry" @click="handleBecomePromoter">
							<image class="join-entry-icon" src="/static/icons/join-promoter.png" mode="aspectFit"></image>
							<text class="join-entry-label">推广红娘</text>
						</view>
					</view>

						<view class="notice-card">
							<text class="notice-title">服务说明</text>
							<text class="notice-text">红娘只帮助你梳理资料、匹配对象与安排节奏，不替双方自动同意，也不会承诺关系结果。</text>
						</view>
					</view>

					<view v-if="currentTabValue === 'custom'" class="tab-panel">
						<view class="custom-home-hero">
							<image class="custom-home-hero-art" src="/static/generated/matchmaker-custom-calligraphy.webp" mode="aspectFill"></image>
							<view class="custom-home-copy">
								<text class="custom-home-kicker">私人定制服务</text>
								<text class="custom-home-title">专属红娘，认真陪你靠近</text>
								<text class="custom-home-desc">从需求梳理、候选筛选到见面反馈，全程跟进每一个关键节点。</text>
							</view>
						</view>

						<view class="section-header">
							<view><text class="section-title">服务套餐</text><text class="section-desc">选择适合自己的服务节奏</text></view>
						</view>

						<XsaEmpty v-if="customPlans.length === 0 && !pageLoading" text="暂无定制方案" description="方案内容整理中。" size="small" />
						<scroll-view
							v-if="customPlans.length > 0"
							scroll-x
							enhanced
							:enable-flex="true"
							class="custom-home-plan-scroll"
							:show-scrollbar="false"
						>
							<view class="custom-home-plan-list" :style="'width: ' + customPlanListWidth + 'rpx;'">
								<view v-for="item in customPlans" :key="item.id" class="custom-home-plan" :class="{ selected: selectedCustomPlanId === item.id }" @click="selectCustomPlan(item)">
									<view v-if="selectedCustomPlanId === item.id" class="custom-home-plan-selected-badge"><text>已选</text></view>
									<view class="custom-home-plan-title-row">
										<text class="custom-home-plan-name">{{ item.name }}</text>
										<text v-if="item.tag" class="custom-home-plan-recommend"><text>{{ item.tag }}</text></text>
									</view>
									<view class="custom-home-plan-price"><text>¥{{ item.price }}</text></view>
									<text class="custom-home-plan-duration">{{ item.duration }}</text>
									<text class="custom-home-plan-feature">{{ item.features[0] }}</text>
									<text class="custom-home-plan-copy">{{ item.description }}</text>
								</view>
							</view>
						</scroll-view>

					<view v-if="currentTabValue === 'custom'" class="join-entry-row">
						<view class="join-entry" @click="handleBecomeMatchmaker">
							<image class="join-entry-icon" src="/static/icons/join-matchmaker.png" mode="aspectFit"></image>
							<text class="join-entry-label">我要做红娘</text>
						</view>
						<view class="join-entry" @click="handleBecomePartner">
							<image class="join-entry-icon" src="/static/icons/join-partner.png" mode="aspectFit"></image>
							<text class="join-entry-label">申请合伙人</text>
						</view>
						<view class="join-entry" @click="handleBecomePromoter">
							<image class="join-entry-icon" src="/static/icons/join-promoter.png" mode="aspectFit"></image>
							<text class="join-entry-label">推广红娘</text>
						</view>
					</view>

					</view>

				</view>
			</scroll-view>
		</view>

		<view v-if="currentTabValue === 'custom'" class="custom-apply-safe">
			<view class="custom-apply-button" @click="applyCustomPlan">
				<text>立即申请私人定制</text>
			</view>
		</view>

	</view>

	<!-- 自定义底部导航栏 -->
	<XsaTabBar />
</template>


<script setup lang="uts">
import XsaTabBar from '@/components/XsaTabBar.uvue'
	import LiveMatchmakingPanel from '@/components/LiveMatchmakingPanel.uvue'
	import XsaEmpty from '@/components/XsaEmpty.uvue'
	import MatchmakerCard from '@/components/MatchmakerCard.uvue'
	import MatchmakerRank from '@/components/MatchmakerRank.uvue'
	import {
		getServiceMatchmakers,
		getVolunteerMatchmakers,
		getCustomPlans
	} from '@/api'

	const tabs = ['服务红娘', '私人定制']
	const tabValues = ['service', 'custom']
	const customHomeValues = [
		{ mark: '准', title: '精准匹配', copy: '根据关系期待筛选候选对象。' },
		{ mark: '专', title: '专属服务', copy: '一位红娘持续跟进反馈。' },
		{ mark: '密', title: '隐私保护', copy: '资料只在必要范围内展示。' }
	]
	const customHomeServices = [
		{ title: '无需注册曝光', copy: '服务期间减少无关曝光。' },
		{ title: '深度了解会员', copy: '梳理目标、方式与边界。' },
		{ title: '开放隐藏会员', copy: '匹配更合适的隐藏资料。' },
		{ title: '红娘精准推荐', copy: '结合资料和反馈推荐。' },
		{ title: '个人形象指导', copy: '优化介绍、沟通与见面状态。' },
		{ title: '安排线下见面', copy: '协助沟通首次见面安排。' },
		{ title: '反馈约见结果', copy: '复盘感受并调整方向。' }
	]
	const customHomeSteps = [
		{ title: '提交申请', copy: '填写期待' },
		{ title: '红娘联系', copy: '确认需求' },
		{ title: '需求分析', copy: '梳理方向' },
		{ title: '精准匹配', copy: '推荐对象' },
		{ title: '安排见面', copy: '双方沟通' },
		{ title: '持续跟进', copy: '反馈复盘' }
	]
	const currentTabIndex = ref(0)
	const pageLoading = ref(false)
	const loadError = ref('')
	const serviceMatchmakers = ref<any[]>([])
	const rankList = ref<any[]>([])
	const customPlans = ref<any[]>([])
	const selectedCustomPlanId = ref(0)

	const currentTabValue = computed(() => {
		return tabValues[currentTabIndex.value]
	})

	const serviceCardListWidth = computed((): number => {
		const count = serviceMatchmakers.value.length
		if (count == 0) return 0
		return count * 278 + (count - 1) * 16 + 52
	})

	const customPlanListWidth = computed((): number => {
		const count = customPlans.value.length
		if (count == 0) return 0
		if (count == 1) return 300
		return count * 300 + (count - 1) * 14 + 32
	})

	// ===== zurb 式点线网络：一整片「星网」，每颗星沿自己的**一条直线**往返 =====
	// ① 轨迹只有一条直线：每颗星由 { ang 方向角, len 线段全长, spd 峰值速度, ph 起始相位 } 决定，
	//    x 与 y 由同一个 sin 驱动 → 严格直线，不存在此前的二维曲线与「闪到另一条路线」的跳变。
	// ② 每颗星自带明灭：缓慢渐入 → 全亮 → 缓慢渐出 → 完全消失，四段时长见 HERO_FI/BI/FO
	//    （单次渐变约 3~4.5s，smoothstep 缓动，两端与全亮/全黑段无缝衔接）。
	//    消失期间它仍在自己的直线上继续走，所以重新出现时是接着走的，不会「闪到别处」。
	// ③ 任意两颗星只要靠近（272rpx 内）就自动连线，一颗星同时挂 3 条左右，
	//    于是各处的星会随时连成一片、又随之明灭而整片重排。
	// 9 颗小星（r 5~14rpx，直径 10~28rpx），初始按「4 + 3 + 2」铺满分给星网的那条带子
	// （见 HERO_BOUND_Y0/Y1：只在「星河牵线」上方活动，不会压到文案）。
	// 三行 y 由 88/162/236 收拢到 72/118/164 —— 带子矮了，行距同步压紧。
	const heroParticles = [
		{ cx: 104, cy: 72, r: 12, ang: 14, len: 146, spd: 30, ph: 0.00, fw: 0.42 },
		{ cx: 264, cy: 72, r: 7, ang: 58, len: 170, spd: 36, ph: 0.37, fw: 0.55 },
		{ cx: 424, cy: 72, r: 9, ang: -34, len: 170, spd: 28, ph: 0.62, fw: 0.36 },
		{ cx: 584, cy: 72, r: 14, ang: 104, len: 150, spd: 32, ph: 0.15, fw: 0.48 },
		{ cx: 184, cy: 118, r: 6, ang: 96, len: 170, spd: 38, ph: 0.80, fw: 0.58 },
		{ cx: 344, cy: 118, r: 10, ang: 8, len: 190, spd: 26, ph: 0.45, fw: 0.40 },
		{ cx: 504, cy: 118, r: 5, ang: 140, len: 170, spd: 34, ph: 0.05, fw: 0.52 },
		{ cx: 264, cy: 164, r: 6, ang: -20, len: 170, spd: 29, ph: 0.70, fw: 0.34 },
		// 原来 72°（近乎竖直）：带子矮了以后竖直方向余量太小，行程会被压到 ~30rpx，
		// 这颗星看上去几乎不动 —— 改成 60°，斜率还在，行程回到 ~40rpx。
		{ cx: 424, cy: 164, r: 7, ang: 60, len: 140, spd: 36, ph: 0.28, fw: 0.63 }
	]
	// 速度总开关：所有星星的移动快慢只由这一个数决定（>1 更快）
	const HERO_SPEED = 1.0
	const HERO_LINE_BASE = 700
	// 连线阈值（rpx）：距离进入 300 内开始出现、超出 300 完全熄灭，淡出带 100。
	// 阈值比「最近邻」放得宽，是为了让每颗星除了 2~3 条亮线，还挂着若干条很淡的外围线
	// —— 线的浓度因此有层次（不是齐刷刷一个亮度），网络也不会在几颗星同时走暗时整个空掉。
	const HERO_LINK_MAX = 300
	const HERO_LINK_FADE = 100
	// 线的亮度上限。配合下面 0.10 的底亮度，近线的「深」端更实，
	// 于是同屏的线能拉开「很淡 ↔ 很亮」的对比，而不是糊成一片灰。
	const HERO_LINE_ALPHA = 0.95
	const HERO_TICK_MS = 33
	// 明灭时间表：把一个周期的相位 0~1 切成四段 ——
	//   0~FI 渐入 ｜ FI~BI 全亮 ｜ BI~FO 渐出 ｜ FO~1 全黑
	// 不用正弦：正弦在两端（全黑/全亮）停留很久、中间扫得飞快，观感就是「长时间没动静 →
	// 忽然亮起又忽然灭掉」。改成按时长切段后，渐入/渐出各占 30% 周期
	// （fw≈0.42 时周期 15s → 单次渐变约 4.5s），且 smoothstep 两端导数为 0，
	// 与「全亮」「全黑」两段无缝衔接，看不到任何硬起硬落。
	const HERO_FI = 0.30
	const HERO_BI = 0.62
	const HERO_FO = 0.92
	// rpx → px 系数。小程序视图层把 rpx 换算成 px 时会取整到「整像素」，
	// 而粒子每帧只走约 0.2px —— 取整后就变成「攒够 1px 才跳一次」，这正是抖动的真凶。
	// 所以每帧变化的位移一律换算成小数 px 直接下发（实测 px 的小数不会被丢）。
	const heroRpx = uni.getSystemInfoSync().windowWidth / 750
	// 全场两两配对（n=9 → 36 对，顺序固定），每对线对应一个固定的角度累计槽位。
	// 用两个平行数组而不是二维数组：uni-app-x 的 uts 对嵌套数组类型推断更挑剔。
	const heroPairA : number[] = []
	const heroPairB : number[] = []
	const buildHeroPairs = () => {
		for (let i = 0; i < heroParticles.length; i++) {
			for (let j = i + 1; j < heroParticles.length; j++) {
				heroPairA.push(i)
				heroPairB.push(j)
			}
		}
	}
	buildHeroPairs()
	// 每颗星的运行时状态：
	//   heroFadePh —— 明灭相位（错开，避免所有星同时熄灭）
	//   heroDirX/Y —— 直线方向的单位向量（由 ang 预计算，省掉每帧的三角函数）
	//   heroHalf   —— 半程长度（rpx）：由 hero 可见区裁出来，保证线段整体不出框
	const heroFadePh : number[] = []
	const heroDirX : number[] = []
	const heroDirY : number[] = []
	const heroHalf : number[] = []
	// hero-net 的可见区（rpx）：星心含半径不得越出，否则会贴边或被裁掉。
	const HERO_BOUND_X0 = 30
	const HERO_BOUND_X1 = 664
	// 纵向边界 = 星网的「活动带」上下沿。上沿离卡片顶 24rpx、下沿 204rpx，
	// 而「星河牵线」从 228rpx 起（= .page-head 的 padding-top），中间留 24rpx 净空 ——
	// 星星与连线被这条带子箍住，永远不会盖到文案上。改高度时这三处要一起动：
	// HERO_BOUND_Y1 / .hero-net{height} / .page-head{padding-top}。
	const HERO_BOUND_Y0 = 24
	const HERO_BOUND_Y1 = 204
	const initHeroState = () => {
		for (let i = 0; i < heroParticles.length; i++) {
			const p = heroParticles[i]
			const rad = p.ang * Math.PI / 180
			const ux = Math.cos(rad)
			const uy = Math.sin(rad)
			heroDirX.push(ux)
			heroDirY.push(uy)
			// 沿 ±u 两个方向各能走多远才碰壁，取较短的那个当半程 → 线段关于中点对称、永不出框。
			// 半径也算进去（x0/x1 等已按 r 内缩），所以星边不会蹭到 hero 边界。
			const x0 = HERO_BOUND_X0 + p.r
			const x1 = HERO_BOUND_X1 - p.r
			const y0 = HERO_BOUND_Y0 + p.r
			const y1 = HERO_BOUND_Y1 - p.r
			const plusX = ux > 0 ? (x1 - p.cx) / ux : (ux < 0 ? (x0 - p.cx) / ux : 99999)
			const plusY = uy > 0 ? (y1 - p.cy) / uy : (uy < 0 ? (y0 - p.cy) / uy : 99999)
			const minusX = ux > 0 ? (p.cx - x0) / ux : (ux < 0 ? (p.cx - x1) / ux : 99999)
			const minusY = uy > 0 ? (p.cy - y0) / uy : (uy < 0 ? (p.cy - y1) / uy : 99999)
			let half = p.len / 2
			if (plusX < half) half = plusX
			if (plusY < half) half = plusY
			if (minusX < half) half = minusX
			if (minusY < half) half = minusY
			if (half < 20) half = 20
			heroHalf.push(half)
			// 明灭相位错开，避免所有星同时熄灭（2.399 是黄金角 → 相位在周期上分布最均匀）
			heroFadePh.push(i * 2.399 + 2.0)
		}
	}
	initHeroState()
	const emptyStyles = (n : number) : string[] => {
		const out : string[] = []
		for (let i = 0; i < n; i++) out.push('')
		return out
	}
	// 累计角度（不归一化）：atan2 在 ±180° 处会突变，直接用会让线在跨越时“甩”一下；
	// 这里把每帧角度拉到上一帧附近最近的等价角，保证旋转始终走最近的小弧。
	const heroAngles : number[] = []
	const heroDotStyles = ref<string[]>(emptyStyles(heroParticles.length))
	const heroLineStyles = ref<string[]>(emptyStyles(heroPairA.length))
	let heroTimer = -1
	const heroStartAt = Date.now()

	const heroTick = () => {
		const tf = (Date.now() - heroStartAt) / 1000
		const xs : number[] = []
		const ys : number[] = []
		const ops : number[] = []
		const dotStyles : string[] = []
		const n = heroParticles.length
		for (let i = 0; i < n; i++) {
			const p = heroParticles[i]
			// ---- 明灭：缓慢渐入 → 全亮 → 缓慢渐出 → 完全消失 ----
			// 位置不受明灭影响（见下），所以重新出现时星是接着原来那条路线继续走的。
			// 相位按时长切成四段（见顶部 HERO_FI/BI/FO），渐入渐出用 smoothstep：
			// 两端导数为 0，接上「全亮」「全黑」两段是平滑的，不会出现一亮一灭的硬切。
			let ph = (tf * p.fw + heroFadePh[i]) / 6.2831853
			ph = ph - Math.floor(ph)
			let op = 0
			if (ph < HERO_FI) {
				const q = ph / HERO_FI
				op = q * q * (3 - 2 * q)
			} else if (ph < HERO_BI) {
				op = 1
			} else if (ph < HERO_FO) {
				const q = (HERO_FO - ph) / (HERO_FO - HERO_BI)
				op = q * q * (3 - 2 * q)
			}
			ops.push(op)
			// ---- 轨迹：沿自己那一条固定直线做简谐往返 ----
			// x 与 y 由**同一个** sin 驱动（相位一致）→ 轨迹严格是一条直线，不是二维曲线。
			// 简谐（而非线性三角波）的好处：端点是速度自然趋零再折回，
			// 不会像线性往返那样在尽头「硬弹」一下。位置/速度全程连续。
			// 角速度按 half 反算，使峰值线速度正好等于 p.spd（rpx/秒），半程短的星不会显得更快。
			const half = heroHalf[i]
			const w = p.spd / half
			const off = half * Math.sin(tf * HERO_SPEED * w + p.ph * 6.2831853)
			const x = p.cx + heroDirX[i] * off
			const y = p.cy + heroDirY[i] * off
			xs.push(x)
			ys.push(y)
			const d = (p.r * 2 * heroRpx).toFixed(2)
			// 全部换算成小数 px：小程序的 rpx 换算会取整，直接发 rpx 就等于把位置量化到整像素。
			// translate3d 而非 translate：提升为合成层，靠合成器做亚像素位移，不走主线程重绘。
			const dop = Math.round(op * 1000) / 1000
			dotStyles.push(`width:${d}px;height:${d}px;transform:translate3d(${((x - p.r) * heroRpx).toFixed(2)}px,${((y - p.r) * heroRpx).toFixed(2)}px,0);opacity:${dop}`)
		}
		const lineStyles : string[] = []
		for (let k = 0; k < heroPairA.length; k++) {
			const i = heroPairA[k]
			const j = heroPairB[k]
			// 任一端星星变暗，这条线就跟着变淡；星彻底消失时线正好归零（没有任何硬切）。
			const endOp = ops[i] < ops[j] ? ops[i] : ops[j]
			const dx = xs[j] - xs[i]
			const dy = ys[j] - ys[i]
			const dist = Math.sqrt(dx * dx + dy * dy)
			const raw = (HERO_LINK_MAX - dist) / HERO_LINK_FADE
			const dfLin = raw <= 0 ? 0 : (raw >= 1 ? 1 : raw)
			// 距离因子取平方：线一离开「最近」就快速暗淡下去。
			// 线性映射下中距离的线仍有大半亮度，「淡的线」淡不下来；平方后
			// 近线依旧饱满、远线迅速隐没，明暗层次才拉得开（配合 CSS 的两端渐隐，
			// 一条线本身也在「淡→深→淡」地起伏）。
			const df = dfLin * dfLin
			// 线的亮度 = 距离因子 × 星的存活度 lv(endOp)。
			// lv 用「endOp≥0.62 时为 1，再往下平滑归零」的曲线：星大半时间处在全亮段，
			// 线就一直实；星一旦开始明显变暗，线连续地跟着暗下去，直到星完全消失时正好归零。
			// 旧版这里是 `0.10 + 0.90 × endOp` 的固定底亮度 —— 星灭到阈值时线还有约 10% 亮度，
			// 然后被硬切成 0，一帧之间跳掉，非常突兀；现在全程连续，没有台阶。
			const lvRaw = endOp / 0.62
			const lvLin = lvRaw <= 0 ? 0 : (lvRaw >= 1 ? 1 : lvRaw)
			const lv = lvLin * lvLin * (3 - 2 * lvLin)
			const alpha = Math.round(df * lv * HERO_LINE_ALPHA * 1000) / 1000
			if (alpha <= 0.008) {
				lineStyles.push('opacity:0')
				continue
			}
			// 角度始终连续累计（即使这条线这帧不亮），重新亮起时不会因为角度槽位过期而错位
			let ang = Math.atan2(dy, dx) * 180 / Math.PI
			if (k < heroAngles.length) {
				const prev = heroAngles[k]
				ang = prev + ((ang - prev) % 360 + 540) % 360 - 180
			}
			heroAngles[k] = ang
			// 角度保留一位小数：0.1° 在 170rpx 长的线上只有 0.3rpx 端点位移，
			// 肉眼看不出台阶，但能保证线的旋转是连续推进而不是逐格跳。
			const scale = dist / HERO_LINE_BASE
			lineStyles.push(`transform:translate3d(${(xs[i] * heroRpx).toFixed(2)}px,${(ys[i] * heroRpx).toFixed(2)}px,0) rotate(${ang.toFixed(1)}deg) scaleX(${scale.toFixed(3)});opacity:${alpha}`)
		}
		heroDotStyles.value = dotStyles
		heroLineStyles.value = lineStyles
	}

	const startHeroNet = () => {
		if (heroTimer != -1) return
		// 首帧在首次渲染前就算好，元素不会从初始位置「飞入」，因此不需要任何补间过渡
		heroTick()
		heroTimer = setInterval(heroTick, HERO_TICK_MS)
	}

	const stopHeroNet = () => {
		if (heroTimer != -1) {
			clearInterval(heroTimer)
			heroTimer = -1
		}
	}

	onMounted(() => {
		reloadPage()
		startHeroNet()
	})

	onUnmounted(() => {
		stopHeroNet()
	})

	// 页面被覆盖/切走时暂停帧循环，回到前台再续上（省掉无意义的 setData）
	onHide(() => {
		stopHeroNet()
	})

	onShow(() => {
		startHeroNet()
	})

	const handleTabChange = (index : number) => {
		if (tabValues[index] === 'custom') {
			uni.navigateTo({
				url: '/pagesSub/matchmaker/custom'
			})
			return
		}
		currentTabIndex.value = index
	}

	const reloadPage = async () => {
		pageLoading.value = true
		loadError.value = ''
		try {
			await Promise.all([
				loadServiceMatchmakers(),
				loadMatchmakerRanking(),
				loadCustomContent()
			])
		} catch (e) {
			loadError.value = '页面已展示可用内容，但有少量模块暂时未加载完整。'
		} finally {
			pageLoading.value = false
		}
	}

	const loadServiceMatchmakers = async () => {
		try {
			const res = await getServiceMatchmakers()
			if (res.success && res.data != null) {
				serviceMatchmakers.value = res.data as any[]
			} else if (loadError.value.length == 0) {
				loadError.value = '网络连接不可用，请检查网络后重新加载。'
			}
		} catch (e) {
			if (loadError.value.length == 0) {
				loadError.value = '服务红娘数据加载失败。'
			}
		}
	}

	const loadMatchmakerRanking = async () => {
		try {
			const res = await getVolunteerMatchmakers()
			if (res.success && res.data != null) {
				rankList.value = res.data as any[]
			} else if (loadError.value.length == 0) {
				loadError.value = '红娘排行榜加载失败，请稍后重试。'
			}
		} catch (e) {
			if (loadError.value.length == 0) {
				loadError.value = '红娘排行榜加载失败，请稍后重试。'
			}
		}
	}

	const loadCustomContent = async () => {
		try {
			const planRes = await getCustomPlans()
			if (planRes.success && planRes.data != null) {
				customPlans.value = planRes.data as any[]
			} else if (loadError.value.length == 0) {
				loadError.value = '网络连接不可用，请检查网络后重新加载。'
			}
		} catch (e) {
			if (loadError.value.length == 0) {
				loadError.value = '私人定制内容加载失败。'
			}
		}
	}

	const handleMatchmakerDetail = (item : any) => {
		uni.navigateTo({
			url: '/pagesSub/matchmaker/detail?id=' + item.id
		})
	}

	const handleMatchmakerContact = (item : any) => {
		uni.navigateTo({
			url: '/pagesSub/matchmaker/detail?id=' + item.id
		})
	}

	const handleSelectPlan = (item : any) => {
		uni.navigateTo({
			url: '/pagesSub/matchmaker/custom?id=' + item.id
		})
	}

	const goCustomPlans = () => {
		uni.navigateTo({
			url: '/pagesSub/matchmaker/custom'
		})
	}

	const selectCustomPlan = (item : any) => {
		selectedCustomPlanId.value = item.id
	}

	const applyCustomPlan = () => {
		const plan = customPlans.value.find((p: any) => p.id == selectedCustomPlanId.value)
		if (plan == null) {
			uni.showToast({ title: '请先选择服务套餐', icon: 'none' })
			return
		}
		const name = plan.name
		uni.navigateTo({
			url: '/pagesSub/matchmaker/apply?type=custom&matchmakerName=' + encodeURIComponent(name)
				+ '&planId=' + plan.id
				+ '&planName=' + encodeURIComponent(name)
				+ '&planPrice=' + plan.price
				+ '&planDuration=' + encodeURIComponent(plan.duration)
		})
	}

	const showCustomHomeDetail = (item : any) => {
		uni.showModal({ title: item.title, content: item.copy, showCancel: false, confirmText: '知道了' })
	}

	const handleBecomeMatchmaker = () => {
		uni.navigateTo({
			url: '/pagesSub/matchmaker/become-matchmaker'
		})
	}

	const handleBecomePartner = () => {
		uni.navigateTo({
			url: '/pagesSub/matchmaker/become-partner'
		})
	}

	const handleBecomePromoter = () => {
		uni.navigateTo({
			url: '/pagesSub/matchmaker/become-promoter'
		})
	}

	const applyCustomService = () => {
		applyCustomPlan()
	}

</script>

<style scoped>
	.matchmaker-page {
		height: 100vh;
		/* 对齐首页的浅薄荷绿主题。 */
		background: #FAF8F5;
		--canvas: #FAF8F5;
		--paper: #FFFFFF;
		--surface: #FFFFFF;
		--ink: #1A1A1A;
		--ink2: #5A6B5C;
		--muted: #A0B0A2;
		--line: #E8EDE6;
		--accent: #7EC8A0;
		--accent2: #5BAF80;
		--soft: #A0B0A2;
		--accent-bg: #E8F5EE;
		--accent-glow: rgba(126, 200, 160, 0.16);
		--text-invert: #FFFFFF;
		--warm: #F5F9F2;
		--brown: #5BAF80;
		--sage: #7EC8A0;
		--sage-soft: #E8F5EE;
		--match-paper: #FFFFFF;
		--match-mist: #F5F9F2;
		--match-sky: #E8F5EE;
		--match-blush: #FFF0F0;
		--match-deep: #1A1A1A;
		--match-coral: #F08282;
		--match-line: #E8EDE6;
		--match-shadow: 0 12px 28px rgba(91, 175, 128, 0.10);
		--navy: #2D4A3E;
	}

	.page-shell {
		height: 100%;
		display: flex;
		flex-direction: column;
	}

	/* 上半段（padding-top）就是星网的地盘，所以它必须 ≥ .hero-net 的高度 + HERO_BOUND_Y1
	   那点余量；下半段才是文案。整卡高度 = padding-top 228 + kicker 42 + gap 14 +
	   3 行描述 ~129 + padding-bottom 32 ≈ 445rpx（原来约 543rpx）。 */
	.page-head {
		position: relative;
		overflow: hidden;
		min-height: 420rpx;
		margin: 20rpx 28rpx 0;
		padding: 228rpx 30rpx 32rpx;
		display: flex;
		flex-direction: column;
		/* kicker 与描述之间的盒子间隙。视觉间隙 = 它 + 两行各自的行内留白，
		   所以不能按「等于胶囊那条间隙」直接取值 —— 实测取 8rpx 时两处视觉间隙持平
		   （见 .page-tabs 的 margin-top，两者是成对校准的，改一个要动另一个）。 */
		gap: 2rpx;
		border-radius: 24rpx;
		background: linear-gradient(150deg, #0B1F2A 0%, #0F2E3A 55%, #11445A 100%);
		box-shadow: 0 12rpx 28rpx rgba(11, 31, 42, 0.22);
	}

	/* zurb 式点+连线粒子网络（用 view 节点实现，避免 uni-app-x SVG 属性被吃） */
	.hero-net {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		/* 与 .page-head 的 padding-top 等高：星网的可视区就到此为止，
		   下面的文案区(≥228rpx)这块画布根本不覆盖。 */
		height: 228rpx;
		pointer-events: none;
		z-index: 1;
		overflow: visible;
	}

	/* ===== zurb 式点线网络（constellation）=====
	   点位由 JS 每帧计算（正弦漂浮），连线再按两点实时距离算出长度/角度/透明度：
	   距离越近越清晰，超出阈值即完全隐形 —— 由此产生「忽连忽断」的拓扑变化。
	   left/top 直接 = cx-r / cy-r（避免负 margin 在 mp-weixin 不生效） */
	/* 点/线的 left、top 恒定不动，位置与长度全部交给 transform：
	   translate 定位、rotate 定向、scaleX 定长。这样每帧只改合成层属性，
	   不触发 layout 重排 —— 这是「丝滑」的关键（尤其中低端机）。 */
	.hero-dot {
		position: absolute;
		left: 0;
		top: 0;
		border-radius: 50%;
		background: #FFFFFF;
		box-shadow: 0 0 6rpx rgba(255, 255, 255, 0.40);
		/* 预先声明要动 transform：让渲染引擎把它放进独立合成层，
		   每帧只做图层位移，不重新光栅化 —— box-shadow 的模糊是最贵的重绘项。 */
		will-change: transform;
		backface-visibility: hidden;
	}

	/* 连线：定宽 700rpx 的横线，transform-origin 在左端，
	   由 `translate(起点) rotate(角度) scaleX(距离/700)` 把它摆到两个圆心之间 */
	.hero-line {
		position: absolute;
		left: 0;
		top: 0;
		width: 700rpx;
		height: 2rpx;
		/* 沿线方向「淡 → 深 → 淡」：两端完全透明、中间一段实心，
		   于是每条线自己就是一道渐隐渐显的光，而不是一根生硬的实心短线。
		   scaleX 会连同渐变一起缩放，所以两端的淡出带占比恒定，线无论长短都是同样的形态。
		   线的两端正好落在星星的圆心里、被星本身盖住，所以端点透明不会显得「线和星脱节」。 */
		background: linear-gradient(
			90deg,
			rgba(255, 255, 255, 0) 0%,
			#FFFFFF 30%,
			#FFFFFF 70%,
			rgba(255, 255, 255, 0) 100%
		);
		transform-origin: 0 50%;
		will-change: transform, opacity;
		backface-visibility: hidden;
	}

	/* 这里刻意不用 CSS 补间：位移本身已是小数 px + 30fps 下发，
	   每帧步进仅约 0.2px，肉眼连续。加补间反而会引入相位滞后，
	   并与小程序视图层的更新节奏互相干扰（实测会出现「停一下再补跑」）。
	   位置/长度/角度全部只在 transform 里变，left/top/width 恒定，不触发 layout。 */

	.page-head-art {
		width: calc(100% + 60rpx);
		height: 250rpx;
		margin-left: -30rpx;
		margin-bottom: 8rpx;
		border-radius: 24rpx 24rpx 0 0;
	}

	.page-kicker {
		position: relative;
		z-index: 3;
		font-size: 32rpx;
		line-height: 1.3;
		font-weight: 800;
		letter-spacing: 0.06em;
		color: rgba(255, 217, 160, 0.98);
	}

	.page-title {
		position: relative;
		z-index: 3;
		font-size: 42rpx;
		line-height: 1.3;
		font-family: var(--serif);
		font-weight: 700;
		color: #FFFFFF;
	}

	.page-desc {
		position: relative;
		z-index: 3;
		font-size: 26rpx;
		line-height: 1.65;
		letter-spacing: 0.01em;
		color: rgba(255, 255, 255, 0.78);
	}

	/* tabs 上提，让胶囊压住卡片下沿。这个负 margin 决定了「描述末行 → 胶囊外轮廓」
	   的间隙：盒子间隙恰为 32rpx(padding-bottom) + margin-top，所以
	   margin-top = -32rpx 时盒子间隙归零，只剩描述末行的行内留白 —— 与 kicker↔描述
	   那条视觉间隙持平（两条间隙是一对，改 gap 或这条都要一起看）。 */
	.page-tabs {
		position: relative;
		z-index: 2;
		margin-top: -26rpx;
		padding: 0 46rpx 18rpx;
	}

	.matchmaker-tab-bar {
		width: 100%;
		display: flex;
		flex-direction: row;
		align-items: center;
		gap: 6rpx;
		padding: 7rpx;
		border-radius: 999rpx;
		background: var(--surface);
		box-shadow: 0 8rpx 20rpx rgba(91, 175, 128, 0.12);
		border: 1px solid var(--match-line);
	}

	.matchmaker-tab {
		position: relative;
		flex: 1;
		width: 50%;
		min-width: 0;
		flex-shrink: 1;
		height: 80rpx;
		border-radius: 999rpx;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 32rpx;
		font-weight: 700;
		color: rgba(18, 101, 88, 0.55);
	}

	.matchmaker-tab.active {
		background: var(--accent-bg);
		color: #126558;
	}

	.page-scroller {
		flex: 1;
		height: 0;
	}

	.page-content {
		padding: 8rpx 28rpx 188rpx;
		display: flex;
		flex-direction: column;
		gap: 24rpx;
	}

	.service-page-content {
		padding-bottom: calc(env(safe-area-inset-bottom) + 144rpx);
	}

	.error-card {
		padding: 24rpx;
		border-radius: 20rpx;
		background: rgba(194, 224, 207, 0.56);
		display: flex;
		flex-direction: column;
		gap: 10rpx;
	}

	.error-title {
		font-size: 28rpx;
		font-weight: 800;
		color: var(--ink);
	}

	.error-desc {
		font-size: 22rpx;
		line-height: 1.55;
		color: var(--ink2);
	}

	.error-button {
		margin-top: 4rpx;
		align-self: flex-start;
		height: 56rpx;
		padding: 0 18rpx;
		border-radius: 16rpx;
		background: var(--surface);
		display: flex;
		align-items: center;
		font-size: 20rpx;
		font-weight: 800;
		color: var(--accent2);
	}

	.summary-card {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 12rpx;
	}

	.summary-item {
		padding: 18rpx 16rpx;
		border-radius: 20rpx;
		background: var(--surface);
		box-shadow: var(--shadow-sm);
		display: flex;
		flex-direction: column;
		gap: 8rpx;
		min-height: 120rpx;
		justify-content: center;
	}

	.summary-value {
		font-size: 30rpx;
		line-height: 1.2;
		font-weight: 800;
		color: var(--ink);
	}

	.summary-label {
		font-size: 18rpx;
		line-height: 1.45;
		color: var(--muted);
	}

	.tab-panel {
		display: flex;
		flex-direction: column;
		gap: 20rpx;
	}

	.custom-home-hero {
		min-height: 0;
		padding: 0;
		border-radius: 20rpx;
		background: var(--paper);
		border: 1px solid var(--line);
		box-shadow: var(--shadow-sm);
		position: relative;
		overflow: hidden;
		display: flex;
		flex-direction: column;
	}

	.custom-home-hero-art {
		width: 100%;
		height: 220rpx;
		flex-shrink: 0;
		border-radius: 20rpx 20rpx 0 0;
	}

	.custom-home-copy {
		position: relative;
		z-index: 1;
		width: auto;
		padding: 22rpx 28rpx 28rpx;
		display: flex;
		flex-direction: column;
		gap: 12rpx;
	}

	.custom-home-kicker { font-size: 20rpx; font-weight: 800; letter-spacing: .08em; color: var(--accent2); }
	.custom-home-title { font-size: 40rpx; line-height: 1.3; font-family: var(--serif); font-weight: 700; color: var(--ink); }
	.custom-home-desc { font-size: 22rpx; line-height: 1.6; color: var(--muted); }
	.custom-home-values { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12rpx; }
	.custom-home-value { min-height: 188rpx; padding: 18rpx 14rpx; border-radius: 16rpx; background: var(--surface); box-shadow: var(--shadow-sm); display: flex; flex-direction: column; gap: 10rpx; }
	.custom-home-mark { width: 44rpx; height: 44rpx; border-radius: 50%; background: var(--accent-bg); color: var(--accent2); display: flex; align-items: center; justify-content: center; font-size: 22rpx; font-weight: 800; }
	.custom-home-value-title { font-size: 24rpx; font-weight: 800; color: var(--ink); }.custom-home-value-copy { font-size: 18rpx; line-height: 1.5; color: var(--muted); }
	.custom-home-services { display: grid; grid-template-columns: 1fr 1fr; gap: 12rpx; }.custom-home-service { min-height: 144rpx; padding: 18rpx; border-radius: 16rpx; background: var(--surface); box-shadow: var(--shadow-sm); display: flex; flex-direction: column; gap: 7rpx; }.custom-home-service-index { font-size: 18rpx; color: var(--accent2); font-weight: 800; }.custom-home-service-title { font-size: 25rpx; font-weight: 800; color: var(--ink); }.custom-home-service-copy { font-size: 19rpx; line-height: 1.45; color: var(--muted); }
	.custom-home-process-scroll, .custom-home-plan-scroll { width: 100%; margin: 0 -32rpx; padding: 0 32rpx; }.custom-home-process-list, .custom-home-plan-list { display: flex; flex-direction: row; flex-wrap: nowrap; align-items: flex-start; gap: 14rpx; }.custom-home-process { width: 128rpx; flex-shrink: 0; display: flex; flex-direction: column; gap: 8rpx; }.custom-home-process-mark { width: 50rpx; height: 50rpx; border-radius: 50%; background: var(--accent); color: var(--paper); display: flex; align-items: center; justify-content: center; font-size: 18rpx; font-weight: 800; }.custom-home-process-title { font-size: 23rpx; font-weight: 800; color: var(--ink); }.custom-home-process-copy { font-size: 18rpx; color: var(--muted); }
	.custom-home-plan-list { box-sizing: border-box; }
