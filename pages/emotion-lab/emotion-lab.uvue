		},
		ESFP: {
			loveBase: '锚定当下的热烈恋爱，偏爱鲜活热闹的陪伴，讨厌沉闷压抑的关系，爱意藏在每一次热忱的分享与奔赴里。',
			advantage: '热情开朗，能轻松带动相处氛围；共情力强，敏锐捕捉对方情绪；坦率真诚，相处起来轻松不内耗。',
			shortcoming: '回避沉重话题，逃避深度矛盾；情绪起伏大，容易冲动上头；缺乏长远规划，易忽略现实问题。',
			idealPartner: '情绪稳定，能接住自己的情绪起伏；愿意陪自己体验生活；不强迫自己做长远绑定。',
			matchSoul: { type: 'ISTJ', name: '物流师' },
			matchComplement: { type: 'ESTP', name: '企业家' },
			matchCaution: { type: 'INTJ', name: '建筑师' }
		}
	}

	const EMPTY_INTERPRETATION: any = {
		loveBase: '',
		advantage: '',
		shortcoming: '',
		idealPartner: '',
		matchSoul: { type: '', name: '' },
		matchComplement: { type: '', name: '' },
		matchCaution: { type: '', name: '' }
	}

	const manualTypes = computed(() => {
		if (summary.value == null || !Array.isArray(summary.value.manualTypes)) return [] as string[]
		return summary.value.manualTypes as string[]
	})

	const typeGroups = computed(() => {
		const rows: any[] = [
			{ key: 'analyst', tone: 'tone-analyst', types: ['INTJ', 'INTP', 'ENTJ', 'ENTP'] },
			{ key: 'diplomat', tone: 'tone-diplomat', types: ['INFJ', 'INFP', 'ENFJ', 'ENFP'] },
			{ key: 'sentinel', tone: 'tone-sentinel', types: ['ISTJ', 'ISFJ', 'ESTJ', 'ESFJ'] },
			{ key: 'explorer', tone: 'tone-explorer', types: ['ISTP', 'ISFP', 'ESTP', 'ESFP'] }
		]
		const fallback: string[] = [
			'INTJ', 'INTP', 'ENTJ', 'ENTP',
			'INFJ', 'INFP', 'ENFJ', 'ENFP',
			'ISTJ', 'ISFJ', 'ESTJ', 'ESFJ',
			'ISTP', 'ISFP', 'ESTP', 'ESFP'
		]
		const source: string[] = manualTypes.value.length > 0 ? manualTypes.value : fallback
		const allowed: any = {}
		for (let i = 0; i < source.length; i++) allowed['' + source[i]] = true

		const groups: any[] = []
		for (let i = 0; i < rows.length; i++) {
			const row = rows[i]
			const items: any[] = []
			for (let j = 0; j < row.types.length; j++) {
				const type = row.types[j]
				if (allowed[type] != true) continue
				items.push({ type: type, nickname: MBTI_NICKNAMES[type] != null ? MBTI_NICKNAMES[type] : '' })
			}
			if (items.length == 0) continue
			groups.push({ key: row.key, tone: row.tone, items: items })
		}
		return groups
	})

	const ghostAvatars = computed(() => {
		return [1, 2, 3, 4, 5]
	})

	const assessment = computed(() => {
		if (summary.value == null || !Array.isArray(summary.value.assessments)) return null
		return summary.value.assessments.length > 0 ? summary.value.assessments[0] : null
	})

	const canStartAssessment = computed(() => {
		if (assessment.value == null || assessment.value.authorization == null) return false
		const status = '' + assessment.value.authorization.status
		return assessment.value.canStart == true && (status == 'verified' || status == 'approved')
	})

	const startBlockTitle = computed(() => {
		if (assessment.value != null && assessment.value.authorization != null) {
			const status = '' + assessment.value.authorization.status
			if (status == 'rejected') return '测试内容暂不可用'
			if (status == 'verified' || status == 'approved') return '测试暂不可开始'
		}
		return '审核完成前不可开始'
	})

	const startBlockMessage = computed(() => {
		if (assessment.value != null && assessment.value.authorization != null) {
			const status = '' + assessment.value.authorization.status
			if (status == 'rejected') return '该版本内容未通过复核，当前不会加载测试题。'
			if (status == 'verified' || status == 'approved') return '当前版本暂未开放，请稍后再试。'
		}
		return '题库来源与使用范围尚未完成复核，当前不会加载任何测试题。'
	})

	const profileSource = computed(() => {
		return summary.value != null ? summary.value.profileSource : null
	})

	const activeSession = computed(() => {
		return summary.value != null ? summary.value.activeSession : null
	})

	const hasActiveDraft = computed(() => {
		return canStartAssessment.value && activeSession.value != null && activeSession.value.status == 'in_progress'
	})

	const answeredCount = computed(() => {
		const session: any = activeSession.value
		if (session == null || !Array.isArray(session.questionIds) || !Array.isArray(session.answers)) return 0
		let count = 0
		for (let i = 0; i < session.questionIds.length; i++) {
			const questionId = '' + session.questionIds[i]
			for (let j = 0; j < session.answers.length; j++) {
				if (session.answers[j] != null && '' + session.answers[j].questionId == questionId) {
					count += 1
					break
				}
			}
		}
		return count
	})

	const currentQuestion = computed(() => {
		const session: any = activeSession.value
		if (session == null || !Array.isArray(session.questionIds) || !Array.isArray(session.questions)) return null as any
		if (currentQuestionIndex.value < 0 || currentQuestionIndex.value >= session.questionIds.length) return null as any
		const questionId = '' + session.questionIds[currentQuestionIndex.value]
		for (let i = 0; i < session.questions.length; i++) {
			const question: any = session.questions[i]
			if (question != null && '' + question.id == questionId) return question
		}
		return null as any
	})

	const currentOptions = computed(() => {
		const rows: any[] = []
		const question: any = currentQuestion.value
		if (question == null || !Array.isArray(question.options)) return rows
		for (let i = 0; i < question.options.length; i++) {
			const option: any = question.options[i]
			const rawValue: any = option != null && typeof option == 'object' ? option.value : option
			const value = Number(rawValue)
			if (!Number.isFinite(value)) continue
			let label = '' + rawValue
			if (option != null && typeof option == 'object' && option.label != null) {
				label = '' + option.label
			} else if (question.options.length == defaultScaleLabels.length) {
				label = defaultScaleLabels[i]
			}
			rows.push({ value: value, label: label })
		}
		return rows
	})

	const ratingDots = computed(() => {
		const options = currentOptions.value
		const rows: any[] = []
		const total = options.length
		if (total == 0) return rows

		/* 设计稿原稿（画板3 MBTI Quiz Page）7 级李克特圆点：
		   白底空心 + 2.5px 彩色描边；直径两端大中间小 40/34/28/24/28/34/40；
		   描边色由暖橙 #F0A060 经中性灰 #B8B8B8 渐变到薄荷绿 #7EC8A0。 */
		const designSizes = [40, 34, 28, 24, 28, 34, 40]
		const designColors = ['#F0A060', '#E0A878', '#C8B090', '#B8B8B8', '#90B8A0', '#78B898', '#7EC8A0']

		for (let i = 0; i < total; i++) {
			let size = 24
			let color = '#B8B8B8'
			if (total == designSizes.length) {
				size = designSizes[i]
				color = designColors[i]
			} else {
				// 非 7 档时按比例保持"两端大、中间小"与"橙→灰→绿"渐变
				const middle = (total - 1) / 2
				const distance = middle == 0 ? 1 : Math.abs(i - middle) / middle
				size = Math.round(24 + 16 * distance)
				const t = total == 1 ? 0.5 : i / (total - 1)
				if (t < 0.34) color = '#F0A060'
				else if (t > 0.66) color = '#7EC8A0'
				else color = '#B8B8B8'
			}
			rows.push({ value: options[i].value, label: options[i].label, size: size, color: color })
		}
		return rows
	})

	const currentAnswerLabel = computed(() => {
		const value = currentAnswerValue.value
		if (value == 0) return ''
		const dots = ratingDots.value
		for (let i = 0; i < dots.length; i++) {
			if (dots[i].value == value) return '' + dots[i].label
		}
		return ''
	})

	const currentAnswerValue = computed(() => {
		const session: any = activeSession.value
		const question: any = currentQuestion.value
		if (session == null || question == null || !Array.isArray(session.answers)) return 0
		for (let i = 0; i < session.answers.length; i++) {
			const answer: any = session.answers[i]
			if (answer != null && '' + answer.questionId == '' + question.id) return Number(answer.value)
		}
		return 0
	})

	const progressPercent = computed(() => {
		const session: any = activeSession.value
		if (session == null || !Array.isArray(session.questionIds) || session.questionIds.length == 0) return 0
		return Math.round(answeredCount.value / session.questionIds.length * 100)
	})

	const quizIndexLabel = computed(() => {
		const session: any = activeSession.value
		const total = session != null && Array.isArray(session.questionIds) ? session.questionIds.length : 0
		const index = total > 0 ? currentQuestionIndex.value + 1 : 0
		return padIndex(index) + ' / ' + padIndex(total)
	})

	const allAnswersComplete = computed(() => {
		const session: any = activeSession.value
		return session != null && Array.isArray(session.questionIds) && session.questionIds.length > 0 &&
			answeredCount.value == session.questionIds.length
	})

	const completedResult = computed(() => {
		if (activeSession.value == null) return null
		const session: any = activeSession.value
		return session.status == 'completed' ? session.result : null
	})

	const currentMbtiType = computed(() => {
		if (completedResult.value != null) return '' + completedResult.value.mbtiType
		if (manualResultType.value != '') return manualResultType.value
		if (profileSource.value != null && profileSource.value.mbtiType != null) return '' + profileSource.value.mbtiType
		return ''
	})

	const currentMbtiNickname = computed(() => {
		const type = currentMbtiType.value
		return MBTI_NICKNAMES[type] != null ? '' + MBTI_NICKNAMES[type] : ''
	})

	const hasTestedType = computed(() => currentMbtiType.value != '')

	const resultDescription = computed(() => {
		const result: any = completedResult.value
		if (result != null && result.resultCopy != null && result.resultCopy.summary != null) {
			return '' + result.resultCopy.summary
		}
		const type = currentMbtiType.value
		if (MBTI_BRIEF_COPY[type] != null) return '' + MBTI_BRIEF_COPY[type]
		return ''
	})

	const disclaimerText = computed(() => {
		const result: any = completedResult.value
		if (
			result != null &&
			result.resultCopy != null &&
			typeof result.resultCopy.disclaimer == 'string' &&
			result.resultCopy.disclaimer.trim() != ''
		) {
			return result.resultCopy.disclaimer
		}
		if (summary.value != null && typeof summary.value.disclaimer == 'string') {
			return summary.value.disclaimer
		}
		return ''
	})

	const disclaimerVersion = computed(() => {
		const result: any = completedResult.value
		if (
			result != null &&
			result.resultCopy != null &&
			typeof result.resultCopy.version == 'string'
		) {
			return result.resultCopy.version
		}
		if (summary.value != null && typeof summary.value.disclaimerVersion == 'string') {
			return summary.value.disclaimerVersion
		}
		return ''
	})

	// 四维中文极点名（左=首字母端，右=次字母端）
	const DIM_ZH: any = {
		EI: { left: '外倾', right: '内倾' },
		SN: { left: '实感', right: '直觉' },
		TF: { left: '思考', right: '情感' },
		JP: { left: '判断', right: '知觉' }
	}

	// 结果页四维分布：左侧「字母+中文+数字」，右侧「数字+中文+字母」，进度条按右端分值填充
	// 手动设置/历史资料的类型没有真实分值，按类型字母派生参考分布（62/38），并标注「参考值」
	const DIM_KEYS: string[] = ['EI', 'SN', 'TF', 'JP']

	const dimensionEstimated = computed(() => {
		const result: any = completedResult.value
		return !(result != null && result.dimensions != null)
	})

	const dimensionTitle = computed(() => {
		return dimensionEstimated.value ? '四维特质分布（参考值）' : '四维特质分布'
	})

	const dimensionView = computed(() => {
		const result: any = completedResult.value
		const rows: any[] = []
		const d = result != null ? result.dimensions : null
		if (d != null) {
			const rEI: any = { key: 'EI', leftLabel: 'E' + DIM_ZH.EI.left + d.EI.E, rightLabel: d.EI.I + DIM_ZH.EI.right + 'I', rightPercent: d.EI.I }
			const rSN: any = { key: 'SN', leftLabel: 'S' + DIM_ZH.SN.left + d.SN.S, rightLabel: d.SN.N + DIM_ZH.SN.right + 'N', rightPercent: d.SN.N }
			const rTF: any = { key: 'TF', leftLabel: 'T' + DIM_ZH.TF.left + d.TF.T, rightLabel: d.TF.F + DIM_ZH.TF.right + 'F', rightPercent: d.TF.F }
			const rJP: any = { key: 'JP', leftLabel: 'J' + DIM_ZH.JP.left + d.JP.J, rightLabel: d.JP.P + DIM_ZH.JP.right + 'P', rightPercent: d.JP.P }
			rows.push(rEI)
			rows.push(rSN)
			rows.push(rTF)
			rows.push(rJP)
			return rows
		}
		const type = currentMbtiType.value.toUpperCase()
		if (type.length < 4) return rows
		for (let i = 0; i < DIM_KEYS.length; i++) {
			const key = DIM_KEYS[i]
			const zh: any = DIM_ZH[key]
			const letter = type.charAt(i)
			const leftScore = letter == key.charAt(0) ? 62 : 38
			const rightScore = 100 - leftScore
			const row: any = {
				key: key,
				leftLabel: key.charAt(0) + zh.left + leftScore,
				rightLabel: rightScore + zh.right + key.charAt(1),
				rightPercent: rightScore
			}
			rows.push(row)
		}
		return rows
	})

	// 当前类型对应的 5 板块婚恋解读
	const currentInterpretation = computed(() => {
		const type = currentMbtiType.value
		if (MBTI_INTERPRETATION[type] != null) return MBTI_INTERPRETATION[type]
		return EMPTY_INTERPRETATION
	})

	// 结果文案版本号（mbti-result-copy@x）
	const resultVersion = computed(() => {
		const result: any = completedResult.value
		if (result != null && result.resultCopy != null && typeof result.resultCopy.version == 'string') {
			return result.resultCopy.version
		}
		return ''
	})

	// 昵称 · 版本号（无版本号时只显示昵称，避免多余的「·」）
	const heroMeta = computed(() => {
		const name = currentMbtiNickname.value
		const version = resultVersion.value
		if (name != '' && version != '') return name + ' · ' + version
		if (name != '') return name
		return version
	})

	const padIndex = (value: number): string => {
		return value < 10 ? '0' + value : '' + value
	}

	const responseMessage = (res: any, fallback: string): string => {
		return res != null && res.message != null ? '' + res.message : fallback
	}

	const applySessionSnapshot = (session: any) => {
		if (summary.value != null) summary.value.activeSession = session
	}

	const hasAnswer = (session: any, questionId: string): boolean => {
		if (session == null || !Array.isArray(session.answers)) return false
		for (let i = 0; i < session.answers.length; i++) {
			const answer: any = session.answers[i]
			if (answer != null && '' + answer.questionId == questionId) return true
		}
		return false
	}

	const firstUnansweredIndex = (session: any): number => {
		if (session == null || !Array.isArray(session.questionIds)) return 0
		for (let i = 0; i < session.questionIds.length; i++) {
			if (!hasAnswer(session, '' + session.questionIds[i])) return i
		}
		return session.questionIds.length > 0 ? session.questionIds.length - 1 : 0
	}

	const loadMatches = async () => {
		matchesError.value = ''
		matchesUnavailable.value = false
		if (currentMbtiType.value == '') {
			matches.value = []
			return false
		}
		matchesLoading.value = true
		try {
			const res = await getEmotionLabMatches(currentMbtiType.value)
			if (res.success == true && res.data != null && Array.isArray(res.data.items)) {
				matches.value = res.data.items as any[]
				return true
			} else {
				matches.value = []
				matchesUnavailable.value = res.code == 'EMOTION_MATCHES_UNAVAILABLE'
				matchesError.value = responseMessage(res, '推荐加载失败，请重试')
			}
		} catch (error) {
			matches.value = []
			matchesError.value = '推荐加载失败，请检查网络后重试'
		} finally {
			matchesLoading.value = false
		}
		return false
	}

	const loadSummary = async () => {
		loading.value = true
		errorMessage.value = ''
		try {
			const res = await getEmotionLabSummary()
			if (res.success == true && res.data != null) {
				summary.value = res.data
				if (res.data.profileSource != null) selectedType.value = res.data.profileSource.mbtiType
			} else {
				errorMessage.value = responseMessage(res, '请稍后重试')
			}
		} catch (error) {
			errorMessage.value = '请稍后重试'
		} finally {
			loading.value = false
		}
		await loadMatches()
	}

	const openStartSheet = () => {
		startSheetVisible.value = true
	}

	const handleSheetStart = () => {
		startSheetVisible.value = false
		handleStartAssessment()
	}

	const handleSheetManual = () => {
		startSheetVisible.value = false
		openTypeSheet()
	}

	const openTypeSheet = () => {
		// 记录打开前的类型，供取消时还原，避免选择预览污染已显示的结果
		typeSheetBackup.value = manualResultType.value
		manualConfirmed.value = false
		typeSheetVisible.value = true
	}

	const closeTypeSheet = () => {
		// 取消/关闭时还原为打开前的类型，保证结果图标不被未保存的选择改变
		manualResultType.value = typeSheetBackup.value
		typeSheetVisible.value = false
	}

	const openResultActionSheet = () => {
		resultActionSheetVisible.value = true
	}

	const handleResultActionRetest = () => {
		resultActionSheetVisible.value = false
		handleStartAssessment()
	}

	const handleResultActionChooseType = () => {
		resultActionSheetVisible.value = false
		openTypeSheet()
	}

	const handleStartAssessment = async () => {
		if (!canStartAssessment.value || assessment.value == null) {
			uni.showToast({ title: startBlockMessage.value, icon: 'none' })
			return
		}
		if (hasActiveDraft.value) {
			continueAssessment()
			return
		}
		starting.value = true
		try {
			const res = await startMbtiAssessment(assessment.value.id)
			if (res.success != true) {
				uni.showToast({ title: responseMessage(res, '暂时无法开始测试'), icon: 'none' })
				return
			}
			applySessionSnapshot(res.data)
			continueAssessment()
		} catch (error) {
			uni.showToast({ title: '暂时无法开始测试', icon: 'none' })
		} finally {
			starting.value = false
		}
	}

	const continueAssessment = () => {
		if (!canStartAssessment.value) {
			uni.showToast({ title: '当前测试内容不可继续', icon: 'none' })
			return
		}
		const session: any = activeSession.value
		if (session == null || session.status != 'in_progress') return
		if (!Array.isArray(session.questionIds) || session.questionIds.length == 0) {
			uni.showToast({ title: '当前没有可作答的题目', icon: 'none' })
			return
		}
		currentQuestionIndex.value = firstUnansweredIndex(session)
		progressMessage.value = ''
		viewState.value = 'questions'
	}

	const openResult = () => {
		// 完整解读页按「当前 MBTI 类型」渲染：测评完成、手动设置、历史资料任一来源都可进入，
		// 不再要求必须存在本次完成的测评结果
		if (!hasTestedType.value) {
			uni.showToast({ title: '当前没有可查看的测评结果', icon: 'none' })
			return
		}
		assessmentConfirmed.value = false
		viewState.value = 'result'
		uni.pageScrollTo({ scrollTop: 0, duration: 0 })
	}

	const backToIntro = () => {
		progressMessage.value = ''
		manualConfirmed.value = false
		assessmentConfirmed.value = false
		viewState.value = 'intro'
	}

	const previousQuestion = () => {
		if (savingAnswer.value || currentQuestionIndex.value <= 0) return
		currentQuestionIndex.value -= 1
		progressMessage.value = ''
	}

	const nextQuestion = () => {
		const session: any = activeSession.value
		if (savingAnswer.value || session == null || !Array.isArray(session.questionIds)) return
		if (currentQuestionIndex.value >= session.questionIds.length - 1) return
		currentQuestionIndex.value += 1
		progressMessage.value = ''
	}

	const selectAnswer = async (value: number) => {
		const session: any = activeSession.value
		const question: any = currentQuestion.value
		if (savingAnswer.value || submitting.value || session == null || question == null) return
		savingAnswer.value = true
		progressMessage.value = '正在保存...'
		try {
			const res = await saveMbtiAnswer('' + session.id, '' + question.id, value)
			if (res.success == true && res.data != null) {
				applySessionSnapshot(res.data)
				progressMessage.value = '已保存'
			} else {
				progressMessage.value = '保存失败，请重试'
				uni.showToast({ title: responseMessage(res, '保存失败，请重试'), icon: 'none' })
			}
		} catch (error) {
			progressMessage.value = '保存失败，请重试'
			uni.showToast({ title: '保存失败，请重试', icon: 'none' })
		} finally {
			savingAnswer.value = false
		}
	}

	const orderedAnswers = (session: any): any[] => {
		const rows: any[] = []
		if (session == null || !Array.isArray(session.questionIds) || !Array.isArray(session.answers)) return rows
		for (let i = 0; i < session.questionIds.length; i++) {
			const questionId = '' + session.questionIds[i]
			let savedAnswer: any = null
			for (let j = 0; j < session.answers.length; j++) {
				const candidate: any = session.answers[j]
				if (candidate != null && '' + candidate.questionId == questionId) {
					savedAnswer = candidate
					break
				}
			}
			if (savedAnswer == null) return [] as any[]
			rows.push({ questionId: questionId, value: Number(savedAnswer.value) })
		}
		return rows
	}

	const submitAssessment = async () => {
		const session: any = activeSession.value
		if (submitting.value || savingAnswer.value || session == null || !allAnswersComplete.value) return
		const answers: any[] = orderedAnswers(session)
		if (answers.length != session.questionIds.length) {
			uni.showToast({ title: '请完成全部题目后提交', icon: 'none' })
			return
		}
		submitting.value = true
		try {
			const res = await submitMbtiAssessment('' + session.id, answers)
			if (res.success == true && res.data != null) {
				applySessionSnapshot(res.data)
				assessmentConfirmed.value = false
				progressMessage.value = ''
				viewState.value = 'result'
				uni.showToast({ title: '测试已完成', icon: 'success' })
				await loadMatches()
			} else {
				uni.showToast({ title: responseMessage(res, '提交失败，请重试'), icon: 'none' })
			}
		} catch (error) {
			uni.showToast({ title: '提交失败，请重试', icon: 'none' })
		} finally {
			submitting.value = false
		}
	}

	const discardCurrentDraft = async (sessionId: string, targetView: string = 'intro') => {
		if (discarding.value) return
		discarding.value = true
		try {
			const res = await discardMbtiDraft(sessionId)
			if (res.success == true && res.data != null) {
				applySessionSnapshot(res.data)
				currentQuestionIndex.value = 0
				progressMessage.value = ''
				viewState.value = targetView
				uni.showToast({ title: '已重置，从头开始', icon: 'none' })
			} else {
				uni.showToast({ title: responseMessage(res, '暂时无法放弃测试'), icon: 'none' })
			}
		} catch (error) {
			uni.showToast({ title: '暂时无法放弃测试', icon: 'none' })
		} finally {
			discarding.value = false
		}
	}

	// 重新测试：打开自定义确认弹窗（替代 uni.showModal，避免 mp-weixin 偶发不弹窗）
	const requestRetest = () => {
		const session: any = activeSession.value
		if (session == null || session.id == null) {
			uni.showToast({ title: '当前没有可重置的测试', icon: 'none' })
			return
		}
		pendingRetestSessionId.value = '' + session.id
		retestConfirmVisible.value = true
	}

	const confirmRetest = () => {
		const sessionId = pendingRetestSessionId.value
		if (sessionId == '') return
		retestConfirmVisible.value = false
		discardCurrentDraft(sessionId, 'questions')
			.then(() => {
				uni.pageScrollTo({ scrollTop: 0, duration: 0 })
			})
			.catch(() => {})
	}

	const cancelRetest = () => {
		pendingRetestSessionId.value = ''
		retestConfirmVisible.value = false
	}

	// 选择类型时即时更新结果图标（manualResultType 驱动 currentMbtiType），
	// 让“选哪只猫，图标立刻变成哪只”的反馈立即可见；未保存关闭会由 closeTypeSheet 还原
	const selectManualType = (type: string) => {
		selectedType.value = type
		manualResultType.value = type
		manualConfirmed.value = false
	}

	const handleManualConfirmChange = (event: any) => {
		const values = event.detail != null && event.detail.value != null ? event.detail.value as string[] : [] as string[]
		manualConfirmed.value = values.indexOf('confirmed') >= 0
	}

	const handleAssessmentConfirmChange = (event: any) => {
		const values = event.detail != null && event.detail.value != null ? event.detail.value as string[] : [] as string[]
		assessmentConfirmed.value = values.indexOf('confirmed') >= 0
	}

	const saveManualType = async () => {
		if (selectedType.value == '') return

		// 未勾选"同步到资料"时，不调用同步接口，直接把所选类型记录到本地 manualResultType；
		// 这样"选好了"按钮始终可点，不会触发后端"需要明确确认"的报错，
		// 结果卡片也会立即显示本次选择的类型。
		if (!manualConfirmed.value) {
			manualResultType.value = selectedType.value
			typeSheetVisible.value = false
			return
		}

		savingProfile.value = true
		try {
			const res = await setMyMbtiType({
				mbtiType: selectedType.value,
				source: 'self_reported',
				confirmed: true
			})
			if (res.success == true) {
				uni.showToast({ title: '已保存', icon: 'success' })
				manualConfirmed.value = false
				manualResultType.value = ''
				typeSheetVisible.value = false
				await loadSummary()
			} else {
				uni.showToast({ title: responseMessage(res, '保存失败，请重试'), icon: 'none' })
			}
		} catch (error) {
			uni.showToast({ title: '保存失败，请重试', icon: 'none' })
		} finally {
			savingProfile.value = false
		}
	}

	const saveAssessmentType = async () => {
		if (!assessmentConfirmed.value || completedResult.value == null) return
		savingProfile.value = true
		try {
			const res = await setMyMbtiType({
				mbtiType: completedResult.value.mbtiType,
				source: 'assessment',
				confirmed: true,
				resultId: completedResult.value.id
			})
			if (res.success == true) {
				uni.showToast({ title: '已同步', icon: 'success' })
				assessmentConfirmed.value = false
				await loadSummary()
			} else {
				uni.showToast({ title: responseMessage(res, '同步失败，请重试'), icon: 'none' })
			}
		} catch (error) {
			uni.showToast({ title: '同步失败，请重试', icon: 'none' })
		} finally {
			savingProfile.value = false
		}
	}

	const refreshMatches = async () => {
		if (matchesLoading.value) return
		if (await loadMatches()) uni.showToast({ title: '已换一批', icon: 'none' })
	}

	const openHistory = () => {
		uni.navigateTo({
			url: '/pagesSub/profileExtra/unlock-history',
			fail: () => {
				uni.showToast({ title: '历史记录暂未开放', icon: 'none' })
			}
		})
	}

	const openMatchProfile = (item: any) => {
		const userId = item != null && item.userId != null ? '' + item.userId : ''
		const fallbackId = item != null && item.id != null ? '' + item.id : ''
		const targetId = userId != '' ? userId : fallbackId
		if (targetId == '') {
			uni.showToast({ title: '对方主页暂未开放', icon: 'none' })
			return
		}
		uni.navigateTo({
			url: '/pagesSub/userExtra/user/detail?userId=' + encodeURIComponent(targetId),
			fail: () => {
				uni.showToast({ title: '对方主页暂未开放', icon: 'none' })
			}
		})
	}

	onMounted(() => {
		loadSummary()
	})
</script>

<style scoped>
	.lab-page {
		/* 情感实验室原稿色值（pencil-new.pen 画板0-4，1:1 还原，勿改） */
		--lab-bg: #F0F0F3;
		--lab-bg-mint: #F4F9F6;
		--lab-card: #FFFFFF;
		--lab-accent: #7EC8A0;
		--lab-accent-dark: #5DAF85;
		--lab-accent-light: #B5E8D5;
		--lab-accent-soft: #E8F5EE;
		--lab-text: #1A1A1A;
		--lab-text-2: #8E8E93;
		--lab-text-3: #B0B0B0;
		--lab-inverse: #FFFFFF;
		--lab-track: #ECECEC;
		--lab-divider: #F0F0F0;
		--lab-heart: #FFB5B5;
		--lab-plus: #F0F0F0;
		--lab-tag-bg: #E0F5E8;
		--lab-tag-accent-bg: #FFF0E0;
		--lab-tag-accent-text: #E8A040;

		/* 16 型四组莫兰迪配色（原稿画板2）：NT 紫 / NF 绿 / SJ 蓝 / SP 卡其 */
		--lab-nt-bg: #EBE3F3;
		--lab-nt-text: #6B5A80;
		--lab-nf-bg: #D8F0E4;
		--lab-nf-text: #4A7A5E;
		--lab-sj-bg: #D8E8F4;
		--lab-sj-text: #4A6A8A;
		--lab-sp-bg: #F0E8DC;
		--lab-sp-text: #8A7A5E;

		min-height: 100vh;
		background: var(--lab-bg);
		color: var(--lab-text);
		display: flex;
		flex-direction: column;
	}

	.lab-scroll {
		flex: 1;
		height: 0;
	}

	.lab-content {
		display: flex;
		flex-direction: column;
		padding: 8px 16px 24px;
		gap: 20px;
		background: var(--lab-bg);
	}

	/* 未测试态：原稿画板0 Content Wrapper = padding[8,20] gap=24，浅绿底 #F4F9F6 */
	.lab-content-mint {
		padding: 8px 20px 0;
		gap: 24px;
		background: var(--lab-bg-mint);
	}

	/* 原稿 Guide Text：13px #B0B0B0 居中；与卡片间距由父级 gap 控制 */
	.guide-text {
		display: block;
		padding: 0;
		font-size: 13px;
		line-height: 1.6;
		color: var(--lab-text-3);
		text-align: center;
	}

	.safe-area {
		height: calc(24px + env(safe-area-inset-bottom));
	}

	.main-card,
	.result-card,
	.match-card {
		position: relative;
		background: var(--lab-card);
		border-radius: 20px;
		box-shadow: none;
		display: flex;
		flex-direction: column;
		align-items: center;
		overflow: hidden;
	}

	/* 原稿 Main Card：白底、20px 圆角、padding[32,24]、gap=16 */
	.main-card {
		padding: 32px 24px;
		gap: 16px;
	}

	/* 原稿 Result Card：白底、20px 圆角、padding[28,24]、gap=16 */
	.result-card {
		padding: 28px 24px;
		gap: 16px;
	}

	/* 原稿卡片为纯白无渐变，此处仅作居中容器 */
	.card-hero {
		width: 100%;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.result-hero {
		padding-bottom: 0;
	}

	.hero-eyebrow {
		margin-bottom: 14px;
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 3px;
		color: var(--accent2);
	}

	/* 原稿 Result Title「你的MBTI：ESTP」：24px/700 #1A1A1A */
	.hero-type {
		font-size: 24px;
		font-weight: 700;
		line-height: 1.35;
		color: var(--lab-text);
		text-align: center;
	}

	.hero-nickname {
		margin-top: 4px;
		font-size: 14px;
		font-weight: 600;
		color: var(--lab-text-2);
	}

	/* 原稿 Card Title：20px/700 #1A1A1A */
	.card-title {
		display: block;
		font-size: 20px;
		font-weight: 700;
		line-height: 1.4;
		color: var(--lab-text);
		text-align: center;
	}

	/* 原稿 Card Subtitle：14px #8E8E93 */
	.card-subtitle {
		display: block;
		margin-top: 8px;
		font-size: 14px;
		color: var(--lab-text-2);
		text-align: center;
	}

	/* 描述 12px/1.5，与上方标题间距由卡片 gap 控制，确保完整显示 */
	.result-description {
		display: block;
		margin-top: 6px;
		padding: 0 4px;
		font-size: 12px;
		line-height: 1.5;
		color: var(--lab-text-2);
		text-align: center;
	}

	/* 编辑入口：卡片右上角，白底 + 薄荷色高亮边框，确保易发现且不遮挡内容 */
	.result-edit {
		position: absolute;
		top: 8px;
		right: 8px;
		width: 34px;
		height: 34px;
		box-sizing: border-box;
		display: flex;
		align-items: center;
		justify-content: center;
		background: #FFFFFF;
		border-radius: 50%;
		border: 2px solid var(--lab-accent);
		box-shadow: 0 2px 8px rgba(125, 200, 160, 0.20);
		z-index: 2;
	}

	.result-edit-icon {
		font-size: 18px;
		color: var(--lab-accent-dark);
		font-weight: 700;
	}

	.main-card .primary-button,
	.result-card .primary-button {
		margin-top: 24px;
	}

	.section-header {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
	}

	/* 原稿「合拍的人」：18px/700 #1A1A1A */
	.section-title {
		font-size: 18px;
		font-weight: 700;
		color: var(--lab-text);
	}

	/* 原稿 Match Card：白底、16px 圆角、padding=20、gap=12、无描边 */
	.match-card {
		padding: 20px;
		gap: 12px;
		border: 0;
	}

	.match-list {
		display: flex;
		flex-direction: column;
		gap: 12px;
	}

	.match-list .match-card {
		border-radius: 16px;
		padding: 18px;
		gap: 12px;
		align-items: stretch;
		background: #FFFFFF;
	}

	.match-card-active {
		background: #F4F9F6;
	}

	.avatar-row {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: center;
	}

	/* 原稿头像行：48×48 圆形，5 色叠加 opacity 0.35，相邻重叠 12px */
	.avatar-ghost {
		width: 48px;
		height: 48px;
		border-radius: 50%;
		opacity: 0.35;
		margin-right: -12px;
		background: #FFB5B5;
	}

	.avatar-ghost:nth-child(2) {
		background: #B5D8FF;
	}

	.avatar-ghost:nth-child(3) {
		background: #FFE0A3;
	}

	.avatar-ghost:nth-child(4) {
		background: #C5B5FF;
	}

	.avatar-ghost:nth-child(5) {
		background: #B5F0D0;
	}

	/* 原稿 Plus Avatar：#F0F0F0 圆形，「+」22px/300 #B0B0B0 */
	.avatar-plus {
		width: 48px;
		height: 48px;
		border-radius: 50%;
		background: var(--lab-plus);
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.avatar-plus-text {
		font-size: 22px;
		font-weight: 300;
		color: var(--lab-text-3);
	}

	/* 原稿提示文案：13px #B0B0B0 居中 */
	.match-hint {
		display: block;
		font-size: 13px;
		line-height: 1.6;
		color: var(--lab-text-3);
		text-align: center;
	}

	.match-top {
		display: flex;
		flex-direction: row;
		align-items: flex-start;
		justify-content: space-between;
		gap: 12px;
	}

	.match-user {
		display: flex;
		flex-direction: row;
		align-items: flex-start;
		gap: 12px;
		min-width: 0;
		flex: 1;
	}

	.match-text {
		display: flex;
		flex-direction: column;
		gap: 4px;
		min-width: 0;
		flex: 1;
	}

	/* 原稿：姓名 16px/700 #1A1A1A；年龄城市 12px #8E8E93；学校 12px #B0B0B0 */
	.match-name {
		font-size: 16px;
		font-weight: 700;
		color: var(--lab-text);
	}

	.match-meta {
		font-size: 12px;
		color: var(--lab-text-2);
	}

	.match-school {
		font-size: 12px;
		color: var(--lab-text-3);
	}

	.match-score {
		flex-shrink: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		width: 64px;
		height: 64px;
		border-radius: 50%;
		background: #E8F5F0;
		gap: 2px;
	}

	/* 合拍度：24px/700 #7EC8A0；下方「合拍度」11px #9AA0A6 */
	.match-percent {
		font-size: 24px;
		font-weight: 700;
		line-height: 1;
		color: #7EC8A0;
	}

	.match-score-label {
		font-size: 11px;
		color: #9AA0A6;
	}

	.match-tags {
		display: flex;
		flex-direction: row;
		flex-wrap: wrap;
		gap: 8px;
	}

	/* 原稿标签：10px 圆角、padding[4,10]；普通标签 #E0F5E8/#5DAF85，MBTI 标签 #FFF0E0/#E8A040 */
	.match-tag {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: center;
		padding: 4px 10px;
		border-radius: 10px;
		background: var(--lab-tag-bg);
	}

	.match-tag-accent {
		background: var(--lab-tag-accent-bg);
	}

	.match-tag-text {
		font-size: 11px;
		line-height: 1.4;
		color: var(--lab-accent-dark);
		/* 标签文字不换行：宽度不够时整个标签折到下一行，而不是文字在胶囊内折行被裁 */
		white-space: nowrap;
	}

	.match-tag-accent .match-tag-text {
		color: var(--lab-tag-accent-text);
		font-weight: 700;
	}

	/* 原稿 Bio：12px #8E8E93，行高 1.5 */
	.match-bio {
		display: block;
		font-size: 12px;
		line-height: 1.5;
		color: var(--lab-text-2);
	}

	/* 已删除「查看主页」底部栏，点击整卡跳转个人主页 */

	.bottom-actions {
		margin-top: 16px;
		display: flex;
		flex-direction: row;
		align-items: center;
		gap: 12px;
	}

	.flex-button {
		flex: 1;
		min-width: 0;
	}

	.review-notice {
		margin-top: 16px;
		padding: 12px 16px;
		border-radius: 12px;
		background: var(--paper);
		border: 1px solid var(--line);
		display: flex;
		flex-direction: column;
		gap: 4px;
	}

	.review-title {
		font-size: 14px;
		font-weight: 700;
		color: var(--lab-text);
	}

	.review-message {
		font-size: 13px;
		line-height: 1.6;
		color: var(--lab-text-2);
	}

	.lab-illustration {
		position: relative;
		width: 280px;
		height: 140px;
		margin-bottom: 24px;
	}

	/* 原稿 Result Illustration 240×185，位于标题之上（order 提前），与标题间距 12 */
	.result-illustration {
		position: relative;
		width: 240px;
		height: 185px;
		margin-bottom: 12px;
		order: -1;
	}

	/* 测试结果页：用对应 MBTI 类型小猫替换原笑脸图标；180×180 居中突出，无背景/边框以融合卡片 */
	.result-illustration .result-mbti-cat {
		width: 180px;
		height: 180px;
		position: absolute;
		left: 30px;
		top: 3px;
		border: none;
		outline: none;
	}

	.ill-head {
		width: 50px;
		height: 50px;
		border-radius: 50%;
		background: var(--lab-accent-light);
		position: absolute;
		left: 105px;
		top: 15px;
	}

	.ill-eye {
		width: 6px;
		height: 7px;
		border-radius: 3px;
		background: var(--lab-accent-dark);
		position: absolute;
	}

	.ill-eye-left {
		left: 120px;
		top: 32px;
	}

	.ill-eye-right {
		left: 134px;
		top: 32px;
	}

	.ill-smile {
		width: 14px;
		height: 8px;
		border-radius: 0 0 14px 14px;
		background: var(--lab-accent-dark);
		position: absolute;
		left: 123px;
		top: 44px;
	}

	.ill-star {
		background: var(--lab-accent);
		position: absolute;
		transform: rotate(45deg);
	}

	.ill-star-left {
		width: 22px;
		height: 22px;
		border-radius: 3px;
		left: 65px;
		top: 25px;
	}

	.ill-star-right {
		width: 17px;
		height: 17px;
		border-radius: 2px;
		left: 185px;
		top: 50px;
	}

	.ill-star-a {
		width: 19px;
		height: 19px;
		border-radius: 3px;
		left: 55px;
		top: 18px;
	}

	.ill-star-b {
		width: 14px;
		height: 14px;
		border-radius: 2px;
		left: 170px;
		top: 12px;
	}

	.ill-star-c {
		width: 12px;
		height: 12px;
		border-radius: 2px;
		background: var(--lab-accent-light);
		left: 180px;
		top: 55px;
	}

	.ill-bubble {
		width: 70px;
		height: 38px;
		border-radius: 14px;
		background: var(--lab-accent-light);
		position: absolute;
		left: 15px;
		top: 55px;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	/* 原稿气泡文字「MBTI」：12px/700 #5DAF85 */
	.ill-bubble-text {
		font-size: 12px;
		font-weight: 700;
		color: var(--lab-accent-dark);
	}

	.ill-card {
		position: absolute;
		background: var(--lab-card);
		box-shadow: none;
		display: flex;
		flex-direction: column;
		gap: 6px;
	}

	.ill-card-large {
		width: 48px;
		height: 60px;
		border-radius: 10px;
		padding: 8px;
		left: 195px;
		top: 18px;
	}

	.ill-card-small {
		width: 40px;
		height: 50px;
		border-radius: 8px;
		padding: 7px;
		gap: 5px;
		left: 225px;
		top: 40px;
	}

	.ill-line {
		width: 100%;
		height: 4px;
		border-radius: 2px;
		background: var(--warm);
	}

	.ill-line-accent {
		background: var(--lab-accent-light);
	}

	.ill-line-short {
		width: 24px;
	}

	.ill-doc {
		width: 36px;
		height: 44px;
		border-radius: 6px;
		background: var(--lab-card);
		box-shadow: none;
		position: absolute;
		left: 15px;
		top: 40px;
		padding: 8px;
		display: flex;
		flex-direction: column;
		gap: 4px;
	}

	.ill-doc-line {
		width: 100%;
		height: 3px;
		border-radius: 1.5px;
		background: var(--warm);
	}

	.ill-doc-line-accent {
		background: var(--lab-accent-light);
	}

	.ill-doc-line-short {
		width: 12px;
	}

	.ill-heart {
		position: absolute;
		left: 50px;
		top: 70px;
		font-size: 17px;
		color: var(--heart-red);
	}

	.ill-dot {
		position: absolute;
		border-radius: 50%;
		background: var(--lab-accent-light);
	}

	.ill-dot-a {
		width: 6px;
		height: 6px;
		left: 160px;
		top: 80px;
	}

	.ill-dot-b {
		width: 4px;
		height: 4px;
		left: 80px;
		top: 105px;
	}

	.ill-dot-c {
		width: 5px;
		height: 5px;
		background: var(--line);
		left: 200px;
		top: 110px;
	}

	.result-illustration .ill-dot {
		width: 4px;
		height: 4px;
		left: 60px;
		top: 70px;
	}

	.quiz-body {
		min-height: 100vh;
		background: #FFFFFF;
		padding: 0;
	}

	/* 原稿 Quiz Card：白底、gap=28；顶部 padding 由 32 增至 48，让题目整体下沉。
	   顶部去圆角，避免父级灰色背景在圆角处露出导致“白色没有铺满”；底部保留 24px 圆角。 */
	.quiz-inner {
		display: flex;
		flex-direction: column;
		min-height: 100vh;
		background: #FFFFFF;
		border-radius: 0 0 24px 24px;
		padding: 48px 28px 40px;
		gap: 28px;
	}

	/* 原稿：题号 14px/500 #B0B0B0；进度条底 #ECECEC、填充 #7EC8A0，高 4px 圆角 2px */
	.quiz-index {
		display: block;
		font-size: 14px;
		font-weight: 500;
		color: var(--lab-text-3);
		letter-spacing: 1px;
	}

	.quiz-track {
		width: 100%;
		height: 4px;
		border-radius: 2px;
		background: var(--lab-track);
		overflow: hidden;
	}

	.quiz-track-fill {
		height: 4px;
		border-radius: 2px;
		background: var(--lab-accent);
	}

	/* 原稿题目：18px/700 #1A1A1A，行高 1.6，居中；与进度条之间额外留白 20px，提升视觉舒适度 */
	.quiz-question {
		display: block;
		margin-top: 20px;
		font-size: 18px;
		font-weight: 700;
		line-height: 1.6;
		color: var(--lab-text);
		text-align: center;
	}

	.rating-wrap {
		display: flex;
		flex-direction: column;
		gap: 14px;
	}

	.rating-row {
		position: relative;
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		padding: 0 4px;
	}

	.rating-line {
		position: absolute;
		left: 26px;
		right: 26px;
		top: 50%;
		height: 2px;
		transform: translateY(-50%);
		background: var(--line);
		z-index: 0;
	}

	/* 设计稿原稿：白底空心圆 + 2.5px 彩色描边，描边色与选中填充色由内联样式按档位注入 */
	.rating-dot {
		position: relative;
		z-index: 1;
		border-radius: 50%;
		background: #FFFFFF;
		border: 2.5px solid var(--lab-track);
		box-sizing: border-box;
		transition: transform 0.15s ease-out;
	}

	.rating-dot-selected {
		transform: scale(1.06);
	}

	.rating-labels {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		padding: 0 4px;
	}

	.rating-label {
		width: 44px;
		font-size: 12px;
		color: #F0A060;
		text-align: center;
	}

	.rating-label-center {
		text-align: center;
		color: #B0B0B0;
	}

	.rating-label-right {
		text-align: center;
		color: #7EC8A0;
	}

	.quiz-actions {
		margin-top: 40px;
		display: flex;
		flex-direction: row;
		gap: 16px;
	}

	/* 原稿「上一题」：白底 + 浅灰描边 #F0F0F0 + 深灰字 */
	.quiz-prev-button {
		flex: 1;
		min-width: 0;
		padding: 14px 0;
		min-height: 52px;
		border-radius: 24px;
		background: #FFFFFF;
		border: 1px solid var(--lab-divider);
		color: var(--lab-text-2);
		font-size: 16px;
		font-weight: 500;
	}

	.quiz-prev-button::after {
		border: 0;
	}

	/* 原稿「下一题」：#7EC8A0 填充 + 白字 */
	.quiz-next-button {
		flex: 1;
		min-width: 0;
		padding: 14px 0;
		min-height: 52px;
		border-radius: 24px;
		background: var(--lab-accent);
		color: #FFFFFF;
		font-size: 16px;
		font-weight: 600;
	}

	.quiz-next-button::after {
		border: 0;
	}

	.quiz-aux {
		margin-top: 40px;
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: center;
		gap: 12px;
	}

	.quiz-aux-button {
		padding: 8px 12px;
		font-size: 13px;
		color: var(--lab-text-3);
		background: transparent;
	}

	.quiz-aux-button::after {
		border: 0;
	}

	.result-detail {
		padding: 10px 20px 32px;
		background: #FFFFFF;
		min-height: 100vh;
	}

	/* 类型 hero 卡片：浅绿圆角背景包裹类型标题 + 小猫 + 昵称版本 */
	.result-hero-card {
		background: #E8F5EE;
		border-radius: 30px;
		padding: 20px 20px 22px;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
	}
	.hero-subtitle {
		font-size: 13px;
		color: #2C2C2A;
	}
	.hero-type {
		font-size: 36px;
		font-weight: 500;
		color: #1F5C43;
		letter-spacing: 2px;
		margin-top: 6px;
	}
	.hero-cat {
		width: 124px;
		height: 124px;
		border-radius: 62px;
		background: #FFFFFF;
		display: flex;
		align-items: center;
		justify-content: center;
		margin-top: 18px;
		overflow: hidden;
	}
	.hero-cat-img {
		width: 100%;
		height: 100%;
	}
	.hero-meta {
		font-size: 13px;
		color: #9A9A95;
		margin-top: 13px;
	}

	/* 四维特质分布 */
	.dimension-block {
		margin-top: 22px;
	}
	.block-title {
		font-size: 13px;
		font-weight: 500;
		color: #2C2C2A;
		margin-bottom: 14px;
	}
	.dimension-row {
		display: flex;
		flex-direction: row;
		align-items: center;
		margin-bottom: 14px;
	}
	.dimension-row:last-child {
		margin-bottom: 0;
	}
	.dim-left,
	.dim-right {
		font-size: 13px;
		color: #444441;
		width: 78px;
	}
	.dim-left {
		text-align: left;
	}
	.dim-right {
		text-align: right;
	}
	.dim-track {
		flex: 1;
		height: 8px;
		border-radius: 4px;
		background: #EDEDEB;
		position: relative;
		margin: 0 6px;
		overflow: hidden;
	}
	.dim-fill {
		position: absolute;
		right: 0;
		top: 0;
		height: 8px;
		background: #7EC8A0;
		border-radius: 4px;
	}

	/* 五板块婚恋解读 */
	.interpret-block {
		margin-top: 24px;
	}
	.interpret-card {
		background: #F7F7F5;
		border-radius: 14px;
		padding: 14px 16px;
		margin-bottom: 12px;
	}
	.match-card {
		background: #E8F5EE;
