			matchComplement: { type: 'ISTP', name: '鉴赏家' },
			matchCaution: { type: 'ENTJ', name: '指挥官' }
		},
		ESTP: {
			loveBase: '随性热烈的激情恋爱，偏爱新鲜有趣的陪伴，讨厌刻板沉闷的关系，爱意藏在大胆直接的行动里。',
			advantage: '风趣幽默，相处永远有新鲜感；行动力强，想到就做不纠结；心态松弛，遇事不钻牛角尖。',
			shortcoming: '缺乏耐心，容易厌倦平淡；讨厌被束缚，不愿过早定下来；说话直白，容易无意中伤人。',
			idealPartner: '性格松弛，不控制不黏人；能一起探索新鲜事物；不纠结于形式化的承诺。',
			matchSoul: { type: 'ISFJ', name: '守卫者' },
			matchComplement: { type: 'ESFP', name: '表演者' },
