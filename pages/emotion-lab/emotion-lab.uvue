<template>
	<view class="lab-page">
		<scroll-view class="lab-scroll" scroll-y>
			<view v-if="loading" class="state-block">
				<text class="state-title">正在加载</text>
				<text class="state-message">正在读取你的测试状态</text>
			</view>

			<view v-else-if="errorMessage != ''" class="state-block">
				<text class="state-title">暂时无法加载</text>
				<text class="state-message">{{ errorMessage }}</text>
				<button class="retry-button" @click="loadSummary">重试</button>
			</view>

			<view v-else-if="viewState == 'intro'" class="lab-content" :class="{ 'lab-content-mint': !hasTestedType }">
				<text class="guide-text">探索你的人格特质，找到同频合拍的人</text>

			<view v-if="hasTestedType" class="result-card">
				<view class="card-hero result-hero">
					<view class="result-edit" @click="openResultActionSheet">
						<text class="result-edit-icon">✎</text>
					</view>
					<text class="hero-type">你的MBTI：{{ currentMbtiType }}</text>
				<view class="result-illustration">
					<image
						class="result-mbti-cat"
						:src="'/static/mbti/' + currentMbtiType.toLowerCase() + '.png'"
						mode="aspectFill"
					/>
					<view class="ill-star ill-star-a"></view>
						<view class="ill-star ill-star-b"></view>
						<view class="ill-star ill-star-c"></view>
						<view class="ill-doc">
							<view class="ill-doc-line ill-doc-line-accent"></view>
							<view class="ill-doc-line"></view>
							<view class="ill-doc-line ill-doc-line-short"></view>
						</view>
						<view class="ill-dot"></view>
					</view>
				</view>

			<text class="result-description">{{ resultDescription }}</text>

				<button class="primary-button" @click="openResult">查看完整解读</button>
			</view>

			<view v-else class="main-card">
				<view class="card-hero">
					<view class="lab-illustration">
						<view class="ill-head"></view>
						<view class="ill-eye ill-eye-left"></view>
						<view class="ill-eye ill-eye-right"></view>
						<view class="ill-smile"></view>
						<view class="ill-star ill-star-left"></view>
						<view class="ill-star ill-star-right"></view>
						<view class="ill-bubble">
							<text class="ill-bubble-text">MBTI</text>
						</view>
						<view class="ill-card ill-card-large">
							<view class="ill-line ill-line-accent"></view>
							<view class="ill-line"></view>
							<view class="ill-line ill-line-short"></view>
						</view>
						<view class="ill-card ill-card-small">
							<view class="ill-line ill-line-accent"></view>
							<view class="ill-line"></view>
						</view>
						<text class="ill-heart">♥</text>
						<view class="ill-dot ill-dot-a"></view>
						<view class="ill-dot ill-dot-b"></view>
						<view class="ill-dot ill-dot-c"></view>
					</view>
				</view>

				<text class="card-title">你的MBTI解读待生成</text>
				<text class="card-subtitle">开始测试，解锁你的人格分析</text>

				<button class="primary-button" @click="openStartSheet">开始测试</button>
			</view>

				<view v-if="!hasTestedType && !canStartAssessment" class="review-notice">
					<text class="review-title">{{ startBlockTitle }}</text>
					<text class="review-message">{{ startBlockMessage }}</text>
				</view>

				<view class="section-header">
					<text class="section-title">合拍的人</text>
				</view>

				<view v-if="!hasTestedType" class="match-card">
					<view class="avatar-row">
						<view class="avatar-ghost" v-for="slot in ghostAvatars" :key="slot"></view>
						<view class="avatar-plus">
							<text class="avatar-plus-text">+</text>
						</view>
					</view>
					<text class="match-hint">参与测试即可查看与你合拍的人</text>
				</view>

				<view v-else>
					<view v-if="matchesLoading" class="state-block compact-state">
						<text class="state-title">正在寻找合拍的人</text>
					</view>

					<view v-else-if="matchesError != ''" class="match-card">
						<text class="match-hint">{{ matchesError }}</text>
					</view>
					<view v-else-if="matches.length == 0" class="match-card">
						<text class="match-hint">还没有可推荐的人，稍后再来看看</text>
					</view>

					<view v-else class="match-list">
						<view class="match-card" v-for="item in matches" :key="item.id" @click="openMatchProfile(item)" hover-class="match-card-active" hover-stay-time="150">
							<view class="match-top">
								<view class="match-user">
									<XsaAvatar :name="item.name" size="medium"></XsaAvatar>
									<view class="match-text">
										<text class="match-name">{{ item.name }}</text>
										<text class="match-meta">{{ item.age }}岁 · {{ item.city }}</text>
										<text class="match-school">{{ item.school }}</text>
									</view>
								</view>
								<view class="match-score">
									<text class="match-percent">{{ item.matchPercent }}%</text>
									<text class="match-score-label">合拍度</text>
								</view>
							</view>

							<view class="match-tags">
								<view
									v-for="tag in item.tags"
									:key="tag"
									class="match-tag"
									:class="{ 'match-tag-accent': tag == item.mbtiType }"
								>
									<text class="match-tag-text">{{ tag }}</text>
								</view>
							</view>

							<text class="match-bio">{{ item.bio }}</text>
						</view>
					</view>

					<view class="bottom-actions">
					<button class="history-circle-btn" @click="openHistory">
						<text class="ic ic-home ic-history"></text>
					</button>
						<button v-if="!matchesUnavailable" class="primary-button flex-button" :disabled="matchesLoading" @click="refreshMatches">
							{{ matchesLoading ? '正在更换...' : '换一批' }}
						</button>
					</view>
				</view>

				<view class="safe-area"></view>
			</view>

		<view v-else-if="viewState == 'questions'" class="quiz-body">
			<view v-if="currentQuestion != null" class="quiz-inner">
				<text class="quiz-index">{{ quizIndexLabel }}</text>

				<view class="quiz-track">
					<view class="quiz-track-fill" :style="{ width: progressPercent + '%' }"></view>
				</view>

				<text class="quiz-question">{{ currentQuestion.text }}</text>

				<view class="rating-wrap">
					<view class="rating-row">
						<view
							v-for="dot in ratingDots"
							:key="dot.value"
							class="rating-dot"
							:class="{ 'rating-dot-selected': currentAnswerValue == dot.value }"
						:style="{ width: dot.size + 'px', height: dot.size + 'px', borderColor: dot.color, background: currentAnswerValue == dot.value ? dot.color : '#FFFFFF' }"
						@click="selectAnswer(dot.value)"
						></view>
					</view>

					<view class="rating-labels">
						<text class="rating-label">不同意</text>
						<text class="rating-label rating-label-center">中立</text>
						<text class="rating-label rating-label-right">同意</text>
					</view>
				</view>

				<view class="quiz-actions">
					<button class="quiz-prev-button" :disabled="savingAnswer || currentQuestionIndex == 0" @click="previousQuestion">上一题</button>
					<button
						v-if="currentQuestionIndex < activeSession.questionIds.length - 1"
						class="quiz-next-button"
						:disabled="savingAnswer || currentAnswerValue == 0"
						@click="nextQuestion"
					>下一题</button>
					<button
						v-else
						class="quiz-next-button"
						:disabled="!allAnswersComplete || savingAnswer || submitting"
						@click="submitAssessment"
					>{{ submitting ? '正在提交...' : '提交并查看结果' }}</button>
				</view>

			<view class="quiz-aux">
				<view class="quiz-aux-button" @click="requestRetest">重新测试</view>
			</view>
			</view>

			<view v-else class="state-block compact-state">
				<text class="state-title">没有可显示的题目</text>
				<button class="ghost-button compact-button" @click="backToIntro">返回</button>
			</view>
		</view>

		<view v-else-if="viewState == 'result' && hasTestedType" class="result-detail">
			<view class="result-hero-card">
				<text class="hero-subtitle">你的人格类型是</text>
				<text class="hero-type">{{ currentMbtiType }}</text>
				<view class="hero-cat">
					<image class="hero-cat-img" :src="'/static/mbti/' + currentMbtiType.toLowerCase() + '.png'" mode="aspectFit" />
				</view>
				<text class="hero-meta">{{ heroMeta }}</text>
			</view>

			<view class="dimension-block">
				<text class="block-title">四维特质分布</text>
				<view v-for="row in dimensionView" :key="row.key" class="dimension-row">
					<text class="dim-left">{{ row.leftLabel }}</text>
					<view class="dim-track">
						<view class="dim-fill" :style="{ width: row.rightPercent + '%' }"></view>
					</view>
					<text class="dim-right">{{ row.rightLabel }}</text>
				</view>
			</view>

			<view class="interpret-block">
				<view class="interpret-card">
					<text class="interpret-label">恋爱底色</text>
					<text class="interpret-text">{{ currentInterpretation.loveBase }}</text>
				</view>
				<view class="interpret-card">
					<text class="interpret-label">伴侣优势</text>
					<text class="interpret-text">{{ currentInterpretation.advantage }}</text>
				</view>
				<view class="interpret-card">
					<text class="interpret-label">恋爱短板</text>
					<text class="interpret-text">{{ currentInterpretation.shortcoming }}</text>
				</view>
				<view class="interpret-card">
					<text class="interpret-label">理想伴侣需求</text>
					<text class="interpret-text">{{ currentInterpretation.idealPartner }}</text>
				</view>
				<view class="interpret-card match-card">
					<text class="interpret-label">婚恋匹配推荐</text>
					<view class="match-row">
						<view class="match-tag tag-soul">灵魂适配</view>
						<text class="match-name">{{ currentInterpretation.matchSoul.type }} {{ currentInterpretation.matchSoul.name }}</text>
					</view>
					<view class="match-row">
						<view class="match-tag tag-complement">互补优选</view>
						<text class="match-name">{{ currentInterpretation.matchComplement.type }} {{ currentInterpretation.matchComplement.name }}</text>
					</view>
					<view class="match-row">
						<view class="match-tag tag-caution">谨慎磨合</view>
						<text class="match-name">{{ currentInterpretation.matchCaution.type }} {{ currentInterpretation.matchCaution.name }}</text>
					</view>
				</view>
			</view>

			<view v-if="completedResult != null" class="sync-block">
				<checkbox-group class="confirm-group" @change="handleAssessmentConfirmChange">
					<label class="confirm-row">
						<checkbox value="confirmed" :checked="assessmentConfirmed" />
						<text class="confirm-text">我确认将本次结果同步到资料</text>
					</label>
				</checkbox-group>

				<button class="result-sync-btn" :disabled="!assessmentConfirmed || savingProfile" @click="saveAssessmentType">
					{{ savingProfile ? '正在同步...' : '同步本次结果' }}
				</button>
			</view>

			<button class="result-back-btn" @click="backToIntro">返回实验室</button>

			<view v-if="disclaimerText != ''" class="disclaimer-band">
				<text class="disclaimer-text">{{ disclaimerText }}</text>
				<text v-if="disclaimerVersion != ''" class="disclaimer-version">文案版本 {{ disclaimerVersion }}</text>
			</view>
		</view>
		</scroll-view>

		<XsaSheet :visible="startSheetVisible" @close="startSheetVisible = false">
			<view class="action-sheet">
				<view class="sheet-option" @click="handleSheetStart">
					<text class="sheet-option-text">开始测试</text>
				</view>
				<view class="sheet-divider"></view>
				<view class="sheet-option" @click="handleSheetManual">
					<text class="sheet-option-text">设置我的人格类型</text>
				</view>
				<view class="sheet-divider"></view>
				<view class="sheet-option" @click="startSheetVisible = false">
					<text class="sheet-option-text sheet-option-cancel">取消</text>
				</view>
			</view>
		</XsaSheet>

		<XsaSheet :visible="resultActionSheetVisible" @close="resultActionSheetVisible = false">
			<view class="action-sheet">
				<view class="sheet-option" @click="handleResultActionRetest">
					<text class="sheet-option-text">重新测试</text>
				</view>
				<view class="sheet-divider"></view>
				<view class="sheet-option" @click="handleResultActionChooseType">
					<text class="sheet-option-text">选择我的人格类型</text>
				</view>
				<view class="sheet-divider"></view>
				<view class="sheet-option" @click="resultActionSheetVisible = false">
					<text class="sheet-option-text sheet-option-cancel">取消</text>
				</view>
			</view>
		</XsaSheet>

		<XsaSheet :visible="retestConfirmVisible" title="重新测试" @close="cancelRetest">
			<view class="confirm-sheet">
				<text class="confirm-sheet-text">确定要重新测试吗？当前进度将被清除，并跳转到第一题。</text>
				<view class="confirm-sheet-actions">
					<view class="confirm-sheet-btn confirm-sheet-cancel" @click="cancelRetest">取消</view>
					<view class="confirm-sheet-btn confirm-sheet-ok" @click="confirmRetest">确认</view>
				</view>
			</view>
		</XsaSheet>

		<XsaSheet :visible="typeSheetVisible" title="选择我的人格类型" :tall="true" @close="closeTypeSheet">
			<view class="type-selector">
				<view class="type-row" v-for="group in typeGroups" :key="group.key">
					<view
						v-for="item in group.items"
						:key="item.type"
						class="type-cell"
						:class="[group.tone, { 'type-cell-selected': selectedType == item.type }]"
						@click="selectManualType(item.type)"
					>
						<text class="type-cell-label">{{ item.type }}</text>
						<text class="type-cell-nickname">{{ item.nickname }}</text>
					</view>
				</view>

				<view class="type-confirm">
					<checkbox-group @change="handleManualConfirmChange">
						<label class="confirm-row">
							<checkbox value="confirmed" :checked="manualConfirmed" />
							<text class="confirm-text">我确认将此自填类型同步到资料</text>
						</label>
					</checkbox-group>

					<button class="primary-button" :disabled="selectedType == '' || savingProfile" @click="saveManualType">
						{{ savingProfile ? '正在保存...' : '选好了' }}
					</button>
				</view>
			</view>
		</XsaSheet>
	</view>
</template>

<script setup lang="uts">
	import { ref, computed, onMounted } from 'vue'
	import XsaSheet from '@/components/XsaSheet.uvue'
	import XsaAvatar from '@/components/XsaAvatar.uvue'
	import {
		getEmotionLabSummary,
		getEmotionLabMatches,
		startMbtiAssessment,
		saveMbtiAnswer,
		submitMbtiAssessment,
		discardMbtiDraft,
		setMyMbtiType
	} from '@/api'

	const loading = ref(true)
	const starting = ref(false)
	const savingAnswer = ref(false)
	const submitting = ref(false)
	const discarding = ref(false)
	const savingProfile = ref(false)
	const matchesLoading = ref(false)
	const matchesError = ref('')
	const matchesUnavailable = ref(false)
	const errorMessage = ref('')
	const summary = ref(null as any)
	const viewState = ref('intro')
	const currentQuestionIndex = ref(0)
	const progressMessage = ref('')
	const selectedType = ref('')
	const manualResultType = ref('')
	const manualConfirmed = ref(false)
	const assessmentConfirmed = ref(false)
	const startSheetVisible = ref(false)
	const typeSheetVisible = ref(false)
	const typeSheetBackup = ref('')
	const resultActionSheetVisible = ref(false)
	const retestConfirmVisible = ref(false)
	const pendingRetestSessionId = ref('')
	const matches = ref([] as any[])

	const defaultScaleLabels: string[] = ['非常不符合', '比较不符合', '不确定', '比较符合', '非常符合']

	const MBTI_NICKNAMES: any = {
		INTJ: '建筑师',
		INTP: '逻辑学家',
		ENTJ: '指挥官',
		ENTP: '辩论家',
		INFJ: '提倡者',
		INFP: '调停者',
		ENFJ: '主人公',
		ENFP: '竞选者',
		ISTJ: '物流师',
		ISFJ: '守卫者',
		ESTJ: '总经理',
		ESFJ: '执政官',
		ISTP: '鉴赏家',
		ISFP: '探险家',
		ESTP: '企业家',
		ESFP: '表演者'
	}

	const MBTI_BRIEF_COPY: any = {
		INTJ: '独立、善于规划，习惯先把事情想清楚再行动。',
		INTP: '好奇心强，喜欢拆解问题，享受思考本身。',
		ENTJ: '目标感强，擅长组织推进，习惯把想法落成结果。',
		ENTP: '思维活跃，点子多，乐于尝试新的可能。',
		INFJ: '细腻且重价值感，倾向深度而非广度的相处。',
		INFP: '内心丰富，重视真实，愿意为在意的人留出空间。',
		ENFJ: '善于照顾他人感受，习惯主动维系关系。',
		ENFP: '热情真诚，容易被新鲜事物点燃，也乐于分享。',
		ISTJ: '踏实可靠，重视承诺，偏好稳定可预期的节奏。',
		ISFJ: '温和体贴，记得细节，习惯用行动表达关心。',
		ESTJ: '讲求效率与规则，做事干脆，愿意承担责任。',
		ESFJ: '重视和谐，擅长照顾身边人，喜欢有回应地相处。',
		ISTP: '冷静务实，动手能力强，压力下也能保持判断。',
		ISFP: '审美细腻，随和真诚，偏好用行动而非语言表达。',
		ESTP: '外向、务实、行动力强，在相处中偏爱直接沟通。',
		ESFP: '开朗热络，擅长活跃气氛，享受当下。'
	}

	// 16 型 MBTI 婚恋完整解读（统一 5 板块模板），用于测试结果页展示
	const MBTI_INTERPRETATION: any = {
		INTJ: {
			loveBase: '宁缺毋滥的智性恋爱，偏爱灵魂知己的陪伴，讨厌情绪化内耗的关系，爱意藏在未来规划的细节里。',
			advantage: '独立理性，遇事能冷静解决；眼光长远，会规划两个人的未来；专一靠谱，不轻易开始感情。',
			shortcoming: '外表冷淡，不擅长表达爱意；遇事爱讲道理，容易忽略对方情绪；防备心重，很难完全敞开心扉。',
			idealPartner: '精神同频，能跟上自己的思考节奏；情绪稳定，不无理取闹；尊重独立空间，不黏人纠缠。',
			matchSoul: { type: 'ENFP', name: '竞选者' },
			matchComplement: { type: 'INTP', name: '逻辑学家' },
			matchCaution: { type: 'ESFP', name: '表演者' }
		},
		INTP: {
			loveBase: '精神同频的松弛恋爱，偏爱互不打扰的陪伴，讨厌情绪化绑架的关系，爱意藏在主动的分享与探讨里。',
			advantage: '逻辑清晰，遇事能理性分析；包容度高，不强迫对方改变；思想有趣，能带来新鲜感。',
			shortcoming: '回避冲突，遇到矛盾习惯冷处理；容易沉浸自己世界，忽略伴侣感受；不擅长浪漫与情绪安抚。',
			idealPartner: '边界感强，不强迫亲密表达；精神同频，愿意和自己深度交流；包容慢热，不逼自己给承诺。',
			matchSoul: { type: 'ENFJ', name: '主人公' },
			matchComplement: { type: 'INTJ', name: '建筑师' },
			matchCaution: { type: 'ESFJ', name: '执政官' }
		},
		ENTJ: {
			loveBase: '势均力敌的并肩恋爱，偏爱共同成长的陪伴，讨厌软弱内耗的关系，爱意藏在为对方铺路的行动里。',
			advantage: '果断有担当，能扛事解决问题；上进心强，带着对方一起变好；理性清醒，不拖泥带水。',
			shortcoming: '强势好胜，习惯主导关系；遇事爱争输赢，忽略对方情绪；控制欲强，容易干涉对方选择。',
			idealPartner: '独立有主见，不依附不盲从；能力匹配，能和自己并肩同行；情绪稳定，不无理取闹。',
			matchSoul: { type: 'INFP', name: '调停者' },
			matchComplement: { type: 'ENTP', name: '辩论家' },
			matchCaution: { type: 'ISFP', name: '探险家' }
		},
		ENTP: {
			loveBase: '有趣碰撞的欢喜恋爱，偏爱思想交锋的陪伴，讨厌枯燥平淡的关系，爱意藏在互怼式的关心里。',
			advantage: '风趣幽默，相处永远不无聊；思维活跃，能带来新鲜视角；心态开放，不刻板不束缚。',
			shortcoming: '喜欢抬杠，容易引发矛盾；回避严肃承诺，让人没安全感；耐性不足，容易厌倦平淡。',
