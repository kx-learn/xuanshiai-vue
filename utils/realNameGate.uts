/**
 * 社区 / 申请认识 · 认证门槛
 * 产品覆盖（与 PRODUCT.md §互动门槛 一致）：
 * - 仅实名通过：常规社区互动（点赞 / 关注 / 评论 / 收藏 / 活动报名 / 纸飞机）、申请认识、参与话题
 * - 实名通过 + 人脸通过：发布动态（含带话题发布），见 guardCommunityVerification
 * - 双重认证（实名 + 学历过审）仅作展示加分，不作为任何操作门槛
 * - 浏览、举报、拉黑不要求实名
 *
 * 状态枚举（定版）：passed | missing | reviewing | rejected | revoked
 * 兼容旧值：pending→reviewing，failed→rejected
 */

import { getMeProfile } from '@/api/user.uts'

export type RealNameStatus = 'passed' | 'missing' | 'reviewing' | 'rejected' | 'revoked'
export type EducationStatus = 'passed' | 'missing' | 'reviewing' | 'rejected'

export type GateAction =
  | 'publish'
  | 'like'
  | 'follow'
  | 'comment'
  | 'collect'
  | 'topicJoin'
  | 'activitySignup'
  | 'paperPlane'
  | 'apply'

const ACTION_LABELS: Record<string, string> = {
  publish: '发布动态',
  like: '点赞',
  follow: '关注',
  comment: '评论',
  collect: '收藏',
  topicJoin: '加入话题',
  activitySignup: '报名活动',
  paperPlane: '使用纸飞机',
  apply: '申请认识'
}

/** 归一化历史状态值 */
function normalizeStatus(raw: any): RealNameStatus {
  if (raw == null) return 'missing'
  const s = '' + raw
  if (s == 'passed' || s == 'true' || s == '1') return 'passed'
  if (s == 'reviewing' || s == 'pending') return 'reviewing'
  if (s == 'rejected' || s == 'failed') return 'rejected'
  if (s == 'revoked') return 'revoked'
  if (s == 'missing' || s == 'false' || s == '0') return 'missing'
  return 'missing'
}

/** 从当前用户资料解析实名状态（兼容 boolean / 文案列表 / 旧枚举） */
export function resolveRealNameStatus(profile: any): RealNameStatus {
  if (profile == null) return 'missing'
  if (profile.realNameStatus != null) {
    return normalizeStatus(profile.realNameStatus)
  }
  const certs = profile.certifications
  if (certs != null && typeof certs === 'object' && !Array.isArray(certs)) {
    if (certs.realName === true || certs.realName === 'passed') return 'passed'
    if (certs.realName === 'pending' || certs.realName === 'reviewing') return 'reviewing'
    if (certs.realName === 'failed' || certs.realName === 'rejected') return 'rejected'
    return 'missing'
  }
  if (Array.isArray(certs)) {
    for (let i = 0; i < certs.length; i++) {
      const item = certs[i]
      if (item == '实名' || item == 'realName' || (item != null && item.name == '实名' && item.passed == true)) {
        return 'passed'
      }
    }
  }
  if (profile.certList != null && Array.isArray(profile.certList)) {
    if (profile.certList.indexOf('实名') >= 0) return 'passed'
  }
  return 'missing'
}

export function isRealNamePassed(profile: any): boolean {
  return resolveRealNameStatus(profile) == 'passed'
}

export function actionLabel(action: GateAction | string): string {
  const label = ACTION_LABELS[action]
  return label != null ? label : '该操作'
}

/**
 * 拉取当前用户并校验是否已实名
 * @returns { ok, profile, status, message }
 */
export async function ensureRealName(action: GateAction | string = 'publish') {
  try {
    const res = await getMeProfile()
    const profile = res != null && res.success ? res.data : null
    const status = resolveRealNameStatus(profile)
    if (status == 'passed') {
      return {
        ok: true,
        profile,
        status,
        message: ''
      }
    }
    const label = actionLabel(action)
    let message = `完成实名认证后即可${label}`
    if (action == 'apply') {
      message = '需要实名认证'
      if (status == 'reviewing') {
        message = '实名认证审核中，通过后即可申请认识'
      } else if (status == 'rejected') {
        message = '实名认证未通过，请重新认证后再申请认识'
      } else if (status == 'revoked') {
        message = '实名认证已撤销，请重新认证后再申请认识'
      }
    } else if (status == 'reviewing') {
      message = `实名认证审核中，通过后即可${label}`
    } else if (status == 'rejected') {
      message = `实名认证未通过，请重新认证后再${label}`
    } else if (status == 'revoked') {
      message = `实名认证已撤销，请重新认证后再${label}`
    }
    return {
      ok: false,
      profile,
      status,
      message
    }
  } catch (e) {
    return {
      ok: false,
      profile: null,
      status: 'missing' as RealNameStatus,
      message: '暂时无法确认认证状态，请稍后重试'
    }
  }
}

/** 从当前用户资料解析学历认证状态（兼容 boolean / 文案列表 / 旧枚举） */
export function resolveEducationStatus(profile: any): EducationStatus {
  if (profile == null) return 'missing'
  if (profile.educationStatus != null) {
    return normalizeStatus(profile.educationStatus) as EducationStatus
  }
  const certs = profile.certifications
  if (certs != null && typeof certs === 'object' && !Array.isArray(certs)) {
    if (certs.education != null) return normalizeStatus(certs.education) as EducationStatus
  }
  if (profile.certList != null && Array.isArray(profile.certList)) {
    if (profile.certList.indexOf('学历') >= 0) return 'passed'
  }
  return 'missing'
}

/**
 * 拉取当前用户并校验实名和学历认证是否均已通过。
 * 仅用于双重认证展示 / 预留场景。
 * 操作门槛请用：常规互动与参与话题 → ensureRealName；发布动态 → guardCommunityVerification。
 */
export async function ensureDualVerification(action: GateAction | string = 'topicJoin') {
  const realNameResult = await ensureRealName(action)
  if (!realNameResult.ok) return realNameResult

  try {
    const status = resolveEducationStatus(realNameResult.profile)
    if (status == 'passed') {
      return {
        ok: true,
        profile: realNameResult.profile,
        status,
        message: ''
      }
    }

    const label = actionLabel(action)
    let message = `完成实名认证和学历认证后即可${label}`
    if (status == 'reviewing') {
      message = `学历认证审核中，通过后即可${label}`
    } else if (status == 'rejected') {
      message = `学历认证未通过，请重新认证后再${label}`
    }
    return {
      ok: false,
      profile: realNameResult.profile,
      status,
      message
    }
  } catch (e) {
    return {
      ok: false,
      profile: null,
      status: 'missing' as EducationStatus,
      message: '暂时无法确认认证状态，请稍后重试'
    }
  }
}

/** 未通过双重认证时弹窗引导去认证页；已通过返回 true */
export async function guardDualVerification(action: GateAction | string = 'topicJoin'): Promise<boolean> {
  const result = await ensureDualVerification(action)
  if (result.ok) return true

  uni.showModal({
    title: '需要完成双重认证',
    content: result.message,
    confirmText: '去认证',
    cancelText: '稍后再说',
    success: (res) => {
      if (res.confirm) {
        uni.navigateTo({ url: '/pagesSub/profileExtra/certification?focus=realname' })
      }
    }
  })
  return false
}

/**
 * 未通过时弹窗引导去认证页；已通过返回 true
 */
export async function guardRealName(action: GateAction | string = 'publish'): Promise<boolean> {
  const result = await ensureRealName(action)
  if (result.ok) return true

  uni.showModal({
    title: '需要实名认证',
    content: result.message,
    confirmText: action == 'apply' ? '去认证' : '去实名',
    cancelText: '稍后再说',
    success: (res) => {
      if (res.confirm) {
        uni.navigateTo({ url: '/pagesSub/profileExtra/certification?focus=realname' })
      }
    }
  })
  return false
}

/** 社区发布需要实名认证和人脸认证均通过。 */
export async function guardCommunityVerification(): Promise<boolean> {
  try {
    const res = await getMeProfile()
    const profile = res != null && res.success ? res.data : null
    const realnamePassed = profile != null && Number(profile.realname_status) == 2
    const facePassed = profile != null && Number(profile.face_verified) == 1
    if (realnamePassed && facePassed) return true

    let message = '完成实名认证和人脸认证后，才能在社区发布动态。'
    if (!realnamePassed && !facePassed) {
      message = '请先完成实名认证和人脸认证，完成后才能在社区发布动态。'
    } else if (!realnamePassed) {
      message = '请先完成实名认证，完成后才能在社区发布动态。'
    } else {
      message = '请先完成人脸认证，完成后才能在社区发布动态。'
    }
    uni.showModal({
      title: !realnamePassed ? '需要实名认证' : '需要人脸认证',
      content: message,
      confirmText: '去认证',
      cancelText: '稍后再说',
      success: (result) => {
        if (result.confirm) {
          uni.navigateTo({ url: '/pagesSub/profileExtra/certification?focus=' + (!realnamePassed ? 'realname' : 'face') })
        }
      }
    })
    return false
  } catch (e) {
    uni.showToast({ title: '认证状态获取失败，请稍后重试', icon: 'none' })
    return false
  }
}
