<template>
	<view class="acb" :class="{ 'acb-show': showing }" :style="{ right: props.right, bottom: props.bottom }">
		<view class="acb-inner" @click="onBubbleTap">
			<text class="acb-text">{{ text }}</text>
			<view class="acb-tail"></view>
			<view class="acb-close" @click.stop="onClose">
				<text class="acb-close-x">×</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
/**
 * XsaAiCatBubble - AI 分身小猫的自动说话气泡
 *
 * 行为
 * - 自动弹出：随机 3~6 秒间隔出现一条，显示约 4.2 秒后自动收起，再进入下一轮随机间隔
 * - 文案随机且不连续重复上一条（共 12 条，第一人称「我」，小猫视角）
 * - 右上角 × ：点击后本次会话内不再自动弹出（状态存 utils/aiCatBubble.uts）
 * - 位置由父级传入 right / bottom，与小猫按钮对齐；尾巴（小尖角）指向小猫头部
 * - 隐藏时 pointer-events: none，不拦截页面任何操作
 *
 * 用法
 * <XsaAiCatBubble :active="true" right="112rpx" bottom="506rpx" @tap="openAiAvatar" />
 */

import { ref, watch, onMounted, onUnmounted } from 'vue'
import { isAiCatBubbleClosed, setAiCatBubbleClosed } from '@/utils/aiCatBubble.uts'

interface Props {
	/** 是否允许自动弹出（父级按页面状态控制，如切换 tab、详情页加载中应传 false） */
	active: boolean
	/** 气泡距屏幕右侧距离（默认与小猫按钮同侧） */
	right?: string
	/** 气泡距屏幕底部距离（默认悬于 136rpx 高的小猫上方） */
	bottom?: string
}

const props = withDefaults(defineProps<Props>(), {
	right: '112rpx',
	bottom: '506rpx'
})

const emit = defineEmits<{
	/** 点击气泡主体：父级一般用来打开 AI 分身聊天 */
	tap: []
	/** 用户点了关闭 */
	close: []
}>()

/* ==================== 文案（12 条，知遇口吻：聚合能力引导，不再只推销分身） ==================== */
const LINES: string[] = [
	'喵～我是知遇，点我看看我能帮你做什么',
	'想认识 TA？我可以先陪你看看公开资料',
	'想更了解自己？和我聊聊你的婚恋心相',
	'合拍度我帮你整理，只供参考，不替你做决定',
	'找人也可以来问我，筛选结果还是你自己看',
	'点我一下，认识自己、了解对方都从这里开始',
	'开场白想不出来？我可以给你一句建议',
	'我和 TA 的分身是同一个知遇，不冒充本人',
	'想知道从哪聊起？来看看我们的交集提示',
	'喵呜…你再不说话，我就要打瞌睡啦',
	'我在这儿守着，想聊随时找我',
	'戳戳我，看看知遇现在能帮你做什么'
]

/* ==================== 时机参数 ==================== */
const SHOW_MS = 4200 // 单条气泡停留时长
const MIN_GAP_MS = 3000 // 最小间隔
const MAX_GAP_MS = 6000 // 最大间隔

const showing = ref(false)
const text = ref('')
let lastIndex: number = -1
let popTimer: any = null
let hideTimer: any = null

function clearTimers(): void {
	if (popTimer != null) {
		clearTimeout(popTimer)
		popTimer = null
	}
	if (hideTimer != null) {
		clearTimeout(hideTimer)
		hideTimer = null
	}
}

/** 随机取一条，保证与上一条不重复 */
function pickLine(): string {
	const total = LINES.length
	if (total == 0) return ''
	let index = 0
	if (total > 1) {
		index = Math.floor(Math.random() * (total - 1))
		if (index >= lastIndex) index = index + 1
	}
	lastIndex = index
	return LINES[index]
}

/** 弹出一条 */
function pop(): void {
	if (isAiCatBubbleClosed()) return
	if (!props.active) return
	text.value = pickLine()
	showing.value = true
	if (hideTimer != null) clearTimeout(hideTimer)
	hideTimer = setTimeout(() => {
		hideTimer = null
		showing.value = false
		schedule()
	}, SHOW_MS)
}

/** 安排下一次弹出（随机 3~6 秒） */
function schedule(): void {
	if (popTimer != null) {
		clearTimeout(popTimer)
		popTimer = null
	}
	if (isAiCatBubbleClosed()) return
	if (!props.active) return
	const gap = MIN_GAP_MS + Math.floor(Math.random() * (MAX_GAP_MS - MIN_GAP_MS + 1))
	popTimer = setTimeout(() => {
		popTimer = null
		pop()
	}, gap)
}

/** 收起并停止（页面条件不满足时） */
function stop(): void {
	clearTimers()
	showing.value = false
}

function onBubbleTap(): void {
	emit('tap')
}

function onClose(): void {
	setAiCatBubbleClosed(true)
	clearTimers()
	showing.value = false
	emit('close')
}

onMounted(() => {
	schedule()
})

watch(
	() => props.active,
	(active) => {
		if (active) {
			schedule()
		} else {
			stop()
		}
	}
)

onUnmounted(() => {
	clearTimers()
})
</script>

<style scoped>
/* ==================== 小猫说话气泡 ==================== */
.acb {
	position: fixed;
	z-index: 58;
	max-width: 440rpx; /* ≈220px，小屏也不溢出 */
	opacity: 0;
	transform: translateY(14rpx) scale(0.92);
	transform-origin: 86% 100%;
	transition: opacity 0.26s ease, transform 0.32s cubic-bezier(0.34, 1.4, 0.64, 1);
	pointer-events: none;
}

.acb-show {
	opacity: 1;
	transform: translateY(0) scale(1);
	pointer-events: auto;
}

/* 清新淡绿气泡：薄荷底 + 青瓷描边，与页面主色 --accent(#2D7C72) 同族 */
.acb-inner {
	position: relative;
	padding: 18rpx 56rpx 18rpx 24rpx;
	border-radius: 22rpx;
	background-color: var(--cat-bubble-bg, #E9F7F1);
	border: 2rpx solid var(--cat-bubble-line, #BEDFCE);
	box-shadow: 0 10rpx 26rpx rgba(45, 124, 114, 0.16), inset 0 2rpx 0 rgba(255, 255, 255, 0.72);
}

.acb-text {
	display: block;
	font-size: 24rpx;
	line-height: 1.55;
	color: var(--cat-bubble-ink, #1F5E52);
	font-family: var(--sans, "PingFang SC");
	/* 长文案自动换行 */
	white-space: normal;
	word-break: break-all;
}

/* 指向小猫头部的小尖角（右下角），与气泡同色同描边 */
.acb-tail {
	position: absolute;
	right: 28rpx;
	bottom: -11rpx;
	width: 20rpx;
	height: 20rpx;
	background-color: var(--cat-bubble-bg, #E9F7F1);
	border-right: 2rpx solid var(--cat-bubble-line, #BEDFCE);
	border-bottom: 2rpx solid var(--cat-bubble-line, #BEDFCE);
	border-bottom-right-radius: 4rpx;
	transform: rotate(45deg);
}

/* 关闭按钮：64rpx（≈32px）热区，远大于图标本身 */
.acb-close {
	position: absolute;
	top: 0;
	right: 0;
	width: 64rpx;
	height: 64rpx;
	display: flex;
	align-items: center;
	justify-content: center;
}

.acb-close-x {
	font-size: 26rpx;
	line-height: 1;
	color: var(--cat-bubble-close, #7FB3A2);
}
</style>
