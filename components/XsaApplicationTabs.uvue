<template>
	<XsaSheet class="application-sheet" :visible="visible" title="认识申请" :tall="true" :large-text="largeText" @close="emitClose">
		<XsaTabs
			:model-value="activeTab"
			:tabs="tabs"
			variant="default"
			:large-text="largeText"
			@change="emitChange"
		>
			<view class="application-panel" :class="{ 'large-text': largeText }">
				<view class="loading-state" v-if="loading && applications.length == 0">
					<text class="load-text text-muted">正在加载申请...</text>
				</view>
				<XsaEmpty
					v-else-if="error != '' && applications.length == 0"
					type="noNetwork"
					:text="error"
						:show-action="true"
						action-text="重试"
						size="small"
						:large-text="largeText"
					@action="emitRetry"
				/>
				<XsaEmpty
					v-else-if="applications.length == 0"
					text="暂无申请"
					:description="activeTab == 0 ? '收到的申请会出现在这里' : '发出的申请会出现在这里'"
						size="small"
						:large-text="largeText"
				/>
				<view v-else class="app-list">
					<view class="app-item" v-for="item in applications" :key="item.id">
						<view class="app-avatar protected" v-if="protectPhotos">
							<view class="protected-avatar-mark"></view>
						</view>
						<image class="app-avatar" v-else :src="item.avatar" mode="aspectFill"></image>
						<view class="app-meta">
							<text class="app-name">{{ item.name }}</text>
							<text class="app-msg text-muted">{{ item.message }}</text>
							<text v-if="item.sourceText" class="app-msg text-accent">{{ item.sourceText }}</text>
						</view>
						<view class="app-actions" v-if="activeTab == 0 && item.status == 'pending'">
							<XsaButton
								variant="secondary"
								:size="largeText ? 'large' : 'small'"
								:large-text="largeText"
								:disabled="actionId != 0"
								@click="emitReject(item)"
								class="application-reject"
							>拒绝</XsaButton>
							<XsaButton
								variant="primary"
								:size="largeText ? 'large' : 'small'"
								:large-text="largeText"
								:loading="actionId == item.id"
								:disabled="actionId != 0 && actionId != item.id"
								@click="emitAccept(item)"
								class="application-accept"
							>同意</XsaButton>
						</view>
						<text v-else class="app-status text-muted">{{ item.statusText }}</text>
					</view>
				</view>

				<text
					v-if="applications.length > 0 && error != ''"
					class="retry-text text-accent application-retry"
					@click="emitRetry"
				>加载失败，点击重试</text>
				<view class="application-more" v-else-if="applications.length > 0 && hasMore">
					<XsaButton
						variant="text"
						:size="largeText ? 'large' : 'small'"
						:large-text="largeText"
						:loading="loading"
						@click="emitLoadMore"
					>加载更多</XsaButton>
				</view>
			</view>
		</XsaTabs>
	</XsaSheet>
</template>

<script setup lang="uts">
	import XsaButton from '@/components/XsaButton.uvue'
	import XsaEmpty from '@/components/XsaEmpty.uvue'
	import XsaSheet from '@/components/XsaSheet.uvue'
	import XsaTabs from '@/components/XsaTabs.uvue'

	interface Props {
		visible: boolean
		activeTab: number
		tabs: string[]
		applications: any[]
		loading: boolean
		error: string
		actionId: number
		hasMore: boolean
		largeText?: boolean
		protectPhotos?: boolean
	}

	const props = withDefaults(defineProps<Props>(), {
		largeText: false,
		protectPhotos: false
	})

	const emit = defineEmits<{
		close: []
		change: [index: number]
		retry: []
		'load-more': []
		accept: [item: any]
		reject: [item: any]
	}>()

	const emitClose = () => emit('close')
	const emitChange = (index: number) => emit('change', index)
	const emitRetry = () => emit('retry')
	const emitLoadMore = () => emit('load-more')
	const emitAccept = (item: any) => emit('accept', item)
	const emitReject = (item: any) => emit('reject', item)
</script>

<style scoped>
	.application-panel {
		padding-top: 14px;
	}

	.loading-state {
		min-height: 120px;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.load-text,
	.retry-text {
		font-size: 13px;
	}

	.app-list {
		display: flex;
		flex-direction: column;
		gap: 12px;
	}

	.app-item {
		display: flex;
		flex-direction: row;
		align-items: center;
		gap: 10px;
		padding-bottom: 12px;
		border-bottom: 1px solid var(--line);
	}

	.app-avatar {
		width: 48px;
		height: 48px;
		border-radius: 999px;
		flex-shrink: 0;
		overflow: hidden;
	}

	.app-avatar.protected {
		background: var(--warm);
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.protected-avatar-mark {
		width: 28px;
		height: 28px;
		border-radius: 999px;
		background: var(--accent-bg);
		filter: blur(5px);
	}

	.app-meta {
		min-width: 0;
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: 4px;
	}

	.app-name {
		font-size: 13px;
		font-weight: 700;
	}

	.app-msg,
	.app-status {
		font-size: 11px;
	}

	.app-status,
	.app-actions {
		flex-shrink: 0;
	}

	.app-actions {
		display: flex;
		flex-direction: row;
		gap: 6px;
	}

	.application-more {
		display: flex;
		justify-content: center;
		padding: 16px 0 4px;
	}

	.application-retry {
		display: block;
		padding: 16px 0 4px;
		text-align: center;
	}

	.large-text .load-text,
	.large-text .retry-text,
	.large-text .app-msg,
	.large-text .app-status {
		font-size: 14px;
	}

	.large-text .app-name {
		font-size: 16px;
	}
</style>
