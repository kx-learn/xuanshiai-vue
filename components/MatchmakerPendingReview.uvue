<template>
  <view class="pr-shell">

    <!-- ============ 列表视图 ============ -->
    <view v-if="subview == ''" class="pr-main">
      <scroll-view scroll-x class="pr-tabs" :show-scrollbar="false">
        <view class="pr-tabs-row">
          <view v-for="tab in tabs" :key="tab.key" class="pr-tab" :class="{ active: activeTab == tab.key }" @tap="selectTab(tab.key)">
            <text>{{ tab.label }}</text>
            <view class="pr-tab-line"></view>
          </view>
        </view>
      </scroll-view>

      <view class="pr-search">
        <text class="pr-search-icon">⌕</text>
        <input class="pr-search-input" placeholder="请输入昵称/编号/姓名/手机号" placeholder-class="pr-search-ph" :value="keyword" confirm-type="search" @input="onKeyword" @confirm="loadMembers" />
        <view class="pr-search-btn" @tap="loadMembers"><text>搜索</text></view>
      </view>

      <scroll-view scroll-y class="pr-list" :show-scrollbar="false">
        <view v-if="loading" class="state-card"><text>正在加载资料数据…</text></view>
        <view v-else-if="errorMessage != ''" class="state-card">
          <text>{{ errorMessage }}</text>
          <view class="state-action" @tap="loadMembers"><text>重新加载</text></view>
        </view>
        <view v-else-if="members.length == 0" class="state-card"><text>{{ emptyText }}</text></view>

          <view v-for="member in members" :key="member.user_id" class="mcard" :id="'mcard-' + member.user_id">
          <view class="mcard-top">
            <view class="mcard-ark"><text class="mcard-ark-glyph">◈</text><text>公开档案</text></view>
            <text class="mcard-no">编号：G{{ member.user_id }}</text>
            <view class="mcard-status" :class="'st-' + member.review_status.toLowerCase()" @tap="openReview(member)">
              <text>{{ reviewLabel(member.review_status) }}</text>
              <text class="mcard-status-dot">●</text>
            </view>
          </view>

          <view class="mcard-body">
            <view class="mcard-ava" :class="member.gender == 1 ? 'male' : 'female'">
              <image v-if="member.avatar" :src="member.avatar" mode="aspectFill" />
              <text v-else>{{ avatarText(member.nickname) }}</text>
              <view class="mcard-ava-badge"><text>{{ member.gender == 1 ? '♂' : (member.gender == 2 ? '♀' : '') }}</text></view>
            </view>
            <view class="mcard-info">
              <view class="mcard-name-row">
                <text class="mcard-name">{{ member.nickname }}</text>
                <view class="realname-tag" :class="member.realname_status == 2 ? 'ok' : ''"><text>{{ member.realname_status == 2 ? '已实名' : '未实名' }}</text></view>
              </view>
              <text class="mcard-meta">{{ memberMeta(member) }}</text>
              <view class="mcard-owner" @tap="openAssign(member)">
                <text class="mcard-owner-glyph">❥</text>
                <text class="mcard-owner-label">跟进服务：</text>
                <text class="mcard-owner-value">{{ member.matchmaker_name || '待分派' }}</text>
              </view>
              <view class="mcard-reg">
                <text class="mcard-reg-glyph">◷</text>
                <text>登记：{{ formatTime(member.created_at) }}</text>
              </view>
            </view>
          </view>

          <text v-if="member.review_status == 'REJECTED' && member.review_reason" class="mcard-reason">弃海说明：{{ member.review_reason }}</text>

          <view class="mcard-actions">
            <view :id="'more-trigger-' + member.user_id" class="act-more" @tap.stop="toggleMenu(member, $event)"><text>更多</text></view>
            <view class="act" @tap="openContact(member)"><text>联系</text></view>
            <view class="act" @tap="openFollowUps(member)"><text>跟进({{ member.followCount || 0 }})</text></view>
            <view class="act" @tap="copyProfile(member)"><text>复制资料</text></view>
            <view class="act" @tap="onEditProfile(member)"><text>编辑资料</text></view>
          </view>

        </view>
      </scroll-view>

      <view class="review-float-actions">
        <view class="fab-enter" @tap="onEnterMember"><text class="fab-enter-glyph">✎</text><text>录入</text></view>
        <view class="fab-filter" @tap="onFilter"><text class="fab-filter-glyph">☲</text><text>筛选</text></view>
      </view>
    </view>

    <!-- 页面级筛选抽屉，放在滚动列表之外，避免被列表或卡片裁切。 -->
    <view v-if="filterVisible" class="filter-layer">
      <view class="filter-mask" @tap="closeMemberFilter"></view>
      <view class="filter-drawer" @tap.stop>
        <view class="filter-head">
          <view>
            <text class="filter-title">条件筛选</text>
            <text class="filter-subtitle">按会员资料缩小查看范围</text>
          </view>
          <view class="filter-close" @tap="closeMemberFilter"><text>✕</text></view>
        </view>
        <scroll-view scroll-y class="filter-scroll" :show-scrollbar="false">
          <view v-for="row in filterRows" :key="row.key" class="filter-row">
            <view class="filter-row-summary" @tap="toggleMemberFilter(row.key)">
              <text class="filter-label">{{ row.label }}</text>
              <view class="filter-current"><text>{{ filterValueText(row.key) }}</text><text class="filter-chevron">›</text></view>
            </view>
            <view v-if="expandedFilterKey == row.key" class="filter-options">
              <view v-for="option in row.options" :key="row.key + option.value" class="filter-option" :class="{ selected: memberFilter[row.key] == option.value }" @tap="selectMemberFilter(row.key, option.value)">
                <text>{{ option.label }}</text>
              </view>
            </view>
          </view>
          <text class="filter-data-note">筛选结果会依据当前可用的会员资料实时更新。</text>
        </scroll-view>
        <view class="filter-footer">
          <view class="filter-reset" @tap="resetMemberFilter"><text>重置</text></view>
          <view class="filter-confirm" @tap="confirmMemberFilter"><text>确定</text></view>
        </view>
      </view>
    </view>

    <!-- 页面级菜单不受 scroll-view 裁切，坐标取自点击事件。 -->
    <view v-if="menuForId != 0 && menuMember != null" class="more-layer" @tap="closeMenu">
      <view class="more-pop" :style="{ left: menuLeft + 'px', top: menuTop + 'px' }" @tap.stop>
        <view class="more-item" @tap="openIntroductions(menuMember)"><text>牵线({{ menuMember.introCount || 0 }})</text></view>
        <view class="more-item" @tap="openMatch(menuMember)"><text>匹配</text></view>
        <view class="more-item" @tap="openNote(menuMember)"><text>红娘说</text></view>
        <view class="more-item" @tap="openAssign(menuMember)"><text>修改红娘</text></view>
        <view class="more-item last" @tap="onAbandonEntry(menuMember)"><text>{{ menuMember.review_status == 'REJECTED' ? '已在弃海' : '放入弃海' }}</text></view>
      </view>
    </view>

    <!-- ============ 子页：牵线记录 ============ -->
    <view v-else-if="subview == 'introductions' && selected != null" class="subpage">
      <view class="subpage-head">
        <text class="subpage-title">会员 {{ selected.nickname }} 的牵线记录</text>
        <view class="subpage-close" @tap="closeSubpage"><text>✕</text></view>
      </view>
      <view class="seg">
        <view class="seg-item" :class="{ on: introTab == 'OUTGOING' }" @tap="selectIntroTab('OUTGOING')"><text>主动牵线</text></view>
        <view class="seg-item" :class="{ on: introTab == 'INCOMING' }" @tap="selectIntroTab('INCOMING')"><text>被动牵线</text></view>
      </view>
      <scroll-view scroll-y class="subpage-list" :show-scrollbar="false">
        <view v-if="introLoading" class="state-card"><text>正在加载牵线记录…</text></view>
        <view v-else-if="visibleIntroductions.length == 0" class="state-card"><text>暂无牵线记录</text></view>
        <view v-for="row in visibleIntroductions" :key="row.id" class="intro-row">
          <view class="intro-ava"><text>{{ avatarText(row.counterpart_nickname) }}</text></view>
          <view class="intro-copy">
            <text class="intro-name">{{ row.counterpart_nickname }}</text>
            <text class="intro-sub">编号：G{{ row.counterpart_user_id }} · {{ row.direction == 'OUTGOING' ? '会员主动申请' : '对方申请会员' }}</text>
          </view>
          <view class="intro-right">
            <text class="intro-status" :class="'ms-' + row.status">{{ matchStatusLabel(row.status) }}</text>
            <text class="intro-time">{{ formatTime(row.created_at) }}</text>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- ============ 子页：匹配 ============ -->
    <view v-else-if="subview == 'match' && selected != null" class="subpage">
      <view class="subpage-head">
        <text class="subpage-title">匹配合适的人</text>
        <view class="subpage-close" @tap="closeSubpage"><text>✕</text></view>
      </view>
      <scroll-view scroll-y class="subpage-list" :show-scrollbar="false">
        <view class="match-member">
          <view class="match-member-ava"><image v-if="selected.avatar" :src="selected.avatar" mode="aspectFill" /><text v-else>{{ avatarText(selected.nickname) }}</text></view>
          <view class="match-member-copy">
            <view class="mcard-name-row"><text class="mcard-name">{{ selected.nickname }}</text><text class="match-member-no">会员(G{{ selected.user_id }})</text></view>
            <text class="mcard-meta">{{ memberMeta(selected) }}</text>
          </view>
        </view>

        <view class="match-pref">
          <text class="match-pref-title">根据该会员的择偶要求：</text>
          <view class="match-pref-chips">
            <view v-for="chip in preferenceChips" :key="chip" class="match-chip"><text>{{ chip }}</text></view>
          </view>
        </view>

        <view class="match-tip">
          <text class="match-tip-title">温馨提示</text>
          <text class="match-tip-copy">状态为"停止相亲"、"已经脱单"的会员资料不会显示在匹配结果中。</text>
        </view>

        <view v-if="matchLoading" class="state-card"><text>正在匹配合适人选…</text></view>
        <view v-else-if="candidates.length == 0" class="state-card"><text>暂无符合条件的会员资料</text></view>
        <view v-for="row in candidates" :key="row.user_id" class="candidate-card">
          <view class="mcard-body">
            <view class="mcard-ava" :class="row.gender == 1 ? 'male' : 'female'">
              <image v-if="row.avatar" :src="row.avatar" mode="aspectFill" />
              <text v-else>{{ avatarText(row.nickname) }}</text>
            </view>
            <view class="mcard-info">
              <view class="mcard-name-row"><text class="mcard-name">{{ row.nickname }}</text></view>
              <text class="cand-no">编号:G{{ row.user_id }}</text>
              <view class="mcard-owner"><text class="mcard-owner-glyph">❥</text><text class="mcard-owner-label">服务红娘：</text><text class="mcard-owner-value">{{ row.matchmaker_name || '待分派' }}</text></view>
            </view>
            <view class="cand-ark"><text>公开相亲</text></view>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- ============ 子页：录入会员 ============ -->
    <view v-else-if="subview == 'entry'" class="subpage entry-page">
      <view class="subpage-head">
        <text class="subpage-title">录入会员</text>
        <view class="subpage-close" @tap="closeSubpage"><text>✕</text></view>
      </view>
      <scroll-view scroll-y class="entry-scroll" :show-scrollbar="false">
        <view class="entry-card">
          <view class="entry-avatar" @tap="chooseEntryAvatar">
            <image v-if="entryDraft.avatar" :src="entryDraft.avatar" mode="aspectFill" />
            <view v-else class="entry-avatar-empty"><text class="entry-avatar-plus">＋</text><text>上传头像</text></view>
          </view>

          <view class="entry-row entry-code-row">
            <text class="entry-label">编号</text>
            <view class="entry-options"><view class="entry-option" :class="{ selected: entryDraft.codeMode == 'auto' }" @tap="entryDraft.codeMode = 'auto'"><text class="entry-radio"></text><text>系统自动</text></view><view class="entry-option" :class="{ selected: entryDraft.codeMode == 'custom' }" @tap="entryDraft.codeMode = 'custom'"><text class="entry-radio"></text><text>自定义</text></view></view>
          </view>
          <view v-if="entryDraft.codeMode == 'custom'" class="entry-row"><text class="entry-label">自定义编号</text><input class="entry-input" :value="entryDraft.memberCode" placeholder="请输入会员编号" @input="onEntryInput('memberCode', $event)" /></view>

          <view v-for="field in entryTextFields" :key="field.key" class="entry-row">
            <text class="entry-label">{{ field.label }}</text>
            <input class="entry-input" :type="field.type || 'text'" :value="entryDraft[field.key]" :placeholder="field.placeholder" @input="onEntryInput(field.key, $event)" />
          </view>

          <view class="entry-row"><text class="entry-label">性别</text><view class="entry-options"><view class="entry-option" :class="{ selected: entryDraft.gender == 1 }" @tap="entryDraft.gender = 1"><text class="entry-radio"></text><text>男</text></view><view class="entry-option" :class="{ selected: entryDraft.gender == 2 }" @tap="entryDraft.gender = 2"><text class="entry-radio"></text><text>女</text></view></view></view>
          <picker class="entry-row entry-picker" mode="date" :value="entryDraft.birthday" start="1940-01-01" end="2008-12-31" @change="onEntryBirthday"><text class="entry-label">生日</text><view class="entry-value"><text>{{ entryDraft.birthday || '请选择' }}</text><text class="entry-chevron">›</text></view></picker>
          <view class="entry-row"><text class="entry-label">体重</text><input class="entry-input" type="digit" :value="entryDraft.weight" placeholder="例如 50" @input="onEntryInput('weight', $event)" /><text class="entry-unit">kg</text></view>
          <view class="entry-row"><text class="entry-label">身高</text><input class="entry-input" type="number" :value="entryDraft.height" placeholder="例如 165" @input="onEntryInput('height', $event)" /><text class="entry-unit">cm</text></view>

          <view class="entry-row entry-status-row"><text class="entry-label">状态</text><view class="entry-options"><view class="entry-option" :class="{ selected: entryDraft.status == 'PUBLIC' }" @tap="entryDraft.status = 'PUBLIC'"><text class="entry-radio"></text><text>公开相亲</text></view><view class="entry-option" :class="{ selected: entryDraft.status == 'PAUSED' }" @tap="entryDraft.status = 'PAUSED'"><text class="entry-radio"></text><text>暂停相亲</text></view></view></view>
          <view class="entry-row entry-readonly"><text class="entry-label">审核</text><text>待审</text></view>
          <view class="entry-row entry-readonly"><text class="entry-label">红娘</text><text>当前服务红娘</text></view>
        </view>
        <text class="entry-note">请确认本人已同意录入并完成必要的信息告知；提交后将进入公开资料审核。</text>
      </scroll-view>
      <view class="entry-footer"><view class="entry-submit" :class="{ disabled: entrySubmitting }" @tap="submitEntry"><text>{{ entrySubmitting ? '正在提交' : '完成' }}</text></view></view>
    </view>

    <!-- ============ 红娘说 / 修改红娘 / 弃因 / 联系 / 跟进 面板 ============ -->
    <view v-if="sheet != ''" class="overlay" @tap="closeSheet">
      <view class="panel" @tap.stop>
        <view v-if="sheet != 'assign'" class="panel-head">
          <text class="panel-title">{{ sheetTitle }}</text>
          <view class="panel-close" @tap="closeSheet"><text>✕</text></view>
        </view>

        <view v-if="sheet == 'note' && selected != null" class="panel-body">
          <textarea class="panel-textarea" maxlength="200" placeholder="请输入一段红娘对该会员的评价，本信息公开展示，限制200汉字" :value="noteDraft" @input="onNoteDraft" />
          <view class="panel-submit" @tap="submitNote"><text>提交</text></view>
        </view>

        <view v-else-if="sheet == 'assign' && selected != null" class="panel-body">
          <view class="assign-head">
            <text class="assign-cancel" @tap="closeSheet">取消</text>
            <text class="assign-title">修改红娘</text>
            <view class="assign-confirm" @tap="submitAssign"><text>确认</text></view>
          </view>
          <view v-if="assignLoading" class="state-inline"><text>正在加载红娘名单…</text></view>
          <view v-for="option in assignOptions" :key="option.user_id" class="assign-row" :class="{ disabled: option.user_id == (selected.matchmaker_id || 0), picked: assignTarget == option.user_id }" @tap="pickAssign(option)">
            <text>{{ option.display_name }}</text>
            <text v-if="option.user_id == (selected.matchmaker_id || 0)" class="assign-current">当前</text>
          </view>
        </view>

        <view v-else-if="sheet == 'abandonReason' && selected != null" class="panel-body">
          <textarea class="panel-textarea" maxlength="100" placeholder="请输入" :value="abandonReason" @input="onAbandonReason" />
          <text class="panel-counter">已输入 {{ abandonReason.length }}/100字</text>
          <view class="panel-submit" @tap="submitAbandon"><text>确定提交</text></view>
        </view>

        <view v-else-if="sheet == 'contact' && selected != null" class="panel-body">
          <text class="panel-copy">本次查看已记录到服务审计日志。</text>
          <text class="contact-value">{{ contactPhone || '该会员未绑定手机号' }}</text>
        </view>

        <view v-else-if="sheet == 'followups' && selected != null" class="panel-body">
          <view v-for="item in followUps" :key="item.id" class="fu-row">
            <text class="fu-method">{{ followMethodLabel(item.method) }}</text>
            <text class="fu-content">{{ item.content }}</text>
            <text class="fu-time">{{ formatTime(item.created_at) }}</text>
          </view>
          <view v-if="followUps.length == 0" class="state-inline"><text>暂无服务跟进</text></view>
          <textarea class="panel-textarea" maxlength="2000" placeholder="记录本次服务跟进" :value="followContent" @input="onFollowContent" />
          <view class="panel-submit" @tap="submitFollowUp"><text>新增跟进</text></view>
        </view>
      </view>
    </view>

    <!-- 放入弃海确认弹窗 -->
    <view v-if="modal == 'abandon' && selected != null" class="modal-mask" @tap="closeModal">
      <view class="modal-card" @tap.stop>
        <text class="modal-copy">放入弃海后该客源的红娘分派将被改为"待分派"，并生成弃海记录，所有红娘可以在"弃海客源"中进行捞取。</text>
        <view class="modal-actions">
          <view class="modal-btn" @tap="closeModal"><text>取消</text></view>
          <view class="modal-btn strong" @tap="confirmAbandon"><text>确定</text></view>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
import {
  assignMatchmakerMemberMatchmaker,
  createMatchmakerWorkspaceMember,
  createMatchmakerMemberFollowUp,
  getMatchmakerMemberContact,
  getMatchmakerMemberFollowUps,
  getMatchmakerMemberMatchCandidates,
  getMatchmakerMemberMatchHistory,
  getMatchmakerMemberMatchmakers,
  getMatchmakerMemberNote,
  getMatchmakerReviewMembers,
  getMatchmakerWorkspaceProfile,
  updateMatchmakerMemberNote,
  updateMatchmakerReviewMember
} from '@/api'

interface Props {
  snapshot: any;
  initialTab?: string;
}
const props = defineProps<Props>()

const tabs = [
  { key: '', label: '全部' },
  { key: 'PENDING', label: '待审' },
  { key: 'mine', label: '我的' },
  { key: 'REJECTED', label: '弃海' },
  { key: 'vip_online', label: '线上VIP' },
  { key: 'vip_offline', label: '线下VIP' }
]

const activeTab = ref(props.initialTab == 'mine' ? 'mine' : (props.initialTab == '' ? '' : 'PENDING'))
const keyword = ref('')
const loading = ref(false)
const errorMessage = ref('')
const members = ref<any[]>([])
const rawMembers = ref<any[]>([])
const selfUserId = ref(0)

const filterVisible = ref(false)
const expandedFilterKey = ref('')
const createMemberFilter = (): any => ({
  hometown: '', residence: '', gender: '', ageRange: '', heightRange: '', education: '', occupation: '', income: '',
  marital: '', housing: '', vehicle: '', smoking: '', drinking: '', certification: '', vipOnline: '', vipOffline: ''
})
const memberFilter = ref<any>(createMemberFilter())
const filterRows = [
  { key: 'hometown', label: '籍贯', options: [{ label: '不限', value: '' }, { label: '江苏', value: '江苏' }, { label: '浙江', value: '浙江' }, { label: '上海', value: '上海' }, { label: '北京', value: '北京' }, { label: '广东', value: '广东' }, { label: '其他', value: '其他' }] },
  { key: 'residence', label: '现居', options: [{ label: '不限', value: '' }, { label: '江苏', value: '江苏' }, { label: '浙江', value: '浙江' }, { label: '上海', value: '上海' }, { label: '北京', value: '北京' }, { label: '广东', value: '广东' }, { label: '其他', value: '其他' }] },
  { key: 'gender', label: '性别', options: [{ label: '不限', value: '' }, { label: '男', value: 'male' }, { label: '女', value: 'female' }] },
  { key: 'ageRange', label: '年龄', options: [{ label: '不限', value: '' }, { label: '20岁以下', value: 'under20' }, { label: '20-25岁', value: '20-25' }, { label: '26-30岁', value: '26-30' }, { label: '31-35岁', value: '31-35' }, { label: '36-40岁', value: '36-40' }, { label: '41岁以上', value: 'over40' }] },
  { key: 'heightRange', label: '身高', options: [{ label: '不限', value: '' }, { label: '160cm以下', value: 'under160' }, { label: '160-169cm', value: '160-169' }, { label: '170-179cm', value: '170-179' }, { label: '180cm及以上', value: 'over180' }] },
  { key: 'education', label: '学历', options: [{ label: '不限', value: '' }, { label: '高中及以下', value: 'highschool' }, { label: '大专', value: 'college' }, { label: '本科', value: 'bachelor' }, { label: '硕士及以上', value: 'master' }] },
  { key: 'occupation', label: '职业', options: [{ label: '不限', value: '' }, { label: '事业单位/国企', value: '事业单位' }, { label: '教师/医生', value: '教师' }, { label: 'IT/互联网', value: '互联网' }, { label: '金融/法律', value: '金融' }, { label: '自由职业', value: '自由职业' }, { label: '其他', value: '其他' }] },
  { key: 'income', label: '收入', options: [{ label: '不限', value: '' }, { label: '10万以下', value: '10万以下' }, { label: '10-20万', value: '10-20万' }, { label: '20-30万', value: '20-30万' }, { label: '30万以上', value: '30万以上' }] },
  { key: 'marital', label: '婚况', options: [{ label: '不限', value: '' }, { label: '未婚', value: '0' }, { label: '已婚', value: '1' }, { label: '离异', value: '2' }, { label: '丧偶', value: '3' }] },
  { key: 'housing', label: '购房', options: [{ label: '不限', value: '' }, { label: '已购房', value: '已购房' }, { label: '未购房', value: '未购房' }, { label: '购房中', value: '购房中' }] },
  { key: 'vehicle', label: '购车', options: [{ label: '不限', value: '' }, { label: '已购车', value: '已购车' }, { label: '未购车', value: '未购车' }, { label: '购车中', value: '购车中' }] },
  { key: 'smoking', label: '吸烟', options: [{ label: '不限', value: '' }, { label: '不吸烟', value: '不吸烟' }, { label: '偶尔吸烟', value: '偶尔吸烟' }, { label: '吸烟', value: '吸烟' }] },
  { key: 'drinking', label: '喝酒', options: [{ label: '不限', value: '' }, { label: '不喝酒', value: '不喝酒' }, { label: '偶尔喝酒', value: '偶尔喝酒' }, { label: '喝酒', value: '喝酒' }] },
  { key: 'certification', label: '认证', options: [{ label: '不限', value: '' }, { label: '已实名', value: 'verified' }, { label: '未实名', value: 'unverified' }] },
  { key: 'vipOnline', label: '线上VIP', options: [{ label: '不限', value: '' }, { label: '只看VIP', value: 'vip' }] },
  { key: 'vipOffline', label: '线下VIP', options: [{ label: '不限', value: '' }, { label: '只看VIP', value: 'vip' }] }
]

