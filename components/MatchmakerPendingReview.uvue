const notify = (message: string) => uni.showToast({ title: message, icon: 'none' })

const emptyText = computed(() => {
  if (activeTab.value == 'PENDING') return '暂无待审核的会员资料'
  if (activeTab.value == 'REJECTED') return '暂无弃海客源'
  if (activeTab.value == 'vip_online' || activeTab.value == 'vip_offline') return 'VIP 标签服务端暂未开放，敬请期待'
  return '当前没有符合条件的会员资料'
})

const sheetTitle = computed(() => {
  if (sheet.value == 'note') return '红娘说'
  if (sheet.value == 'abandonReason') return '放弃原因'
  if (sheet.value == 'contact') return '联系信息'
  if (sheet.value == 'followups') return '服务跟进'
  return ''
})

const visibleIntroductions = computed(() => {
  return (introductions.value as any[]).filter((row: any) => row.direction == introTab.value)
})

const preferenceChips = computed(() => {
  const chips: string[] = []
  const pref = preference.value
  if (pref != null && pref.age_min != null && pref.age_max != null) chips.push('年龄' + pref.age_min + '-' + pref.age_max)
  else chips.push('年龄不限')
  if (pref != null && pref.height_min != null && pref.height_max != null) chips.push('身高' + pref.height_min + '-' + pref.height_max)
  else chips.push('身高不限')
  if (pref != null && pref.income_min != null) chips.push('收入' + pref.income_min + '以上')
  else chips.push('收入不限')
  if (pref != null && pref.education_min != null) chips.push(educationLabel(Number(pref.education_min)))
  else chips.push('学历不限')
  return chips
})

/* ---------- 工具 ---------- */
const formatTime = (value: any): string => value == null ? '' : String(value).replace('T', ' ').substring(0, 19)
const avatarText = (name: any): string => {
  const text = name != null ? String(name).trim() : ''
  return text.length > 0 ? text.substring(0, 1) : '会'
}
const ageText = (birthday: any): string => {
  if (birthday == null) return ''
  const text = String(birthday)
  if (text.length < 4) return ''
  const birth = parseInt(text.substring(0, 4))
  if (isNaN(birth)) return ''
  return String(new Date().getFullYear() - birth) + '岁'
}
const marriedText = (value: any): string => {
  const status = value != null ? Number(value) : -1
  if (status == 0) return '未婚'
  if (status == 1) return '已婚'
  if (status == 2) return '离异'
  if (status == 3) return '丧偶'
  return '婚况未填'
}
const educationLabel = (code: number): string => {
  if (code == 1) return '博士及以上'
  if (code == 2) return '硕士及以上'
  if (code == 3) return '本科及以上'
  if (code == 4) return '大专及以上'
  if (code == 5) return '高中及以上'
  return '学历不限'
}
const memberMeta = (member: any): string => {
  const parts: string[] = []
  parts.push(marriedText(member.is_married))
  const age = ageText(member.birthday)
  if (age.length > 0) parts.push(age)
  if (member.education != null && String(member.education).length > 0) parts.push(String(member.education))
  else if (member.job != null && String(member.job).length > 0) parts.push(String(member.job))
  if (member.height != null) parts.push(String(member.height) + 'cm')
  return parts.join(' · ')
}
const reviewLabel = (status: string): string => status == 'PASSED' ? '已通过' : (status == 'REJECTED' ? '已弃海' : '待审核')
const matchStatusLabel = (status: any): string => {
  const value = Number(status)
  if (value == 1) return '双方同意'
  if (value == 2) return '已拒绝'
  if (value == 3) return '已关闭'
  return '待回应'
}
const followMethodLabel = (method: string): string => method == 'PHONE' ? '电话' : (method == 'WECHAT' ? '微信' : (method == 'VISIT' ? '面谈' : '其他'))
const onKeyword = (event: any) => { keyword.value = event.detail.value }
const onNoteDraft = (event: any) => { noteDraft.value = event.detail.value }
const onAbandonReason = (event: any) => { abandonReason.value = event.detail.value }
const onFollowContent = (event: any) => { followContent.value = event.detail.value }
const onEntryInput = (key: string, event: any) => { entryDraft.value[key] = event.detail.value }
const onEntryBirthday = (event: any) => { entryDraft.value.birthday = event.detail.value }

const chooseEntryAvatar = () => {
  uni.chooseImage({
    count: 1,
    sizeType: ['compressed'],
    success: (result: any) => {
      if (result.tempFilePaths != null && result.tempFilePaths.length > 0) entryDraft.value.avatar = String(result.tempFilePaths[0])
    },
    fail: () => notify('头像选择已取消')
  })
}

const resetEntryDraft = () => {
  entryDraft.value = { avatar: '', codeMode: 'auto', memberCode: '', nickname: '', realName: '', gender: 1, phone: '', wechat: '', birthday: '1990-01-01', zodiac: '', hometown: '', household: '', residence: '', weight: '', height: '', education: '', maritalStatus: '', occupation: '', income: '', ethnicity: '', housing: '', vehicle: '', smoking: '', drinking: '', religion: '', marriagePlan: '', tags: '', status: 'PUBLIC' }
}

const submitEntry = async () => {
  if (entrySubmitting.value) return
  const draft = entryDraft.value
  if (String(draft.nickname).trim().length == 0) { notify('请填写昵称'); return }
  if (String(draft.realName).trim().length == 0) { notify('请填写姓名'); return }
  if (!/^1[3-9]\d{9}$/.test(String(draft.phone).trim())) { notify('请填写正确的手机号'); return }
  if (draft.codeMode == 'custom' && String(draft.memberCode).trim().length == 0) { notify('请填写自定义编号'); return }
  if (String(draft.height).trim().length > 0 && (isNaN(Number(draft.height)) || Number(draft.height) < 100 || Number(draft.height) > 250)) { notify('请填写正确的身高'); return }
  if (String(draft.weight).trim().length > 0 && (isNaN(Number(draft.weight)) || Number(draft.weight) < 40 || Number(draft.weight) > 120)) { notify('请填写正确的体重'); return }
  entrySubmitting.value = true
  try {
    const result = await createMatchmakerWorkspaceMember({
      codeMode: draft.codeMode, memberCode: String(draft.memberCode).trim(), nickname: String(draft.nickname).trim(), realName: String(draft.realName).trim(), gender: draft.gender,
      phone: String(draft.phone).trim(), wechat: String(draft.wechat).trim(), birthday: draft.birthday, zodiac: String(draft.zodiac).trim(), hometown: String(draft.hometown).trim(), household: String(draft.household).trim(), residence: String(draft.residence).trim(), weight: draft.weight == '' ? null : Number(draft.weight), height: draft.height == '' ? null : Number(draft.height), education: String(draft.education).trim(), maritalStatus: String(draft.maritalStatus).trim(), occupation: String(draft.occupation).trim(), income: String(draft.income).trim(), ethnicity: String(draft.ethnicity).trim(), housing: String(draft.housing).trim(), vehicle: String(draft.vehicle).trim(), smoking: String(draft.smoking).trim(), drinking: String(draft.drinking).trim(), religion: String(draft.religion).trim(), marriagePlan: String(draft.marriagePlan).trim(), tags: String(draft.tags).trim(), status: draft.status
    })
    if (!result.success) { notify(result.message || '会员录入暂未开放'); return }
    notify('会员资料已录入，等待审核')
    resetEntryDraft()
    subview.value = ''
    activeTab.value = 'PENDING'
    await loadMembers()
  } finally { entrySubmitting.value = false }
}

/* ---------- 列表加载 ---------- */
const loadMembers = async () => {
  loading.value = true
  errorMessage.value = ''
  try {
    const data: any = { page: 1, page_size: 100 }
    if (activeTab.value == 'PENDING' || activeTab.value == 'REJECTED') data['review_status'] = activeTab.value
    if (keyword.value.trim().length > 0) data['search'] = keyword.value.trim()
    const result = await getMatchmakerReviewMembers(data)
    if (!result.success || result.data == null) {
      rawMembers.value = []
      errorMessage.value = result.message || '资料数据加载失败'
      members.value = []
      return
    }
    const raw = Array.isArray(result.data.items) ? result.data.items : []
    rawMembers.value = raw
    applyMemberFilter()
  } catch (error) {
    rawMembers.value = []
    members.value = []
    errorMessage.value = '网络异常，请稍后重试'
  } finally {
    loading.value = false
  }
}

const filterValueText = (key: string): string => {
  const row = (filterRows as any[]).find((item: any) => item.key == key)
  if (row == null) return '不限'
  const option = (row.options as any[]).find((item: any) => item.value == memberFilter.value[key])
  return option != null ? String(option.label) : '不限'
}

const toggleMemberFilter = (key: string) => {
  expandedFilterKey.value = expandedFilterKey.value == key ? '' : key
}

const selectMemberFilter = (key: string, value: string) => {
  memberFilter.value[key] = value
  expandedFilterKey.value = ''
}

const closeMemberFilter = () => {
  filterVisible.value = false
  expandedFilterKey.value = ''
}

const hasMemberValue = (member: any, key: string): boolean => {
  return member != null && member[key] != null && String(member[key]).trim().length > 0
}

const textFilterMatches = (member: any, key: string, value: string): boolean => {
  if (value.length == 0 || !hasMemberValue(member, key)) return true
  const text = String(member[key])
  if (value == '其他') return text.indexOf('江苏') < 0 && text.indexOf('浙江') < 0 && text.indexOf('上海') < 0 && text.indexOf('北京') < 0 && text.indexOf('广东') < 0
  return text.indexOf(value) >= 0
}

const ageOfMember = (member: any): number => {
  if (!hasMemberValue(member, 'birthday')) return -1
  const year = parseInt(String(member.birthday).substring(0, 4))
  return isNaN(year) ? -1 : new Date().getFullYear() - year
}

const rangeMatches = (numberValue: number, range: string, kind: string): boolean => {
  if (range.length == 0 || numberValue < 0) return true
  if (kind == 'age') {
    if (range == 'under20') return numberValue < 20
    if (range == '20-25') return numberValue >= 20 && numberValue <= 25
    if (range == '26-30') return numberValue >= 26 && numberValue <= 30
    if (range == '31-35') return numberValue >= 31 && numberValue <= 35
    if (range == '36-40') return numberValue >= 36 && numberValue <= 40
    return numberValue > 40
  }
  if (range == 'under160') return numberValue < 160
  if (range == '160-169') return numberValue >= 160 && numberValue <= 169
  if (range == '170-179') return numberValue >= 170 && numberValue <= 179
  return numberValue >= 180
}

const educationFilterMatches = (member: any, value: string): boolean => {
  if (value.length == 0 || !hasMemberValue(member, 'education')) return true
  const education = String(member.education)
  if (value == 'highschool') return education.indexOf('高中') >= 0 || education == '5'
  if (value == 'college') return education.indexOf('大专') >= 0 || education == '4'
  if (value == 'bachelor') return education.indexOf('本科') >= 0 || education == '3'
  return education.indexOf('硕') >= 0 || education.indexOf('博') >= 0 || education == '1' || education == '2'
}

const occupationFilterMatches = (member: any, value: string): boolean => {
  if (value.length == 0 || !hasMemberValue(member, 'job')) return true
  const job = String(member.job)
  if (value == '教师') return job.indexOf('教师') >= 0 || job.indexOf('医生') >= 0
  if (value == '金融') return job.indexOf('金融') >= 0 || job.indexOf('法律') >= 0
  if (value == '互联网') return job.indexOf('互联网') >= 0 || job.indexOf('IT') >= 0
  return textFilterMatches(member, 'job', value)
}

const vipFilterMatches = (member: any, keys: string[], value: string): boolean => {
  if (value.length == 0) return true
  let available = false
  for (let i = 0; i < keys.length; i++) {
    const key = keys[i]
    if (hasMemberValue(member, key)) {
      available = true
      const raw = member[key]
      if (raw === true || raw == 1 || String(raw).toUpperCase() == 'VIP' || String(raw).toLowerCase() == 'true') return true
    }
  }
  return !available
}

const isFilterAvailable = (key: string): boolean => {
  const fields: any = {
    hometown: ['hometown'], residence: ['residence'], gender: ['gender'], ageRange: ['birthday'], heightRange: ['height'], education: ['education'], occupation: ['job'], income: ['income'], marital: ['is_married'], housing: ['housing'], vehicle: ['vehicle'], smoking: ['smoking'], drinking: ['drinking'], certification: ['realname_status'], vipOnline: ['vip_online', 'online_vip', 'vipOnline'], vipOffline: ['vip_offline', 'offline_vip', 'vipOffline']
  }
  const keys = fields[key] as string[]
  if (keys == null) return false
  return (rawMembers.value as any[]).some((member: any) => keys.some((field: string) => hasMemberValue(member, field)))
}

const unavailableFilterCount = (): number => {
  let count = 0
  const keys = Object.keys(memberFilter.value)
  for (let i = 0; i < keys.length; i++) {
    if (String(memberFilter.value[keys[i]]).length > 0 && !isFilterAvailable(keys[i])) count++
  }
  return count
}

const applyMemberFilter = () => {
  const selectedFilter = memberFilter.value
  let list = rawMembers.value as any[]
  if (activeTab.value == 'mine') list = list.filter((item: any) => Number(item.matchmaker_id) == selfUserId.value)
  list = list.filter((member: any) => {
    if (selectedFilter.gender == 'male' && Number(member.gender) != 1) return false
    if (selectedFilter.gender == 'female' && Number(member.gender) != 2) return false
    if (!rangeMatches(ageOfMember(member), selectedFilter.ageRange, 'age')) return false
    const height = hasMemberValue(member, 'height') ? Number(member.height) : -1
    if (!rangeMatches(isNaN(height) ? -1 : height, selectedFilter.heightRange, 'height')) return false
    if (!textFilterMatches(member, 'hometown', selectedFilter.hometown)) return false
    if (!textFilterMatches(member, 'residence', selectedFilter.residence)) return false
    if (!educationFilterMatches(member, selectedFilter.education)) return false
    if (!occupationFilterMatches(member, selectedFilter.occupation)) return false
    if (!textFilterMatches(member, 'income', selectedFilter.income)) return false
    if (selectedFilter.marital.length > 0 && hasMemberValue(member, 'is_married') && String(member.is_married) != selectedFilter.marital) return false
    if (!textFilterMatches(member, 'housing', selectedFilter.housing)) return false
    if (!textFilterMatches(member, 'vehicle', selectedFilter.vehicle)) return false
    if (!textFilterMatches(member, 'smoking', selectedFilter.smoking)) return false
    if (!textFilterMatches(member, 'drinking', selectedFilter.drinking)) return false
    if (selectedFilter.certification == 'verified' && Number(member.realname_status) != 2) return false
    if (selectedFilter.certification == 'unverified' && Number(member.realname_status) == 2) return false
    if (!vipFilterMatches(member, ['vip_online', 'online_vip', 'vipOnline'], selectedFilter.vipOnline)) return false
    if (!vipFilterMatches(member, ['vip_offline', 'offline_vip', 'vipOffline'], selectedFilter.vipOffline)) return false
    return true
  })
  members.value = list
}

const resetMemberFilter = () => {
  memberFilter.value = createMemberFilter()
  expandedFilterKey.value = ''
  applyMemberFilter()
}

const confirmMemberFilter = () => {
  applyMemberFilter()
  const unavailableCount = unavailableFilterCount()
  closeMemberFilter()
  if (unavailableCount > 0) {
    notify('已筛选 ' + String(members.value.length) + ' 位会员，部分条件待数据源支持')
    return
  }
  notify('已按条件筛选 ' + String(members.value.length) + ' 位会员')
}

const selectTab = (key: string) => {
  activeTab.value = key
  if (key == 'vip_online' || key == 'vip_offline') {
    members.value = []
    return
  }
  loadMembers()
}

const loadSelfProfile = async () => {
  try {
    const result = await getMatchmakerWorkspaceProfile()
    if (result.success && result.data != null && result.data.user_id != null) {
      selfUserId.value = Number(result.data.user_id)
      if (activeTab.value == 'mine') applyMemberFilter()
    }
  } catch (e) {
  }
}

/* ---------- 更多菜单 ---------- */
const toggleMenu = (member: any, event: any) => {
  const id = Number(member.user_id)
  if (menuForId.value == id) {
    closeMenu()
    return
  }
  const windowInfo = uni.getSystemInfoSync()
  const menuWidth = 270 * windowInfo.windowWidth / 750
  const menuHeight = 5 * 84 * windowInfo.windowWidth / 750
  let tapX = 0
  let tapY = 0
  if (event != null && event.detail != null) {
    if (event.detail.x != null) tapX = Number(event.detail.x)
    if (event.detail.y != null) tapY = Number(event.detail.y)
  }
  if ((tapX <= 0 || tapY <= 0) && event != null && event.touches != null && event.touches.length > 0) {
    const touch = event.touches[0]
    if (tapX <= 0 && touch.clientX != null) tapX = Number(touch.clientX)
    if (tapY <= 0 && touch.clientY != null) tapY = Number(touch.clientY)
  }
  // tap 坐标以屏幕为准；保底值只在极少数旧端未提供坐标时使用。
  if (tapX <= 0) tapX = 56 * windowInfo.windowWidth / 375
  if (tapY <= 0) tapY = windowInfo.windowHeight / 2
  const maxLeft = Math.max(8, windowInfo.windowWidth - menuWidth - 8)
  menuLeft.value = Math.min(maxLeft, Math.max(8, tapX - 26))
  const maxTop = Math.max(8, windowInfo.windowHeight - menuHeight - 8)
  const aboveTop = tapY - menuHeight - 28
  menuTop.value = aboveTop >= 8 ? aboveTop : Math.min(maxTop, tapY + 28)
  menuForId.value = id
  if (!(member.introCount > 0)) loadIntroCount(member)
}
const closeMenu = () => { menuForId.value = 0 }

const loadIntroCount = async (member: any) => {
  const result = await getMatchmakerMemberMatchHistory(String(member.user_id))
  if (result.success && result.data != null) {
    member.introCount = result.data.total != null ? Number(result.data.total) : 0
  }
}

/* ---------- 子页：牵线记录 ---------- */
const openIntroductions = (member: any) => {
  closeMenu()
  selected.value = member
  subview.value = 'introductions'
  introTab.value = 'OUTGOING'
  introductions.value = []
  loadIntroductions(member)
}
const selectIntroTab = (tab: string) => { introTab.value = tab }
const loadIntroductions = async (member: any) => {
  introLoading.value = true
  const result = await getMatchmakerMemberMatchHistory(String(member.user_id))
  if (result.success && result.data != null) {
    introductions.value = Array.isArray(result.data.items) ? result.data.items : []
    member.introCount = result.data.total != null ? Number(result.data.total) : 0
  } else {
    notify(result.message || '牵线记录加载失败')
  }
  introLoading.value = false
}

/* ---------- 子页：匹配 ---------- */
const openMatch = (member: any) => {
  closeMenu()
  selected.value = member
  subview.value = 'match'
  candidates.value = []
  preference.value = null
  loadCandidates(member)
}
const loadCandidates = async (member: any) => {
  matchLoading.value = true
  const result = await getMatchmakerMemberMatchCandidates(String(member.user_id))
  if (result.success && result.data != null) {
    candidates.value = Array.isArray(result.data.items) ? result.data.items : []
    preference.value = result.data.preference != null ? result.data.preference : null
  } else {
    notify(result.message || '匹配候选加载失败')
  }
  matchLoading.value = false
}

const closeSubpage = () => {
  subview.value = ''
  selected.value = null
  introductions.value = []
  candidates.value = []
}

/* ---------- 红娘说 ---------- */
const openNote = (member: any) => {
  closeMenu()
  selected.value = member
  noteDraft.value = ''
  sheet.value = 'note'
  loadNote(member)
}
const loadNote = async (member: any) => {
  const result = await getMatchmakerMemberNote(String(member.user_id))
  if (result.success && result.data != null) noteDraft.value = result.data.note != null ? String(result.data.note) : ''
}
const submitNote = async () => {
  if (selected.value == null) return
  const text = noteDraft.value.trim()
  if (text.length == 0) {
    notify('请输入红娘说内容')
    return
  }
  if (text.length > 200) {
    notify('红娘说最多 200 字')
    return
  }
  const result = await updateMatchmakerMemberNote(String(selected.value.user_id), text)
  if (!result.success) {
    notify(result.message || '红娘说保存失败')
    return
  }
  notify('红娘说已保存')
  closeSheet()
}

/* ---------- 修改红娘 ---------- */
const openAssign = (member: any) => {
  closeMenu()
  selected.value = member
  assignOptions.value = []
  assignTarget.value = member.matchmaker_id != null ? Number(member.matchmaker_id) : 0
  sheet.value = 'assign'
  loadAssignOptions(member)
}
const loadAssignOptions = async (member: any) => {
  assignLoading.value = true
  const result = await getMatchmakerMemberMatchmakers(String(member.user_id))
  if (result.success && result.data != null) {
    assignOptions.value = Array.isArray(result.data) ? result.data : []
    if (assignTarget.value == 0 && assignOptions.value.length > 0) assignTarget.value = Number(assignOptions.value[0].user_id)
  } else {
    notify(result.message || '红娘名单加载失败')
  }
  assignLoading.value = false
}
const pickAssign = (option: any) => {
  if (selected.value != null && option.user_id == (selected.value.matchmaker_id || 0)) return
  assignTarget.value = Number(option.user_id)
}
const submitAssign = async () => {
  if (selected.value == null) return
  if (assignTarget.value == 0) {
    notify('请选择接手的服务红娘')
    return
  }
  if (assignTarget.value == (selected.value.matchmaker_id || 0)) {
    notify('该会员已由当前红娘跟进')
    return
  }
  const result = await assignMatchmakerMemberMatchmaker(String(selected.value.user_id), String(assignTarget.value))
  if (!result.success) {
    notify(result.message || '修改红娘失败')
    return
  }
  notify('跟进红娘已更新')
  closeSheet()
  loadMembers()
}

/* ---------- 放入弃海 ---------- */
const onAbandonEntry = (member: any) => {
  closeMenu()
  selected.value = member
  if (member.review_status == 'REJECTED') {
    notify('该会员已在弃海中')
    return
  }
  pendingAbandon.value = false
  abandonReason.value = ''
  modal.value = 'abandon'
}
const closeModal = () => { modal.value = '' }
const confirmAbandon = () => {
  modal.value = ''
  abandonReason.value = ''
  pendingAbandon.value = true
  sheet.value = 'abandonReason'
}
const submitAbandon = async () => {
  if (selected.value == null) return
  const reason = abandonReason.value.trim()
  if (reason.length == 0) {
    notify('请填写放弃原因')
    return
  }
  if (!pendingAbandon.value) {
    closeSheet()
    return
  }
  const result = await updateMatchmakerReviewMember(String(selected.value.user_id), { status: 'REJECTED', reason: reason })
  if (!result.success) {
    notify(result.message || '放入弃海失败')
    return
  }
  pendingAbandon.value = false
  notify('已放入弃海')
  closeSheet()
  loadMembers()
}

/* ---------- 联系 / 跟进（保留原真实接口） ---------- */
const openContact = async (member: any) => {
  closeMenu()
  selected.value = member
  contactPhone.value = ''
  sheet.value = 'contact'
  const result = await getMatchmakerMemberContact(String(member.user_id))
  if (result.success && result.data != null) contactPhone.value = result.data.phone != null ? String(result.data.phone) : ''
  else {
    notify(result.message || '联系信息加载失败')
    closeSheet()
  }
}
const openFollowUps = async (member: any) => {
  closeMenu()
  selected.value = member
  followContent.value = ''
  followUps.value = []
  sheet.value = 'followups'
  const result = await getMatchmakerMemberFollowUps(String(member.user_id))
  if (result.success && result.data != null) {
    followUps.value = Array.isArray(result.data.items) ? result.data.items : []
    member.followCount = result.data.total != null ? Number(result.data.total) : 0
  } else notify(result.message || '服务跟进加载失败')
}
const submitFollowUp = async () => {
  if (selected.value == null) return
  if (followContent.value.trim() == '') {
    notify('请填写跟进内容')
    return
  }
  const result = await createMatchmakerMemberFollowUp(String(selected.value.user_id), { method: 'OTHER', content: followContent.value.trim() })
  if (!result.success) {
    notify(result.message || '跟进提交失败')
    return
  }
  followContent.value = ''
  notify('服务跟进已保存')
  const reload = await getMatchmakerMemberFollowUps(String(selected.value.user_id))
  if (reload.success && reload.data != null) {
    followUps.value = Array.isArray(reload.data.items) ? reload.data.items : []
    selected.value.followCount = reload.data.total != null ? Number(reload.data.total) : 0
  }
}

/* ---------- 复制 / 编辑 / 悬浮球（按键逻辑保留） ---------- */
const copyProfile = (member: any) => {
  closeMenu()
  const lines: string[] = []
  lines.push('昵称：' + String(member.nickname || ''))
  lines.push('编号：G' + String(member.user_id))
  lines.push('性别：' + (member.gender == 1 ? '男' : (member.gender == 2 ? '女' : '未填写')))
  lines.push('基本资料：' + memberMeta(member))
  lines.push('现居：' + String(member.residence || '未填写'))
  lines.push('跟进服务：' + String(member.matchmaker_name || '待分派'))
  lines.push('登记：' + formatTime(member.created_at))
  uni.setClipboardData({
    data: lines.join('\n'),
    success: () => notify('资料已复制'),
    fail: () => notify('复制失败，请重试')
  })
}
const onEditProfile = (member: any) => {
  closeMenu()
  notify('会员资料编辑开放后可直接修改')
}
const onEnterMember = () => {
  closeMenu()
  resetEntryDraft()
  subview.value = 'entry'
}
const onFilter = () => {
  closeMenu()
  filterVisible.value = true
}

const closeSheet = () => {
  sheet.value = ''
  if (!pendingAbandon.value) selected.value = null
}

onMounted(() => {
  loadMembers()
  loadSelfProfile()
})
</script>

<style scoped>
.pr-shell { position: relative; flex: 1; min-height: 0; display: flex; flex-direction: column; background: var(--canvas); }
.pr-main { position: relative; flex: 1; min-height: 0; display: flex; flex-direction: column; }

