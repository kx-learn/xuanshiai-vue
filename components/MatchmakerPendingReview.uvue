.pr-search-ph { color: var(--muted); font-size: 23rpx; }
.pr-search-btn { width: 118rpx; height: 58rpx; border-radius: 999rpx; background: var(--accent2); color: var(--paper); display: flex; align-items: center; justify-content: center; font-size: 23rpx; font-weight: 800; }

/* list */
.pr-list { flex: 1; height: 0; padding: 14rpx 24rpx 260rpx; box-sizing: border-box; }
.state-card { margin-bottom: 18rpx; min-height: 170rpx; padding: 24rpx; border-radius: 20rpx; background: var(--surface); box-shadow: var(--shadow-sm); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 20rpx; color: var(--muted); font-size: 24rpx; text-align: center; }
.state-action { min-width: 160rpx; height: 60rpx; border-radius: 999rpx; background: var(--accent2); color: var(--paper); display: flex; align-items: center; justify-content: center; font-size: 22rpx; font-weight: 800; }
.state-inline { padding: 14rpx 0; color: var(--muted); font-size: 21rpx; text-align: center; }

/* member card */
.mcard { position: relative; margin-bottom: 20rpx; padding: 22rpx 22rpx 18rpx; border-radius: 20rpx; background: var(--surface); box-shadow: var(--shadow-sm); }
.mcard-top { display: flex; flex-direction: row; align-items: center; gap: 12rpx; }
.mcard-ark { display: flex; flex-direction: row; align-items: center; gap: 6rpx; padding: 6rpx 12rpx; border-radius: 8rpx; background: var(--review-orange-soft); }
.mcard-ark text { color: var(--review-orange); font-size: 18rpx; font-weight: 800; }
.mcard-ark-glyph { font-size: 16rpx !important; }
.mcard-no { flex: 1; min-width: 0; color: var(--muted); font-size: 19rpx; }
.mcard-status { display: flex; flex-direction: row; align-items: center; gap: 6rpx; padding: 7rpx 12rpx; border-radius: 8rpx; background: var(--review-orange-soft); }
.mcard-status text { color: var(--review-orange); font-size: 19rpx; font-weight: 800; }
.mcard-status-dot { font-size: 12rpx !important; }
.mcard-status.st-passed { background: var(--sage-soft); }
.mcard-status.st-passed text { color: var(--sage); }
.mcard-status.st-rejected { background: var(--match-blush); }
.mcard-status.st-rejected text { color: var(--match-coral); }

.mcard-body { margin-top: 18rpx; display: flex; flex-direction: row; gap: 18rpx; }
.mcard-ava { position: relative; width: 96rpx; height: 96rpx; border-radius: 50%; overflow: hidden; background: var(--accent-bg); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.mcard-ava image { width: 96rpx; height: 96rpx; border-radius: 50%; }
.mcard-ava text { color: var(--accent2); font-size: 36rpx; font-weight: 800; }
.mcard-ava.female { background: var(--match-blush); }
.mcard-ava.female text { color: var(--match-coral); }
.mcard-ava-badge { position: absolute; left: 2rpx; bottom: 2rpx; width: 30rpx; height: 30rpx; border-radius: 50%; background: var(--accent2); display: flex; align-items: center; justify-content: center; }
.mcard-ava-badge text { color: var(--paper); font-size: 16rpx; }
