/* search */
.pr-search { flex-shrink: 0; margin: 20rpx 24rpx 4rpx; height: 72rpx; padding: 0 8rpx 0 22rpx; border-radius: 999rpx; background: var(--surface); box-shadow: var(--shadow-sm); display: flex; flex-direction: row; align-items: center; gap: 12rpx; }
.pr-search-icon { color: var(--muted); font-size: 30rpx; font-weight: 800; }
