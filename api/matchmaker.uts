  if (source.phone != null) data.phone = String(source.phone)
  if (source.wechat != null) data.wechat = String(source.wechat)
  if (source.intentionLevel != null) data.intention_level = Number(source.intentionLevel)
  if (source.intentionValue != null) data.intention_value = Number(source.intentionValue)
  if (source.status != null) data.status = String(source.status)
  if (source.remark != null) data.remark = String(source.remark)
  return request({ url: '/matchmaker/workbench/leads/' + encodeURIComponent(leadId), method: 'PATCH', data: data })
}

