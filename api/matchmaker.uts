      wechat: source.wechat != null && String(source.wechat).trim() != '' ? String(source.wechat).trim() : null,
      source: source.source != null && String(source.source).trim() != '' ? String(source.source).trim() : '手动录入',
      intention_level: source.intentionLevel != null ? Number(source.intentionLevel) : 1,
      intention_value: source.intentionValue != null ? Number(source.intentionValue) : 1,
      remark: source.remark != null && String(source.remark).trim() != '' ? String(source.remark).trim() : null
    }
  })
}

function normalizeWorkspaceIntroductionStatus(value: any): string {
  const status = value != null ? String(value) : ''
  return status == 'PENDING' || status == 'IN_PROGRESS' || status == 'SUCCEEDED' || status == 'FAILED' ? status : 'PENDING'
}

function normalizeWorkspaceIntroductionPerson(value: any) {
  const source = value != null ? value : {}
  return {
    id: source.user_id != null ? String(source.user_id) : '',
    name: source.nickname != null && String(source.nickname).length > 0 ? String(source.nickname) : '未命名会员',
    avatar: source.avatar != null ? String(source.avatar) : '',
    gender: Number(source.gender) == 1 ? '男' : (Number(source.gender) == 2 ? '女' : '未填写')
  }
}

/** 查询当前服务红娘工作范围内的四态牵线记录；不返回双方联系方式。 */
export async function getMatchmakerWorkspaceIntroductions() {
  const result = await request({
    url: '/matchmaker/workbench/introductions',
    method: 'GET',
    data: { page: 1, page_size: 100 },
    mockData: USE_MOCK ? { items: mockMatchmakerWorkspaceIntroductions, total: mockMatchmakerWorkspaceIntroductions.length } : null
  })
  const serverItems = result.success && result.data != null && Array.isArray(result.data.items) ? result.data.items : []
  const useDemoFallback = canUseWorkspaceDemoFallback && (!result.success || result.data == null || serverItems.length == 0)
  if (!result.success && !useDemoFallback) return result
  const source = useDemoFallback ? { items: mockMatchmakerWorkspaceIntroductions, total: mockMatchmakerWorkspaceIntroductions.length } : result.data
  if (source == null) return result
  const items = Array.isArray(source.items) ? source.items : []
  return {
    success: true,
    data: {
      items: items.map((item: any) => ({
        id: item.id != null ? String(item.id) : '',
        status: normalizeWorkspaceIntroductionStatus(item.status),
        failureReason: item.failure_reason != null ? String(item.failure_reason) : '',
        note: item.note != null ? String(item.note) : '',
        createdAt: formatWorkspaceTime(item.created_at),
        updatedAt: formatWorkspaceTime(item.updated_at),
        fromUser: normalizeWorkspaceIntroductionPerson(item.from_user),
        toUser: normalizeWorkspaceIntroductionPerson(item.to_user)
      })),
      total: source.total != null ? Number(source.total) : items.length,
      isDemo: useDemoFallback
    },
    code: useDemoFallback ? 0 : result.code,
    message: useDemoFallback ? '本地测试数据' : result.message
  }
}

function normalizeWorkspaceMeetingRecord(value: any) {
  if (value == null) return null
  const status = value.status != null ? String(value.status) : ''
  const validStatus = status == 'SCHEDULED' || status == 'REMINDED' || status == 'CHECKED_IN' || status == 'COMPLETED' || status == 'CANCELLED' || status == 'NO_SHOW'
  if (!validStatus) return null
  return {
    id: value.id != null ? String(value.id) : '',
    status: status,
    scheduledAt: formatWorkspaceTime(value.scheduled_at),
    location: value.location != null ? String(value.location) : '',
    cancelReason: value.cancel_reason != null ? String(value.cancel_reason) : ''
  }
}

/** 查询当前服务红娘工作范围内的约见申请及最新约见安排；不返回双方联系方式。 */
export async function getMatchmakerWorkspaceMeetingRequests() {
  const result = await request({
    url: '/matchmaker/workbench/meeting-requests',
    method: 'GET',
    data: { page: 1, page_size: 100 },
    mockData: USE_MOCK ? { items: mockMatchmakerWorkspaceMeetingRequests, total: mockMatchmakerWorkspaceMeetingRequests.length } : null
  })
  const serverItems = result.success && result.data != null && Array.isArray(result.data.items) ? result.data.items : []
  const useDemoFallback = canUseWorkspaceDemoFallback && (!result.success || result.data == null || serverItems.length == 0)
  if (!result.success && !useDemoFallback) return result
  const source = useDemoFallback ? { items: mockMatchmakerWorkspaceMeetingRequests, total: mockMatchmakerWorkspaceMeetingRequests.length } : result.data
  if (source == null) return result
  const items = Array.isArray(source.items) ? source.items : []
  return {
    success: true,
    data: {
      items: items.map((item: any) => ({
        id: item.id != null ? String(item.id) : '',
        status: item.status != null ? String(item.status) : 'SUBMITTED',
        note: item.note != null ? String(item.note) : '',
        createdAt: formatWorkspaceTime(item.created_at),
        updatedAt: formatWorkspaceTime(item.updated_at),
        applicant: normalizeWorkspaceIntroductionPerson(item.applicant),
        target: normalizeWorkspaceIntroductionPerson(item.target),
        meeting: normalizeWorkspaceMeetingRecord(item.meeting)
      })),
      total: source.total != null ? Number(source.total) : items.length,
      isDemo: useDemoFallback
    },
    code: useDemoFallback ? 0 : result.code,
    message: useDemoFallback ? '本地测试数据' : result.message
  }
}

