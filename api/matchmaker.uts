function normalizePromoterCenterSnapshot(data: any) {
  const source = data != null ? data : {}
  const profile = source.profile != null ? source.profile : {}
  const toMember = (item: any) => ({ id: item.user_id, memberCode: item.member_code != null ? String(item.member_code) : (item.memberCode != null ? String(item.memberCode) : ''), name: item.nickname || '', gender: item.gender == 1 ? '男' : (item.gender == 2 ? '女' : ''), registerAt: formatWorkspaceTime(item.register_at), reviewStatus: item.review_status || 'PENDING', avatar: item.avatar != null ? item.avatar : (item.avatar_url != null ? item.avatar_url : '') })
  const toLead = (item: any) => { const statusMap: any = { NEW: '待审核', CONTACTED: '待审核', INTENDED: '有效', CONVERTED: '有效', LOST: '无效', CLOSED: '无效' }; const rawStatus = item.status != null ? String(item.status) : '待审核'; return { id: item.id, name: item.name || '', nickname: item.name || '', realName: item.name || '', phone: item.phone || '', wechat: item.wechat || '', source: item.source || '', status: statusMap[rawStatus] != null ? statusMap[rawStatus] : rawStatus, createdAt: formatWorkspaceTime(item.created_at) } }
  return { profile: { nickname: profile.nickname || '', promotionCode: profile.promotion_code || '', teamName: profile.team_name != null ? String(profile.team_name) : (profile.teamName != null ? String(profile.teamName) : ''), phone: profile.phone != null ? String(profile.phone) : '', wechatBound: profile.wechat_bound == true || profile.wechatBound == true, registerAt: formatWorkspaceTime(profile.register_at != null ? profile.register_at : profile.registerAt), balance: null, points: null, level: '推广红娘' }, teamOptions: (Array.isArray(source.team_options) ? source.team_options : (Array.isArray(source.teamOptions) ? source.teamOptions : [])).map((team: any) => ({ id: team.id != null ? String(team.id) : '', name: team.name != null ? String(team.name) : '' })), leads: (Array.isArray(source.leads) ? source.leads : []).map(toLead), effectiveMembers: (Array.isArray(source.effective_members) ? source.effective_members : []).map(toMember), incompleteMembers: (Array.isArray(source.incomplete_members) ? source.incomplete_members : []).map(toMember), rewards: (Array.isArray(source.rewards) ? source.rewards : []).map((item: any) => ({ id: item.id != null ? String(item.id) : '', memberName: item.member_name != null ? String(item.member_name) : (item.memberName || ''), memberId: item.member_id != null ? String(item.member_id) : (item.memberId || ''), gender: item.gender == 1 ? '男' : (item.gender == 2 ? '女' : (item.gender || '')), amount: readAmount(item.amount), createdAt: formatWorkspaceTime(item.created_at != null ? item.created_at : item.createdAt), avatar: item.avatar != null ? item.avatar : (item.avatar_url != null ? item.avatar_url : '') })), commissions: (Array.isArray(source.commissions) ? source.commissions : (Array.isArray(source.commission_records) ? source.commission_records : (Array.isArray(source.commissionRecords) ? source.commissionRecords : []))).map((item: any) => ({ id: item.id != null ? String(item.id) : '', itemName: item.item_name != null ? String(item.item_name) : (item.itemName || ''), memberName: item.member_name != null ? String(item.member_name) : (item.memberName || ''), amount: readAmount(item.amount), createdAt: formatWorkspaceTime(item.created_at != null ? item.created_at : item.createdAt) })), withdrawals: [] as any[], offlineOrders: (Array.isArray(source.offline_orders) ? source.offline_orders : (Array.isArray(source.offlineOrders) ? source.offlineOrders : [])).map((item: any) => ({ id: item.id != null ? String(item.id) : '', customer: item.customer != null ? String(item.customer) : (item.customer_name != null ? String(item.customer_name) : (item.name || '')), amount: readAmount(item.amount), status: item.status != null ? String(item.status) : '已结算', createdAt: formatWorkspaceTime(item.created_at != null ? item.created_at : item.createdAt) })), financeAvailable: source.finance_available == true }
}

