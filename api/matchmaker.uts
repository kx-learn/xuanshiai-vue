/** 查询红娘工作范围内会员公开资料审核队列（支持 review_status/search 分页参数）。 */
export async function getMatchmakerReviewMembers(data: any | null = null) {
  const query = data != null ? data : { page: 1, page_size: 100 }
  return request({ url: '/matchmaker/workbench/members', method: 'GET', data: query })
}

/** 红娘后台录入会员；服务端创建基础账号后，再补齐可写的公开资料字段。 */
export async function createMatchmakerWorkspaceMember(data: any) {
  const source = data != null ? data : {}
  const maritalText = source.maritalStatus != null ? String(source.maritalStatus) : ''
  const isMarried = maritalText == '已婚' ? 1 : (maritalText == '离异' || maritalText == '离婚' ? 2 : (maritalText == '丧偶' ? 3 : null))
  const remarkParts: string[] = []
  if (source.realName != null && String(source.realName).trim() != '') remarkParts.push('姓名：' + String(source.realName).trim())
  if (source.codeMode == 'custom' && source.memberCode != null && String(source.memberCode).trim() != '') remarkParts.push('录入编号：' + String(source.memberCode).trim())
  if (source.religion != null && String(source.religion).trim() != '') remarkParts.push('宗教：' + String(source.religion).trim())
  if (source.drinking != null && String(source.drinking).trim() != '') remarkParts.push('饮酒：' + String(source.drinking).trim())
  if (source.marriagePlan != null && String(source.marriagePlan).trim() != '') remarkParts.push('结婚计划：' + String(source.marriagePlan).trim())
  if (source.income != null && String(source.income).trim() != '') remarkParts.push('收入：' + String(source.income).trim())
  if (source.status != null) remarkParts.push('相亲状态：' + (String(source.status) == 'PAUSED' ? '暂停相亲' : '公开相亲'))
  const created = await request({
    url: '/admin/matchmaker/members', method: 'POST', data: {
      phone: String(source.phone || '').trim(), nickname: String(source.nickname || '').trim(), gender: Number(source.gender), birthday: source.birthday || null,
      is_married: isMarried, avatar: source.avatarUrl != null && String(source.avatarUrl).indexOf('http') == 0 ? String(source.avatarUrl) : null,
      remark: remarkParts.join('\n')
    }
  })
  if (!created.success || created.data == null || created.data.id == null) return created
  const memberId = String(created.data.id)
  const patchData: any = {
    nickname: String(source.nickname || '').trim(), gender: Number(source.gender), birthday: source.birthday || null, is_married: isMarried,
    height: source.height, weight: source.weight, zodiac: String(source.zodiac || '').trim(), household: String(source.household || '').trim(), ethnicity: String(source.ethnicity || '').trim(),
    house: String(source.housing || '').trim(), car: String(source.vehicle || '').trim(), smoking: String(source.smoking || '').trim(), hometown: String(source.hometown || '').trim(), residence: String(source.residence || '').trim(),
    education: String(source.education || '').trim(), job: String(source.occupation || '').trim(), wechat: String(source.wechat || '').trim(), remark: remarkParts.join('\n')
  }
  const tagText = source.tags != null ? String(source.tags).trim() : ''
  if (tagText != '') patchData.tags = [tagText]
  if (source.avatarUrl != null && String(source.avatarUrl).indexOf('http') == 0) patchData.avatar = String(source.avatarUrl)
  return request({ url: '/admin/matchmaker/members/' + encodeURIComponent(memberId), method: 'PATCH', data: patchData })
}

