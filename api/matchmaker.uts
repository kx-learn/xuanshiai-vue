/**
 * 牵线/红娘相关 API
 * 包含：服务红娘、热心红娘、AI 红娘、私人定制
 */

import { request } from './request.uts'
import { API_BASE_URL, USE_MOCK } from './config.uts'
import {
  mockMatchmakerManagementCenterAccess,
  mockMatchmakerManagementCenterSnapshot,
  mockPartnerCenterSnapshot,
  mockMatchmakerWorkspaceIntroductions,
  mockMatchmakerWorkspaceMeetingRequests
} from '@/mock/matchmaker.uts'

// 仅本机联调可在服务端尚未写入工作台记录时展示脱敏测试明细；部署环境始终只用服务端数据。
const canUseWorkspaceDemoFallback = !USE_MOCK && API_BASE_URL.indexOf('127.0.0.1') >= 0

function toMatchmakerCard(item: any) {
  const successCount = item.success_count != null ? Number(item.success_count) : 0
  const cases: any[] = []
  if (item.cases != null) {
    const source = item.cases as any[]
    for (let i = 0; i < source.length; i++) {
      const entry = source[i]
      const description = entry.description != null ? String(entry.description).trim() : ''
      if (description.length == 0) continue
      const images: string[] = []
      if (entry.images != null) {
        const sourceImages = entry.images as any[]
        for (let j = 0; j < sourceImages.length; j++) {
          const image = String(sourceImages[j]).trim()
          if (image.length > 0) images.push(image)
        }
      }
      cases.push({
        _id: 'service-case-' + String(item.user_id) + '-' + String(i),
        image: images.length > 0 ? images[0] : '',
        images: images,
        story: description,
        copy: description,
        feedback: entry.feedback != null ? String(entry.feedback).trim() : '',
        matchmakerComment: '',
        tags: []
      })
    }
  }
  return {
    id: item.user_id != null ? Number(item.user_id) : Number(item.id),
    name: item.nickname != null && String(item.nickname).length > 0 ? String(item.nickname) : '服务红娘',
    avatar: item.avatar != null ? String(item.avatar) : '',
    city: '',
    title: '平台认证服务红娘',
    introduction: item.intro != null ? String(item.intro) : '',
    description: item.intro != null ? String(item.intro) : '',
    serviceCount: successCount,
    successCount,
    successRate: 0,
    tags: item.certification_tags != null ? item.certification_tags : [],
    badge: '平台认证',
    price: null,
    priceUnit: '',
    status: item.is_available === true ? 'online' : 'busy',
    certification: item.certification_tags != null && item.certification_tags.length > 0,
    isOnline: item.is_available === true,
    cases: cases,
    caseRecord: successCount > 0 ? '累计促成 ' + successCount + ' 次有效牵线。' : ''
  }
}

function cleanPlanText(value: any, fallback: string): string {
  const text = value != null ? String(value).trim() : ''
  if (text.length == 0 || text.indexOf('?') >= 0) {
    return fallback
  }
  return text
}

/**
 * 将服务端管理中心访问状态收敛为页面使用的字段。
 * 准入只依赖服务红娘申请审核和有效角色；本期不使用支付作为门槛。
 */
function normalizeMatchmakerManagementCenterAccess(data: any) {
  const source = data != null ? data : {}
  const roleStatus = source.role_status != null ? String(source.role_status) : (source.roleStatus != null ? String(source.roleStatus) : '')
  const serverCanAccess = source.can_access != null
    ? source.can_access == true || String(source.can_access) == 'true'
    : (source.canAccess == true || String(source.canAccess) == 'true')
  return {
    roleStatus: roleStatus,
    paymentStatus: 'not_required',
    canAccess: serverCanAccess && roleStatus == 'active',
    scope: source.scope != null ? String(source.scope) : '',
    source: source.source != null ? String(source.source) : 'api',
    message: source.message != null ? String(source.message) : ''
  }
}

/** 获取总店红娘管理中心开通与权限状态。 */
export async function getMatchmakerManagementCenterAccess() {
  const result = await request({
    url: '/matchmaker/management-center/access',
    forceHttp: true,
    method: 'GET',
    mockData: USE_MOCK ? mockMatchmakerManagementCenterAccess : null
  })
  if (!result.success || result.data == null) return result
  return {
    success: true,
    data: normalizeMatchmakerManagementCenterAccess(result.data),
    code: result.code,
    message: result.message
  }
}

/**
 * 获取总店红娘工作台聚合快照。
 * 不返回手机号、微信号等敏感资料；明细和写操作须由各业务接口按 RBAC 单独控制。
 */
function normalizeMatchmakerManagementCenterSnapshot(data: any) {
  const source = data != null ? data : {}
  const identity = source.identity != null ? source.identity : {}
  const metrics = Array.isArray(source.store_metrics)
    ? source.store_metrics
    : (Array.isArray(source.storeMetrics) ? source.storeMetrics : [])
  return {
    identity: {
      greeting: identity.greeting != null ? String(identity.greeting) : '你好',
      name: identity.name != null ? String(identity.name) : '服务红娘',
      roleName: identity.role_name != null ? String(identity.role_name) : (identity.roleName != null ? String(identity.roleName) : '服务红娘')
    },
    storeMetrics: metrics.map((item: any) => ({
      key: item.key != null ? String(item.key) : '',
      label: item.label != null ? String(item.label) : '',
      value: item.value != null ? String(item.value) : '0',
      action: item.action != null ? String(item.action) : '',
      valuePrefix: item.value_prefix != null ? String(item.value_prefix) : (item.valuePrefix != null ? String(item.valuePrefix) : ''),
      badge: item.badge != null ? String(item.badge) : ''
    }))
  }
}

export async function getMatchmakerManagementCenterSnapshot() {
  const result = await request({
    url: '/matchmaker/management-center/dashboard',
    forceHttp: true,
    method: 'GET',
    mockData: USE_MOCK ? mockMatchmakerManagementCenterSnapshot : null
  })
  if (!result.success || result.data == null) return result
  return {
    success: true,
    data: normalizeMatchmakerManagementCenterSnapshot(result.data),
    code: result.code,
    message: result.message
  }
}

function formatWorkspaceTime(value: any): string {
  if (value == null) return ''
  return String(value).replace('T', ' ').substring(0, 19)
}

function normalizePartnerCenterSnapshot(data: any) {
  const source = data != null ? data : {}
  const profile = source.profile != null ? source.profile : {}
  const teamSource = Array.isArray(source.team_members) ? source.team_members : (Array.isArray(source.teamMembers) ? source.teamMembers : [])
  const memberSource = Array.isArray(source.effective_members) ? source.effective_members : (Array.isArray(source.effectiveMembers) ? source.effectiveMembers : [])
  const withdrawalSource = Array.isArray(source.withdrawal_records) ? source.withdrawal_records : (Array.isArray(source.withdrawalRecords) ? source.withdrawalRecords : [])
  const readAmount = (value: any): number | null => {
    if (value == null || String(value) == '') return null
    const amount = Number(value)
    return isNaN(amount) || amount < 0 ? null : amount
  }
  const withdrawableBalance = readAmount(source.withdrawable_balance != null ? source.withdrawable_balance : (source.withdrawableBalance != null ? source.withdrawableBalance : (source.balance != null ? source.balance : (profile.withdrawable_balance != null ? profile.withdrawable_balance : (profile.withdrawableBalance != null ? profile.withdrawableBalance : profile.balance)))))
  const teamPerformance = readAmount(source.team_performance != null ? source.team_performance : (source.teamPerformance != null ? source.teamPerformance : (profile.team_performance != null ? profile.team_performance : profile.teamPerformance)))
  const totalEarned = readAmount(source.total_earned != null ? source.total_earned : (source.totalEarned != null ? source.totalEarned : (profile.total_earned != null ? profile.total_earned : profile.totalEarned)))
  const memberGenderOf = (item: any): string => item.gender == 1 || item.gender == '男' ? '男' : (item.gender == 2 || item.gender == '女' ? '女' : '')
  const memberProfileByName: any = {}
  for (let i = 0; i < memberSource.length; i++) {
    const memberRow: any = memberSource[i]
    const rowName = memberRow.nickname != null ? String(memberRow.nickname) : String(memberRow.name || '')
    if (rowName != '') memberProfileByName[rowName] = memberRow
  }
  return {
    profile: {
      nickname: profile.nickname != null ? String(profile.nickname) : '',
      teamName: profile.team_name != null ? String(profile.team_name) : (profile.teamName != null ? String(profile.teamName) : ''),
      inviteCode: profile.invite_code != null ? String(profile.invite_code) : (profile.inviteCode != null ? String(profile.inviteCode) : (source.inviteCode != null ? String(source.inviteCode) : '')),
      level: profile.level != null ? String(profile.level) : '初级合伙',
      balance: withdrawableBalance,
      withdrawableBalance: withdrawableBalance,
      points: readAmount(profile.points),
      phone: profile.phone != null ? String(profile.phone) : '',
      wechatBound: profile.wechat_bound == true || profile.wechatBound == true,
      registerAt: formatWorkspaceTime(profile.register_at != null ? profile.register_at : profile.registerAt)
    },
    teamPerformance: teamPerformance,
    totalEarned: totalEarned,
    teamMembers: teamSource.map((item: any) => ({ id: item.user_id != null ? item.user_id : item.id, name: item.nickname != null ? item.nickname : (item.name || ''), joinedAt: formatWorkspaceTime(item.joined_at != null ? item.joined_at : item.joinedAt), performance: readAmount(item.performance != null ? item.performance : item.team_performance), effectiveCount: item.effective_count != null ? Number(item.effective_count) : (item.effectiveCount != null ? Number(item.effectiveCount) : null) })),
    effectiveMembers: memberSource.map((item: any) => ({ id: item.user_id != null ? item.user_id : item.id, name: item.nickname != null ? item.nickname : (item.name || ''), gender: item.gender == 1 || item.gender == '男' ? '男' : (item.gender == 2 || item.gender == '女' ? '女' : ''), registerAt: formatWorkspaceTime(item.register_at != null ? item.register_at : item.registerAt), promoterName: item.promoter_name != null ? item.promoter_name : (item.promoterName || ''), avatar: item.avatar != null ? item.avatar : (item.avatar_url || ''), reviewStatus: item.review_status != null ? String(item.review_status) : (item.reviewStatus || 'PASSED') })),
    registrationRewards: (Array.isArray(source.registration_rewards) ? source.registration_rewards : (Array.isArray(source.registrationRewards) ? source.registrationRewards : [])).map((item: any) => {
      const memberName = item.member_name != null ? String(item.member_name) : (item.memberName || '')
      const rewardMemberRow: any = memberProfileByName[memberName] != null ? memberProfileByName[memberName] : {}
      return { id: item.id != null ? String(item.id) : '', promoterName: item.promoter_name != null ? String(item.promoter_name) : (item.promoterName || ''), memberName: memberName, memberId: item.member_id != null ? String(item.member_id) : (item.memberId != null ? String(item.memberId) : (rewardMemberRow.user_id != null ? String(rewardMemberRow.user_id) : (rewardMemberRow.id != null ? String(rewardMemberRow.id) : ''))), gender: item.gender != null ? memberGenderOf(item) : memberGenderOf(rewardMemberRow), itemName: '会员注册奖励', amount: readAmount(item.amount), createdAt: formatWorkspaceTime(item.created_at != null ? item.created_at : item.createdAt), avatar: rewardMemberRow.avatar != null ? rewardMemberRow.avatar : (rewardMemberRow.avatar_url != null ? rewardMemberRow.avatar_url : '') }
    }),
    commissionRecords: (Array.isArray(source.commission_records) ? source.commission_records : (Array.isArray(source.commissionRecords) ? source.commissionRecords : [])).map((item: any) => {
      const memberName = item.member_name != null ? String(item.member_name) : (item.memberName || '')
      const memberRow: any = memberProfileByName[memberName] != null ? memberProfileByName[memberName] : {}
      const memberId = memberRow.user_id != null ? String(memberRow.user_id) : (memberRow.id != null ? String(memberRow.id) : (item.member_id != null ? String(item.member_id) : (item.memberId != null ? String(item.memberId) : '')))
      return { id: item.id != null ? String(item.id) : '', promoterName: item.promoter_name != null ? String(item.promoter_name) : (item.promoterName || ''), memberName: memberName, memberId: memberId, gender: item.gender != null ? memberGenderOf(item) : memberGenderOf(memberRow), itemName: item.item_name != null ? String(item.item_name) : (item.itemName || ''), amount: readAmount(item.amount), createdAt: formatWorkspaceTime(item.created_at != null ? item.created_at : item.createdAt), avatar: memberRow.avatar != null ? memberRow.avatar : (memberRow.avatar_url != null ? memberRow.avatar_url : '') }
    }),
    withdrawalRecords: withdrawalSource.map((item: any) => {
      const appliedAmount = readAmount(item.amount)
      const feeRaw = item.fee != null ? item.fee : (item.withdrawal_fee != null ? item.withdrawal_fee : (item.withdrawalFee != null ? item.withdrawalFee : null))
      const feeValue = readAmount(feeRaw)
      const fee = feeValue != null ? feeValue : (appliedAmount != null ? Math.round(appliedAmount) * 0.01 : 0)
      return { id: item.id != null ? String(item.id) : '', amount: appliedAmount, fee: fee, arrivedAmount: appliedAmount != null ? appliedAmount - fee : null, status: item.status != null ? String(item.status) : '处理中', createdAt: formatWorkspaceTime(item.created_at != null ? item.created_at : item.createdAt) }
    }),
    financeAvailable: source.finance_available == true
  }
}

/** 合伙人中心优先使用真实服务端数据；本机联调中无归属会员时回退到脱敏测试明细。 */
export async function getPartnerCenterSnapshot() {
  const result = await request({ url: '/matchmaker/partner-center', method: 'GET', mockData: USE_MOCK ? mockPartnerCenterSnapshot : null })
  const serverMembers = result.success && result.data != null && Array.isArray(result.data.effective_members)
    ? result.data.effective_members
    : (result.success && result.data != null && Array.isArray(result.data.effectiveMembers) ? result.data.effectiveMembers : [])
  const useDemoFallback = canUseWorkspaceDemoFallback && (!result.success || result.data == null || serverMembers.length == 0)
  if (!result.success && !useDemoFallback) return result
  const source = useDemoFallback ? mockPartnerCenterSnapshot : result.data
  if (source == null) return result
  return { success: true, data: normalizePartnerCenterSnapshot(source), code: result.code, message: result.message }
}

/** 创建或修改当前合伙人的唯一团队。 */
export async function updatePartnerTeamName(teamName: string) {
  const value = teamName.trim()
  if (value.length < 2 || value.length > 128) return { success: false, data: null, code: 400, message: '团队名称需为 2-128 个字符' }
  const result = await request({ url: '/matchmaker/partner-center/team', method: 'PUT', data: { name: value } })
  if (!result.success || result.data == null) return result
  return { success: true, data: normalizePartnerCenterSnapshot(result.data), code: result.code, message: result.message }
}

export async function createPartnerTeamInvite() {
  return request({ url: '/matchmaker/partner-center/invites', method: 'POST' })
}

