/**
 * 统一请求封装
 * - USE_MOCK=true：返回 mockData
 * - USE_MOCK=false：HTTP 调 FastAPI（Bearer）
 */

import {
  USE_MOCK,
  API_CONFIG,
  MOCK_DELAY,
  CURRENT_USER_ID_KEY,
  getAccessToken,
  clearAuthTokens,
  buildApiUrl
} from './config.uts'
import { debugLog } from '@/utils/debug-log.uts'

/**
 * 统一请求方法
 * options:
 *  - url: string 路径（/community/posts 或完整 http）
 *  - method: GET|POST|PUT|DELETE
 *  - data: query 或 body
 *  - mockData: Mock 模式返回值
 *  - headers: 额外请求头
 *  - skipAuth: 跳过 Authorization
 *  - raw: true 时不包 success 层（少用）
 */
export function getCurrentAccountKey(): string {
  return String(uni.getStorageSync(CURRENT_USER_ID_KEY)) + ':' + getAccessToken()
}

export async function request(options: any) {
  if (USE_MOCK) {
    return mockRequest(options)
  }
  return httpRequest(options)
}

/**
 * Mock 模式下若调用方没配 mockData，返回一个安全的空结构，
 * 避免页面拿到 null 后取属性崩溃（写操作给 success，读操作给空分页）。
 */
function buildMockFallback(method: string, url: string): any {
  if (method != 'GET') return { success: true }
  return { items: [], page: 1, page_size: 20, total: 0, has_more: false }
}

async function mockRequest(options: any) {
  debugLog('[Mock Request]', options.url)
  await sleep(MOCK_DELAY)
  const mockMethod = options.method != null ? ('' + options.method).toUpperCase() : 'GET'
  // 未配置 mockData 的接口：走兜底空结构而不是返回 null
  if (options.mockData == null) {
    debugLog('[Mock] 未配置 mockData，返回兜底空结构：', mockMethod, options.url)
    return {
      success: true,
      data: buildMockFallback(mockMethod, options.url != null ? '' + options.url : ''),
      code: 0,
      message: 'success(mock empty fallback)'
    }
  }
  // 允许 mock 侧直接给出失败包
  if (
    options.mockData != null &&
    typeof options.mockData === 'object' &&
    options.mockData.success === false
  ) {
    return {
      success: false,
      data: options.mockData,
      code: options.mockData.code != null ? options.mockData.code : -1,
      message: options.mockData.message != null ? options.mockData.message : 'error'
    }
  }
  return {
    success: true,
    data: options.mockData,
    code: 0,
    message: 'success'
  }
}

function extractDetail(data: any): string {
  if (data == null) return '请求失败'
  if (typeof data === 'string') return data
  if (data.detail != null) {
    if (typeof data.detail === 'string') return data.detail
    if (Array.isArray(data.detail) && data.detail.length > 0) {
      const first = data.detail[0]
      if (first != null && first.msg != null) return '' + first.msg
      return JSON.stringify(data.detail)
    }
  }
  if (data.message != null) return '' + data.message
  return '请求失败'
}

async function httpRequest(options: any) {
  // Bind completion to the account that sent the request, including late 401s.
  const account = getCurrentAccountKey()
  const requestToken = getAccessToken()
  const accountChanged = (): boolean => options.skipAuth != true && account != getCurrentAccountKey()
  const staleResponse = (): any => ({ success: false, data: null, code: 'ACCOUNT_CHANGED', message: '登录账号已切换，请刷新后重试' })
  const methodRaw = options.method != null ? ('' + options.method).toUpperCase() : 'GET'
  const method = methodRaw
  const urlPath = options.url != null ? ('' + options.url) : ''
  let url = buildApiUrl(urlPath)
  const headers: any = {
    'Content-Type': 'application/json'
  }
  if (options.headers != null) {
    const extra = options.headers
    const keys = Object.keys(extra)
    for (let i = 0; i < keys.length; i++) {
      headers[keys[i]] = extra[keys[i]]
    }
  }
  if (options.skipAuth != true) {
    const token = requestToken
    if (token != '') {
      headers['Authorization'] = 'Bearer ' + token
    }
  }

  let body: any = null
	const timeout = options.timeout != null ? Number(options.timeout) : API_CONFIG.timeout
  const data = options.data
  if (method == 'GET' || method == 'DELETE') {
    if (data != null && typeof data === 'object') {
      const parts: string[] = []
      const keys = Object.keys(data)
      for (let i = 0; i < keys.length; i++) {
        const k = keys[i]
        const v = data[k]
        if (v == null) continue
        if (Array.isArray(v)) {
          for (let j = 0; j < v.length; j++) {
            parts.push(encodeURIComponent(k) + '=' + encodeURIComponent('' + v[j]))
          }
        } else {
          parts.push(encodeURIComponent(k) + '=' + encodeURIComponent('' + v))
        }
      }
      if (parts.length > 0) {
        url = url + (url.indexOf('?') >= 0 ? '&' : '?') + parts.join('&')
      }
    }
  } else {
    body = data != null ? data : {}
  }

  debugLog('[HTTP Request]', method, url)

  return new Promise((resolve) => {
    uni.request({
      url: url,
      method: method as any,
      data: body,
      header: headers,
      timeout: timeout,
      success: (res: any) => {
        if (accountChanged()) { resolve(staleResponse()); return }
        const status = res.statusCode != null ? (res.statusCode as number) : 0
        const raw = res.data
        if (status == 204) {
          resolve({ success: true, data: null, code: 0, message: 'success' })
          return
        }
        if (status >= 200 && status < 300) {
          resolve({
            success: true,
            data: raw,
            code: 0,
            message: 'success'
          })
          return
        }
        if (status == 401) {
          clearAuthTokens()
        }
        const message = extractDetail(raw)
        resolve({
          success: false,
          data: raw,
          code: status,
          message: message
        })
      },
      fail: (err: any) => {
        if (accountChanged()) { resolve(staleResponse()); return }
        console.error('❌ [HTTP Error]', err)
        resolve({
          success: false,
          data: null,
          code: -1,
          message: err != null && err.errMsg != null ? err.errMsg : '网络请求失败'
        })
      }
    })
  })
}

function sleep(ms: number) {
  return new Promise((resolve) => setTimeout(resolve, ms))
}
