/**
 * AI 分身前端服务。
 * USE_MOCK=true 时保留本地演示；生产联调默认使用后端持久化会话。
 */

import { getUserDetail } from './user.uts'
import { getMembershipStatus } from './membership.uts'
import { USE_MOCK, getAccessToken, resolveMediaUrl } from './config.uts'
import { request } from './request.uts'
import {
  AI_AVATAR_QUICK_QUESTIONS,
  buildMockAiAvatarReply,
  buildMockAiAvatarPersonReply
} from '@/mock/ai-avatar.uts'

export const AI_AVATAR_STORAGE_PREFIX = 'xsa-ai-avatar-conversations-v1-'
export const AI_AVATAR_OWNER_STORAGE_PREFIX = 'xsa-ai-avatar-owner-v1-'
export const AI_AVATAR_SESSION_STORAGE_PREFIX = 'xsa-ai-avatar-session-v1-'
export const AI_AVATAR_HANDOFF_DELAY = 6000
const AI_AVATAR_PROFILE_PREFIX = 'xsa-ai-avatar-profile-v1-'
const SELF_AVATAR = '/static/portraits/profile-man-light.webp'
const USER_ID_STORAGE_KEY = 'xsa_user_id'

function success(data: any = null, message: string = 'success'): any {
  return { success: true, data: data, code: 0, message: message }
}

function failure(message: string, code: any = -1): any {
  return { success: false, data: null, code: code, message: message }
}

function textValue(value: any, fallback: string = ''): string {
  if (value == null) return fallback
  const text = String(value).trim()
  return text.length > 0 ? text : fallback
}

function pick(source: any, keys: string[], fallback: any = null): any {
  if (source == null) return fallback
  for (let i = 0; i < keys.length; i++) {
    const value = source[keys[i]]
    if (value != null && String(value).trim() != '') return value
  }
  return fallback
}

function listValue(value: any): string[] {
  if (!Array.isArray(value)) return []
  const result: string[] = []
  for (let i = 0; i < value.length; i++) {
    const item = String(value[i]).trim()
    if (item.length > 0 && result.indexOf(item) < 0) result.push(item)
  }
  return result
}

function currentUserId(): number {
  try {
    const value = uni.getStorageSync(USER_ID_STORAGE_KEY)
    const id = Number(value)
    return id > 0 ? id : 0
  } catch (e) {
    return 0
  }
}

function tokenScope(): string {
  const userId = currentUserId()
  if (userId > 0) return 'user-' + String(userId)
  const token = getAccessToken()
  if (token == '') return 'guest'
  let hash = 7
  for (let i = 0; i < token.length; i++) hash = (hash * 31 + token.charCodeAt(i)) % 2147483647
  return 'token-' + String(hash)
}

function unwrapProfile(raw: any): any {
  if (raw == null || typeof raw != 'object') return {}
  const envelope = raw.data != null && typeof raw.data == 'object' ? raw.data : raw
  const profile = envelope.profile != null && typeof envelope.profile == 'object' ? envelope.profile : envelope
  const card = envelope.card != null && typeof envelope.card == 'object' ? envelope.card : envelope
  return { envelope: envelope, profile: profile, card: card }
}

function educationLabel(value: any): string {
  const labels = ['', '高中及以下', '大专', '本科', '硕士', '博士']
  const index = value != null ? Number(value) : 0
  return index > 0 && index < labels.length ? labels[index] : ''
}

function normalizeAiAvatarProfile(raw: any, restricted: boolean): any {
  const parts = unwrapProfile(raw)
  const envelope = parts.envelope
  const profile = parts.profile
  const card = parts.card
  const account = envelope.user != null && typeof envelope.user == 'object'
    ? envelope.user
    : (envelope.account != null && typeof envelope.account == 'object' ? envelope.account : {})
  const tags = listValue(pick(card, ['tags'], pick(profile, ['interest_tags'], [])))
  const tagSelections = profile.tag_selections != null && typeof profile.tag_selections == 'object' ? profile.tag_selections : {}
  const expect = listValue(pick(tagSelections, ['relationship_expectation'], pick(card, ['expect', 'expectations'], pick(profile, ['expectations'], []))))
  const dynamics = listValue(pick(envelope, ['dynamicSummary', 'dynamicsSummary', 'interests'], []))
  const allowExpectations = restricted !== true
  const directCity = textValue(pick(card, ['city'], pick(profile, ['city', 'city_name'], '')), '')
  const directEducation = textValue(pick(card, ['education', 'edu'], pick(profile, ['education'], '')), '')
  const resolvedEducation = directEducation.length > 0 ? directEducation : educationLabel(profile.education_level)
  return {
    id: Number(pick(envelope, ['user_id'], pick(card, ['id', 'user_id'], pick(profile, ['id', 'user_id'], 0)))),
    name: textValue(pick(card, ['name', 'nickname'], pick(profile, ['name', 'nickname'], pick(envelope, ['name', 'nickname'], pick(account, ['name', 'nickname'], 'Ta')))), 'Ta'),
    avatar: textValue(pick(card, ['avatar'], pick(profile, ['avatar'], pick(envelope, ['avatar'], pick(account, ['avatar'], SELF_AVATAR)))), SELF_AVATAR),
    age: textValue(pick(card, ['age'], pick(profile, ['age'], '暂未填写')), '暂未填写'),
    city: textValue(directCity, '暂未填写'),
    job: textValue(pick(card, ['job', 'occupation'], pick(profile, ['job', 'occupation'], '暂未填写')), '暂未填写'),
    education: textValue(resolvedEducation, '暂未填写'),
    tags: tags,
    bio: textValue(pick(card, ['intro', 'introduction', 'bio'], pick(profile, ['self_intro', 'introduction', 'bio'], '')), ''),
    interests: tags.concat(dynamics),
    expectations: expect,
    allowExpectations: allowExpectations,
    restricted: restricted === true
  }
}

function isTrueFlag(value: any): boolean {
  if (value === true || value === 1) return true
  return value != null && String(value).toLowerCase() == 'true'
}

function hasRestrictedProfileFlag(raw: any): boolean {
  const parts = unwrapProfile(raw)
  const sources: any[] = [raw, parts.envelope, parts.profile, parts.card]
  const keys = ['detailLocked', 'detail_locked', 'isLocked', 'is_locked', 'locked', 'restricted', 'privacy_locked', 'vip_locked']
  for (let i = 0; i < sources.length; i++) {
    const source = sources[i]
    if (source == null || typeof source != 'object') continue
    for (let j = 0; j < keys.length; j++) {
      if (isTrueFlag(source[keys[j]])) return true
    }
  }
  return false
}

function hasVipProfileFlag(raw: any): boolean {
  const parts = unwrapProfile(raw)
  const sources: any[] = [raw, parts.envelope, parts.profile, parts.card]
  const keys = ['isVip', 'isVIP', 'is_vip', 'vip', 'vip_member']
  for (let i = 0; i < sources.length; i++) {
    const source = sources[i]
    if (source == null || typeof source != 'object') continue
    for (let j = 0; j < keys.length; j++) {
      if (isTrueFlag(source[keys[j]])) return true
    }
  }
  return false
}

function storageKey(userId: number): string {
  return AI_AVATAR_STORAGE_PREFIX + String(userId) + '-' + tokenScope()
}

function profileStorageKey(userId: number): string {
  return AI_AVATAR_PROFILE_PREFIX + String(userId) + '-' + tokenScope()
}

function ownerStorageKey(userId: number): string {
  return AI_AVATAR_OWNER_STORAGE_PREFIX + String(userId)
}

function sessionStorageKey(ownerId: number): string {
  return AI_AVATAR_SESSION_STORAGE_PREFIX + String(ownerId) + '-' + tokenScope()
}

function readServerSessionId(ownerId: number): number {
  if (ownerId <= 0) return 0
  try {
    const value = uni.getStorageSync(sessionStorageKey(ownerId))
    const id = Number(value)
    return id > 0 ? id : 0
  } catch (e) {
    return 0
  }
}

function writeServerSessionId(ownerId: number, sessionId: number): void {
  if (ownerId <= 0 || sessionId <= 0) return
  try { uni.setStorageSync(sessionStorageKey(ownerId), sessionId) } catch (e) {}
}

function clearServerSessionId(ownerId: number): void {
  try { uni.removeStorageSync(sessionStorageKey(ownerId)) } catch (e) {}
}

function normalizeServerProfile(raw: any, ownerId: number): any {
  const profile = normalizeAiAvatarProfile(raw, false)
  profile.id = ownerId
  profile.avatar = resolveMediaUrl(profile.avatar)
  profile.privacyNotice = raw != null && raw.privacy_notice != null
    ? String(raw.privacy_notice)
    : '这是 AI 分身，只参考公开资料，不是真人聊天。'
  profile.restricted = false
  return profile
}

function serverMessageRows(raw: any): any[] {
  if (raw == null || typeof raw != 'object' || !Array.isArray(raw.messages)) return []
  return raw.messages as any[]
}

function mapServerMessages(raw: any, profile: any): any[] {
  const rows = serverMessageRows(raw)
  return rows.map((item: any, index: number) => ({
    id: item.id,
    type: 'text',
    content: textValue(item.content, ''),
    time: item.created_at != null ? String(item.created_at) : '',
    showTime: index == 0,
    isMine: item.role == 'visitor',
    avatar: item.role == 'visitor' ? SELF_AVATAR : profile.avatar,
    source: item.source != null ? String(item.source) : 'system',
    handoffStatus: item.handoff_status != null ? String(item.handoff_status) : 'none'
  }))
}

function normalizeServerDashboard(raw: any): any {
  const value = raw != null && typeof raw == 'object' ? raw : {}
  const pendingSource = Array.isArray(value.pending_questions) ? value.pending_questions : []
  const answersSource = Array.isArray(value.answers) ? value.answers : []
  const mapQuestion = (item: any): any => ({
    id: item.id,
    question: item.question != null ? String(item.question) : '',
    answer: item.answer != null ? String(item.answer) : '',
    status: item.status != null ? String(item.status) : 'pending',
    time: item.answered_at != null ? String(item.answered_at) : (item.created_at != null ? String(item.created_at) : '刚刚')
  })
  return {
    chatRecords: [],
    pendingQuestions: pendingSource.map(mapQuestion),
    myAnswers: answersSource.map(mapQuestion),
    enabled: value.enabled == true,
    retentionDays: value.retention_days != null ? Number(value.retention_days) : 30
  }
}

async function ensureServerSession(ownerId: number): Promise<any> {
  const savedId = readServerSessionId(ownerId)
  if (savedId > 0) return success(savedId)
  const res = await request({
    url: '/users/' + ownerId + '/ai-avatar/sessions',
    method: 'POST',
    data: { consent_version: 'ai-avatar-v1' }
  })
  if (!res.success || res.data == null) return res
  const sessionId = Number(res.data.id)
  if (sessionId <= 0) return failure('AI 分身会话创建失败', 'SESSION_INVALID')
  writeServerSessionId(ownerId, sessionId)
  return success(sessionId)
}

async function loadServerConversation(ownerId: number, profile: any): Promise<any> {
  let sessionRes = await ensureServerSession(ownerId)
  if (!sessionRes.success) return sessionRes
  let res = await request({
    url: '/users/' + ownerId + '/ai-avatar/sessions/' + Number(sessionRes.data) + '/messages',
    method: 'GET'
  })
  if (!res.success && (res.code == 404 || res.code == 410)) {
    clearServerSessionId(ownerId)
    sessionRes = await ensureServerSession(ownerId)
    if (!sessionRes.success) return sessionRes
    res = await request({
      url: '/users/' + ownerId + '/ai-avatar/sessions/' + Number(sessionRes.data) + '/messages',
      method: 'GET'
    })
  }
  if (!res.success || res.data == null) return res
  const rows = mapServerMessages(res.data, profile)
  if (rows.length == 0) rows.unshift(initialMessage(profile))
  return success(rows, res.message)
}

async function sendServerMessage(ownerId: number, content: string, idempotencyKey: string): Promise<any> {
  let sessionRes = await ensureServerSession(ownerId)
  if (!sessionRes.success) return sessionRes
  let res = await request({
    url: '/users/' + ownerId + '/ai-avatar/sessions/' + Number(sessionRes.data) + '/messages',
    method: 'POST',
    headers: { 'Idempotency-Key': idempotencyKey },
    data: { content: content }
  })
  if (!res.success && (res.code == 404 || res.code == 410)) {
    clearServerSessionId(ownerId)
    sessionRes = await ensureServerSession(ownerId)
    if (!sessionRes.success) return sessionRes
    res = await request({
      url: '/users/' + ownerId + '/ai-avatar/sessions/' + Number(sessionRes.data) + '/messages',
      method: 'POST',
      headers: { 'Idempotency-Key': idempotencyKey },
      data: { content: content }
    })
  }
  return res
}

function readProfileSnapshot(userId: number): any {
  try {
    const key = profileStorageKey(userId)
    const saved = uni.getStorageSync(key)
    if (saved != null && typeof saved == 'object') return saved
    return null
  } catch (e) {
    return null
  }
}

function readMessages(userId: number): any[] {
  try {
    const key = storageKey(userId)
    const saved = uni.getStorageSync(key)
    if (Array.isArray(saved)) return saved as any[]
    return []
  } catch (e) {
    return []
  }
}

function readOwnerState(ownerId: number): any {
  const empty = { chatRecords: [], pendingQuestions: [], myAnswers: [] }
  if (ownerId <= 0) return empty
  try {
    const saved = uni.getStorageSync(ownerStorageKey(ownerId))
    if (saved == null || typeof saved != 'object') return empty
    return {
      chatRecords: Array.isArray(saved.chatRecords) ? saved.chatRecords : [],
      pendingQuestions: Array.isArray(saved.pendingQuestions) ? saved.pendingQuestions : [],
      myAnswers: Array.isArray(saved.myAnswers) ? saved.myAnswers : []
    }
  } catch (e) {
    return empty
  }
}

function writeOwnerState(ownerId: number, state: any) {
  if (ownerId <= 0) return
  try { uni.setStorageSync(ownerStorageKey(ownerId), state) } catch (e) { console.error('AI 分身管理记录保存失败', e) }
}

function normalizeQuestion(value: any): string {
  return value != null ? String(value).trim().replace(/\s+/g, ' ').toLowerCase() : ''
}

function ownerHasAnswer(ownerId: number, question: string): boolean {
  const normalized = normalizeQuestion(question)
  if (normalized == '') return false
  const state = readOwnerState(ownerId)
  for (let i = 0; i < state.myAnswers.length; i++) {
    if (normalizeQuestion(state.myAnswers[i].question) == normalized) return true
  }
  return false
}

function ownerAnswers(ownerId: number): any[] {
  const state = readOwnerState(ownerId)
  return state.myAnswers.map((item: any) => ({ question: item.question, answer: item.answer }))
}

function enrichProfileWithOwnerAnswers(profile: any, restricted: boolean = false): any {
  if (profile == null || typeof profile != 'object') return profile
  if (restricted === true || profile.restricted === true) {
    profile.customAnswers = []
    return profile
  }
  const ownerId = Number(profile.id)
  profile.customAnswers = ownerAnswers(ownerId)
  return profile
}

function topicLabel(category: string): string {
  if (category == 'basic') return '基本资料'
  if (category == 'interest') return '兴趣爱好'
  if (category == 'expectation') return '择偶标准'
  if (category == 'platform') return '平台规则'
  return '公开资料问答'
}

function recordOwnerInteraction(ownerId: number, question: string, category: string, handoff: any = null): any {
  if (ownerId <= 0) return null
  const state = readOwnerState(ownerId)
  let pending = null
  const topic = topicLabel(category)
  let chat = null
  for (let i = 0; i < state.chatRecords.length; i++) {
    if (state.chatRecords[i].topic == topic) { chat = state.chatRecords[i]; break }
  }
  if (chat == null) {
    chat = { id: 'topic-' + category, topic: topic, count: 0, time: '刚刚' }
    state.chatRecords.unshift(chat)
  }
  chat.count = Number(chat.count) + 1
  chat.time = '刚刚'
  if (handoff != null && !ownerHasAnswer(ownerId, question)) {
    const normalized = normalizeQuestion(question)
    for (let i = 0; i < state.pendingQuestions.length; i++) {
      if (normalizeQuestion(state.pendingQuestions[i].question) == normalized && state.pendingQuestions[i].status == 'pending') {
        pending = state.pendingQuestions[i]
        break
      }
    }
    const handoffRef = { conversationKey: handoff.conversationKey, messageId: handoff.messageId }
    if (pending == null) {
      pending = {
        id: 'question-' + Date.now() + '-' + Math.floor(Math.random() * 1000),
        question: question,
        askedCount: 1,
        status: 'pending',
        handoffs: [handoffRef]
      }
      state.pendingQuestions.unshift(pending)
    } else {
      pending.askedCount = Number(pending.askedCount) + 1
      if (!Array.isArray(pending.handoffs)) pending.handoffs = []
      pending.handoffs.push(handoffRef)
    }
  }
  writeOwnerState(ownerId, state)
  return pending != null ? pending.id : null
}

function writeMessages(userId: number, messages: any[]) {
  try { uni.setStorageSync(storageKey(userId), messages) } catch (e) { console.error('AI 分身记录保存失败', e) }
}

function message(content: string, isMine: boolean, profile: any, source: string = 'ai-avatar', extra: any = {}): any {
  return {
    id: 'ai-avatar-' + Date.now() + '-' + Math.floor(Math.random() * 1000),
    type: 'text',
    content: content,
    time: Date.now(),
    showTime: false,
    isMine: isMine,
    avatar: isMine ? SELF_AVATAR : profile.avatar,
    source: source,
    ...extra
  }
}

function initialMessage(profile: any): any {
  return message(`你好，我是 ${profile.name} 的 AI 分身。这里只参考 Ta 当前公开填写的资料，不是真人聊天，Ta 也不会收到提醒。你可以问我基本资料、兴趣爱好、择偶标准或平台规则。`, false, profile)
}

function resolvePendingMessages(messages: any[], profile: any, force: boolean = false): any[] {
  const result = messages.slice()
  const now = Date.now()
  const pending: any[] = []
  for (let i = 0; i < result.length; i++) {
    const item = result[i]
    if (item.handoffStatus == 'pending') pending.push(item)
  }
  for (let i = 0; i < pending.length; i++) {
    const handoff = pending[i]
    const dueAt = handoff.handoffDueAt != null ? Number(handoff.handoffDueAt) : 0
    if (!force && dueAt > now) continue
    handoff.handoffStatus = 'answered'
    const answer = buildMockAiAvatarPersonReply(profile, handoff.handoffQuestion != null ? String(handoff.handoffQuestion) : '')
    result.push(message(answer, false, profile, 'mock-person', {
      handoffStatus: 'answered',
      handoffQuestion: handoff.handoffQuestion,
      isMockPersonReply: true
    }))
  }
  return result
}

export async function getAiAvatarProfile(userId: number, restricted: boolean = false): Promise<any> {
  if (getAccessToken() == '') return failure('请先登录后使用 AI 分身', 'AUTH_REQUIRED')
  if (userId <= 0) return failure('用户资料不存在', 'USER_NOT_FOUND')

  if (!USE_MOCK) {
    const res = await request({ url: '/users/' + userId + '/ai-avatar/profile', method: 'GET' })
    if (!res.success || res.data == null) return res
    return success(normalizeServerProfile(res.data, userId), res.message)
  }

  // Revalidate the visible profile before using a local snapshot. The route's
  // locked flag is only a hint and must not override current privacy state.
  let currentRes: any = null
  try { currentRes = await getUserDetail(userId) } catch (e) {}
  if (currentRes != null && currentRes.success === true && currentRes.data != null) {
    let viewerIsVip = false
    try {
      const membershipRes = await getMembershipStatus()
      viewerIsVip = membershipRes.success === true && membershipRes.data != null && membershipRes.data.is_vip === true
    } catch (e) {}
    const effectiveRestricted = restricted === true || hasRestrictedProfileFlag(currentRes.data) || (hasVipProfileFlag(currentRes.data) && !viewerIsVip)
    const profile = normalizeAiAvatarProfile(currentRes.data, effectiveRestricted)
    profile.id = userId
    profile.snapshotUpdatedAt = Date.now()
    try { uni.setStorageSync(profileStorageKey(userId), profile) } catch (e) {}
    return success(enrichProfileWithOwnerAnswers(profile, effectiveRestricted))
  }

  // Network fallback is fail-closed: only previously visible basics survive,
  // while expectations, dynamics, and owner answers are removed.
  const saved = readProfileSnapshot(userId)
  if (saved != null) {
    const profile = normalizeAiAvatarProfile(saved, true)
    profile.id = userId
    profile.restricted = true
    profile.stale = true
    profile.expectations = []
    profile.interests = []
    profile.customAnswers = []
    return success(profile, '公开资料快照暂时是旧数据')
  }
  return failure(currentRes != null && currentRes.message != null ? String(currentRes.message) : '用户资料暂时无法打开', currentRes != null ? currentRes.code : -1)
}

export function saveAiAvatarProfileSnapshot(userId: number, snapshot: any, restricted: boolean = false): any {
  if (userId <= 0 || snapshot == null || typeof snapshot != 'object') return failure('用户资料不存在', 'USER_NOT_FOUND')
  const profile = normalizeAiAvatarProfile(snapshot, restricted)
  profile.id = userId
  profile.snapshotUpdatedAt = Date.now()
  if (restricted === true) profile.expectations = []
  try {
    uni.setStorageSync(profileStorageKey(userId), profile)
  } catch (e) {
    return failure('公开资料快照保存失败')
  }
  return success(enrichProfileWithOwnerAnswers(profile, restricted))
}

export function getAiAvatarQuickQuestions(): any {
  return success(AI_AVATAR_QUICK_QUESTIONS)
}

export async function getAiAvatarConversation(userId: number, profile: any): Promise<any> {
  if (userId <= 0) return failure('用户资料不存在', 'USER_NOT_FOUND')
  if (profile == null || typeof profile != 'object') return failure('AI 分身资料暂时无法读取', 'PROFILE_REQUIRED')

  if (!USE_MOCK) {
    return loadServerConversation(Number(profile.id), profile)
  }
  profile = enrichProfileWithOwnerAnswers(profile, profile.restricted === true)
  let messages = readMessages(userId)
  if (messages.length == 0) {
    messages = [initialMessage(profile)]
    writeMessages(userId, messages)
  }
  const resolved = resolvePendingMessages(messages, profile)
  if (resolved.length != messages.length || JSON.stringify(resolved) != JSON.stringify(messages)) writeMessages(userId, resolved)
  return success(resolved)
}

export async function sendAiAvatarMessage(userId: number, content: string, profile: any): Promise<any> {
  const question = content != null ? String(content).trim() : ''
  if (question.length == 0) return failure('请输入问题', 'EMPTY_MESSAGE')
  if (question.length > 300) return failure('问题不能超过 300 个字', 'MESSAGE_TOO_LONG')
  if (userId <= 0 || profile == null || typeof profile != 'object') return failure('AI 分身资料暂时无法读取', 'PROFILE_REQUIRED')

  if (!USE_MOCK) {
    const key = 'ai-avatar-' + userId + '-' + Date.now() + '-' + Math.floor(Math.random() * 100000)
    const sendRes = await sendServerMessage(userId, question, key)
    if (!sendRes.success || sendRes.data == null) return sendRes
    const historyRes = await loadServerConversation(userId, profile)
    if (!historyRes.success || historyRes.data == null) return historyRes
    return success({ messages: historyRes.data, result: sendRes.data }, sendRes.message)
  }
  profile = enrichProfileWithOwnerAnswers(profile, profile.restricted === true)
  let messages = readMessages(userId)
  if (messages.length == 0) {
    messages = [initialMessage(profile)]
    writeMessages(userId, messages)
  }
  messages = resolvePendingMessages(messages, profile)
  messages.push(message(question, true, profile, 'user'))
  const result = buildMockAiAvatarReply(profile, question)
  const extra: any = {}
  if (result.handoffRequired === true) {
    extra.handoffStatus = 'pending'
    extra.handoffQuestion = question
    extra.handoffDueAt = Date.now() + AI_AVATAR_HANDOFF_DELAY
  }
  const replyMessage = message(result.reply, false, profile, result.source, extra)
  const ownerQuestionId = recordOwnerInteraction(Number(profile.id), question, result.category, result.handoffRequired === true ? {
    conversationKey: storageKey(userId),
    messageId: replyMessage.id
  } : null)
  if (ownerQuestionId != null) replyMessage.handoffId = ownerQuestionId
  messages.push(replyMessage)
  writeMessages(userId, messages)
  return success({ messages: messages, result: result })
}

export async function resolveAiAvatarHandoffs(userId: number, profile: any): Promise<any> {
  if (userId <= 0 || profile == null || typeof profile != 'object') return failure('AI 分身资料暂时无法读取', 'PROFILE_REQUIRED')
  if (!USE_MOCK) return getAiAvatarConversation(userId, profile)
  profile = enrichProfileWithOwnerAnswers(profile, profile.restricted === true)
  const messages = readMessages(userId)
  const resolved = resolvePendingMessages(messages, profile)
  if (JSON.stringify(resolved) != JSON.stringify(messages)) writeMessages(userId, resolved)
  return success(resolved)
}

export async function clearAiAvatarConversation(userId: number): Promise<any> {
  if (userId <= 0) return failure('用户资料不存在', 'USER_NOT_FOUND')
  if (!USE_MOCK) {
    const sessionId = readServerSessionId(userId)
    if (sessionId <= 0) return success([], 'AI 分身聊天记录已清空')
    const res = await request({
      url: '/users/' + userId + '/ai-avatar/sessions/' + sessionId,
      method: 'DELETE'
    })
    if (!res.success) return res
    clearServerSessionId(userId)
    return success([], 'AI 分身聊天记录已清空')
  }
  try { uni.removeStorageSync(storageKey(userId)) } catch (e) { return failure('清空记录失败') }
  return success([], 'AI 分身聊天记录已清空')
}

export function getAiAvatarOwnerId(): number {
  return currentUserId()
}

export async function getAiAvatarOwnerDashboard(ownerId: number = 0): Promise<any> {
  if (getAccessToken() == '') return failure('请先登录后管理 AI 分身', 'AUTH_REQUIRED')
  const currentId = currentUserId()
  const id = ownerId > 0 ? ownerId : currentId
  if (currentId <= 0 || id <= 0) return failure('当前账号资料暂时无法读取', 'USER_REQUIRED')
  if (id != currentId) return failure('无权管理其他账号的 AI 分身', 'FORBIDDEN')
  if (!USE_MOCK) {
    const res = await request({ url: '/users/me/ai-avatar/dashboard', method: 'GET' })
    if (!res.success || res.data == null) return res
    return success(normalizeServerDashboard(res.data), res.message)
  }
  const state = readOwnerState(id)
  return success({
    chatRecords: state.chatRecords,
    pendingQuestions: state.pendingQuestions.filter((item: any) => item.status == null || item.status == 'pending'),
    myAnswers: state.myAnswers
  })
}

function updateVisitorHandoff(conversationKey: string, messageId: string, answer: string): void {
  if (conversationKey == '' || messageId == '') return
  try {
    const messages = uni.getStorageSync(conversationKey)
    if (!Array.isArray(messages)) return
    for (let i = 0; i < messages.length; i++) {
      const item = messages[i]
      if (String(item.id) == messageId && item.handoffStatus == 'pending') {
        item.content = '本人补充回答（演示）：' + answer
        item.source = 'owner-answer'
        item.handoffStatus = 'answered'
        item.isMockPersonReply = false
        break
      }
    }
    uni.setStorageSync(conversationKey, messages)
  } catch (e) {}
}

export async function submitAiAvatarOwnerAnswer(ownerId: number, questionId: string, answer: string): Promise<any> {
  if (getAccessToken() == '') return failure('请先登录后管理 AI 分身', 'AUTH_REQUIRED')
  const currentId = currentUserId()
  const id = ownerId > 0 ? ownerId : currentId
  const value = answer != null ? String(answer).trim() : ''
  if (currentId <= 0 || id <= 0) return failure('当前账号资料暂时无法读取', 'USER_REQUIRED')
  if (id != currentId) return failure('无权管理其他账号的 AI 分身', 'FORBIDDEN')
  if (value == '') return failure('回答不能为空', 'EMPTY_ANSWER')
  if (value.length > 500) return failure('回答不能超过 500 个字', 'ANSWER_TOO_LONG')
  if (!USE_MOCK) {
    const res = await request({
      url: '/users/me/ai-avatar/questions/' + Number(questionId) + '/answer',
      method: 'POST',
      data: { answer: value }
    })
    if (!res.success || res.data == null) return res
    return success(normalizeServerDashboard(res.data), res.message)
  }
  const state = readOwnerState(id)
  let question = null
  for (let i = 0; i < state.pendingQuestions.length; i++) {
    if (String(state.pendingQuestions[i].id) == String(questionId)) { question = state.pendingQuestions[i]; break }
  }
  if (question == null) {
    for (let i = 0; i < state.myAnswers.length; i++) {
      if (String(state.myAnswers[i].id) == String(questionId)) {
        state.myAnswers[i].answer = value
        state.myAnswers[i].time = '刚刚'
        writeOwnerState(id, state)
        return getAiAvatarOwnerDashboard(id)
      }
    }
    return failure('待回答问题不存在', 'QUESTION_NOT_FOUND')
  }
  question.status = 'answered'
  let existing = null
  for (let i = 0; i < state.myAnswers.length; i++) {
    if (normalizeQuestion(state.myAnswers[i].question) == normalizeQuestion(question.question)) { existing = state.myAnswers[i]; break }
  }
  if (existing == null) state.myAnswers.unshift({ id: 'answer-' + Date.now(), question: question.question, answer: value, time: '刚刚' })
  else { existing.answer = value; existing.time = '刚刚' }
  if (Array.isArray(question.handoffs)) {
    for (let i = 0; i < question.handoffs.length; i++) updateVisitorHandoff(String(question.handoffs[i].conversationKey), String(question.handoffs[i].messageId), value)
  }
  writeOwnerState(id, state)
  return getAiAvatarOwnerDashboard(id)
}

export async function addAiAvatarOwnerAnswer(ownerId: number, question: string, answer: string): Promise<any> {
  if (getAccessToken() == '') return failure('请先登录后管理 AI 分身', 'AUTH_REQUIRED')
  const currentId = currentUserId()
  const id = ownerId > 0 ? ownerId : currentId
  const q = question != null ? String(question).trim() : ''
  const value = answer != null ? String(answer).trim() : ''
  if (currentId <= 0 || id <= 0) return failure('当前账号资料暂时无法读取', 'USER_REQUIRED')
  if (id != currentId) return failure('无权管理其他账号的 AI 分身', 'FORBIDDEN')
  if (q == '') return failure('问题不能为空', 'EMPTY_QUESTION')
  if (q.length > 50) return failure('问题不能超过 50 个字', 'QUESTION_TOO_LONG')
  if (value == '') return failure('回答不能为空', 'EMPTY_ANSWER')
  if (value.length > 500) return failure('回答不能超过 500 个字', 'ANSWER_TOO_LONG')
  if (!USE_MOCK) {
    const res = await request({
      url: '/users/me/ai-avatar/questions',
      method: 'POST',
      data: { question: q, answer: value }
    })
    if (!res.success || res.data == null) return res
    return success(normalizeServerDashboard(res.data), res.message)
  }
  const state = readOwnerState(id)
  for (let i = 0; i < state.myAnswers.length; i++) {
    if (normalizeQuestion(state.myAnswers[i].question) == normalizeQuestion(q)) {
      state.myAnswers[i].answer = value
      state.myAnswers[i].time = '刚刚'
      writeOwnerState(id, state)
      return getAiAvatarOwnerDashboard(id)
    }
  }
  state.myAnswers.unshift({ id: 'answer-' + Date.now(), question: q, answer: value, time: '刚刚' })
  writeOwnerState(id, state)
  return getAiAvatarOwnerDashboard(id)
}

export async function deleteAiAvatarOwnerQuestion(ownerId: number, questionId: string): Promise<any> {
  if (getAccessToken() == '') return failure('请先登录后管理 AI 分身', 'AUTH_REQUIRED')
  const currentId = currentUserId()
  const id = ownerId > 0 ? ownerId : currentId
  if (currentId <= 0 || id != currentId) return failure('无权管理其他账号的 AI 分身', 'FORBIDDEN')
  if (!USE_MOCK) {
    const res = await request({ url: '/users/me/ai-avatar/questions/' + Number(questionId), method: 'DELETE' })
    if (!res.success) return res
    return getAiAvatarOwnerDashboard(id)
  }
  const state = readOwnerState(id)
  state.pendingQuestions = state.pendingQuestions.filter((item: any) => String(item.id) != String(questionId))
  writeOwnerState(id, state)
  return getAiAvatarOwnerDashboard(id)
}

export async function deleteAiAvatarOwnerAnswer(ownerId: number, answerId: string): Promise<any> {
  if (getAccessToken() == '') return failure('请先登录后管理 AI 分身', 'AUTH_REQUIRED')
  const currentId = currentUserId()
  const id = ownerId > 0 ? ownerId : currentId
  if (currentId <= 0 || id != currentId) return failure('无权管理其他账号的 AI 分身', 'FORBIDDEN')
  if (!USE_MOCK) {
    const res = await request({ url: '/users/me/ai-avatar/questions/' + Number(answerId), method: 'DELETE' })
    if (!res.success) return res
    return getAiAvatarOwnerDashboard(id)
  }
  const state = readOwnerState(id)
  state.myAnswers = state.myAnswers.filter((item: any) => String(item.id) != String(answerId))
  writeOwnerState(id, state)
  return getAiAvatarOwnerDashboard(id)
}
