import { request } from './request.uts'
import { resolveMediaUrl } from './config.uts'
import { mockRecommendUsers, mockSquareUsers } from '@/mock/user.uts'

// 只适配服务端公开候选卡；详情 profile/画像/择偶偏好由各自接口处理。
export function mapCard(row: any, fallbackName: string = '用户'): any {
  const source = row != null && row.target != null ? row.target : row
  const card = source != null ? source : {}
  const tags = Array.isArray(card.personal_tags) ? card.personal_tags : card.interest_tags != null && Array.isArray(card.interest_tags)
    ? card.interest_tags
    : (card.tags != null && Array.isArray(card.tags) ? card.tags : [])
  const certifications = card.certification_tags != null && Array.isArray(card.certification_tags)
    ? card.certification_tags
    : (card.qualificationTags != null && Array.isArray(card.qualificationTags) ? card.qualificationTags : [])
  const photo = card.avatar != null ? resolveMediaUrl(card.avatar) : ''
  const photos: string[] = []
  const rawPhotos = card.photos != null && Array.isArray(card.photos) ? card.photos as any[] : []
  for (let i = 0; i < rawPhotos.length; i++) {
    const item = resolveMediaUrl(rawPhotos[i])
    if (item != '' && photos.indexOf(item) < 0) photos.push(item)
  }
  if (photos.length == 0 && photo != '') photos.push(photo)
  const onlineText = card.online != null ? '' + card.online : ''
  return {
    id: Number(card.user_id != null ? card.user_id : (card.id != null ? card.id : 0)),
    userId: Number(card.user_id != null ? card.user_id : 0),
    name: card.nickname != null ? '' + card.nickname : (card.name != null ? '' + card.name : fallbackName),
    nickname: card.nickname != null ? '' + card.nickname : (card.name != null ? '' + card.name : fallbackName),
    avatar: photo,
    photos,
    age: card.age != null ? Number(card.age) : 0,
    height: card.height_cm != null ? Number(card.height_cm) : (card.height != null ? Number(card.height) : 0),
    weight: card.weight_kg != null ? Number(card.weight_kg) : (card.weight != null ? Number(card.weight) : 0),
    gender: card.gender != null ? '' + card.gender : '',
    zodiac: card.zodiac != null ? '' + card.zodiac : (card.constellation != null ? '' + card.constellation : ''),
    hometown: card.hometown != null ? '' + card.hometown : '',
    income: card.income != null ? '' + card.income : '',
    bio: card.bio != null ? '' + card.bio : (card.introduction != null ? '' + card.introduction : (card.intro != null ? '' + card.intro : '')),
    education: card.education_level != null ? '' + card.education_level : (card.education != null ? '' + card.education : '未填写'),
    educationLevel: card.education_level,
    job: card.occupation != null ? '' + card.occupation : (card.job != null ? '' + card.job : '未填写'),
    occupation: card.occupation != null ? '' + card.occupation : (card.job != null ? '' + card.job : ''),
    city: card.city_code != null ? '' + card.city_code : (card.city != null ? '' + card.city : '未填写'),
    cityCode: card.city_code != null ? '' + card.city_code : '',
    distance: card.distance_km != null ? Number(card.distance_km) : null,
    detailLocked: card.detail_locked === true,
    online: card.online_status != null ? card.online_status == 1 : (card.online === true || onlineText.indexOf('在线') >= 0),
    mbti: card.mbti != null ? '' + card.mbti : '',
    interestTags: tags,
    certificationTags: certifications,
    isVip: card.isVip === true || card.is_vip === true,
    isFavorite: card.is_favorite == true,
    matchScore: card.match_score != null ? Number(card.match_score) : (card.match != null ? Number(card.match) : null),
    viewCount: card.view_count != null ? Number(card.view_count) : 0,
    matchReason: card.match_reason != null ? '' + card.match_reason : '',
    raw: card
  }
}

function mapPage(raw: any): any {
  const body = raw != null ? raw : {}
  const rows = body.items != null && Array.isArray(body.items) ? body.items : []
  const items: any[] = []
  for (let i = 0; i < rows.length; i++) items.push(mapCard(rows[i]))
  return {
    items,
    page: body.page != null ? Number(body.page) : 1,
    pageSize: body.page_size != null ? Number(body.page_size) : 20,
    total: body.total != null ? Number(body.total) : items.length,
    hasMore: body.has_more == true,
    nextCursor: body.next_cursor != null ? '' + body.next_cursor : ''
  }
}

export async function getDiscoveryRecommendations(filters: any = null) {
  const res = await request({
    url: '/discovery/recommendations',
    method: 'GET',
    data: filters != null ? filters : {},
    mockData: { items: mockRecommendUsers, page: 1, page_size: 20, total: mockRecommendUsers.length, has_more: false }
  })
  if (!res.success) return res
  return { success: true, data: mapPage(res.data), code: res.code, message: res.message }
}

