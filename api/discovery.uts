export async function acceptDiscoveryApplication(applicationId: number) {
  return request({ url: '/discovery/applications/' + applicationId + '/accept', method: 'POST', data: {} })
}

export async function rejectDiscoveryApplication(applicationId: number, reason: string = '') {
  return request({ url: '/discovery/applications/' + applicationId + '/reject', method: 'POST', data: reason != '' ? { reason } : {} })
}
