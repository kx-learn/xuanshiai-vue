/**
 * 用户相关 API
 * Mock 来源：design-demos/final 高保真嘉宾数据
 * likeUser / applyToMeet：USE_MOCK 双路径；真接口走 social / discovery
 */

import { request } from './request.uts'
import { mockProfileTagOptions } from '@/mock/profile-tags.uts'
import { USE_MOCK, getAccessToken, clearAuthTokens, buildApiUrl } from './config.uts'
import {
  mockRecommendUsers,
  mockSquareUsers,
  mockUserDetail,
  mockMeProfile,
  mockCommunityQuotas,
  mockApplyStates,
  mockLikedUserIds
} from '@/mock'
import { __syncApplyStatus, getCommunityQuotas } from './community.uts'
import { getMockParentStateData, saveMockParentStateData, isMockParentCandidateBlocked } from '@/mock/parent.uts'
import { createMockParentApplication } from '@/mock/message.uts'

function okRes(data: any): any {
  return {
    success: true,
    data: data,
    code: 0,
    message: 'success'
  }
}

function failRes(message: string, code: any = -1, extra: any = null): any {
  const data: any = { success: false, code: code, message: message }
  if (extra != null) {
    const keys = Object.keys(extra)
    for (let i = 0; i < keys.length; i++) {
      data[keys[i]] = extra[keys[i]]
    }
  }
  return {
    success: false,
    data: data,
    code: code,
    message: message
  }
}

/**
 * 父母端仍处于内部演示阶段。这个 scope 只允许走独立 Mock，绝不能把
 * 父母代操作降级为当前普通登录用户的真实关系接口。
 */


function isParentMockScope(scope: string = ''): boolean {
  return scope.indexOf('parent:') == 0
}

function getParentMockLikedIds(scope: string): number[] {
  return getMockParentStateData(scope).likedUserIds as number[]
}

/**
 * 父母端沿用普通端的高保真资料，不单独维护一份低保真候选人。
 * 同一用户可能同时出现在推荐和广场列表，按 id 去重后再进入隔离主体视图。
 */
export function getParentMockCandidateSource(): any[] {
  const output: any[] = []
  const seen: { [key: string]: boolean } = {}
  const groups = [mockRecommendUsers as any[], mockSquareUsers as any[]]
  for (let groupIndex = 0; groupIndex < groups.length; groupIndex++) {
    const group = groups[groupIndex]
    for (let itemIndex = 0; itemIndex < group.length; itemIndex++) {
      const item = group[itemIndex]
      const id = item != null && item.id != null ? String(item.id) : ''
      if (id == '' || seen[id] == true) continue
      seen[id] = true
      output.push(item)
    }
  }
  return output
}

function isMockLiked(userId: number, ids: number[]): boolean {
  for (let i = 0; i < ids.length; i++) {
    if (ids[i] == userId) return true
  }
  return false
}

function extractHttpMessage(res: any, fallback: string): string {
  if (res == null) return fallback
  if (res.message != null && res.message != '' && res.message != '请求失败') {
    return '' + res.message
  }
  const raw = res.data
  if (raw != null && raw.detail != null) {
    if (typeof raw.detail === 'string') return '' + raw.detail
  }
  return fallback
}


const defaultMockPreferences: any = {
  user_id: 1,
  age_min: null,
  age_max: null,
  height_min: null,
  height_max: null,
  education_min: null,
  income_min: null,
  marriage_status: 0,
  preferred_province_code: null,
  preferred_city_codes: [],
  accept_long_distance: true,
  accept_cross_province: true,
  housing_requirement: 0,
  smoking_requirement: 0,
  drinking_requirement: 0,
  extra_requirement: null
}
