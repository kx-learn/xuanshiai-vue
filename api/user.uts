// 后端不存在该路由，唯一调用方（搜索页）已迁移至 GET /discovery/recommendations。

/**
 * 用户级喜欢列表。父母端传入内部 scope 时只读取该子女主体的隔离 Mock；
 * 常规用户仍保持上游真实接口与 Mock 的既有分流。
 */
export async function getLikedUsers(internalMockScope: string = '') {
  if (isParentMockScope(internalMockScope)) {
    const likedIds = getParentMockLikedIds(internalMockScope)
    const candidates: any[] = []
    const source = getParentMockCandidateSource()
    for (let i = 0; i < source.length; i++) {
      if (isMockLiked(Number(source[i].id), likedIds) && !isMockParentCandidateBlocked(Number(source[i].id), internalMockScope)) {
        candidates.push({ ...source[i], liked: true })
      }
    }
    return okRes(candidates)
  }
  return request({
    url: '/relations/likes',
    method: 'GET',
    data: { page: 1, page_size: 100 },
    mockData: (mockRecommendUsers as any[]).filter((item: any) =>
      isMockLiked(Number(item.id), mockLikedUserIds as number[])
    )
  })
}


/**
 * 获取用户详情（优先从高保真嘉宾列表查找）
 */
export async function getUserDetail(userId: number, internalMockScope: string = '') {
  const list = mockRecommendUsers as any[]
  let found: any = null
  for (let i = 0; i < list.length; i++) {
    if (list[i].id == userId) {
      found = list[i]
      break
    }
  }
  if (found == null) {
    const squareUsers = mockSquareUsers as any[]
    for (let i = 0; i < squareUsers.length; i++) {
      if (squareUsers[i].id == userId) {
        found = squareUsers[i]
        break
      }
    }
  }
  const detail = found != null
    ? {
        ...mockUserDetail,
        ...found,
        introduction: found.intro != null
          ? found.intro
          : (found.introduction != null ? found.introduction : mockUserDetail.introduction),
        genderText: found.gender == 1 ? '男' : '女',
        certList: ['实名', '学历', '头像', '单身']
      }
    : mockUserDetail

  if (isParentMockScope(internalMockScope)) {
    if (isMockParentCandidateBlocked(userId, internalMockScope)) return failRes('该用户已屏蔽', 'USER_BLOCKED')
    return okRes({
      ...detail,
      liked: isMockLiked(userId, getParentMockLikedIds(internalMockScope))
    })
  }

  if (USE_MOCK) {
    return request({
      url: '/user/detail',
      cloudFunctionName: 'user',
      action: 'getDetail',
      method: 'GET',
      data: { userId },
      mockData: detail
    })
  }

  return request({
    url: '/users/' + userId + '/profile',
    method: 'GET'
  })
}

export async function getOwnProfile() {
  if (USE_MOCK) {
    if (!Array.isArray(mockMeProfile.personal_tags)) {
      const raw: string[] = ([] as string[]).concat(Array.isArray(mockMeProfile.interest_tags) ? mockMeProfile.interest_tags : [], Array.isArray(mockMeProfile.personality_tags) ? mockMeProfile.personality_tags : [])
      const selected: string[] = []
      const legacy: string[] = []
      for (const tag of raw) {
        const valid = mockProfileTagOptions.categories.some((category: any) => category.options.indexOf(tag) >= 0)
        if (valid && selected.indexOf(tag) < 0) selected.push(tag)
        else if (!valid && legacy.indexOf(tag) < 0) legacy.push(tag)
      }
      mockMeProfile.personal_tags = selected
      mockMeProfile.legacy_tags = legacy
    }
    return request({
      url: '/user/me',
      cloudFunctionName: 'user',
      action: 'getMeProfile',
      method: 'GET',
      mockData: mockMeProfile
    })
  }
  return request({ url: '/users/me/profile', method: 'GET' })
}

/** 标签目录随前端发布，进入编辑页即可展示；只有用户选择结果提交后端。 */
export async function getProfileTagOptions() {
  return okRes(mockProfileTagOptions)
}

export async function updateOwnProfile(data: any) {
  if (USE_MOCK) {
    if (data != null && Object.keys(data).indexOf('personal_tags') >= 0) {
      const tags = data.personal_tags
      if (!Array.isArray(tags) || tags.length > mockProfileTagOptions.max_tags) return failRes('兴趣标签最多选择10个', 422)
      const interests: string[] = []
      const personalities: string[] = []
      const customTags: string[] = []
      const customCategories: any = data.custom_tag_categories != null && typeof data.custom_tag_categories === 'object' ? data.custom_tag_categories : {}
      const seen: string[] = []
      const selections: any = {}
      const normalizedTags: string[] = []
      for (const rawTag of tags as string[]) {
        let tag = '' + rawTag
        let categoryKey = ''
        for (const category of mockProfileTagOptions.categories) {
          if (category.options.indexOf(tag) >= 0) categoryKey = category.key
        }
        if (categoryKey == '') {
          const normalized = tag.trim().replace(/\s+/g, ' ')
          let canonical = ''
          for (const category of mockProfileTagOptions.categories) {
            for (const option of category.options) if (option.toLowerCase() == normalized.toLowerCase()) canonical = option
          }
          if (canonical != '') {
            tag = canonical
            for (const category of mockProfileTagOptions.categories) if (category.options.indexOf(tag) >= 0) categoryKey = category.key
          }
          if (categoryKey == '') {
          const policy = mockProfileTagOptions.custom
          const forbidden = ['找对象', '找伴侣', '寻找伴侣', '长期伴侣', '另一半', '恋爱', '结婚', '婚姻', '生育', '身高', '体重', '年龄', '学历', '本科', '硕士', '博士', '收入', '职业', '房产', '资产', '微信', '电话', '手机', 'qq', 'vx', 'v信', 'wx', 'wechat', '加我', '约炮', '包养', '未成年', '政治', '宗教', '疾病']
          const lowered = normalized.toLowerCase()
          if (!policy.enabled || normalized.length < policy.min_length || normalized.length > policy.max_length || !/^[\u4e00-\u9fffA-Za-z0-9·+&\- ]+$/.test(normalized) || /^\d+$/.test(normalized) || normalized.replace(/\D/g, '').length >= 6 || forbidden.some((word: string) => lowered.indexOf(word) >= 0)) return failRes('自定义标签格式或内容不符合要求', 422)
          tag = normalized
          customTags.push(normalized)
          const assignedCategory = customCategories[normalized]
          if (typeof assignedCategory !== 'string' || !mockProfileTagOptions.categories.some((category: any): boolean => category.key === assignedCategory)) return failRes('每个自定义标签都必须选择所属分区', 422)
          categoryKey = 'custom'
          }
        }
        if (seen.some((item: string) => item.toLowerCase() == tag.toLowerCase())) return failRes('标签不能重复', 422)
        if (customTags.length > mockProfileTagOptions.custom.max_tags) return failRes('自定义标签最多添加3个', 422)
        seen.push(tag)
        if (categoryKey == 'personality') personalities.push(tag)
        else interests.push(tag)
        if (selections[categoryKey] == null) selections[categoryKey] = []
        selections[categoryKey].push(tag)
        normalizedTags.push(tag)
      }
      if (Object.keys(customCategories).length !== customTags.length || Object.keys(customCategories).some((label: string): boolean => customTags.indexOf(label) < 0)) return failRes('自定义标签分区与标签不一致', 422)
      if (Object.keys(data).some((key: string) => key == 'interest_tags' || key == 'personality_tags' || key == 'tag_selections')) return failRes('不能混传旧标签字段', 422)
      mockMeProfile.interest_tags = interests
      mockMeProfile.personality_tags = personalities
      mockMeProfile.custom_tags = customTags
      mockMeProfile.custom_tag_categories = customCategories
      data.personal_tags = normalizedTags
      mockMeProfile.tag_selections = selections
      mockMeProfile.legacy_tags = []
    }
    const keys = Object.keys(data != null ? data : {})
    for (let i = 0; i < keys.length; i++) {
      mockMeProfile[keys[i]] = data[keys[i]]
    }
    return request({
      url: '/user/me/profile',
      cloudFunctionName: 'user',
      action: 'updateProfile',
      method: 'PATCH',
      data,
      mockData: mockMeProfile
    })
  }
  return request({ url: '/users/me/profile', method: 'PATCH', data })
}

/**
 * 修改当前登录用户的昵称。
 *
 * 昵称有独立的后端契约，避免在保存基础资料时把昵称混入通用资料更新；
 * 服务端仍负责登录态、长度和内容边界校验。
 */
export async function updateOwnNickname(nickname: string) {
  const value = nickname != null ? nickname.trim() : ''
  if (value == '') return failRes('昵称不能为空', 422)

  if (USE_MOCK) {
    mockMeProfile.name = value
    mockMeProfile.nickname = value
    return request({
      url: '/user/me/nickname',
      cloudFunctionName: 'user',
      action: 'updateNickname',
      method: 'PATCH',
      data: { nickname: value },
      mockData: {
        user_id: mockMeProfile.id,
        nickname: value,
        updated_at: ''
      }
    })
  }

  return request({
    url: '/users/me/nickname',
    method: 'PATCH',
    data: { nickname: value }
  })
}

export async function getOwnPreferences() {
  return request({
    url: '/users/me/preferences',
    method: 'GET',
    mockData: defaultMockPreferences
  })
}

export async function updateOwnPreferences(data: any) {
  const keys = Object.keys(data != null ? data : {})
  for (let i = 0; i < keys.length; i++) {
    defaultMockPreferences[keys[i]] = data[keys[i]]
  }
  return request({
    url: '/users/me/preferences',
    method: 'PUT',
    data,
    mockData: defaultMockPreferences
  })
}

function profileMediaPath(kind: string): string {
  if (kind == 'avatar') return '/users/me/avatar'
  if (kind == 'background') return '/users/me/background'
  return '/users/me/photos'
}

export async function uploadUserProfileMedia(filePath: string, kind: string) {
  const normalizedKind = kind == 'avatar' || kind == 'background' ? kind : 'photo'
  if (USE_MOCK) {
    return request({
      url: '/user/me/' + normalizedKind,
      cloudFunctionName: 'user',
      action: 'uploadProfileMedia',
      method: 'POST',
      mockData: {
        id: 0,
        media_type: normalizedKind,
        file_url: filePath,
        thumbnail_url: filePath,
        sort_order: 0,
        is_primary: normalizedKind == 'avatar',
        duration_seconds: null
      }
    })
  }

  return new Promise<any>((resolve) => {
    uni.uploadFile({
      url: buildApiUrl(profileMediaPath(normalizedKind)),
      filePath,
      name: 'file',
      header: getAccessToken() != '' ? { Authorization: 'Bearer ' + getAccessToken() } : {},
      success: (res: any) => {
        if (res.statusCode == 401) clearAuthTokens()
        let data: any = null
        try {
          data = JSON.parse('' + res.data)
        } catch (e) {
          resolve({ success: false, data: null, code: res.statusCode, message: '上传响应解析失败' })
          return
        }
        if (res.statusCode >= 200 && res.statusCode < 300) {
          resolve({ success: true, data, code: res.statusCode, message: 'success' })
        } else {
          const detail = data != null && data.detail != null ? data.detail : '上传失败'
          resolve({ success: false, data, code: res.statusCode, message: '' + detail })
        }
      },
      fail: (err: any) => {
        const message = err != null && err.errMsg != null ? '' + err.errMsg : '上传失败，请检查网络'
        resolve({ success: false, data: null, code: -1, message })
      }
    })
  })
}

export async function deleteUserProfilePhoto(mediaId: number) {
  return request({
    url: '/users/me/photos/' + mediaId,
    method: 'DELETE',
    mockData: { success: true }
  })
}

/**
 * 当前登录用户资料（我的）
 */
export async function getMeProfile() {
  if (USE_MOCK) {
    return request({
      url: '/user/me',
      cloudFunctionName: 'user',
      action: 'getMe',
      method: 'GET',
      mockData: mockMeProfile
    })
  }

  const res = await request({
    url: '/auth/me',
    method: 'GET'
  })
  if (!res.success || res.data == null) return res
  const raw = res.data
  const status = raw.realname_status != null ? Number(raw.realname_status) : 0
  let realNameStatus = 'missing'
  if (status == 2) {
    realNameStatus = 'passed'
  } else if (status == 1 || status == 4) {
    realNameStatus = 'reviewing'
  } else if (status == 3 || status == 5) {
    realNameStatus = 'rejected'
  }
  return okRes({
    ...raw,
    realNameStatus: realNameStatus
  })
}

/**
 * 申请认识用户
 * 门槛：仅实名（页面 guardRealName）；每日免费 3 次 + 积分加次说明
 * pending/accepted 幂等，不重复扣次；rejected 可再申请
 * 聊天仍须双方同意后开启；会员不可绕过同意门槛
 * Mock：改 mockApplyStates + 本地额度
 * 真路径：POST /discovery/applications/{userId}，不写 mock 状态
 * 注意：request 外层 success 恒为 true 时，业务成败看 data.success / data.code
 */
export async function applyToMeet(userId: number, message: string, internalMockScope: string = '') {
  if (isParentMockScope(internalMockScope)) {
    if (isMockParentCandidateBlocked(userId, internalMockScope)) return failRes('资料不可用', 'CANDIDATE_UNAVAILABLE')
    const candidate = getParentMockCandidateSource().find((item: any) => item.id == userId)
    if (candidate == null) return failRes('资料不存在', 'CANDIDATE_UNAVAILABLE')
    const result = createMockParentApplication(candidate, message, internalMockScope, getMockParentStateData(internalMockScope).context.quota)
    return result.success == true ? okRes(result) : failRes(result.message, result.code)
  }
  if (USE_MOCK) {
    const key = '' + userId
    const states = mockApplyStates as any
    const current = states[key] != null ? (states[key] as string) : 'none'

    if (current == 'pending') {
      return request({
        url: '/user/apply',
        cloudFunctionName: 'user',
        action: 'apply',
        method: 'POST',
        data: { userId, message },
        mockData: {
          success: false,
          code: 'ALREADY_PENDING',
          applyStatus: 'pending',
          remain: mockCommunityQuotas.applyDaily.remain,
          message: '申请已发送，请等待对方回应'
        }
      })
    }

    if (current == 'accepted') {
      return request({
        url: '/user/apply',
        cloudFunctionName: 'user',
        action: 'apply',
        method: 'POST',
        data: { userId, message },
        mockData: {
          success: false,
          code: 'ALREADY_ACCEPTED',
          applyStatus: 'accepted',
          remain: mockCommunityQuotas.applyDaily.remain,
          message: '对方已同意，可在消息中继续沟通'
        }
      })
    }

    const quotas = mockCommunityQuotas as any
    const applyQ = quotas.applyDaily
    // 与 me.remainApply 对齐（取较小值，避免双源漂移）
    if (mockMeProfile != null && mockMeProfile.remainApply != null) {
      const meRemain = mockMeProfile.remainApply as number
      if (meRemain < applyQ.remain) {
        applyQ.remain = meRemain
        applyQ.used = Math.max(0, applyQ.total - meRemain)
      }
    }

    if (applyQ.remain <= 0) {
      if (mockMeProfile != null) {
        mockMeProfile.remainApply = 0
      }
      return request({
        url: '/user/apply',
        cloudFunctionName: 'user',
        action: 'apply',
        method: 'POST',
        data: { userId, message },
        mockData: {
          success: false,
          code: 'QUOTA_EXCEEDED',
          remain: 0,
          applyStatus: current,
          message: '今日免费申请次数已用完，可用积分加次'
        }
      })
    }

    applyQ.used = (applyQ.used as number) + 1
    applyQ.remain = (applyQ.remain as number) - 1
    if (mockMeProfile != null) {
      mockMeProfile.remainApply = applyQ.remain
    }

    states[key] = 'pending'
    __syncApplyStatus(userId, 'pending')

    return request({
      url: '/user/apply',
      cloudFunctionName: 'user',
      action: 'apply',
      method: 'POST',
      data: { userId, message },
      mockData: {
        success: true,
        remain: applyQ.remain,
        applyStatus: 'pending',
        message: '申请已发送，对方同意后才能开始聊天'
      }
    })
  }

  // ── 真路径：discovery 申请认识 ──
  const res = await request({
    url: '/discovery/applications/' + userId,
    method: 'POST',
    data: { message: message != null ? message : null }
  })

  if (!res.success) {
    const status = res.code
    const msg = extractHttpMessage(res, '申请失败')
    if (status == 429) {
      return failRes('今日免费申请次数已用完，可用积分加次', 'QUOTA_EXCEEDED', {
        remain: 0,
        applyStatus: 'none'
      })
    }
    if (status == 409) {
      // 409 不得当成功：不扣次、不 toast「已发送」
      const lower = (msg != null ? ('' + msg) : '').toLowerCase()
      const alreadyMatched =
        lower.indexOf('match') >= 0 || lower.indexOf('匹配') >= 0 || lower.indexOf('已同意') >= 0
      return failRes(
        msg != '' ? msg : alreadyMatched ? '对方已同意或已匹配' : '申请已发送，请等待对方回应',
        alreadyMatched ? 'ALREADY_MATCHED' : 'ALREADY_PENDING',
        {
          applyStatus: alreadyMatched ? 'accepted' : 'pending',
          remain: null
        }
      )
    }
    if (status == 403) {
      return failRes(msg != '' ? msg : '请先完成实名或完善资料', 'FORBIDDEN', {
        applyStatus: 'none'
      })
    }
    return failRes(msg, status, { applyStatus: 'none' })
  }

  let remain: any = null
  let quotaRefreshFailed = false
  try {
    const qRes = await getCommunityQuotas()
    if (qRes.success && qRes.data != null && qRes.data.applyDaily != null) {
      remain = qRes.data.applyDaily.remain
    } else {
      quotaRefreshFailed = true
    }
  } catch (e) {
    quotaRefreshFailed = true
  }

  return okRes({
    success: true,
    remain: remain,
    quotaRefreshFailed: quotaRefreshFailed,
    applyStatus: 'pending',
    message: quotaRefreshFailed
      ? '申请已发送，额度同步失败请下拉刷新'
      : '申请已发送，对方同意后才能开始聊天',
    application: res.data
  })
}

/**
 * 喜欢用户（用户级，非帖子点赞）
 * Mock：toggle mockLikedUserIds
 * 真路径：PUT 喜欢 / DELETE 取消；先查 relations/likes 判断当前状态
 */
export async function likeUser(userId: number, internalMockScope: string = '', desiredLiked: boolean | null = null) {
  if (isParentMockScope(internalMockScope)) {
    if (isMockParentCandidateBlocked(userId, internalMockScope)) return failRes('资料不可用', 'CANDIDATE_UNAVAILABLE')
    const ids = getParentMockLikedIds(internalMockScope)
    const currentLiked = isMockLiked(userId, ids)
    const liked = desiredLiked == null ? !currentLiked : desiredLiked
    if (liked == currentLiked) return okRes({ success: true, liked: liked, userId: userId, internalDemo: true })
    if (liked) {
      ids.push(userId)
    } else {
      const index = ids.indexOf(userId)
      if (index >= 0) ids.splice(index, 1)
    }
    saveMockParentStateData(internalMockScope)
    return okRes({ success: true, liked: liked, userId: userId, internalDemo: true })
  }
  if (USE_MOCK) {
    const ids = mockLikedUserIds as number[]
    let liked = false
    let found = -1
    for (let i = 0; i < ids.length; i++) {
      if (ids[i] == userId) {
        found = i
        break
      }
    }
    if (found >= 0) {
      ids.splice(found, 1)
      liked = false
    } else {
      ids.push(userId)
      liked = true
    }
    return request({
      url: '/user/like',
      cloudFunctionName: 'user',
      action: 'like',
      method: 'POST',
      data: { userId },
      mockData: { success: true, liked, userId }
    })
  }

  // 查当前是否已喜欢：BE page_size le=50，分页扫描；预检失败不默认未喜欢
  let currentlyLiked = false
  let page = 1
  const pageSize = 50
  let scanned = 0
  let total = -1
  let listPreflightOk = false
  while (true) {
    const listRes = await request({
      url: '/relations/likes',
      method: 'GET',
      data: { page: page, page_size: pageSize }
    })
    if (!listRes.success || listRes.data == null) {
      return failRes(extractHttpMessage(listRes, '喜欢列表加载失败'), listRes.code)
    }
    listPreflightOk = true
    const items =
      listRes.data.items != null
        ? (listRes.data.items as any[])
        : listRes.data.list != null
          ? (listRes.data.list as any[])
          : []
    if (listRes.data.total != null) {
      total = listRes.data.total as number
    }
    for (let i = 0; i < items.length; i++) {
      const row = items[i]
      const tid =
        row != null && row.user_id != null
          ? (row.user_id as number)
          : row != null && row.target_user_id != null
            ? (row.target_user_id as number)
            : row != null && row.id != null
              ? (row.id as number)
              : 0
      if (tid == userId) {
        currentlyLiked = true
        break
      }
    }
    if (currentlyLiked) break
    scanned += items.length
    if (items.length < pageSize) break
    if (total >= 0 && scanned >= total) break
    page += 1
  }
  if (!listPreflightOk) {
    return failRes('喜欢列表加载失败', -1)
  }

  const method = currentlyLiked ? 'DELETE' : 'PUT'
  const res = await request({
    url: '/users/' + userId + '/like',
    method: method,
    data: {}
  })
  if (!res.success) {
    return failRes(extractHttpMessage(res, '操作失败'), res.code)
  }
  const enabled =
    res.data != null && res.data.enabled != null
      ? res.data.enabled == true
      : !currentlyLiked
  return okRes({
    success: true,
    liked: enabled,
    userId: userId,
    matched: res.data != null && res.data.matched == true
  })
}

/** 获取当前用户私有的“我的喜欢”用户列表；不会作为帖子互动计数返回。 */
export async function getMyLikedProfiles(page: number = 1, pageSize: number = 20) {
  if (USE_MOCK) {
    const ids = mockLikedUserIds as number[]
    const rows: any[] = []
    const pool = ([] as any[]).concat(mockRecommendUsers as any[], mockSquareUsers as any[])
    for (let i = 0; i < ids.length; i++) {
      for (let j = 0; j < pool.length; j++) {
        const row = pool[j]
        const rowId = row != null && row.id != null ? Number(row.id) : (row != null && row.userId != null ? Number(row.userId) : 0)
        if (rowId == ids[i]) { rows.push(row); break }
      }
    }
    const start = Math.max(0, (page - 1) * pageSize)
    const items = rows.slice(start, start + pageSize)
    return request({
      url: '/users/me/likes',
      cloudFunctionName: 'user',
      action: 'getMyLikedProfiles',
      method: 'GET',
      data: { page, pageSize },
      mockData: { items, total: rows.length, page, pageSize }
    })
  }
  return await request({
    url: '/users/me/likes',
    method: 'GET',
    data: { page, page_size: pageSize }
  })
}
