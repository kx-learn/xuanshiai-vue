/**
 * 墨相师·AI 引路人 对话 WebSocket 封装
 * 支持语音(半双工实时 ASR)和文字(直接发送文本)双模式
 * 流式回复:ai_content 增量推送
 * 墨相师旅程:session_start 固定携带 mode=moxiang_journey,
 *   接收 journey_ready / extraction_status / journey_progress /
 *   build_invite / build_invite_resolved 推送,
 *   客户端可调用 acceptBuildInvite / snoozeBuildInvite 终结邀请
 */

import { buildWsUrl, getAccessToken } from './config.uts'
import { ProfileSubject } from './ai-profile.uts'
import { debugLog } from '@/utils/debug-log.uts'

/** 用户可见的对话角色名；供应商/模型名只存在于服务端调用与审计层。 */
export const MASTER_ROLE_NAME = '知遇'

/** 旅程阶段枚举(Contract v1.1 §1.2) */
export type JourneyStage = 'chatting' | 'building' | 'ready' | 'published'

/** 构建邀请单条摘要项 */
export interface BuildInviteSummaryItem {
	profile_dimension: string
	content: string
}

/** 构建邀请载荷(build_invite) */
export interface BuildInvitePayload {
	subject: ProfileSubject
	invite_id: string
	summary_items: BuildInviteSummaryItem[]
	effective_turn_count: number
	dimension_count: number
	candidate_count: number
	journey_stage: JourneyStage
}

/** 构建邀请终结回执(build_invite_resolved) */
export interface BuildInviteResolution {
	subject: ProfileSubject
	invite_id: string
	resolution: 'accepted' | 'snoozed'
	journey_stage: JourneyStage
}

/** 单个六维进度项(journey_progress.dimensions.*) */
export interface JourneyDimensionProgress {
	percent: number
	evidenceCount: number
}

/** 自然对话旅程的实时六维进度推送(journey_progress) */
export interface JourneyProgress {
	subject: ProfileSubject
	overallPercent: number
	dimensions: { [key: string]: JourneyDimensionProgress }
}

/** 单轮候选抽取状态(extraction_status)。不包含候选内容。 */
export interface ExtractionStatus {
	subject: ProfileSubject
	taskId: string
	status: 'queued' | 'processing' | 'completed' | 'failed'
}

/** 确认卡片单条待确认字段(confirm_card.items) */
export interface ConfirmCardItem {
	fieldKey: string
	kind: string
	category: string
	content: string
	displayValue: string
}

/** 确认卡片载荷(confirm_card) */
export interface ConfirmCardPayload {
	subject: ProfileSubject
	cardId: string
	draftId: string
	expectedRevision: number
	items: ConfirmCardItem[]
}

/**
 * 把后端下行 error.code 分类为可展示/可决策的错误类型。
 * 语义对齐 docs/api/语音.md §4 错误表；未知 code 归入 unknown，不静默丢弃。
 */
export function classifyMasterWSError(code: string): string {
	if (code == 'AI_POLICY_DENIED') return 'policy_denied'
	if (code == 'AI_TEMPORARILY_UNAVAILABLE') return 'temporarily_unavailable'
	if (code == 'AI_QUOTA_EXCEEDED') return 'quota_exceeded'
	if (code == 'AI_INPUT_INVALID') return 'input_invalid'
	if (code == 'AUTH_REQUIRED') return 'auth_required'
	return 'unknown'
}

export interface MasterWSCallbacks {
	onSessionReady?: (sessionId?: string, subject?: ProfileSubject, resumed?: boolean, newSession?: boolean) => void
	onSubjectChanged?: (subject: ProfileSubject, sessionId?: string, resumed?: boolean, newSession?: boolean) => void
	onPartialTranscript?: (text: string) => void
	onFinalTranscript?: (text: string) => void
	onAIThinking?: () => void
	onAIContent?: (text: string) => void
	onAIReply?: (text: string, isOpening?: boolean, generationId?: string) => void
	onTTSAudio?: (audioUrl: string, durationMs: number) => void
	onConfirmCard?: (card: ConfirmCardPayload) => void
	onPublishReady?: (subject: ProfileSubject, summary: string) => void
	onError?: (code: string, message: string) => void
	/**
	 * 类型化错误（在 onError 之外额外触发，onError 保持原签名不变）。
	 * kind 语义对齐后端文档 docs/api/语音.md §4：
	 * - policy_denied：listen 时账号撤权/注销/签名上下文失效 → 停止播放并
	 *   重新获取当前会话/音频；
	 * - temporarily_unavailable：ASR/TTS/模型暂时失败或无法确认账号状态
	 *   → 稍后重试，不复用旧音频 URL；
	 * - quota_exceeded：额度用尽；
	 * - input_invalid：入参或状态非法（如 revise_text 空串、未 session_start）；
	 * - unknown：其他/未知 code。
	 */
	onTypedError?: (kind: string, code: string, message: string) => void
	onClose?: () => void
	// ===== Phase 1 Contract v1.1 P1-D =====
	onJourneyReady?: (subject: ProfileSubject, sessionId: string, journeyStage: JourneyStage, resumed: boolean, protocolVersion?: number) => void
	onExtractionStatus?: (status: ExtractionStatus) => void
	onJourneyProgress?: (progress: JourneyProgress) => void
	onBuildInvite?: (invite: BuildInvitePayload) => void
	onBuildInviteResolved?: (resolution: BuildInviteResolution) => void
	// ===== 实时语音 v2（SenseAudio）=====
	onVoiceReady?: () => void
	onInputClosed?: () => void
	onAudioOutputStart?: (generationId: string, responseId: string, sampleRate: number, format: string) => void
	onAudioChunk?: (generationId: string, seq: number, base64Data: string) => void
	onAudioOutputEnd?: (generationId: string, responseId: string) => void
	onResponseDone?: (generationId: string, status: string) => void
	onCancelled?: (generationId: string) => void
	onResponseStatus?: (generationId: string, generationStatus: string, playbackStatus: string) => void
}

export class MasterWS {
	private socketTask: any = null
	private callbacks: MasterWSCallbacks
	private connected = false
	private reconnectAttempts = 0
	private maxReconnect = 3
	private manuallyClosed = false
	// 旅程参数:非空时 session_start 固定携带 moxiang_journey。
	private journeySubject: ProfileSubject | null = null
	private journeyConsentVersion = ''
	// 实时语音 v2:connect 前调用 enableRealtimeV2() 后 session_start
	// 携带 protocolVersion=2 与 pcmPlayback 能力声明;未协商成功自动回退 v1。
	private protocolV2 = false

	constructor(callbacks: MasterWSCallbacks) {
		this.callbacks = callbacks
	}

	enableRealtimeV2() {
		this.protocolV2 = true
	}

	isRealtimeV2() : boolean {
		return this.protocolV2
	}

	/**
	 * ProfileSubject is a compile-time union, but WebSocket payloads and calls
	 * crossing the UTS/JS boundary are runtime values. Keep the wire contract
	 * fail-closed so an unknown subject can never be assigned to either portrait.
	 */
	private isSupportedSubject(raw: any): boolean {
		const value = String(raw != null ? raw : '')
		return value == 'personal' || value == 'ideal_partner'
	}

	private reportInvalidSubject() {
		this.callbacks.onError?.('AI_INPUT_INVALID', '画像主体非法')
	}

	connect(): boolean {
		this.manuallyClosed = false
		const token = getAccessToken()
		if (token == '') {
			this.callbacks.onError?.('AUTH_REQUIRED', '未登录,请先登录')
			return false
		}
		const url = buildWsUrl('/voice/moxiang-master', token)
		debugLog('[MasterWS] connecting /voice/moxiang-master')
		this.socketTask = uni.connectSocket({
			url: url,
			success: () => {},
			fail: (err: any) => {
				console.error('❌ [MasterWS] connect failed', err)
				this.callbacks.onError?.('WS_CONNECT_FAILED', '连接失败')
			}
		})
		this.bindEvents()
		return true
	}

	private bindEvents() {
		if (this.socketTask == null) return
		this.socketTask.onOpen(() => {
			debugLog('[MasterWS] connected')
			this.connected = true
			this.reconnectAttempts = 0
			this.sendSessionStart()
		})
		this.socketTask.onMessage((res: any) => {
			this.handleMessage(res.data)
		})
		this.socketTask.onClose(() => {
			debugLog('[MasterWS] closed')
			this.connected = false
			if (!this.manuallyClosed && this.reconnectAttempts < this.maxReconnect) {
				this.reconnectAttempts++
				debugLog('[MasterWS] reconnecting attempt', this.reconnectAttempts)
				setTimeout(() => {
					if (!this.manuallyClosed) {
						this.connect()
					}
				}, 1000 * this.reconnectAttempts)
			} else {
				this.callbacks.onClose?.()
			}
		})
		this.socketTask.onError((err: any) => {
			console.error('❌ [MasterWS] error', err)
			this.callbacks.onError?.('WS_ERROR', '连接异常')
		})
	}

// 进入墨相师新旅程;onOpen 与重连会自动重放同一主体。
startJourneyMode(subject: ProfileSubject, consentVersion: string) {
	if (!this.isSupportedSubject(subject)) {
		this.reportInvalidSubject()
		return
	}
	this.journeySubject = subject
	this.journeyConsentVersion = consentVersion
	if (this.connected) {
		this.sendSessionStart()
	}
}

switchSubject(subject: ProfileSubject) {
	if (!this.isSupportedSubject(subject)) {
		this.reportInvalidSubject()
		return
	}
	if (!this.connected || this.journeySubject == null) return
	this.send({ type: 'subject_switch', subject: subject })
}

private sendSessionStart() {
	if (this.journeySubject != null) {
		if (this.protocolV2) {
			this.send({
				type: 'session_start',
				mode: 'moxiang_journey',
				subject: this.journeySubject,
				consentVersion: this.journeyConsentVersion,
				protocolVersion: 2,
				capabilities: { pcmPlayback: true }
			})
		} else {
			this.send({
				type: 'session_start',
				mode: 'moxiang_journey',
				subject: this.journeySubject,
				consentVersion: this.journeyConsentVersion
			})
		}
	} else {
		this.send({ type: 'session_start' })
	}
}

// ===== Phase 1 Contract v1.1 P1-D:构建邀请 =====
// 接受邀请:服务端回执前不卸载邀请卡(契约 §8);相同 invite 重复 accept 回放同一成功结果
acceptBuildInvite(subject: ProfileSubject, inviteId: string) {
	if (!this.isSupportedSubject(subject)) {
		this.reportInvalidSubject()
		return
	}
	if (inviteId == '') return
	this.send({ type: 'build_invite_accept', subject: subject, invite_id: inviteId })
}

// 暂缓邀请:服务端以"snooze 处理 时"的有效轮次计数 +3 作为再次邀请的阈值
snoozeBuildInvite(subject: ProfileSubject, inviteId: string) {
	if (!this.isSupportedSubject(subject)) {
		this.reportInvalidSubject()
		return
	}
	if (inviteId == '') return
	this.send({ type: 'build_invite_snooze', subject: subject, invite_id: inviteId })
}

	private handleMessage(data: any) {
		let msg: any = null
		try {
			if (typeof data == 'string') {
				msg = JSON.parse(data)
			} else {
				msg = data
			}
		} catch (e) {
			console.error('❌ [MasterWS] parse message failed', e)
			return
		}
		if (msg == null || msg.type == null) return
		const type = String(msg.type)
		switch (type) {
			case 'session_ready':
				{
					const sessionId = String(msg.session_id != null ? msg.session_id : '')
					const subject = this.parseSubject(msg.subject)
					this.callbacks.onSessionReady?.(
						sessionId,
						subject == null ? undefined : subject,
						msg.resumed === true,
						msg.new_session === true
					)
				}
				break
			case 'subject_changed': {
				const subject = this.parseSubject(msg.subject)
				if (subject == null) {
					this.reportInvalidSubject()
					break
				}
				this.journeySubject = subject
				this.callbacks.onSubjectChanged?.(
					subject,
					String(msg.session_id != null ? msg.session_id : ''),
					msg.resumed === true,
					msg.new_session === true
				)
				break
			}
			case 'partial_transcript':
				this.callbacks.onPartialTranscript?.(String(msg.text != null ? msg.text : ''))
				break
			case 'final_transcript':
				this.callbacks.onFinalTranscript?.(String(msg.text != null ? msg.text : ''))
				break
			case 'ai_thinking':
				this.callbacks.onAIThinking?.()
				break
			case 'ai_content':
				this.callbacks.onAIContent?.(String(msg.text != null ? msg.text : ''))
				break
			case 'ai_reply':
				this.callbacks.onAIReply?.(
					String(msg.text != null ? msg.text : ''),
					msg.opening === true,
					msg.generation_id != null ? String(msg.generation_id) : undefined
				)
				break
			case 'tts_audio':
				this.callbacks.onTTSAudio?.(
					String(msg.audio_url != null ? msg.audio_url : ''),
					Number(msg.duration_ms != null ? msg.duration_ms : 0)
				)
				break
			case 'error': {
				const code = String(msg.code != null ? msg.code : 'UNKNOWN')
				const message = String(msg.message != null ? msg.message : MASTER_ROLE_NAME + '对话出错')
				// onError 保持既有签名（向后兼容）；onTypedError 额外提供分类，
				// 使消费方能按 docs/api/语音.md §4 区分「授权已撤回」与「稍后重试」。
				this.callbacks.onError?.(code, message)
				this.callbacks.onTypedError?.(classifyMasterWSError(code), code, message)
				break
			}
			case 'extraction_status':
				this.handleExtractionStatus(msg)
				break
			case 'journey_progress':
				this.handleJourneyProgress(msg)
				break
			case 'confirm_card':
				this.handleConfirmCard(msg)
				break
			case 'publish_ready':
				{
					const subject = this.parseSubject(msg.subject)
					if (subject == null) {
						this.reportInvalidSubject()
						break
					}
					this.callbacks.onPublishReady?.(
						subject,
						String(msg.summary != null ? msg.summary : '')
					)
				}
				break
			// ===== Phase 1 Contract v1.1 P1-D:墨相师新旅程事件 =====
			case 'journey_ready':
				this.handleJourneyReady(msg)
				break
			case 'build_invite':
				this.handleBuildInvite(msg)
				break
			case 'build_invite_resolved':
				this.handleBuildInviteResolved(msg)
				break
			// ===== 实时语音 v2 事件 =====
			case 'voice_ready':
				this.callbacks.onVoiceReady?.()
				break
			case 'input_closed':
				this.callbacks.onInputClosed?.()
				break
			case 'audio_output_start':
				this.callbacks.onAudioOutputStart?.(
					String(msg.generation_id != null ? msg.generation_id : ''),
					String(msg.response_id != null ? msg.response_id : ''),
					Number(msg.sample_rate != null ? msg.sample_rate : 0),
					String(msg.format != null ? msg.format : 'pcm_s16le')
				)
				break
			case 'audio_chunk':
				this.callbacks.onAudioChunk?.(
					String(msg.generation_id != null ? msg.generation_id : ''),
					Number(msg.seq != null ? msg.seq : 0),
					String(msg.data != null ? msg.data : '')
				)
				break
			case 'audio_output_end':
				this.callbacks.onAudioOutputEnd?.(
					String(msg.generation_id != null ? msg.generation_id : ''),
					String(msg.response_id != null ? msg.response_id : '')
				)
				break
			case 'response_done':
				this.callbacks.onResponseDone?.(
					String(msg.generation_id != null ? msg.generation_id : ''),
					String(msg.status != null ? msg.status : 'failed')
				)
				break
			case 'cancelled':
				this.callbacks.onCancelled?.(
					String(msg.generation_id != null ? msg.generation_id : '')
				)
				break
			case 'response_status':
				this.callbacks.onResponseStatus?.(
					String(msg.generation_id != null ? msg.generation_id : ''),
					String(msg.generation_status != null ? msg.generation_status : ''),
					String(msg.playback_status != null ? msg.playback_status : '')
				)
				break
		}
	}

	private parseSubject(raw: any): ProfileSubject | null {
		const value = String(raw != null ? raw : '')
		if (value == 'ideal_partner') return 'ideal_partner'
		if (value == 'personal') return 'personal'
		return null
	}

	private parseJourneyStage(raw: any): JourneyStage {
		const value = String(raw != null ? raw : '')
		if (value == 'building' || value == 'ready' || value == 'published') return value
		return 'chatting'
	}

	// {"type":"journey_ready","subject":"personal","session_id":"s-...","journey_stage":"chatting","resumed":true,"protocol_version":2}
	private handleJourneyReady(msg: any) {
		const subject = this.parseSubject(msg.subject)
		if (subject == null) {
			this.reportInvalidSubject()
			return
		}
		const sessionId = String(msg.session_id != null ? msg.session_id : '')
		const stage = this.parseJourneyStage(msg.journey_stage)
		const resumed = msg.resumed === true
		const protocolVersion = Number(msg.protocol_version != null ? msg.protocol_version : 1)
		this.callbacks.onJourneyReady?.(subject, sessionId, stage, resumed, protocolVersion)
	}

	// {"type":"build_invite","subject":"personal","invite_id":"invite-...","summary_items":[...],"effective_turn_count":4,"dimension_count":3,"candidate_count":3}
	private handleBuildInvite(msg: any) {
		const subject = this.parseSubject(msg.subject)
		if (subject == null) {
			this.reportInvalidSubject()
			return
		}
		const rawItems: any[] = msg.summary_items != null ? (msg.summary_items as any[]) : []
		const items: BuildInviteSummaryItem[] = []
		for (let i = 0; i < rawItems.length; i++) {
			const it = rawItems[i]
			items.push({
				profile_dimension: String(it.profile_dimension != null ? it.profile_dimension : ''),
				content: String(it.content != null ? it.content : '')
			})
		}
		const payload: BuildInvitePayload = {
			subject: subject,
			invite_id: String(msg.invite_id != null ? msg.invite_id : ''),
			summary_items: items,
			effective_turn_count: Number(msg.effective_turn_count != null ? msg.effective_turn_count : 0),
			dimension_count: Number(msg.dimension_count != null ? msg.dimension_count : 0),
			candidate_count: Number(msg.candidate_count != null ? msg.candidate_count : 0),
			journey_stage: this.parseJourneyStage(msg.journey_stage)
		}
		this.callbacks.onBuildInvite?.(payload)
	}

	// {"type":"build_invite_resolved","subject":"personal","invite_id":"invite-...","resolution":"accepted","journey_stage":"building"}
	private handleBuildInviteResolved(msg: any) {
		const subject = this.parseSubject(msg.subject)
		if (subject == null) {
			this.reportInvalidSubject()
			return
		}
		const value = String(msg.resolution != null ? msg.resolution : '')
		const resolution: 'accepted' | 'snoozed' = value == 'snoozed' ? 'snoozed' : 'accepted'
		const resolved: BuildInviteResolution = {
			subject: subject,
			invite_id: String(msg.invite_id != null ? msg.invite_id : ''),
			resolution: resolution,
			journey_stage: this.parseJourneyStage(msg.journey_stage)
		}
		this.callbacks.onBuildInviteResolved?.(resolved)
	}

	private handleExtractionStatus(msg: any) {
		const subject = this.parseSubject(msg.subject)
		if (subject == null) {
			this.reportInvalidSubject()
			return
		}
		const rawStatus = String(msg.status != null ? msg.status : '')
		const status: 'queued' | 'processing' | 'completed' | 'failed' =
			rawStatus == 'processing' || rawStatus == 'completed' || rawStatus == 'failed'
				? rawStatus as 'processing' | 'completed' | 'failed'
				: 'queued'
		this.callbacks.onExtractionStatus?.({
			subject: subject,
			taskId: String(msg.task_id != null ? msg.task_id : ''),
			status: status,
		})
	}

	private handleJourneyProgress(msg: any) {
		const subject = this.parseSubject(msg.subject)
		if (subject == null) {
			this.reportInvalidSubject()
			return
		}
		const rawDimensions: any = msg.dimensions != null ? msg.dimensions : {}
		const dimensions: { [key: string]: JourneyDimensionProgress } = {}
		for (const key in rawDimensions) {
			const item = rawDimensions[key]
			dimensions[key] = {
				percent: Number(item?.percent != null ? item.percent : 0),
				evidenceCount: Number(item?.evidence_count != null ? item.evidence_count : 0),
			}
		}
		this.callbacks.onJourneyProgress?.({
			subject: subject,
			overallPercent: Number(msg.overall_percent != null ? msg.overall_percent : 0),
			dimensions: dimensions,
		})
	}

	// 确认卡片推送:{"type":"confirm_card","card_id":"c-...","draft_id":"d-...","expected_revision":3,"items":[...]}
	private handleConfirmCard(msg: any) {
		const subject = this.parseSubject(msg.subject)
		if (subject == null) {
			this.reportInvalidSubject()
			return
		}
		const rawItems: any[] = msg.items != null ? (msg.items as any[]) : []
		const items: ConfirmCardItem[] = []
		for (let i = 0; i < rawItems.length; i++) {
			const it = rawItems[i]
			const item: ConfirmCardItem = {
				fieldKey: String(it.field_key != null ? it.field_key : ''),
				kind: String(it.kind != null ? it.kind : ''),
				category: String(it.category != null ? it.category : ''),
				content: String(it.content != null ? it.content : ''),
				displayValue: String(it.display_value != null ? it.display_value : '')
			}
			items.push(item)
		}
		const card: ConfirmCardPayload = {
			subject: subject,
			cardId: String(msg.card_id != null ? msg.card_id : ''),
			draftId: String(msg.draft_id != null ? msg.draft_id : ''),
			expectedRevision: Number(msg.expected_revision != null ? msg.expected_revision : 0),
			items: items
		}
		this.callbacks.onConfirmCard?.(card)
	}

	// ===== 文字模式 =====
	sendTextMessage(text: string) {
		// clientTurnId 供后端识别/对账同一轮次(时间戳+随机数)
		const clientTurnId = '' + Date.now() + '-' + Math.floor(Math.random() * 1000000)
		this.send({ type: 'text_message', text: text, clientTurnId: clientTurnId })
	}

	// ===== 语音模式 =====
	sendAudioStart() {
		this.send({ type: 'audio_start' })
	}

	sendAudioChunk(base64Data: string, seq: number) {
		this.send({ type: 'audio_chunk', data: base64Data, seq: seq })
	}

	sendAudioEnd() {
		this.send({ type: 'audio_end' })
	}

	// 请求 TTS 播报最新回复
	sendListen() {
		this.send({ type: 'listen' })
	}

	// 编辑转写文本重新生成
	sendReviseText(text: string) {
		this.send({ type: 'revise_text', text: text })
	}

	sendCancel() {
		this.send({ type: 'cancel' })
	}

	// ===== 实时语音 v2 =====
	// 客户端真实开麦:绑定本轮发言的幂等身份(后端以此落库去重)
	sendVoiceInputBegin(clientTurnId: string) {
		this.send({ type: 'voice_input_begin', client_turn_id: clientTurnId })
	}

	// 点击打断:立即作废当前回复世代(后端退役上游并重建)
	sendInterrupt(generationId: string) {
		this.send({ type: 'interrupt', generation_id: generationId })
	}

	// 播放进度回执(节流由页面控制,建议 ≥500ms)
	sendPlaybackProgress(generationId: string, playedMs: number) {
		this.send({ type: 'playback_progress', generation_id: generationId, played_ms: playedMs })
	}

	// 播放完成/打断回执:completed | interrupted | failed
	sendPlaybackFinished(generationId: string, status: string, playedMs: number) {
		this.send({ type: 'playback_finished', generation_id: generationId, status: status, played_ms: playedMs })
	}

	private send(msg: any) {
		if (!this.connected || this.socketTask == null) return
		try {
			this.socketTask.send({ data: JSON.stringify(msg) })
		} catch (e) {
			console.error('❌ [MasterWS] send failed', e)
		}
	}

	disconnect() {
		this.manuallyClosed = true
		this.connected = false
		if (this.socketTask != null) {
			try {
				this.socketTask.close({})
			} catch (e) {}
			this.socketTask = null
		}
	}

	isConnected(): boolean {
		return this.connected
	}
}
