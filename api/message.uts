/**
 * 消息相关 API
 * 新接口提供分页、权限与已读闭环；旧导出继续保留供既有调用方兼容。
 */

import { request } from './request.uts'
import { CURRENT_USER_ID_KEY, resolveMediaUrl } from './config.uts'
import {
  getMockConversationPage,
  getMockApplicationPage,
  getMockChatPermission,
  markAllMockMessagesRead,
  handleMockApplication,
  getMockChatMessages,
  sendMockMessage,
  revokeMockMessage,
  getMockContactExchanges,
  createMockContactExchange,
  respondMockContactExchange
} from '@/mock/message.uts'

const DEFAULT_PEER_AVATAR = '/static/portraits/profile-woman-main.webp'
const DEFAULT_ME_AVATAR = '/static/portraits/profile-man-light.webp'
/** 消息切片独立使用可变 Mock，避免受全局联调开关影响。 */
/** 普通用户消息中心与普通文字聊天使用 FastAPI；父母端仍由 subject fail-closed 保护。 */
export const MESSAGE_USE_MOCK = false
export const CHAT_USE_MOCK = false
/** 联系方式交换尚未有对应 FastAPI 路由，继续隔离在本地 Mock。 */
export const CONTACT_EXCHANGE_USE_MOCK = true
export const CHAT_MEDIA_USE_MOCK = true

export type MessageSubject = {
  mode: 'self' | 'parent'
  childId?: number
}

function okResponse(data: any): any {
  return {
    success: true,
    data: data,
    code: 0,
    message: 'success'
  }
}

function failResponse(message: string, code: any = -1, data: any = null): any {
  return {
    success: false,
    data: data,
    code: code,
    message: message
  }
}

/** Cloud-function failures reject while HTTP/Mock resolve; normalize both for fail-closed UI handling. */
async function messageRequest(options: any) {
  try {
    return await request(options)
  } catch (error: any) {
    return failResponse(
      error != null && error.message != null ? '' + error.message : '请求失败',
      error != null && error.code != null ? error.code : -1,
      error != null && error.data != null ? error.data : null
    )
  }
}

/** 将 HTTP 200 内的业务失败提升为统一失败，避免页面误判成功。 */
function normalizeBusinessResponse(res: any): any {
  if (res == null) return failResponse('请求失败')
  if (res.success != true) return res
  const data = res.data
  if (data != null && data.success === false) {
    return failResponse(
      data.message != null ? '' + data.message : '操作失败',
      data.code != null ? data.code : -1,
      data
    )
  }
  return res
}

function businessData(res: any): any {
  if (
    res != null &&
    res.data != null &&
    res.data.success == true &&
    res.data.data != null
  ) return res.data.data
  return res != null ? res.data : null
}

function normalizePageResponse(res: any, fallback: string): any {
  if (res == null || res.success != true) return res
  const data = businessData(res)
  if (
    data == null ||
    (!Array.isArray(data.list) && !Array.isArray(data.items))
  ) {
    return failResponse(fallback, 'INVALID_PAGE_RESPONSE', data)
  }
  return okResponse(data)
}

const PROTECTED_MEDIA_FIELDS: string[] = [
  'url',
  'src',
  'path',
  'imageUrl',
  'thumbnailUrl',
  'fileUrl',
  'attachmentUrl',
  'mediaUrl',
  'audioUrl',
  'videoUrl',
  'downloadUrl',
  'resourceUrl',
  'photoUrl',
  'avatarUrl',
  'preview',
  'previewUrl',
  'cover',
  'coverUrl',
  'poster',
  'posterUrl',
  'image_url',
  'thumbnail_url',
  'file_url',
  'attachment_url',
  'media_url',
  'audio_url',
  'video_url',
  'download_url',
  'resource_url',
  'photo_url',
  'avatar_url',
  'preview_url',
  'cover_url',
  'poster_url'
]

const PROTECTED_MEDIA_OBJECT_FIELDS: string[] = [
  'image',
  'file',
  'attachment',
  'attachments',
  'media',
  'files',
  'resource',
  'resources'
]

function normalizeProtectedKey(key: any): any {
  if (key == null) return ''
  return String(key).toLowerCase().split('_').join('').split('-').join('')
}

function isProtectedIdentityField(key: any): boolean {
  const normalized = normalizeProtectedKey(key)
  return normalized == 'avatar' ||
    normalized == 'avatarurl' ||
    normalized == 'clearavatar' ||
    normalized == 'senderavatar' ||
    normalized == 'receiveravatar' ||
    normalized == 'photo' ||
    normalized == 'photourl' ||
    normalized == 'clearphoto' ||
    normalized == 'portrait' ||
    normalized == 'portraiturl' ||
    normalized == 'headimage' ||
    normalized == 'headimageurl' ||
    normalized == 'profileimage' ||
    normalized == 'profileimageurl' ||
    normalized == 'photos' ||
    normalized == 'gallery' ||
    normalized == 'album' ||
    normalized == 'avatars'
}

function isProtectedMediaField(key: any): boolean {
  const normalized = normalizeProtectedKey(key)
  return normalized == 'url' ||
    normalized == 'src' ||
    normalized == 'path' ||
    normalized == 'imageurl' ||
    normalized == 'thumbnailurl' ||
    normalized == 'fileurl' ||
    normalized == 'attachmenturl' ||
    normalized == 'mediaurl' ||
    normalized == 'audiourl' ||
    normalized == 'videourl' ||
    normalized == 'downloadurl' ||
    normalized == 'resourceurl' ||
    normalized == 'preview' ||
    normalized == 'previewurl' ||
    normalized == 'cover' ||
    normalized == 'coverurl' ||
    normalized == 'poster' ||
    normalized == 'posterurl' ||
    normalized == 'thumbnail'
}

function isProtectedMediaObjectField(key: any): boolean {
  const normalized = normalizeProtectedKey(key)
  return normalized == 'image' ||
    normalized == 'file' ||
    normalized == 'attachment' ||
    normalized == 'attachments' ||
    normalized == 'media' ||
    normalized == 'files' ||
    normalized == 'resource' ||
    normalized == 'resources'
}

function looksLikeMediaUrl(value: any): boolean {
  if (typeof value != 'string' || value == '') return false
  const normalized = value.trim().toLowerCase()
  return normalized.indexOf('://') >= 0 ||
    normalized.indexOf('data:') == 0 ||
    normalized.indexOf('blob:') == 0 ||
    normalized.indexOf('file:') == 0 ||
    normalized.indexOf('wxfile:') == 0 ||
    normalized.indexOf('/') == 0 ||
    normalized.indexOf('./') == 0 ||
    normalized.indexOf('../') == 0 ||
    normalized.indexOf('private/') == 0 ||
    normalized.indexOf('media/') == 0 ||
    normalized.indexOf('images/') == 0 ||
    normalized.indexOf('photos/') == 0 ||
    normalized.indexOf('uploads/') == 0 ||
    normalized.indexOf('assets/') == 0 ||
    normalized.indexOf('static/') == 0 ||
    normalized.indexOf('.jpg') >= 0 ||
    normalized.indexOf('.jpeg') >= 0 ||
    normalized.indexOf('.png') >= 0 ||
    normalized.indexOf('.webp') >= 0 ||
    normalized.indexOf('.gif') >= 0 ||
    normalized.indexOf('.heic') >= 0 ||
    normalized.indexOf('.mp3') >= 0 ||
    normalized.indexOf('.wav') >= 0 ||
    normalized.indexOf('.mp4') >= 0 ||
    normalized.indexOf('.mov') >= 0
}

/**
 * Protected responses are recursively scrubbed so future schema additions cannot
 * accidentally expose clear identity or media URLs. Text, status and identifiers
 * remain available to the page.
 */
function sanitizeProtectedValue(value: any, key: any = ''): any {
  if (value == null) return value
  if (isProtectedIdentityField(key) || isProtectedMediaField(key)) {
    return typeof value == 'string' ? '' : null
  }
  if (isProtectedMediaObjectField(key)) return null
  if (typeof value == 'string') return looksLikeMediaUrl(value) ? '' : value
  if (Array.isArray(value)) {
    const sanitizedList: any[] = []
    for (let i = 0; i < value.length; i++) {
      sanitizedList.push(sanitizeProtectedValue(value[i], ''))
    }
    return sanitizedList
  }
  if (typeof value == 'object') {
    const sanitizedObject: any = {}
    const keys = Object.keys(value)
    for (let i = 0; i < keys.length; i++) {
      const childKey = keys[i]
      sanitizedObject[childKey] = sanitizeProtectedValue(value[childKey], childKey)
    }
    return sanitizedObject
  }
  return value
}

function protectSubjectResponse(response: any, subjectContext: any): any {
  if (subjectContext == null || subjectContext.mode != 'parent' || response == null) return response
  return sanitizeProtectedValue(response, '')
}

function isIdentityContainerField(key: any): boolean {
  const normalized = normalizeProtectedKey(key)
  return normalized == 'sender' ||
    normalized == 'receiver' ||
    normalized == 'author' ||
    normalized == 'peer' ||
    normalized == 'profile' ||
    normalized == 'owner' ||
    normalized == 'actor'
}

function hasProtectedPayload(value: any, key: any = '', identityContainer: boolean = false): boolean {
  if (value == null) return false
  const insideIdentity = identityContainer || isIdentityContainerField(key)
  if (isProtectedIdentityField(key)) return false
  if (!insideIdentity && (isProtectedMediaField(key) || isProtectedMediaObjectField(key))) return true
  if (typeof value == 'string') return !insideIdentity && looksLikeMediaUrl(value)
  if (Array.isArray(value)) {
    for (let i = 0; i < value.length; i++) {
      if (hasProtectedPayload(value[i], '', insideIdentity)) return true
    }
    return false
  }
  if (typeof value == 'object') {
    const keys = Object.keys(value)
    for (let i = 0; i < keys.length; i++) {
      const childKey = keys[i]
      if (hasProtectedPayload(value[childKey], childKey, insideIdentity)) return true
    }
  }
  return false
}

function hasProtectedMessageContent(item: any): boolean {
  if (item == null) return false
  const type = item.type != null ? String(item.type).toLowerCase() : ''
  if (type != '' && type != 'text') return true
  if (item.content != null && typeof item.content != 'string') return true
  if (looksLikeMediaUrl(item.content)) return true
  const keys = Object.keys(item)
  for (let i = 0; i < keys.length; i++) {
    const field = keys[i]
    if (field == 'content' || isProtectedIdentityField(field)) continue
    if (hasProtectedPayload(item[field], field, false)) return true
  }
  return false
}

function protectAvatarList(list: any[]): any[] {
  const protectedList: any[] = []
  for (let i = 0; i < list.length; i++) {
    const item = list[i]
    if (item == null) continue
    const sanitizedItem = sanitizeProtectedValue(item, '')
    protectedList.push({
      ...sanitizedItem,
      avatar: '',
      avatarUrl: '',
      avatar_url: '',
      photoUrl: '',
      photo_url: '',
      clearAvatar: '',
      senderAvatar: '',
      receiverAvatar: '',
      protectedAvatar: true
    })
  }
  return protectedList
}

/** Protected chat responses must never retain avatar or attachment URLs. */
function protectMessageList(list: any[]): any[] {
  const protectedList: any[] = []
  for (let i = 0; i < list.length; i++) {
    const item = list[i]
    if (item == null) continue
    const protectedContent = hasProtectedMessageContent(item)
    const sanitizedItem = sanitizeProtectedValue(item, '')
    const protectedItem: any = {
      ...sanitizedItem,
      avatar: '',
      avatarUrl: '',
      avatar_url: '',
      photoUrl: '',
      photo_url: '',
      clearAvatar: '',
      senderAvatar: '',
      receiverAvatar: '',
      protectedAvatar: true,
      protectedContent: protectedContent,
      content: protectedContent ? '' : item.content
    }
    for (let j = 0; j < PROTECTED_MEDIA_FIELDS.length; j++) {
      protectedItem[PROTECTED_MEDIA_FIELDS[j]] = ''
    }
    for (let j = 0; j < PROTECTED_MEDIA_OBJECT_FIELDS.length; j++) {
      protectedItem[PROTECTED_MEDIA_OBJECT_FIELDS[j]] = null
    }
    protectedList.push(protectedItem)
  }
  return protectedList
}

function protectSendResult(result: any): any {
  if (result == null) return result
  const protectedResult = sanitizeProtectedValue(result, '')
  if (result.message != null && typeof result.message == 'object') {
    const messages = protectMessageList([result.message])
    protectedResult.message = messages.length > 0 ? messages[0] : null
  }
  return protectedResult
}

function protectApplicationResult(result: any): any {
  if (result == null) return result
  const protectedResult = sanitizeProtectedValue(result, '')
  if (result.application != null) {
    const applications = protectAvatarList([result.application])
    protectedResult.application = applications.length > 0 ? applications[0] : null
  }
  if (result.conversation != null) {
    const conversations = protectAvatarList([result.conversation])
    protectedResult.conversation = conversations.length > 0 ? conversations[0] : null
  }
  return protectedResult
}

function protectPageAvatars(page: any, privacyScope: string): any {
  if (privacyScope != 'protected' || page == null || !Array.isArray(page.list)) return page
  page.list = protectAvatarList(page.list as any[])
  return page
}

function isPositiveInteger(value: number): boolean {
  return Number.isFinite(value) && Math.floor(value) == value && value > 0
}

function resolveMessageSubject(subject: MessageSubject | null = null): any {
  if (subject == null) {
    return { valid: true, mode: 'self', childId: null, key: 'self' }
  }
  if (subject.mode == 'self') {
    return { valid: true, mode: 'self', childId: null, key: 'self' }
  }
  if (subject.mode != 'parent') {
    return { valid: false, message: '无效的消息主体', code: 'INVALID_MESSAGE_SUBJECT' }
  }
  const childId = subject.childId != null ? subject.childId : 0
  if (!isPositiveInteger(childId)) {
    return { valid: false, message: '父母消息主体缺少有效子女授权', code: 'ACTING_CHILD_REQUIRED' }
  }
  return { valid: true, mode: 'parent', childId: childId, key: 'parent:' + childId }
}

function messageSubjectFailure(subjectContext: any): any {
  return failResponse(subjectContext.message, subjectContext.code)
}

/** Parent acting-subject APIs remain Mock-only until their audited backend exists. */
function parentBackendUnavailable(subjectContext: any): any | null {
  if (!MESSAGE_USE_MOCK && subjectContext.mode == 'parent') {
    return failResponse(
      '父母端消息后端尚未开放，不能代子女使用普通用户接口',
      'PARENT_BACKEND_NOT_AVAILABLE'
    )
  }
  return null
}

function effectivePrivacyScope(privacyScope: string, subjectContext: any): string {
  return subjectContext.mode == 'parent' ? 'protected' : privacyScope
}

/**
 * The subject fields are claims only. The real message service must authenticate
 * the parent account and authorize actingChildId for every read and mutation.
 */
function appendMessageSubject(data: any, subjectContext: any): any {
  data.subjectMode = subjectContext.mode
  data.actingChildId = subjectContext.mode == 'parent' ? subjectContext.childId : null
  return data
}

function normalizedPageSize(value: number): number {
  if (!Number.isFinite(value) || value <= 0) return 20
  return Math.min(Math.floor(value), 50)
}

function normalizeCommandResponse(res: any, fallback: string, code: string): any {
  if (res == null || res.success != true) return res
  const data = businessData(res)
  if (data == null || data.success != true) {
    if (data != null && data.success == false) {
      return failResponse(
        data.message != null ? '' + data.message : fallback,
        data.code != null ? data.code : code,
        data
      )
    }
    return failResponse(fallback, code, data)
  }
  return okResponse(data)
}

function normalizeApplicationResult(result: any, action: string): any {
  const expectedStatus = action == 'accept' ? 'accepted' : 'rejected'
  const expectedCanChat = action == 'accept'
  if (
    result == null ||
    result.success != true ||
    result.application == null ||
    result.application.status != expectedStatus ||
    typeof result.canChat != 'boolean' ||
    result.canChat != expectedCanChat
  ) {
    return failResponse('申请处理响应无效', 'INVALID_APPLICATION_RESPONSE', result)
  }
  return okResponse(result)
}

function pageNumberFromCursor(cursor: string): number {
  const parsed = Number(cursor)
  return Number.isFinite(parsed) && Math.floor(parsed) == parsed && parsed > 0 ? parsed : 1
}

function mapConversationItem(item: any): any {
  const target = item != null && item.target != null ? item.target : {}
  const sessionId = Number(item != null && item.id != null ? item.id : 0)
  return {
    id: sessionId,
    sessionId: sessionId,
    userId: Number(target.user_id != null ? target.user_id : 0),
    name: target.nickname != null && target.nickname != '' ? '' + target.nickname : '用户',
    avatar: target.avatar != null ? resolveMediaUrl(target.avatar) : '',
    lastMessage: item != null && item.last_message != null ? '' + item.last_message : '',
    time: item != null && item.last_message_time != null ? '' + item.last_message_time : '',
    unreadCount: Number(item != null && item.unread_count != null ? item.unread_count : 0),
    pinned: item != null && item.pinned == true,
    online: false,
    messageType: 'text'
  }
}

function applicationStatus(value: any): string {
  const status = Number(value)
  if (status == 1) return 'accepted'
  if (status == 2) return 'rejected'
  if (status == 3) return 'expired'
  return 'pending'
}

function applicationStatusText(status: string): string {
  if (status == 'accepted') return '已同意'
  if (status == 'rejected') return '已拒绝'
  if (status == 'expired') return '已过期'
  return '待处理'
}

function mapApplicationItem(item: any, direction: string): any {
  const incoming = direction == 'incoming'
  const user = incoming
    ? (item != null && item.from_user != null ? item.from_user : {})
    : (item != null && item.to_user != null ? item.to_user : {})
  const status = applicationStatus(item != null ? item.status : 0)
  return {
    id: Number(item != null && item.id != null ? item.id : 0),
    userId: Number(incoming
      ? (item != null && item.from_user_id != null ? item.from_user_id : 0)
      : (item != null && item.to_user_id != null ? item.to_user_id : 0)),
    name: user.nickname != null && user.nickname != '' ? '' + user.nickname : '用户',
    avatar: user.avatar != null ? resolveMediaUrl(user.avatar) : '',
    message: item != null && item.message != null && item.message != '' ? '' + item.message : '想和你认真认识',
    status: status,
    statusText: applicationStatusText(status),
    createdAt: item != null && item.created_at != null ? '' + item.created_at : '',
    expireAt: item != null && item.expire_at != null ? '' + item.expire_at : '',
    fromUserId: Number(item != null && item.from_user_id != null ? item.from_user_id : 0),
    toUserId: Number(item != null && item.to_user_id != null ? item.to_user_id : 0)
  }
}

/** 游标分页获取会话。data: { list, nextCursor, hasMore, total, unreadTotal } */
export async function getConversationPage(
  cursor: string = '',
  pageSize: number = 20,
  privacyScope: string = 'standard',
  subject: MessageSubject | null = null
) {
  const subjectContext = resolveMessageSubject(subject)
  if (subjectContext.valid != true) return messageSubjectFailure(subjectContext)
  const parentBackendFailure = parentBackendUnavailable(subjectContext)
  if (parentBackendFailure != null) return parentBackendFailure
  const photoScope = effectivePrivacyScope(privacyScope, subjectContext)
  const size = normalizedPageSize(pageSize)
  if (MESSAGE_USE_MOCK) {
    return protectSubjectResponse(
      okResponse(protectPageAvatars(
        getMockConversationPage(cursor, size, subjectContext.key),
        photoScope
      )),
      subjectContext
    )
  }
  const page = pageNumberFromCursor(cursor)
  const requestData: any = { page: page, page_size: size, photoScope: photoScope }
  appendMessageSubject(requestData, subjectContext)
  const normalized = normalizeBusinessResponse(await messageRequest({
    url: '/chat/sessions',
    method: 'GET',
    data: requestData
  }))
  const pageResponse = normalizePageResponse(normalized, '消息分页响应无效')
  if (pageResponse == null || pageResponse.success != true) {
    return protectSubjectResponse(pageResponse, subjectContext)
  }
  const raw = pageResponse.data
  const rawItems = Array.isArray(raw.items) ? raw.items : []
  const list: any[] = []
  for (let index = 0; index < rawItems.length; index++) {
    const mapped = mapConversationItem(rawItems[index])
    if (!isPositiveInteger(mapped.id) || !isPositiveInteger(mapped.userId)) {
      return protectSubjectResponse(failResponse('会话列表包含无效主体', 'INVALID_CHAT_SESSION', rawItems[index]), subjectContext)
    }
    list.push(mapped)
  }
  const hasMore = raw.has_more == true
  const responseData: any = {
    list: list,
    nextCursor: hasMore ? '' + (page + 1) : '',
    hasMore: hasMore,
    total: raw.total != null ? Number(raw.total) : list.length,
    unreadTotal: raw.unreadTotal != null
      ? Number(raw.unreadTotal)
      : list.reduce((sum: number, item: any) => sum + Number(item.unreadCount || 0), 0)
  }
  protectPageAvatars(responseData, photoScope)
  return protectSubjectResponse(okResponse(responseData), subjectContext)
}

/** 按收到/发出分页获取申请。 */
export async function getApplicationPage(
  direction: string = 'incoming',
  cursor: string = '',
  pageSize: number = 20,
  privacyScope: string = 'standard',
  subject: MessageSubject | null = null
) {
  const subjectContext = resolveMessageSubject(subject)
  if (subjectContext.valid != true) return messageSubjectFailure(subjectContext)
  const parentBackendFailure = parentBackendUnavailable(subjectContext)
  if (parentBackendFailure != null) return parentBackendFailure
  const photoScope = effectivePrivacyScope(privacyScope, subjectContext)
  if (direction != 'incoming' && direction != 'outgoing') {
    return failResponse('不支持的申请方向', 'INVALID_APPLICATION_DIRECTION')
  }
  const size = normalizedPageSize(pageSize)
  if (MESSAGE_USE_MOCK) {
    return protectSubjectResponse(
      okResponse(protectPageAvatars(
        getMockApplicationPage(direction, cursor, size, subjectContext.key),
        photoScope
      )),
      subjectContext
    )
  }
  const page = pageNumberFromCursor(cursor)
  const requestData: any = { page: page, page_size: size }
  appendMessageSubject(requestData, subjectContext)
  const normalized = normalizeBusinessResponse(await messageRequest({
    url: direction == 'incoming' ? '/discovery/applications/incoming' : '/discovery/applications/outgoing',
    method: 'GET',
    data: requestData
  }))
  const pageResponse = normalizePageResponse(normalized, '申请分页响应无效')
  if (pageResponse == null || pageResponse.success != true) {
    return protectSubjectResponse(pageResponse, subjectContext)
  }
  const raw = pageResponse.data
  const rawItems = Array.isArray(raw.items) ? raw.items : []
  const list: any[] = []
  for (let index = 0; index < rawItems.length; index++) {
    const mapped = mapApplicationItem(rawItems[index], direction)
    if (!isPositiveInteger(mapped.id) || !isPositiveInteger(mapped.userId)) {
      return protectSubjectResponse(failResponse('申请列表包含无效主体', 'INVALID_APPLICATION', rawItems[index]), subjectContext)
    }
    list.push(mapped)
  }
  const hasMore = raw.has_more == true
  const pendingCount = direction == 'incoming'
    ? list.filter((item: any) => item.status == 'pending').length
    : 0
  const responseData: any = {
    list: list,
    nextCursor: hasMore ? '' + (page + 1) : '',
    hasMore: hasMore,
    total: raw.total != null ? Number(raw.total) : list.length,
    pendingCount: pendingCount
  }
  protectPageAvatars(responseData, photoScope)
  return protectSubjectResponse(okResponse(responseData), subjectContext)
}


function chatBackendUnavailable(subjectContext: any): any | null {
  if (subjectContext.mode == 'parent') {
    return failResponse('父母端聊天尚未接入当前后端接口', 'PARENT_BACKEND_NOT_AVAILABLE')
  }
  return null
}

/** Resolve a peer to a server-owned chat session; never treat peer IDs as session IDs. */
async function findRealChatSession(targetUserId: number): Promise<any> {
  const pageSize = 50
  for (let page = 1; page <= 1000; page++) {
    const response = normalizeBusinessResponse(await messageRequest({
      url: '/chat/sessions',
      method: 'GET',
      data: { page: page, page_size: pageSize }
    }))
    if (response == null || response.success != true) return response ?? failResponse('聊天会话加载失败', 'CHAT_SESSION_LOOKUP_FAILED')
    const data = businessData(response)
    if (data == null || !Array.isArray(data.items)) return failResponse('聊天会话响应无效', 'INVALID_CHAT_SESSION_PAGE', data)
    for (let index = 0; index < data.items.length; index++) {
      const item = data.items[index]
      const peerId = Number(item?.target?.user_id ?? 0)
      if (peerId != targetUserId) continue
      const sessionId = Number(item?.id ?? 0)
      if (!isPositiveInteger(sessionId)) return failResponse('聊天会话标识无效', 'INVALID_CHAT_SESSION', item)
      return okResponse({ id: sessionId, target: item.target ?? null })
    }
    if (data.has_more != true) break
    if (page == 1000) return failResponse('会话列表超过查询上限，暂时无法定位', 'CHAT_SESSION_LOOKUP_INCOMPLETE')
  }
  return failResponse('双方尚无可用聊天会话', 'SESSION_NOT_FOUND')
}

function currentChatUserId(): number {
  try {
    const value = Number(uni.getStorageSync(CURRENT_USER_ID_KEY))
    return isPositiveInteger(value) ? value : 0
  } catch (error) {
    return 0
  }
}

function chatMessageTypeFromBackend(value: any): string {
  const type = Number(value)
  if (type == 2) return 'image'
  if (type == 3) return 'voice'
  if (type == 4) return 'video'
  return 'text'
}

/** 进入会话和加载详情前均需调用；真实权限由后端可见会话列表裁决。 */
export async function getChatPermission(userId: number, subject: MessageSubject | null = null) {
  const subjectContext = resolveMessageSubject(subject)
  if (subjectContext.valid != true) return messageSubjectFailure(subjectContext)
  if (!isPositiveInteger(userId)) return failResponse('无效的会话用户', 'INVALID_USER')
  if (CHAT_USE_MOCK) {
    const permission = getMockChatPermission(userId, subjectContext.key)
    return typeof permission.canChat == 'boolean'
      ? protectSubjectResponse(okResponse(permission), subjectContext)
      : protectSubjectResponse(failResponse('聊天权限响应无效', 'INVALID_PERMISSION_RESPONSE', permission), subjectContext)
  }
  const unavailable = chatBackendUnavailable(subjectContext)
  if (unavailable != null) return unavailable
  const sessionRes = await findRealChatSession(userId)
  if (sessionRes == null || sessionRes.success != true) {
    if (sessionRes != null && sessionRes.code == 'SESSION_NOT_FOUND') {
      return protectSubjectResponse(okResponse({ canChat: false, reason: '双方尚无可用聊天会话' }), subjectContext)
    }
    return protectSubjectResponse(sessionRes ?? failResponse('聊天权限检查失败', 'CHAT_PERMISSION_FAILED'), subjectContext)
  }
  return protectSubjectResponse(okResponse({ canChat: true, sessionId: Number(sessionRes.data.id) }), subjectContext)
}
/**
 * Resolve the current subject's chat-session ID for one approved conversation.
 * The lookup is intentionally permission-first: a target-user ID must never be
 * treated as a chat-session ID outside the isolated message Mock.
 */
export async function getChatSessionId(
  targetUserId: number,
  subject: MessageSubject | null = null
) {
  const subjectContext = resolveMessageSubject(subject)
  if (subjectContext.valid != true) return messageSubjectFailure(subjectContext)
  if (!isPositiveInteger(targetUserId)) return failResponse('无效的会话用户', 'INVALID_USER')
	if (!CHAT_USE_MOCK) {
		const unavailable = chatBackendUnavailable(subjectContext)
		if (unavailable != null) return unavailable
		const sessionRes = await findRealChatSession(targetUserId)
		if (sessionRes == null || sessionRes.success != true || sessionRes.data == null) {
			return protectSubjectResponse(sessionRes ?? failResponse('当前没有可用聊天会话', 'SESSION_NOT_FOUND'), subjectContext)
		}
		return protectSubjectResponse(okResponse({ id: Number(sessionRes.data.id), target: sessionRes.data.target ?? null }), subjectContext)
	}
  const parentBackendFailure = parentBackendUnavailable(subjectContext)
  if (parentBackendFailure != null) return parentBackendFailure
  if (!isPositiveInteger(targetUserId)) return failResponse('无效的会话用户', 'INVALID_USER')

  const permissionRes = await getChatPermission(targetUserId, subject)
  const permission = permissionRes != null ? permissionRes.data : null
  if (permissionRes == null || permissionRes.success != true) {
    return protectSubjectResponse(
      permissionRes != null ? permissionRes : failResponse('聊天权限检查失败', 'CHAT_PERMISSION_FAILED'),
      subjectContext
    )
  }
  if (permission == null || permission.canChat != true) {
    const reason = permission != null && permission.reason != null
      ? '' + permission.reason
      : '双方同意后才能开始聊天'
    return protectSubjectResponse(failResponse(reason, 'CHAT_NOT_ALLOWED', permission), subjectContext)
  }

  let cursor = ''
  for (let pageIndex = 0; pageIndex < 20; pageIndex++) {
    const pageRes = await getConversationPage(cursor, 50, 'standard', subject)
    if (pageRes == null || pageRes.success != true || pageRes.data == null) {
      return protectSubjectResponse(
        pageRes != null ? pageRes : failResponse('聊天会话加载失败', 'CHAT_SESSION_LOOKUP_FAILED'),
        subjectContext
      )
    }
    const rows = Array.isArray(pageRes.data.list) ? pageRes.data.list as any[] : [] as any[]
    for (let index = 0; index < rows.length; index++) {
      const row = rows[index]
      const rowTargetId = row != null && row.userId != null
        ? Number(row.userId)
        : row != null && row.target != null && row.target.user_id != null
          ? Number(row.target.user_id)
          : 0
      if (rowTargetId != targetUserId) continue
      const sessionId = row.sessionId != null
        ? Number(row.sessionId)
        : row.session_id != null
          ? Number(row.session_id)
          : Number(row.id)
      if (!isPositiveInteger(sessionId)) {
        return protectSubjectResponse(
          failResponse('聊天会话标识无效', 'INVALID_CHAT_SESSION', row),
          subjectContext
        )
      }
      return protectSubjectResponse(okResponse({ id: sessionId }), subjectContext)
    }

    const hasMore = pageRes.data.hasMore == true
    const nextCursor = pageRes.data.nextCursor != null ? String(pageRes.data.nextCursor).trim() : ''
    if (!hasMore) break
    if (nextCursor == '' || nextCursor == cursor) {
      return protectSubjectResponse(
        failResponse('聊天会话分页响应无效', 'INVALID_CHAT_SESSION_PAGE', pageRes.data),
        subjectContext
      )
    }
    cursor = nextCursor
  }
  return protectSubjectResponse(failResponse('当前没有可用聊天会话', 'SESSION_NOT_FOUND'), subjectContext)
}

async function markChatSessionRead(sessionId: number, subjectContext: any): Promise<any> {
  if (!isPositiveInteger(sessionId)) return failResponse('聊天会话标识无效', 'INVALID_CHAT_SESSION')
  const requestData: any = {}
  appendMessageSubject(requestData, subjectContext)
  const response = normalizeBusinessResponse(await messageRequest({
    url: '/chat/sessions/' + sessionId + '/read',
    method: 'POST',
    data: requestData
  }))
  if (response == null || response.success != true) return response ?? failResponse('已读状态更新失败', 'CHAT_READ_FAILED')
  return okResponse({ success: true, sessionId: sessionId })
}

/** 将全部可见会话逐一标为已读；失败时不虚报成功。 */
export async function markAllMessagesRead(subject: MessageSubject | null = null) {
  const subjectContext = resolveMessageSubject(subject)
  if (subjectContext.valid != true) return messageSubjectFailure(subjectContext)
  const parentBackendFailure = parentBackendUnavailable(subjectContext)
  if (parentBackendFailure != null) return parentBackendFailure
  if (MESSAGE_USE_MOCK) {
    return protectSubjectResponse(
      normalizeCommandResponse(
        okResponse(markAllMockMessagesRead(subjectContext.key)),
        '全部已读响应无效',
        'INVALID_READ_ALL_RESPONSE'
      ),
      subjectContext
    )
  }
  let cursor = ''
  let markedCount = 0
  for (let pageIndex = 0; pageIndex < 1000; pageIndex++) {
    const pageRes = await getConversationPage(cursor, 50, 'standard', subject)
    if (pageRes == null || pageRes.success != true || pageRes.data == null) {
      return protectSubjectResponse(pageRes ?? failResponse('消息会话加载失败', 'CHAT_SESSION_LOOKUP_FAILED'), subjectContext)
    }
    const rows = Array.isArray(pageRes.data.list) ? pageRes.data.list as any[] : [] as any[]
    for (let index = 0; index < rows.length; index++) {
      const sessionId = Number(rows[index]?.sessionId ?? rows[index]?.id ?? 0)
      const readRes = await markChatSessionRead(sessionId, subjectContext)
      if (readRes == null || readRes.success != true) {
        return protectSubjectResponse(failResponse('全部已读失败，请重试', 'CHAT_READ_FAILED', readRes), subjectContext)
      }
      markedCount += 1
    }
    const hasMore = pageRes.data.hasMore == true
    if (!hasMore) break
    const nextCursor = pageRes.data.nextCursor != null ? String(pageRes.data.nextCursor).trim() : ''
    if (nextCursor == '' || nextCursor == cursor) {
      return protectSubjectResponse(failResponse('消息会话分页响应无效', 'INVALID_CHAT_SESSION_PAGE', pageRes.data), subjectContext)
    }
    if (pageIndex == 999) {
      return protectSubjectResponse(failResponse('消息会话超过查询上限，请稍后重试', 'CHAT_SESSION_LOOKUP_INCOMPLETE'), subjectContext)
    }
    cursor = nextCursor
  }
  return protectSubjectResponse(okResponse({ success: true, markedCount: markedCount }), subjectContext)
}

/** 旧导出兼容：返回完整会话数组；父母调用方必须请求 protected scope。 */
export async function getMessageList(
  privacyScope: string = 'standard',
  subject: MessageSubject | null = null
) {
  const res = await getConversationPage('', 50, privacyScope, subject)
  if (res.success != true || res.data == null) return res
  return protectSubjectResponse(
    okResponse(res.data.list != null ? res.data.list : []),
    resolveMessageSubject(subject)
  )
}

/** Fetch a real chat history through the authenticated session-scoped FastAPI route. */
export async function getChatMessages(
  userId: number,
  privacyScope: string = 'standard',
  subject: MessageSubject | null = null
) {
  const subjectContext = resolveMessageSubject(subject)
  if (subjectContext.valid != true) return messageSubjectFailure(subjectContext)
  if (!isPositiveInteger(userId)) return failResponse('无效的会话用户', 'INVALID_USER')
  const photoScope = effectivePrivacyScope(privacyScope, subjectContext)
  if (CHAT_USE_MOCK) {
    const permission = getMockChatPermission(userId, subjectContext.key)
    if (permission == null || permission.canChat != true) return failResponse(permission?.reason ?? '双方同意后才能开始聊天', 'CHAT_NOT_ALLOWED')
    const messages = getMockChatMessages(userId, subjectContext.key)
    return protectSubjectResponse(okResponse(photoScope == 'protected' ? protectMessageList(messages) : messages), subjectContext)
  }
  const unavailable = chatBackendUnavailable(subjectContext)
  if (unavailable != null) return unavailable
  const sessionRes = await getChatSessionId(userId, subject)
  if (sessionRes == null || sessionRes.success != true || sessionRes.data == null) return sessionRes
  const sessionId = Number(sessionRes.data.id)
  const response = normalizeBusinessResponse(await messageRequest({
    url: '/chat/sessions/' + sessionId + '/messages',
    method: 'GET',
    data: { page: 1, page_size: 50 }
  }))
  if (response == null || response.success != true) return protectSubjectResponse(response, subjectContext)
  const rows = businessData(response)
  if (!Array.isArray(rows)) return protectSubjectResponse(failResponse('聊天记录响应无效', 'INVALID_CHAT_RESPONSE', rows), subjectContext)
  const currentUserId = currentChatUserId()
  if (!isPositiveInteger(currentUserId)) return protectSubjectResponse(failResponse('登录用户信息已失效，请重新登录', 'AUTH_REQUIRED'), subjectContext)
  const peerAvatar = sessionRes.data.target?.avatar ?? DEFAULT_PEER_AVATAR
  const messages = rows.map((row: any) => {
    const isMine = Number(row?.from_user_id ?? 0) == currentUserId
    const type = chatMessageTypeFromBackend(row?.type)
    const isMedia = type == 'image' || type == 'voice' || type == 'video'
    return {
      id: Number(row?.id ?? 0),
      clientMessageId: String(row?.client_message_id ?? ''),
      type: type,
      content: isMedia ? String(row?.media_url ?? '') : String(row?.content ?? ''),
      time: row?.created_at ?? '',
      showTime: false,
      isMine: isMine,
      avatar: isMine ? DEFAULT_ME_AVATAR : peerAvatar,
      senderAvatar: isMine ? DEFAULT_ME_AVATAR : peerAvatar,
      revoked: row?.revoked === true || row?.is_recalled === true,
      status: isMine ? 'sent' : ''
    }
  })
  const readResponse = await markChatSessionRead(sessionId, subjectContext)
  if (readResponse == null || readResponse.success != true) {
    return protectSubjectResponse(failResponse('聊天记录已加载，但已读状态更新失败，请重试', 'CHAT_READ_FAILED', readResponse), subjectContext)
  }
  return protectSubjectResponse(okResponse(photoScope == 'protected' ? protectMessageList(messages) : messages), subjectContext)
}

/** Send one user-authored message and return a stable UI envelope. */
export async function sendMessage(
  userId: number,
  content: string,
  type: string = 'text',
  clientMessageId: string = '',
  subject: MessageSubject | null = null,
  mediaId: number | null = null
) {
  const subjectContext = resolveMessageSubject(subject)
  if (subjectContext.valid != true) return messageSubjectFailure(subjectContext)
  if (!isPositiveInteger(userId)) return failResponse('无效的会话用户', 'INVALID_USER')
  if (type != 'text' && type != 'image' && type != 'voice' && type != 'video') return failResponse('不支持的消息类型', 'INVALID_MESSAGE_TYPE')
  if (typeof content != 'string' || (type == 'text' && content.trim() == '')) return failResponse('消息内容不能为空', 'EMPTY_MESSAGE')
  if (clientMessageId == null || clientMessageId.trim() == '') return failResponse('缺少消息唯一标识', 'CLIENT_MESSAGE_ID_REQUIRED')
  const resolvedClientMessageId = clientMessageId.trim()
  if (resolvedClientMessageId.length > 128) return failResponse('消息唯一标识过长', 'INVALID_CLIENT_MESSAGE_ID')

  if (CHAT_USE_MOCK) {
    const permissionRes = await getChatPermission(userId, subject)
    const permission = permissionRes != null ? permissionRes.data : null
    if (permissionRes == null || permissionRes.success != true) return permissionRes ?? failResponse('聊天权限检查失败', 'CHAT_PERMISSION_FAILED')
    if (permission == null || permission.canChat != true) return failResponse(permission?.reason ?? '双方同意后才能开始聊天', 'CHAT_NOT_ALLOWED', permission)
    if (type != 'text') return failResponse('Mock 模式不上传本地媒体，请切换真实后端后重试', 'MOCK_MEDIA_UPLOAD_NOT_SUPPORTED')
    const result = sendMockMessage(userId, content, type, resolvedClientMessageId, subjectContext.key)
    if (result.success != true) return protectSubjectResponse(failResponse(result.message, result.code, result), subjectContext)
    return protectSubjectResponse(normalizeCommandResponse(okResponse(result), '发送消息响应无效', 'INVALID_SEND_RESPONSE'), subjectContext)
  }

  const unavailable = chatBackendUnavailable(subjectContext)
  if (unavailable != null) return unavailable
  if (type != 'text') return failResponse('当前真实聊天闭环仅支持文字消息', 'REAL_MEDIA_NOT_SUPPORTED')
  const permissionRes = await getChatPermission(userId, subject)
  const permission = permissionRes != null ? permissionRes.data : null
  if (permissionRes == null || permissionRes.success != true) return protectSubjectResponse(permissionRes ?? failResponse('聊天权限检查失败', 'CHAT_PERMISSION_FAILED'), subjectContext)
  if (permission == null || permission.canChat != true) return protectSubjectResponse(failResponse(permission?.reason ?? '双方同意后才能开始聊天', 'CHAT_NOT_ALLOWED', permission), subjectContext)
  const sessionId = Number(permission.sessionId ?? 0)
  if (!isPositiveInteger(sessionId)) return protectSubjectResponse(failResponse('聊天会话标识无效', 'INVALID_CHAT_SESSION'), subjectContext)

  const response = normalizeBusinessResponse(await messageRequest({
    url: '/chat/sessions/' + sessionId + '/messages',
    method: 'POST',
    data: { type: 1, content: content.trim(), client_message_id: resolvedClientMessageId }
  }))
  if (response == null || response.success != true) {
    if (response != null && Number(response.code) == 409) {
      return protectSubjectResponse(failResponse('消息请求与已发送内容不一致，无法重复提交。', 'IDEMPOTENCY_CONFLICT', response.data), subjectContext)
    }
    return protectSubjectResponse(response ?? failResponse('发送失败，请稍后重试'), subjectContext)
  }
  const row = businessData(response)
  if (row == null || !isPositiveInteger(Number(row.id))) return protectSubjectResponse(failResponse('发送响应无效', 'INVALID_SEND_RESPONSE', row), subjectContext)
  return protectSubjectResponse(okResponse({
    success: true,
    messageId: Number(row.id),
    clientMessageId: String(row.client_message_id ?? resolvedClientMessageId),
    createdAt: row.created_at ?? null
  }), subjectContext)
}

/** 旧导出兼容：合并收到和发出的申请；父母调用方必须请求 protected scope。 */
export async function getApplications(
  privacyScope: string = 'standard',
  subject: MessageSubject | null = null
) {
  const subjectContext = resolveMessageSubject(subject)
  if (subjectContext.valid != true) return messageSubjectFailure(subjectContext)
  const parentBackendFailure = parentBackendUnavailable(subjectContext)
  if (parentBackendFailure != null) return parentBackendFailure
  const photoScope = effectivePrivacyScope(privacyScope, subjectContext)
  if (MESSAGE_USE_MOCK) {
    const incoming = getMockApplicationPage('incoming', '', 50, subjectContext.key)
    const outgoing = getMockApplicationPage('outgoing', '', 50, subjectContext.key)
    const list = incoming.list.concat(outgoing.list)
    return protectSubjectResponse(
      okResponse(photoScope == 'protected' ? protectAvatarList(list) : list),
      subjectContext
    )
  }
  const incoming = await getApplicationPage('incoming', '', 50, photoScope, subject)
  if (incoming == null || incoming.success != true || incoming.data == null) return incoming
  const outgoing = await getApplicationPage('outgoing', '', 50, photoScope, subject)
  if (outgoing == null || outgoing.success != true || outgoing.data == null) return outgoing
  return protectSubjectResponse(
    okResponse((incoming.data.list as any[]).concat(outgoing.data.list as any[])),
    subjectContext
  )
}

function validCommandId(value: string, label: string): any {
  const id = value != null ? value.trim() : ''
  if (id == '') return failResponse('缺少' + label + '唯一标识', 'CLIENT_COMMAND_ID_REQUIRED')
  if (id.length > 128) return failResponse(label + '唯一标识过长', 'INVALID_CLIENT_COMMAND_ID')
  return id
}

/** Chat media remains explicitly fail-closed until its audited backend contract exists. */
export async function uploadChatMedia(
  userId: number,
  filePath: string,
  subject: MessageSubject | null = null
) {
  const subjectContext = resolveMessageSubject(subject)
  if (subjectContext.valid != true) return messageSubjectFailure(subjectContext)
  const parentBackendFailure = parentBackendUnavailable(subjectContext)
  if (parentBackendFailure != null) return parentBackendFailure
  if (!isPositiveInteger(userId)) return failResponse('无效的会话用户', 'INVALID_USER')
  if (filePath == null || filePath.trim() == '') return failResponse('请选择要发送的媒体', 'EMPTY_FILE')
  if (CHAT_MEDIA_USE_MOCK) {
    return failResponse('聊天媒体暂未接入真实服务，请先发送文字消息', 'CHAT_MEDIA_NOT_AVAILABLE')
  }
  return failResponse('聊天媒体上传契约尚未开放', 'CHAT_MEDIA_NOT_AVAILABLE')
}

export async function revokeMessage(
  messageId: number,
  clientCommandId: string,
  subject: MessageSubject | null = null
) {
  const subjectContext = resolveMessageSubject(subject)
  if (subjectContext.valid != true) return messageSubjectFailure(subjectContext)
  const parentBackendFailure = parentBackendUnavailable(subjectContext)
  if (parentBackendFailure != null) return parentBackendFailure
  if (!isPositiveInteger(messageId)) return failResponse('无效的消息', 'INVALID_MESSAGE_ID')
  const commandId = validCommandId(clientCommandId, '撤回操作')
  if (typeof commandId != 'string') return commandId
  if (MESSAGE_USE_MOCK) {
    const result = revokeMockMessage(messageId, commandId, subjectContext.key)
    return result.success == true ? okResponse(result) : failResponse(result.message, result.code, result)
  }
  const normalized = normalizeBusinessResponse(await messageRequest({
    url: '/chat/messages/' + messageId,
    method: 'DELETE'
  }))
  if (normalized == null || normalized.success != true) return normalized
  return okResponse({ messageId: messageId, revoked: true, clientCommandId: commandId })
}

export async function getContactExchanges(
  userId: number,
  subject: MessageSubject | null = null
) {
  const subjectContext = resolveMessageSubject(subject)
  if (subjectContext.valid != true) return messageSubjectFailure(subjectContext)
  const parentBackendFailure = parentBackendUnavailable(subjectContext)
  if (parentBackendFailure != null) return parentBackendFailure
  if (!isPositiveInteger(userId)) return failResponse('无效的会话用户', 'INVALID_USER')
  if (MESSAGE_USE_MOCK || CONTACT_EXCHANGE_USE_MOCK) {
    const result = getMockContactExchanges(userId, subjectContext.key)
    return result.success == true ? okResponse(result.list) : failResponse(result.message, result.code, result)
  }
  return failResponse('联系方式交换后端契约尚未开放', 'CONTACT_EXCHANGE_NOT_AVAILABLE')
}

export async function createContactExchange(
  userId: number,
  contactType: string,
  contactValue: string,
  clientCommandId: string,
  subject: MessageSubject | null = null
) {
  const subjectContext = resolveMessageSubject(subject)
  if (subjectContext.valid != true) return messageSubjectFailure(subjectContext)
  const parentBackendFailure = parentBackendUnavailable(subjectContext)
  if (parentBackendFailure != null) return parentBackendFailure
  if (!isPositiveInteger(userId)) return failResponse('无效的会话用户', 'INVALID_USER')
  if (contactType != 'phone' && contactType != 'wechat') return failResponse('不支持的联系方式类型', 'INVALID_CONTACT_TYPE')
  const commandId = validCommandId(clientCommandId, '联系方式操作')
  if (typeof commandId != 'string') return commandId
  if (MESSAGE_USE_MOCK || CONTACT_EXCHANGE_USE_MOCK) {
    const result = createMockContactExchange(userId, contactType, contactValue, commandId, subjectContext.key)
    return result.success == true ? okResponse(result.exchange) : failResponse(result.message, result.code, result)
  }
  return failResponse('联系方式交换后端契约尚未开放', 'CONTACT_EXCHANGE_NOT_AVAILABLE')
}

export async function respondContactExchange(
  exchangeId: number,
  action: string,
  clientCommandId: string,
  subject: MessageSubject | null = null
) {
  const subjectContext = resolveMessageSubject(subject)
  if (subjectContext.valid != true) return messageSubjectFailure(subjectContext)
  const parentBackendFailure = parentBackendUnavailable(subjectContext)
  if (parentBackendFailure != null) return parentBackendFailure
  if (!isPositiveInteger(exchangeId)) return failResponse('无效的联系方式请求', 'INVALID_CONTACT_EXCHANGE')
  if (action != 'accept' && action != 'reject') return failResponse('不支持的处理方式', 'INVALID_ACTION')
  const commandId = validCommandId(clientCommandId, '联系方式操作')
  if (typeof commandId != 'string') return commandId
  if (MESSAGE_USE_MOCK || CONTACT_EXCHANGE_USE_MOCK) {
    const result = respondMockContactExchange(exchangeId, action, commandId, subjectContext.key)
    return result.success == true ? okResponse(result.exchange) : failResponse(result.message, result.code, result)
  }
  return failResponse('联系方式交换后端契约尚未开放', 'CONTACT_EXCHANGE_NOT_AVAILABLE')
}

/** Compatibility alias retained for callers of the former placeholder export. */
export async function handleContactExchangeRequest(
  exchangeId: number,
  action: string,
  clientCommandId: string,
  subject: MessageSubject | null = null
) {
  return respondContactExchange(exchangeId, action, clientCommandId, subject)
}

/** 处理收到的申请；稳定命令 ID 防止重试造成重复状态变更。 */
export async function handleApplication(
  applicationId: number,
  action: string,
  clientCommandId: string = '',
  subject: MessageSubject | null = null
) {
  const subjectContext = resolveMessageSubject(subject)
  if (subjectContext.valid != true) return messageSubjectFailure(subjectContext)
  const parentBackendFailure = parentBackendUnavailable(subjectContext)
  if (parentBackendFailure != null) return parentBackendFailure
  if (!isPositiveInteger(applicationId)) return failResponse('无效的申请', 'INVALID_APPLICATION')
  if (action != 'accept' && action != 'reject') return failResponse('不支持的处理方式', 'INVALID_ACTION')
  if (clientCommandId == null || clientCommandId.trim() == '') {
    return failResponse('缺少申请操作唯一标识', 'CLIENT_COMMAND_ID_REQUIRED')
  }
  if (clientCommandId.length > 128) {
    return failResponse('申请操作唯一标识过长', 'INVALID_CLIENT_COMMAND_ID')
  }
  const resolvedClientCommandId = clientCommandId.trim()
  if (MESSAGE_USE_MOCK) {
    const result = handleMockApplication(
      applicationId,
      action,
      resolvedClientCommandId,
      subjectContext.key
    )
    if (result.success != true) {
      return protectSubjectResponse(failResponse(result.message, result.code, result), subjectContext)
    }
    return protectSubjectResponse(
      normalizeApplicationResult(
        subjectContext.mode == 'parent' ? protectApplicationResult(result) : result,
        action
      ),
      subjectContext
    )
  }
  const requestData: any = {
    applicationId: applicationId,
    action: action,
    clientCommandId: resolvedClientCommandId
  }
  appendMessageSubject(requestData, subjectContext)
  const normalized = normalizeBusinessResponse(await messageRequest({
    url: '/discovery/applications/' + applicationId + '/' + (action == 'accept' ? 'accept' : 'reject'),
    method: 'POST',
    data: requestData
  }))
  if (normalized == null || normalized.success != true) {
    return protectSubjectResponse(normalized, subjectContext)
  }
  const backendApplication = businessData(normalized)
  if (backendApplication == null || !isPositiveInteger(Number(backendApplication.id))) {
    return protectSubjectResponse(failResponse('申请处理响应无效', 'INVALID_APPLICATION_RESPONSE', backendApplication), subjectContext)
  }
  const result: any = {
    success: true,
    application: mapApplicationItem(backendApplication, 'incoming'),
    conversation: null,
    canChat: action == 'accept'
  }
  return protectSubjectResponse(
    normalizeApplicationResult(result, action),
    subjectContext
  )
}
